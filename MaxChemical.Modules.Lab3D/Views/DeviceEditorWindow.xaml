<Window x:Class="MaxChemical.Modules.Lab3D.Views.DeviceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="540" Height="580"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Foreground="#1A1A1A" FontFamily="Segoe UI, Microsoft YaHei UI"
        ShowInTaskbar="False" Topmost="True">
    <Window.Resources>
        <Style x:Key="EditorTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource FieldTextBoxStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FAFAF6"/>
            <Setter Property="BorderBrush" Value="#EAEAEA"/>
        </Style>
        <Style x:Key="EditorMonoTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource EditorTextBoxStyle}">
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
        </Style>
        <Style x:Key="EditorLabelStyle" TargetType="TextBlock"
               BasedOn="{StaticResource FieldLabelStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5F5E5A"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="EditorPrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderBrush" Value="#A41626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#8E121F"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="#6B0E1A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditorSecondaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="#F4F3EF"/>
            <Setter Property="BorderBrush" Value="#EAEAEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="EditorCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="4">
                            <Path Data="M6,6 L12,12 M12,6 L6,12"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#FFFFFF" BorderBrush="#EAEAEA" BorderThickness="1"
            CornerRadius="10" Effect="{StaticResource DeepShadow}" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="68"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#A41626" CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="24,0,15,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EditorTitle}" FontSize="16"
                                   FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        <TextBlock Text="设备信息与模型参数" FontSize="10" Foreground="#FCEAEC"
                                   Margin="14,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource EditorCloseButtonStyle}" HorizontalAlignment="Right"
                            ToolTip="取消" IsCancel="True" Click="Close_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Style="{StaticResource ThinScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,22,26,18">
                    <Border Height="160" Background="#FAFAF6" BorderBrush="#EAEAEA"
                            BorderThickness="1" CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="15,12,15,0">
                                <Border Width="3" Height="13" Background="#A41626" Margin="0,0,7,0"/>
                                <TextBlock Text="设备图片预览" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#5F5E5A"/>
                            </StackPanel>
                            <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform"
                                   Margin="18,6,18,12" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Text="设备名称" Style="{StaticResource EditorLabelStyle}"/>
                        <TextBox Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditorTextBoxStyle}" Margin="0,7,0,0"/>
                    </StackPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="134"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="模型高度（米）" Style="{StaticResource EditorLabelStyle}"/>
                            <TextBlock Text="允许 0.35–4 米，不影响上传原图" FontSize="10"
                                       Foreground="#888780" Margin="0,5,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding ModelHeightText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource EditorMonoTextBoxStyle}" TextAlignment="Right"/>
                    </Grid>

                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="设备库目录" Style="{StaticResource EditorLabelStyle}"/>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding StorageDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorMonoTextBoxStyle}" FontSize="11"
                                     ToolTip="{Binding StorageDirectory}"/>
                            <Button Grid.Column="1" Style="{StaticResource EditorSecondaryButtonStyle}"
                                    Height="36" Margin="10,0,0,0" Click="SelectFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M1.5,4.5 L6,4.5 L8,6.5 L14.5,6.5 L14.5,14 L1.5,14 Z M1.5,7.5 L14.5,7.5"
                                          Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                    <TextBlock Text="选择目录" FontSize="12" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Border Margin="0,18,0,0" Padding="12,10" Background="#FAFAF6"
                            BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="20" Height="20" CornerRadius="10" Background="#FCEAEC"
                                    VerticalAlignment="Top">
                                <TextBlock Text="i" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="#A41626"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Margin="10,1,0,0"
                                       Text="将优先匹配高精度设备模型，其他图片按轮廓生成带厚度的实体模型。新设备默认处于离线展示状态。"
                                       FontSize="11" Foreground="#5F5E5A" TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#FAFAF6" BorderBrush="#EAEAEA"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,9,9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,24,0">
                    <Button Content="取消" Style="{StaticResource EditorSecondaryButtonStyle}"
                            IsCancel="True" Click="Close_Click" Margin="0,0,10,0"/>
                    <Button Content="{Binding ConfirmButtonText}" Style="{StaticResource EditorPrimaryButtonStyle}"
                            FontWeight="SemiBold" Click="AddDevice_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
