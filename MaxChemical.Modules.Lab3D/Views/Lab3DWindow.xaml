                                                <Border Grid.Row="1" BorderBrush="#E8E5E2" BorderThickness="0,0,0,1"/>
                                                <Border Grid.Row="2" BorderBrush="#E8E5E2" BorderThickness="0,0,0,1"/>
                                                <Border Grid.Row="3" BorderBrush="#E8E5E2" BorderThickness="0,0,0,1"/>
                                                <Border Grid.Row="4" BorderBrush="#D6D1CC" BorderThickness="0,0,0,1"/>
