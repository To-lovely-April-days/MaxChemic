<Window x:Class="MaxChemical.Modules.Lab3D.Views.Lab3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:MaxChemical.Modules.Lab3D.Models"
        xmlns:converters="clr-namespace:MaxChemical.Modules.Lab3D.Converters"
        xmlns:views="clr-namespace:MaxChemical.Modules.Lab3D.Views"
        mc:Ignorable="d"
        Title="HOTREE · 3D 智能数字展厅" Width="1440" Height="900"
        MinWidth="864" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="#ECE9E3" Foreground="#1F2326" FontSize="12"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Design tokens (light) -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FBFAF7"/>
        <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceSunkBrush" Color="#F1EFEA"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#E7E4DE"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFCBC4"/>
        <SolidColorBrush x:Key="FloatBorderBrush" Color="#1F1F2326"/>
        <SolidColorBrush x:Key="SceneBackingBrush" Color="#ECE9E3"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2326"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A5F63"/>
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#7A7E82"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A41626"/>
        <SolidColorBrush x:Key="TitleHoverBrush" Color="#8E121F"/>
        <SolidColorBrush x:Key="TitleDarkBrush" Color="#6B0E1A"/>
        <SolidColorBrush x:Key="OnlineBrush" Color="#12704F"/>
        <SolidColorBrush x:Key="StaleBrush" Color="#8A5A00"/>
        <SolidColorBrush x:Key="ChartSuccessBrush" Color="#2E8B6E"/>

        <!-- Legacy keys kept for compatibility -->
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#FBFAF7"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E7E4DE"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7A7E82"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#A41626"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#A41626"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#F1EFEA"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F1EFEA"/>
        <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A41626" Offset="0"/>
            <GradientStop Color="#8E121F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ImageFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00FBFAF7" Offset="0.42"/>
            <GradientStop Color="#FFFBFAF7" Offset="1"/>
        </LinearGradientBrush>

        <DrawingBrush x:Key="FailHatchBrush" TileMode="Tile" Stretch="None"
                      Viewport="0,0,5,5" ViewportUnits="Absolute" Viewbox="0,0,5,5" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#A41626">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,5,5"/></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen><Pen Brush="#99FFFFFF" Thickness="1.2"/></GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,5" EndPoint="5,0"/>
                                <LineGeometry StartPoint="-2.5,2.5" EndPoint="2.5,-2.5"/>
                                <LineGeometry StartPoint="2.5,7.5" EndPoint="7.5,2.5"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style TargetType="Button" x:Key="IconButtonStyle">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1F2326"/>
            <Setter Property="BorderBrush" Value="#CFCBC4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1EFEA"/>
                                <Setter Property="Foreground" Value="#1F2326"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#CFCBC4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E7E4DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="TitleBarButtonStyle" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5A5F63"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1EFEA"/>
                                <Setter Property="Foreground" Value="#1F2326"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E7E4DE"/>
                                <Setter Property="Foreground" Value="#1F2326"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="TitleBarCloseButtonStyle" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5A5F63"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#A41626"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6B0E1A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ActionButtonStyle" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryActionButtonStyle" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#A41626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#A41626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#8E121F"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#8E121F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6B0E1A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6B0E1A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="TextLinkButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#1F2326"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
            <Setter Property="Foreground" Value="#5A5F63"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="StatusGlyphStyle" TargetType="Path">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Data" Value="M4,0.75 A3.25,3.25 0 1 1 3.99,0.75 Z"/>
            <Setter Property="Stroke" Value="#5A5F63"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="live">
                    <Setter Property="Fill" Value="#12704F"/>
                    <Setter Property="Stroke" Value="#12704F"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="stale">
                    <Setter Property="Data" Value="M4,0.5 L7.5,7.5 L0.5,7.5 Z"/>
                    <Setter Property="Fill" Value="#8A5A00"/>
                    <Setter Property="Stroke" Value="#8A5A00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidePanelCardStyle" TargetType="ContentControl">
            <Setter Property="Background" Value="#FBFAF7"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="#FBFAF7" CornerRadius="10" IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect Color="#1F2326" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14"/>
                                </Border.Effect>
                            </Border>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource FloatBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1F2326"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="BorderBrush" Value="#E7E4DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinWidth" Value="154"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource DeepShadow}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1F2326"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="142"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconBorder" Width="24" Height="24"
                                        Background="#F1EFEA" CornerRadius="5">
                                    <ContentPresenter ContentSource="Icon"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Header}"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,6,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F1EFEA"/>
                                <Setter TargetName="IconBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#1F2326"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E7E4DE"/>
                                <Setter Property="Foreground" Value="#1F2326"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#E7E4DE" Margin="9,4"
                                VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dock card. Keyed on purpose: the dock lives in the overlay window, where an implicit template of this window is not found. -->
        <DataTemplate x:Key="DockDeviceTemplate" DataType="{x:Type models:LabDevice}">
            <Button MinWidth="150" Height="88" Margin="0,0,6,0" Padding="0" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Click="DeviceCard_Click" AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#F1EFEA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="68" CornerRadius="6" Background="#FFFFFF" BorderBrush="#E7E4DE" BorderThickness="1" Padding="4">
                            <Image Source="{Binding ImagePath}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                            </Image>
                        </Border>
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PrimaryDockText}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2326" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="12" Foreground="#5A5F63" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                       LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="34"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1F2326"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Foreground" Value="#8E121F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <DockPanel Grid.Row="2">
                                <Path DockPanel.Dock="Left" Style="{StaticResource StatusGlyphStyle}"/>
                                <TextBlock Text="{Binding DockStatusText}" FontSize="12" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Foreground="{Binding StatusKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=status}"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                    <Grid IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="3" VerticalAlignment="Bottom"
                                Background="{Binding InspectionStateKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=line}"
                                Visibility="{Binding IsInspected, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- A. Title bar -->
        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#FBFAF7" BorderBrush="#E7E4DE" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Height="44">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="TitleScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="6" Background="#A41626">
                        <Image Source="pack://siteoforigin:,,,/Resources/Icon/logo.png" Stretch="Uniform" Margin="4"/>
                    </Border>
                    <TextBlock Text="HOTREE" FontFamily="Segoe UI" FontWeight="Bold" FontSize="15" Foreground="#A41626" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="3D 智能数字展厅" FontSize="12" Foreground="#5A5F63" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="#CFCBC4" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="智能设备展示 · 数字孪生中心" FontSize="13" FontWeight="SemiBold" Foreground="#1F2326" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Devices}" VerticalAlignment="Center" Focusable="False" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="6" VerticalAlignment="Center">
                                    <Border Width="10" Margin="0,0,3,0" CornerRadius="1" BorderThickness="1" VerticalAlignment="Bottom">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Height" Value="6"/>
                                                <Setter Property="BorderBrush" Value="#CFCBC4"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="live">
                                                        <Setter Property="BorderBrush" Value="#12704F"/>
                                                        <Setter Property="Background" Value="#12704F"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKey}" Value="stale">
                                                        <Setter Property="BorderBrush" Value="#8A5A00"/>
                                                        <Setter Property="Background" Value="#8A5A00"/>
                                                        <Setter Property="Height" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding OnlineSummary}" FontSize="13" FontWeight="SemiBold" Margin="5,0,6,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#5A5F63"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOnlineDevices}" Value="True">
                                        <Setter Property="Foreground" Value="#12704F"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Click="Maximize_Click" ToolTip="最大化 / 还原"/>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- B. Scene + floating layer -->
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid x:Name="SceneViewport" Background="#ECE9E3" ClipToBounds="True">
                <wv2:WebView2 x:Name="LabWebView" Visibility="Hidden"
                              xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"/>
                <Border x:Name="LabLoading" Background="#FBFAF7">
                    <StackPanel x:Name="LabLoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                        <Border Width="52" Height="52" CornerRadius="10" Background="#A41626" BorderBrush="#A41626" BorderThickness="1" HorizontalAlignment="Center">
                            <Image Source="pack://siteoforigin:,,,/Resources/Icon/logo.png" Stretch="Uniform" Margin="6"/>
                        </Border>
                        <TextBlock x:Name="LabLoadingTitle" Text="正在构建高保真展厅" FontSize="15" FontWeight="SemiBold" Foreground="#1F2326" HorizontalAlignment="Center" Margin="0,18,0,6"/>
                        <TextBlock x:Name="LabLoadingText" Text="霍桐仪器" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Center"
                                   MaxHeight="72" TextTrimming="CharacterEllipsis" TextAlignment="Center"/>
                        <ProgressBar x:Name="LabLoadingProgress" IsIndeterminate="True" Height="3" Margin="28,22,28,0" Foreground="#A41626" Background="#F1EFEA" BorderThickness="0"/>
                        <Button x:Name="LabRetryButton" Style="{StaticResource ActionButtonStyle}" Content="重新加载场景" Click="RetryScene_Click" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SceneModeBorder" Visibility="Collapsed" Margin="12" Padding="8,4" Background="#FBFAF7" BorderBrush="#E7E4DE" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="{Binding SceneModeTitle}" FontSize="12" Foreground="#5A5F63"/>
                </Border>
            </Grid>

            <!-- Everything floating. Moved into Lab3DOverlayWindow at Loaded: no ElementName bindings inside. -->
            <Grid x:Name="OverlayLayer" Panel.ZIndex="2">

                <!-- C1. Lab overview -->
                <ContentControl x:Name="LeftPanel" Style="{StaticResource SidePanelCardStyle}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0" Width="296" Padding="20,18,20,16">
                    <StackPanel>
                        <Grid x:Name="OverviewCard">
                            <TextBlock Text="实验室概览" FontSize="15" FontWeight="SemiBold" Foreground="#1F2326" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OverviewUpdatedText}" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="96" Height="96">
                                <Ellipse Width="90" Height="90" Stroke="#F1EFEA" StrokeThickness="6"/>
                                <Path Width="96" Height="96" Stretch="None" Data="{Binding ExperimentSuccessArc}" Stroke="#A41626" StrokeThickness="6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExperimentSuccessRateText}" FontSize="22" FontWeight="SemiBold" Foreground="#1F2326" HorizontalAlignment="Center"/>
                                    <TextBlock Text="实验成功率" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid Grid.Column="2" Columns="2" Rows="2" VerticalAlignment="Center">
                                <StackPanel Margin="0,0,4,5">
                                    <TextBlock Text="设备总数" FontSize="12" Foreground="#5A5F63"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Devices.Count}" FontSize="20" FontWeight="SemiBold" Foreground="#1F2326"/>
                                        <TextBlock Text=" 台" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="4,0,0,5">
                                    <TextBlock Text="在线设备" FontSize="12" Foreground="#5A5F63"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding OnlineDeviceCountText}" FontSize="20" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1F2326"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOnlineDevices}" Value="True">
                                                            <Setter Property="Foreground" Value="#12704F"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text=" 台" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,5,4,0">
                                    <TextBlock Text="累计实验" FontSize="12" Foreground="#5A5F63"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ExperimentCountText}" FontSize="20" FontWeight="SemiBold" Foreground="#1F2326"/>
                                        <TextBlock Text=" 次" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="4,5,0,0">
                                    <TextBlock Text="今日实验" FontSize="12" Foreground="#5A5F63"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TodayExperimentCountText}" FontSize="20" FontWeight="SemiBold" Foreground="#1F2326"/>
                                        <TextBlock Text=" 次" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>

                        <Border Height="1" Background="#E7E4DE" Margin="0,14"/>

                        <!-- Current experiment -->
                        <Grid>
                            <TextBlock Text="当前实验" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ActiveExperimentProgressText}" FontFamily="Consolas" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1F2326"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActiveExperimentProgressText}" Value="--">
                                                <Setter Property="Foreground" Value="#7A7E82"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding ActiveExperimentName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1F2326"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveExperimentProgressText}" Value="--">
                                            <Setter Property="Foreground" Value="#5A5F63"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Height="4" Maximum="100" Value="{Binding ActiveExperimentProgress, Mode=OneWay}" Margin="0,6,0,0"
                                     Foreground="#A41626" Background="#F1EFEA" BorderThickness="0"/>
                        <TextBlock Text="{Binding ActiveExperimentStatus}" FontSize="12" Foreground="#5A5F63" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>

                        <Border Height="1" Background="#E7E4DE" Margin="0,14"/>

                        <!-- 7-day trend -->
                        <Grid x:Name="TrendCard">
                            <TextBlock Text="近 7 天实验趋势" FontSize="13" FontWeight="SemiBold" Foreground="#1F2326" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="#2E8B6E" VerticalAlignment="Center"/>
                                <TextBlock Text="成功" FontSize="12" Foreground="#5A5F63" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                <Rectangle Width="8" Height="8" RadiusX="1" RadiusY="1" Fill="{StaticResource FailHatchBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="失败" FontSize="12" Foreground="#5A5F63" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Height="100" Visibility="{Binding TrendItemsVisibility}">
                                <TextBlock Text="{Binding TrendAxisTopText}" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-14,-8,6,0"/>
                                <TextBlock Text="{Binding TrendAxisUpperText}" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-14,17,6,0"/>
                                <TextBlock Text="{Binding TrendAxisMiddleText}" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-14,42,6,0"/>
                                <TextBlock Text="{Binding TrendAxisLowerText}" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-14,67,6,0"/>
                                <TextBlock Text="0" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-14,0,6,-8"/>
                            </Grid>
                            <Grid Grid.Column="1" Height="100">
                                <Border Height="1" Background="#E7E4DE" VerticalAlignment="Top"/>
                                <Border Height="1" Background="#E7E4DE" VerticalAlignment="Top" Margin="0,25,0,0"/>
                                <Border Height="1" Background="#E7E4DE" VerticalAlignment="Top" Margin="0,50,0,0"/>
                                <Border Height="1" Background="#E7E4DE" VerticalAlignment="Top" Margin="0,75,0,0"/>
                                <Border Height="1" Background="#CFCBC4" VerticalAlignment="Bottom"/>
                                <ItemsControl ItemsSource="{Binding TrendItems}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" ToolTip="{Binding ToolTipText}">
                                                <Rectangle Height="{Binding FailedHeight}" Fill="{StaticResource FailHatchBrush}"/>
                                                <Rectangle Height="{Binding SuccessHeight}" Fill="#2E8B6E"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FBFAF7" CornerRadius="4" Padding="10,2"
                                        Visibility="{Binding TrendEmptyVisibility}">
                                    <TextBlock Text="暂无趋势数据" FontSize="12" Foreground="#5A5F63"/>
                                </Border>
                            </Grid>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TrendItems}" Margin="20,8,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#5A5F63"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Label}" Value="今天">
                                                        <Setter Property="Foreground" Value="#1F2326"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <!-- C2. AI console host -->
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="312,12,352,0" Height="264"
                      DataContext="{Binding Inspection, Source={x:Static views:Lab3DWindow.Current}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="720"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl x:Name="BrainCard" Grid.Column="1" Style="{StaticResource SidePanelCardStyle}" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="28" Height="28" Stroke="#E7E4DE" StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AssistantAvatarPath, Source={x:Static views:Lab3DWindow.Current}}" Stretch="UniformToFill" AlignmentY="Top"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="AI 智慧大脑" FontSize="16" FontWeight="SemiBold" Foreground="#1F2326" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6" Fill="#12704F" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="规则引擎运行中" FontSize="12" Foreground="#5A5F63" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="当前分析" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TargetId}" FontFamily="Consolas" FontSize="12" Foreground="#5A5F63" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TargetName}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2326" MaxWidth="140" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="·" FontSize="13" Foreground="#1F2326" Margin="8,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding InspectionAnalysisText, Source={x:Static views:Lab3DWindow.Current}}" FontSize="13" Foreground="#1F2326" VerticalAlignment="Center"/>
                                    <Border Height="22" CornerRadius="4" BorderThickness="1" Padding="7,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                            BorderBrush="{Binding OverallStateKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=status}">
                                        <TextBlock Text="{Binding TargetStatus}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{Binding OverallStateKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=status}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Inputs / brain / outputs -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl Grid.Column="0" ItemsSource="{Binding Inputs}" Margin="0,3" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="4" Columns="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Right" Width="8" Height="8" StrokeThickness="1.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                         Stroke="{Binding StateKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=line}"
                                                         Fill="{Binding StateKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=fill}"/>
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#5A5F63" TextTrimming="CharacterEllipsis" TextAlignment="Right" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Right" HorizontalAlignment="Right"
                                                               Foreground="{Binding StateKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=text}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <views:Lab3DBrainView x:Name="BrainView" Grid.Column="1" Width="280" Height="150" AutomationProperties.Name="AI 大脑规则巡检可视化"/>
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Outputs}" Margin="0,3" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="3" Columns="1"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" StrokeThickness="1.5" Margin="0,0,8,0" VerticalAlignment="Center"
                                                         Stroke="{Binding StateKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=line}"
                                                         Fill="{Binding StateKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=fill}"/>
                                                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#5A5F63" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding StateKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=text}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Footer -->
                            <Border Grid.Row="4" BorderBrush="#E7E4DE" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="轮巡" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Center"/>
                                        <ItemsControl ItemsSource="{Binding InspectionRounds, Source={x:Static views:Lab3DWindow.Current}}"
                                                      MaxWidth="240" ClipToBounds="True" Margin="12,0,0,0" VerticalAlignment="Center" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="18" Height="4" CornerRadius="2" Margin="0,0,3,0"
                                                            Background="{Binding Converter={x:Static converters:Lab3DStateBrushConverter.Instance}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding RotationText}" FontFamily="Consolas" FontSize="12" Foreground="#5A5F63" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding InspectionCount}" FontSize="16" FontWeight="SemiBold" Foreground="#1F2326" VerticalAlignment="Center"/>
                                            <TextBlock Text="巡检次数" FontSize="12" Foreground="#5A5F63" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding AlertCount}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#A41626"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AlertCount}" Value="0">
                                                                <Setter Property="Foreground" Value="#1F2326"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="异常预警" FontSize="12" Foreground="#5A5F63" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding InspectionDataCoverageText, Source={x:Static views:Lab3DWindow.Current}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1F2326"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding InspectionDataCoverageText, Source={x:Static views:Lab3DWindow.Current}}" Value="--">
                                                                <Setter Property="Foreground" Value="#7A7E82"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="数据覆盖率" FontSize="12" Foreground="#5A5F63" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding InspectionSuccessRateText, Source={x:Static views:Lab3DWindow.Current}}" FontSize="16" FontWeight="SemiBold" Foreground="#1F2326" VerticalAlignment="Center"/>
                                            <TextBlock Text="历史成功率" FontSize="12" Foreground="#5A5F63" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ContentControl>

                    <!-- Link from the console's alert output to the conclusions card. Decorative only. -->
                    <Border Grid.Column="2" Height="2" VerticalAlignment="Top" Margin="-6,127,-6,0" IsHitTestVisible="False"
                            Background="{Binding InspectionLinkStateKey, Source={x:Static views:Lab3DWindow.Current}, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=line}"/>
                    <Ellipse Grid.Column="2" Width="10" Height="10" StrokeThickness="2" Fill="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,123,-6,0" IsHitTestVisible="False"
                             Stroke="{Binding InspectionLinkStateKey, Source={x:Static views:Lab3DWindow.Current}, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=line}"/>
                </Grid>

                <!-- C3. Right column: conclusions + device details -->
                <Grid x:Name="RightPanel" HorizontalAlignment="Right" Margin="0,12,16,136" Width="336" DataContext="{Binding SelectedDevice}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ContentControl x:Name="AnalysisCard" Grid.Row="0" Style="{StaticResource SidePanelCardStyle}" Padding="20,16,20,8" MaxHeight="280"
                                    DataContext="{Binding Inspection, Source={x:Static views:Lab3DWindow.Current}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,2">
                                <TextBlock Text="AI 分析结论" FontSize="15" FontWeight="SemiBold" Foreground="#1F2326" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding InspectionNoticeCountText, Source={x:Static views:Lab3DWindow.Current}}" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <ScrollViewer x:Name="RightPanelScrollViewer" Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly" Focusable="False">
                                <ItemsControl ItemsSource="{Binding Notices}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E7E4DE" BorderThickness="0,1,0,0" Padding="0,8">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Height="20" CornerRadius="4" BorderThickness="1" Padding="6,0" VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="#5A5F63"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Level}" Value="warning"><Setter Property="BorderBrush" Value="#A41626"/></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Level}" Value="normal"><Setter Property="BorderBrush" Value="#12704F"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding LevelTagText}" FontSize="12" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#5A5F63"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Level}" Value="warning"><Setter Property="Foreground" Value="#A41626"/></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Level}" Value="normal"><Setter Property="Foreground" Value="#12704F"/></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontFamily="Consolas" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Inspection.TargetName, Source={x:Static views:Lab3DWindow.Current}}" FontSize="13" FontWeight="SemiBold" Foreground="#1F2326"
                                                                   Margin="8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#1F2326" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </ContentControl>

                    <ContentControl x:Name="DeviceDetailsCard" Grid.Row="2" Style="{StaticResource SidePanelCardStyle}" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 1 -->
                            <Grid Grid.Row="0">
                                <TextBlock Text="设备详情 · 当前选中" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 2 -->
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" Foreground="#1F2326" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding EnglishName}" FontSize="11" Foreground="#5A5F63" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- 3 -->
                            <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                <Border DockPanel.Dock="Left" Height="24" CornerRadius="4" BorderThickness="1" Padding="8,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#CFCBC4"/>
                                            <Setter Property="Background" Value="#F1EFEA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKey}" Value="live">
                                                    <Setter Property="BorderBrush" Value="#12704F"/>
                                                    <Setter Property="Background" Value="#FFFFFF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKey}" Value="stale">
                                                    <Setter Property="BorderBrush" Value="#8A5A00"/>
                                                    <Setter Property="Background" Value="#FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource StatusGlyphStyle}"/>
                                        <TextBlock Text="{Binding ActivityText}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding StatusKey, Converter={x:Static converters:Lab3DStateBrushConverter.Instance}, ConverterParameter=status}"/>
                                    </StackPanel>
                                </Border>
                                <Button DockPanel.Dock="Right" Content="删除" Style="{StaticResource TextLinkButtonStyle}" Foreground="#A41626" VerticalAlignment="Center" Click="DeleteSelected_Click"/>
                                <Button DockPanel.Dock="Right" Content="编辑" Style="{StaticResource TextLinkButtonStyle}" VerticalAlignment="Center" Margin="0,0,4,0" Click="EditSelected_Click"/>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Location}" FontSize="12" Foreground="#5A5F63" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock DockPanel.Dock="Left" Text=" · " FontSize="12" Foreground="#5A5F63" VerticalAlignment="Center"
                                           Visibility="{Binding Protocol, Converter={x:Static converters:ProtocolVisibilityConverter.Instance}, FallbackValue=Collapsed}"/>
                                <TextBlock Text="{Binding Protocol}" FontFamily="Consolas" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Visibility="{Binding Protocol, Converter={x:Static converters:ProtocolVisibilityConverter.Instance}, FallbackValue=Collapsed}"/>
                            </DockPanel>

                            <!-- 4 -->
                            <TextBlock Grid.Row="3" Text="{Binding Description}" FontSize="12" Foreground="#5A5F63" Margin="0,8,0,0"
                                       TextWrapping="Wrap" LineHeight="18" MaxHeight="36" TextTrimming="CharacterEllipsis"/>

                            <!-- 5 -->
                            <Border Grid.Row="4" Height="1" Background="#E7E4DE" Margin="0,12,0,0"/>

                            <!-- 6 -->
                            <UniformGrid Grid.Row="5" Columns="3" Margin="0,12,0,0">
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="{Binding PrimaryName}" FontSize="12" Foreground="#5A5F63" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding PrimaryDisplayText}" FontSize="22" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7A7E82"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLiveValues}" Value="True">
                                                            <Setter Property="Foreground" Value="#1F2326"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PrimaryUnit}" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Margin="0,0,4,0">
                                    <TextBlock Text="{Binding SecondaryName}" FontSize="12" Foreground="#5A5F63" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding SecondaryDisplayText}" FontSize="22" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#7A7E82"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLiveValues}" Value="True">
                                                            <Setter Property="Foreground" Value="#1F2326"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SecondaryUnit}" FontSize="12" Foreground="#5A5F63" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="本机成功率" FontSize="12" Foreground="#5A5F63"/>
                                    <TextBlock Text="{Binding SelectedSuccessRateText, Source={x:Static views:Lab3DWindow.Current}}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1F2326"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedSuccessRateText, Source={x:Static views:Lab3DWindow.Current}}" Value="--">
                                                        <Setter Property="Foreground" Value="#7A7E82"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </UniformGrid>

                            <!-- 7 -->
                            <Border Grid.Row="6" Height="1" Background="#E7E4DE" Margin="0,12,0,0"/>

                            <!-- 8 -->
                            <Grid Grid.Row="7" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="近 60 秒实时曲线" FontSize="13" FontWeight="SemiBold" Foreground="#1F2326" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Rectangle Width="12" Height="2" Fill="#A41626" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PrimaryName}" FontSize="12" Foreground="#5A5F63" MaxWidth="70" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    <Line X1="0" Y1="1" X2="12" Y2="1" Width="12" Height="2" Stroke="#5A5F63" StrokeThickness="2" StrokeDashArray="1.5 1.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SecondaryName}" FontSize="12" Foreground="#5A5F63" MaxWidth="70" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 9 -->
                            <views:Lab3DRealtimeChart Grid.Row="8" Margin="0,8,0,0" MinHeight="64" MaxHeight="140" VerticalAlignment="Top"
                                                      PrimarySamples="{Binding PrimarySamples}" SecondarySamples="{Binding SecondarySamples}"
                                                      PrimaryName="{Binding PrimaryName}" SecondaryName="{Binding SecondaryName}"
                                                      PrimaryUnit="{Binding PrimaryUnit}" SecondaryUnit="{Binding SecondaryUnit}"
                                                      AutomationProperties.Name="近60秒实测值与设定值曲线"/>
                        </Grid>
                    </ContentControl>
                </Grid>

                <!-- C4. Device dock -->
                <ContentControl x:Name="DeviceNavigationBorder" Style="{StaticResource SidePanelCardStyle}"
                                VerticalAlignment="Bottom" Margin="16,0,16,16" Height="112" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="DeviceScrollViewer" Grid.Column="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"
                                      CanContentScroll="False" PanningMode="None" Focusable="False" PreviewMouseWheel="DeviceScroll_PreviewMouseWheel"
                                      TouchDown="DeviceScroll_TouchDown" TouchMove="DeviceScroll_TouchMove"
                                      TouchUp="DeviceScroll_TouchUp" LostTouchCapture="DeviceScroll_LostTouchCapture">
                            <Grid x:Name="DeviceTrackHost">
                                <Border x:Name="SelectionIndicator" Width="150" Height="88"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                                        RenderTransformOrigin="0.5,0.5" Background="Transparent" BorderThickness="0">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="SelectionScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="SelectionTranslate"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <Border Margin="0,0,6,0" CornerRadius="8" Background="#FFFFFF" BorderBrush="#A41626" BorderThickness="1.5"/>
                                </Border>
                                <ItemsControl x:Name="DeviceList" ItemsSource="{Binding Devices}" Panel.ZIndex="1" Focusable="False"
                                              ItemTemplate="{StaticResource DockDeviceTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="暂无设备，请点击右侧 + 新增设备。" FontSize="12" Foreground="#5A5F63" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ScrollViewer>
                        <Border Grid.Column="1" Width="1" Height="40" Background="#CFCBC4" Margin="4,0,10,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="44" Height="44" Margin="0" Focusable="False"
                                Content="&#xE710;" FontFamily="Segoe MDL2 Assets" Click="AddDevice_Click" ToolTip="新增设备"/>
                    </Grid>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
