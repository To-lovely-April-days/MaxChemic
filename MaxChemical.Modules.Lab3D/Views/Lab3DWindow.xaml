            <Border x:Name="RightPanel" Grid.Column="2" Panel.ZIndex="2" Background="#F2FFFFFF" BorderBrush="#66E3E1DE" BorderThickness="1,0,0,0" Padding="5" DataContext="{Binding SelectedDevice}" VerticalAlignment="Stretch">
