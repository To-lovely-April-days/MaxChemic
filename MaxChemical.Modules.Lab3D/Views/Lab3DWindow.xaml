                                    <TextBlock Text="{Binding PrimaryDisplay}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="#303332"/>
                                    <TextBlock Text="{Binding PrimaryUnit}" FontSize="7" Foreground="#888780" VerticalAlignment="Bottom" Margin="3,0,0,1"/>
