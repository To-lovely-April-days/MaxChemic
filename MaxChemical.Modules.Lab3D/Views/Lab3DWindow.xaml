                                                                    <Setter Property="Foreground" Value="#1D9E75"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsOnline}" Value="True"/>
                                                                        <Condition Binding="{Binding HasFreshData}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.Setters>
                                                                        <Setter Property="Text" Value="▲"/>
                                                                        <Setter Property="Foreground" Value="#B78B45"/>
                                                                        <Setter Property="FontSize" Value="8"/>
                                                                    </MultiDataTrigger.Setters>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="9" Foreground="#303332" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
