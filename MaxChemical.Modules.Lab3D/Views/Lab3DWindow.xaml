                                                    <DataTemplate>
                                                        <Grid Height="88" ToolTip="{Binding ToolTipText}">
                                                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                <Rectangle Width="14" Height="{Binding FailedHeight}" Fill="#A41626"/>
                                                                <Rectangle Width="14" Height="{Binding SuccessHeight}" Fill="#1D9E75"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding TrendItems}" Height="20">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding Label}" FontSize="7" Foreground="#888780" HorizontalAlignment="Center" Margin="0,4,0,0"/></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ContentControl>
                </Grid>
            </Border>

