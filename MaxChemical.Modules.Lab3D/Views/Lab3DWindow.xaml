                                                <Border Width="28" Height="16" BorderThickness="1" Padding="1,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#A7A49E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="warning"><Setter Property="BorderBrush" Value="#A41626"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="normal"><Setter Property="BorderBrush" Value="#1D9E75"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="7.5" TextAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#888780"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="warning"><Setter Property="Foreground" Value="#A41626"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="normal"><Setter Property="Foreground" Value="#1D9E75"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="26"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DataContext.Inspection.TargetName, Source={x:Static views:Lab3DWindow.Current}}" FontSize="9" FontWeight="SemiBold" Foreground="#303332" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontFamily="Consolas" FontSize="7" Foreground="#888780" Margin="4,0" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Height="2" Background="#52616B" VerticalAlignment="Center" Margin="3,0"/>
                                                    <TextBlock Grid.Column="3" Text="规则检查" FontSize="7" Foreground="#888780" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Text}" FontSize="8" Foreground="#5F5E5A" TextWrapping="Wrap" LineHeight="13" Margin="0,5,0,0"/>
                                            </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
