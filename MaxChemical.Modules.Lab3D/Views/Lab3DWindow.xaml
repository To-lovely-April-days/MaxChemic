<Window x:Class="MaxChemical.Modules.Lab3D.Views.Lab3DWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:MaxChemical.Modules.Lab3D.Models"
        xmlns:converters="clr-namespace:MaxChemical.Modules.Lab3D.Converters"
        xmlns:views="clr-namespace:MaxChemical.Modules.Lab3D.Views"
        mc:Ignorable="d"
        Title="HOTREE · 3D 智能数字展厅" Width="1150" Height="640"
        MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="#FFFFFF" Foreground="#1A1A1A"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#FAFAF6"/>
        <SolidColorBrush x:Key="LineBrush" Color="#EAEAEA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#888780"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#A41626"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#C42626"/>
        <SolidColorBrush x:Key="OnlineBrush" Color="#1D9E75"/>
        <SolidColorBrush x:Key="TitleBrush" Color="#A41626"/>
        <SolidColorBrush x:Key="TitleHoverBrush" Color="#8E121F"/>
        <SolidColorBrush x:Key="TitleDarkBrush" Color="#6B0E1A"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FCEAEC"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5E5A"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#F4F3EF"/>
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#D3D1C7"/>
        <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A41626" Offset="0"/>
            <GradientStop Color="#8E121F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ImageFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00FAFAF6" Offset="0.42"/>
            <GradientStop Color="#FFFAFAF6" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button" x:Key="IconButtonStyle">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#5F5E5A"/>
            <Setter Property="BorderBrush" Value="#D3D1C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FCEAEC"/>
                                <Setter Property="Foreground" Value="#A41626"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#A41626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F4F3EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="TitleBarButtonStyle" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#8E121F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6B0E1A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ActionButtonStyle" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryActionButtonStyle" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#A41626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#A41626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#8E121F"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#8E121F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#6B0E1A"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6B0E1A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionTitleStyle">
            <Setter Property="Foreground" Value="#888780"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="SidePanelCardStyle" TargetType="ContentControl">
            <Setter Property="Background" Value="#F5FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" SnapsToDevicePixels="True"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Canvas Height="8" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Polygon Points="0,0 12,0 0,8" Width="12" Height="8" Stretch="Fill"
                                         Fill="{StaticResource AccentBrush}" Opacity="0.48" Canvas.Left="0" Canvas.Top="0"/>
                                <Polygon Points="0,0 12,0 12,8" Width="12" Height="8" Stretch="Fill"
                                         Fill="{StaticResource AccentBrush}" Opacity="0.48" Canvas.Right="0" Canvas.Top="0"/>
                            </Canvas>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="BorderBrush" Value="#EAEAEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="MinWidth" Value="154"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource DeepShadow}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="142"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconBorder" Width="24" Height="24"
                                        Background="#F4F3EF" CornerRadius="5">
                                    <ContentPresenter ContentSource="Icon"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Header}"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,6,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FCEAEC"/>
                                <Setter TargetName="IconBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter Property="Foreground" Value="#A41626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F6DDE1"/>
                                <Setter Property="Foreground" Value="#8E121F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#EAEAEA" Margin="9,4"
                                VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type models:LabDevice}">
            <Button Width="212" Height="70" Margin="0,0,10,0" Padding="0" Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" FocusVisualStyle="{x:Null}"
                    Cursor="Hand" Click="DeviceCard_Click" AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Button.Template>
                <Border x:Name="Card" Padding="10,7" BorderThickness="0" Background="Transparent" CornerRadius="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="54" Background="Transparent" BorderThickness="0">
                        <Grid>
                            <Image Source="{Binding ImagePath}" Stretch="Uniform" Margin="4" RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,1,5,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1A1A1A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="#A41626"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="{StaticResource OnlineBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="#5F5E5A" Margin="5,0,0,0"/>
                            <TextBlock Text="·" Foreground="#D3D1C7" Margin="4,0"
                                       Visibility="{Binding Protocol, Converter={x:Static converters:ProtocolVisibilityConverter.Instance}}"/>
                            <TextBlock Text="{Binding Protocol}" FontFamily="Consolas" FontSize="8" Foreground="#888780"
                                       Visibility="{Binding Protocol, Converter={x:Static converters:ProtocolVisibilityConverter.Instance}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition x:Name="DeviceNavigationRow" Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="#A41626" BorderBrush="#6B0E1A" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="24,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="16" Margin="12,0,4,0">
                        <Image Source="pack://siteoforigin:,,,/Resources/Icon/logo.png"/>
                    </Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="HOTREE" FontFamily="Segoe UI" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="TitleBrandSubText" Text="3D 智能数字展厅" FontSize="8" Foreground="#FCEAEC" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="TitleDescriptionPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="1" Height="18" Background="#FCEAEC" Opacity="0.5" Margin="20,0,16,0"/>
                        <TextBlock Text="智能设备展示 · 数字孪生中心" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="TitleStatusPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource OnlineBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="系统运行正常" FontSize="11" Foreground="#FFFFFF" Margin="7,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="18" Background="#FCEAEC" Opacity="0.5" Margin="10,0"/>
                    <TextBlock Text="{Binding OnlineSummary}" FontSize="11" Foreground="#E1F5EE" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Click="Maximize_Click" ToolTip="最大化 / 还原"/>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Click="Close_Click" ToolTip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DeviceNavigationBorder" Grid.Row="1" Background="#FAFAF6" BorderBrush="#EAEAEA" BorderThickness="0,0,0,1">
            <Grid Margin="18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DeviceNavigationPrimaryRow" Height="*"/>
                    <RowDefinition x:Name="DeviceNavigationSecondaryRow" Height="0"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="18" Background="#A41626" Margin="0,0,8,0"/>
                        <TextBlock Text="设备导航" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer x:Name="DeviceScrollViewer" Grid.Column="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"
                              CanContentScroll="False" PanningMode="None" PreviewMouseWheel="DeviceScroll_PreviewMouseWheel"
                              TouchDown="DeviceScroll_TouchDown" TouchMove="DeviceScroll_TouchMove"
                              TouchUp="DeviceScroll_TouchUp" LostTouchCapture="DeviceScroll_LostTouchCapture">
                    <Grid x:Name="DeviceTrackHost" HorizontalAlignment="Left">
                        <Border x:Name="SelectionIndicator" Width="212" Height="70" Padding="0"
                                HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#66A41626" BorderThickness="1"
                                CornerRadius="35" Opacity="0" IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#D9FFFFFF" Offset="0"/>
                                    <GradientStop Color="#99FCEAEC" Offset="0.55"/>
                                    <GradientStop Color="#CCFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="SelectionScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="SelectionTranslate"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#6B5E58" BlurRadius="18" ShadowDepth="3" Opacity="0.18"/>
                            </Border.Effect>
                            <Grid IsHitTestVisible="False">
                                <Border Height="22" Margin="14,3,22,0" VerticalAlignment="Top" CornerRadius="10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#BFFFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border Width="18" Height="8" Margin="0,9,14,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        CornerRadius="6" Background="#CCFFFFFF">
                                    <Border.Effect><BlurEffect Radius="3"/></Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                        <ItemsControl x:Name="DeviceList" ItemsSource="{Binding Devices}" Panel.ZIndex="1">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" Click="DeviceScrollLeft_Click" ToolTip="向左滑动"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" Click="DeviceScrollRight_Click" ToolTip="向右滑动"/>
                    <Button Style="{StaticResource IconButtonStyle}" Content="+" FontSize="20" Click="AddDevice_Click" ToolTip="新增设备"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightPanelColumn" Width="244"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0"/>
                <RowDefinition x:Name="CompactDetailsRow" Height="0"/>
            </Grid.RowDefinitions>

            <Border x:Name="LeftPanel" Grid.Column="0" Grid.Row="0" Panel.ZIndex="2" Background="#F2FFFFFF" BorderBrush="#66EAEAEA" BorderThickness="0,0,1,0" Padding="5" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" x:Name="LeftPanelScrollViewer" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="LeftPanelContent" VerticalAlignment="Stretch" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ContentControl x:Name="OverviewCard" Grid.Row="0" Style="{StaticResource SidePanelCardStyle}" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Height="17">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="3" Height="14" Background="#A41626" Margin="0,0,7,0"/>
                                        <TextBlock Text="实验室概览" FontSize="12" FontWeight="SemiBold" Foreground="#1A1A1A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OverviewUpdatedText}" FontSize="8" Foreground="#888780" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="9,5,10,0" Height="90">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="82" Height="87" HorizontalAlignment="Left">
                                        <Ellipse Width="82" Height="82" Stroke="#D8C6CA" StrokeThickness="1" StrokeDashArray="1 2"/>
                                        <Ellipse Width="72" Height="72" Stroke="#F0E7E9" StrokeThickness="5"/>
                                        <Path Width="72" Height="72" Data="{Binding ExperimentSuccessArc}" Stroke="#A41626" StrokeThickness="5"
                                              StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Stretch="None"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,-9,0,0">
                                            <TextBlock Text="{Binding ExperimentSuccessRateText}" FontFamily="Segoe UI" FontSize="17" FontWeight="SemiBold" Foreground="#8E121F" HorizontalAlignment="Center"/>
                                            <TextBlock Text="实验成功率" FontSize="8" Foreground="#5F5E5A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <UniformGrid Grid.Column="1" Columns="2" Rows="2">
                                        <StackPanel Margin="0,4,3,0" VerticalAlignment="Top">
                                            <TextBlock Text="设备总数" FontSize="8" Foreground="#888780"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Devices.Count}" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                                <TextBlock Text=" 台" FontSize="8" Foreground="#888780" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="3,4,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="在线设备" FontSize="8" Foreground="#888780"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding OnlineDeviceCountText}" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                                <TextBlock Text=" 台" FontSize="8" Foreground="#888780" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="0,8,3,0" VerticalAlignment="Top">
                                            <TextBlock Text="累计实验" FontSize="8" Foreground="#888780"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ExperimentCountText}" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                                <TextBlock Text=" 次" FontSize="8" Foreground="#888780" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Margin="3,8,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="今日实验" FontSize="8" Foreground="#888780"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
