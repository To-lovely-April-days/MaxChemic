                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A7A49E"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Foreground" Value="#52616B"/></DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsOnline}" Value="True"/>
                                                                            <Condition Binding="{Binding HasFreshData}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <MultiDataTrigger.Setters><Setter Property="Foreground" Value="#B78B45"/></MultiDataTrigger.Setters>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding PrimaryUnit}" FontSize="7" Foreground="#888780" Margin="2,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="4" Text="{Binding ActivityText}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#888780"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Foreground" Value="#1D9E75"/></DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsOnline}" Value="True"/>
                                                                        <Condition Binding="{Binding HasFreshData}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <MultiDataTrigger.Setters><Setter Property="Foreground" Value="#B78B45"/></MultiDataTrigger.Setters>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ContentControl>
                    </Grid>
