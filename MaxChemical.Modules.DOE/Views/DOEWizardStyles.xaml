<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════
         DOE 设计向导 — 靛蓝极简控件库 v2
         严格对齐 DOEWizardMockup.jsx 视觉规范
         ══════════════════════════════════════════════════ -->

    <!-- ═══ 色彩令牌 ═══ -->
    <Color x:Key="IndigoPrimary">#2D3A8C</Color>
    <Color x:Key="IndigoPrimaryDark">#1E2A6E</Color>
    <Color x:Key="IndigoPrimaryLight">#E8EAF6</Color>
    <Color x:Key="IndigoAccent">#3B5BDB</Color>

    <Color x:Key="IndigoText">#1A1F36</Color>
    <Color x:Key="IndigoTextSec">#374151</Color>
    <Color x:Key="IndigoTextMuted">#6B7280</Color>
    <Color x:Key="IndigoTextHint">#9CA3AF</Color>

    <Color x:Key="IndigoBorder">#E2E5EB</Color>
    <Color x:Key="IndigoBorderHover">#C7CCD4</Color>
    <Color x:Key="IndigoBorderFocus">#2D3A8C</Color>

    <Color x:Key="IndigoSurface">#F8F9FB</Color>
    <Color x:Key="IndigoSidebar">#FAFBFC</Color>
    <Color x:Key="IndigoDivider">#E8EAED</Color>

    <Color x:Key="IndigoDanger">#DC2626</Color>
    <Color x:Key="IndigoDangerLight">#FEF2F2</Color>
    <Color x:Key="IndigoSuccess">#059669</Color>
    <Color x:Key="IndigoSuccessLight">#ECFDF5</Color>

    <!-- 阶段色 -->
    <Color x:Key="PhaseScreening">#D97706</Color>
    <Color x:Key="PhaseScreeningBg">#FEF3C7</Color>
    <Color x:Key="PhaseFactorial">#2563EB</Color>
    <Color x:Key="PhaseFactorialBg">#DBEAFE</Color>
    <Color x:Key="PhaseCustom">#6B7280</Color>
    <Color x:Key="PhaseCustomBg">#F3F4F6</Color>

    <SolidColorBrush x:Key="WzPrimary" Color="{StaticResource IndigoPrimary}"/>
    <SolidColorBrush x:Key="WzPrimaryDark" Color="{StaticResource IndigoPrimaryDark}"/>
    <SolidColorBrush x:Key="WzPrimaryLight" Color="{StaticResource IndigoPrimaryLight}"/>
    <SolidColorBrush x:Key="WzAccent" Color="{StaticResource IndigoAccent}"/>
    <SolidColorBrush x:Key="WzText" Color="{StaticResource IndigoText}"/>
    <SolidColorBrush x:Key="WzTextSec" Color="{StaticResource IndigoTextSec}"/>
    <SolidColorBrush x:Key="WzTextMuted" Color="{StaticResource IndigoTextMuted}"/>
    <SolidColorBrush x:Key="WzTextHint" Color="{StaticResource IndigoTextHint}"/>
    <SolidColorBrush x:Key="WzBorder" Color="{StaticResource IndigoBorder}"/>
    <SolidColorBrush x:Key="WzBorderHover" Color="{StaticResource IndigoBorderHover}"/>
    <SolidColorBrush x:Key="WzSurface" Color="{StaticResource IndigoSurface}"/>
    <SolidColorBrush x:Key="WzDivider" Color="{StaticResource IndigoDivider}"/>
    <SolidColorBrush x:Key="WzDanger" Color="{StaticResource IndigoDanger}"/>
    <SolidColorBrush x:Key="WzSuccess" Color="{StaticResource IndigoSuccess}"/>

    <!-- ═══ 文本输入框（独立表单用） ═══ -->
    <Style x:Key="WzTextBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource WzText}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="CaretBrush" Value="{StaticResource WzPrimary}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource WzAccent}"/>
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource WzBorder}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource WzTextHint}" FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       Visibility="Collapsed" IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                                          VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WzBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource IndigoBorderFocus}"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource IndigoPrimary}" BlurRadius="6" ShadowDepth="0" Opacity="0.10"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WzSurface}"/>
                            <Setter Property="Foreground" Value="{StaticResource WzTextHint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WzNumBox" TargetType="TextBox" BasedOn="{StaticResource WzTextBox}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- ═══ 行内紧凑输入框（表格单元格内） ═══ -->
    <Style x:Key="WzCellInput" TargetType="TextBox">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource WzText}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="CaretBrush" Value="{StaticResource WzPrimary}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource WzBorder}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WzBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WzPrimary}"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource IndigoPrimary}" BlurRadius="4" ShadowDepth="0" Opacity="0.08"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WzCellNum" TargetType="TextBox" BasedOn="{StaticResource WzCellInput}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- ═══ 下拉框 ═══ -->
    <Style x:Key="WzComboBox" TargetType="ComboBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource WzText}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="11,8,28,8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource WzBorder}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True"/>
                        <ToggleButton x:Name="ToggleBtn" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,12,0" Width="8" Height="5"
                                              Data="M0,0 L4,5 L8,0" Stroke="{StaticResource WzTextMuted}"
                                              StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" CenterX="4" CenterY="2.5"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="White" CornerRadius="6"
                                    BorderBrush="{StaticResource WzBorder}" BorderThickness="1"
                                    Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.08"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WzBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WzPrimary}"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource IndigoPrimary}" BlurRadius="6" ShadowDepth="0" Opacity="0.10"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WzComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource WzText}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="4">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WzSurface}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WzPrimaryLight}"/>
                            <Setter Property="Foreground" Value="{StaticResource WzPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WzComboCompact" TargetType="ComboBox" BasedOn="{StaticResource WzComboBox}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,6,24,6"/>
    </Style>

    <!-- ═══ 复选框 ═══ -->
    <Style x:Key="WzCheckBox" TargetType="CheckBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource WzText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,0,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                Background="White" BorderBrush="{StaticResource WzBorderHover}" BorderThickness="1">
                            <Path x:Name="Check" Data="M3,8 L6.5,11.5 L13,4" Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="16" Height="16" Stretch="None" Visibility="Collapsed"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource WzPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource WzPrimary}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource WzPrimary}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ 单选按钮（隐藏圆圈，纯卡片模式） ═══ -->
    <Style x:Key="WzRadio" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource WzText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- 没有圆圈指示器，纯内容 -->
                    <ContentPresenter VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ 主按钮（靛蓝填充） ═══ -->
    <Style x:Key="WzBtnPrimary" TargetType="Button">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="22,9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource WzPrimary}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WzPrimaryDark}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Bd" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ 次要按钮（描边） ═══ -->
    <Style x:Key="WzBtnGhost" TargetType="Button">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource WzTextSec}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="18,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            BorderBrush="{StaticResource WzBorderHover}" BorderThickness="0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WzSurface}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ 虚线添加按钮 ═══ -->
    <Style x:Key="WzBtnAdd" TargetType="Button">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource WzTextMuted}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0,9"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" BorderThickness="1"
                            BorderBrush="{StaticResource WzBorderHover}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource WzBorderHover}"/>
                            </Style>
                        </Border.Style>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WzSurface}"/>
                            <Setter Property="Foreground" Value="{StaticResource WzPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ 删除按钮（×，hover 红底） ═══ -->
    <Style x:Key="WzBtnDel" TargetType="Button">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="{StaticResource WzTextHint}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                            Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                        <TextBlock Text="×" FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource IndigoDangerLight}"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource IndigoDanger}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ 配置参数按钮（卡片选中后出现） ═══ -->
    <Style x:Key="WzBtnCfg" TargetType="Button">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource WzPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            BorderBrush="{StaticResource WzPrimary}" BorderThickness="0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{StaticResource IndigoPrimaryLight}" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ 步骤徽章 ═══ -->
    <Style x:Key="WzStepBadge" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource WzPrimary}"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <!-- ═══ 字段标签 ═══ -->
    <Style x:Key="WzLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource WzTextSec}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ═══ 字段提示 ═══ -->
    <Style x:Key="WzHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource WzTextHint}"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>

    <!-- ═══ Drawer 字段标签（比 WzLabel 间距更大） ═══ -->
    <Style x:Key="WzDrawerLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource WzTextSec}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>

    <!-- ═══ 侧栏导航项 ═══ -->
    <Style x:Key="WzNavItem" TargetType="Border">
        <Setter Property="Padding" Value="20,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="2.5,0,0,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#08000000"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ 设计方法选择卡片（Step2） ═══ -->
    <Style x:Key="WzMethodCard" TargetType="Border">
        <Setter Property="Padding" Value="14,14,16,14"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="BorderBrush" Value="{StaticResource WzDivider}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource WzBorderHover}"/>
                <Setter Property="Background" Value="#FDFDFE"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ 表格容器（圆角白底 + 细边框） ═══ -->
    <Style x:Key="WzTableContainer" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource WzDivider}"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- ═══ DataGrid 行样式 ═══ -->
    <Style x:Key="WzGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource WzDivider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
        <Setter Property="MinHeight" Value="38"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource WzSurface}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══ DataGrid 列头样式 ═══ -->
    <Style x:Key="WzColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FAFBFC"/>
        <Setter Property="Foreground" Value="{StaticResource WzTextHint}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="{StaticResource WzDivider}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- ═══ 进度条段 ═══ -->
    <Style x:Key="WzProgressSeg" TargetType="Border">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="CornerRadius" Value="1.5"/>
        <Setter Property="Background" Value="{StaticResource WzDivider}"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>

    <Style x:Key="WzProgressSegDone" TargetType="Border" BasedOn="{StaticResource WzProgressSeg}">
        <Setter Property="Background" Value="{StaticResource WzPrimary}"/>
    </Style>

    <!-- ═══ 抽屉面板确认按钮 ═══ -->
    <Style x:Key="WzBtnDrawerConfirm" TargetType="Button">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource WzPrimary}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WzPrimaryDark}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ 抽屉面板关闭按钮 ═══ -->
    <Style x:Key="WzBtnDrawerClose" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Width="28" Height="28">
                        <TextBlock Text="✕" FontSize="15" Foreground="{StaticResource WzTextHint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource WzSurface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ═══════════════════════════════════════════════════════════
         ScrollBar 极简风格 — 细轨道 + 圆角滑块 + hover 加深
         适用于 DataGrid / ScrollViewer / ListBox 等所有滚动容器
         ═══════════════════════════════════════════════════════════ -->

    <!-- 滑块 Thumb（垂直） -->
    <Style x:Key="WzScrollThumbV" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd" Background="#C7CCD4" CornerRadius="3"
                            Width="6" Margin="0,1" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="#9CA3AF"/>
                            <Setter TargetName="ThumbBd" Property="Width" Value="8"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="#6B7280"/>
                            <Setter TargetName="ThumbBd" Property="Width" Value="8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 滑块 Thumb（水平） -->
    <Style x:Key="WzScrollThumbH" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd" Background="#C7CCD4" CornerRadius="3"
                            Height="6" Margin="1,0" SnapsToDevicePixels="True"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="#9CA3AF"/>
                            <Setter TargetName="ThumbBd" Property="Height" Value="8"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="#6B7280"/>
                            <Setter TargetName="ThumbBd" Property="Height" Value="8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 轨道两端的翻页按钮（透明占位，不显示箭头） -->
    <Style x:Key="WzScrollPageBtn" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 垂直 ScrollBar -->
    <Style x:Key="WzScrollBarV" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent" Width="10" Padding="1,0">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource WzScrollPageBtn}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource WzScrollThumbV}" MinHeight="20"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource WzScrollPageBtn}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 水平 ScrollBar -->
    <Style x:Key="WzScrollBarH" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent" Height="10" Padding="0,1">
                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource WzScrollPageBtn}" Command="ScrollBar.PageLeftCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource WzScrollThumbH}" MinWidth="20"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource WzScrollPageBtn}" Command="ScrollBar.PageRightCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ ScrollViewer（DataGrid 内部自动套用） ═══ -->
    <Style x:Key="WzScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Row="0" Grid.Column="1"
                                   Style="{StaticResource WzScrollBarV}"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource WzScrollBarH}"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ DataGrid 专用样式（含 ScrollViewer 覆盖） ═══ -->
    <Style x:Key="WzDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource WzDivider}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="RowStyle" Value="{StaticResource WzGridRow}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="RowHeight" Value="44"/>
        <Setter Property="ColumnHeaderHeight" Value="34"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <!-- 列头（表头）：靛蓝浅底 + 靛蓝深字，与主表正文(近黑)区分但同色系协调 -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E8EAF6"/>
                    <Setter Property="Foreground" Value="#2D3A8C"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="BorderBrush" Value="#C5CAE9"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="SeparatorVisibility" Value="Collapsed"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGrid">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                            <!-- 自定义 ScrollViewer 模板：显式包含 DataGridColumnHeadersPresenter，
                                 否则表头(列标题)不会被渲染。行 0=表头，行 1=内容，行 2=横向滚动条 -->
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                                        Grid.Row="0" Grid.Column="0"
                                                                        Visibility="{Binding HeadersVisibility,
                                                                            RelativeSource={RelativeSource AncestorType=DataGrid},
                                                                            Converter={x:Static DataGrid.HeadersVisibilityConverter},
                                                                            ConverterParameter={x:Static DataGridHeadersVisibility.Column}}"/>

                                        <ScrollContentPresenter Grid.Row="1" Grid.Column="0"
                                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>

                                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                                   Grid.Row="1" Grid.Column="1"
                                                   Style="{StaticResource SharedScrollBarV}"
                                                   Orientation="Vertical"
                                                   Value="{TemplateBinding VerticalOffset}"
                                                   Maximum="{TemplateBinding ScrollableHeight}"
                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                   Grid.Row="2" Grid.Column="0"
                                                   Style="{StaticResource SharedScrollBarH}"
                                                   Orientation="Horizontal"
                                                   Value="{TemplateBinding HorizontalOffset}"
                                                   Maximum="{TemplateBinding ScrollableWidth}"
                                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ScrollViewer.CanContentScroll>True</ScrollViewer.CanContentScroll>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
