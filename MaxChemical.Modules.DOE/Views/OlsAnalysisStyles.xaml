<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════ -->
    <!--  靛蓝深邃 (Indigo Deep) 主题色                -->
    <!-- ═══════════════════════════════════════════ -->
    <Color x:Key="IndigoPrimary">#2D3A8C</Color>
    <Color x:Key="IndigoAccent">#3949AB</Color>
    <Color x:Key="IndigoLight">#E8EAF6</Color>
    <Color x:Key="IndigoMid">#7986CB</Color>
    <Color x:Key="RedSignificant">#B71C1C</Color>
    <Color x:Key="RedLight">#FFEBEE</Color>

    <SolidColorBrush x:Key="Indigo" Color="{StaticResource IndigoPrimary}"/>
    <SolidColorBrush x:Key="IndigoAcc" Color="{StaticResource IndigoAccent}"/>
    <SolidColorBrush x:Key="IndigoLt" Color="{StaticResource IndigoLight}"/>
    <SolidColorBrush x:Key="IndigoMd" Color="{StaticResource IndigoMid}"/>
    <SolidColorBrush x:Key="RedSig" Color="{StaticResource RedSignificant}"/>
    <SolidColorBrush x:Key="RedLt" Color="{StaticResource RedLight}"/>

    <!-- ═══ 通用色 ═══ -->
    <SolidColorBrush x:Key="OlsBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OlsSurface" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="OlsBorder" Color="#E2E5EB"/>
    <SolidColorBrush x:Key="OlsBorderLight" Color="#ECEEF2"/>
    <SolidColorBrush x:Key="OlsText" Color="#1A1F36"/>
    <SolidColorBrush x:Key="OlsTextSec" Color="#6B7280"/>
    <SolidColorBrush x:Key="OlsTextHint" Color="#9CA3AF"/>

    <!-- ═══════════════════════════════════════════ -->
    <!--  标题栏                                      -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsTitleBar" TargetType="Border">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="{StaticResource OlsBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OlsBorderLight}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  工具栏按钮                                   -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsToolBtn" TargetType="Button">
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource OlsTextSec}"/>
        <Setter Property="Background" Value="{StaticResource OlsBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OlsBorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource OlsSurface}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource OlsBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource OlsBorderLight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作按钮（靛蓝实心） -->
    <Style x:Key="OlsPrimaryBtn" TargetType="Button" BasedOn="{StaticResource OlsToolBtn}">
        <Setter Property="Background" Value="{StaticResource Indigo}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Indigo}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="#1A237E"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  编码/未编码 滑块开关 (ToggleButton)          -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsPillSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="124"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="14" Background="{StaticResource OlsSurface}"
                            BorderBrush="{StaticResource OlsBorderLight}" BorderThickness="1">
                        <Grid>
                            <!-- 滑块 pill -->
                            <Border x:Name="Pill" Width="60" Height="22" CornerRadius="11"
                                    Background="{StaticResource OlsBg}" BorderBrush="{StaticResource OlsBorder}"
                                    BorderThickness="0.5" HorizontalAlignment="Left" Margin="2,0,0,0"
                                    VerticalAlignment="Center"/>
                            <!-- 文字 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LeftText" Grid.Column="0" Text="编码"
                                           FontSize="10" FontWeight="Medium" Foreground="{StaticResource Indigo}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RightText" Grid.Column="1" Text="未编码"
                                           FontSize="10" Foreground="{StaticResource OlsTextHint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Margin" Value="62,0,0,0"/>
                            <Setter TargetName="LeftText" Property="Foreground" Value="{StaticResource OlsTextHint}"/>
                            <Setter TargetName="LeftText" Property="FontWeight" Value="Normal"/>
                            <Setter TargetName="RightText" Property="Foreground" Value="{StaticResource Indigo}"/>
                            <Setter TargetName="RightText" Property="FontWeight" Value="Medium"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  Tab 样式                                    -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsTab" TargetType="RadioButton">
        <Setter Property="Padding" Value="13,9"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource OlsTextHint}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="TabBd" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TabBd" Property="BorderBrush" Value="{StaticResource IndigoAcc}"/>
                            <Setter Property="Foreground" Value="{StaticResource Indigo}"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBd" Property="Background" Value="{StaticResource OlsSurface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  Section Header                              -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsSectionHeader" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OlsSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OlsBorderLight}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="14,7"/>
    </Style>

    <!-- R² Badge -->
    <Style x:Key="OlsBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource IndigoLt}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="9,2"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  KPI 格子                                    -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsKpiLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="{StaticResource OlsTextHint}"/>
    </Style>

    <Style x:Key="OlsKpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="Foreground" Value="{StaticResource OlsText}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  Pareto Checkbox                             -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsCheckBox" TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
        <Style.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource IndigoAccent}"/>
        </Style.Resources>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  底部操作按钮（小号）                          -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsFooterBtn" TargetType="Button" BasedOn="{StaticResource OlsToolBtn}">
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style x:Key="OlsFooterPrimaryBtn" TargetType="Button" BasedOn="{StaticResource OlsPrimaryBtn}">
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  图表卡片（残差四合一用）                      -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsChartCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OlsBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OlsBorderLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="OlsChartTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource OlsTextSec}"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  状态栏                                      -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsStatusBar" TargetType="Border">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="{StaticResource OlsSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OlsBorderLight}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  ComboBox 紧凑样式                            -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsCombo" TargetType="ComboBox">
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderBrush" Value="{StaticResource OlsBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource OlsBg}"/>
        <Setter Property="Foreground" Value="{StaticResource OlsText}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="6" Background="{StaticResource OlsBg}"
                                            BorderBrush="{StaticResource OlsBorder}" BorderThickness="1"
                                            Padding="8,0" SnapsToDevicePixels="True">
                                        <Grid>
                                            <ContentPresenter/>
                                            <Path x:Name="Arrow" Data="M0,0 L4,4 L8,0" Stroke="{StaticResource OlsTextHint}"
                                                  StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,1,0,0"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource IndigoAcc}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Indigo}"/>
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource IndigoLt}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="8,0,28,0"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          VerticalAlignment="Center"/>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" PopupAnimation="Slide">
                            <Border x:Name="DropDown" Background="White" BorderBrush="{StaticResource OlsBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="2"
                                    MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000" BlurRadius="8" ShadowDepth="2" Opacity="0.08"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource IndigoLt}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource IndigoLt}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Indigo}"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  靛蓝 Slider                                 -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!-- 轨道背景 -->
                        <Border x:Name="TrackBg" Height="3" CornerRadius="1.5" Background="#E5E7EB"
                                VerticalAlignment="Center" Margin="6,0"/>
                        <!-- 已填充部分 -->
                        <Canvas VerticalAlignment="Center" Height="3" Margin="6,0">
                            <Border x:Name="Fill" Height="3" CornerRadius="1.5"
                                    Background="{StaticResource IndigoAcc}" Canvas.Left="0"
                                    Width="0"/>
                        </Canvas>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse x:Name="ThumbOuter" Width="16" Height="16"
                                                         Fill="White" Stroke="{StaticResource IndigoAcc}"
                                                         StrokeThickness="2"/>
                                                <Ellipse x:Name="ThumbInner" Width="6" Height="6"
                                                         Fill="{StaticResource IndigoAcc}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbOuter" Property="Stroke" Value="{StaticResource Indigo}"/>
                                                    <Setter TargetName="ThumbInner" Property="Fill" Value="{StaticResource Indigo}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbOuter" Property="Width" Value="18"/>
                                                    <Setter TargetName="ThumbOuter" Property="Height" Value="18"/>
                                                    <Setter TargetName="ThumbOuter" Property="Fill" Value="{StaticResource IndigoLt}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  靛蓝 DataGrid（ANOVA/系数/异常点/Tukey 统一） -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="OlsDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F8F9FB"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="CanUserSortColumns" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="RowHeight" Value="30"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource Indigo}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="BorderThickness" Value="0,0,0.5,0"/>
                    <Setter Property="BorderBrush" Value="#3949AB"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Foreground" Value="#1F2937"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource IndigoLt}"/>
                            <Setter Property="Foreground" Value="{StaticResource Indigo}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                    <Setter Property="BorderBrush" Value="#F0F1F3"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F2FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- P值标红文本样式（DataGridTextColumn.ElementStyle 用） -->
    <Style x:Key="OlsPValueCell" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Foreground" Value="#1F2937"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSignificant}" Value="True">
                <Setter Property="Foreground" Value="#B71C1C"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 右对齐数值文本 -->
    <Style x:Key="OlsNumCell" TargetType="TextBlock">
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- 左对齐项名文本 -->
    <Style x:Key="OlsTermCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

</ResourceDictionary>

