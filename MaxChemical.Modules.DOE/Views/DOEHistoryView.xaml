<UserControl x:Class="MaxChemical.Modules.DOE.Views.DOEHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8F9FB">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DOEWizardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Margin="22" CornerRadius="12" ClipToBounds="True"
            BorderBrush="{StaticResource WzDivider}" BorderThickness="0.5"
            Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ 左侧: 项目 / 批次 树形列表 ═══ -->
            <Border Grid.Column="0" CornerRadius="0" ClipToBounds="True"
                    BorderBrush="{StaticResource WzDivider}" BorderThickness="0,0,0.5,0"
                    Background="{StaticResource WzSurface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Border Grid.Row="0" Padding="18,14" Background="White"
                        BorderBrush="{StaticResource WzDivider}" BorderThickness="0,0,0,0.5">
                        <Grid>
                            <TextBlock Text="{Binding ProjBatchTxt}" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource WzText}"/>
                            <Button Content="{Binding RefreshTxt}" HorizontalAlignment="Right" FontSize="10"
                                Foreground="{StaticResource WzAccent}" Cursor="Hand"
                                Command="{Binding RefreshCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="Tb" Text="{TemplateBinding Content}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="{TemplateBinding FontSize}" Cursor="Hand"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tb" Property="Foreground" Value="{StaticResource WzPrimaryDark}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 项目+批次 树形列表 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Style="{StaticResource WzScrollViewer}">
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- ── 项目行（展开/折叠） ── -->
                                        <Border Padding="18,10" Cursor="Hand" Background="White"
                                            BorderBrush="#F2F3F5" BorderThickness="0,0,0,0.5">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                Command="{Binding DataContext.SelectProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FAFBFC"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="17"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 展开/折叠箭头 -->
                                                <Path Grid.Column="0" VerticalAlignment="Center"
                                                  StrokeThickness="1.3" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" Fill="Transparent"
                                                  Data="{Binding ChevronData}" Stroke="{Binding ChevronColor}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding ProjectName}" FontSize="11" FontWeight="Medium"
                                                           Foreground="{Binding ProjectNameColor}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="9" Foreground="{Binding SubtitleColor}" Margin="0,1,0,0">
                                                    <Run Text="{Binding PhaseText, Mode=OneWay}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding TotalBatches, Mode=OneWay}"/>
                                                    <Run Text="{Binding BatchTxt,StringFormat='{}{0} · '}"/>
                                                    <Run Text="{Binding TotalExperiments, Mode=OneWay}"/>
                                                        <Run Text="{Binding GroupTxt}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- ── 批次子列表（选中项目时展开） ── -->
                                        <ItemsControl ItemsSource="{Binding Batches}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="18,9,18,9" Cursor="Hand" Background="White"
                                                        BorderThickness="2.5,0,0,0">
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick"
                                                            Command="{Binding DataContext.SelectRoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                        </Border.InputBindings>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                                <Setter Property="Background" Value="White"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Background">
                                                                            <Setter.Value>
                                                                                <SolidColorBrush Color="{StaticResource IndigoPrimaryLight}"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="BorderBrush">
                                                                            <Setter.Value>
                                                                                <SolidColorBrush Color="{StaticResource IndigoPrimary}"/>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Background" Value="#FAFBFC"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid Margin="16,0,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 编号圆 -->
                                                            <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{Binding PhaseColor}"/>
                                                                </Border.Background>
                                                                <TextBlock Text="{Binding RoundNumber}" FontSize="9" FontWeight="Medium"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- 批次信息 -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DesignMethodText}" FontSize="10.5"
                                                                       FontWeight="Medium"
                                                                       Foreground="{Binding TitleColor}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock FontSize="9" Margin="0,1,0,0"
                                                                       Foreground="{Binding SubtitleColor}">
                                                                <Run Text="{Binding ProgressText, Mode=OneWay}"/>
                                                                <Run Text="{Binding GroupTxt}"/>
                                                                <Run Text="{Binding RSquaredDisplayText, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <!-- 状态药丸 -->
                                                            <Border Grid.Column="2" CornerRadius="4" Padding="7,2"
                                                                VerticalAlignment="Center">
                                                                <Border.Background>
                                                                    <SolidColorBrush Color="{Binding StatusBgColor}"/>
                                                                </Border.Background>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="Medium">
                                                                    <TextBlock.Foreground>
                                                                        <SolidColorBrush Color="{Binding StatusFgColor}"/>
                                                                    </TextBlock.Foreground>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 底部状态 -->
                    <Border Grid.Row="2" Padding="18,10" Background="White"
                        BorderBrush="{StaticResource WzDivider}" BorderThickness="0,0.5,0,0">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10"
                               Foreground="{StaticResource WzTextHint}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 右侧: 批次详情 + 数据表 ═══ -->
            <Border Grid.Column="1" CornerRadius="0" ClipToBounds="True"
                BorderThickness="0"
                Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── 批次头部（面包屑 + 标题 + 操作按钮） ── -->
                    <Border Grid.Row="0" Padding="20,14"
                        BorderBrush="{StaticResource WzDivider}" BorderThickness="0,0,0,0.5"
                        Visibility="{Binding HasSelectedRound, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- 面包屑 -->
                                <TextBlock FontSize="10" Foreground="{StaticResource WzTextMuted}">
                                <Run Text="{Binding SelectedProject.ProjectName, Mode=OneWay}"/>
                                <Run Text=" ›"/>
                                </TextBlock>
                                <!-- 标题行 + 药丸 -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedRoundTitle}" FontSize="14"
                                           FontWeight="Medium" Foreground="{StaticResource WzText}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <!-- 阶段药丸 -->
                                    <Border CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <Border.Background>
                                            <SolidColorBrush Color="{StaticResource IndigoPrimaryLight}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding SelectedRound.PhaseText}" FontSize="9" FontWeight="Medium"
                                               Foreground="{StaticResource WzPrimary}"/>
                                    </Border>
                                    <!-- 状态药丸 -->
                                    <Border CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                        <Border.Background>
                                            <SolidColorBrush Color="{Binding SelectedRound.StatusBgColor}"/>
                                        </Border.Background>
                                        <TextBlock Text="{Binding SelectedRound.StatusText}" FontSize="9" FontWeight="Medium">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding SelectedRound.StatusFgColor}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <!-- 统计行 -->
                                <TextBlock FontSize="10" Foreground="{StaticResource WzTextMuted}" Margin="0,4,0,0">
                                <Run Text="{Binding SelectedRoundRunCount, Mode=OneWay}"/><Run Text="{Binding GroupsPeriTxt}"/>
                                <Run Text=" · R² = "/>
                                <Run Text="{Binding SelectedRoundR2Text, Mode=OneWay}"
                                     FontWeight="Medium" Foreground="{StaticResource WzSuccess}"/>
                                <Run Text="{Binding SelectedRoundDateText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- 操作按钮 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding JumpExecTxt}" Padding="14,6" FontSize="10" FontWeight="Medium"
                                    Cursor="Hand" Margin="0,0,5,0"
                                    Command="{Binding NavigateToExecutionCommand}"
                                    Style="{StaticResource WzBtnPrimary}"/>
                                <Button Content="{Binding ViewAnalysisTxt}" Padding="14,6" FontSize="10" Cursor="Hand" Margin="0,0,5,0"
                                    Command="{Binding NavigateToAnalysisCommand}"
                                    Style="{StaticResource WzBtnGhost}"/>
                                <Button Content="{Binding ExportTxt}" Padding="14,6" FontSize="10" Cursor="Hand" Margin="0,0,5,0"
                                    Command="{Binding ExportRoundCommand}" CommandParameter="{Binding SelectedRound}"
                                    Style="{StaticResource WzBtnGhost}"/>
                                <Button Content="{Binding DeleteTxt}" Padding="14,6" FontSize="10" Cursor="Hand"
                                    Command="{Binding DeleteRoundCommand}" CommandParameter="{Binding SelectedRound}"
                                    Foreground="{StaticResource WzTextMuted}"
                                    Style="{StaticResource WzBtnGhost}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── 数据表 ── -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedRoundRuns.DefaultView}"
                          AutoGenerateColumns="True" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F2F3F5"
                          HeadersVisibility="Column" BorderThickness="0"
                          Background="White" AlternationCount="2"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          FontSize="11" Foreground="{StaticResource WzText}"
                          ColumnWidth="*"
                          Visibility="{Binding HasSelectedRound, Converter={StaticResource BoolToVis}}"
                          Style="{StaticResource WzDataGrid}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FAFBFC"/>
                                <Setter Property="Foreground" Value="{StaticResource WzTextHint}"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Padding" Value="10,0,10,0"/>
                                <Setter Property="Height" Value="32"/>
                                <Setter Property="BorderBrush" Value="{StaticResource WzDivider}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                                <Setter Property="SeparatorVisibility" Value="Collapsed"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{StaticResource IndigoPrimaryLight}"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="{StaticResource WzText}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Height" Value="34"/>
                                <Setter Property="BorderBrush" Value="#F2F3F5"/>
                                <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#FAFBFC"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WzSurface}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{StaticResource IndigoPrimaryLight}"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- 未选中提示 -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedRound}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding UnselectTxt}" FontSize="13"
                               Foreground="{StaticResource WzTextHint}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
