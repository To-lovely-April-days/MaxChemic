<UserControl x:Class="MaxChemical.Modules.DOE.Views.DOEOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F8">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DOEStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="IndPrimary">#2D3A8C</Color>
            <Color x:Key="IndAccent">#3949AB</Color>
            <Color x:Key="IndLight">#E8EAF6</Color>
            <Color x:Key="IndMid">#C5CAE9</Color>
            <SolidColorBrush x:Key="IndPrimaryBrush" Color="{StaticResource IndPrimary}"/>
            <SolidColorBrush x:Key="IndAccentBrush" Color="{StaticResource IndAccent}"/>
            <SolidColorBrush x:Key="IndLightBrush" Color="{StaticResource IndLight}"/>
            <SolidColorBrush x:Key="IndMidBrush" Color="{StaticResource IndMid}"/>
            <SolidColorBrush x:Key="OvBorder" Color="#ECEDF1"/>
            <SolidColorBrush x:Key="OvBorder2" Color="#E2E5EB"/>
            <SolidColorBrush x:Key="OvText" Color="#1A1F36"/>
            <SolidColorBrush x:Key="OvTextSec" Color="#8A8F9C"/>
            <SolidColorBrush x:Key="OvTextHint" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="OvTextMuted" Color="#B0B8C4"/>
            <SolidColorBrush x:Key="OvSurface" Color="#FAFAFC"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: 顶部栏 ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding TitleTxt}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource OvText}"/>
                <TextBlock FontSize="10.5" Foreground="{StaticResource OvTextHint}" Margin="0,2,0,0">
                    <Run Text="{Binding ActiveProjectCount, Mode=OneWay}"/>
                    <Run Text="{Binding ProjCountTxt,StringFormat='{}{0} · '}"/>
                    <Run Text="{Binding TotalExperiments, Mode=OneWay}"/>
                    <Run Text="{Binding ItemCountTxt}"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,8,0" Cursor="Hand" Command="{Binding GoToHistoryCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="White" CornerRadius="7" Padding="14,6"
                                    BorderBrush="{StaticResource OvBorder2}" BorderThickness="1">
                                <TextBlock Text="{Binding HistoryTxt}" FontSize="10.5" FontWeight="SemiBold" Foreground="#6B7280"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F7F8FA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Cursor="Hand"
                        Command="{Binding DataContext.CreateProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource IndPrimaryBrush}" CornerRadius="7" Padding="16,6">
                                <TextBlock Text="{Binding NewProjTxt,StringFormat='+ {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1A237E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ Row 1: 焦点项目大卡片（绑定 FocusedProject） ═══ -->
        <Border Grid.Row="1" CornerRadius="14" Background="White"
                BorderBrush="{StaticResource OvBorder2}" BorderThickness="1"
                Margin="0,0,0,12" ClipToBounds="True"
                Visibility="{Binding HasProjects, Converter={StaticResource BoolToVis}}"
                DataContext="{Binding FocusedProject}"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">

            <Border.ContextMenu>
                <ContextMenu Style="{StaticResource DOEContextMenu}">
                    <MenuItem Header="{Binding PlacementTarget.Tag.ViewDetails,RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}"
                              Command="{Binding PlacementTarget.Tag.ViewProjectDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding ProjectId}"/>
                    <!--<MenuItem Header="{Binding PlacementTarget.Tag.ViewAnalysis,RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}"
                              Command="{Binding PlacementTarget.Tag.ViewProjectAnalysisCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding ProjectId}"/>-->
                    <MenuItem Header="{Binding PlacementTarget.Tag.ViewHistory,RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}"
                              Command="{Binding PlacementTarget.Tag.ViewProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding ProjectId}"/>
                    <Separator/>
                    <MenuItem Header="{Binding PlacementTarget.Tag.ProjArchive,RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}"
                              Command="{Binding PlacementTarget.Tag.ArchiveProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding ProjectId}"/>
                    <MenuItem Header="{Binding PlacementTarget.Tag.DeleteProj,RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}" Foreground="#D32F2F"
                              Command="{Binding PlacementTarget.Tag.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding ProjectId}"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58*"/>
                    <ColumnDefinition Width="42*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 左侧 58% ── -->
                <StackPanel Grid.Column="0" Margin="24,20,16,20">
                    <!-- 阶段徽章 -->
                    <Border HorizontalAlignment="Left" Padding="10,3" CornerRadius="5" Margin="0,0,0,6">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding PhaseColor}" Opacity="0.12"/>
                        </Border.Background>
                        <TextBlock Text="{Binding PhaseText}" FontSize="10" FontWeight="SemiBold">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="{Binding PhaseColor}"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                    <!-- 项目名 -->
                    <TextBlock Text="{Binding ProjectName}" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource OvText}" Margin="0,0,0,2"/>
                    <!-- 描述 -->
                    <TextBlock Text="{Binding DetailSummaryText}" FontSize="11"
                               Foreground="{StaticResource OvTextSec}" Margin="0,0,0,12"/>
                    <!-- KPI -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="{Binding BestValueText}" FontSize="22" FontWeight="Bold"
                                       FontFamily="Consolas" Foreground="{StaticResource IndPrimaryBrush}"/>
                            <TextBlock Text="{Binding DataContext.ProdRateTxt,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="8" Foreground="{StaticResource OvTextMuted}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource OvBorder}" Margin="0,3,18,3"/>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="{Binding TotalBatches}" FontSize="22" FontWeight="Bold"
                                       FontFamily="Consolas" Foreground="{StaticResource OvText}"/>
                            <TextBlock Text="{Binding DataContext.RoundTxt,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="8" Foreground="{StaticResource OvTextMuted}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Border Width="1" Background="{StaticResource OvBorder}" Margin="0,3,18,3"/>
                        <StackPanel>
                            <TextBlock Text="{Binding TotalExperiments}" FontSize="22" FontWeight="Bold"
                                       FontFamily="Consolas" Foreground="{StaticResource OvText}"/>
                            <TextBlock Text="{Binding DataContext.ExperiTxt,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="8" Foreground="{StaticResource OvTextMuted}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 最优因子组合 -->
                    <TextBlock Text="{Binding DataContext.FactorTxt,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OvTextSec}"
                               Margin="0,0,0,5"/>
                    <ItemsControl ItemsSource="{Binding OptimalFactorItems}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F8FA" CornerRadius="5" Padding="8,4" Margin="0,0,4,4">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   FontSize="11" FontWeight="SemiBold" FontFamily="Consolas" Foreground="{StaticResource OvText}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="{StaticResource OvTextHint}"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 响应值 -->
                    <TextBlock Text="{Binding DataContext.ResponseTxt,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource OvTextSec}"
                               Margin="0,0,0,5"/>
                    <ItemsControl ItemsSource="{Binding ResponseValueItems}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F8FA" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                    <DockPanel MinWidth="80">
                                        <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                   FontSize="13" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource IndPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="{StaticResource OvTextHint}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 进度条 -->
                    <ItemsControl ItemsSource="{Binding PhaseSegments}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="32" Height="4" CornerRadius="2" Margin="0,0,3,0" Background="{Binding Color}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 创建/更新时间 -->
                    <TextBlock FontSize="8.5" Foreground="{StaticResource OvTextMuted}" Margin="0,0,0,10">
                        <Run Text="{Binding DataContext.CreateInTxt,RelativeSource={RelativeSource AncestorType=UserControl}}"/><Run Text="{Binding CreatedTime, StringFormat=MM-dd, Mode=OneWay}"/>
                        <Run Text="{Binding DataContext.UpdateOnTxt,RelativeSource={RelativeSource AncestorType=UserControl},StringFormat=' · {0} '}"/><Run Text="{Binding UpdatedTime, StringFormat=MM-dd HH:mm, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal">
                        <Button Cursor="Hand" Margin="0,0,6,0"
                                Visibility="{Binding CanContinue, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.ContinueProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding ProjectId}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource IndPrimaryBrush}" CornerRadius="7" Padding="16,7">
                                        <TextBlock Text="{Binding DataContext.ContinueTxt,RelativeSource={RelativeSource AncestorType=UserControl},StringFormat='{}{0} →'}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1A237E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Cursor="Hand" Margin="0,0,6,0"
                                Command="{Binding DataContext.ViewProjectDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding ProjectId}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="White" CornerRadius="7" Padding="14,7"
                                            BorderBrush="#D5D9E2" BorderThickness="1">
                                        <TextBlock x:Name="Tx" Text="{Binding DataContext.DetailTxt,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F7F8FA"/>
                                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource OvText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Cursor="Hand" Visibility="Collapsed"
                                Command="{Binding DataContext.ViewProjectAnalysisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding ProjectId}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="White" CornerRadius="7" Padding="14,7"
                                            BorderBrush="#D5D9E2" BorderThickness="1">
                                        <TextBlock x:Name="Tx" Text="{Binding DataContext.AnalysisTxt,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F7F8FA"/>
                                            <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource OvText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- ── 右侧 42%：恢复 or 时间线 ── -->
                <Border Grid.Column="1" Background="{StaticResource OvSurface}"
                        BorderBrush="{StaticResource OvBorder}" BorderThickness="1,0,0,0">
                    <Grid>
                        <!-- 状态 A：有恢复批次（简洁版） -->
                        <Border Padding="20,18"
                                Visibility="{Binding DataContext.HasResumableBatch, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DataContext.WaitResumeTxt,RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="9" FontWeight="Bold" Foreground="{StaticResource OvTextSec}" Margin="0,0,0,14"/>
                                <TextBlock Text="{Binding DataContext.ResumableBatchSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OvText}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding DataContext.ResumableProgressText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="20" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource IndPrimaryBrush}" Margin="0,0,0,16"/>
                                <Button Cursor="Hand" HorizontalAlignment="Stretch"
                                        Command="{Binding DataContext.ResumeLastBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{StaticResource IndAccentBrush}" CornerRadius="7" Padding="0,9">
                                                <TextBlock Text="{Binding DataContext.ResumeExecute,RelativeSource={RelativeSource AncestorType=UserControl},StringFormat='{}{0} →'}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource IndPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 状态 B：无恢复批次 → 最近 4 轮时间线 -->
                        <Border Padding="18,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.HasResumableBatch, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding DataContext.OptimizTxt,RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OvTextSec}"/>
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Cursor="Hand"
                                            Command="{Binding DataContext.ViewProjectDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ProjectId}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock x:Name="Tx" FontSize="9" Foreground="{StaticResource IndAccentBrush}" FontWeight="Medium">
                                                    <Run Text="{Binding DataContext.AllTxt,RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    <Run Text="{Binding TotalBatches, Mode=OneWay}"/>
                                                    <Run Text="{Binding DataContext.RoundsTxt,RelativeSource={RelativeSource AncestorType=UserControl},StringFormat='{} {0} →'}"/>
                                                </TextBlock>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tx" Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding DataContext.RecentTimelineItems, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="50">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Border Width="1.5" Background="#E2E5EB" HorizontalAlignment="Center"
                                                            Visibility="{Binding ShowLine, Converter={StaticResource BoolToVis}}"/>
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,3,0,0" HorizontalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#9FA8DA"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                                        <Setter Property="Fill" Value="#2D3A8C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,6">
                                                    <TextBlock Text="{Binding RoundLabel}" FontSize="9.5" FontWeight="Bold"
                                                               Foreground="#2D3A8C" Margin="0,0,0,1"/>
                                                    <TextBlock Text="{Binding EventText}" FontSize="9.5" Foreground="#1A1F36"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="26"/>
                                                    <TextBlock Text="{Binding MetaText}" FontSize="8" Foreground="#B0B8C4" Margin="0,1,0,0"/>
                                                    <Border Padding="4,1" CornerRadius="3" HorizontalAlignment="Left" Margin="0,2,0,0"
                                                            Background="{Binding ChipBackground}"
                                                            Visibility="{Binding HasChip, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding ChipText}" FontSize="7.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding ChipForeground}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ Row 2: 底部卡片网格 ═══ -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasProjects, Converter={StaticResource BoolToVis}}"
                          Style="{StaticResource ThinScrollViewerStyle}">
                <ItemsControl ItemsSource="{Binding BottomCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,8,8">
                                <!-- ═══ 新建项目卡片 ═══ -->
                                <Border CornerRadius="10" Background="White" Cursor="Hand"
                                        BorderBrush="{StaticResource IndMidBrush}" BorderThickness="1"
                                        MouseLeftButtonDown="NewProjectCard_Click" MinHeight="100">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNewPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FAFAFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="8" HorizontalAlignment="Center"
                                                Background="{StaticResource IndLightBrush}" Margin="0,0,0,6">
                                            <TextBlock Text="＋" FontSize="15" Foreground="{StaticResource IndAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding DataContext.NewProjTxt, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#6B7280" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ 普通项目卡片 ═══ -->
                                <Border CornerRadius="10" Background="White"
                                        BorderThickness="1" Padding="14,12" Cursor="Hand"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        MouseLeftButtonDown="ProjectCard_Click">

                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource OvBorder}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNewPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource IndPrimaryBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource IndMidBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding CanContinue}" Value="False">
                                                    <Setter Property="Opacity" Value="0.4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource DOEContextMenu}">
                                            <MenuItem Header="{Binding PlacementTarget.Tag.ViewDetails, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}"
                                                      Command="{Binding PlacementTarget.Tag.ViewProjectDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding ProjectId}"/>
                                            <!--<MenuItem Header="{Binding PlacementTarget.Tag.ViewAnalysis, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}"
                                                      Command="{Binding PlacementTarget.Tag.ViewProjectAnalysisCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding ProjectId}"/>-->
                                            <MenuItem Header="{Binding PlacementTarget.Tag.ViewHistory, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}"
                                                      Command="{Binding PlacementTarget.Tag.ViewProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding ProjectId}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding PlacementTarget.Tag.ProjArchive, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}"
                                                      Command="{Binding PlacementTarget.Tag.ArchiveProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding ProjectId}"/>
                                            <MenuItem Header="{Binding PlacementTarget.Tag.DeleteProj, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource DOEMenuItem}" Foreground="#D32F2F"
                                                      Command="{Binding PlacementTarget.Tag.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding ProjectId}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,2">
                                            <Border DockPanel.Dock="Right" Padding="5,1" CornerRadius="3" HorizontalAlignment="Right">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding PhaseColor}" Opacity="0.12"/>
                                                </Border.Background>
                                                <TextBlock Text="{Binding PhaseText}" FontSize="8" FontWeight="SemiBold">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{Binding PhaseColor}"/>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Text="{Binding ProjectName}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OvText}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding DetailSummaryText}" FontSize="9"
                                                   Foreground="{StaticResource OvTextHint}" Margin="0,0,0,6"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <ItemsControl ItemsSource="{Binding PhaseSegments}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="10" Height="2.5" CornerRadius="1" Margin="0,0,1.5,0"
                                                                    Background="{Binding Color}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BestValueText}" FontSize="15" FontWeight="Bold" FontFamily="Consolas">
                                                    <TextBlock.Foreground>
                                                        <SolidColorBrush Color="{Binding PhaseColor}"/>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                                <TextBlock FontSize="8" Foreground="{StaticResource OvTextMuted}" Margin="0,1,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding DataContext.CurrentBestTxt, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanContinue}" Value="False">
                                                                    <Setter Property="Text" Value="{Binding DataContext.FinalResultTxt, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ═══ 空状态引导 ═══ -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,36,0,36">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasProjects}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,0,14" HorizontalAlignment="Center"
                        Background="{StaticResource IndLightBrush}">
                    <TextBlock Text="＋" FontSize="20" Foreground="{StaticResource IndAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding StartOptimizTxt}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource OvText}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource OvTextSec}"
                           TextAlignment="Center" Margin="0,0,0,18" LineHeight="18">
                    <Run Text="{Binding InstructionTxt}"/><LineBreak/>
                    <Run Text="{Binding ProcessGuideTxt}"/>
                </TextBlock>
                <Button Cursor="Hand" HorizontalAlignment="Center"
                        Command="{Binding DataContext.CreateProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource IndPrimaryBrush}" CornerRadius="8" Padding="20,8">
                                <TextBlock Text="{Binding NewProjTxt,StringFormat='＋ {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1A237E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
