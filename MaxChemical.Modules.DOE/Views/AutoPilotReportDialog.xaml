<Window x:Class="MaxChemical.Modules.DOE.Views.AutoPilotReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能决策报告"
        Width="560" Height="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DOEWizardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="10" CornerRadius="12" Background="White"
            BorderBrush="#E2E5EB" BorderThickness="0.5" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="24" ShadowDepth="6" Opacity="0.10" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ 靛蓝头部 + 指标卡片 ═══ -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Border.Background>
                    <SolidColorBrush Color="#2D3A8C"/>
                </Border.Background>
                <StackPanel Margin="22,18,22,18">
                    <!-- 标题行 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Name="TbTitle" Text="分析报告" FontSize="10" Foreground="#73FFFFFF"/>
                            <TextBlock Text="{Binding RoundText}" FontSize="15" FontWeight="Medium"
                                       Foreground="White" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                    Margin="0,-4,0,0">
                            <!-- 阶段药丸 -->
                            <Border CornerRadius="5" Padding="10,4" Margin="0,0,6,0"
                                    Background="#19FFFFFF">
                                <TextBlock Text="{Binding PhaseText}" FontSize="10"
                                           Foreground="#B3FFFFFF"/>
                            </Border>
                            <!-- 关闭按钮 -->
                            <Button Click="CloseBtn_Click" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="28" Height="28" CornerRadius="6"
                                                Background="Transparent">
                                            <TextBlock Text="✕" FontSize="14" Foreground="#55FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#15FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 四指标卡片 -->
                    <UniformGrid Columns="4" Margin="0,0,0,0">
                        <!-- R² -->
                        <Border CornerRadius="6" Padding="12,10" Margin="0,0,4,0"
                                Background="#12FFFFFF">
                            <StackPanel>
                                <TextBlock Name="TbR" Text="R²" FontSize="9" Foreground="#66FFFFFF"/>
                                <TextBlock Text="{Binding R2Text}" FontSize="18" FontWeight="Medium"
                                           Foreground="White" FontFamily="Consolas" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- R² adj -->
                        <Border CornerRadius="6" Padding="12,10" Margin="2,0"
                                Background="#12FFFFFF">
                            <StackPanel>
                                <TextBlock Name="TbRAdj" Text="R² adj" FontSize="9" Foreground="#66FFFFFF"/>
                                <TextBlock Text="{Binding R2AdjText}" FontSize="18" FontWeight="Medium"
                                           Foreground="#B3FFFFFF" FontFamily="Consolas" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- R² pred -->
                        <Border CornerRadius="6" Padding="12,10" Margin="2,0"
                                Background="#12FFFFFF">
                            <StackPanel>
                                <TextBlock Name="TbRPred" Text="R² pred" FontSize="9" Foreground="#66FFFFFF"/>
                                <TextBlock Text="{Binding R2PredText}" FontSize="18" FontWeight="Medium"
                                           Foreground="#B3FFFFFF" FontFamily="Consolas" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- LOF p -->
                        <Border CornerRadius="6" Padding="12,10" Margin="4,0,0,0"
                                Background="#12FFFFFF">
                            <StackPanel>
                                <TextBlock Name="TbLof" Text="LOF p" FontSize="9" Foreground="#66FFFFFF"/>
                                <TextBlock Text="{Binding LofText}" FontSize="18" FontWeight="Medium"
                                           Foreground="#B3FFFFFF" FontFamily="Consolas" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ═══ 内容区 ═══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource WzScrollViewer}">
                <StackPanel Margin="22,16,22,16">

                    <!-- ── 系统决策卡片 ── -->
                    <Border CornerRadius="8" Padding="16,14" Margin="0,0,0,14"
                            BorderThickness="0.5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#E8EAED"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSafeguard}" Value="True">
                                        <Setter Property="Background" Value="#FFFBEB"/>
                                        <Setter Property="BorderBrush" Value="#FDE68A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                        <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Name="TbSysDecision" Grid.Column="0" Text="系统决策" FontSize="11"
                                           FontWeight="Medium" Foreground="#374151"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="5" Padding="10,4"
                                        Background="#E8EAF6">
                                    <TextBlock Text="{Binding RecommendationText}" FontSize="10"
                                               FontWeight="Medium" Foreground="#2D3A8C"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ReasonText}" FontSize="12" Foreground="#6B7280"
                                       TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </Border>

                    <!-- ── 下一轮方案卡片 ── -->
                    <Border CornerRadius="8" Padding="16,14" Margin="0,0,0,14"
                            Background="White" BorderBrush="#E8EAED" BorderThickness="0.5"
                            Visibility="{Binding NeedsUserAction, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Name="TbNextPlan" Text="下一轮方案" FontSize="11" FontWeight="Medium"
                                       Foreground="#374151" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2" Rows="2">
                                <Border CornerRadius="6" Padding="10,8" Margin="0,0,4,4"
                                        Background="#FAFBFC">
                                    <StackPanel>
                                        <TextBlock Name="TbDesignMethod" Text="设计方法" FontSize="9" Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding NextMethodText}" FontSize="12"
                                                   FontWeight="Medium" Foreground="#1A1F36" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="6" Padding="10,8" Margin="4,0,0,4"
                                        Background="#FAFBFC">
                                    <StackPanel>
                                        <TextBlock Name="TbTargetPhase" Text="目标阶段" FontSize="9" Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding NextPhaseText}" FontSize="12"
                                                   FontWeight="Medium" Foreground="#1A1F36" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="6" Padding="10,8" Margin="0,4,4,0"
                                        Background="#FAFBFC">
                                    <StackPanel>
                                        <TextBlock Name="TbFactor" Text="因子数" FontSize="9" Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding NextFactorText}" FontSize="12"
                                                   FontWeight="Medium" Foreground="#1A1F36" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="6" Padding="10,8" Margin="4,4,0,0"
                                        Background="#FAFBFC">
                                    <StackPanel>
                                        <TextBlock Name="TbPredict" Text="预计实验量" FontSize="9" Foreground="#9CA3AF"/>
                                        <TextBlock Text="{Binding NextRunsText}" FontSize="12"
                                                   FontWeight="Medium" Foreground="#1A1F36" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ── 自动执行完成提示 ── -->
                    <Border CornerRadius="8" Padding="16,14" Margin="0,0,0,14"
                            Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0.5"
                            Visibility="{Binding IsAutoExecuted, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Name="TbAutoExec" Text="已自动执行" FontSize="12" FontWeight="Medium"
                                       Foreground="#166534" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding AutoExecutedText}" FontSize="11"
                                       Foreground="#374151" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- ── 优化完成提示 ── -->
                    <Border CornerRadius="8" Padding="22,20" Margin="0,0,0,14"
                            Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="0.5"
                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- 完成勾号圆 -->
                            <Border Width="44" Height="44" CornerRadius="22"
                                    Background="#DCFCE7" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="M12,24 L19,31 L32,16" Stroke="#16A34A" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="44" Height="44" Stretch="None"/>
                            </Border>
                            <TextBlock Name="TbOptimizeComplete" Text="优化目标达成" FontSize="16" FontWeight="Medium"
                                       Foreground="#166534" HorizontalAlignment="Center"/>
                            <TextBlock Name="TbSuggestParam" Text="建议固化当前工艺参数" FontSize="11" Foreground="#4ADE80"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ═══ 底部按钮 ═══ -->
            <Border Grid.Row="2" Padding="22,12"
                    BorderBrush="#E8EAED" BorderThickness="0,0.5,0,0">
                <Grid>
                    <!-- 需要用户操作时: 跳过 / 手动决策 / 采纳推荐 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding NeedsUserAction, Converter={StaticResource BoolToVis}}">
                        <Button Name="BtnSkip" Content="跳过" Click="SkipBtn_Click" Cursor="Hand"
                                Foreground="#9CA3AF" Margin="0,0,8,0"
                                Style="{StaticResource WzBtnGhost}"
                                FontSize="11" Padding="14,7"/>
                        <Button Name="BtnManual" Content="手动决策" Click="ManualBtn_Click" Cursor="Hand"
                                Margin="0,0,8,0"
                                Style="{StaticResource WzBtnGhost}"
                                FontSize="11" Padding="14,7"/>
                        <Button Name="BtnAccept" Content="采纳推荐" Click="AcceptBtn_Click" Cursor="Hand"
                                Style="{StaticResource WzBtnPrimary}"
                                FontSize="11" Padding="20,7"/>
                    </StackPanel>

                    <!-- 自动执行或已完成时: 仅关闭 -->
                    <Button Name="BtnClose" Content="关闭" Click="CloseBtn_Click" Cursor="Hand"
                            HorizontalAlignment="Right"
                            FontSize="11" Padding="22,7">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WzBtnPrimary}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsUserAction}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
