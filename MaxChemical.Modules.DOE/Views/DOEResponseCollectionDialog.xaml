<Window x:Class="MaxChemical.Modules.DOE.Views.DOEResponseCollectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实验结果录入"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        ResizeMode="NoResize" Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DOEWizardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="12" CornerRadius="12" Background="White"
            BorderBrush="#E2E5EB" BorderThickness="0.5" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="24" ShadowDepth="6" Opacity="0.10" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ 标题区 ═══ -->
            <Border Grid.Row="0" Padding="22,18,22,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Name="TbTitle" Text="实验结果录入" FontSize="15" FontWeight="Medium"
                                   Foreground="#1A1F36"/>
                        <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#6B7280"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- 进度徽章 -->
                    <Border Grid.Column="1" CornerRadius="5" Padding="10,4"
                            VerticalAlignment="Top" Margin="8,2,0,0">
                        <Border.Background>
                            <SolidColorBrush Color="#2D3A8C"/>
                        </Border.Background>
                        <TextBlock x:Name="ProgressBadge" Text="1 / 24" FontSize="11"
                                   FontWeight="Medium" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ 因子参数区 ═══ -->
            <Border Grid.Row="1" Margin="22,14,22,0" CornerRadius="8" Padding="14,12"
                    Background="#F8F9FB">
                <StackPanel>
                    <TextBlock Name="TbParam" Text="本组实验参数" FontSize="10" FontWeight="Medium"
                               Foreground="#9CA3AF" Margin="0,0,0,8"
                               />

                    <ItemsControl x:Name="FactorDisplay">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="11"
                                               Foreground="#6B7280" Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11"
                                               FontWeight="Medium" Foreground="#2D3A8C"
                                               FontFamily="Consolas" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ 响应值输入区 ═══ -->
            <StackPanel Grid.Row="2" Margin="22,16,22,0">
                <TextBlock Name="TbInputResult" Text="请输入实验结果" FontSize="11" FontWeight="Medium"
                           Foreground="#374151" Margin="0,0,0,10"/>

                <ItemsControl x:Name="ResponseInputs">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 标签 -->
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                                           Foreground="#374151" VerticalAlignment="Center"/>

                                <!-- 输入框 + 单位后缀 -->
                                <Border Grid.Column="1" CornerRadius="6" BorderThickness="0.5"
                                        BorderBrush="#E2E5EB" ClipToBounds="True">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#C7CCD4"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12" FontFamily="Consolas"
                                                 Foreground="#1A1F36" Padding="10,8"
                                                 BorderThickness="0" Background="Transparent"
                                                 VerticalContentAlignment="Center"/>

                                        <!-- 单位后缀 -->
                                        <Border Grid.Column="1" Padding="10,0"
                                                Background="#FAFBFC"
                                                BorderBrush="#E2E5EB" BorderThickness="0.5,0,0,0"
                                                Visibility="{Binding HasUnit, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding Unit}" FontSize="10"
                                                       Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══ 底部按钮 ═══ -->
            <Border Grid.Row="4" Padding="22,14" Margin="0,10,0,0"
                    BorderBrush="#E8EAED" BorderThickness="0,0.5,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- 跳过按钮 -->
                    <Button Name="BtnSkip" Content="跳过本组" Click="Skip_Click" Cursor="Hand"
                            Style="{StaticResource WzBtnGhost}"
                            FontSize="11" Padding="16,7" Margin="0,0,8,0"/>

                    <!-- 提交按钮 -->
                    <Button Name="BtnSubmit" Content="提交结果" Click="Submit_Click" Cursor="Hand"
                            Style="{StaticResource WzBtnPrimary}"
                            FontSize="11" Padding="20,7"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
