<Window x:Class="MaxChemical.Modules.DOE.Views.DOEMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MaxChemical.Modules.DOE.Views"
        Title="DOE" Width="960" Height="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="White" ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary Source="DOEStyles.xaml"/>
    </Window.Resources>

    <Grid>
        <!-- ═══ 主内容（大窗口模式） ═══ -->
        <!-- 此窗口为不透明窗(AllowsTransparency=False,规避分层透明+顶层阴影导致的全应用卡顿)。
             不透明窗下 Margin 会露出窗口背景色形成一圈方框,故内容铺满窗口(Margin=0)、
             窗口背景与内容同为白;窗口外圆角改由 DWM 在 Win11 原生绘制(见代码 ApplyRoundedCorners),
             Win10 自动降级为直角。 -->
        <Border x:Name="MainContent" Margin="0" CornerRadius="0" Background="White" BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ═══ 标题栏 ═══ -->
                <Border Grid.Row="0" CornerRadius="0" MouseLeftButtonDown="TitleBar_MouseDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#003A96" Offset="0"/>
                            <GradientStop Color="#002D78" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logo + 标题 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0">
                            <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="1" Canvas.Top="1" Width="5.5" Height="5.5" 
                               RadiusX="1.2" RadiusY="1.2" Fill="White" Opacity="0.7"/>
                                    <Rectangle Canvas.Left="9" Canvas.Top="1" Width="5.5" Height="5.5" 
                               RadiusX="1.2" RadiusY="1.2" Fill="White" Opacity="0.35"/>
                                    <Rectangle Canvas.Left="1" Canvas.Top="9" Width="5.5" Height="5.5" 
                               RadiusX="1.2" RadiusY="1.2" Fill="White" Opacity="0.35"/>
                                    <Rectangle Canvas.Left="9" Canvas.Top="9" Width="5.5" Height="5.5" 
                               RadiusX="1.2" RadiusY="1.2" Fill="White" Opacity="0.18"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding TitleTxt}" VerticalAlignment="Center"
                       Foreground="#DDFFFFFF" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- 关闭按钮 -->
                        <Button Grid.Column="2" Style="{StaticResource CloseButtonStyle}" 
                Click="CloseBtn_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ═══ Tab 栏 ═══ -->
                <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel x:Name="TabBar" Orientation="Horizontal" Margin="14,0,0,0">
                        <RadioButton Content="{Binding OverviewTxt}" Tag="0" IsChecked="True" GroupName="DOETabs"
                 Style="{StaticResource DOETabRadio}" Checked="TabRadio_Checked"/>
                        <RadioButton Content="{Binding ExecuteTxt}" Tag="1" GroupName="DOETabs"
                 Style="{StaticResource DOETabRadio}" Checked="TabRadio_Checked"/>
                        <!-- GPR 禁用: 隐藏"模型分析" Tab
    <RadioButton Content="模型分析" Tag="2" GroupName="DOETabs"
                 Style="{StaticResource DOETabRadio}" Checked="TabRadio_Checked"/>
    -->
                        <RadioButton Content="{Binding HistoryTxt}" Tag="3" GroupName="DOETabs"
                 Style="{StaticResource DOETabRadio}" Checked="TabRadio_Checked"/>
                    </StackPanel>
                </Border>
                <!-- ═══ 内容区 ═══ -->
                <!-- ═══ 内容区 ═══ -->
                <Grid Grid.Row="2" Background="{StaticResource PageBgBrush}">
                    <views:DOEOverviewView x:Name="OverviewView"
        Visibility="{Binding DataContext.IsTab0, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <views:DOEExecutionDashboardView x:Name="ExecutionView"
        Visibility="{Binding DataContext.IsTab1, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                    <!-- GPR 禁用: 移除模型分析视图
    <views:DOEModelAnalysisView x:Name="ModelAnalysisView"
        Visibility="{Binding DataContext.IsTab2, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
    -->
                    <views:DOEHistoryView x:Name="HistoryView"
        Visibility="{Binding DataContext.IsTab3, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- ═══ Loading — DOE 矩阵呼吸格 ═══ -->
                <Border x:Name="LoadingOverlay" Grid.Row="1" Grid.RowSpan="2" Background="White"
                        Visibility="Collapsed" Panel.ZIndex="100">
                    <Border.Resources>
                        <!-- 呼吸动画基础 Storyboard（由代码控制各格子延迟） -->
                        <Color x:Key="GridCellDark">#2D3A8C</Color>
                        <Color x:Key="GridCellLight">#3B5BDB</Color>

                        <Storyboard x:Key="CellPulse" RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.10" To="0.55" Duration="0:0:0.8"
                                             AutoReverse="True">
                                <DoubleAnimation.EasingFunction>
                                    <SineEase EasingMode="EaseInOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Border.Resources>

                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                            <!-- ═══ 4×4 矩阵呼吸格 ═══ -->
                            <UniformGrid Rows="4" Columns="4" HorizontalAlignment="Center" Margin="0,0,0,28"
                                         Width="94" Height="94">
                                <!-- Row 0 -->
                                <Border x:Name="Cell00" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#2D3A8C"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell00" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell01" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B5BDB"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell01" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.15">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell02" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#2D3A8C"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell02" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell03" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B5BDB"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell03" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.45">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Row 1 -->
                                <Border x:Name="Cell10" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B5BDB"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell10" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.1">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell11" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#2D3A8C"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell11" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell12" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B5BDB"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell12" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.4">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell13" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#2D3A8C"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell13" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.55">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Row 2 -->
                                <Border x:Name="Cell20" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#2D3A8C"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell20" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell21" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B5BDB"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell21" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.35">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell22" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#2D3A8C"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell22" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.5">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell23" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B5BDB"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell23" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.65">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Row 3 -->
                                <Border x:Name="Cell30" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B5BDB"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell30" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell31" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#2D3A8C"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell31" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.45">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell32" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#3B5BDB"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell32" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.6">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                                <Border x:Name="Cell33" Width="16" Height="16" CornerRadius="3" Margin="3" Opacity="0.10">
                                    <Border.Background>
                                        <SolidColorBrush Color="#2D3A8C"/>
                                    </Border.Background>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Cell33" Storyboard.TargetProperty="Opacity"
                                                        From="0.10" To="0.55" Duration="0:0:0.8" AutoReverse="True" BeginTime="0:0:0.75">
                                                        <DoubleAnimation.EasingFunction>
                                                            <SineEase EasingMode="EaseInOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </UniformGrid>

                            <!-- ═══ 产品名 ═══ -->
                            <TextBlock Text="{Binding ProductTxt}" FontSize="15" FontWeight="Medium"
                                       Foreground="#1A1F36" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="MaxChemical" FontSize="11" Foreground="#9CA3AF"
                                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

                            <!-- ═══ 状态文字 ═══ -->
                            <TextBlock x:Name="LoadingStatusText" Text="正在加载分析引擎..."
                                       FontSize="12" Foreground="#9CA3AF" HorizontalAlignment="Center"
                                       Margin="0,0,0,14"/>

                            <!-- ═══ 极细进度条 ═══ -->
                            <Grid Width="180" Height="2" HorizontalAlignment="Center">
                                <Border Background="#E8EAF6" CornerRadius="1"/>
                                <Border x:Name="LoadingProgressBar" Background="#2D3A8C" CornerRadius="1"
                                        HorizontalAlignment="Left" Width="0"/>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══  迷你面板（执行时覆盖显示） ═══ -->
        <views:DOEMiniPanel x:Name="MiniPanel"
            Visibility="Collapsed"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
    </Grid>
</Window>
