                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="仿行数" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding CcdReplicates, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ── BBD 参数 ── -->
