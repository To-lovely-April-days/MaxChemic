                                        <Style x:Key="RvVal" TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="12.5"/>
                                            <Setter Property="Foreground" Value="{StaticResource WzText}"/>
                                            <Setter Property="Padding" Value="0,8"/>
                                        </Style>
                                        <Style x:Key="RvBdr" TargetType="Border">
