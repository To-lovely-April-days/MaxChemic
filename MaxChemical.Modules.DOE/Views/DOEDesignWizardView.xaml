                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding QualityGEffText}" FontSize="13" FontFamily="Consolas" Foreground="{StaticResource WzText}" Padding="0,2,20,2"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding QualityDofText}" FontSize="13" FontFamily="Consolas" Foreground="{StaticResource WzText}" Padding="0,2,0,2"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>

