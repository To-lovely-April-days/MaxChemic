                                <Border Background="{StaticResource WzPrimaryLight}" CornerRadius="4" Padding="10,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock Text="STEP 5" Style="{StaticResource WzStepBadge}"/>
                                </Border>
                                <TextBlock Text="确认并保存" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WzText}" Margin="0,0,0,2"/>
                                <TextBlock Text="核对以下配置，确认无误后保存" FontSize="12.5" Foreground="{StaticResource WzTextMuted}" Margin="0,0,0,18"/>

                                <TextBlock Text="批次名称" FontSize="12" FontWeight="Medium" Foreground="{StaticResource WzTextSec}" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding BatchName}" Style="{StaticResource WzTextBox}" Tag="CCD_20250413_001" Margin="0,0,0,20" MaxWidth="320" HorizontalAlignment="Left" FontFamily="Consolas"/>

                                <!-- 配置摘要表 -->
