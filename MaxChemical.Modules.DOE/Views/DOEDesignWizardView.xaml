                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="仿行数" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding PbReplicates, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
                                        </StackPanel>
                                    </StackPanel>

