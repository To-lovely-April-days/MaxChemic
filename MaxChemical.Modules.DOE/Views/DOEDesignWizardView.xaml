                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding LinesLabel}" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding BbdReplicates, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ── D-Optimal 参数 ── -->
                                    <StackPanel x:Name="DrawerDOpt" Visibility="Collapsed">
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding ExpriNumberTxt}" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding DOptimalRunCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
                                            <TextBlock Text="{Binding DoptimalTip}" Style="{StaticResource WzHint}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding ModelLabel}" Style="{StaticResource WzDrawerLabel}"/>
                                            <ComboBox Style="{StaticResource WzComboBox}" SelectedValue="{Binding DOptimalModelType}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="{Binding ModelLinear}" Tag="linear"/>
                                                <ComboBoxItem Content="{Binding ModelInteraction}" Tag="interaction"/>
                                                <ComboBoxItem Content="{Binding ModelQuadratic}" Tag="quadratic"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding RestratsLabel}" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding DOptRestarts, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding IterationLabel}" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding DOptMaxIterations, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding CondidateGridLabel}" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding DOptCandidateGridSize, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RandomSeedLabel}" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding DOptRandomSeed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
                                            <TextBlock Text="{Binding SeedTip}" Style="{StaticResource WzHint}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ── Taguchi 参数 ── -->
                                    <StackPanel x:Name="DrawerTaguchi" Visibility="Collapsed">
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding LTableLabel}" Style="{StaticResource WzDrawerLabel}"/>
                                            <ComboBox Style="{StaticResource WzComboBox}" SelectedValue="{Binding TaguchiTableType}" SelectedValuePath="Content">
                                                <ComboBoxItem Content="{Binding AutoItem}"/>
                                                <ComboBoxItem Content="L4"/>
                                                <ComboBoxItem Content="L8"/>
                                                <ComboBoxItem Content="L9"/>
                                                <ComboBoxItem Content="L12"/>
                                                <ComboBoxItem Content="L16"/>
                                                <ComboBoxItem Content="L18"/>
                                                <ComboBoxItem Content="L27"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SnrLabel}" Style="{StaticResource WzDrawerLabel}"/>
                                            <ComboBox Style="{StaticResource WzComboBox}" SelectedValue="{Binding TaguchiSnRatio}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="{Binding LargerItem}" Tag="larger"/>
                                                <ComboBoxItem Content="{Binding SmallerItem}" Tag="smaller"/>
                                                <ComboBoxItem Content="NominalItem" Tag="nominal"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- ── Custom 参数 ── -->
                                    <StackPanel x:Name="DrawerCustom" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AnalysisTypeLabel}" Style="{StaticResource WzDrawerLabel}"/>
                                            <ComboBox Style="{StaticResource WzComboBox}" SelectedValue="{Binding CustomAnalysisType}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="{Binding AnalysisLinear}" Tag="linear"/>
                                                <ComboBoxItem Content="{Binding AnalysisInteraction}" Tag="interaction"/>
                                                <ComboBoxItem Content="{Binding AnalysisQuadratic}" Tag="quadratic"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ═══ 底部导航栏 ═══ -->
                <Border Grid.Row="2" BorderBrush="{StaticResource WzDivider}" BorderThickness="0,0.5,0,0" Padding="28,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧进度 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                                <Border Width="18" Height="3" CornerRadius="1.5" Margin="0,0,2,0" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=1}"/>
                                <Border Width="18" Height="3" CornerRadius="1.5" Margin="0,0,2,0" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=2}"/>
                                <Border Width="18" Height="3" CornerRadius="1.5" Margin="0,0,2,0" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=3}"/>
                                <Border Width="18" Height="3" CornerRadius="1.5" Margin="0,0,2,0" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=4}"/>
                                <Border Width="18" Height="3" CornerRadius="1.5" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=5}"/>
                            </StackPanel>
                            <TextBlock FontSize="11" Foreground="{StaticResource WzTextHint}" VerticalAlignment="Center" Margin="2,0,0,0">
                                <Run Text="{Binding CurrentStep, Mode=OneWay}"/><Run Text=" / 5"/>
                            </TextBlock>

                            <!-- Loading 指示器 -->
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="14" Height="14" StrokeThickness="1.5" Stroke="{StaticResource WzPrimary}" StrokeDashArray="5 4" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.7"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource WzTextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 右侧按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{Binding PreviousStepTxt}" Command="{Binding PreviousStepCommand}" Style="{StaticResource WzBtnGhost}" Margin="0,0,8,0"/>
                            <Button Content="{Binding NextStepTxt}" Command="{Binding NextStepCommand}" Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WzBtnPrimary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{Binding SaveExecTxt}" Command="{Binding SaveBatchCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WzBtnPrimary}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
