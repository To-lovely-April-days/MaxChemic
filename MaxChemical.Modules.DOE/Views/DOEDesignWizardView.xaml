<Window x:Class="MaxChemical.Modules.DOE.Views.DOEDesignWizardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:MaxChemical.Modules.DOE.Converters"
        xmlns:models="clr-namespace:MaxChemical.Modules.DOE.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="DOE 实验设计向导"
        Width="960" Height="640"
        WindowStartupLocation="CenterScreen"
        Background="#F8F9FB" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DOEWizardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:EnumBoolConverter x:Key="EnumBoolConverter"/>
            <converters:EnumToVisibilityConverter x:Key="EnumToVis"/>
            <converters:NullToVisibilityConverter x:Key="NullToVis"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <converters:StepBrushConverter x:Key="StepBrush"/>

            <converters:BindingProxy x:Key="BindingProxyKey" Data="{Binding}"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- ═══ 外层圆角容器 + 阴影 ═══ -->
    <Border CornerRadius="12" Background="White" BorderBrush="#D4D8E1" BorderThickness="0.5" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.06"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════
                 左侧导航栏
                 ═══════════════════════════════════ -->
            <Border Grid.Column="0" Background="#FAFBFC" BorderBrush="{StaticResource WzDivider}" BorderThickness="0,0,0.5,0">
                <DockPanel>
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,16">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource WzPrimary}">
                            <TextBlock Text="D" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding TitleTxt}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource WzText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- 底部提示 -->
                    <Border DockPanel.Dock="Bottom" Padding="20,12,20,16" BorderBrush="{StaticResource WzDivider}" BorderThickness="0,0.5,0,0">
                        <TextBlock FontSize="11" Foreground="{StaticResource WzTextHint}" TextWrapping="Wrap" LineHeight="17">
                            <Run Text="{Binding BottomTipCancelTxt}"/><LineBreak/><Run Text="{Binding BottomTipTxt}"/>
                        </TextBlock>
                    </Border>

                    <!-- 步骤列表 -->
                    <StackPanel Margin="0,4,0,0">
                        <Border Style="{StaticResource WzNavItem}" MouseLeftButtonDown="NavStep_Click" Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="6" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=1}">
                                    <TextBlock Text="1" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding FactorDefineTxt}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource WzTextMuted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WzNavItem}" MouseLeftButtonDown="NavStep_Click" Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="6" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=2}">
                                    <TextBlock Text="2" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding DesignMethodTxt}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource WzTextMuted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WzNavItem}" MouseLeftButtonDown="NavStep_Click" Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="6" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=3}">
                                    <TextBlock Text="3" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding MatrixPreviewTxt}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource WzTextMuted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WzNavItem}" MouseLeftButtonDown="NavStep_Click" Tag="4">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="6" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=4}">
                                    <TextBlock Text="4" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding RespAndCondiTxt}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource WzTextMuted}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WzNavItem}" MouseLeftButtonDown="NavStep_Click" Tag="5">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="6" Background="{Binding CurrentStep, Converter={StaticResource StepBrush}, ConverterParameter=5}">
                                    <TextBlock Text="5" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding ConfirmSaveTxt}" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource WzTextMuted}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══════════════════════════════════
                 右侧主内容
                 ═══════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 顶部栏 ── -->
                <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Padding="28,10,10,10" BorderBrush="{StaticResource WzDivider}" BorderThickness="0,0,0,0.5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsProjectMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ProjectName}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource WzText}" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                            <Border Background="{StaticResource WzPrimary}" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusMessage}" FontSize="10" FontWeight="Medium" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Click="CloseBtn_Click" Width="30" Height="30" Cursor="Hand" ToolTip="关闭 (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Width="30" Height="30">
                                        <TextBlock Text="✕" FontSize="16" Foreground="{StaticResource WzTextHint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FEF2F2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════
                     内容区域（含 Drawer 覆盖层）
                     ═══════════════════════════════════ -->
                <Grid Grid.Row="1" ClipToBounds="True">

                    <!-- 主滚动内容 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource WzScrollViewer}">
                        <Grid Margin="28,18,28,18">

                            <!-- ══════════════════════════════
                                 Step 1: 因子定义
                                 ══════════════════════════════ -->
                            <StackPanel Visibility="{Binding IsStep1Visible, Converter={StaticResource BoolToVis}}">
                                <Border Background="{StaticResource WzPrimaryLight}" CornerRadius="4" Padding="10,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock Text="STEP 1" Style="{StaticResource WzStepBadge}"/>
                                </Border>
                                <TextBlock Text="{Binding S1Title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WzText}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding S1Subtitle}" FontSize="12.5" Foreground="{StaticResource WzTextMuted}" Margin="0,0,0,18"/>

                                <!-- 因子表格（圆角容器包裹） -->
                                <Border Style="{StaticResource WzTableContainer}">
                                    <DataGrid ItemsSource="{Binding Factors}" Style="{StaticResource WzDataGrid}"
                                              MinHeight="80" MaxHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{Binding Data.FactorNameHeader, Source={StaticResource BindingProxyKey}}" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding FactorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzCellInput}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{Binding Data.FactorTypeHeader, Source={StaticResource BindingProxyKey}}" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox SelectedItem="{Binding FactorType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzComboCompact}">
                                                            <ComboBox.Items>
                                                                <models:DOEFactorType>Continuous</models:DOEFactorType>
                                                                <models:DOEFactorType>Categorical</models:DOEFactorType>
                                                            </ComboBox.Items>
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock>
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="连续"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding}" Value="{x:Static models:DOEFactorType.Categorical}">
                                                                                        <Setter Property="Text" Value="类别"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{Binding Data.LowLevelHeader, Source={StaticResource BindingProxyKey}}" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <!-- 连续因子: 数值输入 -->
                                                            <TextBox Text="{Binding LowerBound, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzCellNum}" Visibility="{Binding IsContinuous, Converter={StaticResource BoolToVis}}"/>
                                                            <!-- 类别因子: 水平标签输入（横跨低水平+高水平的视觉位置） -->
                                                            <TextBox Text="{Binding CategoryLevels, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzCellInput}" Tag="如: Pd/C, Pt, Ni"
                                                                     Visibility="{Binding IsCategorical, Converter={StaticResource BoolToVis}}"
                                                                     Margin="0,0,-80,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{Binding Data.HighLevelHeader, Source={StaticResource BindingProxyKey}}" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding UpperBound, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzCellNum}" Visibility="{Binding IsContinuous, Converter={StaticResource BoolToVis}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{Binding Data.LowerLimitHeader, Source={StaticResource BindingProxyKey}}" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding PhysicalLowerLimit, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource WzCellNum}" Visibility="{Binding IsContinuous, Converter={StaticResource BoolToVis}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{Binding Data.UpperLimitHeader, Source={StaticResource BindingProxyKey}}" Width="70">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding PhysicalUpperLimit, StringFormat={}{0:F1}, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource WzCellNum}" Visibility="{Binding IsContinuous, Converter={StaticResource BoolToVis}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{Binding Data.BindParamHeader, Source={StaticResource BindingProxyKey}}" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- ① 连续因子且未勾选手动: ComboBox 选流程参数 -->
                                                            <ComboBox Grid.Column="0"
                          ItemsSource="{Binding AvailableCandidates}"
                          SelectedItem="{Binding SelectedCandidate, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource WzComboCompact}"
                          Visibility="{Binding NeedsBinding, Converter={StaticResource BoolToVis}}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>

                                                            <!-- ② 类别因子 或 连续因子勾选了手动: 显示「手动操作」灰字 -->
                                                            <TextBlock Grid.Column="0"
                           Text="手动操作 — 由操作员调节"
                           FontSize="11" FontStyle="Italic"
                           Foreground="{StaticResource WzTextHint}"
                           VerticalAlignment="Center" Margin="8,0"
                           Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}"/>

                                                            <!-- ③ 仅连续因子显示「手动」CheckBox(类别因子永远手动,不需要切换) -->
                                                            <CheckBox Grid.Column="1"
                          Content="手动"
                          IsChecked="{Binding IsManual, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center"
                          Margin="8,0,4,0"
                          FontSize="11"
                          ToolTip="勾选后该因子不绑定流程参数,运行时由操作员手动按矩阵值调节"
                          Visibility="{Binding IsContinuous, Converter={StaticResource BoolToVis}}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="" Width="36">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource WzBtnDel}" Command="{Binding DataContext.RemoveFactorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Button Content="{Binding S1AddFactorTxt}" Command="{Binding AddFactorCommand}" Style="{StaticResource WzBtnAdd}"/>
                                <TextBlock Style="{StaticResource WzHint}" Margin="0,8,0,0"
                                           Text="{Binding S1InstructionTxt}"/>
                            </StackPanel>

                            <!-- ══════════════════════════════
                                 Step 2: 设计方法（纯卡片点选，无 RadioButton 圆圈）
                                 ══════════════════════════════ -->
                            <StackPanel Visibility="{Binding IsStep2Visible, Converter={StaticResource BoolToVis}}">
                                <Border Background="{StaticResource WzPrimaryLight}" CornerRadius="4" Padding="10,3" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock Text="STEP 2" Style="{StaticResource WzStepBadge}"/>
                                </Border>
                                <TextBlock Text="{Binding S2Title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource WzText}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding S2Sutitle}" FontSize="12.5" Foreground="{StaticResource WzTextMuted}" Margin="0,0,0,18"/>

                                 <!--── 筛选 Screening ──--> 
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource WzTextHint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding ScreeningTitleTxt}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WzTextMuted}"/>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <Border Style="{StaticResource WzMethodCard}" Margin="0,0,4,0">
                                        <RadioButton GroupName="Method" IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumBoolConverter}, ConverterParameter=PlackettBurman}" Style="{StaticResource WzRadio}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Plackett-Burman" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WzText}"/>
                                                    <TextBlock Text="{Binding ScreeningDesc1}" FontSize="11.5" Foreground="{StaticResource WzTextMuted}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding ScreeningDesc2}" FontSize="10.5" Foreground="{StaticResource WzTextHint}" Margin="0,3,0,0" LineHeight="15"/>
                                                    <Button Content="{Binding ConfigParamTxt}" Style="{StaticResource WzBtnCfg}" Click="OpenDrawer_Click" Tag="PlackettBurman"
                                                            Visibility="{Binding SelectedMethod, Converter={StaticResource EnumToVis}, ConverterParameter=PlackettBurman}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FEF3C7" CornerRadius="3" Padding="6,2">
                                                    <TextBlock Text="{Binding ScreeningLabel}" FontSize="9" FontWeight="SemiBold" Foreground="#D97706"/>
                                                </Border>
                                            </Grid>
                                        </RadioButton>
                                    </Border>
                                    <Border Style="{StaticResource WzMethodCard}" Margin="4,0,0,0">
                                        <RadioButton GroupName="Method" IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumBoolConverter}, ConverterParameter=FractionalFactorial}" Style="{StaticResource WzRadio}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FactorTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WzText}"/>
                                                    <TextBlock Text="{Binding FactorDesc1}" FontSize="11.5" Foreground="{StaticResource WzTextMuted}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding FactorDesc2}" FontSize="10.5" Foreground="{StaticResource WzTextHint}" Margin="0,3,0,0" LineHeight="15"/>
                                                    <Button Content="{Binding ConfigParamTxt}" Style="{StaticResource WzBtnCfg}" Click="OpenDrawer_Click" Tag="FractionalFactorial"
                                                            Visibility="{Binding SelectedMethod, Converter={StaticResource EnumToVis}, ConverterParameter=FractionalFactorial}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FEF3C7" CornerRadius="3" Padding="6,2">
                                                    <TextBlock Text="{Binding ScreeningLabel}" FontSize="9" FontWeight="SemiBold" Foreground="#D97706"/>
                                                </Border>
                                            </Grid>
                                        </RadioButton>
                                    </Border>
                                </UniformGrid>

                                <!-- ── 因子 Factorial ── -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource WzTextHint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding FactorialTitleTxt}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WzTextMuted}"/>
                                </StackPanel>
                                <Border Style="{StaticResource WzMethodCard}" Margin="0,0,0,16">
                                    <RadioButton GroupName="Method" IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumBoolConverter}, ConverterParameter=FullFactorial}" Style="{StaticResource WzRadio}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FullTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WzText}"/>
                                                <TextBlock Text="{Binding FullDesc1}" FontSize="11.5" Foreground="{StaticResource WzTextMuted}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding FullDesc2}" FontSize="10.5" Foreground="{StaticResource WzTextHint}" Margin="0,3,0,0"/>
                                                <Button Content="{Binding ConfigParamTxt}" Style="{StaticResource WzBtnCfg}" Click="OpenDrawer_Click" Tag="FullFactorial"
                                                        Visibility="{Binding SelectedMethod, Converter={StaticResource EnumToVis}, ConverterParameter=FullFactorial}" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#DBEAFE" CornerRadius="3" Padding="6,2">
                                                <TextBlock Text="{Binding FactorialLabel}" FontSize="9" FontWeight="SemiBold" Foreground="#2563EB"/>
                                            </Border>
                                        </Grid>
                                    </RadioButton>
                                </Border>

                                <!-- ── 响应曲面 RSM ── -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource WzPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding RsmTitleTxt}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WzPrimary}"/>
                                </StackPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,4">
                                    <!-- CCD -->
                                    <Border Style="{StaticResource WzMethodCard}" Margin="0,0,4,8">
                                        <RadioButton GroupName="Method" IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumBoolConverter}, ConverterParameter=CCD}" Style="{StaticResource WzRadio}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CcdTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WzText}"/>
                                                    <TextBlock Text="{Binding CcdDesc1}" FontSize="11.5" Foreground="{StaticResource WzTextMuted}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding CcdDesc2}" FontSize="10.5" Foreground="{StaticResource WzTextHint}" Margin="0,3,0,0"/>
                                                    <Button Content="{Binding ConfigParamTxt}" Style="{StaticResource WzBtnCfg}" Click="OpenDrawer_Click" Tag="CCD"
                                                            Visibility="{Binding SelectedMethod, Converter={StaticResource EnumToVis}, ConverterParameter=CCD}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <Border Background="{StaticResource WzPrimary}" CornerRadius="0,0,4,4" Padding="8,2" Margin="0,-14,-16,0">
                                                        <TextBlock Text="{Binding RecommandLabel}" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </RadioButton>
                                    </Border>
                                    <!-- BBD -->
                                    <Border Style="{StaticResource WzMethodCard}" Margin="4,0,0,8">
                                        <RadioButton GroupName="Method" IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumBoolConverter}, ConverterParameter=BoxBehnken}" Style="{StaticResource WzRadio}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="Box-Behnken" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WzText}"/>
                                                    <TextBlock Text="{Binding BoxBehDesc1}" FontSize="11.5" Foreground="{StaticResource WzTextMuted}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding BoxBehDesc2}" FontSize="10.5" Foreground="{StaticResource WzTextHint}" Margin="0,3,0,0"/>
                                                    <Button Content="{Binding ConfigParamTxt}" Style="{StaticResource WzBtnCfg}" Click="OpenDrawer_Click" Tag="BoxBehnken"
                                                            Visibility="{Binding SelectedMethod, Converter={StaticResource EnumToVis}, ConverterParameter=BoxBehnken}" HorizontalAlignment="Left"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource WzPrimaryLight}" CornerRadius="3" Padding="6,2">
                                                    <TextBlock Text="RSM" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource WzPrimary}"/>
                                                </Border>
                                            </Grid>
                                        </RadioButton>
                                    </Border>
                                    <!-- D-Optimal -->
                                    <Border Style="{StaticResource WzMethodCard}" Margin="0,0,4,8">
                                        <RadioButton GroupName="Method" IsChecked="{Binding SelectedMethod, Converter={StaticResource EnumBoolConverter}, ConverterParameter=DOptimal}" Style="{StaticResource WzRadio}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="D-Optimal" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WzText}"/>
                                                    <TextBlock Text="{Binding DOptDesc1}" FontSize="11.5" Foreground="{StaticResource WzTextMuted}" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding DOptDesc2}" FontSize="10.5" Foreground="{StaticResource WzTextHint}" Margin="0,3,0,0"/>
