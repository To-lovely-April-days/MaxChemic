                                            <TextBlock Text="仿行数" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding FullFactorialReplicates, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
