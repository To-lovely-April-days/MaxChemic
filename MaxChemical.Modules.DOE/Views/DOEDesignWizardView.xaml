                                            <TextBlock Text="-1 = 自动" Style="{StaticResource WzHint}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="中心点" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding FfCenterCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="仿行数" Style="{StaticResource WzDrawerLabel}"/>
                                            <TextBox Text="{Binding FfReplicates, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource WzNumBox}"/>
