<UserControl x:Class="MaxChemical.Modules.DOE.Views.DOEAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="#F2F4F7">
    <UserControl.Resources>
        <ResourceDictionary Source="DOEStyles.xaml"/>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22">
                <!-- 工具栏 -->
                <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Padding="12,8" Margin="0,0,0,14">
                    <Grid>
                        <Button Content="刷新全部图表" Style="{StaticResource DOEPrimaryBtn}" Padding="18,7" Command="{Binding RefreshAllCommand}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" Foreground="#8A8F9C"/>
                    </Grid>
                </Border>

                <!-- 2x2 图表 -->
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Margin="0,0,5,5">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/></Grid.RowDefinitions>
                        <Border Background="#FAFBFC" Padding="14,8" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                            <TextBlock Text="主效应图" FontSize="12" FontWeight="SemiBold" Foreground="#1A1F36"/></Border>
                        <oxy:PlotView Grid.Row="1" Model="{Binding MainEffectsPlot}" Background="White" Margin="8"/></Grid>
                    </Border>
                    <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Margin="5,0,0,5">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/></Grid.RowDefinitions>
                        <Border Background="#FAFBFC" Padding="14,8" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                            <TextBlock Text="Pareto 效应图" FontSize="12" FontWeight="SemiBold" Foreground="#1A1F36"/></Border>
                        <oxy:PlotView Grid.Row="1" Model="{Binding ParetoPlot}" Background="White" Margin="8"/></Grid>
                    </Border>
                    <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Margin="0,5,5,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/></Grid.RowDefinitions>
                        <Border Background="#FAFBFC" Padding="14,8" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                            <TextBlock Text="实际值 vs 预测值 (R²)" FontSize="12" FontWeight="SemiBold" Foreground="#1A1F36"/></Border>
                        <oxy:PlotView Grid.Row="1" Model="{Binding ActualVsPredictedPlot}" Background="White" Margin="8"/></Grid>
                    </Border>
                    <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Margin="5,5,0,0">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="260"/></Grid.RowDefinitions>
                        <Border Background="#FAFBFC" Padding="14,8" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                            <TextBlock Text="残差 vs 拟合值" FontSize="12" FontWeight="SemiBold" Foreground="#1A1F36"/></Border>
                        <oxy:PlotView Grid.Row="1" Model="{Binding ResidualPlot}" Background="White" Margin="8"/></Grid>
                    </Border>
                </UniformGrid>

                <!-- 回归 -->
                <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="回归分析" FontSize="13" FontWeight="SemiBold" Foreground="#1A1F36" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding RSquaredText}" FontSize="16" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,6"/>
                        <Border Background="#FAFBFC" CornerRadius="6" BorderBrush="#ECEEF2" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                            <TextBlock Text="{Binding RegressionEquation}" FontFamily="Consolas" FontSize="11" Foreground="#4A5066" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="ANOVA 方差分析表" FontSize="12" FontWeight="SemiBold" Foreground="#1A1F36" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding AnovaTableText}" FontFamily="Consolas" FontSize="10" Foreground="#8A8F9C"/>
                    </StackPanel>
                </Border>

                <!-- 响应曲面 -->
                <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="320"/></Grid.RowDefinitions>
                    <Border Background="#FAFBFC" Padding="14,8" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                        <Grid>
                            <TextBlock Text="3D 响应曲面 &amp; 等高线" FontSize="12" FontWeight="SemiBold" Foreground="#1A1F36" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding FactorNames}" SelectedItem="{Binding SurfaceFactor1}" Width="110" FontSize="11" Padding="4,3" Margin="0,0,4,0"/>
                                <TextBlock Text="x" VerticalAlignment="Center" Foreground="#8A8F9C" FontSize="11" Margin="0,0,4,0"/>
                                <ComboBox ItemsSource="{Binding FactorNames}" SelectedItem="{Binding SurfaceFactor2}" Width="110" FontSize="11" Padding="4,3" Margin="0,0,8,0"/>
                                <Button Content="生成" Style="{StaticResource DOEPrimaryBtn}" Padding="14,5" Command="{Binding GenerateSurfaceCommand}" Height="26"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="{Binding SurfaceImage}" Stretch="Uniform" Margin="10"/>
                        <Border Grid.Column="1" Background="#E8EAED"/>
                        <Border Grid.Column="2" Background="#FAFBFC">
                            <TextBlock Text="等高线图" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#A0A4B0"/>
                        </Border>
                    </Grid></Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading 遮罩 -->
        <Border Background="#EAFFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="50">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid Width="48" Height="48" Margin="0,0,0,14">
                    <Ellipse Width="48" Height="48" Stroke="#E8EAED" StrokeThickness="3"/>
                    <Ellipse Width="48" Height="48" Style="{StaticResource DOESpinRing}" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform x:Name="AnalysisSpin" Angle="0"/></Ellipse.RenderTransform>
                        <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="AnalysisSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard></EventTrigger></Ellipse.Triggers>
                    </Ellipse>
                </Grid>
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Medium" Foreground="#1A1F36" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="请稍候，正在调用 Python 分析引擎..." FontSize="11" Foreground="#8A8F9C" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
