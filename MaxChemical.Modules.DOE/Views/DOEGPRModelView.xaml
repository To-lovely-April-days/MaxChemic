<UserControl x:Class="MaxChemical.Modules.DOE.Views.DOEGPRModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="#F5F5F5">
    <UserControl.Resources>
        <ResourceDictionary Source="DOEStyles.xaml"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,16,16,20">

            <!-- ═══ 模型切换条 ═══ -->
            <ItemsControl ItemsSource="{Binding Models}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,0" Padding="8,6" CornerRadius="3" Cursor="Hand"
                                BorderThickness="1" Background="{Binding TabBackground}" BorderBrush="{Binding TabBorderBrush}"
                                MouseLeftButtonDown="ModelTab_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{Binding StatusDotColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ModelName}" FontSize="11" Foreground="{Binding TabForeground}" FontWeight="{Binding TabFontWeight}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ShortInfo}" FontSize="10" Foreground="#999" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ 状态信息条 ═══ -->
            <Border Background="#F8F8F8" BorderBrush="#E8E8E8" BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{Binding SelectedModel.StatusDotColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock FontSize="11" VerticalAlignment="Center">
                        <Run Text="{Binding SelectedModel.ModelName,Mode=OneWay}" FontWeight="SemiBold" Foreground="#222"/>
                        <Run Text=" · " Foreground="#CCC"/>
                        <Run Text="{Binding SelectedModel.FactorSignature,Mode=OneWay}" FontFamily="Consolas" FontSize="10" Foreground="#0078D4"/>
                        <Run Text=" · " Foreground="#CCC"/>
                        <Run Text="{Binding SelectedModel.StatusSummary, Mode=OneWay}" Foreground="#888"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ═══ 指标行 ═══ -->
            <UniformGrid Columns="4" Margin="0,0,0,10">
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="状态" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedModel.StatusText}" FontSize="14" FontWeight="Bold" Foreground="{Binding SelectedModel.StatusColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedModel.StatusHint}" FontSize="9" Foreground="#AAA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="10" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="训练数据" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedModel.DataCountText}" FontSize="20" FontWeight="Bold" Foreground="#222" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedModel.BatchCountHint}" FontSize="9" Foreground="#AAA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="10" Margin="2,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="R²" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedModel.RSquaredText}" FontSize="20" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Center"/>
                        <TextBlock Text="拟合优度" FontSize="9" Foreground="#AAA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="10" Margin="4,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="RMSE" FontSize="10" Foreground="#888" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedModel.RMSEText}" FontSize="20" FontWeight="Bold" Foreground="#222" HorizontalAlignment="Center"/>
                        <TextBlock Text="预测偏差" FontSize="9" Foreground="#AAA" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═══ 图表行 ═══ -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>
                        <Border Background="#F8F8F8" Padding="10,7" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                            <TextBlock Text="模型演进 R² vs 数据量" FontSize="11" FontWeight="SemiBold" Foreground="#444"/>
                        </Border>
                        <oxy:PlotView Grid.Row="1" Model="{Binding EvolutionPlot}" Background="White" Margin="6"/>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>
                        <Border Background="#F8F8F8" Padding="10,7" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                            <TextBlock Text="参数敏感性" FontSize="11" FontWeight="SemiBold" Foreground="#444"/>
                        </Border>
                        <oxy:PlotView Grid.Row="1" Model="{Binding SensitivityPlot}" Background="White" Margin="6"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ 底部行：详情 + 最优 ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 模型详情 -->
                <Border Grid.Column="0" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#F8F8F8" Padding="10,7" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="模型详情" FontSize="11" FontWeight="SemiBold" Foreground="#444"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="重新训练" Style="{StaticResource DOEPrimaryBtn}" Padding="10,3" Height="22" FontSize="10" Margin="0,0,4,0"
                                            Command="{Binding RetrainCommand}"/>
                                    <Button Content="搜索最优" Padding="10,3" Height="22" FontSize="10" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0"
                                            Command="{Binding FindOptimalCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="3" Padding="{TemplateBinding Padding}" Background="#4CAF50">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Foreground>
                                            <SolidColorBrush Color="White"/>
                                        </Button.Foreground>
                                    </Button>
                                    <Button Content="删除" Style="{StaticResource DOEDangerBtn}" Padding="10,3" Height="22" FontSize="10"
                                            Command="{Binding DeleteModelCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="12,8">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="模型名称" FontSize="11" Foreground="#888"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedModel.ModelName}" FontSize="11" FontWeight="Medium" Foreground="#222"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="因子签名" FontSize="11" Foreground="#888"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedModel.FactorSignature}" FontSize="10" FontFamily="Consolas" Foreground="#0078D4"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="核函数" FontSize="11" Foreground="#888"/>
                                <TextBlock Grid.Column="1" Text="ConstantKernel x RBF + WhiteKernel" FontSize="11" FontWeight="Medium" Foreground="#222"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="冷启动" FontSize="11" Foreground="#888"/>
                                <TextBlock Grid.Column="1" Text="6 组" FontSize="11" FontWeight="Medium" Foreground="#222"/>
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关联批次" FontSize="11" Foreground="#888"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedModel.BatchCountHint}" FontSize="11" FontWeight="Medium" Foreground="#222"/>
                            </Grid>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="上次训练" FontSize="11" Foreground="#888"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedModel.LastTrainedText}" FontSize="11" FontWeight="Medium" Foreground="#222"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 最优参数预测 -->
                <Border Grid.Column="2" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#F8F8F8" Padding="10,7" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="最优参数预测" FontSize="11" FontWeight="SemiBold" Foreground="#444"/>
                                <TextBlock Text="Expected Improvement" FontSize="10" Foreground="#888" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="12,8">
                            <!-- 因子进度条 -->
                            <ItemsControl ItemsSource="{Binding OptimalFactors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Height="4" Background="#EEE" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <Border CornerRadius="2" HorizontalAlignment="Left" Width="{Binding BarWidth}" Background="#0078D4"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F2}}" FontSize="11" FontWeight="SemiBold"
                                                       FontFamily="Consolas" Foreground="#222" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 预测结果 -->
                            <Border Margin="0,10,0,0" Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="3" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="预测转化率" FontSize="9" Foreground="#66BB6A"/>
                                        <TextBlock Text="{Binding OptimalResponseText}" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding OptimalConfidenceText}" FontSize="9" Foreground="#81C784" VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
