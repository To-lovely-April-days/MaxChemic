<UserControl x:Class="MaxChemical.Modules.DOE.Views.DOEMiniPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MaxChemical.Modules.DOE.Converters"
             MinWidth="420" MaxWidth="720">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DOEWizardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <local:PlusOneConverter x:Key="PlusOne"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="12" Background="#EEF1F6" BorderBrush="{StaticResource WzDivider}" BorderThickness="0.5"
            MouseLeftButtonDown="TitleBar_MouseDown" Padding="14,10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.08"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── 左: 进度环 + 组号 ── -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                <Grid Width="44" Height="44" Margin="0,0,10,0">
                    <Ellipse Width="44" Height="44" StrokeThickness="3.5" Stroke="#DDE1E8" Fill="Transparent"/>
                    <Ellipse Width="44" Height="44" StrokeThickness="3.5" Fill="Transparent"
                             Stroke="{StaticResource WzPrimary}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                             StrokeDashArray="6.91 100" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" FontWeight="Medium" Foreground="#1A1F36" FontFamily="Consolas"
                               Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <!-- 当前组号 + 状态 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,1">
                        <TextBlock FontSize="13" FontWeight="Medium" Foreground="#1A1F36">
                            <Run Text="#"/><Run Text="{Binding CurrentRun, Mode=OneWay, Converter={StaticResource PlusOne}}"/>
                        </TextBlock>
                        <!-- 执行中（运行时） -->
                        <TextBlock Name="TbExecuted" Text=" 执行中" FontSize="13" FontWeight="Medium" Foreground="#2D3A8C"
                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                        <!-- 已暂停（暂停时） -->
                        <TextBlock Name="TbPaused" Text=" 已暂停" FontSize="13" FontWeight="Medium" Foreground="#D97706"
                                   Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock FontSize="10" Foreground="#9CA3AF">
                        <Run Text="{Binding CurrentRun, Mode=OneWay, Converter={StaticResource PlusOne}}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding TotalRuns, Mode=OneWay}"/>
                        <Run Name="TbGroup" Text=" 组 · "/>
                        <Run Text="{Binding ETAText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- 分隔线 -->
            <Border Grid.Column="1" Width="0.5" Background="#DDE1E8" Margin="2,6"/>

            <!-- ── 中: 因子参数 ── -->
            <ItemsControl Grid.Column="2" ItemsSource="{Binding CurrentFactorItems}" Margin="10,0"
                          VerticalAlignment="Center"
                          Visibility="{Binding HasCurrentFactors, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#F7F8FA" CornerRadius="6" Padding="8,5" Margin="2,0"
                                BorderBrush="#E2E5EB" BorderThickness="0.5" MinWidth="64">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="9" Foreground="#6B7280"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="Medium"
                                           Foreground="#1A1F36" FontFamily="Consolas" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 无因子时占位 -->
            <TextBlock Name="TbWaitData" Grid.Column="2" Text="等待因子数据..." FontSize="11" Foreground="#9CA3AF"
                       VerticalAlignment="Center" Margin="12,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCurrentFactors}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 分隔线 -->
            <Border Grid.Column="3" Width="0.5" Background="#DDE1E8" Margin="2,6"/>

            <!-- ── 指标: 最优 ── -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Name="TbBest" Text="最优" FontSize="9" Foreground="#9CA3AF"/>
                <TextBlock Text="{Binding BestRunText}" FontSize="12" FontWeight="Medium" Foreground="#1A1F36"/>
            </StackPanel>

            <!-- 分隔线 -->
            <Border Grid.Column="5" Width="0.5" Background="#DDE1E8" Margin="2,6"/>

            <!-- ── 按钮组 ── -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <!-- 暂停 -->
                <Button Name="BtnPause" Command="{Binding PauseCommand}" Margin="0,0,4,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                                                Background="Transparent" BorderBrush="#C7CCD4" BorderThickness="0.5">
                                            <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontWeight="Medium" Foreground="#374151"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E4E7EE"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 恢复 -->
                <Button Name="BtnResume" Command="{Binding ResumeCommand}" Margin="0,0,4,0"
                        Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                                    Background="Transparent" BorderBrush="#059669" BorderThickness="0.5">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontWeight="Medium" Foreground="#059669"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E0F5EC"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 终止 -->
                <Button Name="BtnSuspend" Command="{Binding AbortCommand}" Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Padding="10,5"
                                    Background="Transparent" BorderBrush="#D4D8E0" BorderThickness="0.5">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontWeight="Medium" Foreground="#DC2626"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F5E6E7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 展开 -->
                <Button Name="BtnExpand" Command="{Binding ToggleMiniModeCommand}" ToolTip="展开为大窗口" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="6" Width="28" Height="28"
                                    Background="Transparent" BorderBrush="#D4D8E0" BorderThickness="0.5">
                                <Path Data="M3,7 L7,3 L11,7" Stroke="#9CA3AF" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="14" Height="10" Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E4E7EE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
