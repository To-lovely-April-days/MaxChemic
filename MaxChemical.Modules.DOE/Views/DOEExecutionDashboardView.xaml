<UserControl x:Class="MaxChemical.Modules.DOE.Views.DOEExecutionDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F2F4F7">
    <UserControl.Resources>
        <ResourceDictionary Source="DOEStyles.xaml"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
        <StackPanel>
            <!-- 标题+控制 -->
            <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Margin="0,0,0,12">
                <Border Background="#FAFBFC" Padding="14,10" CornerRadius="10" BorderBrush="#E8EAED" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding BatchName}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1F36"/>
                            <TextBlock Text="{Binding BatchId}" FontSize="10" Foreground="#8A8F9C" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="开始执行" Style="{StaticResource DOESuccessBtn}" Padding="16,6" Margin="0,0,4,0"
                                    Command="{Binding StartCommand}"/>
                            <Button Content="暂停" Style="{StaticResource DOEWarningBtn}" Padding="16,6" Margin="0,0,4,0"
                                    Command="{Binding PauseCommand}"/>
                            <Button Content="恢复" Style="{StaticResource DOEPrimaryBtn}" Padding="16,6" Margin="0,0,4,0"
                                    Command="{Binding ResumeCommand}" IsEnabled="{Binding IsPaused}"/>
                            <Button Content="终止" Style="{StaticResource DOEDangerBtn}" Padding="16,6"
                                    Command="{Binding StopCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- 进度 + 最优 + GPR 三栏 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>

                <!-- 进度 -->
                <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Padding="18">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="执行进度" FontSize="12" Foreground="#4A5066"/>
                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Foreground="#0078D4"/>
                        </Grid>
                        <Border Height="6" Background="#E8EAED" CornerRadius="3">
                            <Border CornerRadius="3" HorizontalAlignment="Left" Width="{Binding ProgressBarWidth}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0078D4" Offset="0"/>
                                        <GradientStop Color="#3B9EFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#A0A4B0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 最优 -->
                <Border Grid.Column="2" CornerRadius="8" Padding="14" BorderThickness="1" BorderBrush="#C2D9F5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#EBF3FE" Offset="0"/>
                            <GradientStop Color="#D6E8FC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="BEST RESULT" FontSize="9" FontWeight="Bold" Foreground="#0062B8" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding BestRunText}" FontSize="13" FontWeight="Bold" Foreground="#1A1F36"/>
                        <TextBlock Text="{Binding BestValueText}" FontSize="10" Foreground="#5A7CA8" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- GPR -->
                <Border Grid.Column="4" CornerRadius="8" Padding="14" BorderThickness="1" BorderBrush="#B5E3C6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E8F8EE" Offset="0"/>
                            <GradientStop Color="#D0F0DC" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="GPR MODEL" FontSize="9" FontWeight="Bold" Foreground="#0D7A3E" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#16C60C" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GPRStatusText}" FontSize="13" FontWeight="Bold" Foreground="#1A1F36"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GPRDetailText}" FontSize="10" Foreground="#5A9C76" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 结果表 -->
            <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#FAFBFC" Padding="18,10" BorderBrush="#E8EAED" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                        <TextBlock Text="实验结果记录" FontSize="13" FontWeight="SemiBold" Foreground="#1A1F36"/>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RunResults}" Style="{StaticResource DOEDataGrid}"
                              ColumnHeaderStyle="{StaticResource DOEColHeader}" MaxHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding RunIndex}" Width="40"/>
                            <DataGridTextColumn Header="因子值" Binding="{Binding FactorSummary}" Width="*"/>
                            <DataGridTextColumn Header="响应值" Binding="{Binding ResponseSummary}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#0078D4"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="来源" Binding="{Binding DataSource}" Width="70"/>
                            <DataGridTextColumn Header="耗时" Binding="{Binding Duration}" Width="50"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 底部状态条 -->
            <Border Background="White" CornerRadius="10" BorderBrush="#ECEEF2" BorderThickness="1" Padding="14,8"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="14" Height="14" Margin="0,0,8,0">
                        <Ellipse Width="14" Height="14" Stroke="#E8EAED" StrokeThickness="2"/>
                        <Ellipse Width="14" Height="14" Stroke="#0078D4" StrokeThickness="2" StrokeDashArray="4 3"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><RotateTransform x:Name="FootSpin" Angle="0"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="FootSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8"/>
                                </Storyboard>
                            </BeginStoryboard></EventTrigger></Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#8A8F9C"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
