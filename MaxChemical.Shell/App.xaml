<prism:PrismApplication x:Class="MaxChemical.Shell.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:prism="http://prismlibrary.com/">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ★ 品牌色板必须最先加载,后面所有样式都引用它 -->
                <ResourceDictionary Source="Resources/ThemeColors.xaml"/>
                <ResourceDictionary Source="Resources/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 自定义细滚动条样式 -->
            <Style x:Key="ThinScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb" Background="#C0C0C0" Width="6">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="3"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#808080"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter Property="Background" Value="#606060"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" 
                                                      Opacity="0" 
                                                      Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" 
                                                      Opacity="0" 
                                                      Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Track x:Name="PART_Track" Focusable="False">
                                            <Track.Thumb>
                                                <Thumb x:Name="Thumb" Background="#C0C0C0" Height="6">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    CornerRadius="3"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#808080"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter Property="Background" Value="#606060"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageRightCommand" 
                                                              Opacity="0" 
                                                              Focusable="False"/>
                                            </Track.IncreaseRepeatButton>
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="ScrollBar.PageLeftCommand" 
                                                              Opacity="0" 
                                                              Focusable="False"/>
                                            </Track.DecreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 细滚动条ScrollViewer样式 -->
            <Style x:Key="ThinScrollViewerStyle" TargetType="ScrollViewer">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                        Grid.Column="0" Grid.Row="0"
                                                        Content="{TemplateBinding Content}"
                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                        CanHorizontallyScroll="False"
                                                        CanVerticallyScroll="False"/>

                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                           Grid.Column="1" Grid.Row="0"
                                           Style="{StaticResource ThinScrollBarStyle}"
                                           Orientation="Vertical"
                                           Value="{TemplateBinding VerticalOffset}"
                                           Maximum="{TemplateBinding ScrollableHeight}"
                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>

                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                           Grid.Column="0" Grid.Row="1"
                                           Style="{StaticResource ThinScrollBarStyle}"
                                           Orientation="Horizontal"
                                           Value="{TemplateBinding HorizontalOffset}"
                                           Maximum="{TemplateBinding ScrollableWidth}"
                                           ViewportSize="{TemplateBinding ViewportWidth}"
                                           Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ToolButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 执行动画资源 -->
            <Storyboard x:Key="ExecutingAnimation" RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0.3" To="1.0" Duration="0:0:0.8"
                     AutoReverse="True"/>
                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                From="#1D9E75" To="#A41626" Duration="0:0:1.2"
                AutoReverse="True"/>
            </Storyboard>

            <Storyboard x:Key="CompletedAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="1.0" To="0.8" Duration="0:0:0.3"/>
                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                To="#1D9E75" Duration="0:0:0.3"/>
            </Storyboard>

            <Storyboard x:Key="FailedAnimation">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="1.0" To="0.9" Duration="0:0:0.3"/>
                <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                To="#C42626" Duration="0:0:0.3"/>
            </Storyboard>

            <!-- 设备节点执行状态样式 -->
            <Style x:Key="ExecutingDeviceNodeStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="{StaticResource Border.Default}"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Background" Value="{StaticResource Bg.PrimaryBrush}"/>
                <Style.Triggers>
                    <!-- 选中状态 -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush">
                            <Setter.Value>
                                <SolidColorBrush Color="{StaticResource Brand.Primary}"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>

                    <!-- 执行中动画 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Name="ExecutingStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.3" To="1.0" Duration="0:0:0.8"
                                       AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.05" Duration="0:0:0.2"
                                         AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                          From="1.0" To="1.05" Duration="0:0:0.2"
                                          AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <Setter Property="BorderBrush" Value="{StaticResource Status.SuccessBrush}"/>
                        <Setter Property="Background" Value="{StaticResource Status.SuccessLightBrush}"/>
                    </DataTrigger>

                    <!-- 失败状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                        <Setter Property="BorderBrush" Value="{StaticResource Status.DangerBrush}"/>
                        <Setter Property="Background" Value="{StaticResource Status.DangerLightBrush}"/>
                    </DataTrigger>

                    <!-- 等待状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                        <Setter Property="BorderBrush" Value="{StaticResource Status.InfoBrush}"/>
                        <Setter Property="Background" Value="{StaticResource Status.InfoLightBrush}"/>
                    </DataTrigger>

                    <!-- 插入高亮状态 -->
                    <DataTrigger Binding="{Binding IsInsertHighlight}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brand.PrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect ShadowDepth="0"
                                  Direction="0"
                                  BlurRadius="20"
                                  Color="{StaticResource Brand.Primary}"
                                  Opacity="0.5"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ExecutingLogicNodeStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

                <Style.Triggers>
                    <!-- 选中状态 -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="#0078D4"/>
                    </DataTrigger>

                    <!-- 执行中动画 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Name="IfExecutingStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                          From="0.6" To="1.0" Duration="0:0:1"
                                          AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                          From="1.0" To="1.02" Duration="0:0:1"
                                          AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                          From="1.0" To="1.02" Duration="0:0:1"
                                          AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="IfExecutingStoryboard"/>
                        </DataTrigger.ExitActions>
                        <Setter Property="BorderBrush" Value="#2196F3"/>
                        <Setter Property="Background" Value="#E3F2FD"/>
                    </DataTrigger>

                    <!-- 完成状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                          From="1.0" To="1.05" Duration="0:0:0.2"
                                          AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                          From="1.0" To="1.05" Duration="0:0:0.2"
                                          AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                        <Setter Property="Background" Value="#E8F5E8"/>
                    </DataTrigger>

                    <!-- 失败状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                        <Setter Property="BorderBrush" Value="#F44336"/>
                        <Setter Property="Background" Value="#FFEBEE"/>
                    </DataTrigger>

                    <!-- 等待状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                        <Setter Property="BorderBrush" Value="#FF9800"/>
                        <Setter Property="Background" Value="#FFF3E0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 设置变量节点执行状态样式 -->
            <Style x:Key="ExecutingSetVariableNodeStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

                <Style.Triggers>
                    <!-- 选中状态 -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="#0078D4"/>
                    </DataTrigger>

                    <!-- 执行中动画 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Name="SetVarExecutingStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.6" To="1.0" Duration="0:0:0.9"
                                         AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.02" Duration="0:0:0.9"
                                         AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.02" Duration="0:0:0.9"
                                         AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="SetVarExecutingStoryboard"/>
                        </DataTrigger.ExitActions>
                        <Setter Property="BorderBrush" Value="#795548"/>
                        <Setter Property="Background" Value="#EFEBE9"/>
                    </DataTrigger>

                    <!-- 完成状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.05" Duration="0:0:0.2"
                                         AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.05" Duration="0:0:0.2"
                                         AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                        <Setter Property="Background" Value="#E8F5E8"/>
                    </DataTrigger>

                    <!-- 失败状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                        <Setter Property="BorderBrush" Value="#F44336"/>
                        <Setter Property="Background" Value="#FFEBEE"/>
                    </DataTrigger>

                    <!-- 等待状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                        <Setter Property="BorderBrush" Value="#795548"/>
                        <Setter Property="Background" Value="#EFEBE9"/>
                    </DataTrigger>

                    <!-- 插入高亮状态 -->
                    <DataTrigger Binding="{Binding IsInsertHighlight}" Value="True">
                        <Setter Property="BorderBrush" Value="#186DF5"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect ShadowDepth="0"
                                      Direction="0"
                                      BlurRadius="20"
                                      Color="#186DF5"
                                      Opacity="0.5"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 等待节点执行状态样式 -->
            <Style x:Key="ExecutingWaitNodeStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Setter.Value>
                </Setter>
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

                <Style.Triggers>
                    <!-- 选中状态 -->
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="#0078D4"/>
                    </DataTrigger>

                    <!-- 执行中动画 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Name="WaitExecutingStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.5" To="1.0" Duration="0:0:1.2"
                                         AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.01" Duration="0:0:1.2"
                                         AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.01" Duration="0:0:1.2"
                                         AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="WaitExecutingStoryboard"/>
                        </DataTrigger.ExitActions>
                        <Setter Property="BorderBrush" Value="#607D8B"/>
                        <Setter Property="Background" Value="#ECEFF1"/>
                    </DataTrigger>

                    <!-- 完成状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                         From="1.0" To="1.05" Duration="0:0:0.2"
                                         AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                         From="1.0" To="1.05" Duration="0:0:0.2"
                                         AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                        <Setter Property="Background" Value="#E8F5E8"/>
                    </DataTrigger>

                    <!-- 失败状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                        <Setter Property="BorderBrush" Value="#F44336"/>
                        <Setter Property="Background" Value="#FFEBEE"/>
                    </DataTrigger>

                    <!-- 等待状态 -->
                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                        <Setter Property="BorderBrush" Value="#607D8B"/>
                        <Setter Property="Background" Value="#ECEFF1"/>
                    </DataTrigger>

                    <!-- 插入高亮状态 -->
                    <DataTrigger Binding="{Binding IsInsertHighlight}" Value="True">
                        <Setter Property="BorderBrush" Value="#186DF5"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect ShadowDepth="0"
                                      Direction="0"
                                      BlurRadius="20"
                                      Color="#186DF5"
                                      Opacity="0.5"/>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 标题栏样式 -->
            <Style x:Key="TitleBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Brand.SecondaryBrush}"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="CornerRadius" Value="8,8,0,0"/>
            </Style>



            <!--  全局阴影效果定义 -->

            <!-- 标准阴影 - 用于卡片、面板 -->
            <DropShadowEffect x:Key="StandardShadow"
                              Color="#000000"
                              ShadowDepth="0"
                              BlurRadius="12"
                              Opacity="0.15"/>

            <!-- 轻微阴影 - 用于悬停效果 -->
            <DropShadowEffect x:Key="LightShadow"
                              Color="#000000"
                              ShadowDepth="0"
                              BlurRadius="8"
                              Opacity="0.08"/>

            <!-- 深度阴影 - 用于弹窗、强调元素 -->
            <DropShadowEffect x:Key="DeepShadow"
                              Color="#000000"
                              ShadowDepth="2"
                              BlurRadius="16"
                              Opacity="0.25"/>

            <!-- 悬浮阴影 - 用于按钮悬停 -->
            <DropShadowEffect x:Key="ElevatedShadow"
                              Color="#000000"
                              ShadowDepth="4"
                              BlurRadius="20"
                              Opacity="0.2"/>

            <!-- ══ ComboBox 下拉框 ══ -->
            <Style x:Key="FieldComboStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Padding" Value="9,0,28,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="#FAFAFA"/>
                <Setter Property="Foreground" Value="#212121"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                                    <Grid>
                                        <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                                        <!-- 箭头图标 -->
                                        <Path x:Name="Arrow"
                                  Data="M 0 0 L 5 5 L 10 0"
                                  Stroke="#9E9E9E" StrokeThickness="1.5"
                                  Fill="Transparent"
                                  Width="10" Height="5"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  StrokeLineJoin="Round"
                                  IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                                <ToggleButton x:Name="ToggleButton"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Opacity="0"/>
                                <Popup x:Name="PART_Popup"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                                    <Border x:Name="DropDown"
                                Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="200">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="2" Direction="270"
                                                  BlurRadius="8" Color="#000000" Opacity="0.08"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#BDBDBD"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Bd" Property="Background" Value="White"/>
                                    <Setter TargetName="Arrow" Property="Stroke" Value="#2196F3"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Arrow" Property="Data" Value="M 0 5 L 5 0 L 10 5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- ComboBoxItem 样式 -->
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Height" Value="32"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="#212121"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4"
                                    Margin="4,2">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                                <Setter Property="Foreground" Value="#1565C0"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                                <Setter Property="Foreground" Value="#1565C0"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ CheckBox 复选框 ══ -->
            <Style x:Key="FieldCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#212121"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 自定义方框 -->
                                <Border x:Name="CheckBd"
                            Width="16" Height="16"
                            BorderBrush="#BDBDBD" BorderThickness="1.5"
                            CornerRadius="4"
                            Background="White"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                                    <!-- 勾选图标 -->
                                    <Path x:Name="CheckMark"
                              Data="M 2 8 L 6 12 L 14 4"
                              Stroke="White" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="Collapsed"
                              Stretch="None"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckBd" Property="Background" Value="#2196F3"/>
                                    <Setter TargetName="CheckBd" Property="BorderBrush" Value="#2196F3"/>
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckBd" Property="BorderBrush" Value="#2196F3"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 对话框基础按钮模板 -->
            <Style x:Key="DialogButtonBaseStyle" TargetType="Button">
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 对话框关闭按钮（白色X图标） -->
            <Style x:Key="CloseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="15"/>
                <Setter Property="Height" Value="15"/>
                <Setter Property="Margin" Value="0,0,13,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                <Image Source="pack://siteoforigin:,,,/Resources/Icon/closeWhite.png" 
                           Width="15" Height="15" 
                           Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brand.PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brand.PrimaryDarkBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 主按钮（确定/提交） -->
            <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button"
       BasedOn="{StaticResource DialogButtonBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource Brand.PrimaryBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.OnPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brand.PrimaryHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brand.PrimaryDarkBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 次按钮（取消） -->
            <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button"
       BasedOn="{StaticResource DialogButtonBaseStyle}">
                <Setter Property="Background" Value="{DynamicResource Border.StrongBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Bg.TertiaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>