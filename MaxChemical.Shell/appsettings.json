{
  "DeepSeek": {
    "ApiKey": "",
    "Model": "deepseek-chat"
  },
  "MaxChemicalMcp": {
    "Mode": "readonly",
    "PipeName": "MaxChemical.Mcp.v1"

  },
  "SherpaAsr": {
    "ModelDir": "Assets\\Sherpa\\sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17",
    "SileroVadPath": "Assets\\Sherpa\\silero_vad.onnx",
    "Language": "zh",
    "NumThreads": 2,
    "VadThreshold": 0.6,
    "MinSpeechDuration": 0.5,
    "EnergyThreshold": 0.015,
    "MinSegmentSeconds": 0.5,
    "MaxSpeechDuration": 15.0
  },
  "VoiceSettings": {
    "//": "Enabled=true 开启持续唤醒监听环:只说「你好小桐」才唤醒,唤醒后处于聆听状态直接说指令(与实验室/软件相关的才会发送),说「退出语音」退出语音响应。SpeakEnabled=true 回复语音播报。TtsProvider=bailian 走阿里云百炼 CosyVoice(自然人声,与语音识别同一网络通道;edge 在本机被 403 拦截)。AutoSleepSeconds=0 表示唤醒后一直聆听、不自动休眠。",
    "TtsProvider": "bailian",
    "Enabled": true,
    "SpeakEnabled": true,
    "AutoSleepSeconds": 0,
    "SherpaOnnx": {
      "ModelPath": "vits-melo-tts-zh_en",
      "SpeakerId": 0,
      "SpeakingRate": 1.0
    },
    "EdgeTts": {
      "Voice": "zh-CN-XiaoxiaoNeural",
      "SpeakingRate": 1.2,
      "Volume": "+0%",
      "Pitch": "+0Hz"
    },
    "AzureTts": {
      "SubscriptionKey": "",
      "Region": "eastasia",
      "DefaultVoice": "zh-CN-XiaoxiaoNeural",
      "SpeakingRate": "1.0",
      "Pitch": "+0Hz",
      "Volume": "+0%"
    },
    //Piper（本地离线语音合成 TTS）
    "Piper": {
      "ExecutablePath": "Piper\\piper.exe",
      "ModelsDirectory": "Piper\\models",
      "PreferredModel": "zh_CN-huayan-medium.onnx",
      "SpeakingRate": 1.0,
      "NoiseFactor": 0.667,
      "LengthScale": 1.0
    },
    //阿里云底层服务
    "AliyunCloud": {
      "AccessKeyId": "",
      "AccessKeySecret": "",
      "AppKey": "2N4jwL056W5ZvuHc"
    },
    // 阿里云语音识别（Aliyun ASR）调节麦克风录音灵敏度的。
    "AliyunAsr": {
      "EnergyThreshold": "0.003"
    }
  },
  // "阿里云百炼（Bailian）"语音交互 采样率。TtsSampleRate=22050 Hz 是音频的一个常见采样率
  "Bailian": {
    "ApiKey": "",
    "AsrModel": "paraformer-realtime-v2",
    "TtsModel": "cosyvoice-v2",
    "TtsVoice": "longshuo_v2",
    "TtsSampleRate": 22050
  },
  //博查 联网搜索 MaxResults 最大返回数
  "WebSearch": {
    "ApiKey": "",
    "BaseUrl": "https://api.bochaai.com/v1/web-search",
    "MaxResults": 5
  },
  "AiKnowledge": {
    "Embedding": {
      "//": "OpenAI 兼容 Embedding API。智谱: BaseUrl=https://open.bigmodel.cn/api/paas/v4, Model=embedding-3;阿里: BaseUrl=https://dashscope.aliyuncs.com/compatible-mode/v1, Model=text-embedding-v3",
      "BaseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "ApiKey": "",
      "Model": "embedding-3",
      "BatchSize": 8
    }
  },
  //AI 记忆模块 MaxFacts 最大事实/记忆条目数。RecallTopN 回忆提取数量
  "AiMemory": {
    "MaxFacts": 200,
    "RecallTopN": 5
  }
