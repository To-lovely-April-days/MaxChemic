<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════
         MaxChemical 品牌色板 (Brand: #A41626 + #1A1A1A)
         所有颜色定义的唯一中央位置
         ═══════════════════════════════════════════════════ -->

    <!-- ═══ 品牌色 ═══ -->
    <Color x:Key="Brand.Primary">#A41626</Color>
    <Color x:Key="Brand.PrimaryHover">#8E121F</Color>
    <Color x:Key="Brand.PrimaryLight">#FCEAEC</Color>
    <Color x:Key="Brand.PrimaryDark">#6B0E1A</Color>
    <Color x:Key="Brand.Secondary">#1A1A1A</Color>

    <!-- ═══ 文字色 ═══ -->
    <Color x:Key="Text.Primary">#1A1A1A</Color>
    <Color x:Key="Text.Secondary">#5F5E5A</Color>
    <Color x:Key="Text.Tertiary">#888780</Color>
    <Color x:Key="Text.OnPrimary">#FFFFFF</Color>

    <!-- ═══ 背景色 ═══ -->
    <Color x:Key="Bg.Primary">#FFFFFF</Color>
    <Color x:Key="Bg.Secondary">#FAFAF6</Color>
    <Color x:Key="Bg.Tertiary">#F1EFE8</Color>
    <Color x:Key="Bg.Hover">#F4F3EF</Color>

    <!-- ═══ 边框色 ═══ -->
    <Color x:Key="Border.Default">#EAEAEA</Color>
    <Color x:Key="Border.Strong">#D3D1C7</Color>
    <Color x:Key="Border.Subtle">#F1EFE8</Color>

    <!-- ═══ 状态色 (品牌化协调,不用纯彩) ═══ -->
    <Color x:Key="Status.Success">#1D9E75</Color>
    <Color x:Key="Status.SuccessLight">#E1F5EE</Color>
    <Color x:Key="Status.Warning">#BA7517</Color>
    <Color x:Key="Status.WarningLight">#FAEEDA</Color>
    <Color x:Key="Status.Danger">#C42626</Color>
    <Color x:Key="Status.DangerLight">#FCEBEB</Color>
    <Color x:Key="Status.Info">#5F5E5A</Color>
    <Color x:Key="Status.InfoLight">#F1EFE8</Color>

    <!-- ═══════════════════════════════════════════════════
         Brush 资源(冻结后供全局使用)
         ═══════════════════════════════════════════════════ -->

    <!-- 品牌 -->
    <SolidColorBrush x:Key="Brand.PrimaryBrush"      Color="{StaticResource Brand.Primary}"/>
    <SolidColorBrush x:Key="Brand.PrimaryHoverBrush" Color="{StaticResource Brand.PrimaryHover}"/>
    <SolidColorBrush x:Key="Brand.PrimaryLightBrush" Color="{StaticResource Brand.PrimaryLight}"/>
    <SolidColorBrush x:Key="Brand.PrimaryDarkBrush"  Color="{StaticResource Brand.PrimaryDark}"/>
    <SolidColorBrush x:Key="Brand.SecondaryBrush"    Color="{StaticResource Brand.Secondary}"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Text.PrimaryBrush"   Color="{StaticResource Text.Primary}"/>
    <SolidColorBrush x:Key="Text.SecondaryBrush" Color="{StaticResource Text.Secondary}"/>
    <SolidColorBrush x:Key="Text.TertiaryBrush"  Color="{StaticResource Text.Tertiary}"/>
    <SolidColorBrush x:Key="Text.OnPrimaryBrush" Color="{StaticResource Text.OnPrimary}"/>

    <!-- 背景 -->
    <SolidColorBrush x:Key="Bg.PrimaryBrush"   Color="{StaticResource Bg.Primary}"/>
    <SolidColorBrush x:Key="Bg.SecondaryBrush" Color="{StaticResource Bg.Secondary}"/>
    <SolidColorBrush x:Key="Bg.TertiaryBrush"  Color="{StaticResource Bg.Tertiary}"/>
    <SolidColorBrush x:Key="Bg.HoverBrush"     Color="{StaticResource Bg.Hover}"/>

    <!-- 边框 -->
    <SolidColorBrush x:Key="Border.DefaultBrush" Color="{StaticResource Border.Default}"/>
    <SolidColorBrush x:Key="Border.StrongBrush"  Color="{StaticResource Border.Strong}"/>
    <SolidColorBrush x:Key="Border.SubtleBrush"  Color="{StaticResource Border.Subtle}"/>

    <!-- 状态 -->
    <SolidColorBrush x:Key="Status.SuccessBrush"      Color="{StaticResource Status.Success}"/>
    <SolidColorBrush x:Key="Status.SuccessLightBrush" Color="{StaticResource Status.SuccessLight}"/>
    <SolidColorBrush x:Key="Status.WarningBrush"      Color="{StaticResource Status.Warning}"/>
    <SolidColorBrush x:Key="Status.WarningLightBrush" Color="{StaticResource Status.WarningLight}"/>
    <SolidColorBrush x:Key="Status.DangerBrush"       Color="{StaticResource Status.Danger}"/>
    <SolidColorBrush x:Key="Status.DangerLightBrush"  Color="{StaticResource Status.DangerLight}"/>
    <SolidColorBrush x:Key="Status.InfoBrush"         Color="{StaticResource Status.Info}"/>
    <SolidColorBrush x:Key="Status.InfoLightBrush"    Color="{StaticResource Status.InfoLight}"/>
    <!-- ═══ 时间范围切换按钮样式 ═══ -->
    <Style x:Key="TimeRangeRadioStyle" TargetType="RadioButton">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.TertiaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                Value="{DynamicResource Bg.PrimaryBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.PrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>