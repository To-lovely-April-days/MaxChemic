<UserControl x:Class="MaxChemical.Shell.Views.MainMenuBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Height="42">

    <UserControl.Resources>
        <!-- 修复的顶级菜单项样式 -->
        <Style x:Key="TopLevelMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#232323"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="38,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4,4,0,0">
                            <Grid>
                                <ContentPresenter x:Name="HeaderHost" 
                                                ContentSource="Header" 
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                <!-- 子菜单弹出位置 - 与主菜单左对齐 -->
                                <Popup x:Name="PART_Popup" 
                                       Placement="Bottom" 
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                       AllowsTransparency="True" 
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       VerticalOffset="-1"
                                       HorizontalOffset="-17">
                                    <!-- 无分割感的子菜单容器 -->
                                    <Grid>
                                        <!-- 阴影层 -->
                                        <Border Background="#20000000" 
                                                CornerRadius="0,0,6,6"
                                                Margin="2,0,6,6"/>
                                        <!-- 主要边框 - 移除顶部圆角和边框 -->
                                        <Border x:Name="SubmenuBorder" 
                                                Background="White" 
                                                BorderBrush="#E0E0E0" 
                                                BorderThickness="1,0,1,1"
                                                CornerRadius="0,0,4,4"
                                                MinWidth="240">
                                            <!-- 添加顶部连接条 -->
                                            <Grid>
                                                <!-- 顶部连接条，与子菜单背景色一致 -->
                                                <Border Height="1" 
                                                        Background="White" 
                                                        VerticalAlignment="Top"
                                                        Margin="0"/>
                                                <StackPanel IsItemsHost="True" 
                                                           KeyboardNavigation.DirectionalNavigation="Cycle"
                                                           Margin="4,4,4,4"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Foreground" Value="#232323"/>
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter Property="Foreground" Value="#232323"/>
                                <!-- 主菜单背景变为白色 -->
                                <Setter Property="Background" Value="White"/>
                                <!-- 添加边框以突出白色背景 -->
                                <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,0"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 第一个菜单项样式 - 4px左边距，使文字距离左侧20px (4+16=20) -->
        <Style x:Key="FirstMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource TopLevelMenuItemStyle}">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4,4,0,0">
                            <Grid>
                                <ContentPresenter x:Name="HeaderHost" 
                                                ContentSource="Header" 
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"/>
                                <!-- 第一个菜单项的子菜单弹出位置 - 与主菜单左对齐 -->
                                <Popup x:Name="PART_Popup" 
                                       Placement="Bottom" 
                                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                       AllowsTransparency="True" 
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       VerticalOffset="-1"
                                       HorizontalOffset="-17">
                                    <!-- 无分割感的子菜单容器 -->
                                    <Grid>
                                        <!-- 阴影层 -->
                                        <Border Background="#20000000" 
                                                CornerRadius="0,0,6,6"
                                                Margin="2,0,6,6"/>
                                        <!-- 主要边框 - 移除顶部圆角和边框 -->
                                        <Border x:Name="SubmenuBorder" 
                                                Background="White" 
                                                BorderBrush="#E0E0E0" 
                                                BorderThickness="1,0,1,1"
                                                CornerRadius="0,0,4,4"
                                                MinWidth="240">
                                            <!-- 添加顶部连接条 -->
                                            <Grid>
                                                <!-- 顶部连接条，与子菜单背景色一致 -->
                                                <Border Height="1" 
                                                        Background="White" 
                                                        VerticalAlignment="Top"
                                                        Margin="0"/>
                                                <StackPanel IsItemsHost="True" 
                                                           KeyboardNavigation.DirectionalNavigation="Cycle"
                                                           Margin="4,4,4,4"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Foreground" Value="#232323"/>
                                <Setter Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter Property="Foreground" Value="#232323"/>
                                <!-- 主菜单背景变为白色 -->
                                <Setter Property="Background" Value="White"/>
                                <!-- 添加边框以突出白色背景 -->
                                <Setter TargetName="Border" Property="BorderThickness" Value="1,1,1,0"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS Code风格的子菜单项样式 - 完全自适应宽度版本 -->
        <Style x:Key="SubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#232323"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="240"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" 
                        Background="{TemplateBinding Background}" 
                        BorderThickness="0"
                        CornerRadius="2"
                        Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                Width="20" 
                                Height="20" 
                                Margin="8,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                                    <ContentPresenter x:Name="IconHost" 
                                            ContentSource="Icon" 
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>
                                </Border>

                                <ContentPresenter x:Name="HeaderHost" 
                                        Grid.Column="1"
                                        ContentSource="Header" 
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Margin="4,0,8,0"/>

                                <TextBlock x:Name="InputGestureText"
                                 Grid.Column="2"
                                 Text="{TemplateBinding InputGestureText}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Right"
                                 FontSize="12"
                                 Foreground="#232323"
                                 Margin="8,0,8,0"/>

                                <Path x:Name="ArrowPath"
                              Grid.Column="3"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Fill="#232323"
                              Data="M0,0 L0,8 L4,4 z"
                              Visibility="Collapsed"/>

                                <!-- 简化的子菜单弹出 -->
                                <Popup x:Name="PART_Popup" 
                               Placement="Right" 
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                               AllowsTransparency="True" 
                               Focusable="False"
                               PopupAnimation="Fade"
                               HorizontalOffset="5"
                               VerticalOffset="-7">
                                    <Grid>
                                        <!-- 阴影层 -->
                                        <Border Background="#20000000" 
                                        CornerRadius="0,6,6,6"
                                        Margin="0,2,6,6"/>
                                        <!-- 主要边框 - 无宽度限制 -->
                                        <Border Background="White" 
                                        BorderBrush="#E0E0E0" 
                                        BorderThickness="1"
                                        CornerRadius="4">
                                            <StackPanel IsItemsHost="True" 
                                               KeyboardNavigation.DirectionalNavigation="Cycle"
                                               Margin="4"/>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#E6E6FA"/>
                                <Setter Property="Foreground" Value="#232323"/>
                                <Setter TargetName="InputGestureText" Property="Foreground" Value="#232323"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#232323"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#232323"/>
                                <Setter TargetName="InputGestureText" Property="Foreground" Value="#232323"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#232323"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#232323"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分隔线样式 -->
        <Style x:Key="MenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Margin" Value="16,4,8,4"/>
        </Style>

        <!-- 嵌套子菜单项样式 - 完全自适应宽度 -->
        <Style x:Key="NestedSubMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource SubMenuItemStyle}">
            <!-- 移除所有宽度设置，让内容决定宽度 -->
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" 
                        Background="{TemplateBinding Background}" 
                        BorderThickness="0"
                        CornerRadius="2"
                        Margin="2,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- 改为Auto -->
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                Width="20" 
                                Height="20" 
                                Margin="6,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                    <ContentPresenter x:Name="IconHost" 
                                            ContentSource="Icon" 
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"/>
                                </Border>

                                <ContentPresenter x:Name="HeaderHost" 
                                        Grid.Column="1"
                                        ContentSource="Header" 
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,8,0"/>

                                <TextBlock x:Name="InputGestureText"
                                 Grid.Column="2"
                                 Text="{TemplateBinding InputGestureText}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Right"
                                 FontSize="12"
                                 Foreground="#232323"
                                 Margin="0,0,8,0"/>

                                <Path x:Name="ArrowPath"
                              Grid.Column="3"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Fill="#232323"
                              Data="M0,0 L0,8 L4,4 z"
                              Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#E6E6FA"/>
                                <Setter Property="Foreground" Value="#232323"/>
                                <Setter TargetName="InputGestureText" Property="Foreground" Value="#232323"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#232323"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#232323"/>
                                <Setter TargetName="InputGestureText" Property="Foreground" Value="#232323"/>
                                <Setter TargetName="ArrowPath" Property="Fill" Value="#232323"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#232323"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 修改背景色 -->
    <Border Background="#F4F3EF" BorderThickness="0">
        <Menu Background="#F4F3EF" 
              FontFamily="Microsoft YaHei UI" 
              FontSize="16" 
              Height="42"
              BorderThickness="0">

            <!-- 文件菜单 - 使用绑定 -->
            <MenuItem Header="{Binding MenuFile}" Style="{StaticResource FirstMenuItemStyle}">
                <MenuItem Header="{Binding MenuNewProject}" 
                          Command="{Binding NewProjectCommand}" 
                          InputGestureText="Ctrl+N" 
                          Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16">
                            <Image Source="pack://siteoforigin:,,,/Resources/Icon/newfile.png"/>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="{Binding MenuOpenProject}" 
                          Command="{Binding OpenProjectCommand}" 
                          InputGestureText="Ctrl+O" 
                          Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16">
                            <Image Source="pack://siteoforigin:,,,/Resources/Icon/openfile.png"/>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>

                <Separator Style="{StaticResource MenuSeparatorStyle}"/>

                <MenuItem Header="{Binding MenuSave}" 
                          Command="{Binding SaveCommand}" 
                          InputGestureText="Ctrl+S" 
                          Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16">
                            <Image Source="pack://siteoforigin:,,,/Resources/Icon/savefile.png"/>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="{Binding MenuSaveAs}" 
                          Command="{Binding SaveAsCommand}" 
                          Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16">
                            <Image Source="pack://siteoforigin:,,,/Resources/Icon/saveas.png"/>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>

                <Separator Style="{StaticResource MenuSeparatorStyle}"/>

                <MenuItem Header="{Binding MenuRecentFiles}" Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.ItemsSource>
                        <Binding Path="RecentFiles"/>
                    </MenuItem.ItemsSource>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource NestedSubMenuItemStyle}">
                            <Setter Property="Header" Value="{Binding DisplayName}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Menu}}"/>
                            <Setter Property="CommandParameter" Value="{Binding FilePath}"/>
                            <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
            </MenuItem>

            <!-- 历史实验菜单 -->
            <MenuItem Header="{Binding MenuHistory}" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{Binding MenuViewHistory}" 
                          Command="{Binding ViewHistoryCommand}" 
                          Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Width="22" Height="22">
                            <Image Source="pack://siteoforigin:,,,/Resources/Icon/Historicalrecords.png"/>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding MenuExportData}" 
                          Command="{Binding ExportDataCommand}" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="{Binding MenuExperimentStats}" 
                          Command="{Binding ExperimentStatsCommand}" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="{Binding MenuGenerateReport}" 
                          Command="{Binding GenerateReportCommand}" 
                          Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>

            <!-- 窗口菜单 -->
            <MenuItem Header="{Binding MenuWindow}" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{Binding MenuToolbar}" 
                          IsCheckable="True" 
                          IsChecked="{Binding IsToolbarVisible}" 
                          Style="{StaticResource SubMenuItemStyle}"/>
            </MenuItem>

            <!-- 工具菜单 -->
            <MenuItem Header="{Binding MenuTools}" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{Binding MenuLanguage}" Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Width="22" Height="22">
                            <Image Source="pack://siteoforigin:,,,/Resources/Icon/Language.png"/>
                        </Border>
                    </MenuItem.Icon>
                    <MenuItem Header="{Binding MenuLanguageChinese}" 
                              Command="{Binding SwitchToChineseCommand}" 
                              Style="{StaticResource NestedSubMenuItemStyle}"/>
                    <MenuItem Header="{Binding MenuLanguageEnglish}" 
                              Command="{Binding SwitchToEnglishCommand}" 
                              Style="{StaticResource NestedSubMenuItemStyle}"/>
                </MenuItem>
            </MenuItem>

            <!-- 帮助菜单 -->
            <MenuItem Header="{Binding MenuHelp}" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="{Binding MenuUserManual}" 
                          Command="{Binding UserManualCommand}" 
                          InputGestureText="F1" 
                          Style="{StaticResource SubMenuItemStyle}"/>
                <MenuItem Header="{Binding MenuVideoTutorial}" 
                          Command="{Binding VideoTutorialCommand}" 
                          Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Background="#722ED1" CornerRadius="2" Width="16" Height="16">
                            <TextBlock Text="🎥" FontSize="10" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="{Binding MenuTechSupport}" 
                          Command="{Binding TechSupportCommand}" 
                          Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Background="#13C2C2" CornerRadius="2" Width="16" Height="16">
                            <TextBlock Text="🛠️" FontSize="10" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Style="{StaticResource MenuSeparatorStyle}"/>
                <MenuItem Header="{Binding MenuCheckUpdate}" 
                          Command="{Binding CheckUpdateCommand}" 
                          Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Background="#52C41A" CornerRadius="2" Width="16" Height="16">
                            <TextBlock Text="🔄" FontSize="10" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding MenuAbout}" 
                          Command="{Binding AboutCommand}" 
                          Style="{StaticResource SubMenuItemStyle}">
                    <MenuItem.Icon>
                        <Border Background="#1890FF" CornerRadius="2" Width="16" Height="16">
                            <TextBlock Text="ℹ️" FontSize="10" 
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
    </Border>
</UserControl>