<Window x:Class="MaxChemical.Shell.Views.AgentChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MaxChemical.Shell.Controls"
        Title="小桐 · 实验室智能助手"
        Width="1080" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 删除会话图标(垃圾桶):默认与辅助文字同灰,悬停转品牌危险色 -->
        <Geometry x:Key="TrashIconGeometry">M864 256 160 256C142.32 256 128 241.68 128 224 128 206.32 142.32 192 160 192L864 192C881.68 192 896 206.32 896 224 896 241.68 881.68 256 864 256ZM608 128 416 128C398.32 128 384 113.68 384 96 384 78.32 398.32 64 416 64L608 64C625.68 64 640 78.32 640 96 640 113.68 625.68 128 608 128ZM224 320C241.68 320 256 334.32 256 352L256 832C256 867.344 284.656 896 320 896L384 896 384 352C384 334.32 398.32 320 416 320 433.68 320 448 334.32 448 352L448 896 576 896 576 352C576 334.32 590.32 320 608 320 625.68 320 640 334.32 640 352L640 896 704 896C739.344 896 768 867.344 768 832L768 352C768 334.32 782.32 320 800 320 817.68 320 832 334.32 832 352L832 832C832 902.688 774.688 960 704 960L320 960C249.312 960 192 902.688 192 832L192 352C192 334.32 206.32 320 224 320Z</Geometry>

        <Style x:Key="ConvDeleteBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="ToolTip" Value="删除此对话"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <Path x:Name="Icon" Data="{StaticResource TrashIconGeometry}"
                                  Fill="{StaticResource Text.TertiaryBrush}"
                                  Stretch="Uniform" Width="13" Height="13"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Status.DangerLightBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Status.DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 仅在悬停该会话时显现,列表保持干净 -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ══ 按钮体系:主/描边/无边,统一圆角与品牌色悬停 ══ -->
        <Style x:Key="ChatPrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brand.PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.OnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.PrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatOutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Bg.PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Brand.PrimaryBrush}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Brand.PrimaryBrush}" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.PrimaryLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChatGhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text.SecondaryBrush}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text.PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ 小桐头像:图片加载后隐藏文字底标(不带任何背景),缺图回落文字标 ══ -->
        <DataTemplate x:Key="XiaoTongAvatar">
            <Grid Width="38" Height="38">
                <Border CornerRadius="9" Background="{StaticResource Brand.PrimaryBrush}"
                        Visibility="{DynamicResource XiaoTongFallbackVisibility}">
                    <TextBlock Text="桐" Foreground="{StaticResource Text.OnPrimaryBrush}"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Background="{DynamicResource XiaoTongAvatarBrush}"/>
            </Grid>
        </DataTemplate>

        <!-- 会话列表项 -->
        <Style x:Key="ConvItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Padding="11,8" Margin="2,1"
                                Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ 消息条目模板:按形态拆分,每行只实例化自己那一套控件树 ═══
             (原先五种形态挤一个模板靠 Visibility 切换,每行都建五套树、隐藏分支绑定照跑,
              MarkdownBlock/ChartBlock 对不相干的消息也白解析,切换会话整屏重建 ×5 导致卡顿) -->

        <!-- 用户消息:右侧品牌色气泡 -->
        <DataTemplate x:Key="ChatUserTemplate">
            <Border CornerRadius="12,12,3,12" Background="{StaticResource Brand.PrimaryBrush}"
                    Padding="14,9" MaxWidth="540" HorizontalAlignment="Right" Margin="0,6">
                <TextBlock Text="{Binding Text}" Foreground="{StaticResource Text.OnPrimaryBrush}" FontSize="12.5"
                           TextWrapping="Wrap" LineHeight="19"/>
            </Border>
        </DataTemplate>

        <!-- 助手消息:头像 + 白卡片 + Markdown 渲染 -->
        <DataTemplate x:Key="ChatAssistantTemplate">
            <Grid HorizontalAlignment="Left" MaxWidth="720" Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" ContentTemplate="{StaticResource XiaoTongAvatar}"
                                  VerticalAlignment="Top" Margin="0,0,10,0"/>
                <Border Grid.Column="1" CornerRadius="3,12,12,12" Background="{StaticResource Bg.PrimaryBrush}"
                        BorderThickness="1" Padding="14,11">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource Border.DefaultBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Status.DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ctrl:MarkdownBlock Markdown="{Binding Text}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 工具过程行:阶段标签 + 描述 -->
        <DataTemplate x:Key="ChatToolTemplate">
            <Border HorizontalAlignment="Stretch" Padding="12,6" CornerRadius="8"
                    Background="{StaticResource Bg.SecondaryBrush}"
                    BorderBrush="{StaticResource Border.SubtleBrush}" BorderThickness="1"
                    Margin="48,6,0,6">
                <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Padding="7,2" Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Brand.PrimaryLightBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ToolStage}" Value="完成">
                                            <Setter Property="Background" Value="{StaticResource Status.SuccessLightBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ToolStage}" Value="失败">
                                            <Setter Property="Background" Value="{StaticResource Status.DangerLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ToolStage}" FontSize="10.5" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Brand.PrimaryBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ToolStage}" Value="完成">
                                                <Setter Property="Foreground" Value="{StaticResource Status.SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ToolStage}" Value="失败">
                                                <Setter Property="Foreground" Value="{StaticResource Status.DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11"
                                   Foreground="{StaticResource Text.SecondaryBrush}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="10"
                                   Foreground="{StaticResource Text.TertiaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
            </Border>
        </DataTemplate>

        <!-- 图表卡片:分析工具直接插入,数据不经模型转述 -->
        <DataTemplate x:Key="ChatChartTemplate">
            <Border CornerRadius="12" Background="{StaticResource Bg.PrimaryBrush}"
                    BorderBrush="{StaticResource Border.DefaultBrush}" BorderThickness="1"
                    Padding="12,10" Margin="48,6,0,6" HorizontalAlignment="Left">
                <ctrl:ChartBlock ChartJson="{Binding Text}" Width="540"/>
            </Border>
        </DataTemplate>

        <!-- 确认卡片:题头条 + 正文 + 操作钮 -->
        <DataTemplate x:Key="ChatConfirmTemplate">
            <Border CornerRadius="12" Background="{StaticResource Bg.PrimaryBrush}"
                    BorderBrush="{StaticResource Border.StrongBrush}" BorderThickness="1"
                    MaxWidth="720" HorizontalAlignment="Left" Margin="48,6,0,6">
                    <StackPanel>
                        <Border Background="{StaticResource Brand.PrimaryBrush}" CornerRadius="11,11,0,0" Padding="14,8">
                            <TextBlock Text="{Binding ToolName, StringFormat='待确认 · {0}'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.OnPrimaryBrush}"/>
                        </Border>
                        <StackPanel Margin="16,12,16,14">
                            <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource Text.PrimaryBrush}" LineHeight="19" Margin="0,0,0,12"/>

                            <!-- 未决:操作按钮 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Button Content="取消" Command="{Binding RejectCommand}"
                                        Style="{StaticResource ChatOutlineBtn}"
                                        Foreground="{StaticResource Text.SecondaryBrush}"
                                        Margin="0,0,10,0"/>
                                <Button Content="确认执行" Command="{Binding ApproveCommand}"
                                        Style="{StaticResource ChatPrimaryBtn}"/>
                            </StackPanel>

                            <!-- 已决:结果标签 -->
                            <TextBlock FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsResolved}" Value="True"/>
                                                    <Condition Binding="{Binding Approved}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="已确认执行"/>
                                                <Setter Property="Foreground" Value="{StaticResource Status.SuccessBrush}"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsResolved}" Value="True"/>
                                                    <Condition Binding="{Binding Approved}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Text" Value="已取消"/>
                                                <Setter Property="Foreground" Value="{StaticResource Text.SecondaryBrush}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 选择卡:单选=单选框,多选=复选框;点确定回传所选项,历史卡片只读 -->
        <DataTemplate x:Key="ChatChoiceTemplate">
            <Border CornerRadius="12" Background="{StaticResource Bg.PrimaryBrush}"
                    BorderBrush="{StaticResource Border.StrongBrush}" BorderThickness="1"
                    MaxWidth="720" HorizontalAlignment="Left" Margin="48,6,0,6">
                <StackPanel>
                    <Border Background="{StaticResource Brand.PrimaryBrush}" CornerRadius="11,11,0,0" Padding="14,8">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.OnPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="请选择"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiSelect}" Value="True">
                                            <Setter Property="Text" Value="请选择(可多选)"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel Margin="16,12,16,14">
                        <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource Text.PrimaryBrush}" LineHeight="19" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <RadioButton Content="{Binding Text}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     GroupName="{Binding DataContext.GroupId, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     FontSize="12.5" Foreground="{StaticResource Text.PrimaryBrush}"
                                                     VerticalContentAlignment="Center" Cursor="Hand">
                                            <RadioButton.Style>
                                                <Style TargetType="RadioButton">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </RadioButton.Style>
                                        </RadioButton>
                                        <CheckBox Content="{Binding Text}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  FontSize="12.5" Foreground="{StaticResource Text.PrimaryBrush}"
                                                  VerticalContentAlignment="Center" Cursor="Hand">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsMultiSelect, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 未决:操作按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="取消" Command="{Binding CancelChoiceCommand}"
                                    Style="{StaticResource ChatOutlineBtn}"
                                    Foreground="{StaticResource Text.SecondaryBrush}"
                                    Margin="0,0,10,0"/>
                            <Button Content="确定" Command="{Binding SubmitChoiceCommand}"
                                    Style="{StaticResource ChatPrimaryBtn}"/>
                        </StackPanel>

                        <!-- 已决:结果标签 -->
                        <TextBlock FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsResolved}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="{Binding ChoiceResult, StringFormat=已选择:{0}}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Status.SuccessBrush}"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsResolved}" Value="True"/>
                                                <Condition Binding="{Binding ChoiceResult}" Value=""/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Text" Value="已取消"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text.SecondaryBrush}"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 形态选择器:必须放在全部模板之后 -->
        <ctrl:ChatTemplateSelector x:Key="ChatItemTemplateSelector"
                                   UserTemplate="{StaticResource ChatUserTemplate}"
                                   AssistantTemplate="{StaticResource ChatAssistantTemplate}"
                                   ToolTemplate="{StaticResource ChatToolTemplate}"
                                   ChartTemplate="{StaticResource ChatChartTemplate}"
                                   ConfirmTemplate="{StaticResource ChatConfirmTemplate}"
                                   ChoiceTemplate="{StaticResource ChatChoiceTemplate}"/>
    </Window.Resources>

    <!-- 外框 -->
    <Border Margin="12" CornerRadius="14" Background="{StaticResource Bg.PrimaryBrush}"
            BorderBrush="{StaticResource Border.DefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.5" Direction="270"/>
        </Border.Effect>

        <Grid>
            <!-- ══════ 完整对话视图 ══════ -->
            <Grid x:Name="FullContent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ 左栏:会话列表 ══════ -->
            <Border Grid.Column="0" Background="{StaticResource Bg.SecondaryBrush}" CornerRadius="14,0,0,14"
                    BorderBrush="{StaticResource Border.DefaultBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 品牌区(可拖动窗口) -->
                    <Border Grid.Row="0" Padding="16,16,16,12" Background="Transparent"
                            MouseLeftButtonDown="TitleBar_MouseDown">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="44" Height="44">
                                <Border CornerRadius="10" Background="{StaticResource Brand.PrimaryBrush}"
                                        Visibility="{DynamicResource XiaoTongFallbackVisibility}">
                                    <TextBlock Text="桐" Foreground="{StaticResource Text.OnPrimaryBrush}"
                                               FontSize="17" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Background="{DynamicResource XiaoTongAvatarBrush}"/>
                            </Grid>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TitleTxt}" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text.PrimaryBrush}"/>
                                    <TextBlock Text="{Binding SubtitleTxt}" FontSize="10.5"
                                           Foreground="{StaticResource Text.TertiaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 新建对话 -->
                    <Button Grid.Row="1" Margin="14,2,14,10" Cursor="Hand"
                            Command="{Binding NewChatCommand}"
                            Style="{StaticResource ChatOutlineBtn}"
                            HorizontalAlignment="Stretch"
                            Content="{Binding NewConversation}"/>

                    <!-- 搜索 -->
                    <Border Grid.Row="2" Margin="14,0,14,10" CornerRadius="8" Background="{StaticResource Bg.PrimaryBrush}"
                            BorderBrush="{StaticResource Border.StrongBrush}" BorderThickness="1">
                        <Grid>
                            <TextBox BorderThickness="0" Background="Transparent" FontSize="11.5"
                                     Padding="10,7" VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding SearchMarkTxt}" FontSize="11.5" Foreground="{StaticResource Text.TertiaryBrush}"
                                       Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- 会话列表(按 今天/昨天/更早 分组;滚动条走全局细样式) -->
                    <ListBox Grid.Row="3" Margin="10,0,10,12" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding ConversationsView}"
                             SelectedItem="{Binding Current}"
                             IsEnabled="{Binding IsNotBusy}"
                             ItemContainerStyle="{StaticResource ConvItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                        </ListBox.Resources>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text.TertiaryBrush}" Margin="8,10,0,4"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium"
                                                   Foreground="{StaticResource Text.PrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Preview}" FontSize="10.5"
                                                   Foreground="{StaticResource Text.TertiaryBrush}" TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource ConvDeleteBtn}"
                                            VerticalAlignment="Center" Margin="6,0,0,0"
                                            Command="{Binding DataContext.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ══════ 右栏:对话区 ══════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏 -->
                <Border Grid.Row="0" Background="{StaticResource Bg.PrimaryBrush}" Padding="20,12" CornerRadius="0,14,0,0"
                        BorderBrush="{StaticResource Border.DefaultBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Current.Title}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text.PrimaryBrush}" VerticalAlignment="Center"/>
                            <Border CornerRadius="99" Background="{StaticResource Brand.PrimaryLightBrush}"
                                    Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                <!-- 状态行只许一行:超长截断省略,换行内容不许撑破标题栏 -->
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" MaxWidth="360"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           Foreground="{StaticResource Brand.PrimaryBrush}" FontWeight="Medium"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="─" Click="Minimize_Click" ToolTip="{Binding MiniTxt}"
                                    Style="{StaticResource ChatGhostBtn}" FontSize="13" Margin="0,0,4,0"/>
                                <Button Content="✕" Click="Close_Click" ToolTip="{Binding MaxiTxt}"
                                    Style="{StaticResource ChatGhostBtn}" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 消息区:虚拟化列表(只渲染可视区域,长对话打开不卡),滚动条走全局细样式 -->
                <Grid Grid.Row="1">
                <ListBox x:Name="MsgList"
                         BorderThickness="0" Background="{StaticResource Bg.SecondaryBrush}"
                         Padding="20,14"
                         ItemsSource="{Binding Current.Items}"
                         ItemTemplateSelector="{StaticResource ChatItemTemplateSelector}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- 空会话引导:按场景分组的示例问题,点击填入输入框;发出第一条消息后自动消失 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource Bg.SecondaryBrush}" Padding="26,18,26,10">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>

                        <!-- 分类卡片 -->
                        <Style x:Key="WelcomeCard" TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Bg.PrimaryBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Border.DefaultBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="10"/>
                            <Setter Property="Padding" Value="16,13,16,10"/>
                            <Setter Property="Margin" Value="0,0,12,12"/>
                        </Style>
                        <Style x:Key="WelcomeCardTitle" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.PrimaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                        <Style x:Key="WelcomeCardDesc" TargetType="TextBlock">
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Foreground" Value="{StaticResource Text.TertiaryBrush}"/>
                            <Setter Property="Margin" Value="0,4,0,8"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>

                        <!-- 示例条目:整行可点,悬停浅红高亮 + 右侧浮现箭头 -->
                        <Style x:Key="WelcomeItem" TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="Command" Value="{Binding DataContext.FillInputCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="6" Padding="10,7" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="12"
                                                           Foreground="{StaticResource Text.SecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <Path x:Name="Ch" Grid.Column="1" Data="M0,0 L4,4 L0,8"
                                                      Stroke="{StaticResource Brand.PrimaryBrush}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center" Margin="8,0,2,0" Opacity="0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.PrimaryLightBrush}"/>
                                                <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource Brand.PrimaryBrush}"/>
                                                <Setter TargetName="Ch" Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="860" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Text="你好,我是小桐" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.PrimaryBrush}"/>
                        <TextBlock Text="从设计实验到执行、分析、预测、放大,一句话交给我。点击示例填入输入框,补全数字后发送。"
                                   FontSize="12" Foreground="{StaticResource Text.SecondaryBrush}" Margin="0,6,0,16" TextWrapping="Wrap"/>

                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource WelcomeCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource Brand.PrimaryBrush}"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="设计实验" Style="{StaticResource WelcomeCardTitle}"/>
                                    </StackPanel>
                                    <TextBlock Text="从口述需求到实验矩阵入库,支持化学家坐标(停留时间/当量比)" Style="{StaticResource WelcomeCardDesc}"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="查一下流程里哪些参数能做实验因子" CommandParameter="查一下流程里哪些参数能做实验因子"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="我要建一个新的优化项目,帮我设计实验" CommandParameter="我要建一个新的优化项目,帮我设计实验。因子和范围是:"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="用停留时间和当量比设计实验" CommandParameter="用化学家坐标设计实验:反应器有效体积 __ mL,底物泵浓度 __ mol/L,试剂泵浓度 __ mol/L,停留时间 __ 到 __ 分钟,当量比 __ 到 __,响应是收率"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="导入我自己的实验数据或方案" CommandParameter="我有自己的实验数据文件(CSV),帮我导入平台"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource WelcomeCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#D97706"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="执行与监控" Style="{StaticResource WelcomeCardTitle}"/>
                                    </StackPanel>
                                    <TextBlock Text="启动批次、实时进度播报、一句话联动调参(两泵按物理量自动换算)" Style="{StaticResource WelcomeCardDesc}"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="开始执行最新的批次" CommandParameter="开始执行最新的批次"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="现在执行到第几组了?" CommandParameter="现在执行到第几组了?这组参数是多少?"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="把停留时间调到 5 分钟,当量比不变" CommandParameter="把停留时间调到 __ 分钟,当量比保持不变"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource WelcomeCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#2A78D6"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="数据分析" Style="{StaticResource WelcomeCardTitle}"/>
                                    </StackPanel>
                                    <TextBlock Text="统计分析与图表直出:因子显著性、模型质量、多轮对比" Style="{StaticResource WelcomeCardDesc}"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="分析最近一轮实验,哪个因子显著?" CommandParameter="分析最近一轮实验,哪个因子显著?"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="这个项目整体优化到什么程度了?" CommandParameter="项目「__」整体优化到什么程度了?"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="我们以前做过类似实验吗?" CommandParameter="我们以前做过「__」相关的实验吗?最优条件是什么?"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="给项目生成一份 PDF 实验报告" CommandParameter="给项目「__」生成一份 PDF 实验报告"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource WelcomeCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="2" Background="#059669"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="预测与机理" Style="{StaticResource WelcomeCardTitle}"/>
                                    </StackPanel>
                                    <TextBlock Text="What-if 预测、反推条件、动力学拟合与放大换算" Style="{StaticResource WelcomeCardDesc}"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="如果温度 80、停留时间 5 分钟,收率多少?" CommandParameter="如果温度 __ 度、停留时间 __ 分钟,收率大概能到多少?"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="想让收率到 95%,条件怎么配?" CommandParameter="我想让收率到 __%,条件怎么配?"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="用这个项目的数据拟合动力学" CommandParameter="用项目「__」的数据拟合动力学"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="用阶梯扫描快速测动力学" CommandParameter="用阶梯扫描测动力学:反应器有效体积 __ mL,底物泵浓度 __ mol/L,试剂泵浓度 __ mol/L,当量比固定 __,停留时间台阶 __、__、__、__ 分钟,温度 __ 和 __ 度,响应是转化率"/>
                                    <Button Style="{StaticResource WelcomeItem}" Content="日产 50 克需要多大反应器?" CommandParameter="按现在的动力学,日产 __ 克需要多大反应器?"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
                </Grid>

                <!-- 输入区 -->
                <Border Grid.Row="2" Background="{StaticResource Bg.PrimaryBrush}" CornerRadius="0,0,14,0"
                        BorderBrush="{StaticResource Border.DefaultBrush}" BorderThickness="0,1,0,0" Padding="18,12,18,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="9" BorderBrush="{StaticResource Border.StrongBrush}"
                                    BorderThickness="1" Background="{StaticResource Bg.PrimaryBrush}">
                                <TextBox x:Name="InputBox" BorderThickness="0" Background="Transparent"
                                         FontSize="12.5" Padding="12,9" VerticalContentAlignment="Center"
                                         MinHeight="38" MaxHeight="96" TextWrapping="Wrap" AcceptsReturn="False"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="InputBox_KeyDown">
                                    <TextBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                                    </TextBox.Resources>
                                </TextBox>
                            </Border>
                            <!-- 忙碌时发送位切换成停止:多专员派工后单轮可能较长,给用户一个不杀进程的刹车 -->
                                <Button Grid.Column="1" Content="{Binding SendTxt}" Command="{Binding SendCommand}"
                                    Padding="24,9" Margin="10,0,0,0" VerticalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChatPrimaryBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1" Content="停止" Command="{Binding StopTurnCommand}"
                                    Padding="24,9" Margin="10,0,0,0" VerticalAlignment="Stretch"
                                    ToolTip="停止当前这轮任务(已确认执行的操作不会回滚)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChatPrimaryBtn}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                            <TextBlock Text="{Binding SendTipTxt}"
                                   FontSize="10" Foreground="{StaticResource Text.TertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>

            <!-- ══════ 执行值守小组件:头像+输入框+当前播报气泡(停靠屏幕右下角) ══════ -->
            <Grid x:Name="MiniContent" Visibility="Collapsed" Width="392">
                <StackPanel Margin="12,10">
                    <!-- 当前播报气泡:只显示最新一条,为空时隐藏 -->
                    <Border CornerRadius="10" Background="{StaticResource Bg.SecondaryBrush}"
                            BorderBrush="{StaticResource Border.DefaultBrush}" BorderThickness="1"
                            Padding="12,9" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MiniMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MiniMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource ThinScrollViewerStyle}">
                            <ctrl:MarkdownBlock Markdown="{Binding MiniMessage}"/>
                        </ScrollViewer>
                    </Border>

                    <!-- 头像 + 输入 + 发送 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="40" Height="40" Cursor="Hand"
                              Background="Transparent" ToolTip="{Binding ExpanderTipTxt}"
                              MouseLeftButtonDown="MiniAvatar_MouseDown">
                            <Border CornerRadius="9" Background="{StaticResource Brand.PrimaryBrush}"
                                    Visibility="{DynamicResource XiaoTongFallbackVisibility}">
                                <TextBlock Text="桐" Foreground="{StaticResource Text.OnPrimaryBrush}"
                                           FontSize="16" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="{DynamicResource XiaoTongAvatarBrush}"/>
                        </Grid>
                        <Border Grid.Column="1" CornerRadius="9" BorderBrush="{StaticResource Border.StrongBrush}"
                                BorderThickness="1" Background="{StaticResource Bg.PrimaryBrush}" Margin="10,0,0,0">
                            <TextBox x:Name="MiniInput" BorderThickness="0" Background="Transparent"
                                     FontSize="12.5" Padding="11,8" VerticalContentAlignment="Center"
                                     MinHeight="36" AcceptsReturn="False"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="InputBox_KeyDown"/>
                        </Border>
                        <Button Grid.Column="2" Content="{Binding SendTxt}" Command="{Binding SendCommand}"
                                Style="{StaticResource ChatPrimaryBtn}"
                                Padding="16,8" Margin="8,0,0,0" VerticalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
