<UserControl x:Class="MaxChemical.Shell.Views.MainTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:infrastructure="clr-namespace:MaxChemical.Infrastructure.Constants;assembly=MaxChemical.Infrastructure"
             xmlns:converters="clr-namespace:MaxChemical.Shell.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{StaticResource Bg.PrimaryBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:DebugBooleanToVisibilityConverter x:Key="DebugBoolToVisibilityConverter"/>

        <!-- 左侧标签按钮(左圆角)— 品牌深红边框 + 白底 -->
        <Style x:Key="LeftTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="183"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="{StaticResource Bg.PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Brand.PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brand.PrimaryBrush}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,0,0,4">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Content"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Brand.PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右侧标签按钮(右圆角)— 品牌深红边框 + 白底 -->
        <Style x:Key="RightTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="183"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="{StaticResource Bg.PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Brand.PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brand.PrimaryBrush}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,4,4,0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Content"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource Brand.PrimaryLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 动作按钮(目前未在用,但保留并改用品牌色) -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brand.PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource Text.OnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brand.PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brand.PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标签页头部 -->
        <Grid Grid.Row="0" Background="{StaticResource Bg.PrimaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧:标签页按钮 -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left">

                <Button Content="{Binding ProcessDesignerTabText}"
                        Command="{Binding SelectProcessDesignerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LeftTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProcessDesignerSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brand.PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text.OnPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Brand.PrimaryBrush}"/>
                                    <Setter Property="Panel.ZIndex" Value="100"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{Binding FlowDesignerTabText}"
                        Command="{Binding SelectFlowDesignerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RightTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFlowDesignerSelected}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brand.PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text.OnPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Brand.PrimaryBrush}"/>
                                    <Setter Property="Panel.ZIndex" Value="100"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>

            <!-- 中间:项目名称 + 上云按钮 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProjectName}"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Medium"
                           Foreground="{StaticResource Text.PrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="400"
                           ToolTip="{Binding ProjectName}"
                           Visibility="{Binding IsProjectNameVisible,
                                        Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- 上云:导出当前组态并同步到云端 -->
                <Button Command="{Binding CloudUploadCommand}"
                        Margin="12,0,0,0" Cursor="Hand" Padding="0"
                        BorderThickness="0" Background="Transparent"
                        VerticalAlignment="Center"
                        ToolTip="导出当前组态并同步到云端(Ctrl+U)"
                        Visibility="{Binding IsProjectNameVisible,
                                     Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="7"
                                    Background="{StaticResource Brand.PrimaryBrush}" Padding="11,5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="17" Height="14" Stretch="Uniform"
                                          Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M6 16 A4 4 0 0 1 5.5 8.03 A5.5 5.5 0 0 1 16 6.5 A4.5 4.5 0 0 1 18.5 15.5 M12 8 L12 14 M9.5 10.5 L12 8 L14.5 10.5"/>
                                    <TextBlock Text="上云" Foreground="White" FontSize="12.5"
                                               FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brand.PrimaryHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- 右侧:查看变量管理 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal" 
                        Margin="0,0,25,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsVariableManagementVisible, 
                                     Converter={StaticResource BoolToVisibilityConverter}}">

                <Button Content="{Binding VariableManagementTabText}"
                        Command="{Binding ViewVariableManagementCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource Brand.PrimaryBrush}"
                        FontSize="16"
                        Padding="0"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brand.PrimaryHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 展开折叠箭头 -->
                <Path Data="M0,0 L5.38,4.46 L0,8.92"
                      Stroke="{StaticResource Brand.PrimaryBrush}"
                      StrokeThickness="1"
                      Fill="Transparent"
                      Width="5.38"
                      Height="8.92"
                      VerticalAlignment="Center"
                      Margin="10,0,0,0">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" CenterX="2.69" CenterY="4.46"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVariableManagementExpanded}" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90" CenterX="2.69" CenterY="4.46"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

            </StackPanel>

        </Grid>

        <!-- 标签页内容区域 -->
        <Border Grid.Row="1" 
                Background="{StaticResource Bg.PrimaryBrush}"
                BorderBrush="{StaticResource Border.DefaultBrush}">

            <Grid Margin="-2 6 14 16">
                <!-- 工艺设计器内容 -->
                <Border x:Name="ProcessDesignerBorder" 
                        Background="{StaticResource Bg.PrimaryBrush}">
                    <ContentControl prism:RegionManager.RegionName="{x:Static infrastructure:RegionNames.ProcessDesignerRegion}"/>
                    <Border.Visibility>
                        <Binding Path="IsProcessDesignerSelected" 
                                 Converter="{StaticResource DebugBoolToVisibilityConverter}"
                                 ConverterParameter="ProcessDesigner"/>
                    </Border.Visibility>
                </Border>

                <!-- 流程设计器内容 -->
                <Border x:Name="FlowDesignerBorder" 
                        Background="{StaticResource Bg.PrimaryBrush}">
                    <ContentControl prism:RegionManager.RegionName="{x:Static infrastructure:RegionNames.FlowDesignerRegion}"/>
                    <Border.Visibility>
                        <Binding Path="IsFlowDesignerSelected" 
                                 Converter="{StaticResource DebugBoolToVisibilityConverter}"
                                 ConverterParameter="FlowDesigner"/>
                    </Border.Visibility>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>