<UserControl x:Class="MaxChemical.Shell.Views.MainTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:infrastructure="clr-namespace:MaxChemical.Infrastructure.Constants;assembly=MaxChemical.Infrastructure"
             xmlns:converters="clr-namespace:MaxChemical.Shell.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:DebugBooleanToVisibilityConverter x:Key="DebugBoolToVisibilityConverter"/>

        <!-- 左侧按钮样式 (左圆角) -->
        <Style x:Key="LeftTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="183"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#186DF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#186DF5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,0,0,4">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Content"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5F3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 右侧按钮样式 (右圆角) -->
        <Style x:Key="RightTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="183"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#186DF5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#186DF5"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,4,4,0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Content"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#E5F3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标签页头部 -->
        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：标签页按钮 -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left">

                <Button Content="{Binding ProcessDesignerTabText}"
                        Command="{Binding SelectProcessDesignerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LeftTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProcessDesignerSelected}" Value="True">
                                    <Setter Property="Background" Value="#186DF5"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#186DF5"/>
                                    <Setter Property="Panel.ZIndex" Value="100"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Content="{Binding FlowDesignerTabText}"
                        Command="{Binding SelectFlowDesignerCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RightTabButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFlowDesignerSelected}" Value="True">
                                    <Setter Property="Background" Value="#186DF5"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#186DF5"/>
                                    <Setter Property="Panel.ZIndex" Value="100"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>

            <!-- 右侧：查看变量管理 -->
            <StackPanel Grid.Column="1"
            Orientation="Horizontal" 
            Margin="0,0,25,0"
            VerticalAlignment="Center"
            Visibility="{Binding IsVariableManagementVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                <Button Content="查看变量管理"
            Command="{Binding ViewVariableManagementCommand}"
            Background="Transparent"
            BorderThickness="0"
            Foreground="#488EFF"
            FontSize="16"
            Padding="0"
            Cursor="Hand"
            VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"
                                  Content="{TemplateBinding Content}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 展开折叠箭头 -->
                <Path Data="M0,0 L5.38,4.46 L0,8.92"
          Stroke="#488EFF"
          StrokeThickness="1"
          Fill="Transparent"
          Width="5.38"
          Height="8.92"
          VerticalAlignment="Center"
          Margin="10,0,0,0">
                    <Path.RenderTransform>
                        <RotateTransform Angle="0"
                             CenterX="2.69" 
                             CenterY="4.46"/>
                    </Path.RenderTransform>
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0"
                                         CenterX="2.69" 
                                         CenterY="4.46"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVariableManagementExpanded}" Value="True">
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90"
                                                 CenterX="2.69" 
                                                 CenterY="4.46"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>

            </StackPanel>

        </Grid>

        <!-- 标签页内容区域 -->
        <Border Grid.Row="1" 
                Background="White"
                BorderBrush="#CCCCCC" 
                >

            <Grid Margin="-2 6 14 16">
                <!-- 工艺设计器内容 -->
                <Border x:Name="ProcessDesignerBorder" 
                        Background="White">
                    <ContentControl prism:RegionManager.RegionName="{x:Static infrastructure:RegionNames.ProcessDesignerRegion}"/>
                    <Border.Visibility>
                        <Binding Path="IsProcessDesignerSelected" 
                                 Converter="{StaticResource DebugBoolToVisibilityConverter}"
                                 ConverterParameter="ProcessDesigner"/>
                    </Border.Visibility>
                </Border>

                <!-- 流程设计器内容 -->
                <Border x:Name="FlowDesignerBorder" 
                        Background="White">
                    <ContentControl prism:RegionManager.RegionName="{x:Static infrastructure:RegionNames.FlowDesignerRegion}"/>
                    <Border.Visibility>
                        <Binding Path="IsFlowDesignerSelected" 
                                 Converter="{StaticResource DebugBoolToVisibilityConverter}"
                                 ConverterParameter="FlowDesigner"/>
                    </Border.Visibility>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>