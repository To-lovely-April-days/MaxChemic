<UserControl x:Class="MaxChemical.Shell.Views.LogViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaxChemical.Shell.Views"
             mc:Ignorable="d" 
             >
    <UserControl.Resources>
        <!-- 简洁按钮 -->
        <Style x:Key="SimpleButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8F8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" 
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="系统日志" FontSize="14" 
                          FontWeight="Medium" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox Width="200" Height="28" Padding="8,4" 
                            BorderBrush="#E0E0E0" BorderThickness="1"
                            Background="White" FontSize="12"
                            Text="搜索..." Foreground="#999999" 
                            Margin="0,0,8,0"/>
                    <Button Content="清空" Style="{StaticResource SimpleButton}" 
                           Height="28" Margin="0,0,4,0"/>
                    <Button Content="导出" Style="{StaticResource SimpleButton}" 
                           Height="28"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Border Grid.Row="1" Background="White" Margin="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Grid Grid.Row="0" Background="#F8F8F8" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="时间" FontSize="12" 
                              Foreground="#666666" VerticalAlignment="Center" 
                              Margin="16,0,0,0"/>
                    <TextBlock Grid.Column="1" Text="级别" FontSize="12" 
                              Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="来源" FontSize="12" 
                              Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="消息" FontSize="12" 
                              Foreground="#666666" VerticalAlignment="Center"/>
                </Grid>

                <!-- 日志列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 日志项模板 -->
                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="36">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="14:32:15" FontSize="12" 
                                          Foreground="#666666" VerticalAlignment="Center" 
                                          Margin="16,0,0,0"/>
                                <Ellipse Grid.Column="1" Width="6" Height="6" 
                                        Fill="#00C853" HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="信息" FontSize="12" 
                                          Foreground="#666666" VerticalAlignment="Center" 
                                          Margin="20,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="系统" FontSize="12" 
                                          Foreground="#666666" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="用户登录成功" FontSize="12" 
                                          Foreground="#333333" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="36">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="14:28:42" FontSize="12" 
                                          Foreground="#666666" VerticalAlignment="Center" 
                                          Margin="16,0,0,0"/>
                                <Ellipse Grid.Column="1" Width="6" Height="6" 
                                        Fill="#FF9800" HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="警告" FontSize="12" 
                                          Foreground="#666666" VerticalAlignment="Center" 
                                          Margin="20,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="设备" FontSize="12" 
                                          Foreground="#666666" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="设备连接超时" FontSize="12" 
                                          Foreground="#333333" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Height="36">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="14:25:18" FontSize="12" 
                                          Foreground="#666666" VerticalAlignment="Center" 
                                          Margin="16,0,0,0"/>
                                <Ellipse Grid.Column="1" Width="6" Height="6" 
                                        Fill="#F44336" HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="错误" FontSize="12" 
                                          Foreground="#666666" VerticalAlignment="Center" 
                                          Margin="20,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="数据库" FontSize="12" 
                                          Foreground="#666666" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="连接失败" FontSize="12" 
                                          Foreground="#333333" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
