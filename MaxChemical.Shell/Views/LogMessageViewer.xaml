<Window x:Class="MaxChemical.Shell.Views.LogMessageViewer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:MaxChemical.Shell.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="LogMessageViewer" Height="450" Width="800"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="CloseButtonStytle" TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Path Data="M 1,1 L 15,15 M 1,15 L 15,1"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6B0E1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <!--<Setter Property="OverridesDefaultStyle" Value="True"/>-->
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                            <Border Padding="{TemplateBinding Padding}">
                                <StackPanel IsItemsHost="True"/>
                            </Border>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border CornerRadius="2" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LogMessageTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Margin="4,0" Text="{Binding Timestamp}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Margin="4,0" Grid.Column="1" Text="{Binding Level}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Margin="4,0" Grid.Column="2" Text="{Binding Source}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Margin="4,0" Grid.Column="3" Text="{Binding Content}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        
    </Window.Resources>
    <Border CornerRadius="8" Background="LightGray" BorderBrush="Gray" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <!--标题区域-->
            <Grid>
                <!--窗体拖动-->
                <Border Name="DragMoveBorder" CornerRadius="8,8,0,0" Background="#A41626" MouseDown="DragMoveBorder_MouseDown"/>
                <!--标题-->
                <TextBlock Margin="16,0" Text="系统日志" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                <!--关闭按钮-->
                <Button Width="24" Height="24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CloseButtonStytle}"
                        Click="CloseButton_Click"/>
            </Grid>
            
            <!--内容区域-->
            <Border Grid.Row="1" Margin="6" CornerRadius="4" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ItemsSource="{Binding LogMessages}"
                             ItemTemplate="{StaticResource LogMessageTemplate}"/>
                    
                    <Rectangle Grid.Row="1" Margin="2,0" VerticalAlignment="Top" Fill="LightGray" Height="1"/>
                    <!--操作区域-->
                    <StackPanel Grid.Row="1" Margin="4" Orientation="Horizontal">
                        <TextBlock Text="显示条数：" VerticalAlignment="Center"/>
                        <ComboBox Width="80" Height="28" Style="{StaticResource FieldComboStyle}" SelectedValue="{Binding MaxCount}">
                            <sys:Int32>100</sys:Int32>
                            <sys:Int32>200</sys:Int32>
                            <sys:Int32>500</sys:Int32>
                            <sys:Int32>1000</sys:Int32>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
