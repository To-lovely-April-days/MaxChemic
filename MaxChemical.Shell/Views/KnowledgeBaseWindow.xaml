<Window x:Class="MaxChemical.Shell.Views.KnowledgeBaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="知识库管理"
        Width="720" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg.PrimaryBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <!-- 删除按钮:默认灰,悬停转危险色 -->
        <Style x:Key="DocDeleteBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text.TertiaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="ToolTip" Value="删除此文档"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Status.DangerLightBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource Status.DangerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文档行 -->
        <DataTemplate x:Key="DocRowTemplate">
            <Border CornerRadius="8" Padding="12,9" Margin="2,2"
                    Background="{StaticResource Bg.PrimaryBrush}"
                    BorderBrush="{StaticResource Border.DefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium"
                                   Foreground="{StaticResource Text.PrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding MetaText}" FontSize="10.5"
                                   Foreground="{StaticResource Text.TertiaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="99" Padding="8,2" Margin="10,0,12,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource Brand.PrimaryLightBrush}">
                        <TextBlock Text="{Binding VectorText}" FontSize="10"
                                   Foreground="{StaticResource Brand.PrimaryBrush}"/>
                    </Border>
                    <Button Grid.Column="2" Style="{StaticResource DocDeleteBtn}"
                            VerticalAlignment="Center"
                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Padding="20,14" BorderBrush="{StaticResource Border.DefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="知识库" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Text.PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="导入设备手册、操作规程等文档后,小桐可基于资料作答并标注出处"
                               FontSize="11" Foreground="{StaticResource Text.TertiaryBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新" Command="{Binding RefreshCommand}"
                            Style="{StaticResource DialogSecondaryButtonStyle}" Margin="0,0,10,0"/>
                    <Button Content="导入文档" Command="{Binding ImportCommand}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 文档列表 -->
        <Grid Grid.Row="1" Margin="16,12">
            <ListBox ItemsSource="{Binding Documents}"
                     ItemTemplate="{StaticResource DocRowTemplate}"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBarStyle}"/>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter HorizontalAlignment="Stretch"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 空状态引导 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Documents.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="知识库还是空的" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource Text.SecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="点右上角「导入文档」添加 txt / pdf / docx 资料" FontSize="11.5"
                           Foreground="{StaticResource Text.TertiaryBrush}" HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource Bg.SecondaryBrush}" Padding="20,9"
                BorderBrush="{StaticResource Border.DefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="11"
                       Foreground="{StaticResource Text.SecondaryBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
