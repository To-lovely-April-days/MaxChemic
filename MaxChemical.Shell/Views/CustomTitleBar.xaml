                                          FillRule="NonZero"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- 标题栏按钮样式(深红底,白色图标) -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text.OnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Marlett"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" x:Name="ButtonBorder">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brand.PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brand.PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮样式(更亮红 hover,区分品牌红) -->
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1F1F"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brand.PrimaryDarkBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 登录按钮样式 -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text.OnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0,15,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                x:Name="ButtonBorder" 
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Image Width="16" Height="16" 
                                       Source="pack://siteoforigin:,,,/Resources/Icon/user.png"
                                       Margin="0,0,10,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brand.PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brand.PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 语音助手按钮样式 -->
        <Style x:Key="VoiceAssistantButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                x:Name="ButtonBorder" 
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brand.PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brand.PrimaryDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ★ 根 Border:深红主题色 -->
    <Border Background="{StaticResource Brand.PrimaryBrush}" 
            BorderBrush="{StaticResource Brand.PrimaryDarkBrush}" 
            BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：应用程序图标和标题 -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center" 
                        Margin="8,0">
                <Border Width="32" Height="16" Margin="12,0,4,0">
                    <Image Source="pack://siteoforigin:,,,/Resources/Icon/logo.png"/>
                </Border>
                <TextBlock Text="{Binding ApplicationTitle}"
                           Foreground="{StaticResource Text.OnPrimaryBrush}" 
                           FontSize="14" 
                           VerticalAlignment="Center"
                           Margin="0,6,0,6"/>
            </StackPanel>

            <!-- 中间：可拖拽区域 -->
            <Grid Grid.Column="1" 
                  Background="Transparent"
                  x:Name="DragArea">
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DragMoveCommand}"/>
                </Grid.InputBindings>
            </Grid>

            <!-- 右侧：语音助手、登录信息和控制按钮 -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- 语音助手状态和控制 -->
                <StackPanel Orientation="Horizontal">
                    <!-- 语音助手开关按钮 -->
                    <Button x:Name="VoiceAssistantButton"
                            Command="{Binding ToggleVoiceAssistantCommand}"
                            Style="{StaticResource VoiceAssistantButtonStyle}"
                            ToolTip="点击切换语音助手开关（说'你好小桐'唤醒）">
                        <StackPanel Orientation="Horizontal">
                            <!-- 麦克风图标 (SVG) -->
                            <Image Width="16" Height="16" 
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Source" Value="{StaticResource MicrophoneIcon}"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVoiceAssistantActive}" Value="True">
                                                <Setter Property="Opacity" Value="1.0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- 状态指示点（呼吸灯效果） -->
                            <Ellipse Width="8" Height="8" 
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FFFFFF"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVoiceAssistantActive}" Value="True">
                                                <Setter Property="Fill" Value="#FFFFFF"/>
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="1.0" To="0.3" Duration="0:0:1"
                                                                             AutoReverse="True"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             To="0.5" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- 状态文字 -->
                            <TextBlock Text="{Binding VoiceAssistantStatus}" 
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="{StaticResource Text.OnPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- 语音助手交互 Popup -->
                    <Popup x:Name="VoiceAssistantPopup"
                           PlacementTarget="{Binding ElementName=VoiceAssistantButton}"
                           Placement="Bottom"
                           HorizontalOffset="-100"
                           VerticalOffset="8"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           IsOpen="{Binding IsVoiceInteractionVisible, Mode=TwoWay}">
                        <Border Background="White"
                                BorderBrush="{StaticResource Border.DefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Width="350"
                                Effect="{DynamicResource PopupShadow}">
                            <Border.Resources>
                                <DropShadowEffect x:Key="PopupShadow" 
                                                  Color="#000000" 
                                                  Opacity="0.15" 
                                                  BlurRadius="20" 
                                                  ShadowDepth="2"/>
                            </Border.Resources>

                            <StackPanel>
                                <!-- 标题栏 -->
                                <Grid Margin="0,0,0,15">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Width="20" Height="20" 
                                               Source="{StaticResource MicrophoneIcon}"
                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="语音助手" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Text.PrimaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="✕" 
                                            HorizontalAlignment="Right"
                                            Command="{Binding CloseVoiceInteractionCommand}"
                                            Width="24" Height="24"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource Text.TertiaryBrush}"
                                            FontSize="14"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" 
                                                                    x:Name="CloseBorder"
                                                                    CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CloseBorder" Property="Background" Value="{StaticResource Bg.HoverBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- 语音状态指示 -->
                                <Border Background="{StaticResource Bg.SecondaryBrush}"
                                        BorderBrush="{StaticResource Border.DefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="15"
                                        Margin="0,0,0,15">
                                    <StackPanel>
                                        <!-- 状态图标和文字 -->
                                        <StackPanel Orientation="Horizontal" 
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,10">
                                            <Ellipse Width="12" Height="12"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{StaticResource Status.SuccessBrush}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="1.0" To="0.2" 
                                                                                             Duration="0:0:0.8"
                                                                                             AutoReverse="True"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding ListeningStatus}" 
                                                       FontSize="13"
                                                       Foreground="{StaticResource Status.SuccessBrush}"
                                                       FontWeight="Medium"/>
                                        </StackPanel>

                                        <!-- 识别的文字 -->
                                        <TextBlock Text="{Binding RecognizedText}" 
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="{StaticResource Text.PrimaryBrush}"
                                                   MinHeight="40"
                                                   TextAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RecognizedText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 助手回复(改成深红主题色) -->
                                <Border Background="{StaticResource Brand.PrimaryBrush}"
                                        CornerRadius="6"
                                        Padding="15"
                                        Margin="0,0,0,15">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AssistantReply}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding AssistantReply}" 
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{StaticResource Text.OnPrimaryBrush}"
                                               LineHeight="20"/>
                                </Border>

                                <!-- 提示信息 -->
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource Text.TertiaryBrush}"
                                           TextAlignment="Center"
                                           Margin="0,5,0,0">
                                    <Run Text="说 "/>
                                    <Run Text="'你好小桐'" FontWeight="SemiBold" Foreground="{StaticResource Brand.PrimaryBrush}"/>
                                    <Run Text=" 即可唤醒语音助手"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 静音/取消静音按钮 -->
                    <Button Command="{Binding ToggleMuteCommand}"
                            Width="32" Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,4,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    x:Name="MuteBorder"
                                                    CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MuteBorder" Property="Background" Value="{StaticResource Brand.PrimaryHoverBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Button.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="点击静音"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Text" Value="点击取消静音"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.ToolTip>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE767;"/>
                                    <Setter Property="Foreground" Value="{StaticResource Text.OnPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                            <Setter Property="Text" Value="&#xE74F;"/>
                                            <Setter Property="Foreground" Value="#FFAA80"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>

                <!-- 分隔线(深红底上用半透明白) -->
                <Border Width="1" Height="18" 
                        Background="{StaticResource Text.OnPrimaryBrush}" 
                        Opacity="0.3"
                        Margin="4,0,8,0"/>

                <!-- 登录按钮 -->
                <Button Content="{Binding LoginText}" 
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource LoginButtonStyle}"/>

                <!-- ═══════════════════════════════════════════════
                     窗口控制按钮 — 用 XAML Path 替代 PNG (白色)
                     ═══════════════════════════════════════════════ -->

                <!-- 最小化:一条横线 -->
                <Button Command="{Binding MinimizeCommand}" 
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="{Binding MinimizeTooltip}">
                    <Path Data="M0,5 L10,5" 
                          Stroke="{StaticResource Text.OnPrimaryBrush}" 
                          StrokeThickness="1.2"
                          Width="10" Height="10"/>
                </Button>

                <!-- 最大化:空心方框 -->
                <Button Command="{Binding MaximizeCommand}" 
                        Style="{StaticResource TitleBarButtonStyle}"
                        ToolTip="{Binding MaximizeTooltip}">
                    <Path Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" 
                          Stroke="{StaticResource Text.OnPrimaryBrush}" 
                          StrokeThickness="1.2"
                          Fill="Transparent"
                          Width="10" Height="10"/>
                </Button>

                <!-- 关闭:叉号 -->
                <Button Command="{Binding CloseCommand}" 
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="{Binding CloseTooltip}">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" 
                          Stroke="{StaticResource Text.OnPrimaryBrush}" 
                          StrokeThickness="1.2"
                          Width="10" Height="10"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>