<Window x:Class="MaxChemical.Modules.Designer.Views.CommandBindingAndParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="ToolWindow"
        Title="绑定命令与参数">
    <Border CornerRadius="8" BorderBrush="#DDDDDD" BorderThickness="1" Padding="14" Background="#FAFAFA">
        <StackPanel MinWidth="420">
            <TextBlock x:Name="TitleText" Text="绑定设备与参数" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <!-- 设备选择 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="设备：" Width="60" VerticalAlignment="Center"/>
                <ComboBox x:Name="DeviceCombo"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Id"
                          MinWidth="300"/>
            </StackPanel>

            <!-- 参数编辑列表（无节点或无参数时会隐藏） -->
            <StackPanel x:Name="ParamsPanel">
                <TextBlock Text="输入参数：" Margin="0,6,0,6" FontWeight="Bold"/>
                <ItemsControl x:Name="ParamsItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         MinWidth="200"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="取消" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="保存" Width="100" Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>