<UserControl x:Class="MaxChemical.Modules.Designer.Views.LoopCommandPropertiesView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:model="clr-namespace:MaxChemical.Modules.Designer.Models"
             mc:Ignorable="d">
    <!-- DataContext = CommandNode -->

    <UserControl.Resources>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style x:Key="GroupCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#FFF9F9F9"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="循环设置"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#333"/>

            <!-- 循环类型 -->
            <TextBlock Text="循环类型" Margin="0,12,0,4" Foreground="#666"/>
            <ComboBox x:Name="LoopTypeCombo"
                      MinWidth="260"
                      SelectedValuePath="Tag"
                      SelectedValue="{Binding ElementName=Root, Path=LoopTypeNormalized, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ComboBoxItem Content="固定次数" Tag="{x:Static model:LoopType.FixedCount}"/>
                <ComboBoxItem Content="条件循环" Tag="{x:Static model:LoopType.Conditional}"/>
                <ComboBoxItem Content="无限循环" Tag="{x:Static model:LoopType.Infinite}"/>
            </ComboBox>

            <!-- 固定次数：LoopCount -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GroupCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=LoopTypeNormalized}"
                                         Value="{x:Static model:LoopType.FixedCount}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="循环次数" Style="{StaticResource FormLabelStyle}"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="LoopCountBox"
                                 Grid.Column="0"
                                 MinWidth="220"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding ElementName=Root, Path=LoopCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="LoopCountBox_PreviewTextInput"
                                 DataObject.Pasting="LoopCountBox_Pasting"/>
                        <TextBlock Grid.Column="1" Text="次" VerticalAlignment="Center" Foreground="#666" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 条件循环：LeftOperand / Operator / RightOperand -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GroupCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=LoopTypeNormalized}"
                             Value="{x:Static model:LoopType.Conditional}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Do-While 开关 - 新增 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="循环模式" Style="{StaticResource FormLabelStyle}"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <CheckBox x:Name="IsDoWhileCheckBox"
                      IsChecked="{Binding ElementName=Root, Path=IsDoWhile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center"/>
                        <TextBlock Text="Do-While (先执行后判断)" 
                       VerticalAlignment="Center" 
                       Margin="8,0,0,0"
                       Foreground="#666"/>
                        <TextBlock Text="；取消勾选为 While (先判断后执行)" 
                       VerticalAlignment="Center" 
                       Margin="8,0,0,0"
                       FontSize="11"
                       Foreground="#999"/>
                    </StackPanel>

                    <!-- 左操作数 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="左操作数" Style="{StaticResource FormLabelStyle}"/>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                     x:Name="LeftOperandBox"
                     MinWidth="220"
                     Style="{StaticResource FormTextBoxStyle}"
                     Text="{Binding ElementName=Root, Path=LeftOperand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="输入变量名或常量值"/>
                        <Button Grid.Column="1"
                    Content="..."
                    Width="30"
                    Margin="4,0,0,0"
                    ToolTip="选择变量"
                    Click="SelectLeftVariable_Click"/>
                    </Grid>

                    <!-- 操作符 -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="比较操作符" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox Grid.Row="4" Grid.Column="1"
                  x:Name="OperatorCombo"
                  MinWidth="260"
                  SelectedValuePath="Tag"
                  SelectedValue="{Binding ElementName=Root, Path=OperatorNormalized, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="等于 (==)" Tag="{x:Static model:ComparisonOperator.Equal}"/>
                        <ComboBoxItem Content="不等于 (!=)" Tag="{x:Static model:ComparisonOperator.NotEqual}"/>
                        <ComboBoxItem Content="大于 (>)" Tag="{x:Static model:ComparisonOperator.GreaterThan}"/>
                        <ComboBoxItem Content="大于等于 (>=)" Tag="{x:Static model:ComparisonOperator.GreaterThanOrEqual}"/>
                        <ComboBoxItem Content="小于 (&lt;)" Tag="{x:Static model:ComparisonOperator.LessThan}"/>
                        <ComboBoxItem Content="小于等于 (&lt;=)" Tag="{x:Static model:ComparisonOperator.LessThanOrEqual}"/>
                        <ComboBoxItem Content="包含" Tag="{x:Static model:ComparisonOperator.Contains}"/>
                        <ComboBoxItem Content="不包含" Tag="{x:Static model:ComparisonOperator.NotContains}"/>
                    </ComboBox>

                    <!-- 右操作数 -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="右操作数" Style="{StaticResource FormLabelStyle}"/>
                    <Grid Grid.Row="6" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                     x:Name="RightOperandBox"
                     MinWidth="220"
                     Style="{StaticResource FormTextBoxStyle}"
                     Text="{Binding ElementName=Root, Path=RightOperand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="输入比较值、常量或变量名"/>
                        <Button Grid.Column="1"
                    Content="..."
                    Width="30"
                    Margin="4,0,0,0"
                    ToolTip="选择变量"
                    Click="SelectRightVariable_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 无限循环：提示 -->
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GroupCardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=LoopTypeNormalized}"
                                         Value="{x:Static model:LoopType.Infinite}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="该循环将持续执行，直到外部逻辑中断。"
                           Foreground="#666" FontSize="12"/>
            </Border>

            <!-- 循环间隔时间 -->
            <Border Style="{StaticResource GroupCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="循环间隔" Style="{StaticResource FormLabelStyle}"/>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="WaitTimeBox"
                                 Grid.Column="0"
                                 MinWidth="220"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 Text="{Binding ElementName=Root, Path=WaitTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="WaitTimeBox_PreviewTextInput"
                                 DataObject.Pasting="WaitTimeBox_Pasting"
                                 ToolTip="每次循环后的等待时间"/>
                        <TextBlock Grid.Column="1" Text="毫秒" VerticalAlignment="Center" Foreground="#666" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 描述 -->
            <TextBlock Text="描述" Margin="0,12,0,4" Foreground="#666"/>
            <TextBox x:Name="DescriptionBox"
                     MinWidth="260"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="60"
                     Text="{Binding ElementName=Root, Path=Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <Separator Margin="0,16,0,16"/>

            <!-- 条件预览（仅在条件循环时显示） -->
            <TextBlock Text="条件预览" 
                       Margin="0,0,0,4" 
                       FontWeight="Medium"
                       Foreground="#666">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=LoopTypeNormalized}"
                                         Value="{x:Static model:LoopType.Conditional}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Background="#F8F8F8" 
                    BorderBrush="#E0E0E0" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Padding="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=Root, Path=LoopTypeNormalized}"
                                         Value="{x:Static model:LoopType.Conditional}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock x:Name="ConditionPreview"
                           Text="{Binding ElementName=Root, Path=ConditionPreviewText}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="12"
                           Foreground="#333"/>
            </Border>

            <!-- 循环摘要信息 -->
            <Border Background="#F0F8FF" 
                    BorderBrush="#B0D4F1" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Padding="8"
                    Margin="0,8,0,0">
                <TextBlock x:Name="LoopSummary"
                           Text="{Binding ElementName=Root, Path=LoopSummaryText}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#2C5AA0"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>