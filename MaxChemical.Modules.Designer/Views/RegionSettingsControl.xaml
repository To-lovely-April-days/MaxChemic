<UserControl x:Class="MaxChemical.Modules.Designer.Views.RegionSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views"
             xmlns:vm="clr-namespace:MaxChemical.Modules.Designer.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="652" d:DesignWidth="1140"
             Background="Transparent">

    <UserControl.Resources>
     
        <!-- 输入框样式 -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Width" Value="223"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- 生成布局按钮样式 -->
        <Style x:Key="GenerateButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#3F75CB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="21,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5588BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部按钮样式 - 确定 -->
        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3F75CB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="93"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#365A96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部按钮样式 - 取消 -->
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#C2C2C2"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="93"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#BBBBBB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 网格单元格样式 -->
        <Style x:Key="GridCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D4D4D4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4472C4"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- 关闭按钮样式 -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="Margin" Value="0,0,13,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <Image Source="pack://siteoforigin:,,,/Resources/Icon/closeWhite.png" 
                      Width="15" Height="15" 
                      Stretch="Uniform"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC0000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 上下文菜单项目样式 -->
        <Style x:Key="ContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Header}"/>
            <Setter Property="Command" Value="{Binding Command}"/>
            <Setter Property="CommandParameter" Value="{Binding RegionTypeValue}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Separator Style="{DynamicResource {x:Static MenuItem.SeparatorStyleKey}}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSeparator}" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border Background="{TemplateBinding Background}" 
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 颜色指示器 -->
                                        <Border Grid.Column="0" 
                                           Width="16" Height="16" 
                                           Background="{Binding ColorBrush}"
                                           BorderBrush="#CCCCCC" 
                                           BorderThickness="1"
                                           CornerRadius="2"
                                           Margin="4,0"/>
                                        <!-- 文本 -->
                                        <ContentPresenter Grid.Column="1" 
                                                    ContentSource="Header"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0,0,0"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter Property="Background" Value="#E8F4FD"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="#AAAAAA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 右键菜单样式 -->
        <Style x:Key="ContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HasDropShadow" Value="True"/>
          
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" 
                                   KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#D4D4D4" 
            BorderThickness="1" 
            CornerRadius="8" 
            Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#60000000" 
                                 Direction="310" 
                                 ShadowDepth="3" 
                                 BlurRadius="8" 
                                 Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Style="{StaticResource TitleBarStyle}" x:Name="DragArea" >
                <Grid>
                    <TextBlock Text="{Binding RegionSettingTitle}" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left"
                               Margin="28,0,0,0"
                               Foreground="White" 
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- 控制面板 -->
            <Grid Grid.Row="1" Margin="15,32,15,10">
                <StackPanel Orientation="Horizontal" 
                VerticalAlignment="Center"
                HorizontalAlignment="Left">
                    <TextBlock Text="{Binding RowLabel,StringFormat='{}{0}：'}" 
                   VerticalAlignment="Center" 
                   FontSize="14" 
                   Margin="35,0,5,0"/>
                    <TextBox Text="{Binding Rows, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource InputTextBoxStyle}"/>

                    <TextBlock Text="{Binding ColLabel,StringFormat='{}{0}：'}" 
                   VerticalAlignment="Center" 
                   FontSize="14" 
                   Margin="20,0,5,0"/>
                    <TextBox Text="{Binding Cols, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource InputTextBoxStyle}"/>

                    <Button Content="{Binding GenerateLayout}" 
                Command="{Binding GenerateGridCommand}"
                Style="{StaticResource GenerateButtonStyle}"/>
                </StackPanel>

                <!-- 提示信息在最右侧 -->
                <StackPanel Orientation="Horizontal" 
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Margin="0,0,20,0">
                    <Image Source="pack://siteoforigin:,,,/Resources/Icon/info.png" 
           Width="20" Height="20" 
           VerticalAlignment="Center"
           Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TipMessage}" 
               VerticalAlignment="Center" 
               FontSize="12" 
               Foreground="#757575"/>
                </StackPanel>
            </Grid>

            <!-- 网格区域 -->
            <Border Grid.Row="2" 
        
        BorderThickness="0" 
        CornerRadius="5"
        Margin="50,20,50,15">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                  VerticalScrollBarVisibility="Auto"
                  Background="White">
                    <ItemsControl ItemsSource="{Binding GridCells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding Rows}" Columns="{Binding Cols}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Background}"
                            Style="{StaticResource GridCellStyle}"
                            MinHeight="120"
                            MinWidth="150">

                                    <!-- 右键菜单 - 通过数据绑定 -->
                                    <Border.ContextMenu>
                                        <ContextMenu Style="{StaticResource ContextMenuStyle}"
                                       ItemsSource="{Binding ContextMenuItems}"
                                       ItemContainerStyle="{StaticResource ContextMenuItemStyle}"/>
                                    </Border.ContextMenu>

                                    <!-- 显示区域类型文本 -->
                                    <TextBlock Text="{Binding DisplayName}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontSize="16"
                                 FontWeight="Normal"
                                 Foreground="#333333"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        Margin="879,0,15,21">
                <Button Content="{Binding OkLabel}" 
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource ConfirmButtonStyle}"/>
                <Button Content="{Binding CancelLabel}" 
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource CancelButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>