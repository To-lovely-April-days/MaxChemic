<!-- IfNodeControlView.xaml - Industrial Panel 统一样式 -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.IfNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
        <converters:StatusToIconBackgroundConverter x:Key="StatusToIconBgConverter"/>
        <converters:StatusToIconForegroundConverter x:Key="StatusToIconFgConverter"/>
        <converters:StatusToCardBackgroundConverter x:Key="StatusToCardBgConverter"/>
        <converters:StatusToCardBorderConverter x:Key="StatusToCardBorderConverter"/>
        <converters:StatusToTitleForegroundConverter x:Key="StatusToTitleFgConverter"/>
        <converters:StatusToBadgeBackgroundConverter x:Key="StatusToBadgeBgConverter"/>
        <converters:StatusToBadgeForegroundConverter x:Key="StatusToBadgeFgConverter"/>
        <converters:StatusToBadgeTextConverter x:Key="StatusToBadgeTextConverter"/>
        <converters:StatusToProgressVisibilityConverter x:Key="StatusToProgressVisConverter"/>
        <converters:StatusToDurationForegroundConverter x:Key="StatusToDurFgConverter"/>
    </UserControl.Resources>

    <Canvas x:Name="RootCanvas">

        <Border x:Name="MainStepCard"
                Canvas.Left="0"
                Width="231" Height="66"
                CornerRadius="10"
                Background="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBgConverter}}"
                BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                BorderThickness="1"
                Cursor="Hand"
                PreviewMouseLeftButtonDown="Node_Click"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="#42A5F5"/>
                            <Setter Property="BorderThickness" Value="1.5"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#2196F3" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Border Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            CornerRadius="0,0,10,10"
                            Visibility="{Binding ExecutionStatus, Converter={StaticResource StatusToProgressVisConverter}}">
                    <Border.Background>
                        <SolidColorBrush Color="#1976D2" Opacity="0.5"/>
                    </Border.Background>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="231"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                    <Setter Property="Width" Value="150"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Margin="12,0,10,0" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                    Background="{Binding ExecutionStatus, Converter={StaticResource StatusToIconBgConverter}}"
                                    BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                                    BorderThickness="1">
                            <Image Source="{Binding LogicCommand.Properties[Bezel_lessIconPath]}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="{Binding DisplayName, FallbackValue='条件判断'}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToTitleFgConverter}}"
                                           TextTrimming="CharacterEllipsis"/>
                            <Grid>
                                <TextBlock x:Name="ConditionSummaryText"
                                   FontSize="11" Foreground="#9E9E9E"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1} {2}">
                                            <Binding Path="LogicCommand.Properties[LeftOperand]" FallbackValue="变量"/>
                                            <Binding Path="LogicCommand.Properties[Operator]" FallbackValue="=="/>
                                            <Binding Path="LogicCommand.Properties[RightOperand]" FallbackValue="值"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                    <Setter Property="Foreground" Value="#1976D2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                    <Setter Property="Foreground" Value="#43A047"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="{Binding ExecutionErrorMessage, FallbackValue='执行失败'}"/>
                                                    <Setter Property="Foreground" Value="#E53935"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="3" Padding="5,2"
                            HorizontalAlignment="Right"
                            Background="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeBgConverter}}">
                                <TextBlock Text="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeTextConverter}}"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeFgConverter}}"/>
                            </Border>
                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,2,0,0">
                                <TextBlock Text="{Binding ExecutionDurationText}"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToDurFgConverter}}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Border x:Name="DeleteButton" Width="18" Height="18" Cursor="Hand"
                                Tag="{Binding}" Background="Transparent"
                                VerticalAlignment="Center"
                                MouseLeftButtonUp="DeleteButton_Click"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="删除节点">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="#BDBDBD"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                        <Setter Property="Fill" Value="#E53935"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Line x:Name="MainHorizontalLine" Stroke="#CCCED3" StrokeThickness="2"/>
        <Line x:Name="BranchVerticalLine" Stroke="#CCCED3" StrokeThickness="2"/>
        <Line x:Name="TrueHorizontalLine" Stroke="#4CAF50" StrokeThickness="2"/>
        <Line x:Name="FalseHorizontalLine" Stroke="#F44336" StrokeThickness="2"/>
        <Polygon x:Name="TrueArrow" Fill="#4CAF50">
            <Polygon.Points>
                <Point X="0" Y="0"/>
                <Point X="0" Y="8"/>
                <Point X="8" Y="4"/>
            </Polygon.Points>
        </Polygon>
        <Polygon x:Name="FalseArrow" Fill="#F44336">
            <Polygon.Points>
                <Point X="0" Y="0"/>
                <Point X="0" Y="8"/>
                <Point X="8" Y="4"/>
            </Polygon.Points>
        </Polygon>

        <Border x:Name="TrueBranchWrapper" MinWidth="200">
            <StackPanel>
                <TextBlock Text="TRUE" FontSize="11" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,4"/>
                <Border x:Name="TrueBranchDropZone" Background="#084CAF50" BorderBrush="#1E4CAF50" BorderThickness="1" CornerRadius="4" Padding="8" MinHeight="60" MinWidth="200" AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True" DragEnter="TrueBranch_DragEnter" DragOver="TrueBranch_DragOver" DragLeave="TrueBranch_DragLeave" Drop="TrueBranch_Drop">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#084CAF50"/>
                            <Setter Property="BorderBrush" Value="#1E4CAF50"/>
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="DragOver">
                                    <Setter Property="Background" Value="#204CAF50"/>
                                    <Setter Property="BorderBrush" Value="#404CAF50"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock x:Name="TrueHint" Text="拖拽步骤到此处" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#804CAF50" FontSize="11" FontStyle="Italic"/>
                        <Canvas x:Name="TrueBranchContent" UseLayoutRounding="True"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <Border x:Name="FalseBranchWrapper" MinWidth="200">
            <StackPanel>
                <TextBlock Text="FALSE" FontSize="11" FontWeight="Bold" Foreground="#F44336" Margin="0,0,0,4"/>
                <Border x:Name="FalseBranchDropZone" Background="#08F44336" BorderBrush="#1EF44336" BorderThickness="1" CornerRadius="4" Padding="8" MinHeight="60" MinWidth="200" AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True" DragEnter="FalseBranch_DragEnter" DragOver="FalseBranch_DragOver" DragLeave="FalseBranch_DragLeave" Drop="FalseBranch_Drop">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#08F44336"/>
                            <Setter Property="BorderBrush" Value="#1EF44336"/>
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="DragOver">
                                    <Setter Property="Background" Value="#20F44336"/>
                                    <Setter Property="BorderBrush" Value="#40F44336"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock x:Name="FalseHint" Text="拖拽步骤到此处" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#80F44336" FontSize="11" FontStyle="Italic"/>
                        <Canvas x:Name="FalseBranchContent" UseLayoutRounding="True"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

    </Canvas>
</UserControl>