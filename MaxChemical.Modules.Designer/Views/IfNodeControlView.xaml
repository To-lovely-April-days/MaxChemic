<!-- IfNodeControlView.xaml - 横向布局版 -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.IfNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
    </UserControl.Resources>

    <!--
        横向布局：
        整体用 Canvas，主卡片在左，右侧分出 TRUE（上）/ FALSE（下）两条水平分支
        Canvas 宽高由后台动态计算并设置
    -->
    <Canvas x:Name="RootCanvas">

        <!-- ① 主体卡片 - 固定在 Canvas 左侧垂直居中（由后台设置 Canvas.Top） -->
        <Border x:Name="MainStepCard"
                Canvas.Left="0"
                Width="231" Height="64"
                CornerRadius="6"
                Cursor="Hand"
                PreviewMouseLeftButtonDown="Node_Click"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                Style="{StaticResource ExecutingLogicNodeStyle}">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4" Direction="315" BlurRadius="8"
                                  Color="#000000" Opacity="0.25"/>
            </Border.Effect>

            <Grid Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 执行状态指示条 -->
                <Rectangle Grid.ColumnSpan="3"
                           Height="2" VerticalAlignment="Top"
                           Margin="-16,0,-16,0"
                           Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                           Opacity="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToOpacityConverter}}">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- 左侧图标 -->
                <Grid Grid.Column="0" Width="36" Height="27" Margin="0,0,12,0">
                    <Image Source="{Binding LogicCommand.Properties[Bezel_lessIconPath]}"
                           Width="24" Height="24" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 中间文字 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding DisplayName, FallbackValue='条件判断'}"
                               FontSize="14" FontWeight="Medium" Foreground="#333"
                               Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ConditionSummaryText"
                               FontSize="11" Foreground="#999"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1} {2}">
                                <Binding Path="LogicCommand.Properties[LeftOperand]"  FallbackValue="变量"/>
                                <Binding Path="LogicCommand.Properties[Operator]"     FallbackValue="=="/>
                                <Binding Path="LogicCommand.Properties[RightOperand]" FallbackValue="值"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- 右侧状态 + 删除 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="{Binding ExecutionDurationText}"
                               FontSize="9" Foreground="#666"
                               VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowExecutionDuration}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Ellipse Width="8" Height="8"
                             Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                             VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <Border x:Name="DeleteButton"
                            Width="20" Height="20"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            MouseLeftButtonUp="DeleteButton_Click"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#10000000"/>
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="×" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ② 连接线：主卡片右侧出发，向右画水平线再分叉 -->
        <!-- 主横线：从主卡片右边到分叉点 -->
        <Line x:Name="MainHorizontalLine"
              Stroke="#CCCED3" StrokeThickness="2"/>

        <!-- 分叉竖线：连接 TRUE 和 FALSE -->
        <Line x:Name="BranchVerticalLine"
              Stroke="#CCCED3" StrokeThickness="2"/>

        <!-- TRUE 分支横线 -->
        <Line x:Name="TrueHorizontalLine"
              Stroke="#4CAF50" StrokeThickness="2"/>

        <!-- FALSE 分支横线 -->
        <Line x:Name="FalseHorizontalLine"
              Stroke="#F44336" StrokeThickness="2"/>

        <!-- TRUE 箭头（向右） -->
        <Polygon x:Name="TrueArrow" Fill="#4CAF50">
            <Polygon.Points>
                <Point X="0" Y="0"/>
                <Point X="0" Y="8"/>
                <Point X="8" Y="4"/>
            </Polygon.Points>
        </Polygon>

        <!-- FALSE 箭头（向右） -->
        <Polygon x:Name="FalseArrow" Fill="#F44336">
            <Polygon.Points>
                <Point X="0" Y="0"/>
                <Point X="0" Y="8"/>
                <Point X="8" Y="4"/>
            </Polygon.Points>
        </Polygon>

        <!-- ③ TRUE 分支容器（上方分支） -->
        <Border x:Name="TrueBranchWrapper" MinWidth="200">
            <StackPanel>
                <TextBlock Text="TRUE"
                           FontSize="11" FontWeight="Bold" Foreground="#4CAF50"
                           Margin="0,0,0,4"/>
                <Border x:Name="TrueBranchDropZone"
                        Background="#084CAF50"
                        BorderBrush="#1E4CAF50"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        MinHeight="60"
                        MinWidth="200"
                        AllowDrop="True"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        DragEnter="TrueBranch_DragEnter"
                        DragOver="TrueBranch_DragOver"
                        DragLeave="TrueBranch_DragLeave"
                        Drop="TrueBranch_Drop">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#084CAF50"/>
                            <Setter Property="BorderBrush" Value="#1E4CAF50"/>
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="DragOver">
                                    <Setter Property="Background" Value="#204CAF50"/>
                                    <Setter Property="BorderBrush" Value="#404CAF50"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock x:Name="TrueHint"
                                   Text="拖拽步骤到此处"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#804CAF50" FontSize="11" FontStyle="Italic"/>
                        <!-- 分支内节点横向排列 -->
                        <Canvas x:Name="TrueBranchContent"
        UseLayoutRounding="True"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ④ FALSE 分支容器（下方分支） -->
        <Border x:Name="FalseBranchWrapper" MinWidth="200">
            <StackPanel>
                <TextBlock Text="FALSE"
                           FontSize="11" FontWeight="Bold" Foreground="#F44336"
                           Margin="0,0,0,4"/>
                <Border x:Name="FalseBranchDropZone"
                        Background="#08F44336"
                        BorderBrush="#1EF44336"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        MinHeight="60"
                        MinWidth="200"
                        AllowDrop="True"
                        UseLayoutRounding="True"
                        SnapsToDevicePixels="True"
                        DragEnter="FalseBranch_DragEnter"
                        DragOver="FalseBranch_DragOver"
                        DragLeave="FalseBranch_DragLeave"
                        Drop="FalseBranch_Drop">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#08F44336"/>
                            <Setter Property="BorderBrush" Value="#1EF44336"/>
                            <Style.Triggers>
                                <Trigger Property="Tag" Value="DragOver">
                                    <Setter Property="Background" Value="#20F44336"/>
                                    <Setter Property="BorderBrush" Value="#40F44336"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock x:Name="FalseHint"
                                   Text="拖拽步骤到此处"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#80F44336" FontSize="11" FontStyle="Italic"/>
                        <!-- 分支内节点横向排列 -->
                        <Canvas x:Name="FalseBranchContent"
        UseLayoutRounding="True"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

    </Canvas>
</UserControl>