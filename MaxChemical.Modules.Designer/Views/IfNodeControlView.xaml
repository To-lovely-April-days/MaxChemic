
<UserControl x:Class="MaxChemical.Modules.Designer.Views.IfNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>

       
    </UserControl.Resources>

    <!-- 主容器 - 垂直布局 -->
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

        <!-- 1. 主体卡片 (统一样式) - 居中显示 -->
        <Border x:Name="MainStepCard"
                Width="231" Height="64"
                CornerRadius="6"
                Cursor="Hand"
                PreviewMouseLeftButtonDown="Node_Click"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                HorizontalAlignment="Center"
                Margin="0,10,0,10"
                Style="{StaticResource ExecutingLogicNodeStyle}">
            <!-- 应用执行状态样式 -->

            <Border.Effect>
                <DropShadowEffect ShadowDepth="4"
                                  Direction="315"
                                  BlurRadius="8"
                                  Color="#000000"
                                  Opacity="0.25"/>
            </Border.Effect>

            <!-- 卡片内容 -->
            <Grid Margin="16 0 16 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 执行状态指示条 -->
                <Rectangle Grid.ColumnSpan="3" 
                           Height="2" 
                           VerticalAlignment="Top"
                           Margin="-16,0,-16,0"
                           Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                           Opacity="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToOpacityConverter}}">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- 左侧图标 - 统一为24x24尺寸 -->
                <Grid Grid.Column="0" Width="36" Height="27" Margin="0,0,12,0">
                    <Image Source="{Binding LogicCommand.Properties[Bezel_lessIconPath]}"
                           Width="24" 
                           Height="24"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Grid>

                <!-- 右侧文字内容 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding DisplayName, FallbackValue='条件判断'}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#333"
                               Margin="0,0,0,2"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="11"
                               Foreground="#999"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock x:Name="ConditionSummaryText"
           FontSize="11"
           Foreground="#999"
           TextWrapping="NoWrap"
           TextTrimming="CharacterEllipsis">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                    <Binding Path="LogicCommand.Properties[LeftOperand]" FallbackValue="变量"/>
                                    <Binding Path="LogicCommand.Properties[Operator]" FallbackValue="=="/>
                                    <Binding Path="LogicCommand.Properties[RightOperand]" FallbackValue="值"/>
                                </MultiBinding>
                            </TextBlock.Text>
</TextBlock>
                    </TextBlock>
                </StackPanel>

                <!-- 执行状态和删除按钮区域 -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- 执行时间显示 -->
                    <TextBlock Text="{Binding ExecutionDurationText}" 
                               FontSize="9" 
                               Foreground="#666"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowExecutionDuration}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 执行状态圆点 -->
                    <Ellipse Width="8" Height="8" 
                             Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- 删除按钮 -->
                    <Border x:Name="DeleteButton"
                            Width="20"
                            Height="20"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Cursor="Hand"
                            MouseLeftButtonUp="DeleteButton_Click"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#10000000"/>
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="×"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#666666"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 分支结构画布 - 其余部分保持不变 -->
        <Canvas x:Name="BranchCanvas"
                Width="600"
                HorizontalAlignment="Center">
            <!-- 现有的分支内容保持不变... -->

            <!-- 主干垂直连接线 - 从主卡片中心向下 -->
            <Line x:Name="MainVerticalLine"
                  X1="300" Y1="0" X2="300" Y2="24"
                  Stroke="#CCCED3"
                  StrokeThickness="2"/>

            <!-- 左侧水平连接线 (FALSE) -->
            <Line x:Name="LeftHorizontalLine"
                  X1="150" Y1="24" X2="300" Y2="24"
                  Stroke="#CCCED3"
                  StrokeThickness="2"/>

            <!-- 右侧水平连接线 (TRUE) -->
            <Line x:Name="RightHorizontalLine"
                  X1="300" Y1="24" X2="450" Y2="24"
                  Stroke="#CCCED3"
                  StrokeThickness="2"/>

            <!-- FALSE分支垂直线 -->
            <Line x:Name="FalseVerticalLine"
                  X1="150" Y1="24" X2="150" Y2="36"
                  Stroke="#F44336"
                  StrokeThickness="2"/>

            <!-- TRUE分支垂直线 -->
            <Line x:Name="TrueVerticalLine"
                  X1="450" Y1="24" X2="450" Y2="36"
                  Stroke="#4CAF50"
                  StrokeThickness="2"/>

            <!-- FALSE箭头 -->
            <Polygon x:Name="FalseArrow"
                     Canvas.Left="146" Canvas.Top="32"
                     Fill="#F44336">
                <Polygon.Points>
                    <Point X="0" Y="0"/>
                    <Point X="8" Y="0"/>
                    <Point X="4" Y="8"/>
                </Polygon.Points>
            </Polygon>

            <!-- TRUE箭头 -->
            <Polygon x:Name="TrueArrow"
                     Canvas.Left="446" Canvas.Top="32"
                     Fill="#4CAF50">
                <Polygon.Points>
                    <Point X="0" Y="0"/>
                    <Point X="8" Y="0"/>
                    <Point X="4" Y="8"/>
                </Polygon.Points>
            </Polygon>

            <!-- FALSE分支容器 -->
            <Border x:Name="FalseBranchWrapper"
                    Canvas.Left="50" Canvas.Top="40"
                    MinWidth="200">
                <StackPanel MinWidth="200">
                    <!-- FALSE标签 -->
                    <TextBlock Text="FALSE"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#F44336"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- FALSE分支拖放区域 -->
                    <Border x:Name="FalseBranchDropZone"
                            Background="#08F44336"
                            BorderBrush="#1EF44336"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            MinHeight="60"
                            MinWidth="200"
                            AllowDrop="True"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True"
                            Margin="0,4,0,0"
                            DragEnter="FalseBranch_DragEnter"
                            DragOver="FalseBranch_DragOver"
                            DragLeave="FalseBranch_DragLeave"
                            Drop="FalseBranch_Drop">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#08F44336"/>
                                <Setter Property="BorderBrush" Value="#1EF44336"/>
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="DragOver">
                                        <Setter Property="Background" Value="#20F44336"/>
                                        <Setter Property="BorderBrush" Value="#40F44336"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid UseLayoutRounding="True">
                            <!-- 拖放提示 -->
                            <TextBlock x:Name="FalseHint"
                                       Text="拖拽步骤到此处"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#80F44336"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       FontFamily="Segoe UI"
                                       UseLayoutRounding="True"/>

                            <!-- 分支内容容器 -->
                            <StackPanel x:Name="FalseBranchContent"
                                        UseLayoutRounding="True"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- TRUE分支容器 -->
            <Border x:Name="TrueBranchWrapper"
                    Canvas.Left="350" Canvas.Top="40"
                    MinWidth="200">
                <StackPanel MinWidth="200">
                    <!-- TRUE标签 -->
                    <TextBlock Text="TRUE"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#4CAF50"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- TRUE分支拖放区域 -->
                    <Border x:Name="TrueBranchDropZone"
                            Background="#084CAF50"
                            BorderBrush="#1E4CAF50"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            MinHeight="60"
                            MinWidth="200"
                            AllowDrop="True"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True"
                            Margin="0,4,0,0"
                            IsHitTestVisible="True"
                            DragEnter="TrueBranch_DragEnter"
                            DragOver="TrueBranch_DragOver"
                            DragLeave="TrueBranch_DragLeave"
                            Drop="TrueBranch_Drop">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#084CAF50"/>
                                <Setter Property="BorderBrush" Value="#1E4CAF50"/>
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="DragOver">
                                        <Setter Property="Background" Value="#204CAF50"/>
                                        <Setter Property="BorderBrush" Value="#404CAF50"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid UseLayoutRounding="True">
                            <!-- 拖放提示 -->
                            <TextBlock x:Name="TrueHint"
                                       Text="拖拽步骤到此处"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#804CAF50"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       FontFamily="Segoe UI"
                                       UseLayoutRounding="True"/>

                            <!-- 分支内容容器 -->
                            <StackPanel x:Name="TrueBranchContent"
                                         Background="Transparent"
                                        UseLayoutRounding="True"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>
    </StackPanel>
</UserControl>