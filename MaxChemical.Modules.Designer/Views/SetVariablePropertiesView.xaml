<UserControl x:Class="MaxChemical.Modules.Designer.Views.SetVariablePropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox 下拉框（变量类型用） -->
        <Style x:Key="FieldComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0,28,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <Path x:Name="Arrow"
                                          Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="#9E9E9E" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Width="10" Height="5"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          StrokeLineJoin="Round"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDown"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2" Direction="270"
                                                          BlurRadius="8" Color="#000000" Opacity="0.08"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 5 L 5 0 L 10 5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#212121"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="4" Margin="4,2">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox（本页未用，但统一放进来） -->
        <Style x:Key="FieldCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBd"
                                    Width="16" Height="16"
                                    BorderBrush="#BDBDBD" BorderThickness="1.5"
                                    CornerRadius="4" Background="White"
                                    Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 2 8 L 6 12 L 14 4"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBd" Property="Background" Value="#2196F3"/>
                                <Setter TargetName="CheckBd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBd" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ThinScrollViewerStyle}">
            <StackPanel Margin="10">

                <!-- Header -->
                <Border Padding="14,12" Background="#F5F5F5"
                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="38" Height="38" CornerRadius="10"
                                    Background="White" Margin="0,0,10,0">
                                <TextBlock Text="x=" FontSize="14" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Name="NodeTitle" Text="设置变量" FontSize="15" FontWeight="Medium"
                                       Foreground="#212121" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="10" Padding="6,2" BorderBrush="#E0E0E0"
                                    BorderThickness="1" Background="White" Margin="0,0,6,0">
                                <TextBlock Text="SetVariable" FontSize="11" Foreground="#757575"/>
                            </Border>
                            <Border CornerRadius="10" Padding="6,2" BorderBrush="#E0E0E0"
                                    BorderThickness="1" Background="White">
                                <TextBlock Text="变量赋值" FontSize="11" Foreground="#757575"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 基本信息卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="NodeInfoTitle" Text="基本信息" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <TextBlock Name="NodeNameLabel" Text="名称" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NodeNameBox"
                                 Style="{StaticResource FieldInputStyle}"
                                 Margin="0,0,0,10"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnValueChanged"/>

                        <TextBlock Name="NodeDesc" Text="描述" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="DescriptionBox"
                                 Height="60" Padding="9,6" FontSize="13"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 BorderBrush="#E0E0E0" BorderThickness="1"
                                 Background="#FAFAFA" Foreground="#212121"
                                 Text="{Binding LogicCommand.Properties[Description], UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnValueChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- 变量配置卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="VarSetTitle" Text="变量配置" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <!-- 变量名 -->
                        <TextBlock Name="VarNameLabel" Text="变量名" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="VariableNameTextBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,6,0"
                                     Text="{Binding LogicCommand.Properties[VariableName], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <Button Name="VarSelect" Grid.Column="1" Content="选择"
                                    Style="{StaticResource VarButtonStyle}"
                                    Click="SelectVariableName_Click"/>
                        </Grid>

                        <!-- 变量类型 -->
                        <TextBlock Name="VarTypeLabel" Text="变量类型" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox x:Name="VariableTypeCombo"
                                  Style="{StaticResource FieldComboStyle}"
                                  Margin="0,0,0,10"
                                  SelectedValue="{Binding LogicCommand.Properties[VariableType], UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="OnValueChanged">
                            <ComboBoxItem Content="字符串"   Tag="String"/>
                            <ComboBoxItem Content="整数"     Tag="Integer"/>
                            <ComboBoxItem Content="数字"     Tag="Number"/>
                            <ComboBoxItem Content="小数"     Tag="Double"/>
                            <ComboBoxItem Content="布尔值"   Tag="Boolean"/>
                            <ComboBoxItem Content="日期时间" Tag="DateTime"/>
                        </ComboBox>

                        <!-- 变量值 -->
                        <TextBlock Name="VarValueLabel" Text="变量值" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="VariableValueTextBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,6,0"
                                     Text="{Binding LogicCommand.Properties[VariableValue], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <Button Name="ValueSelect" Grid.Column="1" Content="选择"
                                    Style="{StaticResource VarButtonStyle}"
                                    Click="SelectVariableValue_Click"/>
                        </Grid>

                        <!-- 动态提示文本（保留原有 DataTrigger 逻辑） -->
                        <TextBlock FontSize="11" Foreground="#9E9E9E" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="可输入常量值或使用 {变量名} 引用其他变量"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogicCommand.Properties[VariableType]}" Value="String">
                                            <Setter Property="Text" Value="示例：Hello World 或 {userName}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogicCommand.Properties[VariableType]}" Value="Integer">
                                            <Setter Property="Text" Value="示例：123 或 {count}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogicCommand.Properties[VariableType]}" Value="Number">
                                            <Setter Property="Text" Value="示例：123 或 {count}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogicCommand.Properties[VariableType]}" Value="Double">
                                            <Setter Property="Text" Value="示例：123.45 或 {price}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogicCommand.Properties[VariableType]}" Value="Boolean">
                                            <Setter Property="Text" Value="示例：true 或 {isCompleted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogicCommand.Properties[VariableType]}" Value="DateTime">
                                            <Setter Property="Text" Value="示例：2024-01-01 或 {currentTime}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 预览卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="NodePreviewTitle" Text="赋值预览" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>
                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0"
                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="VariablePreview"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#424242" TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 验证提示（保留原有 MultiDataTrigger 逻辑） -->
                <Border x:Name="ValidationPanel"
                        Background="#FFEBEE" BorderBrush="#EF9A9A"
                        BorderThickness="1" CornerRadius="8"
                        Padding="12" Margin="0,0,0,8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=VariableNameTextBox}" Value=""/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="#E53935" Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Name="WarnInfo" Text="变量名不能为空"
                                   FontSize="12" Foreground="#C62828"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 提示卡片 -->
                <Border Background="#E3F2FD" BorderBrush="#BBDEFB"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="NodeUseDescTitle" Text="使用说明" FontSize="11" FontWeight="Medium" Foreground="#1565C0"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#1976D2"
                                   LineHeight="20" TextWrapping="Wrap">
                            <Run Name="Desc1" Text="• 变量名：直接输入或点击「选择」从已有变量中选取"/>
                            <LineBreak/>
                            <Run Name="Desc2" Text="• 变量值：可以是常量，也可以引用其他变量 ${变量名}"/>
                            <LineBreak/>
                            <Run Name="Desc3" Text="• 类型会影响后续比较和运算的行为"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>