<UserControl x:Class="MaxChemical.Modules.Designer.Views.MonitoringCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Width="Auto"
             Height="Auto">

    <UserControl.Resources>
        <!-- 参数项样式 - 更明显的浅色背景 -->
        <Style x:Key="ParameterItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BBDEFB"/>
                    <Setter Property="BorderBrush" Value="#64B5F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 拖动手柄样式 -->
        <Style x:Key="DragHandleStyle" TargetType="Border">
            <Setter Property="Background" Value="#CFE8FC"/>
            <Setter Property="BorderBrush" Value="#90CAF9"/>
            <Setter Property="BorderThickness" Value="1,1,1,0"/>
            <Setter Property="Cursor" Value="SizeAll"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B3E0FC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 拖动手柄 -->
        <Border Grid.Row="0"
                x:Name="DragHandle"
                Style="{StaticResource DragHandleStyle}"
                CornerRadius="3,3,0,0"
                Height="14"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                MouseMove="DragHandle_MouseMove"
                MouseLeftButtonUp="DragHandle_MouseLeftButtonUp"
                MouseLeave="DragHandle_MouseLeave">

            <Grid>
                <!-- 拖动图标 -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <Ellipse Width="2.5" Height="2.5" Fill="#607D8B" Margin="1"/>
                    <Ellipse Width="2.5" Height="2.5" Fill="#607D8B" Margin="1"/>
                    <Ellipse Width="2.5" Height="2.5" Fill="#607D8B" Margin="1"/>
                    <Ellipse Width="2.5" Height="2.5" Fill="#607D8B" Margin="1"/>
                    <Ellipse Width="2.5" Height="2.5" Fill="#607D8B" Margin="1"/>
                    <Ellipse Width="2.5" Height="2.5" Fill="#607D8B" Margin="1"/>
                </StackPanel>

                <!-- 设备名称 -->
                <TextBlock x:Name="DeviceNameText"
                          Text=""
                          FontSize="7"
                          Foreground="#37474F"
                          FontWeight="Medium"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="5,0,0,0"/>
            </Grid>
        </Border>

        <!-- 参数列表 -->
        <ItemsControl Grid.Row="1"
                     x:Name="ParametersItemsControl">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ParameterItemStyle}"
                            CornerRadius="2"
                            Margin="0,0,0,2"
                            Padding="6,4"
                            MouseLeftButtonDown="ParameterItem_MouseLeftButtonDown"
                            Tag="{Binding}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 参数名 - 深色，更清晰 -->
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="8.5"
                                       Foreground="#263238"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="60"/>

                            <!-- 参数值 - 深蓝色加粗 -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Value}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#0D47A1"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Popup 专业图表弹窗 -->
        <Popup x:Name="DetailPopup"
               Placement="Mouse"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="Fade">

            <Border Background="White"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="4"
                    Width="450"
                    Height="300"
                    MouseLeftButtonDown="Popup_MouseLeftButtonDown">

                <Border.Effect>
                    <DropShadowEffect Color="#000000" 
                                    ShadowDepth="0" 
                                    BlurRadius="20" 
                                    Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid Grid.Row="0"
                          Background="White"
                          Margin="15,0"
                          MouseLeftButtonDown="PopupTitle_MouseLeftButtonDown">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="PopupTitleText"
                                   Text="Outdoor temperature"
                                   Foreground="#2C2C2C"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="✕"
                                FontSize="18"
                                Width="28"
                                Height="28"
                                Background="Transparent"
                                Foreground="#999999"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="PopupCloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border"
                                            Background="{TemplateBinding Background}" 
                                            CornerRadius="2">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                            <Setter Property="Foreground" Value="#666666"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- 内容区域 -->
                    <Grid Grid.Row="1" Background="White" Margin="15,0,15,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 统计信息栏 -->
                        <StackPanel Grid.Row="0" 
                                   Orientation="Horizontal"
                                   VerticalAlignment="Center"
                                   Margin="5,0,0,5">

                            <!-- 当前值 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,25,0">
                                <TextBlock Text="当前: " 
                                           FontSize="10" 
                                           Foreground="#888888"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PopupCurrentValue"
                                           Text="35.2"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#333333"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" °C" 
                                           FontSize="10" 
                                           Foreground="#888888"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 最大值 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock Text="最大: " 
                                           FontSize="9" 
                                           Foreground="#999999"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PopupMaxValue"
                                           Text="--" 
                                           FontSize="10" 
                                           FontWeight="SemiBold" 
                                           Foreground="#4CAF50"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 最小值 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock Text="最小: " 
                                           FontSize="9" 
                                           Foreground="#999999"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PopupMinValue"
                                           Text="--" 
                                           FontSize="10" 
                                           FontWeight="SemiBold" 
                                           Foreground="#F44336"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 平均值 -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="平均: " 
                                           FontSize="9" 
                                           Foreground="#999999"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="PopupAvgValue"
                                           Text="--" 
                                           FontSize="10" 
                                           FontWeight="SemiBold" 
                                           Foreground="#2196F3"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 图表区域 -->
                        <Canvas Grid.Row="1"
                                x:Name="ChartCanvas"
                                Background="White"
                                SizeChanged="ChartCanvas_SizeChanged"/>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>