<UserControl x:Class="MaxChemical.Modules.Designer.Views.LoopNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
        <converters:LoopHeaderSummaryConverter x:Key="LoopHeaderSummaryConverter"/>
        <converters:StatusToIconBackgroundConverter x:Key="StatusToIconBgConverter"/>
        <converters:StatusToIconForegroundConverter x:Key="StatusToIconFgConverter"/>
        <converters:StatusToCardBackgroundConverter x:Key="StatusToCardBgConverter"/>
        <converters:StatusToCardBorderConverter x:Key="StatusToCardBorderConverter"/>
        <converters:StatusToTitleForegroundConverter x:Key="StatusToTitleFgConverter"/>
        <converters:StatusToBadgeBackgroundConverter x:Key="StatusToBadgeBgConverter"/>
        <converters:StatusToBadgeForegroundConverter x:Key="StatusToBadgeFgConverter"/>
        <converters:StatusToBadgeTextConverter x:Key="StatusToBadgeTextConverter"/>
        <converters:StatusToProgressVisibilityConverter x:Key="StatusToProgressVisConverter"/>
        <converters:StatusToDurationForegroundConverter x:Key="StatusToDurFgConverter"/>
    </UserControl.Resources>

    <!--
        方案C布局：
        - 外层 StackPanel 不设固定宽度，由内部最宽元素撑开
        - 头部卡片默认 MinWidth=231，子区域也默认 MinWidth=231
        - 子节点撑大时，代码同步拉宽头部卡片和子区域（SyncWidths）
    -->
    <StackPanel x:Name="RootPanel" HorizontalAlignment="Left">

        <!-- 选中高亮边框（在卡片下方，通过更大的圆角和阴影形成选中效果） -->
        <Grid>
            <Border CornerRadius="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#42A5F5"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#2196F3" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#2196F3" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
            </Border>
            
            <Border x:Name="MainContainer" Margin="2"
                MinWidth="231" Height="66"
                CornerRadius="10"
                Background="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBgConverter}}"
                BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                BorderThickness="1" Cursor="Hand" UseLayoutRounding="True" SnapsToDevicePixels="True"
                MouseLeftButtonDown="Node_Click">
                
                <Grid>
                    <Border Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            CornerRadius="0,0,10,10"
                            Visibility="{Binding ExecutionStatus, Converter={StaticResource StatusToProgressVisConverter}}">
                        <Border.Background>
                            <SolidColorBrush Color="#1976D2" Opacity="0.5"/>
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="231"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                        <Setter Property="Width" Value="150"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <Border Margin="12,0,10,0" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                        VerticalAlignment="Center" Margin="0,0,10,0"
                        Background="{Binding ExecutionStatus, Converter={StaticResource StatusToIconBgConverter}}"
                        BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                        BorderThickness="1">
                                <Image Source="pack://siteoforigin:,,,/Resources/CommadIcon/Bezel-lessLoop.png" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0"
                            Background="Transparent">
                                <TextBlock Text="{Binding DisplayName, FallbackValue='循环'}"
                               FontSize="13" FontWeight="Medium"
                               Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToTitleFgConverter}}"
                               TextTrimming="CharacterEllipsis"/>
                                <Grid>
                                    <TextBlock x:Name="SummaryText"
                       FontSize="11" Foreground="#9E9E9E"
                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                        <Setter Property="Foreground" Value="#1976D2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                        <Setter Property="Foreground" Value="#43A047"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="{Binding ExecutionErrorMessage, FallbackValue='执行失败'}"/>
                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                            <Button x:Name="ExpandToggle" Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,4,0" Click="ExpandToggle_Click" Cursor="Hand" ToolTip="展开/折叠">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <Path x:Name="ExpandIcon" Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" Fill="#9E9E9E" Width="12" Height="12" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ExpandIconTransform" Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Button>
                            <Grid Grid.Column="3" VerticalAlignment="Center" Margin="4,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="3" Padding="5,2"
                HorizontalAlignment="Right"
                Background="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeBgConverter}}">
                                    <TextBlock Text="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeTextConverter}}"
                       FontSize="9" FontWeight="SemiBold"
                       Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeFgConverter}}"/>
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ExecutionDurationText}"
                       FontSize="10" FontWeight="Medium"
                       Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToDurFgConverter}}"
                       VerticalAlignment="Center" Margin="0,0,4,0"
                       Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Border x:Name="DeleteButton" Width="18" Height="18" Cursor="Hand"
                    Tag="{Binding}" Background="Transparent"
                    VerticalAlignment="Center"
                    MouseLeftButtonUp="DeleteButton_Click"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                    ToolTip="删除节点">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="#BDBDBD"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                            <Setter Property="Fill" Value="#E53935"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- ══ 子命令区域（展开时显示） ══ -->
        <StackPanel x:Name="ChildrenContainer"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed">

            <!-- 连接线 -->
            <Line X1="0" Y1="0" X2="0" Y2="8"
                  Stroke="#378ADD" StrokeThickness="1.5"
                  HorizontalAlignment="Center"/>

            <!-- 子节点容器 + 回路箭头叠加 -->
            <Grid x:Name="ChildAreaGrid">
                <!-- 子节点容器：宽度与头部卡片同步（由代码 SyncWidths 控制） -->
                <Border x:Name="LoopContentWrapper"
                        MinWidth="231"
                        ClipToBounds="False"  
                        HorizontalAlignment="Stretch"
                        Background="#F5FAFF"
                        BorderBrush="#378ADD"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        MinHeight="50"
                        AllowDrop="True"
                        Drop="DropArea_Drop"
                        DragOver="DropArea_DragOver"
                        DragEnter="DropArea_DragEnter"
                        DragLeave="DropArea_DragLeave">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EBF5FF"/>
                                    <Setter Property="BorderBrush" Value="#2196F3"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <!-- 空状态提示 -->
                        <TextBlock x:Name="EmptyHint"
                                   Text="+ 拖拽步骤到此处"
                                   FontSize="11"
                                   Foreground="#90CAF9"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="Children.Count">
                                    <Binding.Converter>
                                        <converters:CountToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <!-- 子节点内容 -->
                        <StackPanel x:Name="LoopChildrenContent"
                                    HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- 回路箭头覆盖层：叠加在右侧，用负 Margin 移出布局区域，不影响宽度计算 -->
                <Canvas x:Name="RepeatArrowCanvas"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="36"
                        Margin="0,0,-38,0"
                        IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

    </StackPanel>
</UserControl>
