<UserControl x:Class="MaxChemical.Modules.Designer.Views.LoopNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center">

        <!-- 循环头部卡片 -->
        <Border x:Name="MainContainer"
                Width="231" Height="64"
                Background="White"
                CornerRadius="6"
                Cursor="Hand"
                >

            <Border.Effect>
                <DropShadowEffect ShadowDepth="4"
                                  Direction="315"
                                  BlurRadius="8"
                                  Color="#000000"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧图标 -->
                <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                    <Ellipse Width="24" Height="24" Fill="#FF9800"/>
                    <Path Data="M4,2A2,2 0 0,0 2,4V16A2,2 0 0,0 4,18H11V16H4V4H16V7H18V4A2,2 0 0,0 16,2H4M18.5,9A0.5,0.5 0 0,0 18,9.5V11.5A0.5,0.5 0 0,0 18.5,12H20V15A1,1 0 0,1 19,16H17V14.5A0.5,0.5 0 0,0 16.5,14H14.5A0.5,0.5 0 0,0 14,14.5V16.5A0.5,0.5 0 0,0 14.5,17H16.5A0.5,0.5 0 0,0 17,16.5V18H19A3,3 0 0,0 22,15V12A1,1 0 0,0 21,11H18.5V9Z"
                          Fill="White"
                          Width="12" Height="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stretch="Uniform"/>
                </Grid>

                <!-- 中间区域 - 添加点击事件 -->
                <StackPanel Grid.Column="1" 
                           VerticalAlignment="Center"
                           MouseLeftButtonDown="Node_Click"
                           Background="Transparent">
                    <TextBlock Text="{Binding DisplayName, FallbackValue='循环'}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#333"
                               Margin="0,0,0,2"/>
                    <TextBlock FontSize="11"
                               Foreground="#999">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}执行 {0} 次 · {1} 个步骤">
                                <Binding Path="LogicCommand.Properties[LoopCount]" FallbackValue="10"/>
                                <Binding Path="Children.Count" FallbackValue="0"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- 展开/折叠按钮 - 简化为Button -->
                <Button x:Name="ExpandToggle"
                        Grid.Column="2"
                        Width="20" Height="20"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                         Margin="8,0,0,0"
                        Click="ExpandToggle_Click"
                        Cursor="Hand">

                    <Path x:Name="ExpandIcon"
                          Fill="#666"
                          Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ExpandIconTransform" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>

                    <!-- 按钮样式 -->
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- 子命令显示区域 -->
        <StackPanel x:Name="ChildrenContainer" 
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Visibility="Visible">

            <!-- 子命令列表 -->
            <StackPanel x:Name="LoopChildrenContent"/>

            <!-- 拖放区域 -->
            <Border x:Name="DropZone"
                    Width="200" Height="40"
                    Background="#FFF8E1"
                    BorderBrush="#FFB74D"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,4,0,0"
                    AllowDrop="True"
                    Drop="DropArea_Drop"
                    DragOver="DropArea_DragOver"
                    DragEnter="DropArea_DragEnter"
                    DragLeave="DropArea_DragLeave"
                    MouseLeftButtonDown="DropArea_Click"
                    Cursor="Hand">

                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFECB3"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock x:Name="EmptyHint"
                           Text="+ 添加步骤"
                           FontSize="12"
                           Foreground="#E65100"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

    </StackPanel>
</UserControl>