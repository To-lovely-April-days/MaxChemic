<UserControl x:Class="MaxChemical.Modules.Designer.Views.LoopNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
        <converters:LoopHeaderSummaryConverter x:Key="LoopHeaderSummaryConverter"/>
    </UserControl.Resources>

    <!--
        方案C布局：
        - 外层 StackPanel 不设固定宽度，由内部最宽元素撑开
        - 头部卡片默认 MinWidth=231，子区域也默认 MinWidth=231
        - 子节点撑大时，代码同步拉宽头部卡片和子区域（SyncWidths）
    -->
    <StackPanel x:Name="RootPanel" HorizontalAlignment="Left">

        <!-- ══ 循环头部卡片 ══ -->
        <Border x:Name="MainContainer"
                MinWidth="231" Height="64"
                CornerRadius="8"
                Cursor="Hand"
                Style="{StaticResource ExecutingLogicNodeStyle}"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                Margin="0,10,0,0">

            <Border.Effect>
                <DropShadowEffect ShadowDepth="4"
                      Direction="315"
                      BlurRadius="8"
                      Color="#000000"
                      Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 执行状态指示条（顶部） -->
                <Rectangle Grid.ColumnSpan="4"
                           Height="3"
                           VerticalAlignment="Top"
                           Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                           Opacity="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToOpacityConverter}}">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- 左侧图标 -->
                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="6"
                        Background="White"
                        Margin="14,0,10,0"
                        VerticalAlignment="Center">
                    <Image Source="pack://siteoforigin:,,,/Resources/CommadIcon/Bezel-lessLoop.png"
                           Width="20" Height="20"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- 中间文字区域 -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="Node_Click"
                            Background="Transparent"
                            Margin="0,0,6,0">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="{Binding DisplayName, FallbackValue='循环'}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#212121"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,6,0"/>

                        <!-- 执行状态圆点 -->
                        <Ellipse Width="7" Height="7"
                                 Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>

                    <!-- 摘要文字 -->
                    <TextBlock x:Name="SummaryText"
                               FontSize="11" Foreground="#185FA5"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- 执行时间 -->
                    <TextBlock Text="{Binding ExecutionDurationText}"
                               FontSize="9" Foreground="#BDBDBD"
                               Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- 展开/折叠按钮 -->
                <!-- 展开/折叠按钮 -->
                <Button x:Name="ExpandToggle"
           Grid.Column="2"
           Width="22" Height="22"
           VerticalAlignment="Center"
           Margin="0,0,4,0"
           Click="ExpandToggle_Click"
           Cursor="Hand"
           ToolTip="展开/折叠">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                   Background="{TemplateBinding Background}"
                                   CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Path x:Name="ExpandIcon"
             Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
             Fill="#9E9E9E"
             Width="12" Height="12"
             Stretch="Uniform"
             RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ExpandIconTransform" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Button>

                <!-- 删除按钮 -->
                <Border x:Name="DeleteButton"
                        Grid.Column="3"
                        Width="22" Height="22"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="DeleteButton_Click"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="5"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="×"
                               FontSize="15"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#BDBDBD"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Foreground" Value="#E53935"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ══ 子命令区域（展开时显示） ══ -->
        <StackPanel x:Name="ChildrenContainer"
                    HorizontalAlignment="Stretch"
                    Visibility="Collapsed">

            <!-- 连接线 -->
            <Line X1="0" Y1="0" X2="0" Y2="8"
                  Stroke="#378ADD" StrokeThickness="1.5"
                  HorizontalAlignment="Center"/>

            <!-- 子节点容器 + 回路箭头叠加 -->
            <Grid x:Name="ChildAreaGrid">
                <!-- 子节点容器：宽度与头部卡片同步（由代码 SyncWidths 控制） -->
                <Border x:Name="LoopContentWrapper"
                        MinWidth="231"
                        ClipToBounds="False"  
                        HorizontalAlignment="Stretch"
                        Background="#F5FAFF"
                        BorderBrush="#378ADD"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        MinHeight="50"
                        AllowDrop="True"
                        Drop="DropArea_Drop"
                        DragOver="DropArea_DragOver"
                        DragEnter="DropArea_DragEnter"
                        DragLeave="DropArea_DragLeave">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EBF5FF"/>
                                    <Setter Property="BorderBrush" Value="#2196F3"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <!-- 空状态提示 -->
                        <TextBlock x:Name="EmptyHint"
                                   Text="+ 拖拽步骤到此处"
                                   FontSize="11"
                                   Foreground="#90CAF9"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="Children.Count">
                                    <Binding.Converter>
                                        <converters:CountToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <!-- 子节点内容 -->
                        <StackPanel x:Name="LoopChildrenContent"
                                    HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <!-- 回路箭头覆盖层：叠加在右侧，用负 Margin 移出布局区域，不影响宽度计算 -->
                <Canvas x:Name="RepeatArrowCanvas"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="36"
                        Margin="0,0,-38,0"
                        IsHitTestVisible="False"/>
            </Grid>
        </StackPanel>

    </StackPanel>
</UserControl>
