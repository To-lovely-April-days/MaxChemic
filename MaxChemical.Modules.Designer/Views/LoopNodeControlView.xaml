<UserControl x:Class="MaxChemical.Modules.Designer.Views.LoopNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
        <converters:LoopHeaderSummaryConverter x:Key="LoopHeaderSummaryConverter"/>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center" Width="231" >

        <!-- 循环头部卡片 -->
        <Border x:Name="MainContainer"
                Width="231" Height="64"
                CornerRadius="6"
                Cursor="Hand"
                Style="{StaticResource ExecutingLogicNodeStyle}">

            <Border.Effect>
                <DropShadowEffect ShadowDepth="4"
                                  Direction="315"
                                  BlurRadius="8"
                                  Color="#000000"
                                  Opacity="0.25"/>
            </Border.Effect>

            <Grid Margin="16 0 16 0">
                <!-- 先定义所有属性元素 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 然后是内容元素 -->
                <!-- 执行状态指示条 -->
                <Rectangle Grid.ColumnSpan="4"
                           Height="3" 
                           VerticalAlignment="Top"
                           Margin="-16,0,-16,0"
                           Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                           Opacity="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToOpacityConverter}}">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- 左侧图标 -->
                <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                    <Ellipse Width="24" Height="24" Fill="#FF9800"/>
                    <Path Data="M4,2A2,2 0 0,0 2,4V16A2,2 0 0,0 4,18H11V16H4V4H16V7H18V4A2,2 0 0,0 16,2H4M18.5,9A0.5,0.5 0 0,0 18,9.5V11.5A0.5,0.5 0 0,0 18.5,12H20V15A1,1 0 0,1 19,16H17V14.5A0.5,0.5 0 0,0 16.5,14H14.5A0.5,0.5 0 0,0 14,14.5V16.5A0.5,0.5 0 0,0 14.5,17H16.5A0.5,0.5 0 0,0 17,16.5V18H19A3,3 0 0,0 22,15V12A1,1 0 0,0 21,11H18.5V9Z"
                          Fill="White"
                          Width="12" Height="12"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stretch="Uniform"/>
                </Grid>

                <!-- 中间区域 -->
                <StackPanel Grid.Column="1" 
                           VerticalAlignment="Center"
                           MouseLeftButtonDown="Node_Click"
                           Background="Transparent"
                           Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName, FallbackValue='循环'}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#333"
                                   Margin="0,0,8,2"/>

                        <!-- 执行状态圆点 -->
                        <Ellipse Width="8" Height="8" 
                                 Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,2">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="11"
           Foreground="#999">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LoopHeaderSummaryConverter}">
                                    <!-- 0: LoopType（支持枚举/字符串/数值） -->
                                    <Binding Path="LogicCommand.Properties[LoopType]"/>
                                    <!-- 1: LoopCount -->
                                    <Binding Path="LogicCommand.Properties[LoopCount]" />
                                    <!-- 2: Children.Count -->
                                    <Binding Path="Children.Count" />
                                    <!-- 3: LeftOperand -->
                                    <Binding Path="LogicCommand.Properties[LeftOperand]" />
                                    <!-- 4: Operator（支持枚举/字符串/数值） -->
                                    <Binding Path="LogicCommand.Properties[Operator]" />
                                    <!-- 5: RightOperand -->
                                    <Binding Path="LogicCommand.Properties[RightOperand]" />
                                    <!-- 6: Condition（若属性面板已生成该值则优先使用） -->
                                    <Binding Path="LogicCommand.Properties[Condition]" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- 执行时间显示 -->
                        <TextBlock Text="{Binding ExecutionDurationText}" 
                                   FontSize="9" 
                                   Foreground="#666"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 展开/折叠按钮 -->
                <Button x:Name="ExpandToggle"
                        Grid.Column="2" Height="20"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Click="ExpandToggle_Click"
                        Cursor="Hand">

                    <Path x:Name="ExpandIcon"
                          Fill="#666"
                          Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ExpandIconTransform" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="2">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 删除按钮 -->
                <Border x:Name="DeleteButton"
                        Grid.Column="3"
                        Width="20"
                        Height="20"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        MouseLeftButtonUp="DeleteButton_Click"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#10000000"/>
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="×"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#666666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Foreground" Value="#333333"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- 子命令显示区域 -->
        <StackPanel x:Name="ChildrenContainer" 
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Visibility="Visible">

            <Canvas x:Name="LoopCanvas"
                    Width="500"
                    HorizontalAlignment="Center">

                <Border x:Name="LoopContentWrapper"
                        Canvas.Left="125"
                        Canvas.Top="0"
                        Background="#08607D8B"
                        BorderBrush="#1E607D8B"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        MinHeight="60"
                        MinWidth="250"
                        AllowDrop="True"
                        Drop="DropArea_Drop"
                        DragOver="DropArea_DragOver"
                        DragEnter="DropArea_DragEnter"
                        DragLeave="DropArea_DragLeave">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#10607D8B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <TextBlock x:Name="EmptyHint"
                                   Text="拖拽步骤到此处"
                                   FontSize="11"
                                   Foreground="#80607D8B"
                                   FontStyle="Italic"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="Children.Count">
                                    <Binding.Converter>
                                        <converters:CountToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <StackPanel x:Name="LoopChildrenContent"
                                    HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </Canvas>
        </StackPanel>

    </StackPanel>
</UserControl>