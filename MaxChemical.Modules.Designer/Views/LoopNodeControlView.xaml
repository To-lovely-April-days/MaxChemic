<UserControl x:Class="MaxChemical.Modules.Designer.Views.LoopNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
        <converters:LoopHeaderSummaryConverter x:Key="LoopHeaderSummaryConverter"/>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Center" Width="231">

        <!-- ══ 循环头部卡片 ══ -->
        <Border x:Name="MainContainer"
                Width="231" Height="64"
                CornerRadius="8"
                Cursor="Hand"
                Style="{StaticResource ExecutingLogicNodeStyle}"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                Margin="0,10,0,0">

            <!-- 轻阴影，取代原来过重的效果 -->
            <Border.Effect>
                <DropShadowEffect ShadowDepth="4"
                      Direction="315"
                      BlurRadius="8"
                      Color="#000000"
                      Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

              

                <!-- 执行状态指示条（顶部） -->
                <Rectangle Grid.ColumnSpan="4"
                           Height="3"
                           VerticalAlignment="Top"
                           Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                           Opacity="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToOpacityConverter}}">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- 左侧图标（换成图片） -->
                <Border Grid.Column="0"
                        Width="32" Height="32"
                        CornerRadius="6"
                        Background="White"
                        Margin="14,0,10,0"
                        VerticalAlignment="Center">
                    <Image Source="pack://siteoforigin:,,,/Resources/CommadIcon/Bezel-lessLoop.png"
                           Width="20" Height="20"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- 中间文字区域 -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="Node_Click"
                            Background="Transparent"
                            Margin="0,0,6,0">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="{Binding DisplayName, FallbackValue='循环'}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#212121"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,6,0"/>

                        <!-- 执行状态圆点 -->
                        <Ellipse Width="7" Height="7"
                                 Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>

                    <!-- 摘要文字 -->
                    <TextBlock FontSize="11" Foreground="#9E9E9E"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LoopHeaderSummaryConverter}">
                                <Binding Path="LogicCommand.Properties[LoopType]"/>
                                <Binding Path="LogicCommand.Properties[LoopCount]"/>
                                <Binding Path="Children.Count"/>
                                <Binding Path="LogicCommand.Properties[LeftOperand]"/>
                                <Binding Path="LogicCommand.Properties[Operator]"/>
                                <Binding Path="LogicCommand.Properties[RightOperand]"/>
                                <Binding Path="LogicCommand.Properties[Condition]"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- 执行时间 -->
                    <TextBlock Text="{Binding ExecutionDurationText}"
                               FontSize="9" Foreground="#BDBDBD"
                               Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- 展开/折叠按钮 -->
                <Button x:Name="ExpandToggle"
                        Grid.Column="2"
                        Width="22" Height="22"
                        VerticalAlignment="Center"
                        Margin="0,0,4,0"
                        Click="ExpandToggle_Click"
                        Cursor="Hand"
                        ToolTip="展开/折叠">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#BBDEFB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Path x:Name="ExpandIcon"
                          Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
                          Fill="#9E9E9E"
                          Width="12" Height="12"
                          Stretch="Uniform"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ExpandIconTransform" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Button>

                <!-- 删除按钮 -->
                <Border x:Name="DeleteButton"
                        Grid.Column="3"
                        Width="22" Height="22"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        MouseLeftButtonUp="DeleteButton_Click"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="CornerRadius" Value="5"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="×"
                               FontSize="15"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#BDBDBD"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Foreground" Value="#E53935"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

            </Grid>
        </Border>

        <!-- ══ 子命令区域 ══ -->
        <StackPanel x:Name="ChildrenContainer"
                    HorizontalAlignment="Center"
                    Margin="0,6,0,0"
                    Visibility="Visible">

            <Canvas x:Name="LoopCanvas"
                    Width="500"
                    HorizontalAlignment="Center">

                <!-- 顶部连接线：细、浅色 -->
                <Line Canvas.Left="250" Canvas.Top="0"
                      X1="0" Y1="0" X2="0" Y2="12"
                      Stroke="#CFD8DC" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                <!-- 内容容器：统一主题色 -->
                <Border x:Name="LoopContentWrapper"
                        Canvas.Left="125"
                        Canvas.Top="12"
                        Background="#F5FAFF"
                        BorderBrush="#BBDEFB"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        Padding="8"
                        MinHeight="60"
                        MinWidth="250"
                        AllowDrop="True"
                        Drop="DropArea_Drop"
                        DragOver="DropArea_DragOver"
                        DragEnter="DropArea_DragEnter"
                        DragLeave="DropArea_DragLeave">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EBF5FF"/>
                                    <Setter Property="BorderBrush" Value="#90CAF9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <TextBlock x:Name="EmptyHint"
                                   FontSize="11"
                                   Foreground="#90CAF9"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Visibility>
                                <Binding Path="Children.Count">
                                    <Binding.Converter>
                                        <converters:CountToVisibilityConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Visibility>
                        </TextBlock>

                        <StackPanel x:Name="LoopChildrenContent"
                                    HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

            </Canvas>
        </StackPanel>

    </StackPanel>
</UserControl>