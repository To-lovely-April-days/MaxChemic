<UserControl x:Class="MaxChemical.Modules.Designer.Views.LoopNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
    </UserControl.Resources>

    <!-- 主容器 -->
    <Border x:Name="MainContainer"
            Background="White"
            CornerRadius="10"
            Padding="14"
            Margin="0,10,0,10"
            MinWidth="200"
            BorderBrush="#E6E6E6"
            BorderThickness="1"
            Cursor="Hand"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True"
            HorizontalAlignment="Center"
            MouseDown="Node_Click">

        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Direction="270"
                              ShadowDepth="2"
                              BlurRadius="10"
                              Opacity="0.4"/>
        </Border.Effect>

        <StackPanel UseLayoutRounding="True">

            <!-- ① 循环头部 -->
            <Grid x:Name="HeaderGrid" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧图标 -->
                <Border Grid.Column="0"
                        Width="38" Height="38"
                        Background="#F5F7FA"
                        CornerRadius="13"
                        BorderBrush="#28A745"
                        BorderThickness="1.2"
                        Margin="0,0,18,0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                    <TextBlock Text="🔄"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#28A745"
                               FontSize="22"
                               FontWeight="SemiBold"
                               UseLayoutRounding="True"/>
                </Border>

                <!-- 中间内容区 -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            UseLayoutRounding="True">
                    <TextBlock Text="{Binding DisplayName, FallbackValue='循环'}"
                               FontFamily="Segoe UI Variable, Segoe UI Semibold, Segoe UI, Microsoft YaHei, Arial"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#333333"
                               Margin="0,0,0,3"
                               TextTrimming="CharacterEllipsis"
                               LineHeight="16.24"
                               UseLayoutRounding="True"/>
                    <TextBlock FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei, Arial"
                               FontSize="11"
                               Foreground="#666666"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="Normal"
                               LineHeight="14.52"
                               MaxWidth="130"
                               UseLayoutRounding="True">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}循环 {0} 次">
                                <Binding Path="LogicCommand.Properties[LoopCount]" FallbackValue="10"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- 右侧状态区 -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            UseLayoutRounding="True">
                    <Border Background="#F1F3F4"
                            BorderBrush="#E6E6E6"
                            BorderThickness="1"
                            Padding="7,2,7,2"
                            CornerRadius="4"
                            Margin="0,0,0,6"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="01"
                                   FontFamily="Segoe UI Variable, Segoe UI, Microsoft YaHei, Arial"
                                   FontSize="11"
                                   FontWeight="Medium"
                                   Foreground="#666666"
                                   UseLayoutRounding="True"/>
                    </Border>
                    <Ellipse Width="8" Height="8"
                             HorizontalAlignment="Center"
                             UseLayoutRounding="True"
                             SnapsToDevicePixels="True">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#48BB78" Offset="0"/>
                                <GradientStop Color="#38A169" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
            </Grid>

            <!-- ② 分隔线 -->
            <Rectangle Height="1"
                       Fill="#E6E6E6"
                       Margin="-14,8,-14,8"/>

            <!-- ③ 循环体区域 -->
            <Border x:Name="BodySection" Background="Transparent" UseLayoutRounding="True">
                <StackPanel>

                    <!-- 循环体标签 -->
                    <Grid x:Name="LabelGrid"
                          Height="28"
                          Background="#F8F9FA"
                          Cursor="Hand"
                          Margin="0,0,0,4"
                          MouseLeftButtonDown="ExpandButton_Click">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 展开箭头 -->
                        <Polygon x:Name="ExpandArrow"
                                 Grid.Column="0"
                                 Fill="#666666"
                                 Points="0,0 8,0 4,6"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Margin="8,0,0,0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Polygon.RenderTransform>
                                <RotateTransform x:Name="ArrowRotateTransform" Angle="0"/>
                            </Polygon.RenderTransform>
                        </Polygon>

                        <TextBlock Grid.Column="1"
                                   Text="循环体"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="#666666"
                                   UseLayoutRounding="True"/>

                        <TextBlock x:Name="StepCountText"
                                   Grid.Column="2"
                                   Text="{Binding Children.Count, FallbackValue='0'}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="10"
                                   Foreground="#666666"
                                   UseLayoutRounding="True"/>
                    </Grid>

                    <!-- 拖放区域 -->
                    <Border x:Name="DropZone"
                            MinHeight="56"
                            Margin="0,4,0,0"
                            CornerRadius="4"
                            BorderThickness="1"
                            AllowDrop="True"
                            Background="#FCFDFC"
                            BorderBrush="#C8D7C8"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Drop="DropArea_Drop"
                            DragOver="DropArea_DragOver"
                            DragEnter="DropArea_DragEnter"
                            DragLeave="DropArea_DragLeave">

                        <DockPanel>
                            <!-- 空状态提示 -->
                            <TextBlock x:Name="EmptyHint"
                                       Text="拖拽步骤到此处"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       Foreground="#28A745"
                                       UseLayoutRounding="True"
                                       Margin="0,20,0,20"/>

                            <!-- 内容容器 -->
                            <ScrollViewer x:Name="ContentScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="400"
                                          Padding="4"
                                          Background="Transparent">
                                <StackPanel x:Name="LoopChildrenContent"
                                            Background="Transparent"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>