<UserControl x:Class="MaxChemical.Modules.Designer.Views.ParallelCommandPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views">

    <UserControl.Resources>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分段选择器 RadioButton -->
        <Style x:Key="OpPillStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" HorizontalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- StringEqualityConverter：等待策略是字符串，用这个转换器双向绑定 -->
        <local:StringEqualityConverter x:Key="StrEqConverter"/>

    </UserControl.Resources>

    <Border Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ThinScrollViewerStyle}">
            <StackPanel Margin="10">

                <!-- Header -->
                <Border Padding="14,12" Background="#F5F5F5"
                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="38" Height="38" CornerRadius="10"
                                    Background="White" Margin="0,0,10,0">
                                <Image Source="pack://siteoforigin:,,,/Resources/CommadIcon/Bezel-lessParallel.png"
                                       Width="24" Height="24" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Name="NodeTitle" Text="并行" FontSize="15" FontWeight="Medium"
                                       Foreground="#212121" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="10" Padding="6,2" BorderBrush="#E0E0E0"
                                    BorderThickness="1" Background="White" Margin="0,0,6,0">
                                <TextBlock Text="Parallel" FontSize="11" Foreground="#757575"/>
                            </Border>
                            <Border CornerRadius="10" Padding="6,2" BorderBrush="#E0E0E0"
                                    BorderThickness="1" Background="White">
                                <TextBlock Text="并发执行" FontSize="11" Foreground="#757575"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 等待策略卡片（分段选择器） -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="StrategyTitle" Text="等待策略" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <!-- 隐藏的 ComboBox 保持原有数据绑定 -->
                        <!--<ComboBox Visibility="Collapsed"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding LogicCommand.Properties[WaitStrategy],
                                      Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="OnAnyValueChanged">
                            <ComboBoxItem Content="NoWait"/>
                            <ComboBoxItem Content="WaitAll"/>
                            <ComboBoxItem Content="WaitAny"/>
                        </ComboBox>-->

                        <!-- 分段选择器 -->
                        <Border Background="#F3F4F6" CornerRadius="7" Padding="3">
                            <UniformGrid Rows="1">
                                <RadioButton Name="RbNoWait" Content="不等待"
                                             GroupName="WaitStrategyGroup"
                                             Style="{StaticResource OpPillStyle}"
                                             IsChecked="{Binding LogicCommand.Properties[WaitStrategy],
                                                 Converter={StaticResource StrEqConverter},
                                                 ConverterParameter=NoWait,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Checked="OnAnyValueChanged"/>
                                <RadioButton Name="RbAll" Content="等待全部"
                                             GroupName="WaitStrategyGroup"
                                             Style="{StaticResource OpPillStyle}"
                                             IsChecked="{Binding LogicCommand.Properties[WaitStrategy],
                                                 Converter={StaticResource StrEqConverter},
                                                 ConverterParameter=WaitAll,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Checked="OnAnyValueChanged"/>
                                <RadioButton Name="RbAny" Content="等待任一"
                                             GroupName="WaitStrategyGroup"
                                             Style="{StaticResource OpPillStyle}"
                                             IsChecked="{Binding LogicCommand.Properties[WaitStrategy],
                                                 Converter={StaticResource StrEqConverter},
                                                 ConverterParameter=WaitAny,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Checked="OnAnyValueChanged"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 并行参数卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="ParallelParamTitle" Text="并行参数" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <TextBlock Name="ParallelParamLabel" Text="最大并行数" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="MaxParallelCountBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,8,0"
                                     Text="{Binding LogicCommand.Properties[MaxParallelCount],
                                         Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnAnyValueChanged"
                                     PreviewTextInput="NumberOnly"/>
                            <TextBlock Name="NumberUnitLabel" Grid.Column="1" Text="个"
                                       VerticalAlignment="Center"
                                       FontSize="12" Foreground="#757575"/>
                        </Grid>

                        <TextBlock Name="TimeoutLabel" Text="超时时间" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="TimeoutBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,8,0"
                                     Text="{Binding LogicCommand.Properties[TimeoutSeconds],
                                         Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnAnyValueChanged"
                                     PreviewTextInput="NumberDotOnly"/>
                            <TextBlock Name="TimeUnitLabel" Grid.Column="1" Text="秒"
                                       VerticalAlignment="Center"
                                       FontSize="12" Foreground="#757575"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 描述卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="DescLabel" Text="描述" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>
                        <TextBox x:Name="DescriptionBox"
                                 Height="60" Padding="9,6" FontSize="13"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 BorderBrush="#E0E0E0" BorderThickness="1"
                                 Background="#FAFAFA" Foreground="#212121"
                                 Text="{Binding LogicCommand.Properties[Description],
                                     Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnAnyValueChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- 提示卡片 -->
                <Border Background="#E3F2FD" BorderBrush="#BBDEFB"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="InstructionLabel" Text="策略说明" FontSize="11" FontWeight="Medium" Foreground="#1565C0"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#1976D2"
                                   LineHeight="20" TextWrapping="Wrap">
                            <Run Name="Desc1" Text="• 不等待：启动所有分支后立即继续，分支在后台运行"/>
                            <LineBreak/>
                            <Run Name="Desc2" Text="• 等待全部：等待所有分支都完成后才继续"/>
                            <LineBreak/>
                            <Run Name="Desc3" Text="• 等待任一：任意一个分支完成后即继续，其余后台运行"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>