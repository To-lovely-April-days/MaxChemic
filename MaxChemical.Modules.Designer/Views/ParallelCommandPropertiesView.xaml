<UserControl x:Class="MaxChemical.Modules.Designer.Views.ParallelCommandPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext = CommandNode -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="并行命令"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#333"/>

            <TextBlock Text="最大并行数" Margin="0,12,0,4" Foreground="#666"/>
            <TextBox x:Name="MaxParallelCountBox"
                     MinWidth="160"
                     Text="{Binding LogicCommand.Properties[MaxParallelCount], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="OnAnyValueChanged"
                     PreviewTextInput="NumberOnly"/>

            <TextBlock Text="等待策略" Margin="0,12,0,4" Foreground="#666"/>
            <ComboBox
    MinWidth="160"
    SelectedValuePath="Content"
    SelectedValue="{Binding LogicCommand.Properties[WaitStrategy], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
    SelectionChanged="OnAnyValueChanged">
                <ComboBox.Items>
                    <ComboBoxItem Content="NoWait"/>
                    <ComboBoxItem Content="WaitAll"/>
                    <ComboBoxItem Content="WaitAny"/>
                </ComboBox.Items>
            </ComboBox>

            <TextBlock Text="超时时间（秒）" Margin="0,12,0,4" Foreground="#666"/>
            <TextBox x:Name="TimeoutBox"
                     MinWidth="160"
                     Text="{Binding LogicCommand.Properties[TimeoutSeconds], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="OnAnyValueChanged"
                     PreviewTextInput="NumberDotOnly"/>

            <TextBlock Text="描述" Margin="0,12,0,4" Foreground="#666"/>
            <TextBox x:Name="DescriptionBox"
                     MinWidth="160"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="60"
                     Text="{Binding LogicCommand.Properties[Description], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="OnAnyValueChanged"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>