<UserControl x:Class="MaxChemical.Modules.Designer.Views.EndNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:StatusToIconBackgroundConverter x:Key="StatusToIconBgConverter"/>
        <converters:StatusToCardBackgroundConverter x:Key="StatusToCardBgConverter"/>
        <converters:StatusToCardBorderConverter x:Key="StatusToCardBorderConverter"/>
        <converters:StatusToTitleForegroundConverter x:Key="StatusToTitleFgConverter"/>
        <converters:StatusToBadgeBackgroundConverter x:Key="StatusToBadgeBgConverter"/>
        <converters:StatusToBadgeForegroundConverter x:Key="StatusToBadgeFgConverter"/>
        <converters:StatusToBadgeTextConverter x:Key="StatusToBadgeTextConverter"/>
        <converters:StatusToProgressVisibilityConverter x:Key="StatusToProgressVisConverter"/>
        <converters:StatusToDurationForegroundConverter x:Key="StatusToDurFgConverter"/>
    </UserControl.Resources>

    <!-- 选中光晕 + 主卡片 -->
    <Grid HorizontalAlignment="Center" Margin="0,10,0,10">
        <!-- 选中光晕 -->
        <Border Width="235" Height="70" CornerRadius="12"
                BorderBrush="#EF5350" BorderThickness="1.5"
                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="#E53935" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
            </Border.Effect>
        </Border>

        <Border x:Name="MainStepCard"
                Width="231" Height="66"
                CornerRadius="10"
                Background="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBgConverter}}"
                BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                BorderThickness="1"
                Cursor="Hand"
                MouseDown="Node_Click"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True">

            <Grid>
                <!-- 底部进度条 -->
                <Border Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                        CornerRadius="0,0,10,10"
                        Visibility="{Binding ExecutionStatus, Converter={StaticResource StatusToProgressVisConverter}}">
                    <Border.Background>
                        <SolidColorBrush Color="#E53935" Opacity="0.5"/>
                    </Border.Background>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="231"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                    <Setter Property="Width" Value="150"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Border Margin="12,0,10,0" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 图标区：红色停止方块 -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                                VerticalAlignment="Center" Margin="0,0,10,0"
                                Background="{Binding ExecutionStatus, Converter={StaticResource StatusToIconBgConverter}}"
                                BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                                BorderThickness="1">
                            <Grid>
                                <!-- 电源/结束图标（矢量，深红 #A41626） -->
                                <Path Width="24" Height="24" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="#A41626"
                                      Data="M718.9248 239.328c24.1984 17.2096 45.7152 36.704 64.5376 58.4896s34.9568 45.312 48.4032 70.592c13.4464 25.28 23.6608 52.032 30.6496 80.2688 6.9952 28.2368 10.4896 56.8704 10.4896 85.9136 0 50.016-9.5424 96.9408-28.64 140.7744-19.0848 43.8336-44.9088 82.016-77.4464 114.5536s-70.7264 58.3552-114.5536 77.4464C608.5376 886.4576 561.6192 896 511.5968 896c-49.472 0-96.1344-9.5424-139.9616-28.64-43.8336-19.0848-82.1504-44.9088-114.9568-77.4464s-58.6176-70.7264-77.4464-114.5536-28.2368-90.7584-28.2368-140.7744c0-28.4992 3.36-56.4736 10.0864-83.8976 6.72-27.4304 16.2624-53.5104 28.64-78.2464 12.3712-24.7424 27.6928-47.872 45.984-69.376 18.2848-21.5168 38.72-40.8768 61.3056-58.0928 11.84-8.6016 24.608-11.8272 38.3232-9.6768 13.7152 2.1504 24.8704 8.8768 33.472 20.1664 8.608 11.296 11.84 23.936 9.6896 37.92-2.1568 13.984-8.8768 25.28-20.1728 33.8816C324.4352 352 298.4896 382.3872 280.4736 418.4192c-18.016 36.032-27.0336 74.7584-27.0336 116.1664 0 35.5008 6.7264 68.9728 20.1728 100.4352 13.4464 31.4624 31.8656 58.8928 55.2576 82.2848 23.3984 23.392 50.8224 41.952 82.2848 55.6608 31.4624 13.7216 64.9344 20.576 100.4288 20.576 35.5008 0 68.9792-6.8544 100.4352-20.576 31.4624-13.7152 58.8928-32.2688 82.2848-55.6608 23.3984-23.392 41.952-50.8224 55.6608-82.2848 13.7216-31.4624 20.576-64.9344 20.576-100.4352 0-41.952-9.6832-81.6128-29.0432-118.9888s-46.5216-68.1664-81.472-92.3712c-11.84-8.064-18.9632-19.0912-21.3824-33.0688-2.4192-13.9904 0.4032-26.8928 8.4672-38.7264 8.0704-11.296 19.0912-18.1504 33.0752-20.5696C694.1824 228.4352 707.0912 231.264 718.9248 239.328zM511.5968 537.0048c-13.984 0-25.9456-4.9728-35.8912-14.9184-9.952-9.952-14.9248-21.92-14.9248-35.904L460.7808 179.6288c0-13.984 4.9728-26.08 14.9248-36.3008S497.6128 128 511.5968 128c14.528 0 26.7648 5.1072 36.704 15.328 9.9584 10.2208 14.9312 22.3168 14.9312 36.3008l0 306.5536c0 13.984-4.9728 25.952-14.9312 35.904C538.3552 532.032 526.1184 537.0048 511.5968 537.0048z"/>
                            </Grid>
                        </Border>

                        <!-- 标题 + 副标题 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="{Binding DisplayName, FallbackValue='结束'}"
                                       FontSize="13" FontWeight="Medium"
                                       Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToTitleFgConverter}}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Grid>
                                <!-- 默认摘要（idle 时显示） -->
                                <TextBlock Text="结束整个流程"
                                           FontSize="11" Foreground="#9E9E9E"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- 执行状态文字 -->
                                <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                    <Setter Property="Foreground" Value="#1976D2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                    <Setter Property="Foreground" Value="#43A047"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Text" Value="{Binding ExecutionErrorMessage, FallbackValue='执行失败'}"/>
                                                    <Setter Property="Foreground" Value="#E53935"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- 右侧：Badge + 耗时 + 删除 -->
                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="3" Padding="5,2"
                                    HorizontalAlignment="Right"
                                    Background="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeBgConverter}}">
                                <TextBlock Text="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeTextConverter}}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeFgConverter}}"/>
                            </Border>
                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right" Margin="0,2,0,0">
                                <TextBlock Text="{Binding ExecutionDurationText}"
                                           FontSize="10" FontWeight="Medium"
                                           Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToDurFgConverter}}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                           Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Border x:Name="DeleteButton" Width="18" Height="18" Cursor="Hand"
                                        Tag="{Binding}" Background="Transparent"
                                        VerticalAlignment="Center"
                                        MouseLeftButtonUp="DeleteButton_Click"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="删除节点">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="#BDBDBD"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                        <Setter Property="Fill" Value="#E53935"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
