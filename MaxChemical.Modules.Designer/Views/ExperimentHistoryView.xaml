<!-- MaxChemical.Modules.Designer/Views/ExperimentHistoryView.xaml -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.ExperimentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="FilterGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Header" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
        </Style>
        <Style x:Key="StatusBarStyle" TargetType="StatusBar">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 筛选条件区域 -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel>
                <TextBlock Text="实验历史记录" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 时间范围 -->
                    <GroupBox Grid.Column="0" Header="时间范围" Style="{StaticResource FilterGroupBoxStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="开始时间:" VerticalAlignment="Center" Width="60"/>
                                <DatePicker SelectedDate="{Binding StartDate}" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="结束时间:" VerticalAlignment="Center" Width="60"/>
                                <DatePicker SelectedDate="{Binding EndDate}" Width="120"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 执行状态 -->
                    <GroupBox Grid.Column="1" Header="执行状态" Style="{StaticResource FilterGroupBoxStyle}">
                        <StackPanel>
                            <ComboBox SelectedValue="{Binding IsSuccessful}" Width="100">
                                <ComboBoxItem Content="全部" Tag="{x:Null}"/>
                                <ComboBoxItem Content="成功" Tag="True"/>
                                <ComboBoxItem Content="失败" Tag="False"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <!-- 运行模式 -->
                    <GroupBox Grid.Column="2" Header="运行模式" Style="{StaticResource FilterGroupBoxStyle}">
                        <StackPanel>
                            <ComboBox SelectedValue="{Binding IsSimulation}" Width="100">
                                <ComboBoxItem Content="全部" Tag="{x:Null}"/>
                                <ComboBoxItem Content="实际" Tag="False"/>
                                <ComboBoxItem Content="仿真" Tag="True"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <!-- 搜索和操作按钮 -->
                    <GroupBox Grid.Column="3" Header="搜索" Style="{StaticResource FilterGroupBoxStyle}">
                        <StackPanel>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="200" Margin="0,0,0,5">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="搜索实验名称、流程名称或操作员" 
                                                                           Foreground="Gray" Margin="2,0,0,0"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="搜索" Command="{Binding SearchCommand}" Width="60" Margin="0,0,5,0"/>
                                <Button Content="重置" Command="{Binding ResetFiltersCommand}" Width="60" Margin="0,0,5,0"/>
                                <Button Content="刷新" Command="{Binding RefreshCommand}" Width="60"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="导出全部" Command="{Binding ExportAllCommand}" Width="80" Margin="0,0,10,0"
                            Background="#007BFF" Foreground="White" ToolTip="导出所有实验记录（包含参数变化记录）"/>
                    <Button Content="导出选中" Command="{Binding ExportSelectedCommand}" Width="80" Margin="0,0,10,0"
                            Background="#28A745" Foreground="White" ToolTip="导出选中实验的详细信息"/>
                    <Button Content="参数变化" Command="{Binding ExportParameterChangesCommand}" Width="80" Margin="0,0,10,0"
                            Background="#FFC107" Foreground="Black" ToolTip="导出设备参数变化记录（去重后的数据）"/>
                    <Button Content="查看详情" Command="{Binding ViewDetailsCommand}" Width="80" Margin="0,0,10,0"
                            Background="#17A2B8" Foreground="White"/>
                    <Button Content="删除记录" Command="{Binding DeleteSelectedCommand}" Width="80"
                            Background="#DC3545" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 数据表格区域 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Experiments}" SelectedItem="{Binding SelectedExperiment}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  AlternatingRowBackground="#F8F9FA" SelectionMode="Single"
                  SelectionChanged="DataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="实验名称" Binding="{Binding ExperimentName}" Width="200"/>
                <DataGridTextColumn Header="流程名称" Binding="{Binding FlowName}" Width="150"/>
                <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                <DataGridTextColumn Header="结束时间" Binding="{Binding EndTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                <DataGridTextColumn Header="持续时间" Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" Width="100"/>

                <DataGridTemplateColumn Header="执行状态" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccessful}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="运行模式" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ModeText}" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                                <Setter Property="Foreground" Value="Blue"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSimulationMode}" Value="False">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="完成度" Binding="{Binding ProgressPercentage, StringFormat={}{0:F1}%}" Width="80"/>
                <DataGridTextColumn Header="操作员" Binding="{Binding OperatorName}" Width="100"/>
                <DataGridTextColumn Header="标签" Binding="{Binding Tags}" Width="120"/>
                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页控制区域 -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 记录信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="每页显示:"/>
                    <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="60" Margin="5,0"/>
                    <TextBlock Text="条记录" Margin="5,0,20,0"/>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="共 {0} 条记录，第 {1}/{2} 页">
                                <Binding Path="TotalRecords"/>
                                <Binding Path="CurrentPage"/>
                                <Binding Path="TotalPages"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- 分页按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="首页" Command="{Binding FirstPageCommand}" Width="50" Margin="2"/>
                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Width="60" Margin="2"/>
                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" Width="60" Margin="2"/>
                    <Button Content="末页" Command="{Binding LastPageCommand}" Width="50" Margin="2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Style="{StaticResource StatusBarStyle}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="20" Height="20" IsIndeterminate="{Binding IsLoading}" 
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>