<!-- MaxChemical.Modules.Designer/Views/ExperimentHistoryView.xaml -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.ExperimentHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:MaxChemical.Modules.Designer.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="FilterGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Header" Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"/>
        </Style>
        <Style x:Key="StatusBarStyle" TargetType="StatusBar">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <!--新增：绑定代理-->
        <views:BindingProxy x:Key="BindingProxyKey" Data="{Binding}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 筛选条件区域 -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel>
                <TextBlock Text="{Binding ViewTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 时间范围 -->
                    <GroupBox Grid.Column="0" Header="{Binding TimeRange}" Style="{StaticResource FilterGroupBoxStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="{Binding StartTimeLabel,StringFormat='{}{0}: '}" VerticalAlignment="Center" Width="60"/>
                                <DatePicker SelectedDate="{Binding StartDate}" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EndTimeLabel,StringFormat='{}{0}: '}" VerticalAlignment="Center" Width="60"/>
                                <DatePicker SelectedDate="{Binding EndDate}" Width="120"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 执行状态 -->
                    <GroupBox Grid.Column="1" Header="{Binding ExecuteStatus}" Style="{StaticResource FilterGroupBoxStyle}">
                        <StackPanel>
                            <ComboBox SelectedValue="{Binding IsSuccessful}" Width="100">
                                <ComboBoxItem Content="{Binding StatusItemAll}" Tag="{x:Null}"/>
                                <ComboBoxItem Content="{Binding StatusItemSuccess}" Tag="True"/>
                                <ComboBoxItem Content="{Binding StatusItemFail}" Tag="False"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <!-- 运行模式 -->
                    <GroupBox Grid.Column="2" Header="{Binding RunMode}" Style="{StaticResource FilterGroupBoxStyle}">
                        <StackPanel>
                            <ComboBox SelectedValue="{Binding IsSimulation}" Width="100">
                                <ComboBoxItem Content="{Binding RunItemAll}" Tag="{x:Null}"/>
                                <ComboBoxItem Content="{Binding RunItemActual}" Tag="False"/>
                                <ComboBoxItem Content="{Binding RunItemSimulation}" Tag="True"/>
                            </ComboBox>
                        </StackPanel>
                    </GroupBox>

                    <!-- 搜索和操作按钮 -->
                    <GroupBox Grid.Column="3" Header="{Binding SearchLabel}" Style="{StaticResource FilterGroupBoxStyle}">
                        <StackPanel>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="200" Margin="0,0,0,5">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                            <VisualBrush.Visual>
                                                                <TextBlock Text="{Binding  Data.SearchWatermark,Source={StaticResource BindingProxyKey}}" 
                                                                           Foreground="Gray" Margin="2,0,0,0"/>
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding SearchBtnLabel}" Command="{Binding SearchCommand}" Width="60" Margin="0,0,5,0"/>
                                <Button Content="{Binding ResetBtnLabel}" Command="{Binding ResetFiltersCommand}" Width="60" Margin="0,0,5,0"/>
                                <Button Content="{Binding RefreshBtnLabel}" Command="{Binding RefreshCommand}" Width="60"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="{Binding ExportAllLabel}" Command="{Binding ExportAllCommand}" Width="80" Margin="0,0,10,0"
                            Background="#007BFF" Foreground="White" ToolTip="{Binding ExportAllTip}"/>
                    <Button Content="{Binding ExportSelectLabel}" Command="{Binding ExportSelectedCommand}" Width="80" Margin="0,0,10,0"
                            Background="#28A745" Foreground="White" ToolTip="{Binding ExportSelectTip}"/>
                    <Button Content="{Binding ParamChangeLabel}" Command="{Binding ExportParameterChangesCommand}" Width="80" Margin="0,0,10,0"
                            Background="#FFC107" Foreground="Black" ToolTip="{Binding ParamChangeTip}"/>
                    <Button Content="{Binding ViewDetailsLabel}" Command="{Binding ViewDetailsCommand}" Width="80" Margin="0,0,10,0"
                            Background="#17A2B8" Foreground="White"/>
                    <Button Content="{Binding DeleteRecordLabel}" Command="{Binding DeleteSelectedCommand}" Width="80"
                            Background="#DC3545" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 数据表格区域 -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Experiments}" SelectedItem="{Binding SelectedExperiment}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  AlternatingRowBackground="#F8F9FA" SelectionMode="Single"
                  SelectionChanged="DataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding Data.ExperimentnameHeader,Source={StaticResource BindingProxyKey}}" Binding="{Binding ExperimentName}" Width="200"/>
                <DataGridTextColumn Header="{Binding Data.FlownameHeader,Source={StaticResource BindingProxyKey}}" Binding="{Binding FlowName}" Width="150"/>
                <DataGridTextColumn Header="{Binding Data.StartHeader,Source={StaticResource BindingProxyKey}}" Binding="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                <DataGridTextColumn Header="{Binding Data.EndHeader,Source={StaticResource BindingProxyKey}}" Binding="{Binding EndTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="140"/>
                <DataGridTextColumn Header="{Binding Data.DurationHeader,Source={StaticResource BindingProxyKey}}" Binding="{Binding Duration, StringFormat=hh\\:mm\\:ss}" Width="100"/>

                <DataGridTemplateColumn Header="{Binding Data.ExcuteStatusHeader,Source={StaticResource BindingProxyKey}}" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSuccessful}" Value="True">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                                                <Setter Property="Foreground" Value="Red"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="{Binding Data.RunModeHeader,Source={StaticResource BindingProxyKey}}" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ModeText}" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSimulationMode}" Value="True">
                                                <Setter Property="Foreground" Value="Blue"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSimulationMode}" Value="False">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{Binding Data.CompletionrateHeader,Source={StaticResource BindingProxyKey}}" Binding="{Binding ProgressPercentage, StringFormat={}{0:F1}%}" Width="80"/>
                <DataGridTextColumn Header="{Binding Data.OperatorHeader,Source={StaticResource BindingProxyKey}}" Binding="{Binding OperatorName}" Width="100"/>
                <DataGridTextColumn Header="{Binding Data.LabelHeader,Source={StaticResource BindingProxyKey}}" Binding="{Binding Tags}" Width="120"/>
                <DataGridTextColumn Header="{Binding Data.DescHeader,Source={StaticResource BindingProxyKey}}" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 分页控制区域 -->
        <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 记录信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EachPageShow}"/>
                    <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="60" Margin="5,0"/>
                    <TextBlock Text="{Binding RecordsText}" Margin="5,0,20,0"/>
                    <TextBlock>
                            <!--<MultiBinding StringFormat="共 {0} 条记录，第 {1}/{2} 页">
                                <Binding Path="TotalRecords"/>
                                <Binding Path="CurrentPage"/>
                                <Binding Path="TotalPages"/>
                            </MultiBinding>-->
                            <Run Text="{Binding ATotalText}"/>
                            <Run Text="{Binding TotalRecords}"/>
                            <Run Text="{Binding SecondText}"/>
                            <Run Text="{Binding CurrentPage}"/>
                            <Run Text="{Binding TotalPages,StringFormat='/ {0}'}"/>
                            <Run Text="{Binding PageText}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 分页按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding IndexLabel}" Command="{Binding FirstPageCommand}" Width="50" Margin="2"/>
                    <Button Content="{Binding NextPageLabel}" Command="{Binding PreviousPageCommand}" Width="60" Margin="2"/>
                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
                    <Button Content="{Binding PreviousPageLabel}" Command="{Binding NextPageCommand}" Width="60" Margin="2"/>
                    <Button Content="{Binding BackoverLabel}" Command="{Binding LastPageCommand}" Width="50" Margin="2"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3" Style="{StaticResource StatusBarStyle}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="20" Height="20" IsIndeterminate="{Binding IsLoading}" 
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>