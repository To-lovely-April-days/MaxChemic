<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.TShapePipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="140" 
             d:DesignWidth="160"
             Width="160" Height="140"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="LeftEndCapGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#D9D9D9" Offset="0"/>
            <GradientStop Color="#A0A0A0" Offset="0.5"/>
            <GradientStop Color="#D9D9D9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RightEndCapGradient" StartPoint="1,0.5" EndPoint="0,0.5">
            <GradientStop Color="#D9D9D9" Offset="0"/>
            <GradientStop Color="#A0A0A0" Offset="0.5"/>
            <GradientStop Color="#D9D9D9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopEndCapGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#D9D9D9" Offset="0"/>
            <GradientStop Color="#A0A0A0" Offset="0.5"/>
            <GradientStop Color="#D9D9D9" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Canvas x:Name="PipeCanvas" Background="Transparent" ClipToBounds="False">

        <Canvas x:Name="LeftFlangeGroup" 
                Canvas.Left="4" 
                Canvas.Top="58"
                Width="2.54" 
                Height="24">

            <Rectangle x:Name="LeftFlangeBase"
                       Width="2.54"
                       Height="24"
                       Fill="#D9D9D9"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="LeftFlangeGradient"
                       Width="2.54"
                       Height="24"
                       Fill="{StaticResource LeftEndCapGradient}"
                       Opacity="0.6"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="LeftFlangeBorder"
                       Width="2.54"
                       Height="24"
                       Stroke="#727171" 
                       StrokeThickness="0.7"
                       RadiusX="1.27" 
                       RadiusY="1.27" 
                       Fill="Transparent"/>
        </Canvas>

        <Rectangle x:Name="MainHorizontalPipe" 
                   Canvas.Left="6" 
                   Canvas.Top="60"
                   Width="120"
                   Height="20">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#727171" Offset="0"/>
                    <GradientStop Color="#59727171" Offset="0.264"/>
                    <GradientStop Color="#1A727171" Offset="0.418"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.498"/>
                    <GradientStop Color="#1A727171" Offset="0.581"/>
                    <GradientStop Color="#59727171" Offset="0.719"/>
                    <GradientStop Color="#727171" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Line x:Name="MainHorizontalTopEdge" 
              X1="6" Y1="60" 
              X2="126" Y2="60"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Line x:Name="MainHorizontalBottomEdge" 
              X1="6" Y1="80" 
              X2="126" Y2="80"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Canvas x:Name="RightFlangeGroup" 
                Canvas.Left="126"
                Canvas.Top="58"
                Width="2.54"
                Height="24">

            <Rectangle x:Name="RightFlangeBase" 
                       Width="2.54"
                       Height="24" 
                       Fill="#D9D9D9" 
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="RightFlangeGradient" 
                       Width="2.54"
                       Height="24"
                       Fill="{StaticResource RightEndCapGradient}"
                       Opacity="0.6"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="RightFlangeBorder" 
                       Width="2.54"
                       Height="24" 
                       Stroke="#727171" 
                       StrokeThickness="0.7" 
                       RadiusX="1.27" 
                       RadiusY="1.27" 
                       Fill="Transparent"/>
        </Canvas>

        <Canvas x:Name="TopFlangeGroup" 
                Canvas.Left="58"
                Canvas.Top="3.4"
                Width="24"
                Height="2.54">

            <Rectangle x:Name="TopFlangeBase" 
                       Width="24"
                       Height="2.54" 
                       Fill="#D9D9D9" 
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="TopFlangeGradient" 
                       Width="24"
                       Height="2.54"
                       Fill="{StaticResource TopEndCapGradient}"
                       Opacity="0.6"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="TopFlangeBorder" 
                       Width="24"
                       Height="2.54" 
                       Stroke="#727171" 
                       StrokeThickness="0.7" 
                       RadiusX="1.27" 
                       RadiusY="1.27" 
                       Fill="Transparent"/>
        </Canvas>

        <Rectangle x:Name="BranchVerticalPipe" 
                   Canvas.Left="60"
                   Canvas.Top="6"
                   Width="20"
                   Height="54">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#727171" Offset="0"/>
                    <GradientStop Color="#59727171" Offset="0.264"/>
                    <GradientStop Color="#1A727171" Offset="0.418"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.498"/>
                    <GradientStop Color="#1A727171" Offset="0.581"/>
                    <GradientStop Color="#59727171" Offset="0.719"/>
                    <GradientStop Color="#727171" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Line x:Name="BranchLeftEdge" 
              X1="60" Y1="6" 
              X2="60" Y2="60"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Line x:Name="BranchRightEdge" 
              X1="80" Y1="6" 
              X2="80" Y2="60"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Ellipse x:Name="TJunction"
                 Canvas.Left="65"
                 Canvas.Top="65"
                 Width="10"
                 Height="10"
                 Fill="#8A8A8A"
                 Opacity="0.3"/>

        <Ellipse x:Name="MainLengthAnchor" 
                 Canvas.Left="134"
                 Canvas.Top="64"
                 Width="12" Height="12" 
                 Fill="Orange" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整主管道长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="BranchLengthAnchor" 
                 Canvas.Left="64"
                 Canvas.Top="-6"
                 Width="12" Height="12" 
                 Fill="Orange" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整支管长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="BranchPositionAnchor" 
                 Canvas.Left="34"
                 Canvas.Top="64"
                 Width="12" Height="12" 
                 Fill="Orange" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整支管位置"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="PipeWidthAnchor" 
                 Canvas.Left="64"
                 Canvas.Top="84"
                 Width="12" Height="12" 
                 Fill="Orange" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="RotateAnchor" 
                 Canvas.Left="74"
                 Canvas.Top="-40"
                 Width="12" Height="12" 
                 Fill="#4CAF50" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="Hand">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Line x:Name="RotateAnchorLine" 
              X1="80" Y1="0"
              X2="80" Y2="-34"
              Stroke="Orange" 
              StrokeThickness="1" 
              StrokeDashArray="2,2" 
              Opacity="0"/>

        <Border x:Name="RotationLabel"
                Canvas.Left="60"
                Canvas.Top="-60"
                Background="#CC000000"
                CornerRadius="3"
                Padding="5,2"
                Visibility="Collapsed">
            <TextBlock x:Name="RotationText"
                       Foreground="White"
                       FontSize="11"
                       Text="0°"/>
        </Border>

        <Rectangle x:Name="SelectionBorder" 
                   Canvas.Left="-2"
                   Canvas.Top="-2"
                   Width="164"
                   Height="144"
                   Stroke="#FF9500" 
                   StrokeThickness="2" 
                   Fill="Transparent" 
                   RadiusX="3" 
                   RadiusY="3" 
                   Visibility="Collapsed">
            <Rectangle.Effect>
                <DropShadowEffect Color="Orange" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
            </Rectangle.Effect>
        </Rectangle>
    </Canvas>

</UserControl>