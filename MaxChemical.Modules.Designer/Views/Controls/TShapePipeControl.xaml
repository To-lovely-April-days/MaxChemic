<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.TShapePipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="140" 
             d:DesignWidth="160"
             Width="160" Height="140"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0"
                     SnapsToDevicePixels="True"
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <!-- ═══ 所有画刷由代码动态生成，不再使用 StaticResource ═══ -->

    <!-- 不设 Background（=null）：空白区域不捕获鼠标，点击穿透到下方
         命中测试仅作用于实际有 Fill 的子元素（主管、支管、法兰） -->
    <Canvas x:Name="PipeCanvas" ClipToBounds="False">

        <!-- ═══════════════ 左侧法兰组 ═══════════════ -->
        <Canvas x:Name="LeftFlangeGroup"
                Canvas.Left="4" Canvas.Top="58"
                Width="2.54" Height="24">
            <Rectangle x:Name="LeftFlangeBase"
                       Width="2.54" Height="24"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeGradient"
                       Width="2.54" Height="24"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeBorder"
                       Width="2.54" Height="24"
                       StrokeThickness="0.7"
                       Fill="Transparent"
                       RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 主水平管道 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Rectangle x:Name="MainHorizontalPipeBackground"
                   Canvas.Left="6" Canvas.Top="60"
                   Width="120" Height="20"
                   Fill="White"/>

        <Rectangle x:Name="MainHorizontalFluidBackground"
                   Canvas.Left="6" Canvas.Top="60"
                   Width="120" Height="20"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="MainHorizontalFluidPattern"
                   Canvas.Left="6" Canvas.Top="60"
                   Width="120" Height="20"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="MainHorizontalPipe"
                   Canvas.Left="6" Canvas.Top="60"
                   Width="120" Height="20"/>

        <Line x:Name="MainHorizontalTopEdge"
              X1="6" Y1="60" X2="126" Y2="60"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <Line x:Name="MainHorizontalBottomEdge"
              X1="6" Y1="80" X2="126" Y2="80"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 右侧法兰组 ═══════════════ -->
        <Canvas x:Name="RightFlangeGroup"
                Canvas.Left="126" Canvas.Top="58"
                Width="2.54" Height="24">
            <Rectangle x:Name="RightFlangeBase"
                       Width="2.54" Height="24"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeGradient"
                       Width="2.54" Height="24"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeBorder"
                       Width="2.54" Height="24"
                       StrokeThickness="0.7"
                       Fill="Transparent"
                       RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 顶部法兰组 ═══════════════ -->
        <Canvas x:Name="TopFlangeGroup"
                Canvas.Left="58" Canvas.Top="3.4"
                Width="24" Height="2.54">
            <Rectangle x:Name="TopFlangeBase"
                       Width="24" Height="2.54"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="TopFlangeGradient"
                       Width="24" Height="2.54"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="TopFlangeBorder"
                       Width="24" Height="2.54"
                       StrokeThickness="0.7"
                       Fill="Transparent"
                       RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 支管垂直管道 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Rectangle x:Name="BranchPipeBackground"
                   Canvas.Left="60" Canvas.Top="6"
                   Width="20" Height="54"
                   Fill="White"/>

        <Rectangle x:Name="BranchFluidBackground"
                   Canvas.Left="60" Canvas.Top="6"
                   Width="20" Height="54"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="BranchFluidPattern"
                   Canvas.Left="60" Canvas.Top="6"
                   Width="20" Height="54"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="BranchVerticalPipe"
                   Canvas.Left="60" Canvas.Top="6"
                   Width="20" Height="54"/>

        <Line x:Name="BranchLeftEdge"
              X1="60" Y1="6" X2="60" Y2="60"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <Line x:Name="BranchRightEdge"
              X1="80" Y1="6" X2="80" Y2="60"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ T 型连接处 ═══════════════ -->
        <Ellipse x:Name="TJunction"
                 Canvas.Left="65" Canvas.Top="65"
                 Width="10" Height="10"
                 Opacity="0.3"/>

        <!-- ═══════════════ 锚点 ═══════════════ -->
        <!-- 主管左端锚点：拖动时从左端延伸管道（MainPipeLength 增加 + 控件整体向左移） -->
        <Ellipse x:Name="MainLeftAnchor"
                 Canvas.Left="-6" Canvas.Top="64"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动从左端延伸主管"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="MainLengthAnchor"
                 Canvas.Left="134" Canvas.Top="64"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整主管道长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="BranchLengthAnchor"
                 Canvas.Left="64" Canvas.Top="-6"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整支管长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="BranchPositionAnchor"
                 Canvas.Left="34" Canvas.Top="64"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整支管位置"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="PipeWidthAnchor"
                 Canvas.Left="64" Canvas.Top="84"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="RotateAnchor"
                 Canvas.Left="74" Canvas.Top="-40"
                 Width="12" Height="12"
                 Fill="#4CAF50" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="Hand">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Line x:Name="RotateAnchorLine"
              X1="80" Y1="0" X2="80" Y2="-34"
              Stroke="Orange" StrokeThickness="1" StrokeDashArray="2,2"
              Opacity="0"/>

        <Border x:Name="RotationLabel"
                Canvas.Left="60" Canvas.Top="-60"
                Background="#CC000000" CornerRadius="3" Padding="5,2"
                Visibility="Collapsed">
            <TextBlock x:Name="RotationText" Foreground="White" FontSize="11" Text="0°"/>
        </Border>

        <!-- ═══════════════ 选中高亮边框 ═══════════════ -->
        <!-- 选中描边：T 形，由主管（横）+ 支管（竖）两段贴合 -->
        <Rectangle x:Name="SelectionBorder" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="SelectionBorderBranch" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
    </Canvas>
</UserControl>