<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.TShapePipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="140" 
             d:DesignWidth="160"
             Width="160" Height="140"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0"
                     SnapsToDevicePixels="True"
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <Canvas x:Name="PipeCanvas" ClipToBounds="False">

        <!-- ═══════════════ 左侧法兰组 ═══════════════ -->
        <Canvas x:Name="LeftFlangeGroup"
                Canvas.Left="4" Canvas.Top="58"
                Width="2.54" Height="24">
            <Rectangle x:Name="LeftFlangeBase" Width="2.54" Height="24" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeGradient" Width="2.54" Height="24" Opacity="0.6" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeBorder" Width="2.54" Height="24" StrokeThickness="0.7" Fill="Transparent" RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 主水平管道 ═══════════════ -->
        <Rectangle x:Name="MainHorizontalPipeBackground" Canvas.Left="6" Canvas.Top="60" Width="120" Height="20" Fill="White"/>
        <Rectangle x:Name="MainHorizontalFluidBackground" Canvas.Left="6" Canvas.Top="60" Width="120" Height="20" Visibility="Collapsed"/>
        <Rectangle x:Name="MainHorizontalFluidPattern" Canvas.Left="6" Canvas.Top="60" Width="120" Height="20" Visibility="Collapsed"/>
        <Rectangle x:Name="MainHorizontalPipe" Canvas.Left="6" Canvas.Top="60" Width="120" Height="20"/>

        <Line x:Name="MainHorizontalTopEdge" X1="6" Y1="60" X2="126" Y2="60"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Line x:Name="MainHorizontalBottomEdge" X1="6" Y1="80" X2="126" Y2="80"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 右侧法兰组 ═══════════════ -->
        <Canvas x:Name="RightFlangeGroup"
                Canvas.Left="126" Canvas.Top="58"
                Width="2.54" Height="24">
            <Rectangle x:Name="RightFlangeBase" Width="2.54" Height="24" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeGradient" Width="2.54" Height="24" Opacity="0.6" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeBorder" Width="2.54" Height="24" StrokeThickness="0.7" Fill="Transparent" RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 顶部法兰组 ═══════════════ -->
        <Canvas x:Name="TopFlangeGroup"
                Canvas.Left="58" Canvas.Top="3.4"
                Width="24" Height="2.54">
            <Rectangle x:Name="TopFlangeBase" Width="24" Height="2.54" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="TopFlangeGradient" Width="24" Height="2.54" Opacity="0.6" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="TopFlangeBorder" Width="24" Height="2.54" StrokeThickness="0.7" Fill="Transparent" RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 支管垂直管道 ═══════════════ -->
        <Rectangle x:Name="BranchPipeBackground" Canvas.Left="60" Canvas.Top="6" Width="20" Height="54" Fill="White"/>
        <Rectangle x:Name="BranchFluidBackground" Canvas.Left="60" Canvas.Top="6" Width="20" Height="54" Visibility="Collapsed"/>
        <Rectangle x:Name="BranchFluidPattern" Canvas.Left="60" Canvas.Top="6" Width="20" Height="54" Visibility="Collapsed"/>
        <Rectangle x:Name="BranchVerticalPipe" Canvas.Left="60" Canvas.Top="6" Width="20" Height="54"/>

        <Line x:Name="BranchLeftEdge" X1="60" Y1="6" X2="60" Y2="60"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Line x:Name="BranchRightEdge" X1="80" Y1="6" X2="80" Y2="60"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ T 型连接处 ═══════════════ -->
        <Ellipse x:Name="TJunction" Canvas.Left="65" Canvas.Top="65" Width="10" Height="10" Opacity="0.3"/>

        <!-- ═══════════════════════════════════════════════════════════
             ★ 赛博流光层 — 默认隐藏，UseDefaultStyle=true 时显示
             ═══════════════════════════════════════════════════════════ -->

        <!-- 金属管壁层（主管 + 支管两个矩形） -->
        <Rectangle x:Name="CyberMainMetal" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="CyberBranchMetal" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- 内部暗腔 -->
        <Rectangle x:Name="CyberMainDark" Fill="#000814" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="CyberBranchDark" Fill="#000814" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- ★ 主管中心线流光 —— 横穿主管 -->
        <Path x:Name="CyberMainMainStream" Visibility="Collapsed" IsHitTestVisible="False" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Effect>
                <BlurEffect Radius="3" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>
        <Path x:Name="CyberMainParticleStream" Visibility="Collapsed" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect>
                <BlurEffect Radius="2" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>
        <Path x:Name="CyberMainSparkStream" Visibility="Collapsed" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="#FFFFFF">
            <Path.Effect>
                <BlurEffect Radius="1.5" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- ★ 支管中心线流光 —— 从主管中线向上到支管顶 -->
        <Path x:Name="CyberBranchMainStream" Visibility="Collapsed" IsHitTestVisible="False" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Effect>
                <BlurEffect Radius="3" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>
        <Path x:Name="CyberBranchParticleStream" Visibility="Collapsed" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect>
                <BlurEffect Radius="2" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>
        <Path x:Name="CyberBranchSparkStream" Visibility="Collapsed" IsHitTestVisible="False" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="#FFFFFF">
            <Path.Effect>
                <BlurEffect Radius="1.5" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- ═══════════════ 锚点 ═══════════════ -->
        <Ellipse x:Name="MainLeftAnchor"
                 Canvas.Left="-6" Canvas.Top="64"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动从左端延伸主管"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="MainLengthAnchor" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整主管道长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="BranchLengthAnchor" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整支管长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="BranchPositionAnchor" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整支管位置"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="PipeWidthAnchor" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="RotateAnchor" Width="12" Height="12" Fill="#4CAF50" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="Hand">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Line x:Name="RotateAnchorLine" Stroke="Orange" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0"/>

        <Border x:Name="RotationLabel" Background="#CC000000" CornerRadius="3" Padding="5,2" Visibility="Collapsed">
            <TextBlock x:Name="RotationText" Foreground="White" FontSize="11" Text="0°"/>
        </Border>

        <!-- ═══════════════ 选中高亮边框（T 形：2 段） ═══════════════ -->
        <Rectangle x:Name="SelectionBorder" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="SelectionBorderBranch" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
    </Canvas>
</UserControl>
