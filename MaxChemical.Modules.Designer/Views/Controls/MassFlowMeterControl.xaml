<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.MassFlowMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" 
             d:DesignWidth="400"
             Width="400" Height="500"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <!-- ✅ 根级别缓存配置 -->
    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <UserControl.Resources>
        <!-- ✅ 优化：数据发光动画添加帧率限制 -->
        <Storyboard x:Key="DataGlowAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ValueGlow"
                           Storyboard.TargetProperty="Opacity"
                           From="0.4" To="0.8" Duration="0:0:2"
                           AutoReverse="True"
                           Timeline.DesiredFrameRate="30"/>
        </Storyboard>

        <!-- 其他资源保持不变 -->
        <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#59020202" Offset="0"/>
            <GradientStop Color="#1F020202" Offset="0.026"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.116"/>
            <GradientStop Color="#4DFFFFFF" Offset="0.498"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.888"/>
            <GradientStop Color="#1F020202" Offset="0.966"/>
            <GradientStop Color="#59020202" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BaseGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4DB8C5CC" Offset="0"/>
            <GradientStop Color="#66B8C5CC" Offset="0.3"/>
            <GradientStop Color="#99AAB8BF" Offset="0.6"/>
            <GradientStop Color="#B8C5CC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A9AA5" Offset="0"/>
            <GradientStop Color="#B8C5CC" Offset="0.1"/>
            <GradientStop Color="#D4DDE2" Offset="0.25"/>
            <GradientStop Color="#F0F4F6" Offset="0.5"/>
            <GradientStop Color="#D4DDE2" Offset="0.75"/>
            <GradientStop Color="#B8C5CC" Offset="0.9"/>
            <GradientStop Color="#8A9AA5" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="DialGradient">
            <GradientStop Color="#FAFAFA" Offset="0"/>
            <GradientStop Color="#E8E8E8" Offset="0.7"/>
            <GradientStop Color="#D0D0D0" Offset="1"/>
        </RadialGradientBrush>

        <!-- 按钮样式保持不变 -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderOptions.CachingHint="Cache">
                            <Border x:Name="ButtonBg" CornerRadius="7" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                                    BlurRadius="6" ShadowDepth="2" Direction="315"
                                                    RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="7" BorderBrush="#E0E0E0" BorderThickness="2" Margin="1"/>
                            <Border CornerRadius="5" Margin="3" Opacity="0.08">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EEF1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#F5FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#E8F0F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderOptions.CachingHint="Cache">
                            <Border x:Name="ButtonBg" CornerRadius="9" Background="#FFFFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                            BlurRadius="8" ShadowDepth="3" Direction="315"
                                            RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="9" BorderBrush="White" BorderThickness="2" Margin="1" Opacity="0.5"/>
                            <Border CornerRadius="7" Margin="3" Opacity="0.08">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EEF1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#F5FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas Background="Transparent">
        <!-- ✅ 可拖拽区域（不缓存） -->
        <Rectangle x:Name="DraggableArea"
                   Canvas.Left="0" Canvas.Top="0"
                   Width="400" Height="500"
                   Fill="Transparent"
                   Panel.ZIndex="0"
                   Cursor="SizeAll"
                   MouseLeftButtonDown="OnOverlayMouseDown"
                   MouseLeftButtonUp="OnOverlayMouseUp"
                   MouseMove="OnOverlayMouseMove"/>

        <!-- ✅ 静态层：地面阴影（性能优化） -->
        <Ellipse Canvas.Left="100" Canvas.Top="492"
                 Width="200" Height="6" Opacity="0.15"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2A4A68" Offset="0"/>
                    <GradientStop Color="#2A4A68" Offset="0.6"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="6" RenderingBias="Performance"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- ✅ 静态层：底座矩形（启用缓存） -->
        <Rectangle Canvas.Left="80" Canvas.Top="471" Width="240" Height="29" RadiusX="7" RadiusY="7"
                   Panel.ZIndex="1" Fill="{StaticResource BaseGradient}"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.2" BlurRadius="4" ShadowDepth="2" Direction="315"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 底座高光 -->
        <Rectangle Canvas.Left="82" Canvas.Top="473" Width="236" Height="8" RadiusX="6" RadiusY="6"
                   Opacity="0.25" Panel.ZIndex="2"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ✅ 静态层：底座梯形（启用缓存） -->
        <Polygon Points="120,445 280,445 300,471 100,471" Panel.ZIndex="1"
                 Fill="{StaticResource BaseGradient}"
                 RenderOptions.CachingHint="Cache">
            <Polygon.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
            </Polygon.Stroke>
            <Polygon.StrokeThickness>2.5</Polygon.StrokeThickness>
        </Polygon>

        <!-- ✅ 静态层：主外壳（启用缓存） -->
        <Rectangle Canvas.Left="30" Canvas.Top="0" Width="340" Height="445" RadiusX="12" RadiusY="12" 
                   Fill="#F0F4F6" Panel.ZIndex="3"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.25" BlurRadius="12" ShadowDepth="5" Direction="315"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="30" Canvas.Top="0" Width="340" Height="445" RadiusX="12" RadiusY="12" 
                   Fill="{StaticResource MetalBrush}" Panel.ZIndex="4"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
        </Rectangle>

        <Rectangle Canvas.Left="32" Canvas.Top="2" Width="336" Height="60" RadiusX="10" RadiusY="10"
                   Opacity="0.3" Panel.ZIndex="5"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#FAFCFD" Offset="0.4"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ✅ 静态层：左侧进口管道（启用缓存） -->
        <Rectangle Canvas.Left="-16" Canvas.Top="385" Width="102" Height="37" 
                   Fill="{StaticResource PipeGradient}" Panel.ZIndex="2"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.2"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="8" ShadowDepth="4" Direction="270"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="-14" Canvas.Top="387" Width="98" Height="15"
                   Opacity="0.5" Panel.ZIndex="3"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ✅ 动画层：液体流动效果（禁用缓存，使用 GPU） -->
        <Canvas x:Name="FluidFlowContainer" 
                Canvas.Left="-16" Canvas.Top="385" 
                Width="432" Height="37" 
                Panel.ZIndex="10" 
                ClipToBounds="True"  
                Visibility="Collapsed"
                RenderOptions.BitmapScalingMode="LowQuality">

            <!-- ⚠️ 液体层不使用 CacheMode -->

            <Rectangle x:Name="FluidRectangle" Width="432" Height="37">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="FluidGradientBrush" StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="FluidGradientTransform" X="0"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#4D2E86C1" Offset="0"/>
                        <GradientStop Color="#803498DB" Offset="0.25"/>
                        <GradientStop Color="#CC5DADE2" Offset="0.5"/>
                        <GradientStop Color="#803498DB" Offset="0.75"/>
                        <GradientStop Color="#4D2E86C1" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 波动路径 -->
            <Path x:Name="WavePath1" 
                  Data="M -50,0 Q -25,3 0,0 T 50,0 T 100,0 T 150,0 T 200,0 T 250,0 T 300,0 T 350,0 T 400,0 T 450,0 T 500,0"
                  Stroke="#85C1F0" StrokeThickness="1.5" Canvas.Top="8" Opacity="0.6">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="WaveTransform1" X="0"/>
                </Path.RenderTransform>
            </Path>

            <Path x:Name="WavePath2"
                  Data="M -50,0 Q -25,-2 0,0 T 50,0 T 100,0 T 150,0 T 200,0 T 250,0 T 300,0 T 350,0 T 400,0 T 450,0 T 500,0"
                  Stroke="#AED6F1" StrokeThickness="1.2" Canvas.Top="28" Opacity="0.5">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="WaveTransform2" X="0"/>
                </Path.RenderTransform>
            </Path>

            <!-- 气泡 -->
            <Ellipse x:Name="Bubble1" Width="6" Height="6" Fill="White" Opacity="0.5" Canvas.Left="-10" Canvas.Top="20">
                <Ellipse.Effect>
                    <BlurEffect Radius="2" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Bubble2" Width="5" Height="5" Fill="White" Opacity="0.4" Canvas.Left="-10" Canvas.Top="24">
                <Ellipse.Effect>
                    <BlurEffect Radius="1.5" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Bubble3" Width="4" Height="4" Fill="White" Opacity="0.6" Canvas.Left="-10" Canvas.Top="16">
                <Ellipse.Effect>
                    <BlurEffect Radius="1" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Bubble4" Width="7" Height="7" Fill="White" Opacity="0.3" Canvas.Left="-10" Canvas.Top="22">
                <Ellipse.Effect>
                    <BlurEffect Radius="2.5" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Bubble5" Width="5" Height="5" Fill="White" Opacity="0.5" Canvas.Left="-10" Canvas.Top="18">
                <Ellipse.Effect>
                    <BlurEffect Radius="1.8" RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 高光反射 -->
            <Rectangle Width="432" Height="12" Canvas.Top="2" Opacity="0.3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 底部阴影 -->
            <Rectangle Width="432" Height="8" Canvas.Top="29" Opacity="0.2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#1A2E4A" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Canvas>

        <!-- ✅ 静态层：管道接口（启用缓存） -->
        <Rectangle Canvas.Left="-30" Canvas.Top="380" Width="14" Height="47" RadiusX="7" RadiusY="7" 
                   Fill="#C4CFD6" Stroke="#7A8A95" StrokeThickness="2.5" Panel.ZIndex="11"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="6" ShadowDepth="3" Direction="180"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 右侧管道组（与左侧相同优化） -->
        <Rectangle Canvas.Left="314" Canvas.Top="385" Width="102" Height="37" 
                   Fill="{StaticResource PipeGradient}" Panel.ZIndex="2"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.2"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="8" ShadowDepth="4" Direction="270"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="316" Canvas.Top="387" Width="98" Height="15"
                   Opacity="0.5" Panel.ZIndex="3"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle Canvas.Left="416" Canvas.Top="380" Width="14" Height="47" RadiusX="7" RadiusY="7" 
                   Fill="#C4CFD6" Stroke="#7A8A95" StrokeThickness="2.5" Panel.ZIndex="11"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="6" ShadowDepth="3" Direction="0"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ✅ 设定值显示区域（缓存） -->
        <StackPanel Canvas.Left="70" Canvas.Top="18" Panel.ZIndex="10" HorizontalAlignment="Center"
                    RenderOptions.CachingHint="Cache">
            <TextBlock Text="SET POINT" FontSize="13" Foreground="#7F8C8D" FontWeight="Bold" 
                      HorizontalAlignment="Center" Margin="0,0,0,6"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- 按钮组（已在样式中优化） -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Width="45" Height="38" Margin="0,0,0,4"
                            Style="{StaticResource SmallButtonStyle}" 
                            Cursor="Hand"
                            Click="OnIncreaseButtonClick">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="1024" Height="1024">
                                <Path Data="M861.417121,738.727375 C903.021852,738.727375 926.650504,683.76358 896.345760,653.469157 L547.071415,304.191372 C527.041419,284.159656 497.249294,284.159656 477.217578,304.191372 L127.955275,653.469157 C96.869561,684.54283 122.818761,738.727375 163.396533,738.727375 L861.417121,738.727375 Z" 
                                      Fill="#27AE60"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button Width="45" Height="38"
                            Style="{StaticResource SmallButtonStyle}" 
                            Cursor="Hand"
                            Click="OnDecreaseButtonClick">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="1024" Height="1024">
                                <Path Data="M163.396533,289.168875 C122.818761,289.168875 96.871281,343.35342 127.955275,374.427093 L477.217578,723.704878 C497.249294,743.736594 527.041419,743.736594 547.073135,723.704878 L896.34748,374.427093 C926.652224,344.132670 903.025292,289.168875 861.419841,289.168875 L163.396533,289.168875 Z" 
                                      Fill="#E74C3C"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <Border CornerRadius="9" Background="White" 
                        BorderBrush="#BDC3C7" BorderThickness="2.5"
                        Padding="16,10" VerticalAlignment="Center" Margin="0,0,10,0"
                        RenderOptions.CachingHint="Cache">
                    <Border.Effect>
                        <DropShadowEffect Color="#2A4A68" Opacity="0.18" BlurRadius="5" ShadowDepth="2" Direction="315"
                                          RenderingBias="Performance"/>
                    </Border.Effect>
                    <TextBlock x:Name="TargetValueText" Text="125.0" 
                              FontSize="32" FontWeight="Bold" 
                              Foreground="#3498DB" 
                              TextAlignment="Center" 
                              FontFamily="Segoe UI, Arial"
                              MinWidth="110"/>
                </Border>

                <Button Width="65" Height="46"
                        Style="{StaticResource SetButtonStyle}" 
                        Cursor="Hand"
                        Click="OnSetButtonClick"
                        VerticalAlignment="Center">
                    <TextBlock Text="SET" FontSize="17" FontWeight="Bold" Foreground="#27AE60"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ✅ 仪表盘区域（缓存） -->
        <Canvas Canvas.Left="100" Canvas.Top="125" Panel.ZIndex="7"
                RenderOptions.CachingHint="Cache">

            <Ellipse Width="200" Height="200" 
                    Fill="Transparent"
                    Stroke="#B0BCC3" StrokeThickness="4.5">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="10" ShadowDepth="5" Direction="315"
                                      RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Canvas.Left="4.5" Canvas.Top="4.5" Width="191" Height="191" 
                    Fill="{StaticResource DialGradient}"
                    Stroke="#999999" StrokeThickness="3.5"/>

            <Ellipse Canvas.Left="12" Canvas.Top="12" Width="176" Height="176" 
                    Fill="White"
                    Stroke="#DDDDDD" StrokeThickness="2"/>

            <!-- 刻度盘（缓存） -->
            <Canvas Width="191" Height="191" Canvas.Left="4.5" Canvas.Top="4.5">
                <Line X1="23" Y1="95.5" X2="35" Y2="95.5" Stroke="#333333" StrokeThickness="3.2"
                      RenderOptions.EdgeMode="Aliased"/>
                <TextBlock Canvas.Left="2" Canvas.Top="88" Text="0" FontSize="17" FontWeight="Bold" Foreground="#333333"/>

                <Line X1="44" Y1="56" X2="53" Y2="65" Stroke="#666666" StrokeThickness="2.3"
                      RenderOptions.EdgeMode="Aliased"/>

                <Line X1="95.5" Y1="23" X2="95.5" Y2="35" Stroke="#333333" StrokeThickness="3.2"
                      RenderOptions.EdgeMode="Aliased"/>
                <TextBlock Canvas.Left="84" Canvas.Top="2" Text="50" FontSize="17" FontWeight="Bold" Foreground="#333333"/>

                <Line X1="147" Y1="56" X2="138" Y2="65" Stroke="#666666" StrokeThickness="2.3"
                      RenderOptions.EdgeMode="Aliased"/>

                <Line X1="168" Y1="95.5" X2="156" Y2="95.5" Stroke="#333333" StrokeThickness="3.2"
                      RenderOptions.EdgeMode="Aliased"/>
                <TextBlock Canvas.Left="170" Canvas.Top="88" Text="100" FontSize="17" FontWeight="Bold" Foreground="#333333"/>

                <Line X1="147" Y1="135" X2="138" Y2="126" Stroke="#666666" StrokeThickness="2.3"
                      RenderOptions.EdgeMode="Aliased"/>

                <Line X1="95.5" Y1="168" X2="95.5" Y2="156" Stroke="#333333" StrokeThickness="3.2"
                      RenderOptions.EdgeMode="Aliased"/>
                <TextBlock Canvas.Left="80" Canvas.Top="170" Text="150" FontSize="17" FontWeight="Bold" Foreground="#333333"/>

                <Line X1="44" Y1="135" X2="53" Y2="126" Stroke="#666666" StrokeThickness="2.3"
                      RenderOptions.EdgeMode="Aliased"/>
            </Canvas>

            <TextBlock Canvas.Left="77" Canvas.Top="78" Text="kg/h" FontSize="15" FontWeight="Bold" 
                      Foreground="#7F8C8D" HorizontalAlignment="Center"/>

            <Ellipse Canvas.Left="91" Canvas.Top="91" Width="13" Height="13" Fill="#34495E">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="4" ShadowDepth="2"
                                      RenderingBias="Performance"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- ✅ 指针（不缓存，使用硬件加速变换） -->
            <Path x:Name="CurrentPointer" Fill="#E74C3C" Stroke="#C0392B" StrokeThickness="1.5"
                  Data="M 97.5,102 L 94,35 L 97.5,29 L 101,35 Z">
                <Path.RenderTransform>
                    <RotateTransform x:Name="PointerRotation" 
