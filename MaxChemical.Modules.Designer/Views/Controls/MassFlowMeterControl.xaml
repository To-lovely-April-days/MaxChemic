<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.MassFlowMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" 
             d:DesignWidth="400"
             Width="400" Height="500"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <UserControl.Resources>
        <!-- ========== 🆕 改进的加载动画：参考柱塞泵 ========== -->
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <!-- 1. 显示加载层 -->
            <DoubleAnimation Storyboard.TargetName="LoadingOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.2"/>

            <!-- 2. 🎯 蓝色扫描光效：在外壳上来回移动 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScannerTranslate"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-400"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="400"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="-400"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 3. 仪表盘四角的旋转光圈 -->
            <DoubleAnimation Storyboard.TargetName="LoadingRing1Rotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.5"/>
            <DoubleAnimation Storyboard.TargetName="LoadingRing2Rotate"
                             Storyboard.TargetProperty="Angle"
                             From="90" To="450" Duration="0:0:1.5"/>
            <DoubleAnimation Storyboard.TargetName="LoadingRing3Rotate"
                             Storyboard.TargetProperty="Angle"
                             From="180" To="540" Duration="0:0:1.5"/>
            <DoubleAnimation Storyboard.TargetName="LoadingRing4Rotate"
                             Storyboard.TargetProperty="Angle"
                             From="270" To="630" Duration="0:0:1.5"/>

            <!-- 4. 管道内部流光效果 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PipeFlowGradient"
                                          Storyboard.TargetProperty="Offset"
                                          Duration="0:0:1">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 5. 整体轻微呼吸 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                          Storyboard.TargetProperty="BlurRadius"
                                          Duration="0:0:1.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="10"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                         Storyboard.TargetProperty="Color"
                                         Duration="0:0:1.5">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#00FFFFFF"/>
                <LinearColorKeyFrame KeyTime="0:0:0.75" Value="#662196F3"/>
                <LinearColorKeyFrame KeyTime="0:0:1.5" Value="#00FFFFFF"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ========== 🆕 改进的错误闪烁动画：参考柱塞泵 ========== -->
        <Storyboard x:Key="ErrorBlinkAnimation" RepeatBehavior="3x">
            <!-- 1. 显示错误层 -->
            <DoubleAnimation Storyboard.TargetName="ErrorOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.1"/>

            <!-- 2. 剧烈震动效果 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellShakeTransform"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:0.1" RepeatBehavior="5x">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.02" Value="-5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="-5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.10" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 3. 🎯 红色扫描光效：急促来回移动 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorScannerTranslate"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-400"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="400"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="-400"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="400"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="-400"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 4. 红色警报灯急促闪烁 -->
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                         Storyboard.TargetProperty="Color"
                                         Duration="0:0:0.5">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="Transparent"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.1" Value="#FFD32F2F"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.25" Value="Transparent"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.4" Value="#FFD32F2F"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.5" Value="Transparent"/>
            </ColorAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                          Storyboard.TargetProperty="BlurRadius"
                                          Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="40"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="40"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 5. 🎯 底座指示灯闪烁 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIndicator1"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIndicator2"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 6. 🎯 警告图标缩放弹跳 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIconScale"
                                          Storyboard.TargetProperty="ScaleX"
                                          Duration="0:0:0.5">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1.2"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIconScale"
                                          Storyboard.TargetProperty="ScaleY"
                                          Duration="0:0:0.5">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1.2"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ========== 🆕 改进的错误保持动画：参考柱塞泵 ========== -->
        <Storyboard x:Key="ErrorStateHoldAnimation" RepeatBehavior="Forever">
            <!-- 保持错误层显示 -->
            <DoubleAnimation Storyboard.TargetName="ErrorOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0"/>

            <!-- 🎯 红色扫描光效：持续缓慢移动 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorScannerTranslate"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:3">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-400"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="400"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="-400"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 柔和的红色呼吸 -->
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                         Storyboard.TargetProperty="Color"
                                         Duration="0:0:2">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#66D32F2F"/>
                <LinearColorKeyFrame KeyTime="0:0:1" Value="#B3D32F2F"/>
                <LinearColorKeyFrame KeyTime="0:0:2" Value="#66D32F2F"/>
            </ColorAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                          Storyboard.TargetProperty="BlurRadius"
                                          Duration="0:0:2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="15"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="30"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="15"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 底座指示灯持续呼吸 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIndicator1"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:1">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.6"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIndicator2"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:1">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.6"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 🎯 图标透明度呼吸 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIcon"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:1.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.8"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ✅ 数据发光动画（原有） -->
        <Storyboard x:Key="DataGlowAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ValueGlow"
                           Storyboard.TargetProperty="Opacity"
                           From="0.4" To="0.8" Duration="0:0:2"
                           AutoReverse="True"
                           Timeline.DesiredFrameRate="30"/>
        </Storyboard>

        <!-- 其他资源保持不变 -->
        <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#59020202" Offset="0"/>
            <GradientStop Color="#1F020202" Offset="0.026"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.116"/>
            <GradientStop Color="#4DFFFFFF" Offset="0.498"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.888"/>
            <GradientStop Color="#1F020202" Offset="0.966"/>
            <GradientStop Color="#59020202" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BaseGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4DB8C5CC" Offset="0"/>
            <GradientStop Color="#66B8C5CC" Offset="0.3"/>
            <GradientStop Color="#99AAB8BF" Offset="0.6"/>
            <GradientStop Color="#B8C5CC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A9AA5" Offset="0"/>
            <GradientStop Color="#B8C5CC" Offset="0.1"/>
            <GradientStop Color="#D4DDE2" Offset="0.25"/>
            <GradientStop Color="#F0F4F6" Offset="0.5"/>
            <GradientStop Color="#D4DDE2" Offset="0.75"/>
            <GradientStop Color="#B8C5CC" Offset="0.9"/>
            <GradientStop Color="#8A9AA5" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="DialGradient">
            <GradientStop Color="#FAFAFA" Offset="0"/>
            <GradientStop Color="#E8E8E8" Offset="0.7"/>
            <GradientStop Color="#D0D0D0" Offset="1"/>
        </RadialGradientBrush>

        <!-- 按钮样式（保持不变） -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderOptions.CachingHint="Cache">
                            <Border x:Name="ButtonBg" CornerRadius="7" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                                    BlurRadius="6" ShadowDepth="2" Direction="315"
                                                    RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="7" BorderBrush="#E0E0E0" BorderThickness="2" Margin="1"/>
                            <Border CornerRadius="5" Margin="3" Opacity="0.08">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EEF1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#F5FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#E8F0F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderOptions.CachingHint="Cache">
                            <Border x:Name="ButtonBg" CornerRadius="9" Background="#FFFFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                            BlurRadius="8" ShadowDepth="3" Direction="315"
                                            RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="9" BorderBrush="White" BorderThickness="2" Margin="1" Opacity="0.5"/>
                            <Border CornerRadius="7" Margin="3" Opacity="0.08">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EEF1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#F5FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas Background="Transparent">
        <!-- ✅ 可拖拽区域（不缓存） -->
        <Rectangle x:Name="DraggableArea"
                   Canvas.Left="0" Canvas.Top="0"
                   Width="400" Height="500"
                   Fill="Transparent"
                   Panel.ZIndex="0"
                   Cursor="SizeAll"
                   MouseLeftButtonDown="OnOverlayMouseDown"
                   MouseLeftButtonUp="OnOverlayMouseUp"
                   MouseMove="OnOverlayMouseMove"/>

        <!-- ✅ 静态层：地面阴影 -->
        <Ellipse Canvas.Left="100" Canvas.Top="492"
                 Width="200" Height="6" Opacity="0.15"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2A4A68" Offset="0"/>
                    <GradientStop Color="#2A4A68" Offset="0.6"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="6" RenderingBias="Performance"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- ✅ 静态层：底座矩形 -->
        <Rectangle Canvas.Left="80" Canvas.Top="471" Width="240" Height="29" RadiusX="7" RadiusY="7"
                   Panel.ZIndex="1" Fill="{StaticResource BaseGradient}"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.2" BlurRadius="4" ShadowDepth="2" Direction="315"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 🎯 底座上的嵌入式错误指示灯 -->
        <Ellipse x:Name="ErrorIndicator1" Canvas.Left="95" Canvas.Top="478" Width="15" Height="15" 
                 Fill="#D32F2F" Opacity="0" Panel.ZIndex="2">
            <Ellipse.Effect>
                <DropShadowEffect Color="#D32F2F" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="ErrorIndicator2" Canvas.Left="290" Canvas.Top="478" Width="15" Height="15" 
                 Fill="#D32F2F" Opacity="0" Panel.ZIndex="2">
            <Ellipse.Effect>
                <DropShadowEffect Color="#D32F2F" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 底座高光 -->
        <Rectangle Canvas.Left="82" Canvas.Top="473" Width="236" Height="8" RadiusX="6" RadiusY="6"
                   Opacity="0.25" Panel.ZIndex="2"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ✅ 静态层：底座梯形 -->
        <Polygon Points="120,445 280,445 300,471 100,471" Panel.ZIndex="1"
                 Fill="{StaticResource BaseGradient}"
                 RenderOptions.CachingHint="Cache">
            <Polygon.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
            </Polygon.Stroke>
            <Polygon.StrokeThickness>2.5</Polygon.StrokeThickness>
        </Polygon>

        <!-- ========== ✅ 关键修改：主外壳组（支持震动） ========== -->
        <Canvas x:Name="MainBodyGroup" Panel.ZIndex="3">
            <!-- ⚠️ 震动变换 -->
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="ShellShakeTransform" X="0" Y="0"/>
            </Canvas.RenderTransform>

            <!-- 主外壳底色 -->
            <Rectangle Canvas.Left="30" Canvas.Top="0" Width="340" Height="445" RadiusX="12" RadiusY="12" 
                       Fill="#F0F4F6"
                       RenderOptions.CachingHint="Cache">
                <Rectangle.Effect>
                    <!-- ⚠️ 关键：带光效的阴影 -->
                    <DropShadowEffect x:Name="ShellGlow" 
                                      Color="Transparent" 
                                      Opacity="0.8" 
                                      BlurRadius="0" 
                                      ShadowDepth="0"
                                      RenderingBias="Performance"/>
                </Rectangle.Effect>
            </Rectangle>

            <!-- 🎯 蓝色加载状态：扫描光效层 -->
            <Canvas x:Name="LoadingOverlay" Opacity="0" IsHitTestVisible="False">
                <Rectangle Canvas.Left="30" Canvas.Top="0" Width="340" Height="445" RadiusX="12" RadiusY="12">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#402196F3" Offset="0.45"/>
                            <GradientStop Color="#8064B5F6" Offset="0.5"/>
                            <GradientStop Color="#402196F3" Offset="0.55"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                            <LinearGradientBrush.Transform>
                                <TranslateTransform x:Name="ScannerTranslate" X="-400"/>
                            </LinearGradientBrush.Transform>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>

            <!-- 🎯 红色错误状态：扫描光效层 -->
            <Canvas x:Name="ErrorOverlay" Opacity="0" IsHitTestVisible="False">
                <Rectangle Canvas.Left="30" Canvas.Top="0" Width="340" Height="445" RadiusX="12" RadiusY="12">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#66D32F2F" Offset="0.45"/>
                            <GradientStop Color="#B3FF5252" Offset="0.5"/>
                            <GradientStop Color="#66D32F2F" Offset="0.55"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                            <LinearGradientBrush.Transform>
                                <TranslateTransform x:Name="ErrorScannerTranslate" X="-400"/>
                            </LinearGradientBrush.Transform>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>

            <!-- 金属纹理 -->
            <Rectangle Canvas.Left="30" Canvas.Top="0" Width="340" Height="445" RadiusX="12" RadiusY="12" 
                       Fill="{StaticResource MetalBrush}"
                       RenderOptions.CachingHint="Cache">
                <Rectangle.Stroke>
                    <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
                </Rectangle.Stroke>
                <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            </Rectangle>

            <!-- 顶部高光 -->
            <Rectangle Canvas.Left="32" Canvas.Top="2" Width="336" Height="60" RadiusX="10" RadiusY="10"
                       Opacity="0.3"
                       RenderOptions.CachingHint="Cache">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#FAFCFD" Offset="0.4"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Canvas>

        <!-- ✅ 静态层：左侧进口管道 -->
        <Rectangle Canvas.Left="-16" Canvas.Top="385" Width="102" Height="37" 
                   Fill="{StaticResource PipeGradient}" Panel.ZIndex="2"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.2"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="8" ShadowDepth="4" Direction="270"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 🎯 管道内部流光效果（加载时） -->
        <Rectangle Canvas.Left="-16" Canvas.Top="385" Width="102" Height="37" 
                   Panel.ZIndex="3" IsHitTestVisible="False"
                   Opacity="{Binding Opacity, ElementName=LoadingOverlay}">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="Transparent" Offset="0"/>
