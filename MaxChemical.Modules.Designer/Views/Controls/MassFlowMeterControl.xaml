        </Ellipse>
        <Line X1="357" Y1="66" X2="369" Y2="66" Stroke="#4A4A52" StrokeThickness="1.6" Panel.ZIndex="21"/>
        <Line X1="363" Y1="60" X2="363" Y2="72" Stroke="#4A4A52" StrokeThickness="1.6" Panel.ZIndex="21"/>

        <Ellipse Canvas.Left="28" Canvas.Top="381" Width="18" Height="18"
                 Fill="#C8C8D0" Stroke="#8A8A92" StrokeThickness="1"
                 Panel.ZIndex="20"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="2.5" ShadowDepth="1"
