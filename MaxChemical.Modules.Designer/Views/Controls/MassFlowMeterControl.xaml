        <TextBlock Canvas.Left="117" Canvas.Top="90" Text="CORI-FLOW" 
                   FontSize="24" FontWeight="ExtraBold" Foreground="#F0F0F0" 
                   FontFamily="Arial, Segoe UI" Panel.ZIndex="26"/>
        <TextBlock Canvas.Left="283" Canvas.Top="89" Text="™" 
