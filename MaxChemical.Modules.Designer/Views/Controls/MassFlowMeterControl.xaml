<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.MassFlowMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" 
             d:DesignWidth="400"
             Width="400" Height="500"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <UserControl.Resources>
        <!-- ===========================================================
             F. 深灰 Bronkhorst 1:1 还原 配色
             =========================================================== -->

        <!-- 停止状态: 深灰 -->
        <LinearGradientBrush x:Key="StoppedShellGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#929298" Offset="0"/>
            <GradientStop Color="#787880" Offset="1"/>
        </LinearGradientBrush>

        <!-- 运行状态: 蓝绿色 -->
        <LinearGradientBrush x:Key="RunningShellGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#6EA888" Offset="0"/>
            <GradientStop Color="#4E8866" Offset="1"/>
        </LinearGradientBrush>

        <!-- 顶面 -->
        <LinearGradientBrush x:Key="TopFaceGradient" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#9898A0" Offset="0"/>
            <GradientStop Color="#AAAAB2" Offset="1"/>
        </LinearGradientBrush>

        <!-- 右侧面 -->
        <LinearGradientBrush x:Key="RightFaceGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6A6A72" Offset="0"/>
            <GradientStop Color="#585860" Offset="1"/>
        </LinearGradientBrush>

        <!-- LCD蓝色渐变 -->
        <LinearGradientBrush x:Key="LcdGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#2848A0" Offset="0"/>
            <GradientStop Color="#1A3078" Offset="1"/>
        </LinearGradientBrush>

        <!-- 垂直管道圆管渐变 -->
        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EEECEA" Offset="0"/>
            <GradientStop Color="#DEDBD6" Offset="0.2"/>
            <GradientStop Color="#C4C0B8" Offset="0.5"/>
            <GradientStop Color="#A4A098" Offset="0.8"/>
            <GradientStop Color="#8A8680" Offset="1"/>
        </LinearGradientBrush>

        <!-- 水平管道 -->
        <LinearGradientBrush x:Key="PipeHorizGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A8680" Offset="0"/>
            <GradientStop Color="#A4A098" Offset="0.15"/>
            <GradientStop Color="#C4C0B8" Offset="0.35"/>
            <GradientStop Color="#EEECEA" Offset="0.5"/>
            <GradientStop Color="#C4C0B8" Offset="0.65"/>
            <GradientStop Color="#A4A098" Offset="0.85"/>
            <GradientStop Color="#8A8680" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===========================================================
             统一深灰工业风按钮样式
             深灰渐变 + 金属描边 + 凸起高光
             =========================================================== -->

        <!-- 上/下箭头按钮 (绿色/红色图标 + 深灰底) -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBg" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#7A7A82" Offset="0"/>
                                        <GradientStop Color="#5A5A62" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="3" 
                                                      ShadowDepth="1.5" Direction="315"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="4" BorderBrush="#3A3A42" BorderThickness="0.8" Margin="0"/>
                            <!-- 顶部凸起高光(贴顶部1/3,用VerticalAlignment实现) -->
                            <Border CornerRadius="3" Margin="2,2,2,0" Height="6" VerticalAlignment="Top" 
                                    Background="White" Opacity="0.15"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#8A8A92" Offset="0"/>
                                            <GradientStop Color="#6A6A72" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#4A4A52" Offset="0"/>
                                            <GradientStop Color="#3A3A42" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SET 按钮 (深蓝LCD风格凸起) -->
        <Style x:Key="SetButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBg" CornerRadius="5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2A4A80" Offset="0"/>
                                        <GradientStop Color="#1A3060" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="4" 
                                                      ShadowDepth="2" Direction="315"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="5" BorderBrush="#0E2040" BorderThickness="1" Margin="0"/>
                            <!-- 顶部高光 -->
                            <Border CornerRadius="4" Margin="2,2,2,0" Height="12" VerticalAlignment="Top" 
                                    Background="White" Opacity="0.12"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#3A5A90" Offset="0"/>
                                            <GradientStop Color="#2A4070" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#152040" Offset="0"/>
                                            <GradientStop Color="#0A1530" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas Background="Transparent">

