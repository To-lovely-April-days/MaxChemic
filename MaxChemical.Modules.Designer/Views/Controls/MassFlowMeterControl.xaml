                Cursor="Hand" Click="OnIncreaseButtonClick"
                Panel.ZIndex="34">
            <Path Data="M0,6 L5,0 L10,6 Z" Fill="#27D070" Width="10" Height="6"/>
        </Button>
        <Button Canvas.Left="145" Canvas.Top="320" Width="26" Height="18"
                Style="{StaticResource SmallButtonStyle}" 
                Cursor="Hand" Click="OnDecreaseButtonClick"
                Panel.ZIndex="34">
            <Path Data="M0,0 L5,6 L10,0 Z" Fill="#E84040" Width="10" Height="6"/>
        </Button>

        <!-- === 分隔竖线 === -->
        <Line X1="189" Y1="292" X2="189" Y2="354" Stroke="#4070A0" StrokeThickness="0.8" 
              Opacity="0.4" Panel.ZIndex="33"/>

        <!-- === 分区2: CURRENT FLOW (右半, 只读) === -->
        <TextBlock Canvas.Left="199" Canvas.Top="288" Text="CURRENT" 
                   FontSize="9" FontWeight="Bold" Foreground="#8FB8E8" Opacity="0.85"
                   FontFamily="Arial, Segoe UI" Panel.ZIndex="33"/>
        <!-- Current数值(大字) -->
        <TextBlock x:Name="CurrentValueText" Canvas.Left="199" Canvas.Top="300" 
                   Width="110" TextAlignment="Left"
                   Text="0.0" 
                   FontSize="26" FontWeight="Bold" Foreground="#E8F4FF" 
                   FontFamily="Consolas, monospace" Panel.ZIndex="33"/>
        <TextBlock Canvas.Left="199" Canvas.Top="340" Text="g/min" 
                   FontSize="9" Foreground="#90B8D8"
                   FontFamily="Times New Roman" FontStyle="Italic" 
                   Panel.ZIndex="33"/>

        <!-- SET 按钮 (屏右侧内嵌) -->
        <Button Canvas.Left="315" Canvas.Top="310" Width="32" Height="36"
                Style="{StaticResource SetButtonStyle}" 
                Cursor="Hand" Click="OnSetButtonClick"
                Panel.ZIndex="34">
            <TextBlock Text="SET" FontSize="12" FontWeight="Bold" Foreground="#FFD860"/>
        </Button>

        <!-- 运行状态LED指示(屏右上角) -->
        <Ellipse Canvas.Left="337" Canvas.Top="290" Width="6" Height="6" 
                 Fill="#40E060" Opacity="0.9" Panel.ZIndex="33">
            <Ellipse.Effect>
                <BlurEffect Radius="2" RenderingBias="Performance"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Canvas.Left="337" Canvas.Top="290" Width="6" Height="6" 
                 Fill="#60FF80" Panel.ZIndex="34"/>

        <!-- ==========================================================
             兼容性隐藏元素 (保留 CurrentPointer/PointerRotation/DialInnerCircle)
             ========================================================== -->
        <Canvas Canvas.Left="-100" Canvas.Top="-100" Width="1" Height="1"
                Opacity="0" IsHitTestVisible="False" Panel.ZIndex="-10">
            <Path x:Name="CurrentPointer" Fill="#E74C3C"
                  Data="M 0,0 L 0,1 L 1,1 L 1,0 Z">
                <Path.RenderTransform>
                    <RotateTransform x:Name="PointerRotation" Angle="0" CenterX="0" CenterY="0"/>
                </Path.RenderTransform>
            </Path>
            <Ellipse x:Name="DialInnerCircle" Width="1" Height="1" Fill="Transparent"/>
        </Canvas>

        <!-- ==========================================================
             选中边框 + 旋转锚点
             ========================================================== -->
        <Rectangle x:Name="SelectionBorder" 
                   Canvas.Left="-2" Canvas.Top="-2" Width="404" Height="504"
                   Stroke="#FF9500" StrokeThickness="2.5" StrokeDashArray="4,2" 
                   Fill="Transparent" RadiusX="3" RadiusY="3" 
                   Visibility="Collapsed" Panel.ZIndex="200"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#FF9500" BlurRadius="8" ShadowDepth="0" Opacity="0.5"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <Ellipse x:Name="RotateAnchor"
                 Canvas.Left="184" Canvas.Top="-50"
                 Width="32" Height="32"
                 Fill="#9B59B6" Stroke="White" StrokeThickness="3"
                 Opacity="0" Cursor="Hand" Panel.ZIndex="210"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="5" Opacity="0.6"
                                  RenderingBias="Performance"/>
            </Ellipse.Effect>
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转流量计 (按住Shift=15度步进)" 
                         FontSize="16" FontWeight="Bold"
                         Background="#E4E4E8" Foreground="#2A2A32"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Line x:Name="RotateAnchorLine"
              X1="200" Y1="0" X2="200" Y2="-42"
              Stroke="#9B59B6" StrokeThickness="3" StrokeDashArray="4,3"
              Opacity="0" Panel.ZIndex="209"
              IsHitTestVisible="False"/>

        <Border x:Name="RotationLabel"
                Canvas.Left="155" Canvas.Top="-85"
                Background="#E62A2A32" CornerRadius="8" Padding="20,12"
                Visibility="Collapsed" Panel.ZIndex="211"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.7"
                                  RenderingBias="Performance"/>
            </Border.Effect>
            <TextBlock x:Name="RotationText"
                       Foreground="White" FontSize="26" FontWeight="Bold"
                       Text="0°" FontFamily="Segoe UI, Arial">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.9"
                                      RenderingBias="Performance"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

    </Canvas>
</UserControl>
