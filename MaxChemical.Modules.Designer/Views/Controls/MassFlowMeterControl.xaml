            <TextBlock x:Name="RotationText"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       Text="0°"
                       FontFamily="Segoe UI, Arial">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" 
                                      BlurRadius="3" 
                                      ShadowDepth="1" 
                                      Opacity="0.9"
                                      RenderingBias="Performance"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

    </Canvas>
</UserControl>