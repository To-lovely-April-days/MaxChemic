<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.MassFlowMeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" 
             d:DesignWidth="400"
             Width="400" Height="500"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False">

    <UserControl.Resources>
        <!-- 数据发光动画 -->
        <Storyboard x:Key="DataGlowAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ValueGlow"
                           Storyboard.TargetProperty="Opacity"
                           From="0.4" To="0.8" Duration="0:0:2"
                           AutoReverse="True"/>
        </Storyboard>

        <!-- 精细金属渐变 -->
        <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#59020202" Offset="0"/>
            <GradientStop Color="#1F020202" Offset="0.026"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.116"/>
            <GradientStop Color="#4DFFFFFF" Offset="0.498"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.888"/>
            <GradientStop Color="#1F020202" Offset="0.966"/>
            <GradientStop Color="#59020202" Offset="1"/>
        </LinearGradientBrush>

        <!-- 底座渐变 -->
        <LinearGradientBrush x:Key="BaseGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4DB8C5CC" Offset="0"/>
            <GradientStop Color="#66B8C5CC" Offset="0.3"/>
            <GradientStop Color="#99AAB8BF" Offset="0.6"/>
            <GradientStop Color="#B8C5CC" Offset="1"/>
        </LinearGradientBrush>

        <!-- 管道渐变 -->
        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A9AA5" Offset="0"/>
            <GradientStop Color="#B8C5CC" Offset="0.1"/>
            <GradientStop Color="#D4DDE2" Offset="0.25"/>
            <GradientStop Color="#F0F4F6" Offset="0.5"/>
            <GradientStop Color="#D4DDE2" Offset="0.75"/>
            <GradientStop Color="#B8C5CC" Offset="0.9"/>
            <GradientStop Color="#8A9AA5" Offset="1"/>
        </LinearGradientBrush>

        <!-- 仪表盘渐变 -->
        <RadialGradientBrush x:Key="DialGradient">
            <GradientStop Color="#FAFAFA" Offset="0"/>
            <GradientStop Color="#E8E8E8" Offset="0.7"/>
            <GradientStop Color="#D0D0D0" Offset="1"/>
        </RadialGradientBrush>

        <!-- 小型按钮样式 -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBg" CornerRadius="6" Background="White">
                                <Border.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                                    BlurRadius="6" ShadowDepth="2" Direction="315"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1.5" Margin="1"/>
                            <Border CornerRadius="4" Margin="3" Opacity="0.08">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EEF1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#F5FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#E8F0F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SET按钮样式 -->
        <Style x:Key="SetButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonBg" CornerRadius="8" Background="#FFFFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                            BlurRadius="8" ShadowDepth="3" Direction="315"/>
                                </Border.Effect>
                            </Border>
                            <Border CornerRadius="8" BorderBrush="White" BorderThickness="2" Margin="1" Opacity="0.5"/>
                            <Border CornerRadius="6" Margin="3" Opacity="0.08">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EEF1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#F5FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas Background="Transparent">
        <!-- 可拖拽区域 -->
        <Rectangle x:Name="DraggableArea"
                   Canvas.Left="0" Canvas.Top="0"
                   Width="400" Height="500"
                   Fill="Transparent"
                   Panel.ZIndex="0"
                   Cursor="SizeAll"
                   MouseLeftButtonDown="OnOverlayMouseDown"
                   MouseLeftButtonUp="OnOverlayMouseUp"
                   MouseMove="OnOverlayMouseMove"/>

        <!-- ===== 地面阴影 ===== -->
        <Ellipse Canvas.Left="100" Canvas.Top="492"
                 Width="200" Height="6" Opacity="0.15">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2A4A68" Offset="0"/>
                    <GradientStop Color="#2A4A68" Offset="0.6"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="6"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- ===== 底座矩形 ===== -->
        <Rectangle Canvas.Left="80" Canvas.Top="471" Width="240" Height="29" RadiusX="7" RadiusY="7"
                   Panel.ZIndex="1" Fill="{StaticResource BaseGradient}">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.2" BlurRadius="4" ShadowDepth="2" Direction="315"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 底座高光 -->
        <Rectangle Canvas.Left="82" Canvas.Top="473" Width="236" Height="8" RadiusX="6" RadiusY="6"
                   Opacity="0.25" Panel.ZIndex="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== 底座梯形 ===== -->
        <Polygon Points="120,445 280,445 300,471 100,471" Panel.ZIndex="1"
                 Fill="{StaticResource BaseGradient}">
            <Polygon.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
            </Polygon.Stroke>
            <Polygon.StrokeThickness>2.5</Polygon.StrokeThickness>
        </Polygon>

        <!-- ===== 主外壳背景 ===== -->
        <Rectangle Canvas.Left="30" Canvas.Top="0" Width="340" Height="445" RadiusX="12" RadiusY="12" 
                   Fill="#F0F4F6" Panel.ZIndex="3">
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.25" BlurRadius="12" ShadowDepth="5" Direction="315"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ===== 主外壳金属效果 ===== -->
        <Rectangle Canvas.Left="30" Canvas.Top="0" Width="340" Height="445" RadiusX="12" RadiusY="12" 
                   Fill="{StaticResource MetalBrush}" Panel.ZIndex="4">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
        </Rectangle>

        <!-- 外壳顶部高光 -->
        <Rectangle Canvas.Left="32" Canvas.Top="2" Width="336" Height="60" RadiusX="10" RadiusY="10"
                   Opacity="0.3" Panel.ZIndex="5">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#FAFCFD" Offset="0.4"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== 左侧进口管道 ===== -->
        <Rectangle Canvas.Left="-16" Canvas.Top="385" Width="102" Height="37" 
                   Fill="{StaticResource PipeGradient}" Panel.ZIndex="2">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.2"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="8" ShadowDepth="4" Direction="270"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 左侧管道高光 -->
        <Rectangle Canvas.Left="-14" Canvas.Top="387" Width="98" Height="15"
                   Opacity="0.5" Panel.ZIndex="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== 真实液体流动效果 ===== -->
        <Canvas x:Name="FluidFlowContainer" 
                Canvas.Left="-16" Canvas.Top="385" 
                Width="432" Height="37" 
                Panel.ZIndex="10" 
                ClipToBounds="True"  
                Visibility="Collapsed">

            <!-- 液体主体矩形 -->
            <Rectangle x:Name="FluidRectangle" Width="432" Height="37">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="FluidGradientBrush" StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="FluidGradientTransform" X="0"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#4D2E86C1" Offset="0"/>
                        <GradientStop Color="#803498DB" Offset="0.25"/>
                        <GradientStop Color="#CC5DADE2" Offset="0.5"/>
                        <GradientStop Color="#803498DB" Offset="0.75"/>
                        <GradientStop Color="#4D2E86C1" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 液体表面波动路径 -->
            <Path x:Name="WavePath1" 
                  Data="M -50,0 Q -25,3 0,0 T 50,0 T 100,0 T 150,0 T 200,0 T 250,0 T 300,0 T 350,0 T 400,0 T 450,0 T 500,0"
                  Stroke="#85C1F0" StrokeThickness="1.5" Canvas.Top="8" Opacity="0.6">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="WaveTransform1" X="0"/>
                </Path.RenderTransform>
            </Path>

            <Path x:Name="WavePath2"
                  Data="M -50,0 Q -25,-2 0,0 T 50,0 T 100,0 T 150,0 T 200,0 T 250,0 T 300,0 T 350,0 T 400,0 T 450,0 T 500,0"
                  Stroke="#AED6F1" StrokeThickness="1.2" Canvas.Top="28" Opacity="0.5">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="WaveTransform2" X="0"/>
                </Path.RenderTransform>
            </Path>

            <!-- 流动气泡 -->
            <Ellipse x:Name="Bubble1" Width="6" Height="6" Fill="White" Opacity="0.5" Canvas.Left="-10" Canvas.Top="20">
                <Ellipse.Effect>
                    <BlurEffect Radius="2"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Bubble2" Width="5" Height="5" Fill="White" Opacity="0.4" Canvas.Left="-10" Canvas.Top="24">
                <Ellipse.Effect>
                    <BlurEffect Radius="1.5"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Bubble3" Width="4" Height="4" Fill="White" Opacity="0.6" Canvas.Left="-10" Canvas.Top="16">
                <Ellipse.Effect>
                    <BlurEffect Radius="1"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Bubble4" Width="7" Height="7" Fill="White" Opacity="0.3" Canvas.Left="-10" Canvas.Top="22">
                <Ellipse.Effect>
                    <BlurEffect Radius="2.5"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse x:Name="Bubble5" Width="5" Height="5" Fill="White" Opacity="0.5" Canvas.Left="-10" Canvas.Top="18">
                <Ellipse.Effect>
                    <BlurEffect Radius="1.8"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- 高光反射 -->
            <Rectangle Width="432" Height="12" Canvas.Top="2" Opacity="0.3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 底部阴影 -->
            <Rectangle Width="432" Height="8" Canvas.Top="29" Opacity="0.2">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#1A2E4A" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Canvas>

        <!-- ===== 左侧进口管道接口 ===== -->
        <Rectangle Canvas.Left="-30" Canvas.Top="380" Width="14" Height="47" RadiusX="7" RadiusY="7" 
                   Fill="#C4CFD6" Stroke="#7A8A95" StrokeThickness="2.5" Panel.ZIndex="11">
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="6" ShadowDepth="3" Direction="180"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ===== 右侧出口管道 ===== -->
        <Rectangle Canvas.Left="314" Canvas.Top="385" Width="102" Height="37" 
                   Fill="{StaticResource PipeGradient}" Panel.ZIndex="2">
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.2"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="8" ShadowDepth="4" Direction="270"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 右侧管道高光 -->
        <Rectangle Canvas.Left="316" Canvas.Top="387" Width="98" Height="15"
                   Opacity="0.5" Panel.ZIndex="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== 右侧出口管道接口 ===== -->
        <Rectangle Canvas.Left="416" Canvas.Top="380" Width="14" Height="47" RadiusX="7" RadiusY="7" 
                   Fill="#C4CFD6" Stroke="#7A8A95" StrokeThickness="2.5" Panel.ZIndex="11">
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="6" ShadowDepth="3" Direction="0"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ===== 设定值显示区域 ===== -->
        <StackPanel Canvas.Left="90" Canvas.Top="20" Panel.ZIndex="10" HorizontalAlignment="Center">
            <TextBlock Text="SET POINT" FontSize="10" Foreground="#7F8C8D" FontWeight="Bold" 
                      HorizontalAlignment="Center" Margin="0,0,0,5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Width="35" Height="30" Margin="0,0,0,3"
                            Style="{StaticResource SmallButtonStyle}" 
                            Cursor="Hand"
                            Click="OnIncreaseButtonClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="1024" Height="1024">
                                <Path Data="M861.417121,738.727375 C903.021852,738.727375 926.650504,683.76358 896.345760,653.469157 L547.071415,304.191372 C527.041419,284.159656 497.249294,284.159656 477.217578,304.191372 L127.955275,653.469157 C96.869561,684.54283 122.818761,738.727375 163.396533,738.727375 L861.417121,738.727375 Z" 
                                      Fill="#27AE60"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button Width="35" Height="30"
                            Style="{StaticResource SmallButtonStyle}" 
                            Cursor="Hand"
                            Click="OnDecreaseButtonClick">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="1024" Height="1024">
                                <Path Data="M163.396533,289.168875 C122.818761,289.168875 96.871281,343.35342 127.955275,374.427093 L477.217578,723.704878 C497.249294,743.736594 527.041419,743.736594 547.073135,723.704878 L896.34748,374.427093 C926.652224,344.132670 903.025292,289.168875 861.419841,289.168875 L163.396533,289.168875 Z" 
                                      Fill="#E74C3C"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <Border CornerRadius="6" Background="White" 
                        BorderBrush="#BDC3C7" BorderThickness="2"
                        Padding="12,8" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#2A4A68" Opacity="0.15" BlurRadius="4" ShadowDepth="2" Direction="315"/>
                    </Border.Effect>
                    <TextBlock x:Name="TargetValueText" Text="125.0" 
                              FontSize="24" FontWeight="Bold" 
                              Foreground="#3498DB" 
                              TextAlignment="Center" 
                              FontFamily="Segoe UI, Arial"
                              MinWidth="90"/>
                </Border>

                <Button Width="50" Height="36"
                        Style="{StaticResource SetButtonStyle}" 
                        Cursor="Hand"
                        Click="OnSetButtonClick"
                        VerticalAlignment="Center">
                    <TextBlock Text="SET" FontSize="13" FontWeight="Bold" Foreground="#27AE60"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ===== 仪表盘区域 ===== -->
        <Canvas Canvas.Left="120" Canvas.Top="130" Panel.ZIndex="7">
            <Ellipse Width="160" Height="160" 
                    Fill="Transparent"
                    Stroke="#B0BCC3" StrokeThickness="4">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="10" ShadowDepth="5" Direction="315"/>
                </Ellipse.Effect>
            </Ellipse>

            <Ellipse Canvas.Left="5" Canvas.Top="5" Width="150" Height="150" 
                    Fill="{StaticResource DialGradient}"
                    Stroke="#999999" StrokeThickness="3"/>

            <Ellipse Canvas.Left="13" Canvas.Top="13" Width="134" Height="134" 
                    Fill="White"
                    Stroke="#DDDDDD" StrokeThickness="1.5"/>

            <Canvas Width="150" Height="150">
                <Line X1="20" Y1="75" X2="30" Y2="75" Stroke="#333333" StrokeThickness="2.5"/>
                <TextBlock Canvas.Left="2" Canvas.Top="68" Text="0" FontSize="13" FontWeight="Bold" Foreground="#333333"/>

                <Line X1="35" Y1="45" X2="43" Y2="52" Stroke="#666666" StrokeThickness="2"/>

                <Line X1="75" Y1="20" X2="75" Y2="30" Stroke="#333333" StrokeThickness="2.5"/>
                <TextBlock Canvas.Left="66" Canvas.Top="2" Text="50" FontSize="13" FontWeight="Bold" Foreground="#333333"/>

                <Line X1="115" Y1="45" X2="107" Y2="52" Stroke="#666666" StrokeThickness="2"/>

                <Line X1="130" Y1="75" X2="120" Y2="75" Stroke="#333333" StrokeThickness="2.5"/>
                <TextBlock Canvas.Left="133" Canvas.Top="68" Text="100" FontSize="13" FontWeight="Bold" Foreground="#333333"/>

                <Line X1="115" Y1="105" X2="107" Y2="98" Stroke="#666666" StrokeThickness="2"/>

                <Line X1="75" Y1="130" X2="75" Y2="120" Stroke="#333333" StrokeThickness="2.5"/>
                <TextBlock Canvas.Left="63" Canvas.Top="133" Text="150" FontSize="13" FontWeight="Bold" Foreground="#333333"/>

                <Line X1="35" Y1="105" X2="43" Y2="98" Stroke="#666666" StrokeThickness="2"/>
            </Canvas>

            <TextBlock Canvas.Left="62" Canvas.Top="60" Text="kg/h" FontSize="11" FontWeight="Bold" 
                      Foreground="#7F8C8D" HorizontalAlignment="Center"/>

            <Ellipse Canvas.Left="70" Canvas.Top="70" Width="10" Height="10" Fill="#34495E">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.3" BlurRadius="3" ShadowDepth="1"/>
                </Ellipse.Effect>
            </Ellipse>

            <Path x:Name="CurrentPointer" Fill="#E74C3C" Stroke="#C0392B" StrokeThickness="1"
                  Data="M 75,78 L 72,30 L 75,25 L 78,30 Z">
                <Path.RenderTransform>
                    <RotateTransform x:Name="PointerRotation" 
                                   Angle="0"
                                   CenterX="75" 
                                   CenterY="75"/>
                </Path.RenderTransform>
                <Path.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="4" ShadowDepth="2"/>
                </Path.Effect>
            </Path>

            <Ellipse Canvas.Left="72" Canvas.Top="72" Width="6" Height="6" Fill="#95A5A6"/>
        </Canvas>

        <!-- ===== 实时流量显示 ===== -->
        <StackPanel Canvas.Left="100" Canvas.Top="300" Width="200" Panel.ZIndex="8">
            <TextBlock Text="CURRENT FLOW" FontSize="10" Foreground="#7F8C8D" FontWeight="Bold" 
                      HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock x:Name="CurrentValueText" Text="0.0 kg/h" 
                      FontSize="22" FontWeight="Bold" 
                      Foreground="#1A1A1A"  
                      TextAlignment="Center" 
                      FontFamily="Segoe UI, Arial">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="ValueGlow" 
                                    Color="#555555" 
                                    Opacity="0.5" 
                                    BlurRadius="10" 
                                    ShadowDepth="0"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- ===== 装饰螺丝 ===== -->
        <Ellipse Canvas.Left="45" Canvas.Top="10" Width="8" Height="8"
                 Fill="#96A5AE" Stroke="#5A6870" StrokeThickness="0.5" Panel.ZIndex="11">
            <Ellipse.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="2" ShadowDepth="1" Direction="315"/>
            </Ellipse.Effect>
        </Ellipse>
        <Line X1="47" Y1="14" X2="51" Y2="14" Stroke="#5A6870" StrokeThickness="0.8" Panel.ZIndex="12"/>

        <Ellipse Canvas.Left="347" Canvas.Top="10" Width="8" Height="8"
                 Fill="#96A5AE" Stroke="#5A6870" StrokeThickness="0.5" Panel.ZIndex="11">
            <Ellipse.Effect>
                <DropShadowEffect Color="#2A4A68" Opacity="0.3" BlurRadius="2" ShadowDepth="1" Direction="315"/>
            </Ellipse.Effect>
        </Ellipse>
