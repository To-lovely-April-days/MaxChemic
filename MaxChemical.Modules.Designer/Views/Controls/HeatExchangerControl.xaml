<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.HeatExchangerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" 
             d:DesignWidth="280"
             Width="280" Height="420"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <UserControl.Resources>
        <!--  热交换脉动动画 -->
        <Storyboard x:Key="HeatExchangePulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="HeatCoreGlow"
                           Storyboard.TargetProperty="Opacity"
                           From="0.3" To="0.8" Duration="0:0:2"
                           AutoReverse="True"
                           Timeline.DesiredFrameRate="30"/>
        </Storyboard>

        <!--  温度指示器脉动 -->
        <Storyboard x:Key="TempIndicatorPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TempIndicator"
                           Storyboard.TargetProperty="Opacity"
                           From="0.5" To="1.0" Duration="0:0:1.5"
                           AutoReverse="True"
                           Timeline.DesiredFrameRate="30"/>
        </Storyboard>

        <!--  青铜金属质感 -->
        <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#593D2B1F" Offset="0"/>
            <GradientStop Color="#1F3D2B1F" Offset="0.03"/>
            <GradientStop Color="#1FFFEDE3" Offset="0.15"/>
            <GradientStop Color="#4DFFFAF5" Offset="0.5"/>
            <GradientStop Color="#1FFFEDE3" Offset="0.85"/>
            <GradientStop Color="#1F3D2B1F" Offset="0.97"/>
            <GradientStop Color="#593D2B1F" Offset="1"/>
        </LinearGradientBrush>

        <!--  主体渐变 -->
        <LinearGradientBrush x:Key="ShellGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6B4423" Offset="0"/>
            <GradientStop Color="#8B6F47" Offset="0.2"/>
            <GradientStop Color="#A0825A" Offset="0.35"/>
            <GradientStop Color="#C9A876" Offset="0.5"/>
            <GradientStop Color="#A0825A" Offset="0.65"/>
            <GradientStop Color="#8B6F47" Offset="0.8"/>
            <GradientStop Color="#6B4423" Offset="1"/>
        </LinearGradientBrush>

        <!--  顶盖渐变 -->
        <RadialGradientBrush x:Key="TopCapGradient" GradientOrigin="0.5,0.2" Center="0.5,0.5" RadiusX="0.9" RadiusY="1.3">
            <GradientStop Color="#E8D4B0" Offset="0"/>
            <GradientStop Color="#D4B896" Offset="0.25"/>
            <GradientStop Color="#C9A876" Offset="0.45"/>
            <GradientStop Color="#A0825A" Offset="0.7"/>
            <GradientStop Color="#8B6F47" Offset="0.88"/>
            <GradientStop Color="#6B4423" Offset="1"/>
        </RadialGradientBrush>

        <!--  管道渐变 -->
        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5D4037" Offset="0"/>
            <GradientStop Color="#6B4423" Offset="0.15"/>
            <GradientStop Color="#8B6F47" Offset="0.3"/>
            <GradientStop Color="#A0825A" Offset="0.5"/>
            <GradientStop Color="#8B6F47" Offset="0.7"/>
            <GradientStop Color="#6B4423" Offset="0.85"/>
            <GradientStop Color="#5D4037" Offset="1"/>
        </LinearGradientBrush>

        <!--  底座渐变 -->
        <LinearGradientBrush x:Key="BaseGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4D3E2723" Offset="0"/>
            <GradientStop Color="#664E342E" Offset="0.35"/>
            <GradientStop Color="#995D4037" Offset="0.65"/>
            <GradientStop Color="#4E342E" Offset="1"/>
        </LinearGradientBrush>

        <!-- 热流渐变 -->
        <LinearGradientBrush x:Key="HotFluidGradient" StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
            <GradientStop Color="#4DE74C3C" Offset="0"/>
            <GradientStop Color="#99E67E22" Offset="0.3"/>
            <GradientStop Color="#FFF39C12" Offset="0.5"/>
            <GradientStop Color="#99E67E22" Offset="0.7"/>
            <GradientStop Color="#4DE74C3C" Offset="1"/>
        </LinearGradientBrush>

        <!-- 冷流渐变 -->
        <LinearGradientBrush x:Key="ColdFluidGradient" StartPoint="0,0" EndPoint="1,0" SpreadMethod="Repeat">
            <GradientStop Color="#4D2E86C1" Offset="0"/>
            <GradientStop Color="#993498DB" Offset="0.3"/>
            <GradientStop Color="#FF5DADE2" Offset="0.5"/>
            <GradientStop Color="#993498DB" Offset="0.7"/>
            <GradientStop Color="#4D2E86C1" Offset="1"/>
        </LinearGradientBrush>

        <!--  热交换核心渐变 -->
        <RadialGradientBrush x:Key="HeatCoreGradient">
            <GradientStop Color="#FFFF9800" Offset="0"/>
            <GradientStop Color="#FFFF5722" Offset="0.4"/>
            <GradientStop Color="#99E67E22" Offset="0.7"/>
            <GradientStop Color="#4D2E86C1" Offset="1"/>
        </RadialGradientBrush>

        <!--  状态指示灯闪烁动画 -->
        <Storyboard x:Key="StatusLightPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="TempStatusLight"
                   Storyboard.TargetProperty="Opacity"
                   From="0.4" To="1.0" Duration="0:0:1.2"
                   AutoReverse="True"
                   Timeline.DesiredFrameRate="30"/>
            <DoubleAnimation Storyboard.TargetName="PressureStatusLight"
                   Storyboard.TargetProperty="Opacity"
                   From="0.4" To="1.0" Duration="0:0:1.5"
                   AutoReverse="True"
                   Timeline.DesiredFrameRate="30"/>
        </Storyboard>
    </UserControl.Resources>

    <Canvas Background="Transparent">
        <!--  可拖拽区域 -->
        <Rectangle x:Name="DraggableArea"
                   Canvas.Left="0" Canvas.Top="0"
                   Width="280" Height="420"
                   Fill="Transparent"
                   Panel.ZIndex="0"
                   Cursor="SizeAll"
                   MouseLeftButtonDown="OnOverlayMouseDown"
                   MouseLeftButtonUp="OnOverlayMouseUp"
                   MouseMove="OnOverlayMouseMove"/>

        <!--  地面阴影 -->
        <Ellipse Canvas.Left="50" Canvas.Top="413"
                 Width="180" Height="5" Opacity="0.3">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3E2723" Offset="0"/>
                    <GradientStop Color="#3E2723" Offset="0.7"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="4" RenderingBias="Performance"/>
            </Ellipse.Effect>
        </Ellipse>

        <!--  底座 -->
        <Rectangle Canvas.Left="45" Canvas.Top="397" Width="190" Height="23" RadiusX="6" RadiusY="6"
                   Panel.ZIndex="1" Fill="{StaticResource BaseGradient}"
                   Stroke="#3E2723" StrokeThickness="2">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="4" ShadowDepth="2" Direction="315"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 底座高光 -->
        <Rectangle Canvas.Left="47" Canvas.Top="399" Width="186" Height="6" RadiusX="5" RadiusY="5"
                   Opacity="0.25" Panel.ZIndex="2">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE4C4" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 底座支撑 -->
        <Polygon Points="75,377 205,377 220,397 60,397" Panel.ZIndex="1"
                 Fill="{StaticResource BaseGradient}" Stroke="#3E2723" StrokeThickness="2"/>

        <!-- ==========  换热器主体 ========== -->
        <Rectangle Canvas.Left="70" Canvas.Top="70" Width="140" Height="307" RadiusX="10" RadiusY="10" 
                   Fill="{StaticResource ShellGradient}" Panel.ZIndex="3">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="10" ShadowDepth="4" Direction="315"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 金属光泽 -->
        <Rectangle Canvas.Left="70" Canvas.Top="70" Width="140" Height="307" RadiusX="10" RadiusY="10" 
                   Fill="{StaticResource MetalBrush}" Panel.ZIndex="4"
                   Stroke="#4E342E" StrokeThickness="2"/>

        <!-- ==========  半球形顶盖 ========== -->
        <Path Panel.ZIndex="5" Fill="{StaticResource TopCapGradient}">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="70,70" IsClosed="True">
                        <LineSegment Point="70,60"/>
                        <QuadraticBezierSegment Point1="70,40" Point2="105,45"/>
                        <QuadraticBezierSegment Point1="140,32" Point2="175,45"/>
                        <QuadraticBezierSegment Point1="210,40" Point2="210,60"/>
                        <LineSegment Point="210,70"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.45" BlurRadius="8" ShadowDepth="3" Direction="315"/>
            </Path.Effect>
        </Path>

        <!-- 顶盖边框 -->
        <Path Panel.ZIndex="6" Fill="Transparent" Stroke="#4E342E" StrokeThickness="2">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="70,70" IsClosed="True">
                        <LineSegment Point="70,60"/>
                        <QuadraticBezierSegment Point1="70,40" Point2="105,45"/>
                        <QuadraticBezierSegment Point1="140,32" Point2="175,45"/>
                        <QuadraticBezierSegment Point1="210,40" Point2="210,60"/>
                        <LineSegment Point="210,70"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
        </Path>

        <!-- 顶盖高光 -->
        <Ellipse Canvas.Left="90" Canvas.Top="42" Width="80" Height="22" Opacity="0.5" Panel.ZIndex="7">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.4,0.3">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#FFFAF0" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ==========  换热核心可视化 ========== -->
        <!-- 核心容器裁剪区域 -->
        <Border Canvas.Left="75" Canvas.Top="110" Width="130" Height="220" 
                CornerRadius="8" ClipToBounds="True" Panel.ZIndex="8">

            <!-- 管束结构 -->
            <Canvas>
                <!-- 垂直管束（5根） -->
                <Rectangle Canvas.Left="15" Canvas.Top="0" Width="8" Height="220" Fill="#8B6F47" Opacity="0.4"/>
                <Rectangle Canvas.Left="35" Canvas.Top="0" Width="8" Height="220" Fill="#8B6F47" Opacity="0.4"/>
                <Rectangle Canvas.Left="55" Canvas.Top="0" Width="8" Height="220" Fill="#8B6F47" Opacity="0.4"/>
                <Rectangle Canvas.Left="75" Canvas.Top="0" Width="8" Height="220" Fill="#8B6F47" Opacity="0.4"/>
                <Rectangle Canvas.Left="95" Canvas.Top="0" Width="8" Height="220" Fill="#8B6F47" Opacity="0.4"/>

                <!-- 水平分隔板 -->
                <Rectangle Canvas.Left="0" Canvas.Top="73" Width="130" Height="3" Fill="#6B4423" Opacity="0.5"/>
                <Rectangle Canvas.Left="0" Canvas.Top="147" Width="130" Height="3" Fill="#6B4423" Opacity="0.5"/>

                <!--  热交换核心发光效果 -->
                <Rectangle x:Name="HeatCoreGlow" 
                          Canvas.Left="0" Canvas.Top="0" 
                          Width="130" Height="220" 
                          Fill="{StaticResource HeatCoreGradient}"
                          Opacity="0" 
                          Panel.ZIndex="10">
                    <Rectangle.Effect>
                        <BlurEffect Radius="25" RenderingBias="Performance"/>
                    </Rectangle.Effect>
                </Rectangle>

                <!--  热流动画容器（从上到下） -->
                <Canvas x:Name="HeatFlowContainer" 
                       Canvas.Left="0" Canvas.Top="0" 
                       Width="130" Height="220" 
                       ClipToBounds="True" 
                       Visibility="Collapsed"
                       Panel.ZIndex="9">

                    <!-- 热流粒子 -->
                    <Ellipse x:Name="HeatParticle1" Width="6" Height="6" Fill="#FFFF5722" Opacity="0.8" Canvas.Top="-10"/>
                    <Ellipse x:Name="HeatParticle2" Width="6" Height="6" Fill="#FFFF9800" Opacity="0.7" Canvas.Top="-30"/>
                    <Ellipse x:Name="HeatParticle3" Width="6" Height="6" Fill="#FFE67E22" Opacity="0.6" Canvas.Top="-50"/>
                    <Ellipse x:Name="HeatParticle4" Width="6" Height="6" Fill="#FFFF5722" Opacity="0.8" Canvas.Top="-70"/>
                    <Ellipse x:Name="HeatParticle5" Width="6" Height="6" Fill="#FFFF9800" Opacity="0.7" Canvas.Top="-90"/>
                </Canvas>

                <!--  冷流动画容器（从下到上） -->
                <Canvas x:Name="ColdFlowContainer" 
                       Canvas.Left="0" Canvas.Top="0" 
                       Width="130" Height="220" 
                       ClipToBounds="True" 
                       Visibility="Collapsed"
                       Panel.ZIndex="9">

                    <Ellipse x:Name="ColdParticle1" Width="5" Height="5" Fill="#FF2196F3" Opacity="0.7" Canvas.Top="230"/>
                    <Ellipse x:Name="ColdParticle2" Width="5" Height="5" Fill="#FF5DADE2" Opacity="0.6" Canvas.Top="250"/>
                    <Ellipse x:Name="ColdParticle3" Width="5" Height="5" Fill="#FF2E86C1" Opacity="0.5" Canvas.Top="270"/>
                    <Ellipse x:Name="ColdParticle4" Width="5" Height="5" Fill="#FF2196F3" Opacity="0.7" Canvas.Top="290"/>
                </Canvas>
            </Canvas>
        </Border>

        <!-- 主体高光 -->
        <Rectangle Canvas.Left="72" Canvas.Top="72" Width="136" Height="50" RadiusX="8" RadiusY="8"
                   Opacity="0.3" Panel.ZIndex="12">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFAF0" Offset="0"/>
                    <GradientStop Color="#FFF5E6" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ==========  管道系统（缩短） ========== -->

        <!-- ==========  热侧进口管道（带内部液体） ========== -->
        <Rectangle Canvas.Left="35" Canvas.Top="105" Width="35" Height="25" 
           Fill="{StaticResource PipeGradient}" Panel.ZIndex="2"
           Stroke="#4E342E" StrokeThickness="2">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="6" ShadowDepth="3" Direction="270"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 管道高光 -->
        <Rectangle Canvas.Left="37" Canvas.Top="107" Width="31" Height="10" Opacity="0.4" Panel.ZIndex="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE4C4" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  热液体流动层（在管道内） -->
        <Border Canvas.Left="37" Canvas.Top="110" 
        Width="31" Height="18"
        CornerRadius="2"
        ClipToBounds="True" 
        Panel.ZIndex="9"
        Background="Transparent">

            <Canvas x:Name="HotFluidFlowContainer" 
            Visibility="Collapsed">

                <!-- 液体基础层 -->
                <Rectangle Width="31" Height="18">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="HotFluidGradientBrush" 
                                   StartPoint="0,0.5" EndPoint="1,0.5" 
                                   SpreadMethod="Repeat">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="HotFluidGradientTransform" X="0"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#99E74C3C" Offset="0"/>
                            <GradientStop Color="#FFE67E22" Offset="0.2"/>
                            <GradientStop Color="#FFF39C12" Offset="0.4"/>
                            <GradientStop Color="#FFE67E22" Offset="0.6"/>
                            <GradientStop Color="#99E74C3C" Offset="0.8"/>
                            <GradientStop Color="#66D32F2F" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 液体表面波纹 -->
                <Path Data="M -5,0 Q 2,2 9,0 T 23,0 T 37,0 T 51,0"
              Stroke="#FFFFFFFF" 
              StrokeThickness="1.5" 
              Canvas.Top="3" 
              Opacity="0.7">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="HotWaveTransform1" X="0"/>
                    </Path.RenderTransform>
                    <Path.Effect>
                        <BlurEffect Radius="1"/>
                    </Path.Effect>
                </Path>

                <!-- 液体底部波纹 -->
                <Path Data="M -5,0 Q 2,-1.5 9,0 T 23,0 T 37,0 T 51,0"
              Stroke="#FFFFCC80" 
              StrokeThickness="1.2" 
              Canvas.Top="14" 
              Opacity="0.5">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="HotWaveTransform2" X="0"/>
                    </Path.RenderTransform>
                </Path>

                <!-- 热液体粒子 -->
                <Ellipse x:Name="HotFluidParticle1" 
                 Width="3" Height="3" 
                 Fill="#FFFFFF" 
                 Canvas.Top="4"
                 Opacity="0.9">
                    <Ellipse.Effect>
                        <BlurEffect Radius="2"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="HotFluidParticle2" 
                 Width="2.5" Height="2.5" 
                 Fill="#FFD54F" 
                 Canvas.Top="9"
                 Opacity="0.8">
                    <Ellipse.Effect>
                        <BlurEffect Radius="1.5"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="HotFluidParticle3" 
                 Width="3.5" Height="3.5" 
                 Fill="#FFFFFF" 
                 Canvas.Top="6"
                 Opacity="0.85">
                    <Ellipse.Effect>
                        <BlurEffect Radius="2"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="HotFluidParticle4" 
                 Width="2" Height="2" 
                 Fill="#FFAB40" 
                 Canvas.Top="12"
                 Opacity="0.7">
                    <Ellipse.Effect>
                        <BlurEffect Radius="1"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 液体高光层 -->
                <Rectangle Width="31" Height="6" Canvas.Top="0" Opacity="0.4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>
        </Border>

        <!-- 管道外接口 -->
        <Rectangle Canvas.Left="24" Canvas.Top="101" Width="11" Height="33" RadiusX="5.5" RadiusY="5.5" 
           Fill="{StaticResource PipeGradient}" 
           Stroke="#3E2723" StrokeThickness="2" Panel.ZIndex="11">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="4" ShadowDepth="2" Direction="180"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ==========  热侧出口管道（带内部液体） ========== -->
        <Rectangle Canvas.Left="210" Canvas.Top="105" Width="35" Height="25" 
           Fill="{StaticResource PipeGradient}" Panel.ZIndex="2"
           Stroke="#4E342E" StrokeThickness="2">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="6" ShadowDepth="3" Direction="270"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="212" Canvas.Top="107" Width="31" Height="10" Opacity="0.4" Panel.ZIndex="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE4C4" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  热液体流动层（出口） -->
        <Border Canvas.Left="212" Canvas.Top="110" 
        Width="31" Height="18"
        CornerRadius="2"
        ClipToBounds="True" 
        Panel.ZIndex="9"
        Background="Transparent">

            <Canvas x:Name="HotFluidOutletContainer" 
            Visibility="Collapsed">

                <!-- 液体基础层（温度降低后的颜色） -->
                <Rectangle Width="31" Height="18">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" SpreadMethod="Repeat">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="HotOutletGradientTransform" X="0"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#99D84315" Offset="0"/>
                            <GradientStop Color="#FFCA6F1E" Offset="0.2"/>
                            <GradientStop Color="#FFE67E22" Offset="0.4"/>
                            <GradientStop Color="#FFCA6F1E" Offset="0.6"/>
                            <GradientStop Color="#99D84315" Offset="0.8"/>
                            <GradientStop Color="#66BF360C" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Path Data="M -5,0 Q 2,2 9,0 T 23,0 T 37,0 T 51,0"
              Stroke="#FFFFEDD3" StrokeThickness="1.5" Canvas.Top="3" Opacity="0.6">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="HotOutletWaveTransform" X="0"/>
                    </Path.RenderTransform>
                </Path>

                <Rectangle Width="31" Height="6" Canvas.Top="0" Opacity="0.35">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>
        </Border>

        <Rectangle Canvas.Left="243" Canvas.Top="101" Width="11" Height="33" RadiusX="5.5" RadiusY="5.5" 
           Fill="{StaticResource PipeGradient}" 
           Stroke="#3E2723" StrokeThickness="2" Panel.ZIndex="11">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="4" ShadowDepth="2" Direction="0"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ==========  冷侧进口管道（带内部液体） ========== -->
        <Rectangle Canvas.Left="35" Canvas.Top="310" Width="35" Height="25" 
           Fill="{StaticResource PipeGradient}" Panel.ZIndex="2"
           Stroke="#4E342E" StrokeThickness="2">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="6" ShadowDepth="3" Direction="270"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="37" Canvas.Top="312" Width="31" Height="10" Opacity="0.4" Panel.ZIndex="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE4C4" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  冷液体流动层（在管道内） -->
        <Border Canvas.Left="37" Canvas.Top="315" 
        Width="31" Height="18"
        CornerRadius="2"
        ClipToBounds="True" 
        Panel.ZIndex="9"
        Background="Transparent">

            <Canvas x:Name="ColdFluidFlowContainer" 
            Visibility="Collapsed">

                <!-- 液体基础层 -->
                <Rectangle Width="31" Height="18">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="ColdFluidGradientBrush" 
                                   StartPoint="0,0.5" EndPoint="1,0.5" 
                                   SpreadMethod="Repeat">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="ColdFluidGradientTransform" X="0"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#991976D2" Offset="0"/>
                            <GradientStop Color="#FF2196F3" Offset="0.2"/>
                            <GradientStop Color="#FF42A5F5" Offset="0.4"/>
                            <GradientStop Color="#FF2196F3" Offset="0.6"/>
                            <GradientStop Color="#991976D2" Offset="0.8"/>
                            <GradientStop Color="#661565C0" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 液体表面波纹 -->
                <Path Data="M -5,0 Q 2,2 9,0 T 23,0 T 37,0 T 51,0"
              Stroke="#FFFFFFFF" 
              StrokeThickness="1.5" 
              Canvas.Top="3" 
              Opacity="0.7">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="ColdWaveTransform1" X="0"/>
                    </Path.RenderTransform>
                    <Path.Effect>
                        <BlurEffect Radius="1"/>
                    </Path.Effect>
                </Path>

                <!-- 液体底部波纹 -->
                <Path Data="M -5,0 Q 2,-1.5 9,0 T 23,0 T 37,0 T 51,0"
              Stroke="#FFBBDEFB" 
              StrokeThickness="1.2" 
              Canvas.Top="14" 
              Opacity="0.5">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="ColdWaveTransform2" X="0"/>
                    </Path.RenderTransform>
                </Path>

                <!-- 冷液体粒子 -->
                <Ellipse x:Name="ColdFluidParticle1" 
                 Width="3" Height="3" 
                 Fill="#FFFFFF" 
                 Canvas.Top="4"
                 Opacity="0.9">
                    <Ellipse.Effect>
                        <BlurEffect Radius="2"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="ColdFluidParticle2" 
                 Width="2.5" Height="2.5" 
                 Fill="#90CAF9" 
                 Canvas.Top="9"
                 Opacity="0.8">
                    <Ellipse.Effect>
                        <BlurEffect Radius="1.5"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="ColdFluidParticle3" 
                 Width="3.5" Height="3.5" 
                 Fill="#FFFFFF" 
                 Canvas.Top="6"
                 Opacity="0.85">
                    <Ellipse.Effect>
                        <BlurEffect Radius="2"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="ColdFluidParticle4" 
                 Width="2" Height="2" 
                 Fill="#64B5F6" 
                 Canvas.Top="12"
                 Opacity="0.7">
                    <Ellipse.Effect>
                        <BlurEffect Radius="1"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- 液体高光层 -->
                <Rectangle Width="31" Height="6" Canvas.Top="0" Opacity="0.4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>
        </Border>

        <Rectangle Canvas.Left="24" Canvas.Top="306" Width="11" Height="33" RadiusX="5.5" RadiusY="5.5" 
           Fill="{StaticResource PipeGradient}" 
           Stroke="#3E2723" StrokeThickness="2" Panel.ZIndex="11">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="4" ShadowDepth="2" Direction="180"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ==========  冷侧出口管道（带内部液体） ========== -->
        <Rectangle Canvas.Left="210" Canvas.Top="310" Width="35" Height="25" 
           Fill="{StaticResource PipeGradient}" Panel.ZIndex="2"
           Stroke="#4E342E" StrokeThickness="2">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="6" ShadowDepth="3" Direction="270"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="212" Canvas.Top="312" Width="31" Height="10" Opacity="0.4" Panel.ZIndex="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFE4C4" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  冷液体流动层（出口，温度升高后） -->
        <Border Canvas.Left="212" Canvas.Top="315" 
        Width="31" Height="18"
        CornerRadius="2"
        ClipToBounds="True" 
        Panel.ZIndex="9"
        Background="Transparent">

            <Canvas x:Name="ColdFluidOutletContainer" 
            Visibility="Collapsed">

                <!-- 液体基础层（温度升高后的颜色） -->
                <Rectangle Width="31" Height="18">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5" SpreadMethod="Repeat">
                            <LinearGradientBrush.RelativeTransform>
                                <TranslateTransform x:Name="ColdOutletGradientTransform" X="0"/>
                            </LinearGradientBrush.RelativeTransform>
                            <GradientStop Color="#992E86C1" Offset="0"/>
                            <GradientStop Color="#FF42A5F5" Offset="0.2"/>
                            <GradientStop Color="#FF64B5F6" Offset="0.4"/>
                            <GradientStop Color="#FF42A5F5" Offset="0.6"/>
                            <GradientStop Color="#992E86C1" Offset="0.8"/>
                            <GradientStop Color="#661E88E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Path Data="M -5,0 Q 2,2 9,0 T 23,0 T 37,0 T 51,0"
              Stroke="#FFE3F2FD" StrokeThickness="1.5" Canvas.Top="3" Opacity="0.6">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="ColdOutletWaveTransform" X="0"/>
                    </Path.RenderTransform>
                </Path>

                <Rectangle Width="31" Height="6" Canvas.Top="0" Opacity="0.35">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>
        </Border>

        <Rectangle Canvas.Left="243" Canvas.Top="306" Width="11" Height="33" RadiusX="5.5" RadiusY="5.5" 
           Fill="{StaticResource PipeGradient}" 
           Stroke="#3E2723" StrokeThickness="2" Panel.ZIndex="11">
            <Rectangle.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="4" ShadowDepth="2" Direction="0"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ==========  温度压力显示（极简高对比版） ========== -->

        <!-- 温度显示 -->
        <Border Canvas.Left="75" Canvas.Top="155" Panel.ZIndex="15"
        Width="130" Height="60"
        CornerRadius="6" 
        Background="#E6000000"
        BorderBrush="#FFB74D" 
        BorderThickness="2.5">
            <Border.Effect>
                <DropShadowEffect Color="#FF5722" Opacity="0.7" BlurRadius="12" ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" 
                   Text="温度" 
                   FontSize="11" 
                   Foreground="#FFB74D" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" Opacity="1" BlurRadius="2" ShadowDepth="1"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- 数值区域 -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 温度数值 -->
                    <TextBlock x:Name="TemperatureText" 
                      Grid.Column="0"
                      Text="85.0" 
                      FontSize="32" 
                      FontWeight="Black" 
                      Foreground="#FF5722"
                      TextAlignment="Right" 
                      FontFamily="Consolas"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0">
                        <TextBlock.Effect>
                            <DropShadowEffect x:Name="TempIndicator" 
                                    Color="#FF5722" 
                                    Opacity="0.9" 
                                    BlurRadius="16" 
                                    ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- 单位 -->
                    <TextBlock Grid.Column="1" 
                       Text="°C" 
                       FontSize="16" 
                       FontWeight="Bold"
                       Foreground="#FF8A65"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,4">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.8" BlurRadius="2" ShadowDepth="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- 压力显示 -->
        <Border Canvas.Left="75" Canvas.Top="230" Panel.ZIndex="15"
        Width="130" Height="60"
        CornerRadius="6" 
        Background="#E6000000"
        BorderBrush="#42A5F5" 
        BorderThickness="2.5">
            <Border.Effect>
                <DropShadowEffect Color="#2196F3" Opacity="0.7" BlurRadius="12" ShadowDepth="0"/>
            </Border.Effect>

            <Grid Margin="8,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" 
                   Text="压力" 
                   FontSize="11" 
                   Foreground="#42A5F5" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" Opacity="1" BlurRadius="2" ShadowDepth="1"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- 数值区域 -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 压力数值 -->
                    <TextBlock x:Name="PressureText" 
                      Grid.Column="0"
                      Text="2.5" 
                      FontSize="32" 
                      FontWeight="Black" 
                      Foreground="#2196F3"
                      TextAlignment="Right" 
                      FontFamily="Consolas"
                      VerticalAlignment="Center"
                      Margin="0,0,6,0">
                        <TextBlock.Effect>
                            <DropShadowEffect x:Name="PressureIndicator" 
                                    Color="#2196F3" 
                                    Opacity="0.9" 
                                    BlurRadius="16" 
                                    ShadowDepth="0"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- 单位 -->
                    <TextBlock Grid.Column="1" 
                       Text="MPa" 
                       FontSize="13" 
                       FontWeight="Bold"
                       Foreground="#64B5F6"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,4">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.8" BlurRadius="2" ShadowDepth="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!--  装饰螺丝 -->
        <Ellipse Canvas.Left="80" Canvas.Top="80" Width="6" Height="6"
                 Fill="#8B6F47" Stroke="#4E342E" StrokeThickness="0.5" Panel.ZIndex="16">
            <Ellipse.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="2" ShadowDepth="1" Direction="315"/>
            </Ellipse.Effect>
        </Ellipse>
        <Line Canvas.Left="82" Canvas.Top="83" X1="0" Y1="0" X2="2" Y2="0" 
              Stroke="#4E342E" StrokeThickness="0.6" Panel.ZIndex="17"/>

        <Ellipse Canvas.Left="194" Canvas.Top="80" Width="6" Height="6"
                 Fill="#8B6F47" Stroke="#4E342E" StrokeThickness="0.5" Panel.ZIndex="16">
            <Ellipse.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="2" ShadowDepth="1" Direction="315"/>
            </Ellipse.Effect>
        </Ellipse>
        <Line Canvas.Left="196" Canvas.Top="83" X1="0" Y1="0" X2="2" Y2="0" 
              Stroke="#4E342E" StrokeThickness="0.6" Panel.ZIndex="17"/>

        <Ellipse Canvas.Left="80" Canvas.Top="364" Width="6" Height="6"
                 Fill="#8B6F47" Stroke="#4E342E" StrokeThickness="0.5" Panel.ZIndex="16">
            <Ellipse.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="2" ShadowDepth="1" Direction="315"/>
            </Ellipse.Effect>
        </Ellipse>
        <Line Canvas.Left="82" Canvas.Top="367" X1="0" Y1="0" X2="2" Y2="0" 
              Stroke="#4E342E" StrokeThickness="0.6" Panel.ZIndex="17"/>

        <Ellipse Canvas.Left="194" Canvas.Top="364" Width="6" Height="6"
                 Fill="#8B6F47" Stroke="#4E342E" StrokeThickness="0.5" Panel.ZIndex="16">
            <Ellipse.Effect>
                <DropShadowEffect Color="#3E2723" Opacity="0.4" BlurRadius="2" ShadowDepth="1" Direction="315"/>
            </Ellipse.Effect>
        </Ellipse>
        <Line Canvas.Left="196" Canvas.Top="367" X1="0" Y1="0" X2="2" Y2="0" 
              Stroke="#4E342E" StrokeThickness="0.6" Panel.ZIndex="17"/>

        <!--  选中边框 -->
        <Rectangle x:Name="SelectionBorder" 
                   Canvas.Left="-2" Canvas.Top="-2"
                   Width="284" Height="424"
                   Stroke="#FF9500" 
                   StrokeThickness="2.5" 
                   StrokeDashArray="4,2" 
                   Fill="Transparent" 
                   RadiusX="3" RadiusY="3" 
                   Visibility="Collapsed"
                   Panel.ZIndex="110"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#FF9500" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
            </Rectangle.Effect>
        </Rectangle>

        <!--  旋转锚点 -->
        <Ellipse x:Name="RotateAnchor"
                 Canvas.Left="124"
                 Canvas.Top="-40"
                 Width="32" Height="32"
                 Fill="#9B59B6"
                 Stroke="White"
                 StrokeThickness="3"
                 Opacity="0"
                 Cursor="Hand"
                 Panel.ZIndex="200">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="5" Opacity="0.6"/>
            </Ellipse.Effect>
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转换热器 (按住Shift=15°步进)" 
                         FontSize="14" FontWeight="Bold"
                         Background="#FFFAF0" Foreground="#6D4C41"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Line x:Name="RotateAnchorLine"
              X1="140" Y1="35" X2="140" Y2="-32"
              Stroke="#9B59B6" StrokeThickness="3" StrokeDashArray="4,3"
              Opacity="0" Panel.ZIndex="199" IsHitTestVisible="False"/>

        <Border x:Name="RotationLabel"
                Canvas.Left="105" Canvas.Top="-75"
                Background="Black" CornerRadius="8" Padding="16,10"
                Visibility="Collapsed" Panel.ZIndex="201" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.7"/>
            </Border.Effect>
            <TextBlock x:Name="RotationText"
                       Foreground="White" FontSize="22" FontWeight="Bold"
                       Text="0°" FontFamily="Consolas">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

    </Canvas>
</UserControl>