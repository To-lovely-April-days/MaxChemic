<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.StraightPipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="45"
             Cursor="SizeAll"
             ClipToBounds="False">

    <!-- 不设 Background（=null）：空白区域不捕获鼠标，点击穿透到下方
         命中测试仅作用于实际有 Fill 的子元素（管道本体、法兰） -->
    <Canvas x:Name="PipeCanvas" ClipToBounds="False">

        <!-- ═══════════════ 左侧法兰组 ═══════════════ -->
        <Canvas x:Name="LeftFlangeGroup" Canvas.Left="0.35" Canvas.Top="11.9">
            <Rectangle x:Name="LeftFlangeBase"
                       Width="2.54" Height="22.4"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeGradient"
                       Width="2.54" Height="22.4"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeBorder"
                       Width="2.54" Height="22.4"
                       StrokeThickness="0.7"
                       Fill="Transparent"
                       RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 管道白色底层（产生高光） ═══════════════ -->
        <Rectangle x:Name="PipeBackground"
                   Canvas.Left="3.2" Canvas.Top="14.8"
                   Width="85.9" Height="16.6"
                   Fill="White"/>

        <!-- ═══════════════ 流体背景层（纯色填充） ═══════════════ -->
        <Rectangle x:Name="FluidBackground"
                   Canvas.Left="3.2" Canvas.Top="14.8"
                   Width="85.9" Height="16.6"
                   Visibility="Collapsed"/>

        <!-- ═══════════════ 流体气泡纹理层（可动画） ═══════════════ -->
        <Rectangle x:Name="FluidPattern"
                   Canvas.Left="3.2" Canvas.Top="14.8"
                   Width="85.9" Height="16.6"
                   Visibility="Collapsed"/>

        <!-- ═══════════════ 管道圆柱渐变层（3D立体效果） ═══════════════ -->
        <Rectangle x:Name="MainPipe"
                   Canvas.Left="3.2" Canvas.Top="14.8"
                   Width="85.9" Height="16.6"/>
        <!-- ═══════════════ 赛博层：金属管壁 ═══════════════ -->
        <!-- 多层渐变模拟金属质感（参考图：暗-中-亮-中-暗 5stop） -->
        <Rectangle x:Name="CyberMetalPipe"
           Canvas.Left="3.2" Canvas.Top="14.8"
           Width="85.9" Height="16.6"
           Visibility="Collapsed"
           IsHitTestVisible="False"/>

        <!-- ═══════════════ 赛博层：内部暗腔 ═══════════════ -->
        <!-- 黑色实心，模拟管道内部空腔 -->
        <Rectangle x:Name="CyberDarkCore"
           Canvas.Left="3.2" Canvas.Top="14.8"
           Width="85.9" Height="16.6"
           Fill="#000814"
           Opacity="0.85"
           Visibility="Collapsed"
           IsHitTestVisible="False"/>

        <!-- ═══════════════ 赛博层：主流光带（dasharray 30 570） ═══════════════ -->
        <!-- 用 Path 包装一条线，让 StrokeDashArray 流光效果可用 -->
        <Path x:Name="CyberMainStream"
      Visibility="Collapsed"
      IsHitTestVisible="False"
      StrokeStartLineCap="Flat"
      StrokeEndLineCap="Flat">
            <Path.Effect>
                <BlurEffect Radius="3" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- ═══════════════ 赛博层：粒子流（dasharray 8 50，更细更亮） ═══════════════ -->
        <Path x:Name="CyberParticleStream"
      Visibility="Collapsed"
      IsHitTestVisible="False"
      StrokeStartLineCap="Round"
      StrokeEndLineCap="Round">
            <Path.Effect>
                <BlurEffect Radius="2" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- ═══════════════ 赛博层：白热闪点（dasharray 4 80，最快） ═══════════════ -->
        <Path x:Name="CyberSparkStream"
      Visibility="Collapsed"
      IsHitTestVisible="False"
      StrokeStartLineCap="Round"
      StrokeEndLineCap="Round"
      Stroke="#FFFFFF">
            <Path.Effect>
                <BlurEffect Radius="1.5" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- ═══════════════ 赛博层：顶部高光带（静态，不动） ═══════════════ -->
        <!-- 模拟金属圆柱顶部反光，stroke linecap = round 端口圆 -->
        <Rectangle x:Name="CyberTopShine"
           Canvas.Left="3.2" Canvas.Top="14.8"
           Width="85.9" Height="16.6"
           Opacity="0.4"
           Visibility="Collapsed"
           IsHitTestVisible="False"/>
        <!-- ═══════════════ 管道顶部边缘线 ═══════════════ -->
        <Line x:Name="TopEdgeLine"
              X1="3.58" Y1="15.12" X2="89.18" Y2="15.12"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 管道底部边缘线 ═══════════════ -->
        <Line x:Name="BottomEdgeLine"
              X1="3.58" Y1="31.06" X2="89.18" Y2="31.06"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 右侧法兰组 ═══════════════ -->
        <Canvas x:Name="RightFlangeGroup" Canvas.Left="89.4" Canvas.Top="11.9">
            <Rectangle x:Name="RightFlangeBase"
                       Width="2.54" Height="22.4"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeGradient"
                       Width="2.54" Height="22.4"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeBorder"
                       Width="2.54" Height="22.4"
                       StrokeThickness="0.7"
                       Fill="Transparent"
                       RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 选中高亮边框 ═══════════════ -->
        <Rectangle x:Name="SelectionBorder"
           Width="85.9" Height="16.6"
           Stroke="#378ADD" StrokeThickness="1.25"
           Fill="Transparent"
           RadiusX="2" RadiusY="2"
           IsHitTestVisible="False"
           Visibility="Collapsed"/>

        <Ellipse x:Name="LeftAnchor"
         Width="12" Height="12"
         Fill="Orange" Stroke="White" StrokeThickness="2"
         Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="RightAnchor"
         Width="12" Height="12"
         Fill="Orange" Stroke="White" StrokeThickness="2"
         Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="TopAnchor"
         Width="12" Height="12"
         Fill="Orange" Stroke="White" StrokeThickness="2"
         Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="BottomAnchor"
         Width="12" Height="12"
         Fill="Orange" Stroke="White" StrokeThickness="2"
         Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="RotateAnchor"
         Width="12" Height="12"
         Fill="#4CAF50" Stroke="White" StrokeThickness="2"
         Opacity="0" Cursor="Hand">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Line x:Name="RotateAnchorLine"
      Stroke="Orange" StrokeThickness="1"
      StrokeDashArray="2,2" Opacity="0"/>

        <Border x:Name="RotationLabel"
        Background="#CC000000" CornerRadius="3" Padding="5,2"
        Visibility="Collapsed">
            <TextBlock x:Name="RotationText"
               Foreground="White" FontSize="11" Text="0°"/>
        </Border>
    </Canvas>
</UserControl>