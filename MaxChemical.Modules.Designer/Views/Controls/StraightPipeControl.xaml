<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.StraightPipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="100" Height="45"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False">

    <Canvas x:Name="PipeCanvas" Background="Transparent" ClipToBounds="False">

        <!-- ═══════════════ 左侧法兰组 ═══════════════ -->
        <Canvas x:Name="LeftFlangeGroup" Canvas.Left="0.35" Canvas.Top="11.9">
            <Rectangle x:Name="LeftFlangeBase"
                       Width="2.54" Height="22.4"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeGradient"
                       Width="2.54" Height="22.4"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeBorder"
                       Width="2.54" Height="22.4"
                       StrokeThickness="0.7"
                       Fill="Transparent"
                       RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 管道白色底层（产生高光） ═══════════════ -->
        <Rectangle x:Name="PipeBackground"
                   Canvas.Left="3.2" Canvas.Top="14.8"
                   Width="85.9" Height="16.6"
                   Fill="White"/>

        <!-- ═══════════════ 流体背景层（纯色填充） ═══════════════ -->
        <Rectangle x:Name="FluidBackground"
                   Canvas.Left="3.2" Canvas.Top="14.8"
                   Width="85.9" Height="16.6"
                   Visibility="Collapsed"/>

        <!-- ═══════════════ 流体气泡纹理层（可动画） ═══════════════ -->
        <Rectangle x:Name="FluidPattern"
                   Canvas.Left="3.2" Canvas.Top="14.8"
                   Width="85.9" Height="16.6"
                   Visibility="Collapsed"/>

        <!-- ═══════════════ 管道圆柱渐变层（3D立体效果） ═══════════════ -->
        <Rectangle x:Name="MainPipe"
                   Canvas.Left="3.2" Canvas.Top="14.8"
                   Width="85.9" Height="16.6"/>

        <!-- ═══════════════ 管道顶部边缘线 ═══════════════ -->
        <Line x:Name="TopEdgeLine"
              X1="3.58" Y1="15.12" X2="89.18" Y2="15.12"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 管道底部边缘线 ═══════════════ -->
        <Line x:Name="BottomEdgeLine"
              X1="3.58" Y1="31.06" X2="89.18" Y2="31.06"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 右侧法兰组 ═══════════════ -->
        <Canvas x:Name="RightFlangeGroup" Canvas.Left="89.4" Canvas.Top="11.9">
            <Rectangle x:Name="RightFlangeBase"
                       Width="2.54" Height="22.4"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeGradient"
                       Width="2.54" Height="22.4"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeBorder"
                       Width="2.54" Height="22.4"
                       StrokeThickness="0.7"
                       Fill="Transparent"
                       RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 选中高亮边框 ═══════════════ -->
        <Rectangle x:Name="SelectionBorder"
                   Canvas.Left="1" Canvas.Top="13"
                   Width="90" Height="20"
                   Stroke="#FF9500" StrokeThickness="2"
                   Fill="Transparent"
                   RadiusX="3" RadiusY="3"
                   Visibility="Collapsed">
            <Rectangle.Effect>
                <DropShadowEffect Color="Orange" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ═══════════════ 左侧锚点 ═══════════════ -->
        <Ellipse x:Name="LeftAnchor"
                 Canvas.Left="-6" Canvas.Top="16.5"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- ═══════════════ 右侧锚点 ═══════════════ -->
        <Ellipse x:Name="RightAnchor"
                 Canvas.Left="94" Canvas.Top="16.5"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- ═══════════════ 上侧锚点 ═══════════════ -->
        <Ellipse x:Name="TopAnchor"
                 Canvas.Left="44" Canvas.Top="4"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- ═══════════════ 下侧锚点 ═══════════════ -->
        <Ellipse x:Name="BottomAnchor"
                 Canvas.Left="44" Canvas.Top="30"
                 Width="12" Height="12"
                 Fill="Orange" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- ═══════════════ 旋转锚点 ═══════════════ -->
        <Ellipse x:Name="RotateAnchor"
                 Canvas.Left="44" Canvas.Top="-30"
                 Width="12" Height="12"
                 Fill="#4CAF50" Stroke="White" StrokeThickness="2"
                 Opacity="0" Cursor="Hand">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- ═══════════════ 旋转辅助线 ═══════════════ -->
        <Line x:Name="RotateAnchorLine"
              X1="50" Y1="0" X2="50" Y2="-24"
              Stroke="Orange" StrokeThickness="1"
              StrokeDashArray="2,2" Opacity="0"/>

        <!-- ═══════════════ 旋转角度标签 ═══════════════ -->
        <Border x:Name="RotationLabel"
                Canvas.Left="34" Canvas.Top="-50"
                Background="#CC000000" CornerRadius="3" Padding="5,2"
                Visibility="Collapsed">
            <TextBlock x:Name="RotationText"
                       Foreground="White" FontSize="11" Text="0°"/>
        </Border>

    </Canvas>
</UserControl>