<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.TemperatureControlSystemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" 
             d:DesignWidth="270"
             Background="Transparent"
             Cursor="SizeAll"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 白色面板渐变 -->
        <LinearGradientBrush x:Key="WhitePanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="1"/>
        </LinearGradientBrush>

        <!-- 侧面渐变 -->
        <LinearGradientBrush x:Key="SideGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E9ECEF" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="0.5"/>
            <GradientStop Color="#DEE2E6" Offset="1"/>
        </LinearGradientBrush>

        <!-- 顶部渐变 -->
        <LinearGradientBrush x:Key="TopGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F1F3F5" Offset="1"/>
        </LinearGradientBrush>

        <!-- 底座渐变 -->
        <LinearGradientBrush x:Key="BaseGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#495057" Offset="0"/>
            <GradientStop Color="#343A40" Offset="1"/>
        </LinearGradientBrush>

        <!-- 屏幕背景渐变 -->
        <LinearGradientBrush x:Key="ScreenBgGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A252F" Offset="0"/>
            <GradientStop Color="#0D1419" Offset="1"/>
        </LinearGradientBrush>

        <!-- 显示卡片渐变 -->
        <LinearGradientBrush x:Key="DisplayCardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#212B36" Offset="0"/>
            <GradientStop Color="#151E27" Offset="1"/>
        </LinearGradientBrush>

        <!-- 通风窗渐变 -->
        <LinearGradientBrush x:Key="VentPanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#E8E8E8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="VentSlotGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#BFBFBF" Offset="0"/>
            <GradientStop Color="#8C8C8C" Offset="1"/>
        </LinearGradientBrush>

        <!-- 按钮渐变 -->
        <LinearGradientBrush x:Key="GreenBtnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#52C41A" Offset="0"/>
            <GradientStop Color="#3FA013" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="OrangeBtnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FA8C16" Offset="0"/>
            <GradientStop Color="#D87010" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BlueBtnGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A90E2" Offset="0"/>
            <GradientStop Color="#357ABD" Offset="1"/>
        </LinearGradientBrush>

        <!-- 控制按钮样式 -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BtnBorder" CornerRadius="5" 
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="1.5" BorderBrush="#30FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="2" Opacity="0.2"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="HoverGlow" CornerRadius="5" Background="#15FFFFFF" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverGlow" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 调节按钮样式 -->
        <Style x:Key="AdjustButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="6" Background="#2A3B4A">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="2" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#364A5F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Fill">
        <Canvas Width="270" Height="420">

            <!-- 可拖拽区域 -->
            <Border x:Name="DraggableArea"
                    Canvas.Left="0" Canvas.Top="0"
                    Width="270" Height="420"
                    Background="Transparent"
                    Panel.ZIndex="100"
                    Cursor="SizeAll"
                    MouseDown="OnDraggableAreaMouseDown"
                    MouseMove="OnDraggableAreaMouseMove"
                    MouseUp="OnDraggableAreaMouseUp"
                    MouseLeave="OnDraggableAreaMouseLeave"/>

            <!-- 3D背景矩形 -->
            <Border Canvas.Left="23" Canvas.Top="-15" Width="240" Height="360" 
                    CornerRadius="10" Background="#E0E0E0"
                    Panel.ZIndex="0"/>

            <!-- 3D顶部 -->
            <Path Fill="{StaticResource TopGradient}" Panel.ZIndex="1">
                <Path.Data>
                    <PathGeometry Figures="M 12,0 L 35,-15 L 251,-15 L 228,0 Z"/>
                </Path.Data>
            </Path>

            <!-- 3D右侧面 -->
            <Path Fill="{StaticResource SideGradient}" Panel.ZIndex="1">
                <Path.Data>
                    <PathGeometry Figures="M 240,12 L 263,-3 L 263,345 L 240,360 Z"/>
                </Path.Data>
            </Path>

            <!-- 3D底部右角 -->
            <Path Fill="#CCC" Panel.ZIndex="1">
                <Path.Data>
                    <PathGeometry Figures="M 240,360 L 263,345 L 251,345 L 228,360 Z"/>
                </Path.Data>
            </Path>

            <!-- 3D左上圆角 -->
            <Path Fill="#F5F5F5" Panel.ZIndex="1">
                <Path.Data>
                    <PathGeometry Figures="M 0,12 Q 0,0 12,0 L 35,-15 Q 23,-15 23,-3 Z"/>
                </Path.Data>
            </Path>

            <!-- 3D右上圆角 -->
            <Path Fill="#F5F5F5" Panel.ZIndex="1">
                <Path.Data>
                    <PathGeometry Figures="M 228,0 L 251,-15 Q 263,-15 263,-3 L 240,12 Q 240,0 228,0 Z"/>
                </Path.Data>
            </Path>

            <!-- 3D右下圆角 -->
            <Path Fill="#D0D0D0" Panel.ZIndex="1">
                <Path.Data>
                    <PathGeometry Figures="M 240,348 Q 240,360 228,360 L 251,345 Q 263,345 263,333 Z"/>
                </Path.Data>
            </Path>

            <!-- 底座 -->
            <Path Canvas.Top="360" Fill="{StaticResource BaseGradient}" Panel.ZIndex="3">
                <Path.Data>
                    <PathGeometry Figures="M 15,0 L 225,0 L 225,11 L 15,11 Z"/>
                </Path.Data>
            </Path>

            <!-- 底座侧面 -->
            <Path Canvas.Top="360" Fill="#2C3136" Panel.ZIndex="3">
                <Path.Data>
                    <PathGeometry Figures="M 225,0 L 248,-15 L 248,-4 L 225,11 Z"/>
                </Path.Data>
            </Path>

            <!-- 底座脚垫 -->
            <Border Canvas.Left="105" Canvas.Top="363" Width="30" Height="5" 
                    CornerRadius="2.5" Background="#6C757D" Panel.ZIndex="3"/>

            <!-- 主面板 -->
            <Border Canvas.Left="0" Canvas.Top="0" Width="240" Height="360" 
                    CornerRadius="10"
                    Background="{StaticResource WhitePanelGradient}" 
                    BorderBrush="#D9D9D9" BorderThickness="1"
                    Panel.ZIndex="2">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.15"/>
                </Border.Effect>
            </Border>

            <!-- 白色高光 -->
            <Border Canvas.Left="1.5" Canvas.Top="1.5" Width="237" Height="357" 
                    CornerRadius="9"
                    BorderBrush="#FFFFFF" BorderThickness="1.5" 
                    Background="Transparent" Opacity="0.8"
                    Panel.ZIndex="2" IsHitTestVisible="False"/>

            <!-- 标题区域 -->
            <Canvas Canvas.Left="18" Canvas.Top="18" Panel.ZIndex="10">
                <TextBlock FontFamily="Helvetica Neue, Microsoft YaHei" 
                           FontSize="11" FontWeight="Light" Foreground="#262626">
                    <Run>高</Run><Run Text=" "/><Run>低</Run><Run Text=" "/><Run>温</Run><Run Text=" "/><Run>循</Run><Run Text=" "/><Run>环</Run><Run Text=" "/><Run>装</Run><Run Text=" "/><Run>置</Run>
                </TextBlock>
                <TextBlock Canvas.Top="13" FontFamily="Helvetica Neue" FontSize="6" Foreground="#8C8C8C">
                    <Run>P</Run><Run Text=" "/><Run>R</Run><Run Text=" "/><Run>E</Run><Run Text=" "/><Run>C</Run><Run Text=" "/><Run>I</Run><Run Text=" "/><Run>S</Run><Run Text=" "/><Run>I</Run><Run Text=" "/><Run>O</Run><Run Text=" "/><Run>N</Run><Run Text="  "/><Run>T</Run><Run Text=" "/><Run>E</Run><Run Text=" "/><Run>M</Run><Run Text=" "/><Run>P</Run><Run Text=" "/><Run>E</Run><Run Text=" "/><Run>R</Run><Run Text=" "/><Run>A</Run><Run Text=" "/><Run>T</Run><Run Text=" "/><Run>U</Run><Run Text=" "/><Run>R</Run><Run Text=" "/><Run>E</Run><Run Text="  "/><Run>C</Run><Run Text=" "/><Run>O</Run><Run Text=" "/><Run>N</Run><Run Text=" "/><Run>T</Run><Run Text=" "/><Run>R</Run><Run Text=" "/><Run>O</Run><Run Text=" "/><Run>L</Run>
                </TextBlock>

                <!-- 运行指示灯 -->
                <Canvas Canvas.Left="176" Canvas.Top="-2">
                    <Ellipse Width="8" Height="8" Fill="#52C41A">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#52C41A" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="5" Height="5" Fill="#FFFFFF" Opacity="0.9"/>
                    <TextBlock Canvas.Left="10" Canvas.Top="1.5" Text="运行" 
                               FontFamily="Helvetica Neue" FontSize="6" 
                               Foreground="#262626" FontWeight="Medium"/>
                </Canvas>
            </Canvas>

            <!-- 显示屏区域 -->
            <Border Canvas.Left="15" Canvas.Top="42" Width="210" Height="158" 
                    CornerRadius="5" Background="{StaticResource ScreenBgGradient}"
                    BorderThickness="1.5" BorderBrush="#0A0F14"
                    Panel.ZIndex="10">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1.5" Opacity="0.2"/>
                </Border.Effect>

                <Canvas>
                    <!-- 屏幕内边框 -->
                    <Border Width="207" Height="155" Canvas.Left="1.5" Canvas.Top="1.5" 
                            CornerRadius="4"
                            BorderBrush="#2A3B4A" BorderThickness="1" 
                            Background="Transparent" Opacity="0.5"/>

                    <!-- 主设置温度显示 -->
                    <Border Canvas.Left="15" Canvas.Top="15" Width="180" Height="56" 
                            CornerRadius="3" Background="{StaticResource DisplayCardGradient}"
                            BorderThickness="1" BorderBrush="#2D3E4F">

                        <Grid>
                            <TextBlock Text="SET TEMP" FontFamily="Helvetica Neue" FontSize="8" 
                                       Foreground="#8C8C8C" FontWeight="Normal"
                                       Margin="9,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" Margin="13,7,0,0">
                                <TextBlock x:Name="SetTempValue" 
                                           Text="{Binding SetTemperature, StringFormat={}{0:F1}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           FontFamily="Consolas" FontSize="32" 
                                           Foreground="#4A90E2" FontWeight="SemiBold">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#4A90E2" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="°C" FontFamily="Helvetica Neue" FontSize="14" 
                                           Foreground="#6BA3D8" FontWeight="Normal" Margin="3,6,0,0"/>
                            </StackPanel>

                            <!-- 调节按钮 -->
                            <StackPanel Canvas.Right="8" Canvas.Top="24" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button Width="27" Height="12" Style="{StaticResource AdjustButtonStyle}"
                                        Click="OnTempUpClick">
                                    <Path Data="M 13.5,4.5 L 9.75,9 L 17.25,9 Z" Fill="#4A90E2"/>
                                </Button>
                                <Button Width="27" Height="12" Margin="0,3,0,0" 
                                        Style="{StaticResource AdjustButtonStyle}"
                                        Click="OnTempDownClick">
                                    <Path Data="M 13.5,7.5 L 9.75,3 L 17.25,3 Z" Fill="#4A90E2"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 当前温度显示 -->
                    <Border Canvas.Left="15" Canvas.Top="82" Width="86" Height="53" 
                            CornerRadius="3" Background="{StaticResource DisplayCardGradient}"
                            BorderThickness="1" BorderBrush="#2D3E4F">
                        <Grid>
                            <TextBlock Text="CURRENT" FontFamily="Helvetica Neue" FontSize="6" 
                                       Foreground="#8C8C8C" FontWeight="Normal"
                                       Margin="6,4.5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" Margin="7.5,6,0,0">
                                <TextBlock Text="{Binding CurrentTemperature, StringFormat={}{0:F1}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           FontFamily="Consolas" FontSize="20" 
                                           Foreground="#F5F5F5" FontWeight="Medium"/>
                                <TextBlock Text="°C" FontFamily="Helvetica Neue" FontSize="8" 
                                           Foreground="#D9D9D9" Margin="2,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 出口温度显示 -->
                    <Border Canvas.Left="109" Canvas.Top="82" Width="86" Height="53" 
                            CornerRadius="3" Background="{StaticResource DisplayCardGradient}"
                            BorderThickness="1" BorderBrush="#2D3E4F">
                        <Grid>
                            <TextBlock Text="OUTLET" FontFamily="Helvetica Neue" FontSize="6" 
                                       Foreground="#8C8C8C" FontWeight="Normal"
                                       Margin="6,4.5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" Margin="7.5,6,0,0">
                                <TextBlock Text="{Binding OutletTemperature, StringFormat={}{0:F1}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                           FontFamily="Consolas" FontSize="20" 
                                           Foreground="#F5F5F5" FontWeight="Medium"/>
                                <TextBlock Text="°C" FontFamily="Helvetica Neue" FontSize="8" 
                                           Foreground="#D9D9D9" Margin="2,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Canvas>
            </Border>

            <!-- 控制按钮区 -->
            <Canvas Canvas.Left="15" Canvas.Top="214" Panel.ZIndex="10">
                <!-- 循环按钮 -->
                <Button Width="64" Height="27" Style="{StaticResource ControlButtonStyle}"
                        Background="{StaticResource GreenBtnGradient}"
                        Click="OnCirculationClick">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="12" Height="12" Margin="0,0,6,0">
                            <Ellipse Width="10.5" Height="10.5" Stroke="White" StrokeThickness="1.5" Canvas.Left="0.75" Canvas.Top="0.75"/>
                            <Path Data="M 3.75,-4.5 L 7.5,-0.75 L 3.75,3" Stroke="White" StrokeThickness="1.2" Canvas.Left="3.75" Canvas.Top="6"/>
                        </Canvas>
                        <TextBlock Text="循环" FontFamily="Helvetica Neue" FontSize="10" 
                                   Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 加热按钮 -->
                <Button Canvas.Left="73" Width="64" Height="27" 
                        Style="{StaticResource ControlButtonStyle}"
                        Background="{StaticResource OrangeBtnGradient}"
                        Click="OnHeatingClick">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0,-6 Q -3,-3 -3,0 Q -3,3.75 0,6.75 Q 3,3.75 3,0 Q 3,-3 0,-6 Z" 
                              Fill="White" Margin="0,0,6,0" Width="12" Height="12" 
                              Stretch="Uniform" Opacity="0.9"/>
                        <TextBlock Text="加热" FontFamily="Helvetica Neue" FontSize="10" 
                                   Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 制冷按钮 -->
                <Button Canvas.Left="146" Width="64" Height="27" 
                        Style="{StaticResource ControlButtonStyle}"
                        Background="{StaticResource BlueBtnGradient}"
                        Click="OnCoolingClick">
                    <StackPanel Orientation="Horizontal">
                        <Canvas Width="12" Height="12" Margin="0,0,6,0">
                            <Path Data="M 6,1.5 L 6,10.5 M 1.5,6 L 10.5,6 M 3,3 L 9,9 M 3,9 L 9,3" 
                                  Stroke="White" StrokeThickness="1.5"/>
                        </Canvas>
                        <TextBlock Text="制冷" FontFamily="Helvetica Neue" FontSize="10" 
                                   Foreground="White" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Canvas>

            <!-- 通风窗 -->
            <Border Canvas.Left="15" Canvas.Top="255" Width="210" Height="60" 
                    CornerRadius="3" Background="{StaticResource VentPanelGradient}"
                    BorderThickness="1" BorderBrush="#D9D9D9"
                    Panel.ZIndex="10">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="4.5" ShadowDepth="0.75" Opacity="0.1"/>
                </Border.Effect>

                <Canvas>
                    <!-- 顶部高光 -->
                    <Border Width="207" Height="0.75" Canvas.Left="1.5" Canvas.Top="1.5" 
                            Background="#FFFFFF" Opacity="0.8"/>

                    <!-- 底部阴影 -->
                    <Border Width="207" Height="0.75" Canvas.Left="1.5" Canvas.Top="57.75" 
                            Background="#000000" Opacity="0.05"/>

                    <!-- 左侧通风槽 -->
                    <ItemsControl Canvas.Left="11" Canvas.Top="10.5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Items>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}"/>
                        </ItemsControl.Items>
                    </ItemsControl>

                    <!-- 中间分隔线 -->
                    <Line X1="105" Y1="7.5" X2="105" Y2="52.5" Stroke="#D9D9D9" StrokeThickness="0.75" Opacity="0.4"/>
                    <Line X1="105.75" Y1="7.5" X2="105.75" Y2="52.5" Stroke="#FFFFFF" StrokeThickness="0.75" Opacity="0.6"/>

                    <!-- 右侧通风槽 -->
                    <ItemsControl Canvas.Left="109" Canvas.Top="10.5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Items>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}" Margin="0,0,0,4.5"/>
                            <Border Width="90" Height="1.5" CornerRadius="0.75" Background="{StaticResource VentSlotGradient}"/>
                        </ItemsControl.Items>
                    </ItemsControl>
                </Canvas>
            </Border>

            <!-- 底部型号 -->
            <TextBlock Canvas.Left="120" Canvas.Top="350" FontFamily="Helvetica Neue" FontSize="5.5" 
                       Foreground="#BFBFBF" FontWeight="Light" TextAlignment="Center">
                <Run>M</Run><Run Text=" "/><Run>o</Run><Run Text=" "/><Run>d</Run><Run Text=" "/><Run>e</Run><Run Text=" "/><Run>l</Run><Run>:</Run><Run Text="  "/><Run>T</Run><Run Text=" "/><Run>C</Run><Run>-</Run><Run>2</Run><Run Text=" "/><Run>0</Run><Run Text=" "/><Run>0</Run><Run Text=" "/><Run>0</Run>
            </TextBlock>

            <!-- 选择边框 -->
            <Border x:Name="SelectionBorder"
                    Canvas.Left="0" Canvas.Top="0" 
                    Width="240" Height="360" 
                    CornerRadius="10"
                    BorderBrush="#2196F3" BorderThickness="2"
                    Visibility="Collapsed"
                    Panel.ZIndex="200"
                    IsHitTestVisible="False">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush">
                            <Setter.Value>
                                <SolidColorBrush Color="#2196F3"/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect Color="#2196F3" BlurRadius="4" ShadowDepth="0" Opacity="0.3"/>
                </Border.Effect>
            </Border>

            <!-- 加载覆盖层 -->
            <Border x:Name="LoadingOverlay"
                    Canvas.Left="0" Canvas.Top="0"
                    Width="240" Height="360"
                    CornerRadius="10"
                    Background="#95FFFFFF"
                    Visibility="Collapsed"
                    Panel.ZIndex="300">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⟳" FontSize="36" Foreground="#4A90E2" 
                               HorizontalAlignment="Center">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="LoadingRotation" CenterX="0" CenterY="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="TextBlock.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:1.5"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="处理中..." FontFamily="Helvetica Neue" FontSize="11" 
                               Foreground="#595959" Margin="0,7.5,0,0"/>
                </StackPanel>
            </Border>

        </Canvas>
    </Viewbox>
</UserControl>