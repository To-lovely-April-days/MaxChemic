<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.TemperatureControlSystemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="310" 
             d:DesignWidth="260"
             Background="Transparent"
             Cursor="SizeAll"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 精密仪器金属渐变 -->
        <LinearGradientBrush x:Key="PrecisionMetalGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8EAED" Offset="0"/>
            <GradientStop Color="#D8DADD" Offset="0.5"/>
            <GradientStop Color="#C8CACD" Offset="1"/>
        </LinearGradientBrush>

        <!-- 主题红色点缀 - 降低饱和度 -->
        <LinearGradientBrush x:Key="AccentRedGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A84545" Offset="0"/>
            <GradientStop Color="#8B3333" Offset="0.5"/>
            <GradientStop Color="#6E2222" Offset="1"/>
        </LinearGradientBrush>

        <!-- 专业级白色面板渐变 -->
        <LinearGradientBrush x:Key="WhitePanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FEFEFE" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="0.5"/>
            <GradientStop Color="#F2F3F5" Offset="1"/>
        </LinearGradientBrush>

        <!-- 侧面金属渐变 -->
        <LinearGradientBrush x:Key="SideGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D8DADD" Offset="0"/>
            <GradientStop Color="#E8EAED" Offset="0.15"/>
            <GradientStop Color="#F2F3F5" Offset="0.35"/>
            <GradientStop Color="#E8EAED" Offset="0.65"/>
            <GradientStop Color="#D0D2D5" Offset="0.85"/>
            <GradientStop Color="#C0C2C5" Offset="1"/>
        </LinearGradientBrush>

        <!-- 顶部渐变 -->
        <LinearGradientBrush x:Key="TopGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="0.3"/>
            <GradientStop Color="#EBEDEF" Offset="0.7"/>
            <GradientStop Color="#E0E2E5" Offset="1"/>
        </LinearGradientBrush>

        <!-- 高级LCD屏幕背景 - 浅灰蓝色 -->
        <LinearGradientBrush x:Key="ScreenBgGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D8DCE3" Offset="0"/>
            <GradientStop Color="#CDD2DA" Offset="0.5"/>
            <GradientStop Color="#C2C8D1" Offset="1"/>
        </LinearGradientBrush>

        <!-- 显示卡片渐变 - 浅色卡片 -->
        <LinearGradientBrush x:Key="DisplayCardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8ECF1" Offset="0"/>
            <GradientStop Color="#DDE2E9" Offset="0.6"/>
            <GradientStop Color="#D2D8E0" Offset="1"/>
        </LinearGradientBrush>

        <!-- LCD外框渐变 - 深红棕色 -->
        <LinearGradientBrush x:Key="LCDFrameGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B84040" Offset="0"/>
            <GradientStop Color="#9E3030" Offset="0.5"/>
            <GradientStop Color="#842020" Offset="1"/>
        </LinearGradientBrush>

        <!-- 现代按钮样式 - 精密仪器风格 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BtnBorder" 
                                    CornerRadius="4" 
                                    BorderThickness="1.5" 
                                    BorderBrush="#D0D2D5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F8F9FA" Offset="0"/>
                                        <GradientStop Color="#EFF1F3" Offset="0.5"/>
                                        <GradientStop Color="#E6E8EB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.1"/>
                                </Border.Effect>

                                <Grid>
                                    <!-- 内部高光 -->
                                    <Border CornerRadius="3" 
                                            BorderThickness="1" 
                                            BorderBrush="#FFFFFF" 
                                            Margin="1.5" 
                                            Opacity="0.8"/>

                                    <!-- 状态指示器 -->
                                    <Border x:Name="StatusIndicator" 
                                            Width="5" Height="5" 
                                            CornerRadius="2.5"
                                            Background="#BCC0C5"
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Top"
                                            Margin="0,7,7,0"/>

                                    <!-- 内容 -->
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 激活光晕 -->
                            <Border x:Name="ActiveGlow" 
                                    CornerRadius="5" 
                                    BorderBrush="#8B3333" 
                                    BorderThickness="2"
                                    Opacity="0"
                                    Margin="-2"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#A0A2A5"/>
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#DFE1E4" Offset="0"/>
                                            <GradientStop Color="#E6E8EB" Offset="0.5"/>
                                            <GradientStop Color="#EEF0F2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>

                            <!-- 激活状态 - 精密红色点缀 -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="1"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#8B3333"/>
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="StatusIndicator" Property="Background" Value="#8B3333"/>
                                <Setter TargetName="StatusIndicator" Property="Width" Value="6"/>
                                <Setter TargetName="StatusIndicator" Property="Height" Value="6"/>
                                <Setter TargetName="StatusIndicator" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#8B3333" BlurRadius="4" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 调节按钮样式 - 专业金属质感 -->
        <Style x:Key="AdjustButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="3" 
                                BorderThickness="1.5" BorderBrush="#B0B2B5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E8EAED" Offset="0"/>
                                    <GradientStop Color="#D8DADD" Offset="0.5"/>
                                    <GradientStop Color="#C8CACD" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="2" 
                                                  ShadowDepth="1" Opacity="0.15"/>
                            </Border.Effect>
                            <Grid>
                                <!-- 顶部高光 -->
                                <Border CornerRadius="2" 
                                        BorderThickness="1,1,1,0" 
                                        BorderBrush="#FFFFFF" 
                                        Margin="1.5,1.5,1.5,0" Opacity="0.7"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#F0F2F5" Offset="0"/>
                                            <GradientStop Color="#E0E2E5" Offset="0.5"/>
                                            <GradientStop Color="#D0D2D5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#7A8A99"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C8CACD" Offset="0"/>
                                            <GradientStop Color="#D0D2D5" Offset="0.5"/>
                                            <GradientStop Color="#D8DADD" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Fill">
        <Canvas Width="260" Height="310">

            <!-- 可拖拽区域 -->
            <Border x:Name="DraggableArea"
                    Canvas.Left="0" Canvas.Top="0"
                    Width="260" Height="310"
                    Background="Transparent"
                    Panel.ZIndex="100"
                    Cursor="SizeAll"
                    MouseDown="OnDraggableAreaMouseDown"
                    MouseMove="OnDraggableAreaMouseMove"
                    MouseUp="OnDraggableAreaMouseUp"
                    MouseLeave="OnDraggableAreaMouseLeave"/>

            <!-- ========== 优化的3D立体结构 ========== -->

            <!-- 统一的3D深阴影基础 -->
            <Border Canvas.Left="26" Canvas.Top="-12" Width="224" Height="314" 
                    CornerRadius="10" Background="#30000000"
                    Panel.ZIndex="0">
                <Border.Effect>
                    <BlurEffect Radius="7"/>
                </Border.Effect>
            </Border>

            <!-- ========== 3D顶部面 ========== -->
            <Canvas Panel.ZIndex="1">
                <!-- 顶部主面 -->
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="12,0" IsClosed="True">
                                <LineSegment Point="35,-15"/>
                                <LineSegment Point="241,-15"/>
                                <LineSegment Point="218,0"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F8F9FA" Offset="0.4"/>
                            <GradientStop Color="#EBEDEF" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.1"/>
                    </Path.Effect>
                </Path>

                <!-- 顶部高光 -->
                <Path Fill="#45FFFFFF" IsHitTestVisible="False">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="20,0" IsClosed="True">
                                <LineSegment Point="37,-12"/>
                                <LineSegment Point="140,-12"/>
                                <LineSegment Point="123,0"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>

            <!-- ========== 3D右侧面 - 修正长度 ========== -->
            <Canvas Panel.ZIndex="1">
                <!-- 侧面主体 -->
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="230,12" IsClosed="True">
                                <LineSegment Point="253,-3"/>
                                <LineSegment Point="253,293"/>
                                <LineSegment Point="230,308"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#D0D2D5" Offset="0"/>
                            <GradientStop Color="#E0E2E5" Offset="0.15"/>
                            <GradientStop Color="#EBEDEF" Offset="0.35"/>
                            <GradientStop Color="#E0E2E5" Offset="0.65"/>
                            <GradientStop Color="#CACCD0" Offset="0.85"/>
                            <GradientStop Color="#B8BEC4" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1.5" Opacity="0.12" Direction="0"/>
                    </Path.Effect>
                </Path>

                <!-- 侧面高光条 -->
                <Path Fill="#35FFFFFF" IsHitTestVisible="False">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="231,15" IsClosed="True">
                                <LineSegment Point="252,-1"/>
                                <LineSegment Point="252,100"/>
                                <LineSegment Point="231,115"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>

                <!-- 侧面暗部 -->
                <Path Fill="#15000000" IsHitTestVisible="False">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="230,200" IsClosed="True">
                                <LineSegment Point="253,185"/>
                                <LineSegment Point="253,293"/>
                                <LineSegment Point="230,308"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>

            <!-- ========== 3D角落过渡 - 优化连接 ========== -->
            <Canvas Panel.ZIndex="1">
                <!-- 左上角 -->
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,12" IsClosed="True">
                                <ArcSegment Point="12,0" Size="12,12" SweepDirection="Clockwise"/>
                                <LineSegment Point="35,-15"/>
                                <ArcSegment Point="23,-3" Size="12,12" SweepDirection="Counterclockwise"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F6F7F8" Offset="0"/>
                            <GradientStop Color="#EBEDEF" Offset="0.5"/>
                            <GradientStop Color="#E0E2E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- 右上角 - 优化连接 -->
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="218,0" IsClosed="True">
                                <ArcSegment Point="230,12" Size="12,12" SweepDirection="Clockwise"/>
                                <LineSegment Point="253,-3"/>
                                <LineSegment Point="241,-15"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E8EAED" Offset="0"/>
                            <GradientStop Color="#DCDEE1" Offset="0.5"/>
                            <GradientStop Color="#D0D2D5" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- 左下角 -->
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,308" IsClosed="True">
                                <ArcSegment Point="12,320" Size="12,12" SweepDirection="Clockwise"/>
                                <LineSegment Point="23,307"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D8DADD" Offset="0"/>
                            <GradientStop Color="#C8CACD" Offset="0.5"/>
                            <GradientStop Color="#B8BEC4" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- 右下角 - 优化连接和长度 -->
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="230,308" IsClosed="True">
                                <ArcSegment Point="218,320" Size="12,12" SweepDirection="Clockwise"/>
                                <LineSegment Point="241,305"/>
                                <LineSegment Point="253,293"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#C8CACD" Offset="0"/>
                            <GradientStop Color="#BFC3C7" Offset="0.5"/>
                            <GradientStop Color="#B0B4B8" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Canvas>

            <!-- ========== 主面板 ========== -->
            <Border Canvas.Left="0" Canvas.Top="0" Width="230" Height="320" 
                    CornerRadius="10"
                    Background="{StaticResource WhitePanelGradient}" 
                    BorderBrush="#C0C2C5" BorderThickness="0,0,1,1"
                    Panel.ZIndex="2">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.08"/>
                </Border.Effect>
            </Border>

            <!-- 主面板精密边框 -->
            <Border Canvas.Left="0" Canvas.Top="0" Width="230" Height="320" 
                    CornerRadius="10"
                    BorderBrush="#B0B2B5" BorderThickness="1"
                    Background="Transparent"
                    Panel.ZIndex="2" IsHitTestVisible="False"/>

            <!-- 主面板内部高光 -->
            <Border Canvas.Left="2" Canvas.Top="2" Width="226" Height="316" 
                    CornerRadius="9"
                    BorderBrush="#FFFFFF" BorderThickness="1.5" 
                    Background="Transparent" Opacity="0.7"
                    Panel.ZIndex="2" IsHitTestVisible="False"/>

            <!-- ========== 内容区域 ========== -->

            <!-- 标题区域 - 精密仪器风格 -->
            <Canvas Canvas.Left="12" Canvas.Top="10" Panel.ZIndex="10">
                <!-- 精密装饰条 - 低调红色 -->
                <Border Width="3" Height="24" CornerRadius="1.5" 
                        Background="{StaticResource AccentRedGradient}">
                    <Border.Effect>
                        <DropShadowEffect Color="#6E2222" BlurRadius="2" ShadowDepth="0" Opacity="0.3"/>
                    </Border.Effect>
                </Border>

                <TextBlock Canvas.Left="10" FontFamily="Helvetica Neue, Microsoft YaHei" 
                           FontSize="12" FontWeight="Medium" Foreground="#3D4349">
                    <Run>高</Run><Run Text=" "/><Run>低</Run><Run Text=" "/><Run>温</Run><Run Text=" "/><Run>循</Run><Run Text=" "/><Run>环</Run><Run Text=" "/><Run>装</Run><Run Text=" "/><Run>置</Run>
                </TextBlock>
                <TextBlock Canvas.Left="10" Margin="0 5 0 0" Canvas.Top="14" FontFamily="Helvetica Neue" FontSize="6.5" Foreground="#8B9199">
                    <Run>P</Run><Run Text=" "/><Run>R</Run><Run Text=" "/><Run>E</Run><Run Text=" "/><Run>C</Run><Run Text=" "/><Run>I</Run><Run Text=" "/><Run>S</Run><Run Text=" "/><Run>I</Run><Run Text=" "/><Run>O</Run><Run Text=" "/><Run>N</Run><Run Text="  "/><Run>T</Run><Run Text=" "/><Run>E</Run><Run Text=" "/><Run>M</Run><Run Text=" "/><Run>P</Run><Run Text="  "/><Run>C</Run><Run Text=" "/><Run>O</Run><Run Text=" "/><Run>N</Run><Run Text=" "/><Run>T</Run><Run Text=" "/><Run>R</Run><Run Text=" "/><Run>O</Run><Run Text=" "/><Run>L</Run>
                </TextBlock>

                <!-- 运行指示灯 - 精密红色 -->
                <Canvas Canvas.Left="158" Canvas.Top="-1">
                    <Ellipse Width="9" Height="9" Fill="#8B3333">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#8B3333" BlurRadius="4" ShadowDepth="0" Opacity="0.5"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="5" Height="5" Fill="#FFFFFF" Opacity="0.8"/>
                    <TextBlock Canvas.Left="12" Canvas.Top="2" Text="运行" 
                               FontFamily="Microsoft YaHei" FontSize="7" 
                               Foreground="#5D6369" FontWeight="Medium"/>
                </Canvas>
            </Canvas>

            <!-- 显示屏区域 - 专业LCD带红色外框 -->
            <Canvas Canvas.Left="12" Canvas.Top="42" Panel.ZIndex="10">
                <!-- LCD外框 - 深红棕色金属质感 -->
                <Border Width="206" Height="148" 
                        CornerRadius="6" 
                        Background="{StaticResource LCDFrameGradient}"
                        BorderThickness="1.5" BorderBrush="#6E2020">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.25"/>
                    </Border.Effect>

                    <!-- 外框高光 -->
                    <Border CornerRadius="5" 
                            BorderBrush="#D04040" 
                            BorderThickness="1" 
                            Margin="1" 
                            Opacity="0.4"/>
                </Border>

                <!-- 屏幕凹槽 -->
                <Border Canvas.Left="4" Canvas.Top="4" Width="198" Height="140" 
                        CornerRadius="4" 
                        Background="#B8BCC4"
                        BorderThickness="1.5" BorderBrush="#A8ADB6">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="2" Opacity="0.3" Direction="135"/>
                    </Border.Effect>
                </Border>

                <!-- 屏幕主体 - 浅灰蓝色专业背景 -->
                <Border Canvas.Left="6" Canvas.Top="6" Width="194" Height="136" 
                        CornerRadius="3" Background="{StaticResource ScreenBgGradient}"
                        BorderThickness="1" BorderBrush="#BFC4CC">

                    <Canvas>
                        <!-- 屏幕内边框 -->
                        <Border Width="190" Height="132" Canvas.Left="2" Canvas.Top="2" 
                                CornerRadius="2"
                                BorderBrush="#C8CDD5" BorderThickness="1" 
                                Background="Transparent" Opacity="0.5"/>

                        <!-- 主设置温度显示 - 浅色卡片 -->
                        <Border Canvas.Left="7" Canvas.Top="8" Width="180" Height="56" 
                                CornerRadius="3" BorderThickness="1" BorderBrush="#B8BEC8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#EEF2F7" Offset="0"/>
                                    <GradientStop Color="#E3E8EF" Offset="0.5"/>
                                    <GradientStop Color="#D8DEE7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <TextBlock Text="设定温度" FontFamily="Microsoft YaHei" FontSize="9" 
                                           Foreground="#5D6B7A" FontWeight="Medium"
                                           Margin="10,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                                            VerticalAlignment="Center" Margin="14,8,0,0">
                                    <!-- 专业LCD红色显示 -->
                                    <TextBlock x:Name="SetTempValue" 
                                               Text="{Binding SetTemperature, StringFormat={}{0:F1}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                               FontFamily="Consolas" FontSize="32" 
                                               Foreground="#E53935" FontWeight="Bold">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#E53935" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="°C" FontFamily="Consolas" FontSize="16" 
                                               Foreground="#EF5350" FontWeight="Bold" Margin="4,6,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#E53935" BlurRadius="5" ShadowDepth="0" Opacity="0.4"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 调节按钮 -->
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Button Width="28" Height="13" Style="{StaticResource AdjustButtonStyle}"
                                            Click="OnTempUpClick">
                                        <Viewbox Width="8" Height="5">
                                            <Path Data="M 4,0 L 0,5 L 8,5 Z" Fill="#5D6369" Stroke="#5D6369" StrokeThickness="0.5"/>
                                        </Viewbox>
                                    </Button>
                                    <Button Width="28" Height="13" Margin="0,3,0,0" 
                                            Style="{StaticResource AdjustButtonStyle}"
                                            Click="OnTempDownClick">
                                        <Viewbox Width="8" Height="5">
