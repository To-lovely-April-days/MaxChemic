<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.TemperatureControlSystemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="310" 
             d:DesignWidth="260"
             Background="Transparent"
             Cursor="SizeAll"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <LinearGradientBrush x:Key="PrecisionMetalGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E8EAED" Offset="0"/>
            <GradientStop Color="#D8DADD" Offset="0.5"/>
            <GradientStop Color="#C8CACD" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentRedGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A84545" Offset="0"/>
            <GradientStop Color="#8B3333" Offset="0.5"/>
            <GradientStop Color="#6E2222" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WhitePanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FEFEFE" Offset="0"/>
            <GradientStop Color="#F8F9FA" Offset="0.5"/>
            <GradientStop Color="#F2F3F5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ScreenBgGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D8DCE3" Offset="0"/>
            <GradientStop Color="#CDD2DA" Offset="0.5"/>
            <GradientStop Color="#C2C8D1" Offset="1"/>
        </LinearGradientBrush>

        <!-- ========== 状态帧渐变 ========== -->

        <!-- 空闲: 深色仪器边框 -->
        <LinearGradientBrush x:Key="IdleFrameGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A5058" Offset="0"/>
            <GradientStop Color="#3A4048" Offset="0.5"/>
            <GradientStop Color="#2D3238" Offset="1"/>
        </LinearGradientBrush>

        <!-- 运行: 明亮青色边框 -->
        <LinearGradientBrush x:Key="RunningFrameGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00A08A" Offset="0"/>
            <GradientStop Color="#00897B" Offset="0.5"/>
            <GradientStop Color="#00695C" Offset="1"/>
        </LinearGradientBrush>

        <!-- 加载: 明亮琥珀色边框 -->
        <LinearGradientBrush x:Key="LoadingFrameGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6A817" Offset="0"/>
            <GradientStop Color="#D49A10" Offset="0.5"/>
            <GradientStop Color="#B8860B" Offset="1"/>
        </LinearGradientBrush>

        <!-- 异常: 明亮红色边框 -->
        <LinearGradientBrush x:Key="ErrorFrameGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E53935" Offset="0"/>
            <GradientStop Color="#D32F2F" Offset="0.5"/>
            <GradientStop Color="#C62828" Offset="1"/>
        </LinearGradientBrush>

        <!-- 现代按钮样式 -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BtnBorder" 
                                    CornerRadius="4" 
                                    BorderThickness="1.5" 
                                    BorderBrush="#D0D2D5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F8F9FA" Offset="0"/>
                                        <GradientStop Color="#EFF1F3" Offset="0.5"/>
                                        <GradientStop Color="#E6E8EB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.1"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>

                                <Grid>
                                    <Border CornerRadius="3" 
                                            BorderThickness="1" 
                                            BorderBrush="#FFFFFF" 
                                            Margin="1.5" 
                                            Opacity="0.8"/>

                                    <Border x:Name="StatusIndicator" 
                                            Width="5" Height="5" 
                                            CornerRadius="2.5"
                                            Background="#BCC0C5"
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Top"
                                            Margin="0,7,7,0"/>

                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border x:Name="ActiveGlow" 
                                    CornerRadius="5" 
                                    BorderBrush="#00897B" 
                                    BorderThickness="2"
                                    Opacity="0"
                                    Margin="-2"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#A0A2A5"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#DFE1E4" Offset="0"/>
                                            <GradientStop Color="#E6E8EB" Offset="0.5"/>
                                            <GradientStop Color="#EEF0F2" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>

                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="1"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#00897B"/>
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="StatusIndicator" Property="Background" Value="#4CAF50"/>
                                <Setter TargetName="StatusIndicator" Property="Width" Value="6"/>
                                <Setter TargetName="StatusIndicator" Property="Height" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdjustButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="3" 
                                BorderThickness="1.5" BorderBrush="#B0B2B5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#E8EAED" Offset="0"/>
                                    <GradientStop Color="#D8DADD" Offset="0.5"/>
                                    <GradientStop Color="#C8CACD" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="2" 
                                                  ShadowDepth="1" Opacity="0.12"
                                                  RenderingBias="Performance"/>
                            </Border.Effect>
                            <Grid>
                                <Border CornerRadius="2" 
                                        BorderThickness="1,1,1,0" 
                                        BorderBrush="#FFFFFF" 
                                        Margin="1.5,1.5,1.5,0" Opacity="0.6"/>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#F0F2F5" Offset="0"/>
                                            <GradientStop Color="#E0E2E5" Offset="0.5"/>
                                            <GradientStop Color="#D0D2D5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#7A8A99"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#C8CACD" Offset="0"/>
                                            <GradientStop Color="#D0D2D5" Offset="0.5"/>
                                            <GradientStop Color="#D8DADD" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Fill">
        <Canvas Width="260" Height="310">

            <!-- 3D深阴影基础 -->
            <Border Canvas.Left="26" Canvas.Top="-12" Width="224" Height="314" 
                    CornerRadius="10" Background="#30000000"
                    Panel.ZIndex="0">
                <Border.Effect>
                    <BlurEffect Radius="7"/>
                </Border.Effect>
            </Border>

            <!-- 3D顶部面 -->
            <Canvas Panel.ZIndex="1">
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="12,0" IsClosed="True">
                                <LineSegment Point="35,-15"/>
                                <LineSegment Point="241,-15"/>
                                <LineSegment Point="218,0"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F8F9FA" Offset="0.4"/>
                            <GradientStop Color="#EBEDEF" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.08"
                                          RenderingBias="Performance"/>
                    </Path.Effect>
                </Path>

                <Path Fill="#35FFFFFF" IsHitTestVisible="False">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="20,0" IsClosed="True">
                                <LineSegment Point="37,-12"/>
                                <LineSegment Point="140,-12"/>
                                <LineSegment Point="123,0"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>

            <!-- 3D右侧面 -->
            <Canvas Panel.ZIndex="1">
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="230,12" IsClosed="True">
                                <LineSegment Point="253,-3"/>
                                <LineSegment Point="253,293"/>
                                <LineSegment Point="230,308"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#D0D2D5" Offset="0"/>
                            <GradientStop Color="#E0E2E5" Offset="0.15"/>
                            <GradientStop Color="#EBEDEF" Offset="0.35"/>
                            <GradientStop Color="#E0E2E5" Offset="0.65"/>
                            <GradientStop Color="#CACCD0" Offset="0.85"/>
                            <GradientStop Color="#B8BEC4" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                    <Path.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1.5" Opacity="0.1" Direction="0"
                                          RenderingBias="Performance"/>
                    </Path.Effect>
                </Path>

                <Path Fill="#30FFFFFF" IsHitTestVisible="False">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="231,15" IsClosed="True">
                                <LineSegment Point="252,-1"/>
                                <LineSegment Point="252,100"/>
                                <LineSegment Point="231,115"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>

                <Path Fill="#12000000" IsHitTestVisible="False">
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="230,200" IsClosed="True">
                                <LineSegment Point="253,185"/>
                                <LineSegment Point="253,293"/>
                                <LineSegment Point="230,308"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Canvas>

            <!-- 3D角落过渡 -->
            <Canvas Panel.ZIndex="1">
                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,12" IsClosed="True">
                                <ArcSegment Point="12,0" Size="12,12" SweepDirection="Clockwise"/>
                                <LineSegment Point="35,-15"/>
                                <ArcSegment Point="23,-3" Size="12,12" SweepDirection="Counterclockwise"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F6F7F8" Offset="0"/>
                            <GradientStop Color="#EBEDEF" Offset="0.5"/>
                            <GradientStop Color="#E0E2E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="218,0" IsClosed="True">
                                <ArcSegment Point="230,12" Size="12,12" SweepDirection="Clockwise"/>
                                <LineSegment Point="253,-3"/>
                                <LineSegment Point="241,-15"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E8EAED" Offset="0"/>
                            <GradientStop Color="#DCDEE1" Offset="0.5"/>
                            <GradientStop Color="#D0D2D5" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,308" IsClosed="True">
                                <ArcSegment Point="12,320" Size="12,12" SweepDirection="Clockwise"/>
                                <LineSegment Point="23,307"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D8DADD" Offset="0"/>
                            <GradientStop Color="#C8CACD" Offset="0.5"/>
                            <GradientStop Color="#B8BEC4" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <Path>
                    <Path.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="230,308" IsClosed="True">
                                <ArcSegment Point="218,320" Size="12,12" SweepDirection="Clockwise"/>
                                <LineSegment Point="241,305"/>
                                <LineSegment Point="253,293"/>
                            </PathFigure>
                        </PathGeometry>
                    </Path.Data>
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#C8CACD" Offset="0"/>
                            <GradientStop Color="#BFC3C7" Offset="0.5"/>
                            <GradientStop Color="#B0B4B8" Offset="1"/>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Canvas>

            <!-- 主面板 -->
            <Border Canvas.Left="0" Canvas.Top="0" Width="230" Height="320" 
                    CornerRadius="10"
                    Background="{StaticResource WhitePanelGradient}" 
                    BorderBrush="#C0C2C5" BorderThickness="0,0,1,1"
                    Panel.ZIndex="2">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.06"
                                      RenderingBias="Performance"/>
                </Border.Effect>
            </Border>

            <Border Canvas.Left="0" Canvas.Top="0" Width="230" Height="320" 
                    CornerRadius="10"
                    BorderBrush="#B0B2B5" BorderThickness="1"
                    Background="Transparent"
                    Panel.ZIndex="2" IsHitTestVisible="False"/>

            <Border Canvas.Left="2" Canvas.Top="2" Width="226" Height="316" 
                    CornerRadius="9"
                    BorderBrush="#FFFFFF" BorderThickness="1.5" 
                    Background="Transparent" Opacity="0.6"
                    Panel.ZIndex="2" IsHitTestVisible="False"/>

            <!-- ========== 内容区域 ========== -->

            <!-- 标题区域 -->
            <Canvas Canvas.Left="12" Canvas.Top="10" Panel.ZIndex="10">
                <Border x:Name="AccentBar" Width="3" Height="24" CornerRadius="1.5" 
                        Background="{StaticResource AccentRedGradient}"/>

                <TextBlock Canvas.Left="10" FontFamily="Helvetica Neue, Microsoft YaHei" 
                           FontSize="12" FontWeight="Medium" Foreground="#3D4349">
                    <Run>高</Run><Run Text=" "/><Run>低</Run><Run Text=" "/><Run>温</Run><Run Text=" "/><Run>循</Run><Run Text=" "/><Run>环</Run><Run Text=" "/><Run>装</Run><Run Text=" "/><Run>置</Run>
                </TextBlock>
                <TextBlock Canvas.Left="10" Margin="0 5 0 0" Canvas.Top="14" FontFamily="Helvetica Neue" FontSize="6.5" Foreground="#8B9199">
                    <Run>P</Run><Run Text=" "/><Run>R</Run><Run Text=" "/><Run>E</Run><Run Text=" "/><Run>C</Run><Run Text=" "/><Run>I</Run><Run Text=" "/><Run>S</Run><Run Text=" "/><Run>I</Run><Run Text=" "/><Run>O</Run><Run Text=" "/><Run>N</Run><Run Text="  "/><Run>T</Run><Run Text=" "/><Run>E</Run><Run Text=" "/><Run>M</Run><Run Text=" "/><Run>P</Run><Run Text="  "/><Run>C</Run><Run Text=" "/><Run>O</Run><Run Text=" "/><Run>N</Run><Run Text=" "/><Run>T</Run><Run Text=" "/><Run>R</Run><Run Text=" "/><Run>O</Run><Run Text=" "/><Run>L</Run>
                </TextBlock>

                <!-- 运行指示灯 -->
                <Canvas Canvas.Left="158" Canvas.Top="-1">
                    <Ellipse x:Name="RunningIndicator" Width="9" Height="9" Fill="#9E9E9E"/>
                    <Ellipse x:Name="RunningIndicatorHighlight" Canvas.Left="2" Canvas.Top="2" Width="5" Height="5" Fill="#FFFFFF" Opacity="0.7"/>
                    <TextBlock x:Name="StatusText" Canvas.Left="12" Canvas.Top="2" Text="就绪" 
                               FontFamily="Microsoft YaHei" FontSize="7" 
                               Foreground="#5D6369" FontWeight="Medium"/>
                </Canvas>
            </Canvas>

            <!-- 显示屏区域 -->
            <Canvas Canvas.Left="12" Canvas.Top="42" Panel.ZIndex="10">
                <!-- LCD外框 - 代码动态控制颜色 -->
                <Border x:Name="LCDFrame" Width="206" Height="148" 
                        CornerRadius="6" 
                        Background="{StaticResource IdleFrameGradient}"
                        BorderThickness="1" BorderBrush="#2D3238">
                    <Border.Effect>
                        <DropShadowEffect x:Name="LCDFrameGlow"
                                          Color="Transparent" 
                                          BlurRadius="0" 
                                          ShadowDepth="0" 
                                          Opacity="0"
                                          RenderingBias="Performance"/>
                    </Border.Effect>

                    <Border CornerRadius="5" 
                            BorderBrush="#FFFFFF" 
                            BorderThickness="0.5,0.5,0,0" 
                            Margin="1" 
                            Opacity="0.1"/>
                </Border>

                <!-- 屏幕凹槽 -->
                <Border Canvas.Left="4" Canvas.Top="4" Width="198" Height="140" 
                        CornerRadius="4" 
                        Background="#B8BCC4"
                        BorderThickness="1.5" BorderBrush="#A8ADB6">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1.5" Opacity="0.25" Direction="135"
                                          RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>

                <!-- 屏幕主体 -->
                <Border Canvas.Left="6" Canvas.Top="6" Width="194" Height="136" 
                        CornerRadius="3" Background="{StaticResource ScreenBgGradient}"
                        BorderThickness="1" BorderBrush="#BFC4CC">

                    <Canvas>
                        <Border Width="190" Height="132" Canvas.Left="2" Canvas.Top="2" 
                                CornerRadius="2"
                                BorderBrush="#C8CDD5" BorderThickness="1" 
                                Background="Transparent" Opacity="0.5"/>

                        <!-- 主设置温度显示 -->
                        <Border Canvas.Left="7" Canvas.Top="8" Width="180" Height="56" 
        CornerRadius="3" BorderThickness="1" BorderBrush="#B8BEC8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#EEF2F7" Offset="0"/>
                                    <GradientStop Color="#E3E8EF" Offset="0.5"/>
                                    <GradientStop Color="#D8DEE7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <TextBlock Text="设定温度" FontFamily="Microsoft YaHei" FontSize="9" 
                   Foreground="#5D6B7A" FontWeight="Medium"
                   Margin="10,7,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="14,8,0,0">
                                    <TextBlock x:Name="SetTempValue" 
                       Text="{Binding SetTemperature, StringFormat={}{0:F1}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       FontFamily="Consolas" FontSize="32" 
                       Foreground="#8B3535" FontWeight="Bold">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#8B3535" BlurRadius="2" ShadowDepth="0" Opacity="0.12"
                                      RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="°C" FontFamily="Consolas" FontSize="16" 
                       Foreground="#A05050" FontWeight="Bold" Margin="4,6,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Button Width="28" Height="13" Style="{StaticResource AdjustButtonStyle}"
                    Click="OnTempUpClick">
                                        <Viewbox Width="8" Height="5">
                                            <Path Data="M 4,0 L 0,5 L 8,5 Z" Fill="#5D6369" Stroke="#5D6369" StrokeThickness="0.5"/>
                                        </Viewbox>
                                    </Button>
                                    <Button Width="28" Height="13" Margin="0,3,0,0" 
                    Style="{StaticResource AdjustButtonStyle}"
                    Click="OnTempDownClick">
                                        <Viewbox Width="8" Height="5">
                                            <Path Data="M 4,5 L 0,0 L 8,0 Z" Fill="#5D6369" Stroke="#5D6369" StrokeThickness="0.5"/>
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 当前温度显示 -->
                        <Border Canvas.Left="7" Canvas.Top="72" Width="90" Height="56" 
        CornerRadius="3" BorderThickness="1" BorderBrush="#B8BEC8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#EEF2F7" Offset="0"/>
                                    <GradientStop Color="#E3E8EF" Offset="0.5"/>
                                    <GradientStop Color="#D8DEE7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="当前" FontFamily="Microsoft YaHei" FontSize="8" 
                   Foreground="#5D6B7A" FontWeight="Medium"
                   Margin="7,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="9,9,0,0">
                                    <TextBlock Text="{Binding CurrentTemperature, StringFormat={}{0:F1}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       FontFamily="Consolas" FontSize="24" 
                       Foreground="#3A5F7A" FontWeight="Bold">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#3A5F7A" BlurRadius="2" ShadowDepth="0" Opacity="0.10"
                                      RenderingBias="Performance"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="°C" FontFamily="Consolas" FontSize="10" 
                       Foreground="#5A7F9A" FontWeight="Bold" Margin="2,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 出口温度显示 -->
                        <Border Canvas.Left="103" Canvas.Top="72" Width="84" Height="56" 
        CornerRadius="3" BorderThickness="1" BorderBrush="#B8BEC8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#EEF2F7" Offset="0"/>
                                    <GradientStop Color="#E3E8EF" Offset="0.5"/>
                                    <GradientStop Color="#D8DEE7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="出口" FontFamily="Microsoft YaHei" FontSize="8" 
                   Foreground="#5D6B7A" FontWeight="Medium"
                   Margin="7,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="8,9,0,0">
