<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.TemperatureControlSystemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="340" 
             d:DesignWidth="260"
             Background="Transparent"
             Cursor="SizeAll"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ========== 主体面板渐变(实验室白) ========== -->
        <!-- 主体面板渐变(替换为纯白) -->
        <LinearGradientBrush x:Key="BodyFrontGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#F5F5F5" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="0.5"/>
            <GradientStop Color="#F5F5F5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BodyTopGradient" StartPoint="0,1" EndPoint="0,0">
            <GradientStop Color="#EEEEEE" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BodySideGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#E8E8E8" Offset="0"/>
            <GradientStop Color="#C8C8C8" Offset="1"/>
        </LinearGradientBrush>
        <!-- ========== LCD 屏渐变(深黑) ========== -->
        <LinearGradientBrush x:Key="LCDScreenGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#1A1A1A" Offset="0"/>
            <GradientStop Color="#0A0A0A" Offset="1"/>
        </LinearGradientBrush>

        <!-- ========== 通风格栅金属条渐变 ========== -->
        <LinearGradientBrush x:Key="VentBarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#888780" Offset="0"/>
            <GradientStop Color="#5F5E5A" Offset="0.5"/>
            <GradientStop Color="#444441" Offset="1"/>
        </LinearGradientBrush>

        <!-- ========== 状态帧渐变(LCD 边框) ========== -->
        <!-- 空闲: 深灰 -->
        <LinearGradientBrush x:Key="IdleFrameGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1A1A1A" Offset="0"/>
            <GradientStop Color="#0A0A0A" Offset="1"/>
        </LinearGradientBrush>

        <!-- 运行: 深森绿 -->
        <LinearGradientBrush x:Key="RunningFrameGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1D9E75" Offset="0"/>
            <GradientStop Color="#0F6E56" Offset="1"/>
        </LinearGradientBrush>

        <!-- 加载: 琥珀 -->
        <LinearGradientBrush x:Key="LoadingFrameGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#BA7517" Offset="0"/>
            <GradientStop Color="#854F0B" Offset="1"/>
        </LinearGradientBrush>

        <!-- 异常: 暖红 -->
        <LinearGradientBrush x:Key="ErrorFrameGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C42626" Offset="0"/>
            <GradientStop Color="#791F1F" Offset="1"/>
        </LinearGradientBrush>

        <!-- ========== 品牌色装饰条渐变 ========== -->
        <LinearGradientBrush x:Key="AccentRedGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A41626" Offset="0"/>
            <GradientStop Color="#6B0E1A" Offset="1"/>
        </LinearGradientBrush>

        <!-- ========== 控制按钮样式 ========== -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 默认态:白底 + 灰边 -->
                            <Border x:Name="BtnBorder" 
                                    CornerRadius="3" 
                                    BorderThickness="1" 
                                    BorderBrush="#D3D1C7"
                                    Background="#FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0.5" Opacity="0.06"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>

                                <Grid>
                                    <!-- 顶部高光 -->
                                    <Border CornerRadius="2,2,0,0" 
                                            Height="2" 
                                            Background="#FFFFFF"
                                            VerticalAlignment="Top"
                                            Margin="1,1,1,0"
                                            Opacity="0.6"/>

                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#888780"/>
                            </Trigger>

                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F4F3EF"/>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>

                            <!-- 激活态(Tag = "Active"):浅粉底 + 深红边 -->
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#FCEAEC"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#A41626"/>
                                <Setter TargetName="BtnBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 温度调节小按钮样式(LCD 屏右上角) ========== -->
        <Style x:Key="AdjustButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" CornerRadius="2" 
                                BorderThickness="1" BorderBrush="#0A0A0A"
                                Background="#1A1A1A">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0A0A0A"/>
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="BtnBorder" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Fill">
        <Canvas Width="260" Height="340">

            <!-- ========== 阴影 ========== -->
            <Ellipse Canvas.Left="35" Canvas.Top="320" Width="200" Height="10" Fill="#2A2A30" Opacity="0.12"
                     Panel.ZIndex="0"/>

            <!-- ========== 3D 顶面 ========== -->
            <Path Panel.ZIndex="1" Fill="{StaticResource BodyTopGradient}" Stroke="#D3D1C7" StrokeThickness="0.3">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="30,57" IsClosed="True">
                            <LineSegment Point="48,39"/>
                            <LineSegment Point="258,39"/>
                            <LineSegment Point="240,57"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- 顶面高光 -->
            <Path Panel.ZIndex="1" Fill="White" Opacity="0.4" IsHitTestVisible="False">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="32,57" IsClosed="True">
                            <LineSegment Point="50,39"/>
                            <LineSegment Point="145,39"/>
                            <LineSegment Point="127,57"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- ========== 3D 右侧面 ========== -->
            <Path Panel.ZIndex="1" Fill="{StaticResource BodySideGradient}" Stroke="#A8A49B" StrokeThickness="0.4">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="240,57" IsClosed="True">
                            <LineSegment Point="258,39"/>
                            <LineSegment Point="258,315"/>
                            <LineSegment Point="240,333"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- ========== 主面板(白底) ========== -->
            <Border Canvas.Left="30" Canvas.Top="57" Width="210" Height="276" 
                    CornerRadius="3"
                    Background="{StaticResource BodyFrontGradient}" 
                    BorderBrush="#B4B2A9" BorderThickness="0.6"
                    Panel.ZIndex="2">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.16"
                                      RenderingBias="Performance"/>
                </Border.Effect>
            </Border>

            <!-- 左侧高光 -->
            <Border Canvas.Left="32" Canvas.Top="59" Width="7" Height="272" 
                    Background="White" Opacity="0.4"
                    Panel.ZIndex="3" IsHitTestVisible="False"/>

            <!-- 右侧暗影 -->
            <Border Canvas.Left="231" Canvas.Top="59" Width="7" Height="272" 
                    Background="#888780" Opacity="0.06"
                    Panel.ZIndex="3" IsHitTestVisible="False"/>

            <!-- ========== 顶部品牌深红标签条 ========== -->
            <Border x:Name="AccentBar"
                    Canvas.Left="37" Canvas.Top="63" Width="198" Height="14" 
                    CornerRadius="2"
                    Background="{StaticResource AccentRedGradient}"
                    Panel.ZIndex="10"/>

            <!-- 标签条文字 -->
            <TextBlock Canvas.Left="49" Canvas.Top="64" Panel.ZIndex="11"
                       Text="HTLAB  TempControl" 
                       FontFamily="Arial" FontSize="9" FontWeight="Bold"
                       Foreground="#FFFFFF"/>

            <TextBlock Canvas.Left="195" Canvas.Top="64" Panel.ZIndex="11"
                       Text="TC-2000" 
                       FontFamily="Arial" FontSize="8.5" FontWeight="Bold"
                       Foreground="#F4B4C0" Opacity="0.95"/>

            <!-- ========== LCD 屏区域 ========== -->
            <Canvas Canvas.Left="41" Canvas.Top="83" Panel.ZIndex="10">
                <!-- LCD 外框(状态色,代码动态切换) -->
                <Border x:Name="LCDFrame" Width="190" Height="100" 
                        CornerRadius="3"
                        Background="{StaticResource IdleFrameGradient}"
                        BorderThickness="1" BorderBrush="#1A1A1A">
                    <Border.Effect>
                        <DropShadowEffect x:Name="LCDFrameGlow"
                                          Color="Transparent" 
                                          BlurRadius="0" 
                                          ShadowDepth="0" 
                                          Opacity="0"
                                          RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>

                <!-- LCD 屏主体(深黑) -->
                <Border Canvas.Left="4" Canvas.Top="4" Width="182" Height="92" 
                        CornerRadius="2.5" Background="{StaticResource LCDScreenGradient}"/>

                <!-- LCD 顶部高光 -->
                <Border Canvas.Left="6" Canvas.Top="6" Width="178" Height="3" 
                        CornerRadius="1" Background="White" Opacity="0.06"/>

                <!-- 设定温度行 -->
                <TextBlock Canvas.Left="12" Canvas.Top="22" Text="SET" 
                           FontFamily="Arial" FontSize="9" Foreground="#888780" FontWeight="SemiBold"/>
                <TextBlock Canvas.Left="12" Canvas.Top="32" Text="设定温度" 
                           FontFamily="Microsoft YaHei" FontSize="8" Foreground="#5F5E5A"/>

                <TextBlock Canvas.Left="0" Canvas.Top="22" Width="160" Height="32"
                           x:Name="SetTempValue"
                           Text="{Binding SetTemperature, StringFormat={}{0:F1}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                           FontFamily="Consolas" FontSize="30" 
                           Foreground="#FF6680" FontWeight="Bold"
                           TextAlignment="Right"
                           Padding="0,0,30,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF6680" BlurRadius="3" ShadowDepth="0" Opacity="0.25"
                                          RenderingBias="Performance"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Canvas.Left="160" Canvas.Top="30" Text="°C" 
                           FontFamily="Times New Roman" FontSize="14" FontWeight="Bold"
                           Foreground="#F4B4C0"/>

                <!-- 红色光晕标识 -->
                <Border Canvas.Left="12" Canvas.Top="52" Width="10" Height="2" CornerRadius="0.8"
                        Background="#A41626" Opacity="0.7"/>

                <!-- 分隔线 -->
                <Line X1="12" Y1="58" X2="178" Y2="58" Stroke="#3A3A3A" StrokeThickness="0.4"/>

                <!-- 当前温度行 -->
                <TextBlock Canvas.Left="12" Canvas.Top="62" Text="PV" 
                           FontFamily="Arial" FontSize="9" Foreground="#888780" FontWeight="SemiBold"/>
                <TextBlock Canvas.Left="12" Canvas.Top="72" Text="当前温度" 
                           FontFamily="Microsoft YaHei" FontSize="8" Foreground="#5F5E5A"/>

                <TextBlock Canvas.Left="0" Canvas.Top="62" Width="160" Height="32"
                           Text="{Binding CurrentTemperature, StringFormat={}{0:F1}, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                           FontFamily="Consolas" FontSize="30" 
                           Foreground="#85B7EB" FontWeight="Bold"
                           TextAlignment="Right"
                           Padding="0,0,30,0">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#85B7EB" BlurRadius="3" ShadowDepth="0" Opacity="0.2"
                                          RenderingBias="Performance"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Canvas.Left="160" Canvas.Top="70" Text="°C" 
                           FontFamily="Times New Roman" FontSize="14" FontWeight="Bold"
                           Foreground="#B5D4F4"/>

                <!-- 蓝色光晕标识 -->
                <Border Canvas.Left="12" Canvas.Top="92" Width="10" Height="2" CornerRadius="0.8"
                        Background="#378ADD" Opacity="0.6"/>

                <!-- 屏幕状态覆盖层 -->
                <Border x:Name="ScreenOverlay" 
                        Canvas.Left="4" Canvas.Top="4" 
                        Width="182" Height="92" 
                        CornerRadius="2.5"
                        Background="Transparent" 
                        IsHitTestVisible="False"
                        Opacity="0"/>
            </Canvas>

            <!-- ========== ▲ ▼ 温度调节按钮 ========== -->
            <Canvas Canvas.Left="207" Canvas.Top="93" Panel.ZIndex="11">
                <Button Width="20" Height="14" Style="{StaticResource AdjustButtonStyle}"
                        Click="OnTempUpClick">
                    <Path Width="8" Height="5" Fill="#888780" Stretch="Uniform"
                          Data="M 4,0 L 0,5 L 8,5 Z"/>
                </Button>
                <Button Canvas.Top="16" Width="20" Height="14" Style="{StaticResource AdjustButtonStyle}"
                        Click="OnTempDownClick">
                    <Path Width="8" Height="5" Fill="#888780" Stretch="Uniform"
                          Data="M 4,5 L 0,0 L 8,0 Z"/>
                </Button>
            </Canvas>

            <!-- ========== 状态指示灯组(LCD 右侧) ========== -->
            <Canvas Canvas.Left="217" Canvas.Top="138" Panel.ZIndex="11">
                <!-- 运行指示灯 -->
                <Ellipse x:Name="RunningIndicator" Width="8" Height="8" Fill="#9E9E9E"/>
                <Ellipse x:Name="RunningIndicatorHighlight" 
                         Canvas.Left="2" Canvas.Top="2" Width="3" Height="3" 
                         Fill="#FFFFFF" Opacity="0.6"/>
                <TextBlock x:Name="StatusText" 
                           Canvas.Left="-2" Canvas.Top="11" 
                           Text="就绪" 
                           FontFamily="Microsoft YaHei" FontSize="7" 
                           Foreground="#5D6369" FontWeight="Medium"/>
            </Canvas>

            <!-- ========== 三个控制按钮 ========== -->
            <Canvas Canvas.Left="37" Canvas.Top="195" Panel.ZIndex="10">
                <Button x:Name="CirculationButton" Width="60" Height="36" 
                        Style="{StaticResource ModernButtonStyle}"
                        Click="OnCirculationClick">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- 循环图标(箭头圆环) -->
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Stroke="#5F5E5A" StrokeThickness="1.4" Fill="Transparent"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 12,6 A 6,6 0 1 1 6,0 M 12,6 L 9,3 M 12,6 L 9,9"
                              Margin="0,0,0,2"/>
                        <TextBlock Text="循环" 
                                   FontFamily="Microsoft YaHei" FontSize="11" 
                                   Foreground="#1A1A1A" FontWeight="Medium"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="HeatingButton" Canvas.Left="65" Width="60" Height="36" 
                        Style="{StaticResource ModernButtonStyle}"
                        Click="OnHeatingClick">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- 加热图标(温度计/火焰) -->
                        <Grid Width="14" Height="14" Margin="0,0,0,2">
                            <Path Width="10" Height="14" Stretch="Uniform"
                                  Fill="#A41626"
                                  Data="M 5,0 Q 2,4 2,7 Q 2,11 5,12 Q 8,11 8,7 Q 8,4 5,0 Z"/>
                            <Ellipse Width="4" Height="4" Fill="#FF6680"
                                     HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     Margin="0,0,0,2"/>
                        </Grid>
                        <TextBlock Text="加热" 
                                   FontFamily="Microsoft YaHei" FontSize="11" 
                                   Foreground="#1A1A1A" FontWeight="Medium"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="CoolingButton" Canvas.Left="130" Width="60" Height="36" 
                        Style="{StaticResource ModernButtonStyle}"
                        Click="OnCoolingClick">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- 雪花图标 -->
                        <Grid Width="14" Height="14" Margin="0,0,0,2">
                            <Line X1="7" Y1="0" X2="7" Y2="14" Stroke="#5F5E5A" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="0" Y1="7" X2="14" Y2="7" Stroke="#5F5E5A" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="2" Y1="2" X2="12" Y2="12" Stroke="#5F5E5A" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="2" Y1="12" X2="12" Y2="2" Stroke="#5F5E5A" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <TextBlock Text="制冷" 
                                   FontFamily="Microsoft YaHei" FontSize="11" 
                                   Foreground="#1A1A1A" FontWeight="Medium"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Canvas>

            <!-- ========== 通风格栅(精致版) ========== -->
            <Canvas Canvas.Left="37" Canvas.Top="241" Panel.ZIndex="10">
                <Border Width="198" Height="50" CornerRadius="3"
                        Background="#E8E5DD" BorderBrush="#B4B2A9" BorderThickness="0.5"/>
                <Border Canvas.Left="3" Canvas.Top="3" Width="192" Height="44" CornerRadius="2"
                        Background="#D3D1C7" BorderBrush="#B4B2A9" BorderThickness="0.3"/>

                <!-- 8 条金属横条 -->
                <Border Canvas.Left="6" Canvas.Top="6" Width="186" Height="2.5" CornerRadius="0.8" Background="{StaticResource VentBarGradient}"/>
                <Border Canvas.Left="6" Canvas.Top="11" Width="186" Height="2.5" CornerRadius="0.8" Background="{StaticResource VentBarGradient}"/>
                <Border Canvas.Left="6" Canvas.Top="16" Width="186" Height="2.5" CornerRadius="0.8" Background="{StaticResource VentBarGradient}"/>
                <Border Canvas.Left="6" Canvas.Top="21" Width="186" Height="2.5" CornerRadius="0.8" Background="{StaticResource VentBarGradient}"/>
                <Border Canvas.Left="6" Canvas.Top="26" Width="186" Height="2.5" CornerRadius="0.8" Background="{StaticResource VentBarGradient}"/>
                <Border Canvas.Left="6" Canvas.Top="31" Width="186" Height="2.5" CornerRadius="0.8" Background="{StaticResource VentBarGradient}"/>
                <Border Canvas.Left="6" Canvas.Top="36" Width="186" Height="2.5" CornerRadius="0.8" Background="{StaticResource VentBarGradient}"/>
                <Border Canvas.Left="6" Canvas.Top="41" Width="186" Height="2.5" CornerRadius="0.8" Background="{StaticResource VentBarGradient}"/>
            </Canvas>

            <!-- ========== 4 个角落十字螺丝 ========== -->
            <!-- 左上 -->
            <Canvas Canvas.Left="36" Canvas.Top="80" Panel.ZIndex="11">
                <Ellipse Width="6" Height="6" Fill="#888780" Stroke="#5F5E5A" StrokeThickness="0.4"/>
                <Line X1="1" Y1="3" X2="5" Y2="3" Stroke="#444441" StrokeThickness="0.5"/>
                <Line X1="3" Y1="1" X2="3" Y2="5" Stroke="#444441" StrokeThickness="0.5"/>
            </Canvas>
            <!-- 右上 -->
            <Canvas Canvas.Left="222" Canvas.Top="80" Panel.ZIndex="11">
                <Ellipse Width="6" Height="6" Fill="#888780" Stroke="#5F5E5A" StrokeThickness="0.4"/>
                <Line X1="1" Y1="3" X2="5" Y2="3" Stroke="#444441" StrokeThickness="0.5"/>
                <Line X1="3" Y1="1" X2="3" Y2="5" Stroke="#444441" StrokeThickness="0.5"/>
            </Canvas>
            <!-- 左下 -->
            <Canvas Canvas.Left="36" Canvas.Top="320" Panel.ZIndex="11">
                <Ellipse Width="6" Height="6" Fill="#888780" Stroke="#5F5E5A" StrokeThickness="0.4"/>
                <Line X1="1" Y1="3" X2="5" Y2="3" Stroke="#444441" StrokeThickness="0.5"/>
                <Line X1="3" Y1="1" X2="3" Y2="5" Stroke="#444441" StrokeThickness="0.5"/>
            </Canvas>
            <!-- 右下 -->
            <Canvas Canvas.Left="222" Canvas.Top="320" Panel.ZIndex="11">
                <Ellipse Width="6" Height="6" Fill="#888780" Stroke="#5F5E5A" StrokeThickness="0.4"/>
                <Line X1="1" Y1="3" X2="5" Y2="3" Stroke="#444441" StrokeThickness="0.5"/>
                <Line X1="3" Y1="1" X2="3" Y2="5" Stroke="#444441" StrokeThickness="0.5"/>
            </Canvas>

            <!-- ========== 底部品牌信息 ========== -->
            <TextBlock Canvas.Left="80" Canvas.Top="298" Panel.ZIndex="10"
                       Text="霍桐仪器 · PRECISION TEMP CONTROL" 
                       FontFamily="Times New Roman" FontSize="7" FontStyle="Italic"
                       Foreground="#888780" Opacity="0.55"/>

            <TextBlock Canvas.Left="106" Canvas.Top="310" Panel.ZIndex="10"
                       Text="Range -80~100°C · Δ0.1°C" 
                       FontFamily="Arial" FontSize="6"
                       Foreground="#888780" Opacity="0.45"/>

            <TextBlock Canvas.Left="225" Canvas.Top="320" Panel.ZIndex="10"
                       Text="CE" 
                       FontFamily="Arial" FontSize="6"
                       Foreground="#888780" Opacity="0.4"/>

            <!-- ========== 选择边框(由代码控制显示) ========== -->
            <Border x:Name="SelectionBorder"
                    Canvas.Left="28" Canvas.Top="55" 
                    Width="214" Height="280" 
                    CornerRadius="4"
                    BorderBrush="#A41626" BorderThickness="2"
                    Visibility="Collapsed"
                    Panel.ZIndex="200"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#A41626" BlurRadius="6" ShadowDepth="0" Opacity="0.3"
                                      RenderingBias="Performance"/>
                </Border.Effect>
            </Border>

        </Canvas>
    </Viewbox>
</UserControl>