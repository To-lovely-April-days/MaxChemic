<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.PipePropertyDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="500" Height="600">

    <UserControl.Resources>

        <!-- ═══ 主题色常量 ═══ -->
        <Color x:Key="AccentColor">#C41E3A</Color>
        <Color x:Key="AccentLightColor">#FEF1F3</Color>
        <Color x:Key="AccentHoverColor">#A8182F</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}"/>

        <!-- Gray 色阶 -->
        <SolidColorBrush x:Key="Gray50" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="Gray100" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="Gray200" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Gray300" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="Gray400" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="Gray500" Color="#6B7280"/>
        <SolidColorBrush x:Key="Gray600" Color="#4B5563"/>
        <SolidColorBrush x:Key="Gray700" Color="#374151"/>
        <SolidColorBrush x:Key="Gray800" Color="#1F2937"/>
        <SolidColorBrush x:Key="Gray900" Color="#111827"/>

        <!-- ═══ 色块按钮样式 ═══ -->
        <Style x:Key="ColorSwatchStyle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.08" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Gray500}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ToggleLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Gray700}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track"
                                    Background="{StaticResource Gray300}"
                                    CornerRadius="12"
                                    Height="24" Width="44"/>
                            <Border x:Name="Thumb"
                                    Background="White"
                                    CornerRadius="9"
                                    Width="18" Height="18"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource Gray400}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.06"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource Gray600}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DirectionButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="White"
                                BorderBrush="{StaticResource Gray200}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gray50}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource Gray600}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="White"
                                BorderBrush="{StaticResource Gray200}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Padding="24,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gray50}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gray300}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Padding="24,0">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource AccentColor}"/>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2"
                                                  Color="{StaticResource AccentColor}"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{StaticResource AccentHoverColor}"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.26"
                                                          Color="{StaticResource AccentColor}"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Gray400}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{StaticResource Gray100}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Gray200}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource Gray200}"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="16" Height="16" Fill="White"
                                                             Stroke="{StaticResource AccentBrush}"
                                                             StrokeThickness="2">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                                                              Opacity="0.12"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="White" CornerRadius="16"
            BorderBrush="{StaticResource Gray200}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.08" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0" Padding="20,14"
                    BorderBrush="{StaticResource Gray100}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,10,0"
                                 Fill="{StaticResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.26"
                                                  Color="{StaticResource AccentColor}"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Name="TbTitleLabel" Text="管道属性设置" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource Gray900}"/>
                    </StackPanel>

                    <Button x:Name="BtnClose" Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="OnCloseClick"/>
                </Grid>
            </Border>

            <!-- 实时预览 -->
            <Border Grid.Row="1" Margin="20,16,20,0" Padding="20,14,20,10"
                    CornerRadius="12"
                    BorderBrush="{StaticResource Gray200}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F9FAFB" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#F3F4F6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="12" Height="1.5" CornerRadius="1"
                                Background="{StaticResource AccentBrush}" Margin="0,0,6,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Name="TbPreviewLabel" Text="实 时 预 览" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"/>
                        <Border Width="12" Height="1.5" CornerRadius="1"
                                Background="{StaticResource AccentBrush}" Margin="6,0,0,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Center" Height="56">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <Canvas x:Name="PreviewCanvas"
                                    Width="440" Height="56"
                                    ClipToBounds="False"
                                    Background="Transparent"/>
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 选项卡栏 -->
            <Border Grid.Row="2" Margin="20,16,20,0"
                    Background="{StaticResource Gray100}"
                    CornerRadius="10" Padding="3">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="TabAppearance"
                                 Style="{StaticResource TabButtonStyle}"
                                 IsChecked="True"
                                 Checked="OnTabChanged"
                                 GroupName="DialogTabs">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="◆" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Name="TbAppearanceLabel" Text="管道外观" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabFluid"
                                 Style="{StaticResource TabButtonStyle}"
                                 Checked="OnTabChanged"
                                 GroupName="DialogTabs">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="◉" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Name="TbSettingLabel" Text="流体设置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabFlow"
                                 Style="{StaticResource TabButtonStyle}"
                                 Checked="OnTabChanged"
                                 GroupName="DialogTabs">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="▸" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Name="TbControlLabel" Text="流动控制" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>

            <!-- 选项卡内容区 -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          Margin="20,0,20,0" Padding="0,16,0,16">

                <Border Background="{StaticResource Gray50}" CornerRadius="12"
                        Padding="18" BorderBrush="{StaticResource Gray100}" BorderThickness="1">
                    <Grid>

                        <!-- ─── 管道外观 ─── -->
                        <StackPanel x:Name="PanelAppearance">
                            <TextBlock Name="TbBodyColorLabel" Text="管体颜色" Style="{StaticResource FieldLabelStyle}"/>
                            <WrapPanel x:Name="PipeColorPalette" Margin="0,0,0,16"/>

                            <TextBlock Name="TbFlangeColorLabel" Text="法兰颜色" Style="{StaticResource FieldLabelStyle}"/>
                            <WrapPanel x:Name="FlangeColorPalette"/>

                            <!-- ★ 默认样式提示（勾选时显示） -->
                            <Border x:Name="AppearanceLockedHint"
                                    Background="#FFF7E8"
                                    BorderBrush="#FFB84A"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,16,0,0"
                                    Visibility="Collapsed">
                                <TextBlock Text="⚡ 已启用默认流动样式 — 管体/法兰颜色由科技感样式接管"
                                           FontSize="11"
                                           Foreground="#7A4A00"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>

                        <!-- ─── 流体设置 ─── -->
                        <StackPanel x:Name="PanelFluid" Visibility="Collapsed">

                            <!-- ★★★ 默认流动样式开关 ★★★ -->
                            <Border Background="#FFF7E8"
                                    BorderBrush="#FFB84A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox x:Name="ChkUseDefaultStyle"
                                                  Content="使用默认流动样式（赛博风 · 推荐）"
                                                  FontSize="13"
                                                  FontWeight="SemiBold"
                                                  Foreground="#7A4A00"
                                                  Checked="OnUseDefaultStyleChanged"
                                                  Unchecked="OnUseDefaultStyleChanged"/>
                                    </DockPanel>
                                    <TextBlock Name="TbUseDefStyleText" Text="金属管壁 + 流光带 + 粒子辉光的科技效果。流体颜色、方向、流速仍可调整。"
                                               FontSize="11"
                                               Foreground="#996600"
                                               TextWrapping="Wrap"
                                               Margin="22,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 显示流体开关 -->
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Name="TbShowFlowLabel" Text="显示流体" Style="{StaticResource ToggleLabelStyle}"/>
                                <ToggleButton x:Name="ToggleFluidVisible"
                                              Style="{StaticResource ToggleStyle}"
                                              HorizontalAlignment="Right"
                                              Checked="OnFluidVisibleChanged"
                                              Unchecked="OnFluidVisibleChanged"/>
                            </DockPanel>

                            <StackPanel x:Name="FluidSettingsPanel">
                                <TextBlock Name="TbFlowColorLabel" Text="流体颜色" Style="{StaticResource FieldLabelStyle}"/>
                                <WrapPanel x:Name="FluidColorPalette" Margin="0,0,0,16"/>

                                <DockPanel x:Name="OpacityRow">
                                    <TextBlock Name="TbTransparencyLabel" Text="透明度" Style="{StaticResource FieldLabelStyle}"
                                               Margin="0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtOpacity" Text="50%"
                                               FontSize="13" Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Width="42" TextAlignment="Right"/>
                                    <Slider x:Name="SliderOpacity"
                                            Style="{StaticResource AccentSliderStyle}"
                                            Minimum="0.1" Maximum="1.0" Value="0.5"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Margin="12,0"
                                            ValueChanged="OnOpacityChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- ─── 流动控制 ─── -->
                        <StackPanel x:Name="PanelFlow" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,16">
                                <TextBlock Name="TbFlowStatusLabel" Text="流动状态" Style="{StaticResource ToggleLabelStyle}"/>
                                <ToggleButton x:Name="ToggleFlowing"
                                              Style="{StaticResource ToggleStyle}"
                                              HorizontalAlignment="Right"
                                              Checked="OnFlowingChanged"
                                              Unchecked="OnFlowingChanged"/>
                            </DockPanel>

                            <StackPanel x:Name="FlowControlPanel">
                                <TextBlock Name="TbFlowDirectionLabel" Text="流动方向" Style="{StaticResource FieldLabelStyle}"/>
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <RadioButton x:Name="RbLeftToRight"
                                                 Content="→  正向（左→右）"
                                                 Style="{StaticResource DirectionButtonStyle}"
                                                 IsChecked="True" Margin="0,0,4,0"
                                                 Checked="OnFlowDirectionChanged"/>
                                    <RadioButton x:Name="RbRightToLeft"
                                                 Content="←  反向（右→左）"
                                                 Style="{StaticResource DirectionButtonStyle}"
                                                 Margin="4,0,0,0"
                                                 Checked="OnFlowDirectionChanged"/>
                                </UniformGrid>

                                <DockPanel>
                                    <TextBlock Name="TbFlowVelocityLabel" Text="流速" Style="{StaticResource FieldLabelStyle}"
                                               Margin="0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSpeed" Text="1.0x"
                                               FontSize="13" Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Width="42" TextAlignment="Right"/>
                                    <Slider x:Name="SliderSpeed"
                                            Style="{StaticResource AccentSliderStyle}"
                                            Minimum="0.2" Maximum="5.0" Value="1.0"
                                            TickFrequency="0.2" IsSnapToTickEnabled="True"
                                            Margin="12,0"
                                            ValueChanged="OnSpeedChanged"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </Border>
            </ScrollViewer>

            <!-- 底部按钮 -->
            <Border Grid.Row="4" Padding="20,12,20,16"
                    BorderBrush="{StaticResource Gray100}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="取消"
                            Style="{StaticResource CancelButtonStyle}"
                            Margin="0,0,10,0" Click="OnCancelClick"/>
                    <Button x:Name="BtnApply" Content="确定"
                            Style="{StaticResource ConfirmButtonStyle}"
                            Click="OnApplyClick"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
