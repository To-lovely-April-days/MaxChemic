<base:DeviceScreenBase x:Class="MaxChemical.Modules.Designer.Views.Controls.Screens.JingRuiPumpScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:base="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             mc:Ignorable="d"
             Height="620" Width="1240">

    <!--
        精睿系列柱塞泵(杭州精进科技)控制屏 · RS485 标准 Modbus 协议。

        界面照泵机身上那块触摸屏的样子做:深色机身包一块浅蓝 HMI 屏,
        顶部标题条 → 三个页签(流量/压力/状态) → 右侧常驻动作键 → 底部状态栏。
        操作工在软件上看到的和在泵面板上看到的是同一套布局,不用二次学习。

        读:轮询「获取所有数据」—— 2~3 帧 FC03(实时压力 / 系统状态·实时流量·故障 / 设定流量回显)。
        写:每个操作对应驱动里的一条命令,屏幕不自己拼报文。

        右侧「运行」走的是「按流量启动」而不是裸的「启动泵」——
        手册明确建议启动前先下发流量、读回比对再启动,否则泵可能按屏幕存在 Flash 里的旧流量运行。
    -->

    <base:DeviceScreenBase.Resources>

        <!-- ═══ HMI 配色 ═══ -->
        <SolidColorBrush x:Key="ScreenBg"    Color="#F2F7FC"/>
        <SolidColorBrush x:Key="ScreenLine"  Color="#9BB3C9"/>
        <SolidColorBrush x:Key="TabStripBg"  Color="#C4D8EA"/>
        <SolidColorBrush x:Key="TabIdle"     Color="#A6C2DC"/>
        <SolidColorBrush x:Key="StatusBg"    Color="#DCE7F2"/>
        <SolidColorBrush x:Key="InkStrong"   Color="#16324B"/>
        <SolidColorBrush x:Key="InkMuted"    Color="#5A7690"/>

        <LinearGradientBrush x:Key="TitleBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B8FC7" Offset="0"/>
            <GradientStop Color="#3E72AE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="KeyBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#5B93CC" Offset="0"/>
            <GradientStop Color="#3A6EA5" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="KeyRunBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3FAE79" Offset="0"/>
            <GradientStop Color="#26855A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="KeyStopBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D2604F" Offset="0"/>
            <GradientStop Color="#AA4133" Offset="1"/>
        </LinearGradientBrush>

        <!-- ═══ 输入框:HMI 上的白底数值框 ═══ -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ScreenLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource InkStrong}"/>
            <Setter Property="CaretBrush" Value="#16324B"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <!-- 只读数值框:和输入框同一外观,但明确不可编辑 -->
        <Style x:Key="ReadoutBox" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ScreenLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource InkStrong}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <Style x:Key="LedCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource InkStrong}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>

        <!-- ═══ 页签:照面板做成上凸的梯形块 ═══ -->
        <Style x:Key="HmiTabItem" TargetType="TabItem">
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Width="176" Height="40" Margin="6,6,0,0"
                                CornerRadius="4,4,0,0"
                                Background="{StaticResource TabIdle}"
                                BorderBrush="{StaticResource ScreenLine}"
                                BorderThickness="1,1,1,0">
                            <TextBlock x:Name="tx" Text="{TemplateBinding Header}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="16" Foreground="#2A4A66"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ScreenBg}"/>
                                <Setter TargetName="bd" Property="Height" Value="46"/>
                                <Setter TargetName="bd" Property="Margin" Value="6,0,0,0"/>
                                <Setter TargetName="tx" Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="tx" Property="Foreground" Value="#16324B"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="#B5CFE5"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ 动作键:面板右侧那一列 ═══ -->
        <Style x:Key="HmiKey" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Background" Value="{StaticResource KeyBg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#2C5680" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 页内小按钮(下发/读取) -->
        <Style x:Key="HmiSmallKey" TargetType="Button" BasedOn="{StaticResource HmiKey}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

    </base:DeviceScreenBase.Resources>

    <!-- ══════════════════ 机身 ══════════════════ -->
    <Border Background="#1E2226" Padding="22">
        <Border Background="{StaticResource ScreenBg}" CornerRadius="4"
                BorderBrush="#0F1418" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>

                <!-- ══════ 标题条 ══════ -->
                <Border Grid.Row="0" Background="{StaticResource TitleBg}">
                    <Grid Margin="18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Name="TbTitle" Text="精睿进料泵"
                                       FontFamily="Microsoft YaHei" FontSize="21" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Name="TbMeta" Text="RS485 · Modbus RTU"
                                       FontFamily="Microsoft YaHei" FontSize="13"
                                       Foreground="#CFE2F5" VerticalAlignment="Bottom"
                                       Margin="14,0,0,3"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Ellipse Name="LedPower" Width="11" Height="11" Fill="#7FA9CF"/>
                            <TextBlock Name="TbRunState" Text="--"
                                       FontFamily="Microsoft YaHei" FontSize="15" FontWeight="Bold"
                                       Foreground="White" Margin="8,0,0,0"/>
                            <Rectangle Width="1" Height="20" Fill="#7FFFFFFF" Margin="16,0"/>
                            <TextBlock Name="TbComm" Text="通讯:--"
                                       FontFamily="Microsoft YaHei" FontSize="13"
                                       Foreground="#CFE2F5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════ 页签区 + 右侧动作键 ══════ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="212"/>
                    </Grid.ColumnDefinitions>

                    <TabControl Name="MainTabs" Grid.Column="0" BorderThickness="0"
                                Background="{StaticResource TabStripBg}" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabPanel">
                                <Setter Property="Background" Value="{StaticResource TabStripBg}"/>
                            </Style>
                        </TabControl.Resources>

                        <!-- ─────────── 页签一:流量 ─────────── -->
                        <TabItem Header="流量" Style="{StaticResource HmiTabItem}">
                            <Border Background="{StaticResource ScreenBg}"
                                    BorderBrush="{StaticResource ScreenLine}" BorderThickness="1,1,0,0">
                                <Grid Margin="28,24,28,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 实时流量:大字读数 -->
                                    <Border Grid.Row="0" Background="White"
                                            BorderBrush="{StaticResource ScreenLine}" BorderThickness="1"
                                            Padding="20,14">
                                        <Grid>
                                            <TextBlock Text="实时流量" Style="{StaticResource FieldLabel}"
                                                       VerticalAlignment="Top"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock Name="TbFlowBig" Text="--"
                                                           FontFamily="Consolas" FontSize="52" FontWeight="Bold"
                                                           Foreground="#0E6B4F"/>
                                                <TextBlock Text="mL/min" FontFamily="Microsoft YaHei" FontSize="15"
                                                           Foreground="{StaticResource InkMuted}"
                                                           VerticalAlignment="Bottom" Margin="10,0,0,10"/>
                                            </StackPanel>
                                            <TextBlock Name="TbFlowSvHint" Text="设定 -- mL/min"
                                                       FontFamily="Microsoft YaHei" FontSize="13"
                                                       Foreground="{StaticResource InkMuted}"
                                                       VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>

                                    <!-- 流量设定 -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="流量设定" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Name="TbSetFlow" Text="--"
                                                 KeyDown="TbSetFlow_KeyDown"/>
                                        <TextBlock Grid.Column="2" Text="mL/min" Style="{StaticResource UnitLabel}"/>
                                        <Button Grid.Column="4" Name="BtnSetFlow" Content="下 发"
                                                Style="{StaticResource HmiSmallKey}" Click="BtnSetFlow_Click"/>
                                    </Grid>

                                    <!-- 定量输送 -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="定量体积" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Name="TbDoseVolume" Text="10"/>
                                        <TextBlock Grid.Column="2" Text="mL" Style="{StaticResource UnitLabel}"/>
                                        <Button Grid.Column="4" Name="BtnDose" Content="定量启动"
                                                Style="{StaticResource HmiSmallKey}" Click="BtnDose_Click"/>
                                    </Grid>

                                    <TextBlock Grid.Row="5" VerticalAlignment="Bottom"
                                               FontFamily="Microsoft YaHei" FontSize="12"
                                               Foreground="{StaticResource InkMuted}" TextWrapping="Wrap"
                                               Text="定量按当前设定流量送完指定体积后自行停止;中途要停用右侧「停止」。"/>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- ─────────── 页签二:压力 ─────────── -->
                        <TabItem Header="压力" Style="{StaticResource HmiTabItem}">
                            <Border Background="{StaticResource ScreenBg}"
                                    BorderBrush="{StaticResource ScreenLine}" BorderThickness="1,1,0,0">
                                <Grid Margin="28,24,28,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 实时压力:大字读数 + 量程条 -->
                                    <Border Grid.Row="0" Background="White"
                                            BorderBrush="{StaticResource ScreenLine}" BorderThickness="1"
                                            Padding="20,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="14"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <TextBlock Text="实时压力" Style="{StaticResource FieldLabel}"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Name="TbPressureBig" Text="--"
                                                               FontFamily="Consolas" FontSize="52" FontWeight="Bold"
                                                               Foreground="#B5701A"/>
                                                    <TextBlock Text="MPa" FontFamily="Microsoft YaHei" FontSize="15"
                                                               Foreground="{StaticResource InkMuted}"
                                                               VerticalAlignment="Bottom" Margin="10,0,0,10"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 量程条:填充=实测,红线=上限 -->
                                            <Grid Grid.Row="2" Height="16">
                                                <Rectangle Fill="#E4EBF1" Stroke="{StaticResource ScreenLine}"
                                                           StrokeThickness="1" RadiusX="3" RadiusY="3"/>
                                                <Canvas ClipToBounds="True">
                                                    <Rectangle Name="PressureBar" Height="14" Width="0"
                                                               Canvas.Left="1" Canvas.Top="1"
                                                               RadiusX="2" RadiusY="2">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#3FAE79" Offset="0"/>
                                                                <GradientStop Color="#D8A33D" Offset="0.75"/>
                                                                <GradientStop Color="#D2604F" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <Rectangle Name="PressureLimitTick" Width="2" Height="20"
                                                               Canvas.Left="0" Canvas.Top="-2" Fill="#C0392B"/>
                                                </Canvas>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- 压力上限 -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="报警上限" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Name="TbPressureMax" Text="--"/>
                                        <TextBlock Grid.Column="2" Text="MPa" Style="{StaticResource UnitLabel}"/>
                                        <Button Grid.Column="4" Name="BtnPressureLimit" Content="下 发"
                                                Style="{StaticResource HmiSmallKey}" Click="BtnPressureLimit_Click"/>
                                    </Grid>

                                    <!-- 压力下限 -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="报警下限" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" Name="TbPressureMin" Text="--"/>
                                        <TextBlock Grid.Column="2" Text="MPa" Style="{StaticResource UnitLabel}"/>
                                        <Button Grid.Column="4" Name="BtnZero" Content="压力校零"
                                                Style="{StaticResource HmiSmallKey}" Click="BtnZero_Click"/>
                                    </Grid>

                                    <TextBlock Grid.Row="5" VerticalAlignment="Bottom"
                                               FontFamily="Microsoft YaHei" FontSize="12"
                                               Foreground="#A0522D" TextWrapping="Wrap"
                                               Text="改上限务必确认不超过泵本体最大压力,否则可能损坏泵;部分泵型另有最低压力运行限值,下限不要随手写 0。校零须在停泵且管路完全泄压后做。"/>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- ─────────── 页签三:状态 ─────────── -->
                        <TabItem Header="状态" Style="{StaticResource HmiTabItem}">
                            <Border Background="{StaticResource ScreenBg}"
                                    BorderBrush="{StaticResource ScreenLine}" BorderThickness="1,1,0,0">
                                <Grid Margin="28,24,28,24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 概要行 -->
                                    <Border Grid.Row="0" Background="White"
                                            BorderBrush="{StaticResource ScreenLine}" BorderThickness="1"
                                            Padding="20,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="系统状态" Style="{StaticResource UnitLabel}" Margin="0"/>
                                                <TextBlock Name="TbStateSummary" Text="--"
                                                           FontFamily="Microsoft YaHei" FontSize="20" FontWeight="Bold"
                                                           Foreground="{StaticResource InkStrong}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="故障码" Style="{StaticResource UnitLabel}" Margin="0"/>
                                                <TextBlock Name="TbFaultTop" Text="--"
                                                           FontFamily="Microsoft YaHei" FontSize="20" FontWeight="Bold"
                                                           Foreground="{StaticResource InkStrong}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="序列号后四位" Style="{StaticResource UnitLabel}" Margin="0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Name="TbSerial" Text="----"
                                                               FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                                                               Foreground="{StaticResource InkStrong}"/>
                                                    <Button Name="BtnReadSerial" Content="读取" Width="64"
                                                            Style="{StaticResource HmiSmallKey}"
                                                            Margin="14,0,0,0" Click="BtnReadSerial_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 指示灯组 -->
                                    <Border Grid.Row="2" Background="White"
                                            BorderBrush="{StaticResource ScreenLine}" BorderThickness="1"
                                            Padding="24,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="34"/>
                                                <RowDefinition Height="34"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Name="LedRunning" Width="13" Height="13" Fill="#C8D4DE"/>
                                                <TextBlock Text="运行中" Style="{StaticResource LedCaption}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Name="LedDosing" Width="13" Height="13" Fill="#C8D4DE"/>
                                                <TextBlock Text="定量输送中" Style="{StaticResource LedCaption}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Name="LedHighPressure" Width="13" Height="13" Fill="#C8D4DE"/>
                                                <TextBlock Text="压力超上限" Style="{StaticResource LedCaption}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                                                <Ellipse Name="LedLowPressure" Width="13" Height="13" Fill="#C8D4DE"/>
                                                <TextBlock Text="压力超下限" Style="{StaticResource LedCaption}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                <Ellipse Name="LedCircuit" Width="13" Height="13" Fill="#C8D4DE"/>
                                                <TextBlock Text="电路故障" Style="{StaticResource LedCaption}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                                <Ellipse Name="LedPumpBody" Width="13" Height="13" Fill="#C8D4DE"/>
                                                <TextBlock Text="泵体故障" Style="{StaticResource LedCaption}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                                <Ellipse Name="LedDriver" Width="13" Height="13" Fill="#C8D4DE"/>
                                                <TextBlock Text="驱动器故障" Style="{StaticResource LedCaption}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <TextBlock Grid.Row="3" Margin="0,14,0,0"
                                               FontFamily="Microsoft YaHei" FontSize="12"
                                               Foreground="{StaticResource InkMuted}" TextWrapping="Wrap"
                                               Text="「故障消除」只清标志不解决成因,超压/欠压的根因(堵塞、漏液、限值设置不当)不排除的话,重启后会再次报警。"/>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>

                    <!-- ══════ 右侧常驻动作键 ══════ -->
                    <Border Grid.Column="1" Background="{StaticResource TabStripBg}"
                            BorderBrush="{StaticResource ScreenLine}" BorderThickness="1,0,0,0">
                        <StackPanel Margin="16,14,16,14">
                            <Button Name="BtnStart" Content="运 行"
                                    Background="{StaticResource KeyRunBg}"
                                    Style="{StaticResource HmiKey}" Click="BtnStart_Click"/>
                            <Button Name="BtnStop" Content="停 止"
                                    Background="{StaticResource KeyStopBg}"
                                    Style="{StaticResource HmiKey}" Click="BtnStop_Click"/>
                            <Button Name="BtnClearFault" Content="故障消除"
                                    Style="{StaticResource HmiKey}" Click="BtnClearFault_Click"/>

                            <Rectangle Height="1" Fill="{StaticResource ScreenLine}" Margin="0,6,0,14"/>

                            <TextBlock Text="设定流量" FontFamily="Microsoft YaHei" FontSize="12"
                                       Foreground="{StaticResource InkMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Name="TbFlowSvSide" Text="--"
                                       FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource InkStrong}"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock Text="mL/min" FontFamily="Microsoft YaHei" FontSize="11"
                                       Foreground="{StaticResource InkMuted}" HorizontalAlignment="Center"/>

                            <TextBlock Name="TbPressureLimitHint" Text="限值 -- / -- MPa"
                                       FontFamily="Microsoft YaHei" FontSize="12"
                                       Foreground="{StaticResource InkMuted}"
                                       HorizontalAlignment="Center" Margin="0,16,0,0"
                                       TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══════ 底部状态栏 ══════ -->
                <Border Grid.Row="2" Background="{StaticResource StatusBg}"
                        BorderBrush="{StaticResource ScreenLine}" BorderThickness="0,1,0,0">
                    <Grid Margin="18,0">
                        <TextBlock Name="TbCmdHint" Text="就绪"
                                   FontFamily="Microsoft YaHei" FontSize="13"
                                   Foreground="{StaticResource InkStrong}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Border>
</base:DeviceScreenBase>
