<base:DeviceScreenBase x:Class="MaxChemical.Modules.Designer.Views.Controls.Screens.MagneticStirrerScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views.Controls.Screens"
             xmlns:base="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             xmlns:ctrl="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             mc:Ignorable="d"
             Height="620" Width="1240">

    <!--
        加热磁力搅拌器控制屏。
        读:轮询「获取所有数据」(一次 FC03 读 16 个寄存器)。
        写:只有驱动的那两条合并指令 ——
          「温度控制」= 温度设定值 + 温度开关
          「搅拌控制」= 时间设定 + 速度设定 + 速度开关
        所以改设定值和按开关走的是同一条指令,另一半参数用屏幕上的当前值补齐。
    -->

    <base:DeviceScreenBase.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#3EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#B0FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LedCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8FFFFFFF"/>
            <Setter Property="Margin" Value="6,0,18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 开关按钮:靠 Tag 切换配色(off=灰 / on=亮) -->
        <Style x:Key="SwitchButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="#3A4147">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background" Value="#C0392B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </base:DeviceScreenBase.Resources>

    <Canvas>
        <Canvas.Background>
            <RadialGradientBrush GradientOrigin="0.16,0.14" Center="0.16,0.14" RadiusX="0.95" RadiusY="0.95">
                <GradientStop Color="#1E3340" Offset="0"/>
                <GradientStop Color="#12212B" Offset="0.42"/>
                <GradientStop Color="#08090C" Offset="0.85"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <!-- ══════════ 标题 ══════════ -->
        <StackPanel Canvas.Left="40" Canvas.Top="24">
            <TextBlock Name="TbTitle" Text="磁力搅拌器" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock Name="TbMeta" Text="加热磁力搅拌器 · Modbus RTU" FontSize="13" Foreground="#8FFFFFFF" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ══════════ 顶部信息条 ══════════ -->
        <Border Canvas.Left="430" Canvas.Top="22" Width="770" Height="58"
                BorderBrush="#4D788C9B" BorderThickness="1" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="外置温度" Style="{StaticResource LabelText}"/>
                <TextBlock Name="TbExtTemp" Text="--" FontSize="20" FontWeight="Bold" Foreground="#FFEF9F27"
                           VerticalAlignment="Center" Margin="8,0,2,0"/>
                <TextBlock Text="℃" Style="{StaticResource LabelText}" FontSize="12"/>

                <Rectangle Margin="26,0" Width="1" Height="26" Fill="#33FFFFFF"/>

                <TextBlock Text="内置温度" Style="{StaticResource LabelText}"/>
                <TextBlock Name="TbIntTemp" Text="--" FontSize="20" FontWeight="Bold" Foreground="#FFD08A3B"
                           VerticalAlignment="Center" Margin="8,0,2,0"/>
                <TextBlock Text="℃" Style="{StaticResource LabelText}" FontSize="12"/>

                <Rectangle Margin="26,0" Width="1" Height="26" Fill="#33FFFFFF"/>

                <TextBlock Text="计时" Style="{StaticResource LabelText}"/>
                <TextBlock Name="TbTimer" Text="--:--:--" FontSize="20" FontWeight="Bold" Foreground="#FF9FD8C4"
                           FontFamily="Consolas" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <Rectangle Margin="26,0" Width="1" Height="26" Fill="#33FFFFFF"/>

                <TextBlock Name="TbComm" Text="通讯:--" Style="{StaticResource LabelText}"/>
            </StackPanel>
        </Border>

        <!-- ══════════ 左:温度表盘(0~上限,上限取设备回读的温度最大设定值) ══════════ -->
        <Canvas Width="212" Height="106" Canvas.Left="60" Canvas.Top="120" ClipToBounds="True">
            <Path Stroke="#3A4147" StrokeThickness="12">
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="6,106">
                                <ArcSegment Size="100,100" Point="206,106" SweepDirection="Clockwise"/>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
            <Path Stroke="#FFEF9F27" StrokeThickness="12" RenderTransformOrigin="0.5,1">
                <Path.RenderTransform>
                    <RotateTransform x:Name="ArcTemp" Angle="-180"/>
                </Path.RenderTransform>
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="6,106">
                                <ArcSegment Size="100,100" Point="206,106" SweepDirection="Clockwise"/>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
            <!-- SV 指针 -->
            <Path Stroke="#FFFFFFFF" StrokeThickness="2" RenderTransformOrigin="0.5,1" Opacity="0.75">
                <Path.RenderTransform>
                    <RotateTransform x:Name="NeedleTempSv" Angle="-180"/>
                </Path.RenderTransform>
                <Path.Data>
                    <LineGeometry StartPoint="6,106" EndPoint="24,106"/>
                </Path.Data>
            </Path>
            <TextBlock Name="TbTempScale0" Text="0" Foreground="#7FFFFFFF" Canvas.Left="26" Canvas.Top="88" FontSize="12"/>
            <TextBlock Name="TbTempScaleMax" Text="320" Foreground="#7FFFFFFF" Canvas.Left="164" Canvas.Top="88" FontSize="12"/>
            <TextBlock Text="温度 PV" Foreground="#FFEF9F27" Canvas.Left="82" Canvas.Top="88" FontSize="12"/>
        </Canvas>
        <StackPanel Canvas.Left="60" Canvas.Top="232" Width="212" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Name="TbTempBig" Text="--" FontSize="42" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="℃" Foreground="White" VerticalAlignment="Bottom" FontSize="16" Margin="6,0,0,8"/>
            </StackPanel>
            <TextBlock Name="TbTempSvHint" Text="设定 -- ℃" FontSize="13" Foreground="#B0FFFFFF" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ══════════ 左:转速表盘 ══════════ -->
        <Canvas Width="212" Height="106" Canvas.Left="60" Canvas.Top="330" ClipToBounds="True">
            <Path Stroke="#3A4147" StrokeThickness="12">
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="6,106">
                                <ArcSegment Size="100,100" Point="206,106" SweepDirection="Clockwise"/>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
            <Path Stroke="#FF5DCAA5" StrokeThickness="12" RenderTransformOrigin="0.5,1">
                <Path.RenderTransform>
                    <RotateTransform x:Name="ArcSpeed" Angle="-180"/>
                </Path.RenderTransform>
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="6,106">
                                <ArcSegment Size="100,100" Point="206,106" SweepDirection="Clockwise"/>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
            <Path Stroke="#FFFFFFFF" StrokeThickness="2" RenderTransformOrigin="0.5,1" Opacity="0.75">
                <Path.RenderTransform>
                    <RotateTransform x:Name="NeedleSpeedSv" Angle="-180"/>
                </Path.RenderTransform>
                <Path.Data>
                    <LineGeometry StartPoint="6,106" EndPoint="24,106"/>
                </Path.Data>
            </Path>
            <TextBlock Text="0" Foreground="#7FFFFFFF" Canvas.Left="26" Canvas.Top="88" FontSize="12"/>
            <TextBlock Text="2000" Foreground="#7FFFFFFF" Canvas.Left="160" Canvas.Top="88" FontSize="12"/>
            <TextBlock Text="转速 PV" Foreground="#FF5DCAA5" Canvas.Left="82" Canvas.Top="88" FontSize="12"/>
        </Canvas>
        <StackPanel Canvas.Left="60" Canvas.Top="442" Width="212" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Name="TbSpeedBig" Text="--" FontSize="42" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="rpm" Foreground="White" VerticalAlignment="Bottom" FontSize="16" Margin="6,0,0,8"/>
            </StackPanel>
            <TextBlock Name="TbSpeedSvHint" Text="设定 -- rpm" FontSize="13" Foreground="#B0FFFFFF" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ══════════ 中:设备示意(复用画布自定义控件,纯装饰不接受点击) ══════════ -->
        <Viewbox Canvas.Left="320" Canvas.Top="110" Width="440" Height="330" Stretch="Uniform">
            <ctrl:MagneticStirrerControl x:Name="StirrerVisual" IsHitTestVisible="False"/>
        </Viewbox>
        <TextBlock Canvas.Left="320" Canvas.Top="448" Width="440" TextAlignment="Center"
                   Name="TbVisualHint" Text="加热关 · 搅拌关"
                   FontSize="14" Foreground="#8FFFFFFF"/>

        <!-- ══════════ 右:控制区 ══════════ -->
        <Border Canvas.Left="800" Canvas.Top="110" Width="400" Height="368"
                BorderBrush="#4D788C9B" BorderThickness="1" CornerRadius="8">
            <StackPanel Margin="20,16">

                <!-- 温度设定 + 加热开关 -->
                <TextBlock Text="温度设定(回车下发)" Style="{StaticResource LabelText}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="TbSetTemp" Text="--" KeyDown="TbSetTemp_KeyDown"/>
                    <TextBlock Grid.Column="1" Text="℃" Style="{StaticResource LabelText}"
                               HorizontalAlignment="Center"/>
                    <Button Grid.Column="2" Name="BtnHeat" Height="40" Content="加热 关"
                            Style="{StaticResource SwitchButton}" Click="BtnHeat_Click"/>
                </Grid>

                <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,18"/>

                <!-- 转速设定 + 搅拌开关 -->
                <TextBlock Text="转速设定(回车下发)" Style="{StaticResource LabelText}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Name="TbSetSpeed" Text="--" KeyDown="TbSetSpeed_KeyDown"/>
                    <TextBlock Grid.Column="1" Text="rpm" Style="{StaticResource LabelText}" FontSize="12"
                               HorizontalAlignment="Center"/>
                    <Button Grid.Column="2" Name="BtnStir" Height="40" Content="搅拌 关"
                            Style="{StaticResource SwitchButton}" Click="BtnStir_Click"/>
                </Grid>

                <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,18"/>

                <!-- 定时设定(与转速同属「搅拌控制」一条指令) -->
                <TextBlock Text="定时设定(0:0:0 为不定时,回车下发)" Style="{StaticResource LabelText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox Name="TbSetHour" Width="70" Text="0" KeyDown="TbSetTime_KeyDown"/>
                    <TextBlock Text="时" Style="{StaticResource LabelText}" Margin="6,0,12,0"/>
                    <TextBox Name="TbSetMinute" Width="70" Text="0" KeyDown="TbSetTime_KeyDown"/>
                    <TextBlock Text="分" Style="{StaticResource LabelText}" Margin="6,0,12,0"/>
                    <TextBox Name="TbSetSecond" Width="70" Text="0" KeyDown="TbSetTime_KeyDown"/>
                    <TextBlock Text="秒" Style="{StaticResource LabelText}" Margin="6,0,0,0"/>
                </StackPanel>

                <TextBlock Name="TbCmdHint" Text=" " FontSize="13" Foreground="#FF9FD8C4"
                           Margin="0,16,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ══════════ 底部:状态位指示灯 ══════════ -->
        <Border Canvas.Left="40" Canvas.Top="505" Width="1160" Height="76"
                BorderBrush="#4D788C9B" BorderThickness="1" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Name="LedHeating" Width="14" Height="14" Fill="#FF3A4147"/>
                <TextBlock Text="加热输出" Style="{StaticResource LedCaption}"/>

                <Ellipse Name="LedTimerFinished" Width="14" Height="14" Fill="#FF3A4147"/>
                <TextBlock Text="定时结束" Style="{StaticResource LedCaption}"/>

                <Ellipse Name="LedExtTempAlarm" Width="14" Height="14" Fill="#FF3A4147"/>
                <TextBlock Text="外置温度异常" Style="{StaticResource LedCaption}"/>

                <Ellipse Name="LedIntTempAlarm" Width="14" Height="14" Fill="#FF3A4147"/>
                <TextBlock Text="内置温度异常" Style="{StaticResource LedCaption}"/>

                <Ellipse Name="LedUpperDeviation" Width="14" Height="14" Fill="#FF3A4147"/>
                <TextBlock Text="上偏差" Style="{StaticResource LedCaption}"/>

                <Ellipse Name="LedSensorFallOff" Width="14" Height="14" Fill="#FF3A4147"/>
                <TextBlock Text="传感器脱落" Style="{StaticResource LedCaption}"/>

                <Ellipse Name="LedIntTempProtect" Width="14" Height="14" Fill="#FF3A4147"/>
                <TextBlock Text="内置温度保护" Style="{StaticResource LedCaption}"/>

                <Ellipse Name="LedMotorHallFault" Width="14" Height="14" Fill="#FF3A4147"/>
                <TextBlock Text="电机霍尔故障" Style="{StaticResource LedCaption}"/>
            </StackPanel>
        </Border>
    </Canvas>
</base:DeviceScreenBase>
