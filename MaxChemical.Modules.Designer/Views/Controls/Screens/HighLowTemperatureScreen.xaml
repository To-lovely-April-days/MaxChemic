        </Canvas>-->

        <!--中心渐变园-->
        <Ellipse Width="210" Height="210" Canvas.Left="503" Canvas.Top="156">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="Black"/>
                    <GradientStop Color="Black" Offset="0.3"/>
                    <GradientStop Color="#FF48CD32" Offset="0.9"/>
                    <GradientStop Color="#FF31FF0E" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!--旋转圆环-->
        <Path Canvas.Left="478" Canvas.Top="131.16" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF6CFF00"/>
                    <GradientStop Color="#8F39AB2E" Offset="0.5"/>
                    <GradientStop Color="#FF6CFF00" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
            <Path.RenderTransform>
                <RotateTransform x:Name="CircleRotate" Angle="0"/>
            </Path.RenderTransform>
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <EllipseGeometry RadiusX="115" RadiusY="115" Center="130,130"/>
                    <EllipseGeometry RadiusX="130" RadiusY="130" Center="130,130"/>
                </GeometryGroup>
            </Path.Data>
        </Path>

        <!--旋转椭圆环-->
        <Path Canvas.Left="452.666" Canvas.Top="116.16" RenderTransformOrigin="0.5,0.5">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF4CFF00"/>
                    <GradientStop Color="#0039AB2E" Offset="0.3"/>
                    <GradientStop Color="#0039AB2E" Offset="0.7"/>
                    <GradientStop Color="#FF4CFF00" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
            <Path.RenderTransform>
                <RotateTransform x:Name="EllipseRotate" Angle="30"/>
            </Path.RenderTransform>
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <EllipseGeometry RadiusX="140" RadiusY="140" Center="155,145"/>
                    <EllipseGeometry RadiusX="155" RadiusY="145" Center="155,145"/>
                </GeometryGroup>
            </Path.Data>
        </Path>

        <!--物料温度-->
        <Border Canvas.Left="900" Canvas.Top="209" Width="180" Height="240"  BorderBrush="#4D788C9B" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <Image Source="pack://siteoforigin:,,,/Resources/Screens/highlow_temp.png" Margin="4,0"/>
                <TextBlock Grid.Column="1" Text="设定温度" FontSize="16" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="℃" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBox Name="TbSetSv" Grid.Row="1" Grid.ColumnSpan="3" Text="9999.00" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"
                         KeyDown="TbSetSv_KeyDown"/>
                <!--物料温度-->
                <TextBlock Grid.Row="2" Grid.Column="1" Text="物料温度" FontSize="16" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="℃" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Name="TbMaterial" Grid.Row="3" Grid.ColumnSpan="3" Text="0.00" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <!--回口温度-->
                <TextBlock Grid.Row="4" Grid.Column="1" Text="回口温度" FontSize="16" Foreground="White" Margin="8,0,0,0"  VerticalAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="℃" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Name="TbBack" Grid.Row="5" Grid.ColumnSpan="3" Text="0.00" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!--出口温度-->
        <Grid Canvas.Left="508" Canvas.Top="217" Width="200" Height="100" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Name="TbOutlet" Text="0.00" FontSize="40" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Margin="4,8" Text="℃" Foreground="White" VerticalAlignment="Bottom"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="出口温度" FontSize="16" Foreground="White" Margin="4" HorizontalAlignment="Center"/>
        </Grid>

        <!--加液排空-->
        <Border Canvas.Left="900" Canvas.Top="64" Width="180" Height="100" BorderBrush="#4D788C9B" BorderThickness="1" CornerRadius="8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="加液排空" FontSize="16" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Button Name="BtnOnOff" Grid.Row="1" Grid.Column="1"
                        Cursor="Hand"
                        Content="ON" 
                        Style="{StaticResource SwitchButtonStyle}"
                        Click="Button_Click"/>
            </Grid>
        </Border>

        <!--运行/停止按钮-->
        <Button Name="BtnRunStop"
                Width="180"
                Height="53"
                Canvas.Left="900"
                Canvas.Top="500"
                Content="运行"
                Cursor="Hand"
                Click="BtnRunStop_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="8" Background="LimeGreen">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Path x:Name="path" Data="M 1,1 L 15,11 1,21 Z" Fill="White" Stroke="White"
                                              Margin="8" StrokeThickness="6" StrokeLineJoin="Round"
                                              VerticalAlignment="Center"/>
                                        <TextBlock x:Name="runstop"
                                                   Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent},Path=Content}"
                                                   FontSize="24" Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=runstop,Path=Text}" Value="运行">
                                        <Setter Property="Data" Value="M 1,1 L 15,11 1,21 Z" TargetName="path"/>
                                        <Setter Property="Background" Value="LimeGreen" TargetName="border"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=runstop,Path=Text}" Value="停止">
                                        <Setter Property="Data" Value="M 1,1 L 21,1 21,21 1,21 Z" TargetName="path"/>
                                        <Setter Property="Background" Value="Red" TargetName="border"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <!--时间-->
        <Border Canvas.Left="338" Canvas.Top="499" BorderBrush="#4D788C9B" BorderThickness="1" CornerRadius="8" Width="540" HorizontalAlignment="Left" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="0,16" HorizontalAlignment="Center">
                <TextBlock Grid.Column="1" Text="运行时间：" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="00 : 00 : 00" FontSize="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <!--分隔线-->
                <Rectangle Margin="60,0" Width="1" Fill="LightGray"/>

                <TextBlock Grid.Column="1" Text="定时时间：" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="00 : 00 : 00" FontSize="16" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Canvas>
</base:DeviceScreenBase>
