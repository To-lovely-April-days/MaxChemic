<base:DeviceScreenBase x:Class="MaxChemical.Modules.Designer.Views.Controls.Screens.HighLowTemperature"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views.Controls.Screens"
             xmlns:base="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             mc:Ignorable="d" 
             Height="620" Width="1240">
    <base:DeviceScreenBase.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#3EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <Style x:Key="SwitchButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Rect" RadiusX="20" RadiusY="20" Height="40" Fill="LimeGreen"/>
                            <Ellipse x:Name="Ellipse" Height="32" Width="32" Fill="White" HorizontalAlignment="Left" Margin="4"/>
                            <ContentPresenter x:Name="Content" Margin="16,0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="ON">
                                <Setter Property="Fill" Value="LimeGreen" TargetName="Rect"/>
                                <Setter Property="HorizontalAlignment" Value="Left" TargetName="Ellipse"/>
                                <Setter Property="HorizontalAlignment" Value="Right" TargetName="Content"/>
                            </Trigger>
                            <Trigger Property="Content" Value="OFF">
                                <Setter Property="Fill" Value="Red" TargetName="Rect"/>
                                <Setter Property="HorizontalAlignment" Value="Right" TargetName="Ellipse"/>
                                <Setter Property="HorizontalAlignment" Value="Left" TargetName="Content"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </base:DeviceScreenBase.Resources>
    <Canvas>
        <Canvas.Background>
            <RadialGradientBrush GradientOrigin="0.16,0.14" Center="0.16,0.14" RadiusX="0.95" RadiusY="0.95">
