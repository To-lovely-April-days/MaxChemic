<base:DeviceScreenBase x:Class="MaxChemical.Modules.Designer.Views.Controls.Screens.HighPreactorScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views.Controls.Screens"
             xmlns:base="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             mc:Ignorable="d" 
             Width="1200" Height="620">
    <base:DeviceScreenBase.Resources>

        <!--文本框样式-->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <!--按钮样式-->
        <Style TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </base:DeviceScreenBase.Resources>
    <Canvas>
        <Canvas.Background>
            <RadialGradientBrush GradientOrigin="0.16,0.14" Center="0.16,0.14" RadiusX="0.95" RadiusY="0.95">
                <GradientStop Color="#6E1B1B" Offset="0"/>
                <GradientStop Color="#2A1212" Offset="0.4"/>
                <GradientStop Color="#08090C" Offset="0.82"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <!--主体背景图-->
        <Image Source="pack://siteoforigin:,,,/Resources/Screens/highpreactor_body.png" Canvas.Left="416" Canvas.Top="29" Width="450" Height="450"/>

        <!--釜温-->
        <Border CornerRadius="8" Background="#7F442F2F" BorderBrush="Gray" BorderThickness="1" Canvas.Left="110" Canvas.Top="64">
            <Grid Margin="16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Image Grid.RowSpan="3" Source="pack://siteoforigin:,,,/Resources/Screens/highpreactor_bath.png"/>

                <TextBlock Text="釜温" Grid.Column="1" Foreground="White" VerticalAlignment="Center" FontSize="20"/>
                <!--SV-->
                <TextBlock Grid.Row="1" Grid.Column="1" Text="SV" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox Name="TbBathSv" Grid.Row="1" Grid.Column="2" Text="0.00" VerticalAlignment="Center" KeyDown="TbBathSv_KeyDown"/>
                <TextBlock Grid.Row="1" Text="℃" Grid.Column="3" Foreground="White" VerticalAlignment="Center"/>
                <!--PV-->
                <TextBlock Grid.Row="2" Grid.Column="1" Text="PV" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Name="TbBathPv" Grid.Row="2" Grid.Column="2" Margin="4,0,8,0" Text="0.00" FontSize="16" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Rectangle Grid.Row="2" Grid.Column="2" Height="2" Fill="White" VerticalAlignment="Bottom"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="℃" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!--搅拌-->
        <Border CornerRadius="8" Background="#7F2B1616" BorderBrush="Gray" BorderThickness="1" Canvas.Left="66" Canvas.Top="317">
            <Grid Margin="16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Image Grid.RowSpan="3" Source="pack://siteoforigin:,,,/Resources/Screens/highpreactor_speed.png"/>

                <TextBlock Text="搅拌" Grid.Column="1" Foreground="White" FontSize="20"/>
                <!--SV-->
                <TextBlock Grid.Row="1" Grid.Column="1" Text="SV" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox Name="TbSpeedSv" Grid.Row="1" Grid.Column="2" Text="0.00" VerticalAlignment="Center" KeyDown="TbSpeedSv_KeyDown"/>
                <TextBlock Grid.Row="1" Text="RPM" Grid.Column="3" Foreground="White" VerticalAlignment="Center"/>
                <!--PV-->
                <TextBlock Grid.Row="2" Grid.Column="1" Text="PV" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Name="TbSpeedPv" Grid.Row="2" Grid.Column="2" Margin="4,0,8,0" Text="0.00" FontSize="16" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Rectangle Grid.Row="2" Grid.Column="2" Height="2" Fill="White" VerticalAlignment="Bottom"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="RPM" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!--压力-->
        <Border CornerRadius="8" Background="#7F262222" BorderBrush="Gray" BorderThickness="1" Canvas.Left="917" Canvas.Top="82">
            <Grid Margin="16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Image Grid.RowSpan="2" Source="pack://siteoforigin:,,,/Resources/Screens/highpreactor_pressure.png"/>

                <TextBlock Text="压力" Grid.Column="1" Foreground="White" FontSize="20"/>

                <TextBlock Name="TbPressure" Grid.Row="1" Grid.Column="1" Margin="4,0,8,0" Text="0.00" FontSize="16" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Mpa" Foreground="White" VerticalAlignment="Center"/>
                <Rectangle Grid.Row="1" Grid.Column="1" Height="2" Fill="White" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!--炉温-->
        <Border CornerRadius="8" Background="#7F292727" BorderBrush="Gray" BorderThickness="1" Canvas.Left="917" Canvas.Top="317">
            <Grid Margin="16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Image Grid.RowSpan="3" Source="pack://siteoforigin:,,,/Resources/Screens/highpreactor_bath.png"/>

                <TextBlock Text="炉温" Grid.Column="1" Foreground="White" FontSize="20"/>
                <!--SV-->
                <TextBlock Grid.Row="1" Grid.Column="1" Text="SV" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBox Name="TbFurnaceSv" Grid.Row="1" Grid.Column="2" Text="0.00" VerticalAlignment="Center" KeyDown="TbBathSv_KeyDown"/>
                <TextBlock Grid.Row="1" Text="℃" Grid.Column="3" Foreground="White" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" Text="PV" Grid.Column="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Name="TbFurnacePv" Grid.Row="2" Grid.Column="2" Margin="4,0,8,0" FontSize="16" Text="0.00" Foreground="Red" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <Rectangle Grid.Row="2" Grid.Column="2" Height="2" Fill="White" VerticalAlignment="Bottom"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="℃" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Button Name="BtnHeat" Content="加热" Canvas.Left="68" Canvas.Top="515" Click="BtnHeat_Click"/>
        <Button Name="BtnSpeed" Content="搅拌" Canvas.Left="208" Canvas.Top="515" Click="BtnSpeed_Click"/>

        <!--斜率控制-->
        <Grid Name="GridSlopeCtrl" Canvas.Left="391" Canvas.Top="526" Width="500" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="升温斜率：" Foreground="White" FontSize="16"/>
            <TextBox Name="TbSlope" Grid.Column="1" Text="0" Foreground="White" FontSize="18" TextAlignment="Center" KeyDown="TbSlope_KeyDown"/>
            <TextBlock Grid.Column="2" Text="℃/MIN" Foreground="White" FontSize="16"/>
            <TextBlock Grid.Column="4" Text="转换拟合阈值：" Foreground="White" FontSize="16"/>
            <TextBox Name="TbThreshold" Grid.Column="5" Text="0" Foreground="White" FontSize="18" TextAlignment="Center" KeyDown="TbThreshold_KeyDown"/>
            <TextBlock Grid.Column="6" Text="℃" Foreground="White" FontSize="16"/>
        </Grid>

        <!--程序控制-->
        <Grid Name="GridProgramCtrl" Canvas.Left="391" Canvas.Top="526" Width="520" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="当前段：" Foreground="White" FontSize="16"/>
            <TextBlock Name="TbSection" Grid.Column="1" Text="0" Foreground="Red" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Rectangle Grid.Column="1" Height="2" Fill="White" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="2" Text="段运行时间：" Foreground="White" FontSize="16"/>
            <TextBlock Name="TbSectionRunTime" Grid.Column="3" Text="0" Foreground="Red" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="/" Foreground="White" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Name="TbTotalTime" Grid.Column="5" Text="0" Foreground="Red" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="MIN" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Rectangle Grid.Column="3" Grid.ColumnSpan="3" Height="2" Fill="White" VerticalAlignment="Bottom"/>
        </Grid>

        <!--釜温/炉温控制-->
        <Grid Name="GridTempCtrl" Canvas.Left="521" Canvas.Top="524" Width="240" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="运行时间：" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Name="TbRunTime" Grid.Column="1" Text="0" Foreground="Red" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Rectangle Grid.Column="1" Height="2" Fill="White" VerticalAlignment="Bottom"/>
            <TextBlock Grid.Column="2" Text="MIN" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        </Grid>

        <!--当前设备控制模式-->
        <TextBlock Name="TbCtrlMode" Text="釜温控制" Foreground="White" FontSize="20" Canvas.Left="1039" Canvas.Top="530"/>
    </Canvas>
</base:DeviceScreenBase>
