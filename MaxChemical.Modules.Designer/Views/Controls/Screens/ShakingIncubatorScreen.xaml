<base:DeviceScreenBase x:Class="MaxChemical.Modules.Designer.Views.Controls.Screens.ShakingIncubatorScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:base="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             mc:Ignorable="d"
             Width="1240" Height="620">

    <!--
      恒温振荡培养箱嵌入式屏幕。

      全矢量,不引用任何图片素材 —— 仓库按扩展名忽略了 *.png,依赖图片的屏幕
      别人 clone 下来会是一片空白。

      两处跟别的屏幕不一样的地方,改之前先看一眼:

      1) 转速、风速、照明、灭菌、预约这几块**不一定存在**。仪器在
         0x0017~0x001F 报了五个"功能开关",关掉的功能对应的控件要置灰,
         否则操作员会对着一个永远没反应的按钮怀疑是软件坏了。
         置灰逻辑在 OnDataRefreshed 里,靠 FUNC_* 几个输出量驱动。

      2) 温度设定不是"写一个温度寄存器"。仪器的 0x0008 是只读的,
         真正改设定值要走驱动的「设置定值参数」命令(它内部按手册的
         编辑窗口流程走)。所以这里下发之后不做本地乐观更新,等下一轮
         轮询把仪器实际收下的值读回来 —— 仪器拒了的话界面会如实退回。
    -->

    <base:DeviceScreenBase.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#D91A1A1F"/>
            <Setter Property="BorderBrush" Value="#3D8A8A96"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7E8490"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="Reading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8EE"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AA"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="Entry" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="BorderBrush" Value="#4A4A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8E8EE"/>
            <Setter Property="Background" Value="#3A3A42"/>
            <Setter Property="BorderBrush" Value="#5A5A64"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A54"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#1E4D33"/>
            <Setter Property="BorderBrush" Value="#2F7A4E"/>
        </Style>

        <Style x:Key="StopBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#5A2A2E"/>
            <Setter Property="BorderBrush" Value="#8A3A42"/>
        </Style>

    </base:DeviceScreenBase.Resources>

    <Canvas>
        <Canvas.Background>
            <RadialGradientBrush GradientOrigin="0.14,0.1" Center="0.14,0.1" RadiusX="1.0" RadiusY="1.0">
                <GradientStop Color="#17323A" Offset="0"/>
                <GradientStop Color="#101820" Offset="0.42"/>
                <GradientStop Color="#08090C" Offset="0.85"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <!-- ══ 抬头 ══════════════════════════════════════════════ -->
        <StackPanel Canvas.Left="40" Canvas.Top="22">
            <TextBlock Text="恒温振荡培养箱" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="SubTitle" Text="Modbus RTU · RS485 · 9600 8N1 · 产品类型编号 0x140B"
                       FontSize="13" Foreground="#8A9098" Margin="0,5,0,0"/>
        </StackPanel>

        <Border x:Name="LinkChip" Canvas.Left="1010" Canvas.Top="28" Width="190" Height="38"
                CornerRadius="19" Background="#2A2A32" BorderBrush="#4A4A55" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="LinkDot" Width="10" Height="10" Fill="#6A6A74" Margin="0,0,9,0"/>
                <TextBlock x:Name="LinkText" Text="等待数据" Foreground="#C8CCD4" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- ══ 温度 ══════════════════════════════════════════════ -->
        <Border Style="{StaticResource Card}" Canvas.Left="40" Canvas.Top="94" Width="470" Height="230">
            <Canvas>
                <TextBlock Text="腔内温度" Style="{StaticResource CardTitle}" Canvas.Left="22" Canvas.Top="16"/>

                <TextBlock x:Name="TempPv" Text="--" Canvas.Left="22" Canvas.Top="44"
                           FontFamily="Consolas" FontSize="88" FontWeight="Bold" Foreground="#4FD1C5"/>
                <TextBlock Text="℃" Canvas.Left="330" Canvas.Top="108"
                           FontSize="30" FontWeight="SemiBold" Foreground="#4FD1C5" Opacity="0.75"/>

                <StackPanel Canvas.Left="22" Canvas.Top="164">
                    <TextBlock Text="设定值" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="TempSet" Text="--" Style="{StaticResource Reading}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Canvas.Left="190" Canvas.Top="164">
                    <TextBlock Text="仪器允许的设定范围" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="TempRange" Text="--" Style="{StaticResource Reading}" FontSize="18" Margin="0,6,0,0"/>
                </StackPanel>
            </Canvas>
        </Border>

        <!-- ══ 转速 ══════════════════════════════════════════════ -->
        <Border x:Name="SpeedCard" Style="{StaticResource Card}" Canvas.Left="530" Canvas.Top="94" Width="330" Height="230">
            <Canvas>
                <TextBlock Text="振荡转速" Style="{StaticResource CardTitle}" Canvas.Left="22" Canvas.Top="16"/>

                <!-- 功能没开时这里会显示"本机未开通",而不是显示一个 0 让人以为停了 -->
                <TextBlock x:Name="SpeedOff" Text="本机未开通转速功能" Visibility="Collapsed"
                           Canvas.Left="22" Canvas.Top="96" FontSize="15" Foreground="#7E8490"/>

                <TextBlock x:Name="SpeedPv" Text="--" Canvas.Left="22" Canvas.Top="48"
                           FontFamily="Consolas" FontSize="66" FontWeight="Bold" Foreground="#F6C453"/>
                <TextBlock x:Name="SpeedUnit" Text="RPM" Canvas.Left="212" Canvas.Top="92"
                           FontSize="22" FontWeight="SemiBold" Foreground="#F6C453" Opacity="0.75"/>

                <StackPanel Canvas.Left="22" Canvas.Top="164">
                    <TextBlock Text="设定值" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="SpeedSet" Text="--" Style="{StaticResource Reading}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Canvas.Left="170" Canvas.Top="164">
                    <TextBlock Text="范围" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="SpeedRange" Text="--" Style="{StaticResource Reading}" FontSize="18" Margin="0,6,0,0"/>
                </StackPanel>
            </Canvas>
        </Border>

        <!-- ══ 风速 ══════════════════════════════════════════════ -->
        <Border x:Name="FanCard" Style="{StaticResource Card}" Canvas.Left="880" Canvas.Top="94" Width="320" Height="230">
            <Canvas>
                <TextBlock Text="风速档位" Style="{StaticResource CardTitle}" Canvas.Left="22" Canvas.Top="16"/>

                <TextBlock x:Name="FanOff" Text="本机风机不可调" Visibility="Collapsed"
                           Canvas.Left="22" Canvas.Top="96" FontSize="15" Foreground="#7E8490"/>

                <TextBlock x:Name="FanPv" Text="--" Canvas.Left="22" Canvas.Top="48"
                           FontFamily="Consolas" FontSize="66" FontWeight="Bold" Foreground="#7FC8F8"/>
                <TextBlock x:Name="FanUnit" Text="档" Canvas.Left="150" Canvas.Top="92"
                           FontSize="22" FontWeight="SemiBold" Foreground="#7FC8F8" Opacity="0.75"/>

                <StackPanel Canvas.Left="22" Canvas.Top="164">
                    <TextBlock Text="设定值" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="FanSet" Text="--" Style="{StaticResource Reading}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Canvas.Left="170" Canvas.Top="164">
                    <TextBlock Text="范围" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="FanRange" Text="--" Style="{StaticResource Reading}" FontSize="18" Margin="0,6,0,0"/>
                </StackPanel>
            </Canvas>
        </Border>

        <!-- ══ 运行状态条 ════════════════════════════════════════ -->
        <Border Style="{StaticResource Card}" Canvas.Left="40" Canvas.Top="338" Width="1160" Height="104">
            <Canvas>
                <StackPanel Canvas.Left="22" Canvas.Top="16">
                    <TextBlock Text="运行状态" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="RunStateText" Text="--" Style="{StaticResource Reading}" FontSize="22" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Canvas.Left="190" Canvas.Top="16">
                    <TextBlock Text="当前模式" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="ModeText" Text="--" Style="{StaticResource Reading}" FontSize="22" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Canvas.Left="380" Canvas.Top="16">
                    <TextBlock Text="运行段 / 周期" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="SegCycleText" Text="--" Style="{StaticResource Reading}" FontSize="20" Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Canvas.Left="560" Canvas.Top="16">
                    <TextBlock Text="已计时 / 设定时长" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="TimeText" Text="--" Style="{StaticResource Reading}" FontSize="20" Margin="0,7,0,0"/>
                </StackPanel>

                <StackPanel Canvas.Left="800" Canvas.Top="16">
                    <TextBlock Text="仪器系统时间" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="ClockText" Text="--" Style="{StaticResource Reading}" FontSize="17" Margin="0,9,0,0"/>
                </StackPanel>

                <!-- 报警只在有报警时才出现。常驻一个"无报警"绿灯会让人对它脱敏,
                     真报的时候反而看不见。 -->
                <Border x:Name="AlarmChip" Canvas.Left="1020" Canvas.Top="26" Width="118" Height="52"
                        CornerRadius="8" Background="#4A1F24" BorderBrush="#B0424E" BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="报警" Foreground="#FF9AA5" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="AlarmCount" Text="0" Foreground="#FFD7DC" FontSize="20"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Canvas>
        </Border>

        <!-- ══ 定值参数下发 ══════════════════════════════════════
             这一排走驱动的「设置定值参数」命令。驱动内部按手册流程:
             先写 0x0027~0x002F 编辑窗口,最后写 0x0026=2 提交。
             界面不做乐观更新,等下一轮轮询把仪器实际收下的值读回来。 -->
        <Border Style="{StaticResource Card}" Canvas.Left="40" Canvas.Top="456" Width="770" Height="140">
            <Canvas>
                <TextBlock Text="定值模式参数（下发后由仪器回读确认，约 1 秒生效）"
                           Style="{StaticResource CardTitle}" Canvas.Left="22" Canvas.Top="14"/>

                <StackPanel Canvas.Left="22" Canvas.Top="48" Width="120">
                    <TextBlock Text="温度 ℃" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="SetTempBox" Style="{StaticResource Entry}" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>

                <StackPanel x:Name="SetSpeedPanel" Canvas.Left="158" Canvas.Top="48" Width="120">
                    <TextBlock Text="转速 RPM" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="SetSpeedBox" Style="{StaticResource Entry}" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>

                <StackPanel x:Name="SetFanPanel" Canvas.Left="294" Canvas.Top="48" Width="100">
                    <TextBlock Text="风速 档" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="SetFanBox" Style="{StaticResource Entry}" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>

                <StackPanel Canvas.Left="410" Canvas.Top="48" Width="90">
                    <TextBlock Text="时长-时" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="SetHourBox" Style="{StaticResource Entry}" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>

                <StackPanel Canvas.Left="516" Canvas.Top="48" Width="90">
                    <TextBlock Text="时长-分" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="SetMinuteBox" Style="{StaticResource Entry}" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>

                <Button x:Name="ApplyBtn" Style="{StaticResource GoBtn}" Content="下发定值参数"
                        Canvas.Left="622" Canvas.Top="74" Width="126" Click="ApplyBtn_Click"/>

                <TextBlock x:Name="StatusText" Text="就绪" Foreground="#7E8490" FontSize="12"
                           Canvas.Left="22" Canvas.Top="108" Width="726" TextTrimming="CharacterEllipsis"/>
            </Canvas>
        </Border>

        <!-- ══ 控制 ══════════════════════════════════════════════ -->
        <Border Style="{StaticResource Card}" Canvas.Left="830" Canvas.Top="456" Width="370" Height="140">
            <Canvas>
                <TextBlock Text="运行控制" Style="{StaticResource CardTitle}" Canvas.Left="22" Canvas.Top="14"/>

                <Button x:Name="StartBtn" Style="{StaticResource GoBtn}" Content="启动"
                        Canvas.Left="22" Canvas.Top="40" Width="100" Click="StartBtn_Click"/>
                <Button x:Name="StopBtn" Style="{StaticResource StopBtn}" Content="停止"
                        Canvas.Left="134" Canvas.Top="40" Width="100" Click="StopBtn_Click"/>

                <StackPanel Canvas.Left="246" Canvas.Top="22" Width="102">
                    <TextBlock Text="工作模式" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="ModeCombo" Style="{StaticResource Combo}" SelectionChanged="ModeCombo_Changed">
                        <ComboBoxItem Content="定值"/>
                        <ComboBoxItem Content="程式 1"/>
                        <ComboBoxItem Content="程式 2"/>
                        <ComboBoxItem Content="程式 3"/>
                        <ComboBoxItem Content="程式 4"/>
                        <ComboBoxItem Content="程式 5"/>
                    </ComboBox>
                </StackPanel>

                <Button x:Name="LightBtn" Style="{StaticResource Btn}" Content="照明"
                        Canvas.Left="22" Canvas.Top="90" Width="100" Click="LightBtn_Click"/>
                <Button x:Name="SterilizeBtn" Style="{StaticResource Btn}" Content="灭菌"
                        Canvas.Left="134" Canvas.Top="90" Width="100" Click="SterilizeBtn_Click"/>
                <Button x:Name="SyncClockBtn" Style="{StaticResource Btn}" Content="对时"
                        Canvas.Left="246" Canvas.Top="90" Width="102" Click="SyncClockBtn_Click"/>
            </Canvas>
        </Border>

    </Canvas>
</base:DeviceScreenBase>
