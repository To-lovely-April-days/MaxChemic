<base:DeviceScreenBase x:Class="MaxChemical.Modules.Designer.Views.Controls.Screens.TwoLiquidOneGasFeedScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             Width="1240" Height="620">

    <!--
      两液一气进料系统嵌入式屏幕（设计稿 1:1 翻译版）
      - 三行：MFC / 泵1 / 泵2
      - 每行：左装饰 → 开关(可点) → 设备机身 → 数据面板 → 阀门/出口
      - 贯穿管道 + 开关 ON 时流动光带动画
      - 设备机身/液瓶/阀门当前为矢量近似，有 png 素材时替换为 <Image>
      数据值与开关都有 x:Name，供 .xaml.cs 的 OnDataRefreshed / 开关命令使用。
    -->

    <base:DeviceScreenBase.Resources>
        <!-- 颜色 -->
        <SolidColorBrush x:Key="LabelBrush" Color="#C3C9D2"/>
        <SolidColorBrush x:Key="ValueBrush" Color="#4FD1C5"/>
        <SolidColorBrush x:Key="UnitBrush"  Color="#8B929C"/>
        <SolidColorBrush x:Key="TagBg"      Color="#D9464C56"/>

        <!-- 数据行值文本样式 -->
        <Style x:Key="ValStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="UnitStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource UnitBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 可编辑 F-SV 输入框样式 -->
        <Style x:Key="EditValStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#33000000"/>
            <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource ValueBrush}"/>
            <Setter Property="BorderBrush" Value="#3E78828F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="56"/>
        </Style>

        <!-- 标牌（进口/出口/MFC/泵） -->
        <Style x:Key="TagStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TagBg}"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </base:DeviceScreenBase.Resources>

    <!-- 屏幕背景：深色 + 左上红光 -->
    <Border ClipToBounds="True">
        <Border.Background>
            <RadialGradientBrush GradientOrigin="0.18,0.12" Center="0.18,0.12" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#7A1F1F" Offset="0"/>
                <GradientStop Color="#2A1212" Offset="0.4"/>
                <GradientStop Color="#0A0B0E" Offset="0.8"/>
            </RadialGradientBrush>
        </Border.Background>

        <Grid Margin="26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ 行1：MFC ============ -->
            <Grid Grid.Row="0">
                <!-- 贯穿管道（底层） -->
                <Border x:Name="ConduitMfc" Height="7" Margin="60,0,70,0" CornerRadius="4"
                        VerticalAlignment="Center" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2B2F36" Offset="0"/>
                            <GradientStop Color="#15181D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <!-- 流动光带（默认透明，开关 ON 时动画） -->
                    <Rectangle x:Name="FlowMfc" Opacity="0" Width="120" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0078D2FF" Offset="0.4"/>
                                <GradientStop Color="#D98CE0FF" Offset="0.5"/>
                                <GradientStop Color="#0078D2FF" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="FlowMfcT" X="-120"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Border>

                <!-- 行内容 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="175"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左装饰：进口 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource TagStyle}">
                            <TextBlock Text="进口" Foreground="#E8EBEF" FontSize="15" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- 开关 -->
                    <Grid x:Name="MfcSwitch" Grid.Column="1" Width="96" Height="42" Margin="18,0" Background="Transparent"
                          VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="MfcSwitch_Click">
                        <Border x:Name="MfcSwitchTrack" CornerRadius="21" Background="#D23A30"/>
                        <TextBlock x:Name="MfcSwitchText" Text="OFF" Foreground="White" FontSize="15" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0"/>
                        <Border x:Name="MfcSwitchKnob" Width="32" Height="32" CornerRadius="16" Background="White"
                                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    </Grid>

                    <!-- 设备：MFC 机身 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="58" Height="78" CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E9EDF2" Offset="0"/>
                                    <GradientStop Color="#AEB6C0" Offset="0.55"/>
                                    <GradientStop Color="#6F7884" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Style="{StaticResource TagStyle}" Margin="0,6,0,0" Padding="12,3" HorizontalAlignment="Center">
                            <TextBlock Text="MFC" Foreground="#DFE3E8" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <!-- 数据面板 -->
                    <Border Grid.Column="3" Background="#9E14161C" CornerRadius="8" Padding="18,12" Margin="14,0,0,0"
                            BorderBrush="#2E78828F" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="F-SV"  Style="{StaticResource KeyStyle}"/>
                            <TextBox x:Name="MfcFsv" Grid.Row="0" Grid.Column="1" Text="--" Style="{StaticResource EditValStyle}"
                                     KeyDown="MfcFsv_KeyDown" GotKeyboardFocus="Fsv_SelectAll"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mL/min" Style="{StaticResource UnitStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="F LOW" Style="{StaticResource KeyStyle}"/>
                            <TextBlock x:Name="MfcFlow" Grid.Row="1" Grid.Column="1" Text="--" Style="{StaticResource ValStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mL/min" Style="{StaticResource UnitStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Add"   Style="{StaticResource KeyStyle}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="MfcAdd"  Grid.Row="2" Grid.Column="1" Text="--" Style="{StaticResource ValStyle}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="L"     Style="{StaticResource UnitStyle}" Margin="14,6,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 右装饰：出口 -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Path Data="M 0 0 L 13 9 L 0 18 Z M 26 0 L 13 9 L 26 18 Z" Fill="#8A929C" Margin="0,0,10,0"/>
                        <Border Style="{StaticResource TagStyle}">
                            <TextBlock Text="出口" Foreground="#E8EBEF" FontSize="15" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ 行2：泵1 ============ -->
            <Grid Grid.Row="1">
                <Border x:Name="ConduitP1" Height="7" Margin="60,0,70,0" CornerRadius="4"
                        VerticalAlignment="Center" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2B2F36" Offset="0"/>
                            <GradientStop Color="#15181D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Rectangle x:Name="FlowP1" Opacity="0" Width="120" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0078D2FF" Offset="0.4"/>
                                <GradientStop Color="#D98CE0FF" Offset="0.5"/>
                                <GradientStop Color="#0078D2FF" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="FlowP1T" X="-120"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="175"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左装饰：液瓶 -->
                    <Border Grid.Column="0" Width="34" Height="60" CornerRadius="6,6,8,8" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CFD6DD" Offset="0"/>
                                <GradientStop Color="#9FB0C4" Offset="0.35"/>
                                <GradientStop Color="#5B8FC4" Offset="0.6"/>
                                <GradientStop Color="#3F74B8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid x:Name="Pump1Switch" Grid.Column="1" Width="96" Height="42" Margin="18,0" Background="Transparent"
                          VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Pump1Switch_Click">
                        <Border x:Name="Pump1SwitchTrack" CornerRadius="21" Background="#D23A30"/>
                        <TextBlock x:Name="Pump1SwitchText" Text="OFF" Foreground="White" FontSize="15" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0"/>
                        <Border x:Name="Pump1SwitchKnob" Width="32" Height="32" CornerRadius="16" Background="White"
                                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    </Grid>

                    <!-- 设备：泵1 机身 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="88" Height="62" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E9EDF2" Offset="0"/>
                                    <GradientStop Color="#AEB6C0" Offset="0.5"/>
                                    <GradientStop Color="#6F7884" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Width="30" Height="22" CornerRadius="3" Background="#0D0F12"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,10,0"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TagStyle}" Margin="0,6,0,0" Padding="12,3" HorizontalAlignment="Center">
                            <TextBlock Text="泵1" Foreground="#DFE3E8" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="3" Background="#9E14161C" CornerRadius="8" Padding="18,12" Margin="14,0,0,0"
                            BorderBrush="#2E78828F" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="F-SV"  Style="{StaticResource KeyStyle}"/>
                            <TextBox x:Name="Pump1Fsv" Grid.Row="0" Grid.Column="1" Text="--" Style="{StaticResource EditValStyle}"
                                     KeyDown="Pump1Fsv_KeyDown" GotKeyboardFocus="Fsv_SelectAll"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mL/min" Style="{StaticResource UnitStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="F LOW" Style="{StaticResource KeyStyle}"/>
                            <TextBlock x:Name="Pump1Flow" Grid.Row="1" Grid.Column="1" Text="--" Style="{StaticResource ValStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mL/min" Style="{StaticResource UnitStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Add"   Style="{StaticResource KeyStyle}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Pump1Add"  Grid.Row="2" Grid.Column="1" Text="--" Style="{StaticResource ValStyle}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="mL"    Style="{StaticResource UnitStyle}" Margin="14,6,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="P"     Style="{StaticResource KeyStyle}"/>
                            <TextBlock x:Name="Pump1P"   Grid.Row="3" Grid.Column="1" Text="--" Style="{StaticResource ValStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="MPa"   Style="{StaticResource UnitStyle}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Path Data="M 0 0 L 13 9 L 0 18 Z M 26 0 L 13 9 L 26 18 Z" Fill="#8A929C" Margin="0,0,10,0"/>
                        <Border Style="{StaticResource TagStyle}">
                            <TextBlock Text="出口" Foreground="#E8EBEF" FontSize="15" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ 行3：泵2 ============ -->
            <Grid Grid.Row="2">
                <Border x:Name="ConduitP2" Height="7" Margin="60,0,70,0" CornerRadius="4"
                        VerticalAlignment="Center" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2B2F36" Offset="0"/>
                            <GradientStop Color="#15181D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Rectangle x:Name="FlowP2" Opacity="0" Width="120" HorizontalAlignment="Left">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0078D2FF" Offset="0.4"/>
                                <GradientStop Color="#D98CE0FF" Offset="0.5"/>
                                <GradientStop Color="#0078D2FF" Offset="0.6"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="FlowP2T" X="-120"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="175"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="34" Height="60" CornerRadius="6,6,8,8" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CFD6DD" Offset="0"/>
                                <GradientStop Color="#9FB0C4" Offset="0.35"/>
                                <GradientStop Color="#5B8FC4" Offset="0.6"/>
                                <GradientStop Color="#3F74B8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid x:Name="Pump2Switch" Grid.Column="1" Width="96" Height="42" Margin="18,0" Background="Transparent"
                          VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="Pump2Switch_Click">
                        <Border x:Name="Pump2SwitchTrack" CornerRadius="21" Background="#D23A30"/>
                        <TextBlock x:Name="Pump2SwitchText" Text="OFF" Foreground="White" FontSize="15" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0"/>
                        <Border x:Name="Pump2SwitchKnob" Width="32" Height="32" CornerRadius="16" Background="White"
                                VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="88" Height="62" CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E9EDF2" Offset="0"/>
                                    <GradientStop Color="#AEB6C0" Offset="0.5"/>
                                    <GradientStop Color="#6F7884" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Border Width="30" Height="22" CornerRadius="3" Background="#0D0F12"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,10,0"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TagStyle}" Margin="0,6,0,0" Padding="12,3" HorizontalAlignment="Center">
                            <TextBlock Text="泵2" Foreground="#DFE3E8" FontSize="13"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="3" Background="#9E14161C" CornerRadius="8" Padding="18,12" Margin="14,0,0,0"
                            BorderBrush="#2E78828F" BorderThickness="1" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="F-SV"  Style="{StaticResource KeyStyle}"/>
                            <TextBox x:Name="Pump2Fsv" Grid.Row="0" Grid.Column="1" Text="--" Style="{StaticResource EditValStyle}"
                                     KeyDown="Pump2Fsv_KeyDown" GotKeyboardFocus="Fsv_SelectAll"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mL/min" Style="{StaticResource UnitStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="F LOW" Style="{StaticResource KeyStyle}"/>
                            <TextBlock x:Name="Pump2Flow" Grid.Row="1" Grid.Column="1" Text="--" Style="{StaticResource ValStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mL/min" Style="{StaticResource UnitStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Add"   Style="{StaticResource KeyStyle}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="Pump2Add"  Grid.Row="2" Grid.Column="1" Text="--" Style="{StaticResource ValStyle}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="mL"    Style="{StaticResource UnitStyle}" Margin="14,6,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="P"     Style="{StaticResource KeyStyle}"/>
                            <TextBlock x:Name="Pump2P"   Grid.Row="3" Grid.Column="1" Text="--" Style="{StaticResource ValStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="MPa"   Style="{StaticResource UnitStyle}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Path Data="M 0 0 L 13 9 L 0 18 Z M 26 0 L 13 9 L 26 18 Z" Fill="#8A929C" Margin="0,0,10,0"/>
                        <Border Style="{StaticResource TagStyle}">
                            <TextBlock Text="出口" Foreground="#E8EBEF" FontSize="15" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</base:DeviceScreenBase>
