<base:DeviceScreenBase x:Class="MaxChemical.Modules.Designer.Views.Controls.Screens.PeristalticPumpLCScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:base="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             mc:Ignorable="d"
             Width="1240" Height="620">

    <!--
      创锐 LC / FC 系列蠕动泵(触摸屏款)嵌入式屏幕。全矢量。
      读:轮询「获取所有数据」(0~23 与 252~254 两帧),1s 一轮。
      写:每个控件对应驱动里的一条命令。驱动在每条写命令前都会确认 485 使能,
      屏幕右上角的「485」标签显示泵当前的使能状态,禁能时点一下即可重新使能。
      流速只能在传输模式下写(手册:分配模式不能设置流速),不在传输模式时驱动会拒绝并说明。
    -->

    <base:DeviceScreenBase.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#D91A1A1F"/>
            <Setter Property="BorderBrush" Value="#3D8A8A96"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7E8490"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Reading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8EE"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="Box" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="BorderBrush" Value="#4A4A55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Combo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E8E8EE"/>
            <Setter Property="Background" Value="#3A3A42"/>
            <Setter Property="BorderBrush" Value="#5A5A64"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StartBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#1F5F3A"/>
            <Setter Property="BorderBrush" Value="#2FB84D"/>
        </Style>
        <Style x:Key="StopBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#5A2A2E"/>
            <Setter Property="BorderBrush" Value="#8A3A42"/>
        </Style>
        <Style x:Key="ModeBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="104"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </base:DeviceScreenBase.Resources>

    <Canvas>
        <Canvas.Background>
            <RadialGradientBrush GradientOrigin="0.14,0.1" Center="0.14,0.1" RadiusX="1.0" RadiusY="1.0">
                <GradientStop Color="#17323A" Offset="0"/>
                <GradientStop Color="#101820" Offset="0.42"/>
                <GradientStop Color="#08090C" Offset="0.85"/>
            </RadialGradientBrush>
        </Canvas.Background>

        <!-- ══ 抬头 ══ -->
        <StackPanel Canvas.Left="40" Canvas.Top="22">
            <TextBlock x:Name="TitleText" Text="LC 蠕动泵" FontSize="26" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="MetaText" Text="RS485 · Modbus RTU · 9600 8N1" FontSize="13" Foreground="#8A9098" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 485 使能状态。泵断电重启后会回到禁能,点一下重新使能 -->
        <Button x:Name="Rs485Btn" Style="{StaticResource Btn}" Content="485 未知" Canvas.Left="850" Canvas.Top="28" Width="140" Height="38" Click="Rs485Btn_Click"/>

        <Border Canvas.Left="1010" Canvas.Top="28" Width="190" Height="38"
                CornerRadius="19" Background="#2A2A32" BorderBrush="#4A4A55" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="LinkDot" Width="10" Height="10" Fill="#6A6A74" Margin="0,0,9,0"/>
                <TextBlock x:Name="LinkText" Text="等待应答" Foreground="#C8CCD4" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- ══ 流速与状态 ══ -->
        <Border Style="{StaticResource Card}" Canvas.Left="40" Canvas.Top="86" Width="560" Height="240">
            <Canvas>
                <StackPanel Orientation="Horizontal" Canvas.Left="22" Canvas.Top="14">
                    <TextBlock Text="流速" Style="{StaticResource CardTitle}"/>
                    <Border Margin="12,-3,0,0" Height="24" CornerRadius="12" Background="#1F3A3E" BorderBrush="#2F6F6A" BorderThickness="1" Padding="12,0">
                        <TextBlock x:Name="ModeChipText" Text="--" Foreground="#4FD1C5" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Border x:Name="RunChip" Canvas.Left="430" Canvas.Top="12" Width="108" Height="28"
                        CornerRadius="14" Background="#2A2A32" BorderBrush="#4A4A55" BorderThickness="1">
                    <TextBlock x:Name="RunText" Text="—" Foreground="#9AA0AA" FontSize="13"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="FlowText" Text="--" Canvas.Left="22" Canvas.Top="40"
                           FontFamily="Consolas" FontSize="84" FontWeight="Bold" Foreground="#4FD1C5"/>
                <TextBlock Text="mL/min" Canvas.Left="392" Canvas.Top="104"
                           FontSize="24" FontWeight="SemiBold" Foreground="#4FD1C5" Opacity="0.75"/>

                <StackPanel Canvas.Left="22" Canvas.Top="152">
                    <TextBlock Text="灌装量 mL" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="FillVolumeText" Text="--" Style="{StaticResource Reading}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Canvas.Left="160" Canvas.Top="152">
                    <TextBlock Text="灌装时间 s" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="FillTimeText" Text="--" Style="{StaticResource Reading}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Canvas.Left="298" Canvas.Top="152">
                    <TextBlock Text="方向 / 全速" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="DirFullText" Text="--" Style="{StaticResource Reading}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Canvas.Left="436" Canvas.Top="152">
                    <TextBlock Text="K 值" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="KText" Text="--" Style="{StaticResource Reading}" Margin="0,3,0,0"/>
                </StackPanel>

                <TextBlock x:Name="HeadText" Text="泵头 -- · 泵管 -- · 外控 --" Style="{StaticResource Caption}" Canvas.Left="22" Canvas.Top="208"/>
            </Canvas>
        </Border>

        <!-- ══ 运行控制 ══ -->
        <Border Style="{StaticResource Card}" Canvas.Left="620" Canvas.Top="86" Width="580" Height="240">
            <Canvas>
                <TextBlock Text="运行控制" Style="{StaticResource CardTitle}" Canvas.Left="22" Canvas.Top="14"/>

                <StackPanel Canvas.Left="22" Canvas.Top="42" Width="160">
                    <TextBlock Text="流速 mL/min（传输模式，回车下发）" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="FlowBox" Style="{StaticResource Box}" KeyDown="FlowBox_KeyDown" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>
                <Button x:Name="SetFlowBtn" Style="{StaticResource Btn}" Content="下发流速" Canvas.Left="196" Canvas.Top="59" Width="100" Height="32" Click="SetFlowBtn_Click"/>
                <Button x:Name="StartAtBtn" Style="{StaticResource StartBtn}" Content="按流速启动" Canvas.Left="306" Canvas.Top="59" Width="116" Height="32" Click="StartAtBtn_Click"/>

                <Button x:Name="StartBtn" Style="{StaticResource StartBtn}" Content="启动" Canvas.Left="22" Canvas.Top="104" Width="110" Click="StartBtn_Click"/>
                <Button x:Name="StopBtn" Style="{StaticResource StopBtn}" Content="停止" Canvas.Left="142" Canvas.Top="104" Width="110" Click="StopBtn_Click"/>
                <Button x:Name="FullBtn" Style="{StaticResource Btn}" Content="全速" Canvas.Left="262" Canvas.Top="104" Width="110" Click="FullBtn_Click"/>
                <Button x:Name="CwBtn" Style="{StaticResource Btn}" Content="顺时针" Canvas.Left="382" Canvas.Top="104" Width="80" Click="CwBtn_Click"/>
                <Button x:Name="CcwBtn" Style="{StaticResource Btn}" Content="逆时针" Canvas.Left="470" Canvas.Top="104" Width="80" Click="CcwBtn_Click"/>

                <TextBlock Text="运转模式" Style="{StaticResource Caption}" Canvas.Left="22" Canvas.Top="156"/>
                <WrapPanel x:Name="ModePanel" Canvas.Left="22" Canvas.Top="176" Width="540"/>
            </Canvas>
        </Border>

        <!-- ══ 分配参数与泵头 ══ -->
        <Border Style="{StaticResource Card}" Canvas.Left="40" Canvas.Top="338" Width="1160" Height="128">
            <Canvas>
                <TextBlock Text="分配参数与泵头（输入框回车下发；写入后回读比对）" Style="{StaticResource CardTitle}" Canvas.Left="22" Canvas.Top="12"/>

                <StackPanel Canvas.Left="22" Canvas.Top="42" Width="150">
                    <TextBlock Text="灌装量 mL" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="FillVolumeBox" Style="{StaticResource Box}" Tag="设置灌装量" KeyDown="ParamBox_KeyDown" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>
                <StackPanel Canvas.Left="186" Canvas.Top="42" Width="150">
                    <TextBlock Text="灌装时间 s" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="FillTimeBox" Style="{StaticResource Box}" Tag="设置灌装时间" KeyDown="ParamBox_KeyDown" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>
                <StackPanel Canvas.Left="350" Canvas.Top="42" Width="150">
                    <TextBlock Text="回吸速度 10~300 rpm" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="BackSpeedBox" Style="{StaticResource Box}" Tag="设置回吸速度" KeyDown="ParamBox_KeyDown" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>
                <StackPanel Canvas.Left="514" Canvas.Top="42" Width="150">
                    <TextBlock Text="回吸角度 0~3600°" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="BackAngleBox" Style="{StaticResource Box}" Tag="设置回吸角度" KeyDown="ParamBox_KeyDown" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>
                <StackPanel Canvas.Left="700" Canvas.Top="42" Width="220">
                    <TextBlock Text="泵头（选中即下发）" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="HeadCombo" Style="{StaticResource Combo}" SelectionChanged="HeadCombo_Changed"/>
                </StackPanel>
                <StackPanel Canvas.Left="936" Canvas.Top="42" Width="200">
                    <TextBlock Text="泵管编号（对应泵头列表，从 0 起）" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="TubeBox" Style="{StaticResource Box}" Tag="设置泵管" KeyDown="ParamBox_KeyDown" GotKeyboardFocus="SelectAllOnFocus"/>
                </StackPanel>
            </Canvas>
        </Border>

        <!-- ══ 校准 ══ -->
        <Border Style="{StaticResource Card}" Canvas.Left="40" Canvas.Top="478" Width="1160" Height="66">
            <Canvas>
                <TextBlock Text="流量校准：① 写校准液量 → ② 让泵跑一次分配 → ③ 量出实际液量写入，泵据此更新 K"
                           Style="{StaticResource CardTitle}" Canvas.Left="22" Canvas.Top="10"/>
                <TextBlock Text="校准液量 mL" Style="{StaticResource Caption}" Canvas.Left="22" Canvas.Top="38"/>
                <TextBox x:Name="CalVolumeBox" Style="{StaticResource Box}" Width="110" Height="26" FontSize="13" Tag="设置校准液量"
                         Canvas.Left="104" Canvas.Top="33" KeyDown="ParamBox_KeyDown" GotKeyboardFocus="SelectAllOnFocus"/>
                <TextBlock Text="实测液量 mL" Style="{StaticResource Caption}" Canvas.Left="240" Canvas.Top="38"/>
                <TextBox x:Name="CalActualBox" Style="{StaticResource Box}" Width="110" Height="26" FontSize="13" Tag="设置实测液量"
                         Canvas.Left="322" Canvas.Top="33" KeyDown="ParamBox_KeyDown" GotKeyboardFocus="SelectAllOnFocus"/>
                <TextBlock x:Name="CalHint" Text="回车写入。写实测液量即触发校准，泵不在校准状态时其它写命令才有效。"
                           Style="{StaticResource Caption}" Canvas.Left="460" Canvas.Top="38"/>
            </Canvas>
        </Border>

        <!-- ══ 状态栏 ══ -->
        <Border Style="{StaticResource Card}" Canvas.Left="40" Canvas.Top="556" Width="1160" Height="42">
            <TextBlock x:Name="StatusText" Text="就绪" Foreground="#9AA0AA" FontSize="13"
                       Margin="16,0,16,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Canvas>
</base:DeviceScreenBase>
