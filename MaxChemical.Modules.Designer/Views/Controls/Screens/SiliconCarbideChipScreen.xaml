<base:DeviceScreenBase x:Class="MaxChemical.Modules.Designer.Views.Controls.Screens.SiliconCarbideChipScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:base="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             Width="1240" Height="620">

    <!--
      进料系统集成碳化硅芯片（六联罐增压系统）嵌入式屏幕（按 tank-system.html 翻译）
      用 Viewbox 包一个 1456×553 的 Canvas（与 HTML 舞台同比例），所有元素按 HTML 的
      百分比定位换算成 Canvas 绝对坐标，避免屏幕比例不同导致的错位。
      图片素材（放 Resources/Screens/）：
        scc_bg.png（背景）scc_tanks.png（罐组）scc_pump.png（水泵）
        scc_arrow.png（进出口箭头）scc_pipe.png（管道）
    -->

    <base:DeviceScreenBase.Resources>
        <Style x:Key="TempBox" TargetType="Border">
            <Setter Property="Background" Value="#D928282C"/>
            <Setter Property="BorderBrush" Value="#4D787882"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style x:Key="TempText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8EE"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="PortLbl" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderBrush" Value="#5A5A5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#4A4A4E" Offset="0"/>
                        <GradientStop Color="#2C2C30" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </base:DeviceScreenBase.Resources>

    <!-- 整屏背景铺底 -->
    <Border ClipToBounds="True" Background="#0A0809">
        <!-- Viewbox + 1456×553 Canvas：与 HTML 舞台同比例，坐标 = HTML 百分比 × (1456 或 553) -->
        <Viewbox Stretch="Uniform">
            <Canvas Width="1456" Height="553">

                <!-- 背景图（铺满 Canvas） -->
                <Image Source="pack://siteoforigin:,,,/Resources/Screens/scc_bg.png"
                       Width="1456" Height="553" Canvas.Left="0" Canvas.Top="0" Stretch="Fill"/>

                <!-- ===== 管道（3 段，主管高度 top=39.3%×553≈217；粗 11） ===== -->
                <!-- 进口→罐组：left 9%×1456≈131，width 2.5%×1456≈36 -->
                <Image Source="pack://siteoforigin:,,,/Resources/Screens/scc_pipe.png"
                       Canvas.Left="131" Canvas.Top="217" Width="36" Height="11" Stretch="Fill"/>
                <!-- 罐组→水泵：left 73%≈1063，width 13%≈189 -->
                <Image Source="pack://siteoforigin:,,,/Resources/Screens/scc_pipe.png"
                       Canvas.Left="1063" Canvas.Top="217" Width="189" Height="11" Stretch="Fill"/>
                <!-- 水泵→出口：left 85.5%≈1245，width 5%≈73 -->
                <Image Source="pack://siteoforigin:,,,/Resources/Screens/scc_pipe.png"
                       Canvas.Left="1245" Canvas.Top="217" Width="73" Height="11" Stretch="Fill"/>

                <!-- ===== 罐组（left 11.5%≈167，top 13%≈72，width 62%≈903，aspect 646/270→高≈377） ===== -->
                <Image Source="pack://siteoforigin:,,,/Resources/Screens/scc_tanks.png"
                       Canvas.Left="167" Canvas.Top="72" Width="903" Height="377" Stretch="Uniform"/>

                <!-- ===== 水泵（left 79%≈1150，top 22%≈122，width 6.5%≈95，aspect 116/194→高≈159） ===== -->
                <Image Source="pack://siteoforigin:,,,/Resources/Screens/scc_pump.png"
                       Canvas.Left="1150" Canvas.Top="122" Width="95" Height="159" Stretch="Uniform"/>

                <!-- ===== 进口（left 1%≈15，top 36.4%≈201）标牌 + 箭头 ===== -->
                <Border Style="{StaticResource PortLbl}" Canvas.Left="15" Canvas.Top="201">
                    <TextBlock Text="进口" Foreground="#CFCFD4" FontSize="20" FontWeight="Bold"/>
                </Border>
                <Image Source="pack://siteoforigin:,,,/Resources/Screens/scc_arrow.png"
                       Canvas.Left="95" Canvas.Top="205" Width="44" Height="31" Stretch="Uniform"/>

                <!-- ===== 出口（right 1.5%→left≈1366，top 36.4%≈201）箭头 + 标牌 ===== -->
                <Image Source="pack://siteoforigin:,,,/Resources/Screens/scc_arrow.png"
                       Canvas.Left="1290" Canvas.Top="205" Width="44" Height="31" Stretch="Uniform"/>
                <Border Style="{StaticResource PortLbl}" Canvas.Left="1338" Canvas.Top="201">
                    <TextBlock Text="出口" Foreground="#CFCFD4" FontSize="20" FontWeight="Bold"/>
                </Border>

                <!-- ===== 六罐温度框（temps：left 11.5%≈167，width 62%≈903，bottom 8%→top≈453） ===== -->
                <Canvas Canvas.Left="167" Canvas.Top="453" Width="903" Height="40">
                    <Border Style="{StaticResource TempBox}" Canvas.Left="10"  Width="120">
                        <TextBlock x:Name="T1" Text="--" Style="{StaticResource TempText}"/>
                    </Border>
                    <Border Style="{StaticResource TempBox}" Canvas.Left="158" Width="120">
                        <TextBlock x:Name="T2" Text="--" Style="{StaticResource TempText}"/>
                    </Border>
                    <Border Style="{StaticResource TempBox}" Canvas.Left="306" Width="120">
                        <TextBlock x:Name="T3" Text="--" Style="{StaticResource TempText}"/>
                    </Border>
                    <Border Style="{StaticResource TempBox}" Canvas.Left="454" Width="120">
                        <TextBlock x:Name="T4" Text="--" Style="{StaticResource TempText}"/>
                    </Border>
                    <Border Style="{StaticResource TempBox}" Canvas.Left="602" Width="120">
                        <TextBlock x:Name="T5" Text="--" Style="{StaticResource TempText}"/>
                    </Border>
                    <Border Style="{StaticResource TempBox}" Canvas.Left="750" Width="120">
                        <TextBlock x:Name="T6" Text="--" Style="{StaticResource TempText}"/>
                    </Border>
                </Canvas>

                <!-- ===== 右下控制面板（right 1.5%、top 52%→left≈1090，top≈287，width 23%≈335） ===== -->
                <StackPanel Canvas.Left="1098" Canvas.Top="287" Width="340">
                    <Border Background="#9E121012" BorderBrush="#40969696" BorderThickness="1" CornerRadius="7" Padding="16,13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Rectangle Width="15" Height="6" Fill="#D8D8DE" Margin="0,0,5,0"/>
                                <Rectangle Width="15" Height="6" Fill="#D8D8DE" Margin="0,0,5,0"/>
                                <Rectangle Width="15" Height="6" Fill="#D8D8DE" Margin="0,0,5,0"/>
                                <Rectangle Width="15" Height="6" Fill="#D8D8DE" Margin="0,0,5,0"/>
                                <Rectangle Width="15" Height="6" Fill="#D8D8DE"/>
                            </StackPanel>
                            <!-- SV% 可编辑 -->
                            <Grid Margin="0,0,0,11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SV%" Foreground="#C8C8CE" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBox x:Name="SvPercent" Grid.Column="1" Text="--" Background="#2A2A30" BorderBrush="#3A3A40" BorderThickness="1"
                                         Foreground="White" FontSize="20" FontWeight="Bold" TextAlignment="Center" Padding="4,4"
                                         KeyDown="SvPercent_KeyDown" GotKeyboardFocus="Sv_SelectAll"/>
                            </Grid>
                            <!-- 压力 只读 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="P" Foreground="#C8C8CE" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#2A2A30" BorderBrush="#3A3A40" BorderThickness="1" CornerRadius="4" Padding="4,4">
                                    <TextBlock x:Name="Press" Text="--" Foreground="White" FontSize="20" FontWeight="Bold" TextAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="Bar" Foreground="#E0E0E6" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                        <Border Background="#3A3A3E" BorderBrush="#555555" BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <TextBlock Text="自动输出" Foreground="#DCDCE0" FontSize="18" FontWeight="SemiBold"/>
                        </Border>
                        <Grid x:Name="ValveSwitch" Width="100" Height="44" Margin="12,0,0,0" Background="Transparent"
                              Cursor="Hand" MouseLeftButtonDown="ValveSwitch_Click">
                            <Border x:Name="ValveTrack" CornerRadius="22" Background="#E04848"/>
                            <TextBlock x:Name="ValveText" Text="OFF" Foreground="White" FontSize="16" FontWeight="Bold"
                                       VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16,0,0,0"/>
                            <Border x:Name="ValveKnob" Width="32" Height="32" CornerRadius="16" Background="White"
                                    VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

            </Canvas>
        </Viewbox>
    </Border>
</base:DeviceScreenBase>
