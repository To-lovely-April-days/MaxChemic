<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.ZShapePipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="160" 
             d:DesignWidth="180"
             Width="180" Height="160"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="LeftEndCapGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#D9D9D9" Offset="0"/>
            <GradientStop Color="#A0A0A0" Offset="0.5"/>
            <GradientStop Color="#D9D9D9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="RightEndCapGradient" StartPoint="1,0.5" EndPoint="0,0.5">
            <GradientStop Color="#D9D9D9" Offset="0"/>
            <GradientStop Color="#A0A0A0" Offset="0.5"/>
            <GradientStop Color="#D9D9D9" Offset="1"/>
        </LinearGradientBrush>
        
    </UserControl.Resources>

    <Canvas x:Name="PipeCanvas" Background="Transparent" ClipToBounds="False">

        <Canvas x:Name="LeftFlangeGroup" 
                Canvas.Left="2" 
                Canvas.Top="18"
                Width="2.54" 
                Height="24">

            <Rectangle x:Name="LeftFlangeBase"
                       Width="2.54"
                       Height="24"
                       Fill="#D9D9D9"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="LeftFlangeGradient"
                       Width="2.54"
                       Height="24"
                       Fill="{StaticResource LeftEndCapGradient}"
                       Opacity="0.6"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="LeftFlangeBorder"
                       Width="2.54"
                       Height="24"
                       Stroke="#727171" 
                       StrokeThickness="0.7"
                       RadiusX="1.27" 
                       RadiusY="1.27" 
                       Fill="Transparent"/>
        </Canvas>

        <Rectangle x:Name="TopHorizontalPipe" 
                   Canvas.Left="6" 
                   Canvas.Top="20"
                   Width="60"
                   Height="20">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#727171" Offset="0"/>
                    <GradientStop Color="#59727171" Offset="0.264"/>
                    <GradientStop Color="#1A727171" Offset="0.418"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.498"/>
                    <GradientStop Color="#1A727171" Offset="0.581"/>
                    <GradientStop Color="#59727171" Offset="0.719"/>
                    <GradientStop Color="#727171" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Line x:Name="TopHorizontalTopEdge" 
              X1="6" Y1="20" 
              X2="66" Y2="20"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Line x:Name="TopHorizontalBottomEdge" 
              X1="6" Y1="40" 
              X2="66" Y2="40"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Path x:Name="TopElbowPath" StrokeThickness="0.7" Stroke="#727171">
            <Path.Data>
                <PathGeometry x:Name="TopElbowGeometry">
                    <PathFigure x:Name="TopElbowFigure" StartPoint="68,20">
                        <ArcSegment x:Name="TopElbowOuterArc" 
                                    Point="88,40" 
                                    Size="20,20" 
                                    SweepDirection="Clockwise"/>
                        <LineSegment x:Name="TopElbowLine1" Point="78,40"/>
                        <ArcSegment x:Name="TopElbowInnerArc" 
                                    Point="68,30" 
                                    Size="10,10" 
                                    SweepDirection="Counterclockwise"/>
                        <LineSegment Point="68,20"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Fill>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="#5A5A5A" Offset="0"/>
                    <GradientStop Color="#656565" Offset="0.12"/>
                    <GradientStop Color="#727171" Offset="0.22"/>
                    <GradientStop Color="#59727171" Offset="0.32"/>
                    <GradientStop Color="#40727171" Offset="0.40"/>
                    <GradientStop Color="#1A727171" Offset="0.46"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#1A727171" Offset="0.54"/>
                    <GradientStop Color="#40727171" Offset="0.60"/>
                    <GradientStop Color="#59727171" Offset="0.68"/>
                    <GradientStop Color="#727171" Offset="0.78"/>
                    <GradientStop Color="#7D7D7D" Offset="0.88"/>
                    <GradientStop Color="#8A8A8A" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <Path x:Name="TopElbowHighlight" Opacity="0.25" StrokeThickness="0">
            <Path.Data>
                <PathGeometry x:Name="TopElbowHighlightGeometry">
                    <PathFigure x:Name="TopElbowHighlightFigure" StartPoint="70,22">
                        <ArcSegment x:Name="TopElbowHighlightArc" 
                                    Point="86,38" 
                                    Size="18,18" 
                                    SweepDirection="Clockwise"/>
                        <LineSegment Point="76,38"/>
                        <ArcSegment Point="70,32" Size="8,8" SweepDirection="Counterclockwise"/>
                        <LineSegment Point="70,22"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Fill>
                <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#C8C8C8" Offset="0.35"/>
                    <GradientStop Color="#E8E8E8" Offset="0.65"/>
                    <GradientStop Color="#F0F0F0" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <Rectangle x:Name="DiagonalPipe" 
                   Canvas.Left="78"
                   Canvas.Top="40"
                   Width="20"
                   Height="60">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#727171" Offset="0"/>
                    <GradientStop Color="#59727171" Offset="0.264"/>
                    <GradientStop Color="#1A727171" Offset="0.418"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.498"/>
                    <GradientStop Color="#1A727171" Offset="0.581"/>
                    <GradientStop Color="#59727171" Offset="0.719"/>
                    <GradientStop Color="#727171" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Line x:Name="DiagonalLeftEdge" 
              X1="78" Y1="40" 
              X2="78" Y2="100"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Line x:Name="DiagonalRightEdge" 
              X1="98" Y1="40" 
              X2="98" Y2="100"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Path x:Name="BottomElbowPath" StrokeThickness="0.7" Stroke="#727171">
            <Path.Data>
                <PathGeometry x:Name="BottomElbowGeometry">
                    <PathFigure x:Name="BottomElbowFigure" StartPoint="78,100">
                        <ArcSegment x:Name="BottomElbowOuterArc" 
                                    Point="98,120" 
                                    Size="20,20" 
                                    SweepDirection="Counterclockwise"/>
                        <LineSegment x:Name="BottomElbowLine1" Point="98,110"/>
                        <ArcSegment x:Name="BottomElbowInnerArc" 
                                    Point="88,100" 
                                    Size="10,10" 
                                    SweepDirection="Clockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                    <GradientStop Color="#5A5A5A" Offset="0"/>
                    <GradientStop Color="#656565" Offset="0.12"/>
                    <GradientStop Color="#727171" Offset="0.22"/>
                    <GradientStop Color="#59727171" Offset="0.32"/>
                    <GradientStop Color="#40727171" Offset="0.40"/>
                    <GradientStop Color="#1A727171" Offset="0.46"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#1A727171" Offset="0.54"/>
                    <GradientStop Color="#40727171" Offset="0.60"/>
                    <GradientStop Color="#59727171" Offset="0.68"/>
                    <GradientStop Color="#727171" Offset="0.78"/>
                    <GradientStop Color="#7D7D7D" Offset="0.88"/>
                    <GradientStop Color="#8A8A8A" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <Path x:Name="BottomElbowHighlight" Opacity="0.25">
            <Path.Data>
                <PathGeometry x:Name="BottomElbowHighlightGeometry">
                    <PathFigure x:Name="BottomElbowHighlightFigure" StartPoint="83,102">
                        <ArcSegment x:Name="BottomElbowHighlightArc" 
                                    Point="96,115" 
                                    Size="15,15" 
                                    SweepDirection="Counterclockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#FFFFFF" Offset="0.3"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Path.Fill>
        </Path>

        <Rectangle x:Name="BottomHorizontalPipe" 
                   Canvas.Left="98"
                   Canvas.Top="110"
                   Width="60"
                   Height="20">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#727171" Offset="0"/>
                    <GradientStop Color="#59727171" Offset="0.264"/>
                    <GradientStop Color="#1A727171" Offset="0.418"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.498"/>
                    <GradientStop Color="#1A727171" Offset="0.581"/>
                    <GradientStop Color="#59727171" Offset="0.719"/>
                    <GradientStop Color="#727171" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Line x:Name="BottomHorizontalTopEdge" 
              X1="98" Y1="110" 
              X2="158" Y2="110"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Line x:Name="BottomHorizontalBottomEdge" 
              X1="98" Y1="130" 
              X2="158" Y2="130"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"/>

        <Canvas x:Name="RightFlangeGroup" 
                Canvas.Left="158"
                Canvas.Top="108"
                Width="2.54"
                Height="24">

            <Rectangle x:Name="RightFlangeBase" 
                       Width="2.54"
                       Height="24" 
                       Fill="#D9D9D9" 
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="RightFlangeGradient" 
                       Width="2.54"
                       Height="24"
                       Fill="{StaticResource RightEndCapGradient}"
                       Opacity="0.6"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="RightFlangeBorder" 
                       Width="2.54"
                       Height="24" 
                       Stroke="#727171" 
                       StrokeThickness="0.7" 
                       RadiusX="1.27" 
                       RadiusY="1.27" 
                       Fill="Transparent"/>
        </Canvas>

        <Rectangle x:Name="LeftConnection" 
                   Canvas.Left="5"
                   Canvas.Top="20"
                   Width="2"
                   Height="20"
                   Fill="#727171" 
                   Opacity="0.6"/>

        <Rectangle x:Name="RightConnection" 
                   Canvas.Left="157"
                   Canvas.Top="110"
                   Width="2"
                   Height="20"
                   Fill="#727171" 
                   Opacity="0.6"/>

        <Ellipse x:Name="TopLengthAnchor" Canvas.Left="-6" Canvas.Top="24" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整上段水平长度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="BottomLengthAnchor" Canvas.Left="164" Canvas.Top="114" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整下段水平长度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="VerticalOffsetAnchor" Canvas.Left="82" Canvas.Top="64" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整垂直高度差"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="PipeWidthAnchor" Canvas.Left="33" Canvas.Top="44" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="RotateAnchor" Canvas.Left="84" Canvas.Top="-30" Width="12" Height="12" Fill="#4CAF50" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="Hand">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Line x:Name="RotateAnchorLine" X1="90" Y1="0" X2="90" Y2="-24" Stroke="Orange" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0"/>
        <Border x:Name="RotationLabel" Canvas.Left="70" Canvas.Top="-50" Background="#CC000000" CornerRadius="3" Padding="5,2" Visibility="Collapsed">
            <TextBlock x:Name="RotationText" Foreground="White" FontSize="11" Text="0°"/>
        </Border>

        <Rectangle x:Name="SelectionBorder" Canvas.Left="-2" Canvas.Top="-2" Width="184" Height="164" Stroke="#FF9500" StrokeThickness="2" Fill="Transparent" RadiusX="3" RadiusY="3" Visibility="Collapsed">
            <Rectangle.Effect>
                <DropShadowEffect Color="Orange" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
            </Rectangle.Effect>
        </Rectangle>
    </Canvas>
</UserControl>