<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.ZShapePipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="160" 
             d:DesignWidth="180"
             Width="180" Height="160"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <Canvas x:Name="PipeCanvas" ClipToBounds="False">

        <!-- ═══════════════ 左侧法兰组 ═══════════════ -->
        <Canvas x:Name="LeftFlangeGroup" 
                Canvas.Left="2" Canvas.Top="18"
                Width="2.54" Height="24">
            <Rectangle x:Name="LeftFlangeBase" Width="2.54" Height="24" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeGradient" Width="2.54" Height="24" Opacity="0.6" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeBorder" Width="2.54" Height="24" StrokeThickness="0.7" Fill="Transparent" RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 上方水平段 ═══════════════ -->
        <Rectangle x:Name="TopHorizontalPipeBackground" Canvas.Left="6" Canvas.Top="20" Width="60" Height="20" Fill="White"/>
        <Rectangle x:Name="TopHorizontalFluidBackground" Canvas.Left="6" Canvas.Top="20" Width="60" Height="20" Visibility="Collapsed"/>
        <Rectangle x:Name="TopHorizontalFluidPattern" Canvas.Left="6" Canvas.Top="20" Width="60" Height="20" Visibility="Collapsed"/>
        <Rectangle x:Name="TopHorizontalPipe" Canvas.Left="6" Canvas.Top="20" Width="60" Height="20"/>

        <Line x:Name="TopHorizontalTopEdge" X1="6" Y1="20" X2="66" Y2="20"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Line x:Name="TopHorizontalBottomEdge" X1="6" Y1="40" X2="66" Y2="40"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 上方弯头 ═══════════════ -->
        <Path x:Name="TopElbowBackground" Fill="White"/>
        <Path x:Name="TopElbowFluidBackground" Visibility="Collapsed"/>
        <Path x:Name="TopElbowPath" StrokeThickness="0.7">
            <Path.Data>
                <PathGeometry x:Name="TopElbowGeometry"/>
            </Path.Data>
        </Path>
        <Path x:Name="TopElbowHighlight" Opacity="0.25" StrokeThickness="0">
            <Path.Data>
                <PathGeometry x:Name="TopElbowHighlightGeometry"/>
            </Path.Data>
        </Path>

        <!-- ═══════════════ 中间垂直段 ═══════════════ -->
        <Rectangle x:Name="DiagonalPipeBackground" Canvas.Left="78" Canvas.Top="40" Width="20" Height="60" Fill="White"/>
        <Rectangle x:Name="DiagonalFluidBackground" Canvas.Left="78" Canvas.Top="40" Width="20" Height="60" Visibility="Collapsed"/>
        <Rectangle x:Name="DiagonalFluidPattern" Canvas.Left="78" Canvas.Top="40" Width="20" Height="60" Visibility="Collapsed"/>
        <Rectangle x:Name="DiagonalPipe" Canvas.Left="78" Canvas.Top="40" Width="20" Height="60"/>

        <Line x:Name="DiagonalLeftEdge" X1="78" Y1="40" X2="78" Y2="100"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Line x:Name="DiagonalRightEdge" X1="98" Y1="40" X2="98" Y2="100"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 下方弯头 ═══════════════ -->
        <Path x:Name="BottomElbowBackground" Fill="White"/>
        <Path x:Name="BottomElbowFluidBackground" Visibility="Collapsed"/>
        <Path x:Name="BottomElbowPath" StrokeThickness="0.7">
            <Path.Data>
                <PathGeometry x:Name="BottomElbowGeometry"/>
            </Path.Data>
        </Path>
        <Path x:Name="BottomElbowHighlight" Opacity="0.25">
            <Path.Data>
                <PathGeometry x:Name="BottomElbowHighlightGeometry"/>
            </Path.Data>
        </Path>

        <!-- ═══════════════ 下方水平段 ═══════════════ -->
        <Rectangle x:Name="BottomHorizontalPipeBackground" Canvas.Left="98" Canvas.Top="110" Width="60" Height="20" Fill="White"/>
        <Rectangle x:Name="BottomHorizontalFluidBackground" Canvas.Left="98" Canvas.Top="110" Width="60" Height="20" Visibility="Collapsed"/>
        <Rectangle x:Name="BottomHorizontalFluidPattern" Canvas.Left="98" Canvas.Top="110" Width="60" Height="20" Visibility="Collapsed"/>
        <Rectangle x:Name="BottomHorizontalPipe" Canvas.Left="98" Canvas.Top="110" Width="60" Height="20"/>

        <Line x:Name="BottomHorizontalTopEdge" X1="98" Y1="110" X2="158" Y2="110"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Line x:Name="BottomHorizontalBottomEdge" X1="98" Y1="130" X2="158" Y2="130"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 右侧法兰组 ═══════════════ -->
        <Canvas x:Name="RightFlangeGroup" 
                Canvas.Left="158" Canvas.Top="108"
                Width="2.54" Height="24">
            <Rectangle x:Name="RightFlangeBase" Width="2.54" Height="24" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeGradient" Width="2.54" Height="24" Opacity="0.6" RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeBorder" Width="2.54" Height="24" StrokeThickness="0.7" RadiusX="1.27" RadiusY="1.27" Fill="Transparent"/>
        </Canvas>

        <!-- ═══════════════ 连接处 ═══════════════ -->
        <Rectangle x:Name="LeftConnection" Canvas.Left="5" Canvas.Top="20" Width="2" Height="20" Opacity="0.6"/>
        <Rectangle x:Name="RightConnection" Canvas.Left="157" Canvas.Top="110" Width="2" Height="20" Opacity="0.6"/>

        <!-- ═══════════════════════════════════════════════════════════
             ★ 赛博流光层 — 默认隐藏，UseDefaultStyle=true 时显示
             ═══════════════════════════════════════════════════════════ -->

        <!-- 金属管壁层（5 段都覆盖） -->
        <Rectangle x:Name="CyberTopHorizMetal" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Path x:Name="CyberTopElbowMetal" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="CyberDiagMetal" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Path x:Name="CyberBottomElbowMetal" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="CyberBottomHorizMetal" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- 内部暗腔 -->
        <Rectangle x:Name="CyberTopHorizDark" Fill="#000814" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Path x:Name="CyberTopElbowDark" Fill="#000814" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="CyberDiagDark" Fill="#000814" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Path x:Name="CyberBottomElbowDark" Fill="#000814" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="CyberBottomHorizDark" Fill="#000814" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- ★ Z 形中心线流光（一条 path 横跨 5 段，流光自然顺着两个弯头转弯） -->
        <Path x:Name="CyberMainStream"
              Visibility="Collapsed" IsHitTestVisible="False"
              StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Effect>
                <BlurEffect Radius="3" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <Path x:Name="CyberParticleStream"
              Visibility="Collapsed" IsHitTestVisible="False"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect>
                <BlurEffect Radius="2" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <Path x:Name="CyberSparkStream"
              Visibility="Collapsed" IsHitTestVisible="False"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Stroke="#FFFFFF">
            <Path.Effect>
                <BlurEffect Radius="1.5" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- ═══════════════ 锚点 ═══════════════ -->
        <Ellipse x:Name="TopLengthAnchor" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整上段水平长度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="BottomLengthAnchor" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整下段水平长度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="VerticalOffsetAnchor" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整垂直高度差"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="PipeWidthAnchor" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="RotateAnchor" Width="12" Height="12" Fill="#4CAF50" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="Hand">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Line x:Name="RotateAnchorLine" Stroke="Orange" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0"/>

        <Border x:Name="RotationLabel" Background="#CC000000" CornerRadius="3" Padding="5,2" Visibility="Collapsed">
            <TextBlock x:Name="RotationText" Foreground="White" FontSize="11" Text="0°"/>
        </Border>

        <!-- ═══════════════ 选中高亮边框（Z 形：3 段） ═══════════════ -->
        <Rectangle x:Name="SelectionBorder" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="SelectionBorderM" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="SelectionBorderB" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
    </Canvas>
</UserControl>
