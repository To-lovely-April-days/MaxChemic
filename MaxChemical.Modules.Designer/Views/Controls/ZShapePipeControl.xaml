<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.ZShapePipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="160" 
             d:DesignWidth="180"
             Width="180" Height="160"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <!-- ═══ 所有画刷均由代码动态生成，不再使用 StaticResource ═══ -->

    <!-- 不设 Background（=null）：空白区域不捕获鼠标，点击穿透到下方
         命中测试仅作用于实际有 Fill 的子元素（上下横管、垂直段、法兰） -->
    <Canvas x:Name="PipeCanvas" ClipToBounds="False">

        <!-- ═══════════════ 左侧法兰组 ═══════════════ -->
        <Canvas x:Name="LeftFlangeGroup" 
                Canvas.Left="2" Canvas.Top="18"
                Width="2.54" Height="24">
            <Rectangle x:Name="LeftFlangeBase"
                       Width="2.54" Height="24"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeGradient"
                       Width="2.54" Height="24"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeBorder"
                       Width="2.54" Height="24"
                       StrokeThickness="0.7"
                       Fill="Transparent"
                       RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 上方水平段 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Rectangle x:Name="TopHorizontalPipeBackground"
                   Canvas.Left="6" Canvas.Top="20"
                   Width="60" Height="20"
                   Fill="White"/>

        <Rectangle x:Name="TopHorizontalFluidBackground"
                   Canvas.Left="6" Canvas.Top="20"
                   Width="60" Height="20"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="TopHorizontalFluidPattern"
                   Canvas.Left="6" Canvas.Top="20"
                   Width="60" Height="20"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="TopHorizontalPipe" 
                   Canvas.Left="6" Canvas.Top="20"
                   Width="60" Height="20"/>

        <Line x:Name="TopHorizontalTopEdge" 
              X1="6" Y1="20" X2="66" Y2="20"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <Line x:Name="TopHorizontalBottomEdge" 
              X1="6" Y1="40" X2="66" Y2="40"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 上方弯头 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Path x:Name="TopElbowBackground" Fill="White"/>
        <Path x:Name="TopElbowFluidBackground" Visibility="Collapsed"/>

        <Path x:Name="TopElbowPath" StrokeThickness="0.7">
            <Path.Data>
                <PathGeometry x:Name="TopElbowGeometry"/>
            </Path.Data>
        </Path>

        <Path x:Name="TopElbowHighlight" Opacity="0.25" StrokeThickness="0">
            <Path.Data>
                <PathGeometry x:Name="TopElbowHighlightGeometry"/>
            </Path.Data>
        </Path>

        <!-- ═══════════════ 中间垂直段 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Rectangle x:Name="DiagonalPipeBackground"
                   Canvas.Left="78" Canvas.Top="40"
                   Width="20" Height="60"
                   Fill="White"/>

        <Rectangle x:Name="DiagonalFluidBackground"
                   Canvas.Left="78" Canvas.Top="40"
                   Width="20" Height="60"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="DiagonalFluidPattern"
                   Canvas.Left="78" Canvas.Top="40"
                   Width="20" Height="60"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="DiagonalPipe" 
                   Canvas.Left="78" Canvas.Top="40"
                   Width="20" Height="60"/>

        <Line x:Name="DiagonalLeftEdge" 
              X1="78" Y1="40" X2="78" Y2="100"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <Line x:Name="DiagonalRightEdge" 
              X1="98" Y1="40" X2="98" Y2="100"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 下方弯头 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Path x:Name="BottomElbowBackground" Fill="White"/>
        <Path x:Name="BottomElbowFluidBackground" Visibility="Collapsed"/>

        <Path x:Name="BottomElbowPath" StrokeThickness="0.7">
            <Path.Data>
                <PathGeometry x:Name="BottomElbowGeometry"/>
            </Path.Data>
        </Path>

        <Path x:Name="BottomElbowHighlight" Opacity="0.25">
            <Path.Data>
                <PathGeometry x:Name="BottomElbowHighlightGeometry"/>
            </Path.Data>
        </Path>

        <!-- ═══════════════ 下方水平段 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Rectangle x:Name="BottomHorizontalPipeBackground"
                   Canvas.Left="98" Canvas.Top="110"
                   Width="60" Height="20"
                   Fill="White"/>

        <Rectangle x:Name="BottomHorizontalFluidBackground"
                   Canvas.Left="98" Canvas.Top="110"
                   Width="60" Height="20"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="BottomHorizontalFluidPattern"
                   Canvas.Left="98" Canvas.Top="110"
                   Width="60" Height="20"
                   Visibility="Collapsed"/>

        <Rectangle x:Name="BottomHorizontalPipe" 
                   Canvas.Left="98" Canvas.Top="110"
                   Width="60" Height="20"/>

        <Line x:Name="BottomHorizontalTopEdge" 
              X1="98" Y1="110" X2="158" Y2="110"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <Line x:Name="BottomHorizontalBottomEdge" 
              X1="98" Y1="130" X2="158" Y2="130"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- ═══════════════ 右侧法兰组 ═══════════════ -->
        <Canvas x:Name="RightFlangeGroup" 
                Canvas.Left="158" Canvas.Top="108"
                Width="2.54" Height="24">
            <Rectangle x:Name="RightFlangeBase" 
                       Width="2.54" Height="24" 
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeGradient" 
                       Width="2.54" Height="24"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="RightFlangeBorder" 
                       Width="2.54" Height="24" 
                       StrokeThickness="0.7" 
                       RadiusX="1.27" RadiusY="1.27" 
                       Fill="Transparent"/>
        </Canvas>

        <!-- ═══════════════ 连接处 ═══════════════ -->
        <Rectangle x:Name="LeftConnection" 
                   Canvas.Left="5" Canvas.Top="20"
                   Width="2" Height="20"
                   Opacity="0.6"/>

        <Rectangle x:Name="RightConnection" 
                   Canvas.Left="157" Canvas.Top="110"
                   Width="2" Height="20"
                   Opacity="0.6"/>

        <!-- ═══════════════ 锚点 ═══════════════ -->
        <Ellipse x:Name="TopLengthAnchor" Canvas.Left="-6" Canvas.Top="24" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整上段水平长度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="BottomLengthAnchor" Canvas.Left="164" Canvas.Top="114" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整下段水平长度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="VerticalOffsetAnchor" Canvas.Left="82" Canvas.Top="64" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整垂直高度差"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="PipeWidthAnchor" Canvas.Left="33" Canvas.Top="44" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="RotateAnchor" Canvas.Left="84" Canvas.Top="-30" Width="12" Height="12" Fill="#4CAF50" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="Hand">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Line x:Name="RotateAnchorLine" X1="90" Y1="0" X2="90" Y2="-24" Stroke="Orange" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0"/>
        <Border x:Name="RotationLabel" Canvas.Left="70" Canvas.Top="-50" Background="#CC000000" CornerRadius="3" Padding="5,2" Visibility="Collapsed">
            <TextBlock x:Name="RotationText" Foreground="White" FontSize="11" Text="0°"/>
        </Border>

        <!-- ═══════════════ 选中高亮边框 ═══════════════ -->
        <!-- 选中描边：Z 形，由上水平 + 中间垂直 + 下水平三段贴合 -->
        <Rectangle x:Name="SelectionBorder" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="SelectionBorderM" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="SelectionBorderB" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
    </Canvas>
</UserControl>