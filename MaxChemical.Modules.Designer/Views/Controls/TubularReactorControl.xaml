<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.TubularReactorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="210"
             Width="210" Height="800"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" SnapsToDevicePixels="True" EnableClearType="False"/>
    </UserControl.CacheMode>

    <UserControl.Resources>
        <LinearGradientBrush x:Key="CylinderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E293B" Offset="0"/>
            <GradientStop Color="#64748B" Offset="0.15"/>
            <GradientStop Color="#475569" Offset="0.25"/>
            <GradientStop Color="#1E293B" Offset="0.60"/>
            <GradientStop Color="#0F172A" Offset="0.85"/>
            <GradientStop Color="#020617" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PipeDarkGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1E293B" Offset="0"/>
            <GradientStop Color="#475569" Offset="0.20"/>
            <GradientStop Color="#64748B" Offset="0.38"/>
            <GradientStop Color="#334155" Offset="0.58"/>
            <GradientStop Color="#1E293B" Offset="0.80"/>
            <GradientStop Color="#0F172A" Offset="1.0"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Canvas Background="Transparent">

        <Rectangle x:Name="DraggableArea"
                   Canvas.Left="0" Canvas.Top="0"
                   Width="210" Height="800"
                   Fill="Transparent" Panel.ZIndex="0" Cursor="SizeAll"/>

        <!-- ===================================================================
             顶部进料接管
             =================================================================== -->

        <!-- 顶部进料法兰端盖 -->
        <Rectangle Canvas.Left="88" Canvas.Top="10"
                   Width="28" Height="8"
                   RadiusX="4" RadiusY="4"
                   Stroke="#020617" StrokeThickness="1.5"
                   Panel.ZIndex="5">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#475569" Offset="0.28"/>
                    <GradientStop Color="#64748B" Offset="0.50"/>
                    <GradientStop Color="#334155" Offset="0.72"/>
                    <GradientStop Color="#0F172A" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.30" BlurRadius="5"
                                  ShadowDepth="2" Direction="270" RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 进料管道体 -->
        <Rectangle Canvas.Left="92" Canvas.Top="18"
                   Width="20" Height="160"
                   Fill="{StaticResource PipeDarkGradient}"
                   Stroke="#020617" StrokeThickness="1.5"
                   Panel.ZIndex="2">
            <Rectangle.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.20" BlurRadius="6"
                                  ShadowDepth="3" Direction="270" RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 进料管道高光条 -->
        <Rectangle Canvas.Left="94" Canvas.Top="20"
                   Width="5" Height="156"
                   Opacity="0.35" Panel.ZIndex="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#94A3B8" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ========== 顶部椭圆封头 ========== -->
        <Path Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="3"
              Data="M 10,196 C 10,123 194,123 194,196 Z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#334155" Offset="0"/>
                    <GradientStop Color="#94A3B8" Offset="0.20"/>
                    <GradientStop Color="#334155" Offset="0.50"/>
                    <GradientStop Color="#0F172A" Offset="0.85"/>
                    <GradientStop Color="#020617" Offset="1.0"/>
                </LinearGradientBrush>
            </Path.Fill>
            <Path.Stroke>
                <SolidColorBrush Color="#020617"/>
            </Path.Stroke>
            <Path.StrokeThickness>1.5</Path.StrokeThickness>
            <Path.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="10"
                                  ShadowDepth="5" Direction="270" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- 封头高光弧 -->
        <Path Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="4" Opacity="0.45"
              Data="M 42,183 C 42,151 162,151 162,183"
              Stroke="#CBD5E1" StrokeThickness="1.5" Fill="Transparent"/>

        <!-- ========== 主筒体 ========== -->
        <Rectangle Canvas.Left="10" Canvas.Top="196"
                   Width="184" Height="420"
                   Fill="{StaticResource CylinderBrush}"
                   Stroke="#020617" StrokeThickness="1.5"
                   Panel.ZIndex="3"/>

        <!-- 顶焊缝 -->
        <Path Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="4"
              Data="M 10,196 A 92,14 0 0 1 194,196"
              Stroke="#020617" StrokeThickness="2" Fill="Transparent"/>
        <Path Canvas.Left="0" Canvas.Top="-1.5" Panel.ZIndex="4" Opacity="0.4"
              Data="M 10,196 A 92,14 0 0 1 194,196"
              Stroke="#94A3B8" StrokeThickness="1" Fill="Transparent"/>

        <!-- 加强环 1 -->
        <Path Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="4"
              Data="M 10,336 A 92,11 0 0 1 194,336"
              Stroke="#020617" StrokeThickness="3" Fill="Transparent"/>
        <Path Canvas.Left="0" Canvas.Top="-2" Panel.ZIndex="4" Opacity="0.6"
              Data="M 10,336 A 92,11 0 0 1 194,336"
              Stroke="#64748B" StrokeThickness="1.5" Fill="Transparent"/>

        <!-- 加强环 2 -->
        <Path Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="4"
              Data="M 10,476 A 92,11 0 0 1 194,476"
              Stroke="#020617" StrokeThickness="3" Fill="Transparent"/>
        <Path Canvas.Left="0" Canvas.Top="-2" Panel.ZIndex="4" Opacity="0.6"
              Data="M 10,476 A 92,11 0 0 1 194,476"
              Stroke="#64748B" StrokeThickness="1.5" Fill="Transparent"/>

        <!-- 底焊缝 -->
        <Path Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="4"
              Data="M 10,616 A 92,14 0 0 1 194,616"
              Stroke="#020617" StrokeThickness="2" Fill="Transparent"/>
        <Path Canvas.Left="0" Canvas.Top="-1.5" Panel.ZIndex="4" Opacity="0.4"
              Data="M 10,616 A 92,14 0 0 1 194,616"
              Stroke="#94A3B8" StrokeThickness="1" Fill="Transparent"/>

        <!-- 筒体铭牌 -->
        <TextBlock Canvas.Left="38" Canvas.Top="368"
                   Text="HTLAB-TR-2000"
                   Foreground="#64748B" FontSize="13" FontWeight="Bold"
                   FontFamily="Arial" Panel.ZIndex="5">
            <TextBlock.RenderTransform>
                <RotateTransform Angle="90" CenterX="55" CenterY="10"/>
            </TextBlock.RenderTransform>
            <TextBlock.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="2"
                                  ShadowDepth="1" Direction="135" RenderingBias="Performance"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- ========== 底部椭圆封头 ========== -->
        <Path Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="3"
              Data="M 10,616 C 10,696 194,696 194,616 Z">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#334155" Offset="0"/>
                    <GradientStop Color="#94A3B8" Offset="0.20"/>
                    <GradientStop Color="#334155" Offset="0.50"/>
                    <GradientStop Color="#0F172A" Offset="0.85"/>
                    <GradientStop Color="#020617" Offset="1.0"/>
                </LinearGradientBrush>
            </Path.Fill>
            <Path.Stroke>
                <SolidColorBrush Color="#020617"/>
            </Path.Stroke>
            <Path.StrokeThickness>1.5</Path.StrokeThickness>
        </Path>

        <!-- ===================================================================
             底部出料接管
             =================================================================== -->

        <!-- 出料管道体 -->
        <Rectangle Canvas.Left="92" Canvas.Top="674"
                   Width="20" Height="108"
                   Fill="{StaticResource PipeDarkGradient}"
                   Stroke="#020617" StrokeThickness="1.5"
                   Panel.ZIndex="2">
            <Rectangle.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.20" BlurRadius="6"
                                  ShadowDepth="3" Direction="270" RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 出料管道高光条 -->
        <Rectangle Canvas.Left="94" Canvas.Top="676"
                   Width="5" Height="104"
                   Opacity="0.35" Panel.ZIndex="3">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#94A3B8" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 底部出料法兰端盖 -->
        <Rectangle Canvas.Left="88" Canvas.Top="782"
                   Width="28" Height="8"
                   RadiusX="4" RadiusY="4"
                   Stroke="#020617" StrokeThickness="1.5"
                   Panel.ZIndex="5">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1E293B" Offset="0"/>
                    <GradientStop Color="#475569" Offset="0.28"/>
                    <GradientStop Color="#64748B" Offset="0.50"/>
                    <GradientStop Color="#334155" Offset="0.72"/>
                    <GradientStop Color="#0F172A" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="5"
                                  ShadowDepth="2" Direction="270" RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ========== 流体动画层 ========== -->

        <Canvas x:Name="InletFluidContainer"
                Canvas.Left="92" Canvas.Top="18"
                Panel.ZIndex="10" Visibility="Collapsed">
            <Rectangle x:Name="InletFluid" Width="16" Height="156">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="InletFluidGradient"
                                         StartPoint="0,0" EndPoint="0,1">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="InletFluidGradientTransform" Y="0"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#2A5DADE2" Offset="0"/>
                        <GradientStop Color="#8085C1F0" Offset="0.25"/>
                        <GradientStop Color="#D0AED6F1" Offset="0.5"/>
                        <GradientStop Color="#8085C1F0" Offset="0.75"/>
                        <GradientStop Color="#2A5DADE2" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Canvas>

        <Canvas x:Name="VesselFluidContainer"
                Canvas.Left="11" Canvas.Top="197"
                Panel.ZIndex="3" Visibility="Collapsed">
            <Rectangle x:Name="VesselFluid" Width="182" Height="418" Opacity="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3A5DADE2" Offset="0"/>
                        <GradientStop Color="#7085C1F0" Offset="0.30"/>
                        <GradientStop Color="#90AED6F1" Offset="0.50"/>
                        <GradientStop Color="#7085C1F0" Offset="0.70"/>
                        <GradientStop Color="#3A5DADE2" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Effect>
                    <DropShadowEffect Color="#5DADE2" Opacity="0.4" BlurRadius="12"
                                      ShadowDepth="0" RenderingBias="Performance"/>
                </Rectangle.Effect>
            </Rectangle>
        </Canvas>

        <Canvas x:Name="OutletFluidContainer"
                Canvas.Left="92" Canvas.Top="674"
                Panel.ZIndex="10" Visibility="Collapsed">
            <Rectangle x:Name="OutletFluid" Width="16" Height="104">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="OutletFluidGradient"
                                         StartPoint="0,0" EndPoint="0,1">
                        <LinearGradientBrush.RelativeTransform>
                            <TranslateTransform x:Name="OutletFluidGradientTransform" Y="0"/>
                        </LinearGradientBrush.RelativeTransform>
                        <GradientStop Color="#2A5DADE2" Offset="0"/>
                        <GradientStop Color="#8085C1F0" Offset="0.25"/>
                        <GradientStop Color="#D0AED6F1" Offset="0.5"/>
                        <GradientStop Color="#8085C1F0" Offset="0.75"/>
                        <GradientStop Color="#2A5DADE2" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Canvas>

    </Canvas>
</UserControl>