<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.DigitalScaleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             mc:Ignorable="d"
             d:DesignHeight="230" 
             d:DesignWidth="450"
             Background="Transparent"
             Cursor="SizeAll"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ============================================================ -->
        <!-- 渐变定义 — 1:1复刻SVG C方案 A&D风格                          -->
        <!-- ============================================================ -->

        <!-- 屏幕渐变 SVG id="s3": 垂直 #1A3048 → #0E2030 -->
        <LinearGradientBrush x:Key="ScreenGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#1A3048" Offset="0"/>
            <GradientStop Color="#0E2030" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="LcdTextBrush" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="LcdInactiveBrush" Color="#15000000"/>
    </UserControl.Resources>

    <Viewbox Stretch="Fill">
        <Canvas Width="450" Height="230">

            <!-- 可拖拽区域 -->
            <Rectangle x:Name="DraggableArea"
                       Canvas.Left="0" Canvas.Top="0"
                       Width="450" Height="230"
                       Fill="Transparent"
                       Panel.ZIndex="100"
                       Cursor="SizeAll"
                       MouseDown="OnDraggableAreaMouseDown"
                       MouseMove="OnDraggableAreaMouseMove"
                       MouseUp="OnDraggableAreaMouseUp"
                       MouseLeave="OnDraggableAreaMouseLeave"/>

            <!-- ============================================================ -->
            <!-- 1. 顶面 — 米白色                                             -->
            <!-- SVG: fill=#EDE8E0 stroke=#C0B8AE 0.6px                       -->
            <!-- ============================================================ -->
            <Path Fill="#EDE8E0" Stroke="#C0B8AE" StrokeThickness="0.6" Panel.ZIndex="2">
                <Path.Data>
                    <PathGeometry Figures="M 110,5 L 342,5 Q 366,5 378,30 L 402,98 L 50,98 L 74,30 Q 86,5 110,5 Z"/>
                </Path.Data>
            </Path>

            <!-- 2. 顶面光泽 — white opacity=0.35 -->
            <Path Fill="White" Opacity="0.35" IsHitTestVisible="False" Panel.ZIndex="2">
                <Path.Data>
                    <PathGeometry Figures="M 114,9 L 226,9 L 170,94 L 54,94 Z"/>
                </Path.Data>
            </Path>

            <!-- 3-5. 顶面透视线 — stroke=#C0B8AE 0.4px -->
            <Line X1="110" Y1="5" X2="50" Y2="98" Stroke="#C0B8AE" StrokeThickness="0.4" Opacity="0.4" Panel.ZIndex="2"/>
            <Line X1="342" Y1="5" X2="402" Y2="98" Stroke="#C0B8AE" StrokeThickness="0.4" Opacity="0.4" Panel.ZIndex="2"/>
            <Line X1="110" Y1="5" X2="342" Y2="5" Stroke="#C0B8AE" StrokeThickness="0.4" Opacity="0.3" Panel.ZIndex="2"/>

            <!-- ============================================================ -->
            <!-- 6. 机身 — 米白微灰 梯形后倾                                  -->
            <!-- SVG: fill=#E2DCD4 stroke=#AAA49C 0.7px                       -->
            <!-- ============================================================ -->
            <Path Fill="#E2DCD4" Stroke="#AAA49C" StrokeThickness="0.7" Panel.ZIndex="3">
                <Path.Data>
                    <PathGeometry Figures="M 50,98 L 402,98 L 418,192 Q 422,218 390,218 L 62,218 Q 30,218 34,192 Z"/>
                </Path.Data>
            </Path>

            <!-- 7. 机身左高光 — white opacity=0.3 -->
            <Path Fill="White" Opacity="0.3" IsHitTestVisible="False" Panel.ZIndex="3">
                <Path.Data>
                    <PathGeometry Figures="M 54,103 L 38,188 Q 34,214 66,214 L 82,214 L 94,103 Z"/>
                </Path.Data>
            </Path>

            <!-- 8. 机身右暗影 — #706860 opacity=0.05 -->
            <Path Fill="#706860" Opacity="0.05" IsHitTestVisible="False" Panel.ZIndex="3">
                <Path.Data>
                    <PathGeometry Figures="M 398,103 L 414,184 Q 418,214 394,214 L 382,214 L 374,103 Z"/>
                </Path.Data>
            </Path>

            <!-- ============================================================ -->
            <!-- 9. 海军蓝面板区                                               -->
            <!-- SVG: rect fill=#1A3050 stroke=#0E2040 opacity=0.95           -->
            <!-- SVG: x=30 y=46 w=158 h=48 rx=3                              -->
            <!-- WPF: x=66 y=107 w=316 h=102 rx=6                            -->
            <!-- ============================================================ -->
            <Rectangle Canvas.Left="66" Canvas.Top="107" 
                       Width="316" Height="102" RadiusX="6" RadiusY="6"
                       Fill="#1A3050" Stroke="#0E2040" StrokeThickness="0.5" Opacity="0.95" 
                       Panel.ZIndex="4"/>

            <!-- ============================================================ -->
            <!-- 10. 屏幕 — 深海军蓝底 白色数字                               -->
            <!-- SVG: fill=s3 stroke=#081828 0.5px                            -->
            <!-- SVG: x=36 y=50 w=110 h=24 rx=3                              -->
            <!-- WPF: x=78 y=116 w=220 h=51 rx=6                             -->
            <!-- ============================================================ -->
            <Rectangle Canvas.Left="78" Canvas.Top="116" 
                       Width="220" Height="51" RadiusX="6" RadiusY="6"
                       Fill="{StaticResource ScreenGradient}" 
                       Stroke="#081828" StrokeThickness="0.5" Panel.ZIndex="5"/>

            <!-- 11. 屏幕顶部高光线 — #5A90B0 @0.1 -->
            <Rectangle Canvas.Left="82" Canvas.Top="120" 
                       Width="212" Height="2.5" RadiusX="1" RadiusY="1"
                       Fill="#5A90B0" Opacity="0.1" IsHitTestVisible="False" Panel.ZIndex="5"/>

            <!-- 12. 数字显示 — fill=#E8F0F8 Consolas 18px bold -->
            <TextBlock x:Name="ValueText"
                       Canvas.Left="82" Canvas.Top="120" Width="212" Height="46"
                       Text="{Binding WeightValue, StringFormat={}{0:F2}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="Consolas" FontSize="36" FontWeight="Bold"
                       Foreground="#E8F0F8"
                       TextAlignment="Right" Padding="0,4,60,0"
                       Visibility="{Binding IsPoweredOn, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Panel.ZIndex="6"/>

            <!-- 13. 单位 — fill=#C0D8E8 Times 7px -->
            <TextBlock Canvas.Left="276" Canvas.Top="124"
                       Text="{Binding CurrentUnit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontFamily="Times New Roman" FontSize="14" 
                       Foreground="#C0D8E8"
                       Visibility="{Binding IsPoweredOn, Converter={StaticResource BooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Panel.ZIndex="6"/>

            <!-- 14. 信号条 — #C0D8E8 @0.3 -->
            <Rectangle Canvas.Left="82" Canvas.Top="130" 
                       Width="14" Height="5" RadiusX="1.5" RadiusY="1.5"
                       Fill="#C0D8E8" Opacity="0.3" IsHitTestVisible="False" Panel.ZIndex="6"/>

            <!-- ============================================================ -->
            <!-- 按钮组 — 面板内(TARE/UNIT) + 机身上(CF/SEL/ENT)              -->
            <!-- ============================================================ -->

            <!-- 15. TARE按钮 — fill=#2A5070 stroke=#1A3858 -->
            <Rectangle Canvas.Left="314" Canvas.Top="120" 
                       Width="56" Height="21" RadiusX="6" RadiusY="6"
                       Fill="#2A5070" Stroke="#1A3858" StrokeThickness="0.4" Panel.ZIndex="5"/>
            <TextBlock Canvas.Left="314" Canvas.Top="122" Width="56" Height="21"
                       Text="TARE" FontFamily="Arial" FontSize="11" FontWeight="Bold"
                       Foreground="#B0D0E0" TextAlignment="Center"
                       Panel.ZIndex="6"/>
            <Button Canvas.Left="314" Canvas.Top="120" Width="56" Height="21" 
                    Background="Transparent" BorderThickness="0" Opacity="0"
                    Panel.ZIndex="99" Cursor="Hand" Click="OnTareButtonClick"/>

            <!-- 16. UNIT按钮 — fill=#2A5070 @0.7 stroke=#1A3858 -->
            <Rectangle Canvas.Left="314" Canvas.Top="146" 
                       Width="56" Height="21" RadiusX="6" RadiusY="6"
                       Stroke="#1A3858" StrokeThickness="0.35" Panel.ZIndex="5">
                <Rectangle.Fill>
                    <SolidColorBrush Color="#2A5070" Opacity="0.7"/>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock Canvas.Left="314" Canvas.Top="148" Width="56" Height="21"
                       Text="UNIT" FontFamily="Arial" FontSize="11" FontWeight="Bold"
                       Foreground="#90B8C8" TextAlignment="Center"
                       Panel.ZIndex="6"/>
            <Button Canvas.Left="314" Canvas.Top="146" Width="56" Height="21" 
                    Background="Transparent" BorderThickness="0" Opacity="0"
                    Panel.ZIndex="99" Cursor="Hand" Click="OnUnitButtonClick"/>

            <!-- 17. CF按钮 — fill=#AAA49C @0.35 stroke=#8A8480 -->
            <Rectangle Canvas.Left="118" Canvas.Top="183" 
                       Width="44" Height="15" RadiusX="5" RadiusY="5"
                       Stroke="#8A8480" StrokeThickness="0.35" Panel.ZIndex="5">
                <Rectangle.Fill>
                    <SolidColorBrush Color="#AAA49C" Opacity="0.35"/>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock Canvas.Left="118" Canvas.Top="184" Width="44" Height="15"
                       Text="CF" FontFamily="Arial" FontSize="9" FontWeight="SemiBold"
                       Foreground="#585450" TextAlignment="Center"
                       Panel.ZIndex="6"/>

            <!-- 18. SEL按钮 -->
            <Rectangle Canvas.Left="170" Canvas.Top="183" 
                       Width="44" Height="15" RadiusX="5" RadiusY="5"
                       Stroke="#8A8480" StrokeThickness="0.35" Panel.ZIndex="5">
                <Rectangle.Fill>
                    <SolidColorBrush Color="#AAA49C" Opacity="0.35"/>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock Canvas.Left="170" Canvas.Top="184" Width="44" Height="15"
                       Text="SEL" FontFamily="Arial" FontSize="9" FontWeight="SemiBold"
                       Foreground="#585450" TextAlignment="Center"
                       Panel.ZIndex="6"/>

            <!-- 19. ENT按钮 -->
            <Rectangle Canvas.Left="222" Canvas.Top="183" 
                       Width="44" Height="15" RadiusX="5" RadiusY="5"
                       Stroke="#8A8480" StrokeThickness="0.35" Panel.ZIndex="5">
                <Rectangle.Fill>
                    <SolidColorBrush Color="#AAA49C" Opacity="0.35"/>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock Canvas.Left="222" Canvas.Top="184" Width="44" Height="15"
                       Text="ENT" FontFamily="Arial" FontSize="9" FontWeight="SemiBold"
                       Foreground="#585450" TextAlignment="Center"
                       Panel.ZIndex="6"/>

            <!-- ============================================================ -->
            <!-- 20. 电源按钮                                                  -->
            <!-- SVG: circle fill=#3A6A40 @0.15 stroke=#3A6A40 0.5px op=0.6  -->
            <!-- ============================================================ -->
            <Ellipse Canvas.Left="62" Canvas.Top="178" 
                     Width="16" Height="16"
                     Stroke="#3A6A40" StrokeThickness="0.5" Opacity="0.6" Panel.ZIndex="5">
                <Ellipse.Fill>
                    <SolidColorBrush Color="#3A6A40" Opacity="0.15"/>
                </Ellipse.Fill>
            </Ellipse>
            <!-- 电源图标 -->
            <Path Stroke="#3A6A40" StrokeThickness="0.6" Opacity="0.6" 
                  Canvas.Left="65" Canvas.Top="181" Panel.ZIndex="6">
                <Path.Data>
                    <PathGeometry Figures="M 5,2.5 L 5,7.5 M 2,4 A 3.5,3.5 0 0 0 8,4"/>
                </Path.Data>
            </Path>
            <Button Canvas.Left="60" Canvas.Top="176" Width="20" Height="20" 
                    Background="Transparent" BorderThickness="0" Opacity="0"
                    Panel.ZIndex="99" Cursor="Hand" Click="OnPowerButtonClick"/>

            <!-- ============================================================ -->
            <!-- 品牌标识 — #8A8680 Times italic opacity=0.5                  -->
            <!-- ============================================================ -->
            <TextBlock Canvas.Left="170" Canvas.Top="82"
                       Text="PRECISION SCALE"
                       FontFamily="Times New Roman" FontSize="11" FontStyle="Italic"
                       Foreground="#8A8680" Opacity="0.5"
                       IsHitTestVisible="False" Panel.ZIndex="2"/>

            <!-- ============================================================ -->
            <!-- 加载覆盖层                                                    -->
            <!-- ============================================================ -->
            <Border x:Name="LoadingOverlay" 
                    Canvas.Left="78" Canvas.Top="116" Width="220" Height="51"
                    CornerRadius="6" Background="#85FFFFFF" Visibility="Collapsed" Panel.ZIndex="10">
                <TextBlock Text="-  -  -  -  -" HorizontalAlignment="Center" VerticalAlignment="Center" 
                           FontSize="16" FontWeight="Bold" Foreground="#2A2A2A" FontFamily="Consolas"/>
            </Border>

            <!-- 选择边框 -->
            <Rectangle x:Name="SelectionBorder"
                       Canvas.Left="25" Canvas.Top="0" 
                       Width="400" Height="225" 
                       RadiusX="14" RadiusY="14"
                       Stroke="#2196F3" StrokeThickness="2"
                       StrokeDashArray="5,3"
                       Visibility="Collapsed"
                       Panel.ZIndex="200"
                       IsHitTestVisible="False">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#2196F3" BlurRadius="5" ShadowDepth="0" Opacity="0.3"/>
                </Rectangle.Effect>
            </Rectangle>

        </Canvas>
    </Viewbox>
</UserControl>
