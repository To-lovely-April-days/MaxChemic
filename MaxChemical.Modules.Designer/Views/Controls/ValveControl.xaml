<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.ValveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" 
             d:DesignWidth="200"
             Width="200" Height="200"
             Background="Transparent"
             ClipToBounds="False">

    <UserControl.Resources>
        <!-- ✅ 保持所有资源不变 -->
        <LinearGradientBrush x:Key="BodyGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#B0BCC3" Offset="0"/>
            <GradientStop Color="#C4CFD6" Offset="0.1"/>
            <GradientStop Color="#D8E0E5" Offset="0.2"/>
            <GradientStop Color="#E8EEF1" Offset="0.35"/>
            <GradientStop Color="#F4F7F9" Offset="0.5"/>
            <GradientStop Color="#E8EEF1" Offset="0.65"/>
            <GradientStop Color="#D8E0E5" Offset="0.8"/>
            <GradientStop Color="#C4CFD6" Offset="0.9"/>
            <GradientStop Color="#B0BCC3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HandleGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#C8D3DA" Offset="0"/>
            <GradientStop Color="#D8E0E5" Offset="0.15"/>
            <GradientStop Color="#E8EEF1" Offset="0.35"/>
            <GradientStop Color="#F4F7F9" Offset="0.5"/>
            <GradientStop Color="#E8EEF1" Offset="0.65"/>
            <GradientStop Color="#D8E0E5" Offset="0.85"/>
            <GradientStop Color="#C8D3DA" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#A8B5BC" Offset="0"/>
            <GradientStop Color="#C4CFD6" Offset="0.2"/>
            <GradientStop Color="#DCE4E9" Offset="0.4"/>
            <GradientStop Color="#F4F7F9" Offset="0.5"/>
            <GradientStop Color="#DCE4E9" Offset="0.6"/>
            <GradientStop Color="#C4CFD6" Offset="0.8"/>
            <GradientStop Color="#A8B5BC" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="CenterGradient" GradientOrigin="0.3,0.3">
            <GradientStop Color="#E8EEF1" Offset="0"/>
            <GradientStop Color="#C8D3DA" Offset="0.3"/>
            <GradientStop Color="#A0ADB5" Offset="0.6"/>
            <GradientStop Color="#7A8890" Offset="0.85"/>
            <GradientStop Color="#5A6870" Offset="1"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="OpenBodyGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#7FB89D" Offset="0"/>
            <GradientStop Color="#9AC9B3" Offset="0.1"/>
            <GradientStop Color="#B5D9C8" Offset="0.2"/>
            <GradientStop Color="#CFE8DC" Offset="0.35"/>
            <GradientStop Color="#E5F4ED" Offset="0.5"/>
            <GradientStop Color="#CFE8DC" Offset="0.65"/>
            <GradientStop Color="#B5D9C8" Offset="0.8"/>
            <GradientStop Color="#9AC9B3" Offset="0.9"/>
            <GradientStop Color="#7FB89D" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="OpenCenterGradient" GradientOrigin="0.3,0.3">
            <GradientStop Color="#D4F1E8" Offset="0"/>
            <GradientStop Color="#A3E0CA" Offset="0.3"/>
            <GradientStop Color="#7FD4B8" Offset="0.6"/>
            <GradientStop Color="#5CB89D" Offset="0.85"/>
            <GradientStop Color="#3D9A7F" Offset="1"/>
        </RadialGradientBrush>
    </UserControl.Resources>

    <!-- ✅ 核心修改：整个 Canvas 旋转 90 度 -->
    <Canvas x:Name="ValveCanvas" Background="Transparent" ClipToBounds="False">
        <Canvas.RenderTransform>
            <RotateTransform Angle="90" CenterX="100" CenterY="100"/>
        </Canvas.RenderTransform>

        <!-- ===== 地面阴影 ===== -->
        <Ellipse Canvas.Left="10" Canvas.Top="192"
                 Width="180" Height="6"
                 Opacity="0.15"
                 Panel.ZIndex="0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2A4A68" Offset="0"/>
                    <GradientStop Color="#2A4A68" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="6"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- ===== 左管道主体（原上管道） ===== -->
        <Rectangle Canvas.Left="91.25" Canvas.Top="1.5"
                   Width="17.5" Height="97"
                   RadiusX="5.5" RadiusY="5.5"
                   Fill="{StaticResource PipeGradient}"
                   Panel.ZIndex="1"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" BlurRadius="6" ShadowDepth="3" Opacity="0.2" Direction="135"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="91.25" Canvas.Top="1.5"
                   Width="17.5" Height="97"
                   RadiusX="5.5" RadiusY="5.5"
                   Stroke="#2A4A68"
                   StrokeThickness="1.2"
                   Fill="Transparent"
                   Opacity="0.3"
                   Panel.ZIndex="1"
                   IsHitTestVisible="False"/>

        <Rectangle Canvas.Left="92.5" Canvas.Top="3"
                   Width="5" Height="94"
                   RadiusX="2" RadiusY="2"
                   Opacity="0.4"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F4F7F9" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== 右管道主体（原下管道） ===== -->
        <Rectangle Canvas.Left="91.25" Canvas.Top="101.5"
                   Width="17.5" Height="97"
                   RadiusX="5.5" RadiusY="5.5"
                   Fill="{StaticResource PipeGradient}"
                   Panel.ZIndex="1"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#2A4A68" BlurRadius="6" ShadowDepth="3" Opacity="0.2" Direction="135"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="91.25" Canvas.Top="101.5"
                   Width="17.5" Height="97"
                   RadiusX="5.5" RadiusY="5.5"
                   Stroke="#2A4A68"
                   StrokeThickness="1.2"
                   Fill="Transparent"
                   Opacity="0.3"
                   Panel.ZIndex="1"
                   IsHitTestVisible="False"/>

        <Rectangle Canvas.Left="92.5" Canvas.Top="103"
                   Width="5" Height="94"
                   RadiusX="2" RadiusY="2"
                   Opacity="0.4"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F4F7F9" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== 阀门主体底色 ===== -->
        <Path x:Name="ValveBody"
              Data="M 63.075,186 C 63.075,186 57.506,160.118 54.267,143 C 51.12,126.368 50.5,116.818 50.5,100 C 50.5,83.182 51.12,73.632 54.267,57 C 57.506,39.882 63.075,14 63.075,14 L 136.908,14 C 136.908,14 141.724,39.882 144.963,57 C 148.11,73.632 149.337,83.182 149.483,100 C 149.63,116.807 148.844,126.377 145.716,143 C 142.485,160.177 136.908,186 136.908,186 Z"
              Fill="{Binding BodyColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={StaticResource BodyGradient}}"
              Panel.ZIndex="3"
              IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect Color="#2A4A68" BlurRadius="10" ShadowDepth="5" Opacity="0.25" Direction="315"/>
            </Path.Effect>
        </Path>

        <Path Data="M 63.621,18.62 C 63.902,17.299 64.129,16.236 64.287,15.497 L 135.662,15.497 C 135.799,16.235 135.995,17.284 136.237,18.583 C 136.739,21.277 137.442,25.048 138.247,29.353 C 139.855,37.964 141.869,48.715 143.489,57.276 C 146.624,73.844 147.838,83.302 147.983,100.01 C 148.129,116.724 147.351,126.196 144.242,142.72 C 142.629,151.293 140.43,162.031 138.632,170.632 C 137.734,174.931 136.936,178.694 136.363,181.381 C 136.082,182.7 135.855,183.759 135.697,184.497 L 64.287,184.497 C 64.129,183.758 63.902,182.695 63.621,181.374 C 63.049,178.681 62.252,174.913 61.354,170.61 C 59.557,162.002 57.358,151.263 55.741,142.718 C 52.615,126.197 52,116.743 52,100 C 52,83.257 52.615,73.8 55.741,57.279 C 57.358,48.734 59.557,37.996 61.354,29.387 C 62.252,25.084 63.049,21.316 63.621,18.624 Z"
              Stroke="#2A4A68"
              StrokeThickness="1.5"
              Fill="Transparent"
              Opacity="0.3"
              Panel.ZIndex="4"
              IsHitTestVisible="False"/>

        <Path Opacity="0.35" Panel.ZIndex="5" IsHitTestVisible="False">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="65,20">
                        <LineSegment Point="57,150"/>
                        <LineSegment Point="62,150"/>
                        <LineSegment Point="68,22"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F4F7F9" Offset="0.2"/>
                    <GradientStop Color="#E8EEF1" Offset="0.4"/>
                    <GradientStop Color="#D8E0E5" Offset="0.6"/>
                    <GradientStop Color="#C4CFD6" Offset="0.8"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <Path Opacity="0.15" Panel.ZIndex="5" IsHitTestVisible="False">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="132,22">
                        <LineSegment Point="138,150"/>
                        <LineSegment Point="143,150"/>
                        <LineSegment Point="135,22"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2A4A68" Offset="0"/>
                    <GradientStop Color="#456078" Offset="0.4"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- ===== 旋转手柄组 ===== -->
        <Canvas x:Name="RotatingHandleContainer"
                Canvas.Left="0" Canvas.Top="0"
                Width="200" Height="200"
                Panel.ZIndex="10"
                IsHitTestVisible="False">

            <Canvas.RenderTransform>
                <TransformGroup>
                    <!-- ✅ 手柄初始角度改为 0（水平向右） -->
                    <RotateTransform x:Name="HandleRotation" Angle="0" CenterX="100" CenterY="100"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <Path Data="M 100,80.174 C 100,80.174 121.238,88.05 145.5,88.174 C 159.698,88.2466 173.827,87.1215 184.14,86.0214 C 192.49,85.1306 200,91.6024 200,100 C 200,108.398 192.49,114.869 184.14,113.979 C 173.827,112.879 159.698,111.753 145.5,111.826 C 121.238,111.95 100,119.826 100,119.826 Z"
                  Fill="{StaticResource HandleGradient}">
                <Path.Effect>
                    <DropShadowEffect Color="#2A4A68" BlurRadius="8" ShadowDepth="4" Opacity="0.25" Direction="315"/>
                </Path.Effect>
            </Path>

            <Path Data="M 100.5,80.883 L 100.5,119.117 C 100.59,119.086 100.69,119.051 100.798,119.014 C 101.43,118.797 102.359,118.487 103.548,118.116 C 105.928,117.373 109.352,116.381 113.536,115.386 C 121.901,113.396 133.316,111.388 145.497,111.326 C 159.721,111.253 173.87,112.38 184.193,113.481 C 192.261,114.342 199.5,108.087 199.5,100 C 199.5,91.913 192.261,85.658 184.193,86.519 C 173.87,87.62 159.721,88.747 145.497,88.674 C 133.316,88.612 121.901,86.604 113.536,84.614 C 109.352,83.619 105.928,82.627 103.548,81.884 C 102.359,81.512 101.43,81.203 100.798,80.986 C 100.69,80.949 100.59,80.914 100.5,80.883 Z"
                  Stroke="#2A4A68"
                  StrokeThickness="1.2"
                  Fill="Transparent"
                  Opacity="0.3"/>

            <Path Opacity="0.4">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="105,84">
                            <LineSegment Point="145,86"/>
                            <LineSegment Point="145,90"/>
                            <LineSegment Point="105,88"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#F4F7F9" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <Path Opacity="0.2">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="105,112">
                            <LineSegment Point="145,110"/>
                            <LineSegment Point="145,114"/>
                            <LineSegment Point="105,116"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#2A4A68" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>

        <!-- ===== 中心圆盘外圈 ===== -->
        <Ellipse Canvas.Left="73" Canvas.Top="73"
                 Width="54" Height="54"
                 Fill="#A8B5BC"
                 Panel.ZIndex="15"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect Color="#2A4A68" BlurRadius="5" ShadowDepth="3" Opacity="0.2"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Canvas.Left="73" Canvas.Top="73"
                 Width="54" Height="54"
                 Stroke="#2A4A68"
                 StrokeThickness="1.2"
                 Fill="Transparent"
                 Opacity="0.3"
                 Panel.ZIndex="15"
                 IsHitTestVisible="False"/>

        <Ellipse Canvas.Left="77" Canvas.Top="77"
                 Width="46" Height="46"
                 Fill="#0D000000"
                 Panel.ZIndex="16"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" Opacity="0.25" BlurRadius="8" ShadowDepth="0"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Canvas.Left="77" Canvas.Top="77"
                 Width="46" Height="46"
                 Fill="{Binding CenterColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={StaticResource CenterGradient}}"
                 Panel.ZIndex="17"
                 IsHitTestVisible="False"/>

        <Ellipse Canvas.Left="80" Canvas.Top="80"
                 Width="20" Height="20"
                 Opacity="0.3"
                 Panel.ZIndex="18"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F4F7F9" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Canvas.Left="78" Canvas.Top="78"
                 Width="44" Height="44"
                 Stroke="#2A4A68"
                 StrokeThickness="1.2"
                 Fill="Transparent"
                 Opacity="0.3"
                 Panel.ZIndex="18"
                 IsHitTestVisible="False"/>

        <Canvas Canvas.Left="100" Canvas.Top="100" Panel.ZIndex="19" IsHitTestVisible="False">
            <Path Data="M -2.717,-9.386 C -3.364,-9.386 -3.928,-8.965 -4.123,-8.384 C -8.256,-6.802 -11.191,-2.797 -11.191,1.89 C -11.191,7.965 -6.266,12.89 -0.191,12.89 C 5.884,12.89 10.809,7.965 10.809,1.89 C 10.809,-2.674 7.029,-6.589 3.07,-8.254 C 2.461,-8.51 1.827,-8.033 1.827,-7.372 C 1.827,-6.95 2.095,-6.578 2.482,-6.407 C 5.662,-5 7.88,-1.813 7.88,1.89 C 7.88,6.9 3.819,10.961 -1.191,10.961 C -6.201,10.961 -10.262,6.9 -10.262,1.89 C -10.262,-1.917 -7.917,-5.176 -4.593,-6.522 C -4.191,-6.685 -3.907,-7.063 -3.907,-7.497 C -3.907,-8.144 -3.296,-8.618 -2.717,-9.386 Z"
                  Fill="#2A4A68"
                  Opacity="0.8">
                <Path.Effect>
                    <DropShadowEffect Color="White" BlurRadius="2" ShadowDepth="0" Opacity="0.3"/>
                </Path.Effect>
            </Path>
            <Rectangle Canvas.Left="-0.637" Canvas.Top="-12.363"
                       Width="1.274" Height="10.401"
                       RadiusX="0.637" RadiusY="0.637"
                       Fill="#2A4A68"
                       Opacity="0.8">
                <Rectangle.Effect>
                    <DropShadowEffect Color="White" BlurRadius="2" ShadowDepth="0" Opacity="0.3"/>
                </Rectangle.Effect>
            </Rectangle>
        </Canvas>

        <!-- ===== 统一的交互覆盖层 ===== -->
        <Border x:Name="InteractionOverlay"
                Canvas.Left="0" Canvas.Top="0"
                Width="200" Height="200"
                Background="Transparent"
                Panel.ZIndex="50"
                Cursor="SizeAll"
                MouseLeftButtonDown="OnOverlayMouseDown"
                MouseLeftButtonUp="OnOverlayMouseUp"
                MouseMove="OnOverlayMouseMove"
                MouseLeave="OnOverlayMouseLeave"/>

        <!-- ===== 选中边框 ===== -->
        <Rectangle x:Name="SelectionBorder" 
                   Canvas.Left="-2" Canvas.Top="-2"
                   Width="204" Height="204"
                   Stroke="#FF9500" 
                   StrokeThickness="2.5" 
                   StrokeDashArray="4,2" 
                   Fill="Transparent" 
                   RadiusX="3" RadiusY="3" 
                   Visibility="Collapsed"
                   Panel.ZIndex="110"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#FF9500" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 旋转锚点 -->
        <Ellipse x:Name="RotateAnchor"
                 Canvas.Left="84"
                 Canvas.Top="-50"
                 Width="32" Height="32"
                 Fill="#9B59B6"
                 Stroke="White"
                 StrokeThickness="3"
                 Opacity="0"
                 Cursor="Hand"
                 Panel.ZIndex="200">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" 
                                  BlurRadius="12" 
                                  ShadowDepth="5" 
                                  Opacity="0.6"/>
            </Ellipse.Effect>
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转阀门 (按住Shift=15°步进)" 
                         FontSize="16" 
                         FontWeight="Bold"
                         Background="#E8EEF1"
                         Foreground="#2A4A68"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Line x:Name="RotateAnchorLine"
              X1="100" Y1="0"
              X2="100" Y2="-42"
              Stroke="#9B59B6"
              StrokeThickness="3"
              StrokeDashArray="4,3"
              Opacity="0"
              Panel.ZIndex="199"
              IsHitTestVisible="False"/>

        <Border x:Name="RotationLabel"
                Canvas.Left="55"
                Canvas.Top="-85"
                Background="#E62A4A68"
                CornerRadius="8"
                Padding="20,12"
                Visibility="Collapsed"
                Panel.ZIndex="201"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" 
                                  BlurRadius="15" 
                                  ShadowDepth="5" 
                                  Opacity="0.7"/>
            </Border.Effect>
            <TextBlock x:Name="RotationText"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       Text="0°"
                       FontFamily="Segoe UI, Arial">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" 
                                      BlurRadius="3" 
                                      ShadowDepth="1" 
                                      Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

    </Canvas>
</UserControl>