<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.ValveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" 
             d:DesignWidth="200"
             Width="200" Height="200"
             Background="Transparent"
             ClipToBounds="False">

    <UserControl.Resources>
        <!-- ================================================================ -->
        <!--  阀门配色方案: 海军蓝(关闭) + 鼠尾草绿(开启)                     -->
        <!--  管道/手柄: 中性深冷灰 (不随状态变化, 作为稳定视觉锚点)          -->
        <!-- ================================================================ -->

        <!-- ===== 管道渐变 (深冷灰金属磨砂, 统一不变色) ===== -->
        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#5A6878" Offset="0"/>
            <GradientStop Color="#7A8898" Offset="0.2"/>
            <GradientStop Color="#A0AEBE" Offset="0.5"/>
            <GradientStop Color="#7A8898" Offset="0.8"/>
            <GradientStop Color="#5A6878" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== 关闭状态 - 海军蓝 ===== -->
        <LinearGradientBrush x:Key="BodyGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#3A4A62" Offset="0"/>
            <GradientStop Color="#52627E" Offset="0.15"/>
            <GradientStop Color="#60708C" Offset="0.35"/>
            <GradientStop Color="#6E809E" Offset="0.5"/>
            <GradientStop Color="#60708C" Offset="0.65"/>
            <GradientStop Color="#52627E" Offset="0.85"/>
            <GradientStop Color="#3A4A62" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="CenterGradient" GradientOrigin="0.35,0.35">
            <GradientStop Color="#6E809E" Offset="0"/>
            <GradientStop Color="#52627E" Offset="0.4"/>
            <GradientStop Color="#344458" Offset="0.7"/>
            <GradientStop Color="#14202E" Offset="1"/>
        </RadialGradientBrush>

        <!-- ===== 开启状态 - 鼠尾草绿 ===== -->
        <LinearGradientBrush x:Key="OpenBodyGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#8A9C7E" Offset="0"/>
            <GradientStop Color="#A6BC96" Offset="0.15"/>
            <GradientStop Color="#B8CCA6" Offset="0.35"/>
            <GradientStop Color="#C6DCB6" Offset="0.5"/>
            <GradientStop Color="#B8CCA6" Offset="0.65"/>
            <GradientStop Color="#A6BC96" Offset="0.85"/>
            <GradientStop Color="#8A9C7E" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="OpenCenterGradient" GradientOrigin="0.35,0.35">
            <GradientStop Color="#C6DCB6" Offset="0"/>
            <GradientStop Color="#A6BC96" Offset="0.4"/>
            <GradientStop Color="#6E8262" Offset="0.7"/>
            <GradientStop Color="#2E3E28" Offset="1"/>
        </RadialGradientBrush>

        <!-- ===== 手柄渐变 (深冷灰金属, 统一不变色) ===== -->
        <LinearGradientBrush x:Key="HandleGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1E2838" Offset="0"/>
            <GradientStop Color="#344458" Offset="0.15"/>
            <GradientStop Color="#4A5E74" Offset="0.35"/>
            <GradientStop Color="#5A6E86" Offset="0.5"/>
            <GradientStop Color="#4A5E74" Offset="0.65"/>
            <GradientStop Color="#344458" Offset="0.85"/>
            <GradientStop Color="#14202E" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <!--  整个 Canvas 旋转 90 度 (保持原有行为) -->
    <Canvas x:Name="ValveCanvas" Background="Transparent" ClipToBounds="False">
        <Canvas.RenderTransform>
            <RotateTransform Angle="90" CenterX="100" CenterY="100"/>
        </Canvas.RenderTransform>

        <!-- ===== 地面阴影 ===== -->
        <Ellipse Canvas.Left="10" Canvas.Top="192"
                 Width="180" Height="6"
                 Opacity="0.18"
                 Panel.ZIndex="0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#0A1018" Offset="0"/>
                    <GradientStop Color="#0A1018" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="6"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- ===== 左管道主体 ===== -->
        <Rectangle Canvas.Left="91" Canvas.Top="2"
                   Width="18" Height="96"
                   RadiusX="4" RadiusY="4"
                   Fill="{StaticResource PipeGradient}"
                   Panel.ZIndex="1"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#0A1018" BlurRadius="5" ShadowDepth="2" Opacity="0.28" Direction="135"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 左管道高光条 -->
        <Rectangle Canvas.Left="93" Canvas.Top="4"
                   Width="3.5" Height="92"
                   RadiusX="1.5" RadiusY="1.5"
                   Fill="White"
                   Opacity="0.28"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <!-- 左管道右暗边 -->
        <Rectangle Canvas.Left="107" Canvas.Top="4"
                   Width="0.5" Height="92"
                   Fill="#14202E"
                   Opacity="0.4"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <!-- 左管道描边 -->
        <Rectangle Canvas.Left="91" Canvas.Top="2"
                   Width="18" Height="96"
                   RadiusX="4" RadiusY="4"
                   Stroke="#3A4858"
                   StrokeThickness="0.5"
                   Fill="Transparent"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <!-- ===== 右管道主体 ===== -->
        <Rectangle Canvas.Left="91" Canvas.Top="102"
                   Width="18" Height="96"
                   RadiusX="4" RadiusY="4"
                   Fill="{StaticResource PipeGradient}"
                   Panel.ZIndex="1"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#0A1018" BlurRadius="5" ShadowDepth="2" Opacity="0.28" Direction="135"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="93" Canvas.Top="104"
                   Width="3.5" Height="92"
                   RadiusX="1.5" RadiusY="1.5"
                   Fill="White"
                   Opacity="0.28"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <Rectangle Canvas.Left="107" Canvas.Top="104"
                   Width="0.5" Height="92"
                   Fill="#14202E"
                   Opacity="0.4"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <Rectangle Canvas.Left="91" Canvas.Top="102"
                   Width="18" Height="96"
                   RadiusX="4" RadiusY="4"
                   Stroke="#3A4858"
                   StrokeThickness="0.5"
                   Fill="Transparent"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <!-- ===== 阀门主体底色 ===== -->
        <Path x:Name="ValveBody"
              Data="M 63.075,186 C 63.075,186 57.506,160.118 54.267,143 C 51.12,126.368 50.5,116.818 50.5,100 C 50.5,83.182 51.12,73.632 54.267,57 C 57.506,39.882 63.075,14 63.075,14 L 136.908,14 C 136.908,14 141.724,39.882 144.963,57 C 148.11,73.632 149.337,83.182 149.483,100 C 149.63,116.807 148.844,126.377 145.716,143 C 142.485,160.177 136.908,186 136.908,186 Z"
              Fill="{Binding BodyColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={StaticResource BodyGradient}}"
              Stroke="#1E2838"
              StrokeThickness="0.6"
              Panel.ZIndex="3"
              IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect Color="#0A1018" BlurRadius="8" ShadowDepth="3" Opacity="0.28" Direction="315"/>
            </Path.Effect>
        </Path>

        <!-- 阀体左侧高光带 -->
        <Path Data="M 63.075,186 C 57.506,160.118 54.267,143 54.267,143 C 51.12,126.368 50.5,116.818 50.5,100 C 50.5,83.182 51.12,73.632 54.267,57 C 57.506,39.882 63.075,14 63.075,14 L 67.075,14 C 67.075,14 62,40 59,57 C 56,73.8 55.3,83.3 55.3,100 C 55.3,116.9 56,126.4 59,143 C 62,160 67.075,186 67.075,186 Z"
              Fill="White"
              Opacity="0.2"
              Panel.ZIndex="4"
              IsHitTestVisible="False"/>

        <!-- 阀体右侧暗边 -->
        <Path Data="M 136.908,14 C 136.908,14 141.724,39.882 144.963,57 C 148.11,73.632 149.337,83.182 149.483,100 C 149.63,116.807 148.844,126.377 145.716,143 C 142.485,160.177 136.908,186 136.908,186 L 132.908,186 C 132.908,186 138,160 141,143 C 144,126.4 144.7,116.9 144.5,100 C 144.3,83.3 144,73.8 141,57 C 138,40 132.908,14 132.908,14 Z"
              Fill="#0A1220"
              Opacity="0.32"
              Panel.ZIndex="4"
              IsHitTestVisible="False"/>

        <!-- 阀体细描边 -->
        <Path Data="M 63.075,186 C 63.075,186 57.506,160.118 54.267,143 C 51.12,126.368 50.5,116.818 50.5,100 C 50.5,83.182 51.12,73.632 54.267,57 C 57.506,39.882 63.075,14 63.075,14 L 136.908,14 C 136.908,14 141.724,39.882 144.963,57 C 148.11,73.632 149.337,83.182 149.483,100 C 149.63,116.807 148.844,126.377 145.716,143 C 142.485,160.177 136.908,186 136.908,186 Z"
              Stroke="#0A1018"
              StrokeThickness="0.4"
              Fill="Transparent"
              Opacity="0.5"
              Panel.ZIndex="5"
              IsHitTestVisible="False"/>

        <!-- ===== 旋转手柄组 ===== -->
        <Canvas x:Name="RotatingHandleContainer"
                Canvas.Left="0" Canvas.Top="0"
                Width="200" Height="200"
                Panel.ZIndex="10"
                IsHitTestVisible="False">

            <Canvas.RenderTransform>
                <TransformGroup>
                    <!-- 手柄初始角度 0 (水平向右 = 关闭) -->
                    <RotateTransform x:Name="HandleRotation" Angle="0" CenterX="100" CenterY="100"/>
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- 手柄主体 (深冷灰胶囊) -->
            <Path Data="M 100,80.174 C 100,80.174 121.238,88.05 145.5,88.174 C 159.698,88.2466 173.827,87.1215 184.14,86.0214 C 192.49,85.1306 200,91.6024 200,100 C 200,108.398 192.49,114.869 184.14,113.979 C 173.827,112.879 159.698,111.753 145.5,111.826 C 121.238,111.95 100,119.826 100,119.826 Z"
                  Fill="{StaticResource HandleGradient}"
                  Stroke="#0A101A"
                  StrokeThickness="0.6">
                <Path.Effect>
                    <DropShadowEffect Color="#0A1018" BlurRadius="6" ShadowDepth="3" Opacity="0.3" Direction="315"/>
                </Path.Effect>
            </Path>

            <!-- 手柄顶部高光条 -->
            <Path Opacity="0.35">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="105,84">
                            <LineSegment Point="145,86"/>
                            <LineSegment Point="145,90"/>
                            <LineSegment Point="105,88"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#D8E0E5" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>

            <!-- 手柄底部暗边 -->
            <Path Opacity="0.45">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="105,112">
                            <LineSegment Point="145,110"/>
                            <LineSegment Point="145,114"/>
                            <LineSegment Point="105,116"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#000000" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>

        <!-- ===== 中心圆盘外圈 ===== -->
        <Ellipse Canvas.Left="73" Canvas.Top="73"
                 Width="54" Height="54"
                 Fill="#2A3A50"
                 Panel.ZIndex="15"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect Color="#0A1018" BlurRadius="5" ShadowDepth="2" Opacity="0.3"/>
            </Ellipse.Effect>
        </Ellipse>

        <Ellipse Canvas.Left="73" Canvas.Top="73"
                 Width="54" Height="54"
                 Stroke="#0A101A"
                 StrokeThickness="0.5"
                 Fill="Transparent"
                 Panel.ZIndex="15"
                 IsHitTestVisible="False"/>

        <!-- ===== 中心圆盘内阴影 ===== -->
        <Ellipse Canvas.Left="77" Canvas.Top="77"
                 Width="46" Height="46"
                 Fill="#0D000000"
                 Panel.ZIndex="16"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="6" ShadowDepth="0"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- ===== 中心圆盘主体 ===== -->
        <Ellipse Canvas.Left="77" Canvas.Top="77"
                 Width="46" Height="46"
                 Fill="{Binding CenterColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={StaticResource CenterGradient}}"
                 Panel.ZIndex="17"
                 IsHitTestVisible="False"/>

        <!-- ===== 中心圆盘高光 ===== -->
        <Ellipse Canvas.Left="82" Canvas.Top="82"
                 Width="14" Height="10"
                 Fill="White"
                 Opacity="0.35"
                 Panel.ZIndex="18"
                 IsHitTestVisible="False"/>

        <!-- ===== 中心圆盘细描边 ===== -->
        <Ellipse Canvas.Left="78" Canvas.Top="78"
                 Width="44" Height="44"
                 Stroke="#000000"
                 StrokeThickness="0.4"
                 Fill="Transparent"
                 Opacity="0.5"
                 Panel.ZIndex="18"
                 IsHitTestVisible="False"/>

        <!-- ===== 指示器 ===== -->
        <!--  注意: 指示器颜色随状态切换, 由 C# 代码或后续绑定控制会更精细     -->
        <!--  当前使用亮白 (在深海军蓝上对比强, 在浅鼠尾草绿上仍可辨)         -->
        <Canvas Canvas.Left="100" Canvas.Top="100" Panel.ZIndex="19" IsHitTestVisible="False">
            <Path Data="M -2.717,-9.386 C -3.364,-9.386 -3.928,-8.965 -4.123,-8.384 C -8.256,-6.802 -11.191,-2.797 -11.191,1.89 C -11.191,7.965 -6.266,12.89 -0.191,12.89 C 5.884,12.89 10.809,7.965 10.809,1.89 C 10.809,-2.674 7.029,-6.589 3.07,-8.254 C 2.461,-8.51 1.827,-8.033 1.827,-7.372 C 1.827,-6.95 2.095,-6.578 2.482,-6.407 C 5.662,-5 7.88,-1.813 7.88,1.89 C 7.88,6.9 3.819,10.961 -1.191,10.961 C -6.201,10.961 -10.262,6.9 -10.262,1.89 C -10.262,-1.917 -7.917,-5.176 -4.593,-6.522 C -4.191,-6.685 -3.907,-7.063 -3.907,-7.497 C -3.907,-8.144 -3.296,-8.618 -2.717,-9.386 Z"
                  Fill="#E8F0FA"
                  Opacity="0.95">
                <Path.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
                </Path.Effect>
            </Path>
            <Rectangle Canvas.Left="-0.637" Canvas.Top="-12.363"
                       Width="1.274" Height="10.401"
                       RadiusX="0.637" RadiusY="0.637"
                       Fill="#E8F0FA"
                       Opacity="0.95">
                <Rectangle.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Opacity="0.5"/>
                </Rectangle.Effect>
            </Rectangle>
        </Canvas>

        <!-- ===== 统一的交互覆盖层 ===== -->
        <Border x:Name="InteractionOverlay"
                Canvas.Left="0" Canvas.Top="0"
                Width="200" Height="200"
                Background="Transparent"
                Panel.ZIndex="50"
                Cursor="SizeAll"
                MouseLeftButtonDown="OnOverlayMouseDown"
                MouseLeftButtonUp="OnOverlayMouseUp"
                MouseMove="OnOverlayMouseMove"
                MouseLeave="OnOverlayMouseLeave"
                IsHitTestVisible="True"/>

        <!-- ===== 选中边框 ===== -->
        <Rectangle x:Name="SelectionBorder" 
                   Canvas.Left="-2" Canvas.Top="-2"
                   Width="204" Height="204"
                   Stroke="#FF9500" 
                   StrokeThickness="2.5" 
                   StrokeDashArray="4,2" 
                   Fill="Transparent" 
                   RadiusX="3" RadiusY="3" 
                   Visibility="Collapsed"
                   Panel.ZIndex="110"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#FF9500" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 旋转锚点 -->
        <Ellipse x:Name="RotateAnchor"
                 Canvas.Left="84"
                 Canvas.Top="-50"
                 Width="32" Height="32"
                 Fill="#9B59B6"
                 Stroke="White"
                 StrokeThickness="3"
                 Opacity="0"
                 Cursor="Hand"
                 Panel.ZIndex="200">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" 
                                  BlurRadius="12" 
                                  ShadowDepth="5" 
                                  Opacity="0.6"/>
            </Ellipse.Effect>
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转阀门 (按住Shift=15°步进)" 
                         FontSize="16" 
                         FontWeight="Bold"
                         Background="#E8EEF1"
                         Foreground="#2A4A68"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Line x:Name="RotateAnchorLine"
              X1="100" Y1="0"
              X2="100" Y2="-42"
              Stroke="#9B59B6"
              StrokeThickness="3"
              StrokeDashArray="4,3"
              Opacity="0"
              Panel.ZIndex="199"
              IsHitTestVisible="False"/>

        <Border x:Name="RotationLabel"
                Canvas.Left="55"
                Canvas.Top="-85"
                Background="#E62A4A68"
                CornerRadius="8"
                Padding="20,12"
                Visibility="Collapsed"
                Panel.ZIndex="201"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="Black" 
                                  BlurRadius="15" 
                                  ShadowDepth="5" 
                                  Opacity="0.7"/>
            </Border.Effect>
            <TextBlock x:Name="RotationText"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"
                       Text="0°"
                       FontFamily="Segoe UI, Arial">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" 
                                      BlurRadius="3" 
                                      ShadowDepth="1" 
                                      Opacity="0.9"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

    </Canvas>
</UserControl>
