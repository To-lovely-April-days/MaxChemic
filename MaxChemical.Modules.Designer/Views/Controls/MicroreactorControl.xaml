        <!-- 管道渐变 -->
        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8A9BA8" Offset="0"/>
            <GradientStop Color="#A8B8C4" Offset="0.2"/>
            <GradientStop Color="#C8D4DD" Offset="0.4"/>
            <GradientStop Color="#E8EEF2" Offset="0.5"/>
            <GradientStop Color="#C8D4DD" Offset="0.6"/>
            <GradientStop Color="#A8B8C4" Offset="0.8"/>
            <GradientStop Color="#8A9BA8" Offset="1"/>
        </LinearGradientBrush>

        <!-- 底座金属渐变 -->
        <LinearGradientBrush x:Key="BaseBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#9AACB8" Offset="0"/>
            <GradientStop Color="#B8C5CF" Offset="0.3"/>
            <GradientStop Color="#D4DFE7" Offset="0.5"/>
            <GradientStop Color="#B8C5CF" Offset="0.7"/>
            <GradientStop Color="#9AACB8" Offset="1"/>
        </LinearGradientBrush>

        <!-- 底座支柱渐变 -->
        <LinearGradientBrush x:Key="PillarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7A8B98" Offset="0"/>
            <GradientStop Color="#9AACB8" Offset="0.3"/>
            <GradientStop Color="#B8C5CF" Offset="0.5"/>
            <GradientStop Color="#9AACB8" Offset="0.7"/>
            <GradientStop Color="#7A8B98" Offset="1"/>
        </LinearGradientBrush>

        <!-- 液体渐变画刷 -->
        <LinearGradientBrush x:Key="FluidBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A05DADE2" Offset="0"/>
            <GradientStop Color="#D085C1F0" Offset="0.3"/>
            <GradientStop Color="#F0AED6F1" Offset="0.5"/>
            <GradientStop Color="#D085C1F0" Offset="0.7"/>
            <GradientStop Color="#A05DADE2" Offset="1"/>
        </LinearGradientBrush>

    </UserControl.Resources>

