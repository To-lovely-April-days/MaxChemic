            <GradientStop Color="#E8ECEF" Offset="0"/>
            <GradientStop Color="#F5F7F9" Offset="0.15"/>
            <GradientStop Color="#FFFFFF" Offset="0.35"/>
            <GradientStop Color="#F5F7F9" Offset="0.65"/>
            <GradientStop Color="#E8ECEF" Offset="0.85"/>
            <GradientStop Color="#D4DCE1" Offset="1"/>
