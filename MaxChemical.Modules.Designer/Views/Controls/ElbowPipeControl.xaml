<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.ElbowPipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="100" 
             d:DesignWidth="100"
             Width="80" Height="80"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <Canvas x:Name="PipeCanvas" ClipToBounds="False">

        <!-- ═══════════════ 左侧法兰组 ═══════════════ -->
        <Canvas x:Name="LeftFlangeGroup" 
                Canvas.Left="0.35" 
                Canvas.Top="32"
                Width="2.54" 
                Height="24"
                RenderOptions.CachingHint="Cache">
            <Rectangle x:Name="LeftFlangeBase"
                       Width="2.54" Height="24"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeGradient"
                       Width="2.54" Height="24"
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="LeftFlangeBorder"
                       Width="2.54" Height="24"
                       StrokeThickness="0.7"
                       Fill="Transparent"
                       RadiusX="1.27" RadiusY="1.27"/>
        </Canvas>

        <!-- ═══════════════ 水平段 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Rectangle x:Name="HorizontalPipeBackground"
                   Canvas.Left="3.2" Canvas.Top="34"
                   Width="34" Height="20"
                   Fill="White"
                   RenderOptions.CachingHint="Cache"/>
        <Rectangle x:Name="HorizontalFluidBackground"
                   Canvas.Left="3.2" Canvas.Top="34"
                   Width="34" Height="20"
                   Visibility="Collapsed"
                   RenderOptions.CachingHint="Cache"/>
        <Rectangle x:Name="HorizontalFluidPattern"
                   Canvas.Left="3.2" Canvas.Top="34"
                   Width="34" Height="20"
                   Visibility="Collapsed"
                   RenderOptions.CachingHint="Cache"/>
        <Rectangle x:Name="HorizontalPipe" 
                   Canvas.Left="3.2" Canvas.Top="34"
                   Width="34" Height="20"
                   RenderOptions.CachingHint="Cache"/>

        <Line x:Name="HorizontalTopEdge" 
              X1="3.58" Y1="34.32" X2="37.18" Y2="34.32"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              RenderOptions.EdgeMode="Aliased"/>
        <Line x:Name="HorizontalBottomEdge" 
              X1="3.58" Y1="53.68" X2="37.18" Y2="53.68"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              RenderOptions.EdgeMode="Aliased"/>

        <!-- ═══════════════ 弯头段 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Path x:Name="ElbowPipeBackground" Fill="White"/>
        <Path x:Name="ElbowFluidBackground" Visibility="Collapsed"/>
        <Path x:Name="ElbowPath" StrokeThickness="0.7"/>
        <Path x:Name="ElbowOuterEdge" Opacity="0.25" RenderOptions.EdgeMode="Aliased">
            <Path.StrokeThickness>1.8</Path.StrokeThickness>
        </Path>
        <Path x:Name="ElbowHighlight" Opacity="0.25" RenderOptions.EdgeMode="Aliased">
            <Path.StrokeThickness>1.5</Path.StrokeThickness>
        </Path>

        <!-- ═══════════════ 垂直段 — 白底 + 流体 + 渐变 ═══════════════ -->
        <Rectangle x:Name="VerticalPipeBackground"
                   Canvas.Left="50" Canvas.Top="3.2"
                   Width="20" Height="28"
                   Fill="White"
                   RenderOptions.CachingHint="Cache"/>
        <Rectangle x:Name="VerticalFluidBackground"
                   Canvas.Left="50" Canvas.Top="3.2"
                   Width="20" Height="28"
                   Visibility="Collapsed"
                   RenderOptions.CachingHint="Cache"/>
        <Rectangle x:Name="VerticalFluidPattern"
                   Canvas.Left="50" Canvas.Top="3.2"
                   Width="20" Height="28"
                   Visibility="Collapsed"
                   RenderOptions.CachingHint="Cache"/>
        <Rectangle x:Name="VerticalPipe" 
                   Canvas.Left="50" Canvas.Top="3.2"
                   Width="20" Height="28"
                   RenderOptions.CachingHint="Cache"/>

        <Line x:Name="VerticalLeftEdge" 
              X1="50.32" Y1="3.58" X2="50.32" Y2="31.18"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              RenderOptions.EdgeMode="Aliased"/>
        <Line x:Name="VerticalRightEdge" 
              X1="69.68" Y1="3.58" X2="69.68" Y2="31.18"
              Stroke="#000000" StrokeThickness="0.7" Opacity="0.12"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              RenderOptions.EdgeMode="Aliased"/>

        <!-- ═══════════════════════════════════════════════════════════
             ★ 赛博流光层 — 默认隐藏，UseDefaultStyle=true 时显示
             ═══════════════════════════════════════════════════════════ -->

        <!-- 金属管壁层（覆盖整个 L 形：水平 + 弯头 + 垂直） -->
        <Rectangle x:Name="CyberHorizontalMetal"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
        <Path x:Name="CyberElbowMetal"
              Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="CyberVerticalMetal"
                   Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- 内部暗腔 -->
        <Rectangle x:Name="CyberHorizontalDark"
                   Fill="#000814" Opacity="0.85"
                   Visibility="Collapsed" IsHitTestVisible="False"/>
        <Path x:Name="CyberElbowDark"
              Fill="#000814" Opacity="0.85"
              Visibility="Collapsed" IsHitTestVisible="False"/>
        <Rectangle x:Name="CyberVerticalDark"
                   Fill="#000814" Opacity="0.85"
                   Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- ★ L 形中心线流光（一条 path 横跨水平→弯头→垂直，流光自然转弯） -->
        <Path x:Name="CyberMainStream"
              Visibility="Collapsed" IsHitTestVisible="False"
              StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
            <Path.Effect>
                <BlurEffect Radius="3" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <Path x:Name="CyberParticleStream"
              Visibility="Collapsed" IsHitTestVisible="False"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect>
                <BlurEffect Radius="2" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <Path x:Name="CyberSparkStream"
              Visibility="Collapsed" IsHitTestVisible="False"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Stroke="#FFFFFF">
            <Path.Effect>
                <BlurEffect Radius="1.5" KernelType="Gaussian" RenderingBias="Performance"/>
            </Path.Effect>
        </Path>

        <!-- ═══════════════ 顶部法兰组 ═══════════════ -->
        <Canvas x:Name="TopFlangeGroup" 
                Canvas.Left="48" Canvas.Top="0.35"
                Width="24" Height="2.54"
                RenderOptions.CachingHint="Cache">
            <Rectangle x:Name="TopFlangeBase" 
                       Width="24" Height="2.54" 
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="TopFlangeGradient" 
                       Width="24" Height="2.54" 
                       Opacity="0.6"
                       RadiusX="1.27" RadiusY="1.27"/>
            <Rectangle x:Name="TopFlangeBorder" 
                       Width="24" Height="2.54" 
                       StrokeThickness="0.7" 
                       RadiusX="1.27" RadiusY="1.27" 
                       Fill="Transparent"/>
        </Canvas>

        <!-- ═══════════════ 连接处 ═══════════════ -->
        <Rectangle x:Name="LeftConnection" 
                   Canvas.Left="2.89" Canvas.Top="34"
                   Width="1" Height="20"
                   Opacity="0.6"/>
        <Rectangle x:Name="TopConnection" 
                   Canvas.Left="50" Canvas.Top="2.89"
                   Width="20" Height="1"
                   Opacity="0.6"/>

        <!-- ═══════════════ 锚点 ═══════════════ -->
        <Ellipse x:Name="LeftAnchor" Canvas.Left="-6" Canvas.Top="38" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整水平长度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="TopAnchor" Canvas.Left="54" Canvas.Top="-6" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整垂直长度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="HorizontalWidthAnchor" Canvas.Left="19" Canvas.Top="68" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeNS">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>
        <Ellipse x:Name="VerticalWidthAnchor" Canvas.Left="74" Canvas.Top="15" Width="12" Height="12" Fill="Orange" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="SizeWE">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- ═══════════════ 选中高亮边框 ═══════════════ -->
        <Rectangle x:Name="SelectionBorder" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
        <Rectangle x:Name="SelectionBorderV" Width="0" Height="0"
                   Stroke="#378ADD" StrokeThickness="1.25" Fill="Transparent"
                   RadiusX="2" RadiusY="2"
                   IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- ═══════════════ 旋转锚点 ═══════════════ -->
        <Ellipse x:Name="RotateAnchor" Canvas.Left="34" Canvas.Top="-30" Width="12" Height="12" Fill="#4CAF50" Stroke="White" StrokeThickness="2" Opacity="0" Cursor="Hand"/>
        <Line x:Name="RotateAnchorLine" X1="40" Y1="0" X2="40" Y2="-24" Stroke="Orange" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0" RenderOptions.EdgeMode="Aliased"/>
        <Border x:Name="RotationLabel" Canvas.Left="20" Canvas.Top="-50" Background="#CC000000" CornerRadius="3" Padding="5,2" Visibility="Collapsed">
            <TextBlock x:Name="RotationText" Foreground="White" FontSize="11" Text="0°"/>
        </Border>
    </Canvas>
</UserControl>
