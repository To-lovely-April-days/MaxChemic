<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.ElbowPipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="100" 
             d:DesignWidth="100"
             Width="80" Height="80"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False">

    <Canvas x:Name="PipeCanvas" Background="Transparent" ClipToBounds="False">

        <!-- ✅ 左侧法兰组 (水平段) - 宽度改为4 -->
        <Canvas x:Name="LeftFlangeGroup" 
        Canvas.Left="2" 
        Canvas.Top="32"
        Width="4" 
        Height="24">
            <Rectangle x:Name="LeftFlangeBase"
               Width="4"
               Height="24"
               Fill="#D0D0D0"
               RadiusX="0.8" 
               RadiusY="0.8"/>

            <Rectangle x:Name="LeftFlangeGradient"
               Width="4"
               Height="24"
               RadiusX="0.8" 
               RadiusY="0.8">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E8E8E8" Offset="0"/>
                        <GradientStop Color="#F5F5F5" Offset="0.5"/>
                        <GradientStop Color="#D8D8D8" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle x:Name="LeftFlangeBorder"
               Width="4"
               Height="24"
               Stroke="#334C68" 
               StrokeThickness="0.8"
               RadiusX="0.8" 
               RadiusY="0.8" 
               Fill="Transparent"/>

            <!-- ✅ 螺栓位置调整 -->
            <Ellipse x:Name="LeftBolt1" Width="2" Height="2" Fill="#4A4A4A" Canvas.Left="1" Canvas.Top="3">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="1" ShadowDepth="0.5" Opacity="0.3"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="LeftBolt2" Width="2" Height="2" Fill="#4A4A4A" Canvas.Left="1" Canvas.Top="11">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="1" ShadowDepth="0.5" Opacity="0.3"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="LeftBolt3" Width="2" Height="2" Fill="#4A4A4A" Canvas.Left="1" Canvas.Top="19">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="1" ShadowDepth="0.5" Opacity="0.3"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- 水平管道段 -->
        <Rectangle x:Name="HorizontalPipe" 
                   Canvas.Left="6" 
                   Canvas.Top="34"
                   Width="34"
                   Height="20"
                   RadiusX="1.5" 
                   RadiusY="1.5">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#D5E5F2" Offset="0"/>
                    <GradientStop Color="#C5D9E8" Offset="0.1"/>
                    <GradientStop Color="#B0CAE2" Offset="0.3"/>
                    <GradientStop Color="#95B5D5" Offset="0.5"/>
                    <GradientStop Color="#B0CAE2" Offset="0.7"/>
                    <GradientStop Color="#C5D9E8" Offset="0.9"/>
                    <GradientStop Color="#D5E5F2" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 水平管道边缘线 -->
        <Line x:Name="HorizontalTopEdge" 
              X1="6" Y1="34" 
              X2="40" Y2="34"
              Stroke="#2A4A68" 
              StrokeThickness="0.6"/>
        <Line x:Name="HorizontalBottomEdge" 
              X1="6" Y1="54" 
              X2="40" Y2="54"
              Stroke="#2A4A68" 
              StrokeThickness="0.6"/>

        <!-- 水平管道高光 -->
        <Rectangle x:Name="HorizontalHighlight" 
                   Canvas.Left="7"
                   Canvas.Top="35"
                   Width="32"
                   Height="3" 
                   Opacity="0.6" 
                   RadiusX="0.5" 
                   RadiusY="0.5">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#FFFFFF" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 弯头部分 -->
        <Path x:Name="ElbowPath" StrokeThickness="0.6" Stroke="#2A4A68">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="40,54">
                        <ArcSegment Point="60,34" Size="20,20" SweepDirection="Counterclockwise"/>
                        <LineSegment Point="50,34"/>
                        <ArcSegment Point="40,44" Size="10,10" SweepDirection="Clockwise"/>
                        <LineSegment Point="40,54"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D5E5F2" Offset="0"/>
                    <GradientStop Color="#C5D9E8" Offset="0.2"/>
                    <GradientStop Color="#B0CAE2" Offset="0.4"/>
                    <GradientStop Color="#95B5D5" Offset="0.5"/>
                    <GradientStop Color="#B0CAE2" Offset="0.6"/>
                    <GradientStop Color="#C5D9E8" Offset="0.8"/>
                    <GradientStop Color="#D5E5F2" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- 弯头高光 -->
        <Path x:Name="ElbowHighlight" Opacity="0.5">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="42,49">
                        <ArcSegment Point="55,36" Size="15,15" SweepDirection="Counterclockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Fill>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#FFFFFF" Offset="0.3"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Path.Fill>
        </Path>

        <!-- 垂直管道段 -->
        <Rectangle x:Name="VerticalPipe" 
                   Canvas.Left="50"
                   Canvas.Top="6"
                   Width="20"
                   Height="28"
                   RadiusX="1.5" 
                   RadiusY="1.5">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#D5E5F2" Offset="0"/>
                    <GradientStop Color="#C5D9E8" Offset="0.1"/>
                    <GradientStop Color="#B0CAE2" Offset="0.3"/>
                    <GradientStop Color="#95B5D5" Offset="0.5"/>
                    <GradientStop Color="#B0CAE2" Offset="0.7"/>
                    <GradientStop Color="#C5D9E8" Offset="0.9"/>
                    <GradientStop Color="#D5E5F2" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 垂直管道边缘线 -->
        <Line x:Name="VerticalLeftEdge" 
              X1="50" Y1="6" 
              X2="50" Y2="34"
              Stroke="#2A4A68" 
              StrokeThickness="0.6"/>
        <Line x:Name="VerticalRightEdge" 
              X1="70" Y1="6" 
              X2="70" Y2="34"
              Stroke="#2A4A68" 
              StrokeThickness="0.6"/>

        <!-- 垂直管道高光 -->
        <Rectangle x:Name="VerticalHighlight" 
                   Canvas.Left="51"
                   Canvas.Top="7"
                   Width="3"
                   Height="26"
                   Opacity="0.6" 
                   RadiusX="0.5" 
                   RadiusY="0.5">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#FFFFFF" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ✅ 顶部法兰组 - 高度改为4 -->
        <Canvas x:Name="TopFlangeGroup" 
        Canvas.Left="48"
        Canvas.Top="2"
        Width="24"
        Height="4">
            <Rectangle x:Name="TopFlangeBase" 
               Width="24"
               Height="4" 
               Fill="#D0D0D0" 
               RadiusX="0.8" 
               RadiusY="0.8"/>
            <Rectangle x:Name="TopFlangeGradient" 
               Width="24"
               Height="4" 
               RadiusX="0.8" 
               RadiusY="0.8">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E8E8E8" Offset="0"/>
                        <GradientStop Color="#F5F5F5" Offset="0.5"/>
                        <GradientStop Color="#D8D8D8" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="TopFlangeBorder" 
               Width="24"
               Height="4" 
               Stroke="#334C68" 
               StrokeThickness="0.8" 
               RadiusX="0.8" 
               RadiusY="0.8" 
               Fill="Transparent"/>

            <!-- ✅ 螺栓位置调整 -->
            <Ellipse x:Name="TopBolt1" Width="2" Height="2" Fill="#4A4A4A" Canvas.Left="3" Canvas.Top="1">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="1" ShadowDepth="0.5" Opacity="0.3"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="TopBolt2" Width="2" Height="2" Fill="#4A4A4A" Canvas.Left="11" Canvas.Top="1">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="1" ShadowDepth="0.5" Opacity="0.3"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse x:Name="TopBolt3" Width="2" Height="2" Fill="#4A4A4A" Canvas.Left="19" Canvas.Top="1">
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="1" ShadowDepth="0.5" Opacity="0.3"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- 连接处 -->
        <Rectangle x:Name="LeftConnection" 
                   Canvas.Left="5"
                   Canvas.Top="34"
                   Width="2"
                   Height="20"
                   Fill="#8FA9BD" 
                   RadiusX="0.5" 
                   RadiusY="0.5"/>
        <Rectangle x:Name="TopConnection" 
                   Canvas.Left="50"
                   Canvas.Top="5"
                   Width="20"
                   Height="2"
                   Fill="#8FA9BD" 
                   RadiusX="0.5" 
                   RadiusY="0.5"/>

        <!-- 锚点 -->
        <Ellipse x:Name="LeftAnchor" 
                 Canvas.Left="-6"
                 Canvas.Top="38"
                 Width="12" Height="12" 
                 Fill="#FF6B6B" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeWE">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
            </Ellipse.Effect>
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整水平长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="TopAnchor" 
                 Canvas.Left="54"
                 Canvas.Top="-6"
                 Width="12" Height="12" 
                 Fill="#FF6B6B" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeNS">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
            </Ellipse.Effect>
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整垂直长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="HorizontalWidthAnchor" 
                 Canvas.Left="19"
                 Canvas.Top="68"
                 Width="12" Height="12" 
                 Fill="#4ECDC4" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeNS">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
            </Ellipse.Effect>
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="VerticalWidthAnchor" 
                 Canvas.Left="74"
                 Canvas.Top="15"
                 Width="12" Height="12" 
                 Fill="#4ECDC4" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeWE">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
            </Ellipse.Effect>
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- 选中边框 -->
        <Rectangle x:Name="SelectionBorder" 
                   Canvas.Left="-2"
                   Canvas.Top="-2"
                   Width="84"
                   Height="84"
                   Stroke="#FF9500" 
                   StrokeThickness="2" 
                   StrokeDashArray="4,2" 
                   Fill="Transparent" 
                   RadiusX="3" 
                   RadiusY="3" 
                   Visibility="Collapsed"/>

        <!-- 旋转锚点 -->
        <Ellipse x:Name="RotateAnchor" 
                 Canvas.Left="34"
                 Canvas.Top="-30"
                 Width="12" Height="12" 
                 Fill="#9B59B6" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="Hand">
            <Ellipse.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
            </Ellipse.Effect>
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- 旋转辅助线 -->
        <Line x:Name="RotateAnchorLine" 
              X1="40" Y1="0"
              X2="40" Y2="-24"
              Stroke="#9B59B6" 
              StrokeThickness="1" 
              StrokeDashArray="2,2" 
              Opacity="0"/>

        <!-- 旋转角度显示标签 -->
        <Border x:Name="RotationLabel"
                Canvas.Left="20"
                Canvas.Top="-50"
                Background="#CC000000"
                CornerRadius="3"
                Padding="8,3"
                Visibility="Collapsed">
            <TextBlock x:Name="RotationText"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="0°"/>
        </Border>
    </Canvas>

</UserControl>