<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.ElbowPipeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="100" 
             d:DesignWidth="100"
             Width="80" Height="80"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <!-- ✅ 根级别缓存配置 -->
    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <UserControl.Resources>
        <!-- ✅ 优化：简化管道渐变（减少梯度停止点） -->
        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#727171" Offset="0"/>
            <GradientStop Color="#59727171" Offset="0.25"/>
            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
            <GradientStop Color="#59727171" Offset="0.75"/>
            <GradientStop Color="#727171" Offset="1"/>
        </LinearGradientBrush>

        <!-- ✅ 简化法兰渐变 -->
        <LinearGradientBrush x:Key="LeftEndCapGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#D9D9D9" Offset="0"/>
            <GradientStop Color="#A0A0A0" Offset="0.5"/>
            <GradientStop Color="#D9D9D9" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopEndCapGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#D9D9D9" Offset="0"/>
            <GradientStop Color="#A0A0A0" Offset="0.5"/>
            <GradientStop Color="#D9D9D9" Offset="1"/>
        </LinearGradientBrush>

        <!-- ✅ 简化水平管道渐变 -->
        <LinearGradientBrush x:Key="HorizontalPipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#727171" Offset="0"/>
            <GradientStop Color="#59727171" Offset="0.25"/>
            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
            <GradientStop Color="#59727171" Offset="0.75"/>
            <GradientStop Color="#727171" Offset="1"/>
        </LinearGradientBrush>

        <!-- ✅ 简化垂直管道渐变 -->
        <LinearGradientBrush x:Key="VerticalPipeGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#727171" Offset="0"/>
            <GradientStop Color="#59727171" Offset="0.25"/>
            <GradientStop Color="#00FFFFFF" Offset="0.5"/>
            <GradientStop Color="#59727171" Offset="0.75"/>
            <GradientStop Color="#727171" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Canvas x:Name="PipeCanvas" Background="Transparent" ClipToBounds="False">

        <!-- ✅ 静态层：左侧法兰（启用缓存） -->
        <Canvas x:Name="LeftFlangeGroup" 
                Canvas.Left="0.35" 
                Canvas.Top="32"
                Width="2.54" 
                Height="24"
                RenderOptions.CachingHint="Cache">

            <Rectangle x:Name="LeftFlangeBase"
                       Width="2.54"
                       Height="24"
                       Fill="#D9D9D9"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="LeftFlangeGradient"
                       Width="2.54"
                       Height="24"
                       Fill="{StaticResource LeftEndCapGradient}"
                       Opacity="0.6"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="LeftFlangeBorder"
                       Width="2.54"
                       Height="24"
                       Stroke="#727171" 
                       StrokeThickness="0.7"
                       RadiusX="1.27" 
                       RadiusY="1.27" 
                       Fill="Transparent"/>
        </Canvas>

        <!-- ✅ 静态层：水平管道（启用缓存） -->
        <Rectangle x:Name="HorizontalPipe" 
                   Canvas.Left="3.2" 
                   Canvas.Top="34"
                   Width="34"
                   Height="20"
                   Fill="{StaticResource HorizontalPipeGradient}"
                   RenderOptions.CachingHint="Cache"/>

        <!-- ✅ 边缘线（使用性能优化模式） -->
        <Line x:Name="HorizontalTopEdge" 
              X1="3.58" Y1="34.32" 
              X2="37.18" Y2="34.32"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              RenderOptions.EdgeMode="Aliased"/>

        <Line x:Name="HorizontalBottomEdge" 
              X1="3.58" Y1="53.68" 
              X2="37.18" Y2="53.68"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              RenderOptions.EdgeMode="Aliased"/>

        <!-- ✅ 核心元素：弯头（不缓存，使用 GPU 渲染） -->
        <Path x:Name="ElbowPath" 
              StrokeThickness="0.7" 
              Stroke="#727171"
              RenderOptions.BitmapScalingMode="HighQuality">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="40,54">
                        <ArcSegment Point="60,34" Size="20,20" SweepDirection="Counterclockwise"/>
                        <LineSegment Point="50,34"/>
                        <ArcSegment Point="40,44" Size="10,10" SweepDirection="Clockwise"/>
                        <LineSegment Point="40,54"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <!-- ✅ 优化：简化弯头渐变 -->
            <Path.Fill>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="#5A5A5A" Offset="0"/>
                    <GradientStop Color="#727171" Offset="0.22"/>
                    <GradientStop Color="#40727171" Offset="0.40"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#40727171" Offset="0.60"/>
                    <GradientStop Color="#727171" Offset="0.78"/>
                    <GradientStop Color="#8A8A8A" Offset="1"/>
                </LinearGradientBrush>
            </Path.Fill>
        </Path>

        <!-- ✅ 弯头外侧强化（降低复杂度） -->
        <Path x:Name="ElbowOuterEdge" 
              Opacity="0.25"
              RenderOptions.EdgeMode="Aliased">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="40,53.5">
                        <ArcSegment Point="59.5,34" Size="19.5,19.5" SweepDirection="Counterclockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Stroke>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="#3E3E3E" Offset="0"/>
                    <GradientStop Color="#5A5A5A" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
            <Path.StrokeThickness>1.8</Path.StrokeThickness>
        </Path>

        <!-- ✅ 弯头高光（简化渐变） -->
        <Path x:Name="ElbowHighlight" 
              Opacity="0.25"
              RenderOptions.EdgeMode="Aliased">
            <Path.Data>
                <PathGeometry>
                    <PathFigure StartPoint="43,51">
                        <ArcSegment Point="57,37" Size="17,17" SweepDirection="Counterclockwise"/>
                    </PathFigure>
                </PathGeometry>
            </Path.Data>
            <Path.Stroke>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#E8E8E8" Offset="0.5"/>
                    <GradientStop Color="#F0F0F0" Offset="1"/>
                </LinearGradientBrush>
            </Path.Stroke>
            <Path.StrokeThickness>1.5</Path.StrokeThickness>
        </Path>

        <!-- ✅ 静态层：垂直管道（启用缓存） -->
        <Rectangle x:Name="VerticalPipe" 
                   Canvas.Left="50"
                   Canvas.Top="3.2"
                   Width="20"
                   Height="28"
                   Fill="{StaticResource VerticalPipeGradient}"
                   RenderOptions.CachingHint="Cache"/>

        <!-- ✅ 垂直边缘线（性能优化） -->
        <Line x:Name="VerticalLeftEdge" 
              X1="50.32" Y1="3.58" 
              X2="50.32" Y2="31.18"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              RenderOptions.EdgeMode="Aliased"/>

        <Line x:Name="VerticalRightEdge" 
              X1="69.68" Y1="3.58" 
              X2="69.68" Y2="31.18"
              Stroke="#000000" 
              StrokeThickness="0.7"
              Opacity="0.12"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              RenderOptions.EdgeMode="Aliased"/>

        <!-- ✅ 静态层：顶部法兰（启用缓存） -->
        <Canvas x:Name="TopFlangeGroup" 
                Canvas.Left="48"
                Canvas.Top="0.35"
                Width="24"
                Height="2.54"
                RenderOptions.CachingHint="Cache">

            <Rectangle x:Name="TopFlangeBase" 
                       Width="24"
                       Height="2.54" 
                       Fill="#D9D9D9" 
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="TopFlangeGradient" 
                       Width="24"
                       Height="2.54" 
                       Fill="{StaticResource TopEndCapGradient}"
                       Opacity="0.6"
                       RadiusX="1.27" 
                       RadiusY="1.27"/>

            <Rectangle x:Name="TopFlangeBorder" 
                       Width="24"
                       Height="2.54" 
                       Stroke="#727171" 
                       StrokeThickness="0.7" 
                       RadiusX="1.27" 
                       RadiusY="1.27" 
                       Fill="Transparent"/>
        </Canvas>

        <!-- ✅ 连接处（静态缓存） -->
        <Rectangle x:Name="LeftConnection" 
                   Canvas.Left="2.89"
                   Canvas.Top="34"
                   Width="1"
                   Height="20"
                   Fill="#727171" 
                   Opacity="0.6"
                   RenderOptions.CachingHint="Cache"/>

        <Rectangle x:Name="TopConnection" 
                   Canvas.Left="50"
                   Canvas.Top="2.89"
                   Width="20"
                   Height="1"
                   Fill="#727171" 
                   Opacity="0.6"
                   RenderOptions.CachingHint="Cache"/>

        <!-- ✅ 锚点（优化阴影性能） -->
        <Ellipse x:Name="LeftAnchor" 
                 Canvas.Left="-6"
                 Canvas.Top="38"
                 Width="12" Height="12" 
                 Fill="Orange" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeWE"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整水平长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="TopAnchor" 
                 Canvas.Left="54"
                 Canvas.Top="-6"
                 Width="12" Height="12" 
                 Fill="Orange" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeNS"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整垂直长度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="HorizontalWidthAnchor" 
                 Canvas.Left="19"
                 Canvas.Top="68"
                 Width="12" Height="12" 
                 Fill="Orange" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeNS"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <Ellipse x:Name="VerticalWidthAnchor" 
                 Canvas.Left="74"
                 Canvas.Top="15"
                 Width="12" Height="12" 
                 Fill="Orange" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="SizeWE"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动调整管道宽度"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- ✅ 选中边框（不缓存，优化阴影） -->
        <Rectangle x:Name="SelectionBorder" 
                   Canvas.Left="-2"
                   Canvas.Top="-2"
                   Width="84"
                   Height="84"
                   Stroke="#FF9500" 
                   StrokeThickness="2" 
                   Fill="Transparent" 
                   RadiusX="3" 
                   RadiusY="3" 
                   Visibility="Collapsed">
            <Rectangle.Effect>
                <DropShadowEffect Color="Orange" 
                                  BlurRadius="10" 
                                  ShadowDepth="0" 
                                  Opacity="0.8"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- ✅ 旋转锚点（缓存） -->
        <Ellipse x:Name="RotateAnchor" 
                 Canvas.Left="34"
                 Canvas.Top="-30"
                 Width="12" Height="12" 
                 Fill="#4CAF50" 
                 Stroke="White" 
                 StrokeThickness="2" 
                 Opacity="0" 
                 Cursor="Hand"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.ToolTip>
                <ToolTip Content="拖动旋转 (按住Shift=15°步进)"/>
            </Ellipse.ToolTip>
        </Ellipse>

        <!-- ✅ 旋转辅助线（性能模式） -->
        <Line x:Name="RotateAnchorLine" 
              X1="40" Y1="0"
              X2="40" Y2="-24"
              Stroke="Orange" 
              StrokeThickness="1" 
              StrokeDashArray="2,2" 
              Opacity="0"
              RenderOptions.EdgeMode="Aliased"/>

        <!-- ✅ 旋转角度标签（不缓存） -->
        <Border x:Name="RotationLabel"
                Canvas.Left="20"
                Canvas.Top="-50"
                Background="#CC000000"
                CornerRadius="3"
                Padding="5,2"
                Visibility="Collapsed">
            <TextBlock x:Name="RotationText"
                       Foreground="White"
                       FontSize="11"
                       Text="0°"
                       RenderOptions.ClearTypeHint="Enabled"/>
        </Border>
    </Canvas>

</UserControl>