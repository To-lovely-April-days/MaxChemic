<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.SolenoidValveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="200" 
             d:DesignWidth="200"
             Width="200" Height="200"
             Background="Transparent"
             ClipToBounds="False">

    <UserControl.Resources>
        <!-- ================================================================ -->
        <!--  C款 深灰工业风 - Bronkhorst Style                                -->
        <!--  特征: 磨砂金属质感 / 水平渐变 / 左高光右暗边 / 细线描边         -->
        <!-- ================================================================ -->

        <!-- ===== 管道渐变 (深灰金属磨砂) ===== -->
        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#6A6A72" Offset="0"/>
            <GradientStop Color="#868690" Offset="0.2"/>
            <GradientStop Color="#A8A8B0" Offset="0.5"/>
            <GradientStop Color="#868690" Offset="0.8"/>
            <GradientStop Color="#6A6A72" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== 关闭状态 - 深炭灰 ===== -->
        <LinearGradientBrush x:Key="ClosedBodyGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#5A5A62" Offset="0"/>
            <GradientStop Color="#74747E" Offset="0.15"/>
            <GradientStop Color="#8A8A94" Offset="0.35"/>
            <GradientStop Color="#94949E" Offset="0.5"/>
            <GradientStop Color="#8A8A94" Offset="0.65"/>
            <GradientStop Color="#74747E" Offset="0.85"/>
            <GradientStop Color="#5A5A62" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="ClosedCenterGradient" GradientOrigin="0.35,0.35">
            <GradientStop Color="#94949E" Offset="0"/>
            <GradientStop Color="#74747E" Offset="0.4"/>
            <GradientStop Color="#5E5E68" Offset="0.7"/>
            <GradientStop Color="#3A3A44" Offset="1"/>
        </RadialGradientBrush>

        <!-- ===== 开启状态 - 墨绿工业 ===== -->
        <LinearGradientBrush x:Key="OpenBodyGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#4A6A5A" Offset="0"/>
            <GradientStop Color="#648272" Offset="0.15"/>
            <GradientStop Color="#7A9686" Offset="0.35"/>
            <GradientStop Color="#86A090" Offset="0.5"/>
            <GradientStop Color="#7A9686" Offset="0.65"/>
            <GradientStop Color="#648272" Offset="0.85"/>
            <GradientStop Color="#4A6A5A" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="OpenCenterGradient" GradientOrigin="0.35,0.35">
            <GradientStop Color="#86A090" Offset="0"/>
            <GradientStop Color="#648272" Offset="0.4"/>
            <GradientStop Color="#4A6A5A" Offset="0.7"/>
            <GradientStop Color="#2A4236" Offset="1"/>
        </RadialGradientBrush>

        <!-- ===== 轮盘外圈 (深灰金属) ===== -->
        <LinearGradientBrush x:Key="WheelRingGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A3A42" Offset="0"/>
            <GradientStop Color="#5E5E68" Offset="0.5"/>
            <GradientStop Color="#2C2C34" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== 辐条渐变 ===== -->
        <LinearGradientBrush x:Key="SpokeGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#2C2C34" Offset="0"/>
            <GradientStop Color="#9898A0" Offset="0.5"/>
            <GradientStop Color="#2C2C34" Offset="1"/>
        </LinearGradientBrush>

        <!-- ===== 失败状态渐变 ===== -->
        <LinearGradientBrush x:Key="ErrorBodyGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#8B2020" Offset="0"/>
            <GradientStop Color="#A53030" Offset="0.15"/>
            <GradientStop Color="#BF4040" Offset="0.35"/>
            <GradientStop Color="#CC5050" Offset="0.5"/>
            <GradientStop Color="#BF4040" Offset="0.65"/>
            <GradientStop Color="#A53030" Offset="0.85"/>
            <GradientStop Color="#8B2020" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="ErrorCenterGradient" GradientOrigin="0.35,0.35">
            <GradientStop Color="#CC5050" Offset="0"/>
            <GradientStop Color="#A53030" Offset="0.4"/>
            <GradientStop Color="#8B2020" Offset="0.7"/>
            <GradientStop Color="#5A1010" Offset="1"/>
        </RadialGradientBrush>

        <!-- ===== 加载状态渐变 ===== -->
        <LinearGradientBrush x:Key="LoadingBodyGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#8B6A20" Offset="0"/>
            <GradientStop Color="#A58030" Offset="0.15"/>
            <GradientStop Color="#BF9840" Offset="0.35"/>
            <GradientStop Color="#CCAA50" Offset="0.5"/>
            <GradientStop Color="#BF9840" Offset="0.65"/>
            <GradientStop Color="#A58030" Offset="0.85"/>
            <GradientStop Color="#8B6A20" Offset="1"/>
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="LoadingCenterGradient" GradientOrigin="0.35,0.35">
            <GradientStop Color="#CCAA50" Offset="0"/>
            <GradientStop Color="#A58030" Offset="0.4"/>
            <GradientStop Color="#8B6A20" Offset="0.7"/>
            <GradientStop Color="#5A4210" Offset="1"/>
        </RadialGradientBrush>

        <!-- ========== 加载动画：蓝色扫描光效 ========== -->
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.2"/>

            <DoubleAnimation Storyboard.TargetName="LoadingCenterOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0.7" Duration="0:0:0.2"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LoadingScannerTranslate"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-250"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="250"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="-250"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="LoadingWheelRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:1.2"
                             BeginTime="0:0:0.2"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LoadingPulse"
                                           Storyboard.TargetProperty="Opacity"
                                           BeginTime="0:0:0.2">
                <LinearDoubleKeyFrame Value="0.3" KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame Value="0.8" KeyTime="0:0:0.5"/>
                <LinearDoubleKeyFrame Value="0.3" KeyTime="0:0:1"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LoadingPulse"
                                           Storyboard.TargetProperty="(Ellipse.RenderTransform).(ScaleTransform.ScaleX)"
                                           BeginTime="0:0:0.2">
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame Value="1.15" KeyTime="0:0:0.5"/>
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LoadingPulse"
                                           Storyboard.TargetProperty="(Ellipse.RenderTransform).(ScaleTransform.ScaleY)"
                                           BeginTime="0:0:0.2">
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame Value="1.15" KeyTime="0:0:0.5"/>
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1"/>
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ValveBodyGlow"
                                         Storyboard.TargetProperty="Color"
                                         Duration="0:0:1.5">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#00FFFFFF"/>
                <LinearColorKeyFrame KeyTime="0:0:0.75" Value="#662196F3"/>
                <LinearColorKeyFrame KeyTime="0:0:1.5" Value="#00FFFFFF"/>
            </ColorAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ValveBodyGlow"
                                          Storyboard.TargetProperty="BlurRadius"
                                          Duration="0:0:1.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="15"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ========== 错误动画：红色扫描光效 + 警告图标 ========== -->
        <Storyboard x:Key="ErrorBlinkAnimation" RepeatBehavior="3x">
            <DoubleAnimation Storyboard.TargetName="ErrorOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.1"/>

            <DoubleAnimation Storyboard.TargetName="ErrorCenterOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.1"/>

            <DoubleAnimation Storyboard.TargetName="ErrorWarningIcon"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.1"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ValveShakeTransform"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:0.1" RepeatBehavior="5x">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.02" Value="-3"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="3"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="-3"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="3"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.10" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorScannerTranslate"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-250"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="250"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="-250"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="250"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="-250"/>
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ValveBodyGlow"
                                         Storyboard.TargetProperty="Color"
                                         Duration="0:0:0.5">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="Transparent"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.1" Value="#FFD32F2F"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.25" Value="Transparent"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.4" Value="#FFD32F2F"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.5" Value="Transparent"/>
            </ColorAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ValveBodyGlow"
                                          Storyboard.TargetProperty="BlurRadius"
                                          Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="30"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="30"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIconScale"
                                          Storyboard.TargetProperty="ScaleX"
                                          Duration="0:0:0.5">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1.3"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIconScale"
                                          Storyboard.TargetProperty="ScaleY"
                                          Duration="0:0:0.5">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1.3"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ========== 错误保持动画 ========== -->
        <Storyboard x:Key="ErrorStateHoldAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ErrorOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0.8" Duration="0"/>

            <DoubleAnimation Storyboard.TargetName="ErrorCenterOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="0.8" Duration="0"/>

            <DoubleAnimation Storyboard.TargetName="ErrorWarningIcon"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorScannerTranslate"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:3">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-250"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="250"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="-250"/>
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ValveBodyGlow"
                                         Storyboard.TargetProperty="Color"
                                         Duration="0:0:2">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#66D32F2F"/>
                <LinearColorKeyFrame KeyTime="0:0:1" Value="#B3D32F2F"/>
                <LinearColorKeyFrame KeyTime="0:0:2" Value="#66D32F2F"/>
            </ColorAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ValveBodyGlow"
                                          Storyboard.TargetProperty="BlurRadius"
                                          Duration="0:0:2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="12"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="25"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="12"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorWarningIcon"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:1.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.8"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Canvas x:Name="ValveCanvas" Background="Transparent" ClipToBounds="False">
        <Canvas.RenderTransform>
            <TransformGroup>
                <RotateTransform Angle="90" CenterX="100" CenterY="100"/>
                <TranslateTransform x:Name="ValveShakeTransform" X="0" Y="0"/>
            </TransformGroup>
        </Canvas.RenderTransform>

        <!-- ===== 地面阴影 ===== -->
        <Ellipse Canvas.Left="10" Canvas.Top="192"
                 Width="180" Height="6"
                 Opacity="0.18"
                 Panel.ZIndex="0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A1A22" Offset="0"/>
                    <GradientStop Color="#1A1A22" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="6"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- ===== 左管道主体 ===== -->
        <Rectangle Canvas.Left="91" Canvas.Top="2"
                   Width="18" Height="96"
                   RadiusX="4" RadiusY="4"
                   Fill="{StaticResource PipeGradient}"
                   Panel.ZIndex="1"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#1A1A22" BlurRadius="5" ShadowDepth="2" Opacity="0.25" Direction="135"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 左管道高光条 -->
        <Rectangle Canvas.Left="93" Canvas.Top="4"
                   Width="3.5" Height="92"
                   RadiusX="1.5" RadiusY="1.5"
                   Fill="White"
                   Opacity="0.25"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <!-- 左管道右暗边 -->
        <Rectangle Canvas.Left="107" Canvas.Top="4"
                   Width="0.5" Height="92"
                   Fill="#1E1E26"
                   Opacity="0.4"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <!-- 左管道描边 -->
        <Rectangle Canvas.Left="91" Canvas.Top="2"
                   Width="18" Height="96"
                   RadiusX="4" RadiusY="4"
                   Stroke="#4A4A52"
                   StrokeThickness="0.5"
                   Fill="Transparent"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <!-- ===== 右管道主体 ===== -->
        <Rectangle Canvas.Left="91" Canvas.Top="102"
                   Width="18" Height="96"
                   RadiusX="4" RadiusY="4"
                   Fill="{StaticResource PipeGradient}"
                   Panel.ZIndex="1"
                   IsHitTestVisible="False">
            <Rectangle.Effect>
                <DropShadowEffect Color="#1A1A22" BlurRadius="5" ShadowDepth="2" Opacity="0.25" Direction="135"/>
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle Canvas.Left="93" Canvas.Top="104"
                   Width="3.5" Height="92"
                   RadiusX="1.5" RadiusY="1.5"
                   Fill="White"
                   Opacity="0.25"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <Rectangle Canvas.Left="107" Canvas.Top="104"
                   Width="0.5" Height="92"
                   Fill="#1E1E26"
                   Opacity="0.4"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <Rectangle Canvas.Left="91" Canvas.Top="102"
                   Width="18" Height="96"
                   RadiusX="4" RadiusY="4"
                   Stroke="#4A4A52"
                   StrokeThickness="0.5"
                   Fill="Transparent"
                   Panel.ZIndex="2"
                   IsHitTestVisible="False"/>

        <!-- ===== 阀门主体 ===== -->
        <Path x:Name="ValveBody"
              Data="M 63.075,186 C 63.075,186 57.506,160.118 54.267,143 C 51.12,126.368 50.5,116.818 50.5,100 C 50.5,83.182 51.12,73.632 54.267,57 C 57.506,39.882 63.075,14 63.075,14 L 136.908,14 C 136.908,14 141.724,39.882 144.963,57 C 148.11,73.632 149.337,83.182 149.483,100 C 149.63,116.807 148.844,126.377 145.716,143 C 142.485,160.177 136.908,186 136.908,186 Z"
              Fill="{Binding BodyColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={StaticResource ClosedBodyGradient}}"
              Stroke="#2A2A32"
              StrokeThickness="0.6"
              Panel.ZIndex="3"
              IsHitTestVisible="False">
            <Path.Effect>
                <DropShadowEffect x:Name="ValveBodyGlow" 
                                  Color="Transparent" 
                                  BlurRadius="0" 
                                  ShadowDepth="0" 
                                  Opacity="0.8"/>
            </Path.Effect>
        </Path>

        <!-- 阀体左侧高光带 (Bronkhorst 风格) -->
        <Path Data="M 63.075,186 C 57.506,160.118 54.267,143 54.267,143 C 51.12,126.368 50.5,116.818 50.5,100 C 50.5,83.182 51.12,73.632 54.267,57 C 57.506,39.882 63.075,14 63.075,14 L 67.075,14 C 67.075,14 62,40 59,57 C 56,73.8 55.3,83.3 55.3,100 C 55.3,116.9 56,126.4 59,143 C 62,160 67.075,186 67.075,186 Z"
              Fill="White"
              Opacity="0.15"
              Panel.ZIndex="4"
              IsHitTestVisible="False"/>

        <!-- 阀体右侧暗边 -->
        <Path Data="M 136.908,14 C 136.908,14 141.724,39.882 144.963,57 C 148.11,73.632 149.337,83.182 149.483,100 C 149.63,116.807 148.844,126.377 145.716,143 C 142.485,160.177 136.908,186 136.908,186 L 132.908,186 C 132.908,186 138,160 141,143 C 144,126.4 144.7,116.9 144.5,100 C 144.3,83.3 144,73.8 141,57 C 138,40 132.908,14 132.908,14 Z"
              Fill="#0A0A10"
              Opacity="0.3"
              Panel.ZIndex="4"
              IsHitTestVisible="False"/>

        <!-- 阀体细描边 -->
        <Path Data="M 63.075,186 C 63.075,186 57.506,160.118 54.267,143 C 51.12,126.368 50.5,116.818 50.5,100 C 50.5,83.182 51.12,73.632 54.267,57 C 57.506,39.882 63.075,14 63.075,14 L 136.908,14 C 136.908,14 141.724,39.882 144.963,57 C 148.11,73.632 149.337,83.182 149.483,100 C 149.63,116.807 148.844,126.377 145.716,143 C 142.485,160.177 136.908,186 136.908,186 Z"
              Stroke="#1A1A22"
              StrokeThickness="0.4"
              Fill="Transparent"
              Opacity="0.6"
              Panel.ZIndex="5"
              IsHitTestVisible="False"/>

        <!-- 加载状态覆盖层：蓝色扫描光效 -->
        <Canvas x:Name="LoadingOverlay" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="20">
            <Path Data="M 63.075,186 C 63.075,186 57.506,160.118 54.267,143 C 51.12,126.368 50.5,116.818 50.5,100 C 50.5,83.182 51.12,73.632 54.267,57 C 57.506,39.882 63.075,14 63.075,14 L 136.908,14 C 136.908,14 141.724,39.882 144.963,57 C 148.11,73.632 149.337,83.182 149.483,100 C 149.63,116.807 148.844,126.377 145.716,143 C 142.485,160.177 136.908,186 136.908,186 Z">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#402196F3" Offset="0.45"/>
                        <GradientStop Color="#8064B5F6" Offset="0.5"/>
                        <GradientStop Color="#402196F3" Offset="0.55"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                        <LinearGradientBrush.Transform>
                            <TranslateTransform x:Name="LoadingScannerTranslate" X="-250"/>
                        </LinearGradientBrush.Transform>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>

        <!-- 加载状态中心圆盘覆盖层 -->
        <Ellipse x:Name="LoadingCenterOverlay"
                 Canvas.Left="77" Canvas.Top="77"
                 Width="46" Height="46"
                 Fill="{StaticResource LoadingCenterGradient}"
                 Opacity="0"
                 Panel.ZIndex="21"
                 IsHitTestVisible="False">
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF9800" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 加载轮盘旋转层 -->
        <Canvas x:Name="LoadingWheelContainer"
                Canvas.Left="0" Canvas.Top="0"
                Width="200" Height="200"
                Panel.ZIndex="22"
                Opacity="0"
                IsHitTestVisible="False">

            <Canvas.RenderTransform>
                <RotateTransform x:Name="LoadingWheelRotation" Angle="0" CenterX="100" CenterY="100"/>
            </Canvas.RenderTransform>

            <Path Fill="#2196F3" Opacity="0.8">
                <Path.Data>
                    <GeometryGroup>
                        <EllipseGeometry Center="100,55" RadiusX="4" RadiusY="4"/>
                        <EllipseGeometry Center="130,80" RadiusX="4" RadiusY="4"/>
                        <EllipseGeometry Center="130,120" RadiusX="4" RadiusY="4"/>
                    </GeometryGroup>
                </Path.Data>
                <Path.Effect>
                    <DropShadowEffect Color="#2196F3" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                </Path.Effect>
            </Path>
        </Canvas>

        <!-- 脉冲效果圆环 -->
        <Ellipse x:Name="LoadingPulse"
                 Canvas.Left="70" Canvas.Top="70"
                 Width="60" Height="60"
                 Stroke="#2196F3"
                 StrokeThickness="2"
                 Fill="Transparent"
                 Opacity="0"
                 Panel.ZIndex="23"
                 IsHitTestVisible="False"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Ellipse.RenderTransform>
            <Ellipse.Effect>
                <BlurEffect Radius="3"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 错误状态覆盖层：红色扫描光效 -->
