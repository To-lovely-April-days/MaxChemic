<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.JingRuiPumpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="250"
             d:DesignWidth="320"
             Background="Transparent"
             Cursor="SizeAll"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <!--
        精睿系列柱塞泵(杭州精进科技)画布控件 —— 正视图。

        画布 320×250。管路刻意画在机身轮廓之外:出液管从泵头顶端向上再向右走,
        进液管从泵头底部向下走 —— 这样两条管都有足够长的可见段来跑液流动画,
        画布上一眼能看出泵在不在送液、往哪个方向送。

        液流动画不靠逐帧移动小圆点,而是给管芯 Path 一个 StrokeDashArray,
        再动 StrokeDashOffset。一条 DoubleAnimation 就够,缩放到画布上的小尺寸时
        也不会因为圆点太小而糊成一条线。

        柱塞往复:泵头里那根柱塞用 TranslateTransform 上下走,周期随流量变快。
        流量为 0 时停在原位,不做"空转"的假动作。

        绘制顺序:进出液管 → 机身 → 顶面高光 → 泵头 → 柱塞 → 显示屏
                  → 压力条 → 状态灯 → 铭牌 → 交互层
    -->

    <UserControl.Resources>
        <!-- 机身:上浅下深的金属漆面 -->
        <LinearGradientBrush x:Key="BodyBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3A4046" Offset="0"/>
            <GradientStop Color="#2A2F34" Offset="0.55"/>
            <GradientStop Color="#1E2226" Offset="1"/>
        </LinearGradientBrush>

        <!-- 泵头:不锈钢圆柱的高光 -->
        <LinearGradientBrush x:Key="HeadBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7E848A" Offset="0"/>
            <GradientStop Color="#D2D7DC" Offset="0.34"/>
            <GradientStop Color="#AEB4BA" Offset="0.62"/>
            <GradientStop Color="#71777D" Offset="1"/>
        </LinearGradientBrush>

        <!-- 压力条:低→高 由绿转琥珀,超限段红 -->
        <LinearGradientBrush x:Key="PressureBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#3FBF87" Offset="0"/>
            <GradientStop Color="#8FC94F" Offset="0.45"/>
            <GradientStop Color="#E8A33D" Offset="0.78"/>
            <GradientStop Color="#E0523C" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Viewbox Stretch="Fill">
        <Canvas Width="320" Height="250">

            <!-- ═══ 1. 管路(画在机身之下,让机身盖住接口根部) ═══ -->

            <!-- 出液管:泵头顶 → 上 → 右出画面 -->
            <Path Stroke="#6E7479" StrokeThickness="9"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Data="M 59,104 L 59,16 L 316,16"/>
            <Path x:Name="OutletFlowPath" Stroke="#7FD8F0" StrokeThickness="4"
                  StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" StrokeLineJoin="Round"
                  StrokeDashArray="2.2,2.2" StrokeDashOffset="0" Opacity="0"
                  Data="M 59,104 L 59,16 L 316,16"/>

            <!-- 进液管:泵头底 → 下出画面 -->
            <Path Stroke="#6E7479" StrokeThickness="9"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 59,180 L 59,248"/>
            <Path x:Name="InletFlowPath" Stroke="#7FD8F0" StrokeThickness="4"
                  StrokeDashArray="2.2,2.2" StrokeDashOffset="0" Opacity="0"
                  Data="M 59,248 L 59,180"/>

            <!-- ═══ 2. 机身 ═══ -->
            <Rectangle Canvas.Left="8" Canvas.Top="28" Width="304" Height="204"
                       RadiusX="10" RadiusY="10"
                       Fill="{StaticResource BodyBrush}" Stroke="#5A6167" StrokeThickness="1.4"/>
            <!-- 顶面高光 -->
            <Rectangle Canvas.Left="14" Canvas.Top="32" Width="292" Height="10"
                       RadiusX="5" RadiusY="5" Fill="White" Opacity="0.07"/>
            <!-- 机脚 -->
            <Rectangle Canvas.Left="34" Canvas.Top="232" Width="34" Height="9"
                       RadiusX="3" RadiusY="3" Fill="#16191C"/>
            <Rectangle Canvas.Left="252" Canvas.Top="232" Width="34" Height="9"
                       RadiusX="3" RadiusY="3" Fill="#16191C"/>

            <!-- ═══ 3. 泵头 ═══ -->
            <Rectangle Canvas.Left="28" Canvas.Top="96" Width="62" Height="88"
                       RadiusX="7" RadiusY="7"
                       Fill="{StaticResource HeadBrush}" Stroke="#5F656B" StrokeThickness="1.2"/>
            <!-- 泵头端面凹槽 -->
            <Rectangle Canvas.Left="36" Canvas.Top="106" Width="46" Height="68"
                       RadiusX="4" RadiusY="4" Fill="#00000000" Stroke="#8C9298" StrokeThickness="1"/>
            <!-- 接口压帽:上出下进 -->
            <Rectangle Canvas.Left="49" Canvas.Top="90" Width="20" Height="12"
                       RadiusX="2" RadiusY="2" Fill="#9AA0A6" Stroke="#5F656B" StrokeThickness="1"/>
            <Rectangle Canvas.Left="49" Canvas.Top="178" Width="20" Height="12"
                       RadiusX="2" RadiusY="2" Fill="#9AA0A6" Stroke="#5F656B" StrokeThickness="1"/>

            <!-- 柱塞:运行时上下往复 -->
            <Rectangle x:Name="Plunger"
                       Canvas.Left="52" Canvas.Top="122" Width="14" Height="36"
                       RadiusX="3" RadiusY="3" Fill="#E4E8EC" Stroke="#8C9298" StrokeThickness="0.8">
                <Rectangle.RenderTransform>
                    <TranslateTransform x:Name="PlungerMove" Y="0"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <!-- ═══ 4. 显示屏 ═══ -->
            <Rectangle Canvas.Left="108" Canvas.Top="56" Width="194" Height="72"
                       RadiusX="4" RadiusY="4" Fill="#060E0C" Stroke="#3A4147" StrokeThickness="1.2"/>

            <!-- 流量行 -->
            <TextBlock x:Name="FlowValueText"
                       Canvas.Left="116" Canvas.Top="60" Width="126" TextAlignment="Right"
                       Text="0.00" FontFamily="Consolas" FontSize="27" FontWeight="Bold"
                       Foreground="#5DCAA5" IsHitTestVisible="False"/>
            <TextBlock Canvas.Left="248" Canvas.Top="72"
                       Text="mL/min" FontFamily="Consolas" FontSize="12"
                       Foreground="#2F6B58" IsHitTestVisible="False"/>

            <!-- 压力行 -->
            <TextBlock x:Name="PressureValueText"
                       Canvas.Left="116" Canvas.Top="92" Width="126" TextAlignment="Right"
                       Text="0.00" FontFamily="Consolas" FontSize="27" FontWeight="Bold"
                       Foreground="#EF9F27" IsHitTestVisible="False"/>
            <TextBlock Canvas.Left="248" Canvas.Top="104"
                       Text="MPa" FontFamily="Consolas" FontSize="12"
                       Foreground="#7A6338" IsHitTestVisible="False"/>

            <!-- 设定流量小字:让画布上也能看出"设的是多少、跑的是多少" -->
            <TextBlock x:Name="SetpointText"
                       Canvas.Left="116" Canvas.Top="60"
                       Text="SV --" FontFamily="Consolas" FontSize="11"
                       Foreground="#4E7C6C" IsHitTestVisible="False"/>

            <!-- ═══ 5. 压力条 ═══ -->
            <Rectangle Canvas.Left="108" Canvas.Top="138" Width="194" Height="9"
                       RadiusX="4" RadiusY="4" Fill="#22272B" Stroke="#3A4147" StrokeThickness="1"/>
            <Rectangle x:Name="PressureBar"
                       Canvas.Left="108" Canvas.Top="138" Width="0" Height="9"
                       RadiusX="4" RadiusY="4" Fill="{StaticResource PressureBarBrush}"/>
            <!-- 上限刻线:压力上限落在条上的位置 -->
            <Rectangle x:Name="PressureLimitTick"
                       Canvas.Left="302" Canvas.Top="135" Width="2" Height="15" Fill="#E0523C"/>

            <!-- ═══ 6. 状态灯 ═══ -->
            <Ellipse x:Name="LedRun" Canvas.Left="110" Canvas.Top="158" Width="10" Height="10" Fill="#2C3237"/>
            <TextBlock Canvas.Left="124" Canvas.Top="156" Text="RUN" FontFamily="Consolas" FontSize="11"
                       Foreground="#8A9096" IsHitTestVisible="False"/>

            <Ellipse x:Name="LedDose" Canvas.Left="172" Canvas.Top="158" Width="10" Height="10" Fill="#2C3237"/>
            <TextBlock Canvas.Left="186" Canvas.Top="156" Text="DOSE" FontFamily="Consolas" FontSize="11"
                       Foreground="#8A9096" IsHitTestVisible="False"/>

            <Ellipse x:Name="LedFault" Canvas.Left="242" Canvas.Top="158" Width="10" Height="10" Fill="#2C3237"/>
            <TextBlock Canvas.Left="256" Canvas.Top="156" Text="ALM" FontFamily="Consolas" FontSize="11"
                       Foreground="#8A9096" IsHitTestVisible="False"/>

            <!-- ═══ 7. 铭牌 ═══ -->
            <TextBlock Canvas.Left="28" Canvas.Top="196" Text="精睿进料泵"
                       FontFamily="Microsoft YaHei" FontSize="15" Foreground="#D6DADE"
                       IsHitTestVisible="False"/>
            <TextBlock x:Name="FaultText"
                       Canvas.Left="122" Canvas.Top="200" Width="180" TextAlignment="Right"
                       Text="RS485 · Modbus" FontFamily="Consolas" FontSize="12"
                       Foreground="#798086" IsHitTestVisible="False"/>

            <!-- ══════════════════ 交互层 ══════════════════ -->

            <!-- 可拖拽区域:盖住整机 -->
            <Rectangle x:Name="DraggableArea"
                       Canvas.Left="0" Canvas.Top="0" Width="320" Height="250"
                       Fill="Transparent" Panel.ZIndex="100" Cursor="SizeAll"
                       MouseDown="OnDraggableAreaMouseDown"
                       MouseMove="OnDraggableAreaMouseMove"
                       MouseUp="OnDraggableAreaMouseUp"
                       MouseLeave="OnDraggableAreaMouseLeave"/>

            <!-- 通信中遮罩:只盖显示屏,状态灯照常可见 -->
            <Border x:Name="LoadingOverlay"
                    Canvas.Left="108" Canvas.Top="56" Width="194" Height="72"
                    CornerRadius="4" Background="#8A000000" Visibility="Collapsed" Panel.ZIndex="120">
                <TextBlock Text="-  -  -  -  -" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="18" FontWeight="Bold" Foreground="#5DCAA5" FontFamily="Consolas"/>
            </Border>

            <!-- 选择边框(由设计器统一选中系统接管,这里常隐藏) -->
            <Rectangle x:Name="SelectionBorder"
                       Canvas.Left="1" Canvas.Top="1" Width="318" Height="248"
                       RadiusX="12" RadiusY="12"
                       Stroke="#2196F3" StrokeThickness="2" StrokeDashArray="5,3"
                       Visibility="Collapsed" Panel.ZIndex="200" IsHitTestVisible="False">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#2196F3" BlurRadius="5" ShadowDepth="0" Opacity="0.3"/>
                </Rectangle.Effect>
            </Rectangle>

        </Canvas>
    </Viewbox>
</UserControl>
