            <!-- ====== 3D泵头 ====== -->

            <!-- 泵头阴影 -->
            <Rectangle Canvas.Left="40" Canvas.Top="278" Width="170" Height="195"
                       RadiusX="8" RadiusY="8"
                       Fill="Black" Opacity="0.06" Panel.ZIndex="4"/>

            <!-- 泵头侧面(右) -->
            <Path Fill="#222222" Stroke="#1A1A1A" StrokeThickness="0.4" Panel.ZIndex="5">
                <Path.Data>
                    <PathGeometry Figures="M 201,269 L 218,260 L 218,483 L 201,492 Z"/>
                </Path.Data>
            </Path>
            <!-- 泵头侧面(顶) -->
