<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.PistonPumpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" 
             d:DesignWidth="880"
             Width="880" Height="600"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <UserControl.Resources>
        <!-- ========== 🆕 运行状态颜色渐变（与电磁阀一致） ========== -->

        <!-- 运行状态：蓝绿色外壳渐变 -->
        <LinearGradientBrush x:Key="RunningShellGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7FB89D" Offset="0"/>
            <GradientStop Color="#9AC9B3" Offset="0.1"/>
            <GradientStop Color="#B5D9C8" Offset="0.2"/>
            <GradientStop Color="#CFE8DC" Offset="0.35"/>
            <GradientStop Color="#E5F4ED" Offset="0.5"/>
            <GradientStop Color="#CFE8DC" Offset="0.65"/>
            <GradientStop Color="#B5D9C8" Offset="0.8"/>
            <GradientStop Color="#9AC9B3" Offset="0.9"/>
            <GradientStop Color="#7FB89D" Offset="1"/>
        </LinearGradientBrush>

        <!-- 运行状态：气缸径向渐变 -->
        <RadialGradientBrush x:Key="RunningCylinderGradient" GradientOrigin="0.3,0.3">
            <GradientStop Color="#D4F1E8" Offset="0"/>
            <GradientStop Color="#A3E0CA" Offset="0.3"/>
            <GradientStop Color="#7FD4B8" Offset="0.6"/>
            <GradientStop Color="#5CB89D" Offset="0.85"/>
            <GradientStop Color="#3D9A7F" Offset="1"/>
        </RadialGradientBrush>

        <!-- 停止状态：灰色外壳渐变（保持原样） -->
        <LinearGradientBrush x:Key="StoppedShellGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#A8B0D4" Offset="0"/>
            <GradientStop Color="#B4BBD9" Offset="0.1"/>
            <GradientStop Color="#BBC2DE" Offset="0.2"/>
            <GradientStop Color="#CDD3E8" Offset="0.35"/>
            <GradientStop Color="#F1F2F8" Offset="0.5"/>
            <GradientStop Color="#CDD3E8" Offset="0.65"/>
            <GradientStop Color="#BBC2DE" Offset="0.8"/>
            <GradientStop Color="#B4BBD9" Offset="0.9"/>
            <GradientStop Color="#A8B0D4" Offset="1"/>
        </LinearGradientBrush>

        <!-- 停止状态：气缸渐变（保持原样） -->
        <LinearGradientBrush x:Key="StoppedCylinderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6E78A8" Offset="0"/>
            <GradientStop Color="#8890B8" Offset="0.15"/>
            <GradientStop Color="#B4BAD5" Offset="0.35"/>
            <GradientStop Color="#D2D6E8" Offset="0.5"/>
            <GradientStop Color="#B4BAD5" Offset="0.65"/>
            <GradientStop Color="#8890B8" Offset="0.85"/>
            <GradientStop Color="#6E78A8" Offset="1"/>
        </LinearGradientBrush>

        <!-- ========== 正常运行动画 (保持不变) ========== -->
        <Storyboard x:Key="PistonMotionStoryboard" RepeatBehavior="Forever">
            <!-- 柱塞1 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Piston1Transform"
                                          Storyboard.TargetProperty="Y"
                                          Duration="0:0:2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="-30">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="Piston1Rod"
                                         Storyboard.TargetProperty="(Rectangle.Fill).(SolidColorBrush.Color)"
                                         Duration="0:0:2">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#B0BCC3"/>
                <LinearColorKeyFrame KeyTime="0:0:0.25" Value="#4A90E2"/>
                <LinearColorKeyFrame KeyTime="0:0:0.5" Value="#4CAF50"/>
                <LinearColorKeyFrame KeyTime="0:0:0.75" Value="#4A90E2"/>
                <LinearColorKeyFrame KeyTime="0:0:1" Value="#B0BCC3"/>
            </ColorAnimationUsingKeyFrames>

            <!-- 柱塞2 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Piston2Transform"
                                          Storyboard.TargetProperty="Y"
                                          Duration="0:0:2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="-30">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="Piston2Rod"
                                         Storyboard.TargetProperty="(Rectangle.Fill).(SolidColorBrush.Color)"
                                         Duration="0:0:2">
                <LinearColorKeyFrame KeyTime="0:0:0.5" Value="#B0BCC3"/>
                <LinearColorKeyFrame KeyTime="0:0:0.75" Value="#4A90E2"/>
                <LinearColorKeyFrame KeyTime="0:0:1" Value="#4CAF50"/>
                <LinearColorKeyFrame KeyTime="0:0:1.25" Value="#4A90E2"/>
                <LinearColorKeyFrame KeyTime="0:0:1.5" Value="#B0BCC3"/>
            </ColorAnimationUsingKeyFrames>

            <!-- 柱塞3 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Piston3Transform"
                                          Storyboard.TargetProperty="Y"
                                          Duration="0:0:2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="-30">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="Piston3Rod"
                                         Storyboard.TargetProperty="(Rectangle.Fill).(SolidColorBrush.Color)"
                                         Duration="0:0:2">
                <LinearColorKeyFrame KeyTime="0:0:1" Value="#B0BCC3"/>
                <LinearColorKeyFrame KeyTime="0:0:1.25" Value="#4A90E2"/>
                <LinearColorKeyFrame KeyTime="0:0:1.5" Value="#4CAF50"/>
                <LinearColorKeyFrame KeyTime="0:0:1.75" Value="#4A90E2"/>
                <LinearColorKeyFrame KeyTime="0:0:2" Value="#B0BCC3"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ========== 加载动画 ========== -->
        <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoadingOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.2"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScannerTranslate"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-400"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="400"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="-400"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimation Storyboard.TargetName="LoadingRing1Rotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.5"/>
            <DoubleAnimation Storyboard.TargetName="LoadingRing2Rotate"
                             Storyboard.TargetProperty="Angle"
                             From="90" To="450" Duration="0:0:1.5"/>
            <DoubleAnimation Storyboard.TargetName="LoadingRing3Rotate"
                             Storyboard.TargetProperty="Angle"
                             From="180" To="540" Duration="0:0:1.5"/>
            <DoubleAnimation Storyboard.TargetName="LoadingRing4Rotate"
                             Storyboard.TargetProperty="Angle"
                             From="270" To="630" Duration="0:0:1.5"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PipeFlowGradient"
                                          Storyboard.TargetProperty="Offset"
                                          Duration="0:0:1">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                  Storyboard.TargetProperty="BlurRadius"
                                  Duration="0:0:1.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="10"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                 Storyboard.TargetProperty="Color"
                                 Duration="0:0:1.5">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#00FFFFFF"/>
                <LinearColorKeyFrame KeyTime="0:0:0.75" Value="#662196F3"/>
                <LinearColorKeyFrame KeyTime="0:0:1.5" Value="#00FFFFFF"/>
            </ColorAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ========== 错误动画 ========== -->
        <Storyboard x:Key="ErrorBlinkAnimation" RepeatBehavior="3x">
            <DoubleAnimation Storyboard.TargetName="ErrorOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.1"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellShakeTransform"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:0.1" RepeatBehavior="5x">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.00" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.02" Value="-5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.04" Value="5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="-5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.08" Value="5"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.10" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorScannerTranslate"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-400"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="400"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="-400"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="400"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="-400"/>
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                 Storyboard.TargetProperty="Color"
                                 Duration="0:0:0.5">
                <DiscreteColorKeyFrame KeyTime="0:0:0" Value="Transparent"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.1" Value="#FFD32F2F"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.25" Value="Transparent"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.4" Value="#FFD32F2F"/>
                <DiscreteColorKeyFrame KeyTime="0:0:0.5" Value="Transparent"/>
            </ColorAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                  Storyboard.TargetProperty="BlurRadius"
                                  Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="40"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="40"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIndicator1"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIndicator2"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:0.5">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.1" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.25" Value="0"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIconScale"
                                          Storyboard.TargetProperty="ScaleX"
                                          Duration="0:0:0.5">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1.2"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIconScale"
                                          Storyboard.TargetProperty="ScaleY"
                                          Duration="0:0:0.5">
                <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.5"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1.2"/>
                <SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ========== 错误保持动画 ========== -->
        <Storyboard x:Key="ErrorStateHoldAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ErrorOverlay"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0"/>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorScannerTranslate"
                                          Storyboard.TargetProperty="X"
                                          Duration="0:0:3">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="-400"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="400"/>
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="-400"/>
            </DoubleAnimationUsingKeyFrames>

            <ColorAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                 Storyboard.TargetProperty="Color"
                                 Duration="0:0:2">
                <LinearColorKeyFrame KeyTime="0:0:0" Value="#66D32F2F"/>
                <LinearColorKeyFrame KeyTime="0:0:1" Value="#B3D32F2F"/>
                <LinearColorKeyFrame KeyTime="0:0:2" Value="#66D32F2F"/>
            </ColorAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShellGlow"
                                  Storyboard.TargetProperty="BlurRadius"
                                  Duration="0:0:2">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="15"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="30"/>
                <LinearDoubleKeyFrame KeyTime="0:0:2" Value="15"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIndicator1"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:1">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.6"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIndicator2"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:1">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.6"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.5" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.6"/>
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ErrorIcon"
                                          Storyboard.TargetProperty="Opacity"
                                          Duration="0:0:1.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.8"/>
                <LinearDoubleKeyFrame KeyTime="0:0:0.75" Value="1"/>
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.8"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- 其他渐变资源 -->
        <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#59020202" Offset="0"/>
            <GradientStop Color="#1F020202" Offset="0.026"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.116"/>
            <GradientStop Color="#4DFFFFFF" Offset="0.498"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.888"/>
            <GradientStop Color="#1F020202" Offset="0.966"/>
            <GradientStop Color="#59020202" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A8B5BC" Offset="0"/>
            <GradientStop Color="#C4CFD6" Offset="0.15"/>
            <GradientStop Color="#DCE4E9" Offset="0.35"/>
            <GradientStop Color="#F4F7F9" Offset="0.5"/>
            <GradientStop Color="#DCE4E9" Offset="0.65"/>
            <GradientStop Color="#C4CFD6" Offset="0.85"/>
            <GradientStop Color="#A8B5BC" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CylinderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#6E78A8" Offset="0"/>
            <GradientStop Color="#8890B8" Offset="0.15"/>
            <GradientStop Color="#B4BAD5" Offset="0.35"/>
            <GradientStop Color="#D2D6E8" Offset="0.5"/>
            <GradientStop Color="#B4BAD5" Offset="0.65"/>
            <GradientStop Color="#8890B8" Offset="0.85"/>
            <GradientStop Color="#6E78A8" Offset="1"/>
        </LinearGradientBrush>

        <!-- 按钮样式 -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderOptions.CachingHint="Cache">
                            <Ellipse x:Name="ButtonBg" Opacity="0.08">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EEF1" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                                    BlurRadius="8" ShadowDepth="3" Direction="315"
                                                    RenderingBias="Performance"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Stroke="White" StrokeThickness="2.5" Margin="1" Opacity="0.9"/>
                            <Ellipse Margin="4" Opacity="0.15">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PowerButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderOptions.CachingHint="Cache">
                            <Ellipse x:Name="ButtonBg" Fill="#FFFFFFFF">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                            BlurRadius="8" ShadowDepth="3" Direction="315"
                                            RenderingBias="Performance"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Stroke="White" StrokeThickness="2.5" Margin="1" Opacity="0.5"/>
                            <Ellipse Margin="4" Opacity="0.08">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Fill" Value="#F5FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Fill" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Canvas Background="Transparent">
        <!-- 可拖拽区域 -->
        <Rectangle x:Name="DraggableArea"
                   Canvas.Left="0" Canvas.Top="0"
                   Width="880" Height="600"
                   Fill="Transparent"
                   Panel.ZIndex="0"
                   Cursor="SizeAll"
                   MouseDown="OnDraggableAreaMouseDown"
                   MouseMove="OnDraggableAreaMouseMove"
                   MouseUp="OnDraggableAreaMouseUp"
                   MouseLeave="OnDraggableAreaMouseLeave"/>

        <!-- 地面阴影 -->
        <Ellipse Canvas.Left="240" Canvas.Top="592"
                 Width="320" Height="6" Opacity="0.15"
                 RenderOptions.CachingHint="Cache">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2A4A68" Offset="0"/>
                    <GradientStop Color="#2A4A68" Offset="0.6"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect>
                <BlurEffect Radius="6" RenderingBias="Performance"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 底座 -->
        <Rectangle Canvas.Left="250" Canvas.Top="571" Width="300" Height="29" RadiusX="7" RadiusY="7"
                   Panel.ZIndex="1"
                   RenderOptions.CachingHint="Cache">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4DB8C5CC" Offset="0"/>
                    <GradientStop Color="#66B8C5CC" Offset="0.3"/>
                    <GradientStop Color="#99AAB8BF" Offset="0.6"/>
                    <GradientStop Color="#B8C5CC" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.Stroke>
                <SolidColorBrush Color="#2A4A68" Opacity="0.15"/>
            </Rectangle.Stroke>
            <Rectangle.StrokeThickness>2.5</Rectangle.StrokeThickness>
            <Rectangle.Effect>
                <DropShadowEffect x:Name="BaseGlow" 
                                  Color="Transparent" 
                                  Opacity="0.6" 
                                  BlurRadius="0" 
                                  ShadowDepth="0"
                                  RenderingBias="Performance"/>
            </Rectangle.Effect>
        </Rectangle>

        <!-- 底座上的嵌入式错误指示灯 -->
        <Ellipse x:Name="ErrorIndicator1" Canvas.Left="265" Canvas.Top="578" Width="15" Height="15" 
                 Fill="#D32F2F" Opacity="0" Panel.ZIndex="2">
            <Ellipse.Effect>
                <DropShadowEffect Color="#D32F2F" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="ErrorIndicator2" Canvas.Left="520" Canvas.Top="578" Width="15" Height="15" 
                 Fill="#D32F2F" Opacity="0" Panel.ZIndex="2">
            <Ellipse.Effect>
                <DropShadowEffect Color="#D32F2F" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
