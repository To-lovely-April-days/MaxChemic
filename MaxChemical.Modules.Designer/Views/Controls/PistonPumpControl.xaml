            <Ellipse Canvas.Left="363" Canvas.Top="118" Width="3" Height="3" Fill="#6A7A8A" Opacity="0.4" Panel.ZIndex="5"/>
            <Ellipse Canvas.Left="376" Canvas.Top="118" Width="3" Height="3" Fill="#6A7A8A" Opacity="0.4" Panel.ZIndex="5"/>
            <Ellipse Canvas.Left="386" Canvas.Top="122" Width="3" Height="3" Fill="#6A7A8A" Opacity="0.4" Panel.ZIndex="5"/>
            <Ellipse Canvas.Left="392" Canvas.Top="131" Width="3" Height="3" Fill="#6A7A8A" Opacity="0.4" Panel.ZIndex="5"/>

