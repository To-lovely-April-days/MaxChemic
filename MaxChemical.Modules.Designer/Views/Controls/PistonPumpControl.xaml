                    <SolidColorBrush Color="#1A3050" Opacity="0.75"/>
                </Rectangle.Fill>
            </Rectangle>
            <TextBlock Canvas.Left="333" Canvas.Top="251" Width="81" Height="30"
                       Text="STOP" FontFamily="Arial" FontSize="13" FontWeight="Bold"
                       Foreground="#90B8C8" TextAlignment="Center" Panel.ZIndex="6"/>
            <Button Canvas.Left="333" Canvas.Top="246" Width="81" Height="30"
                    Background="Transparent" BorderThickness="0" Opacity="0"
                    Panel.ZIndex="99" Cursor="Hand" Click="OnStopButtonClick"/>

            <!-- ▲▼ 速度调节 -->
            <Ellipse Canvas.Left="340" Canvas.Top="290" Width="30" Height="30"
