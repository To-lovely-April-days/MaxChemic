                       RadiusX="4" RadiusY="4"
                       Fill="#2A2A28" Stroke="#1A1A18" StrokeThickness="0.4" Panel.ZIndex="5"/>
            <TextBlock Canvas.Left="341" Canvas.Top="403" Width="59" Height="23"
                       Text="I/O" FontFamily="Arial" FontSize="11" FontWeight="Bold"
                       Foreground="#A0A098" TextAlignment="Center" Panel.ZIndex="6"/>
