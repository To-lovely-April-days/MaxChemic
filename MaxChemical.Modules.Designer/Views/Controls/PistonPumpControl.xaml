                       Text="▼" FontFamily="Arial" FontSize="11" FontWeight="Bold"
                       Foreground="#2A3A4A" TextAlignment="Center" Panel.ZIndex="6"/>
            <Button Canvas.Left="384" Canvas.Top="290" Width="30" Height="30"
                    Background="Transparent" BorderThickness="0" Opacity="0"
                    Panel.ZIndex="99" Cursor="Hand" Click="OnDecreaseButtonClick"/>

            <!-- DIR/SET -->
            <Rectangle Canvas.Left="333" Canvas.Top="328" Width="81" Height="23"
                       RadiusX="6" RadiusY="6"
                       Fill="#90A0AE" Stroke="#6A7A8A" StrokeThickness="0.3" Panel.ZIndex="5"/>
            <TextBlock Canvas.Left="333" Canvas.Top="331" Width="81" Height="23"
                       Text="DIR" FontFamily="Arial" FontSize="11" FontWeight="SemiBold"
                       Foreground="#2A3A4A" TextAlignment="Center" Panel.ZIndex="6"/>

            <Rectangle Canvas.Left="333" Canvas.Top="357" Width="81" Height="23"
                       RadiusX="6" RadiusY="6"
                       Fill="#90A0AE" Stroke="#6A7A8A" StrokeThickness="0.3" Panel.ZIndex="5"/>
            <TextBlock Canvas.Left="333" Canvas.Top="360" Width="81" Height="23"
                       Text="SET" FontFamily="Arial" FontSize="11" FontWeight="SemiBold"
                       Foreground="#2A3A4A" TextAlignment="Center" Panel.ZIndex="6"/>

