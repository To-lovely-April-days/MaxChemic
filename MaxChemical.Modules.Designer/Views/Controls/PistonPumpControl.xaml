<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.PistonPumpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" 
             d:DesignWidth="880"
             Width="880" Height="600"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False">

    <UserControl.Resources>
        <!-- 柱塞往复运动动画 -->
        <Storyboard x:Key="PistonMotionStoryboard" RepeatBehavior="Forever">
            <!-- 柱塞1向上运动 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Piston1Transform"
                                          Storyboard.TargetProperty="Y"
                                          Duration="0:0:2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="-30">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 柱塞2向上运动 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Piston2Transform"
                                          Storyboard.TargetProperty="Y"
                                          Duration="0:0:2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="-30">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0"/>
            </DoubleAnimationUsingKeyFrames>

            <!-- 柱塞3向上运动 -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Piston3Transform"
                                          Storyboard.TargetProperty="Y"
                                          Duration="0:0:2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="-30">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:2" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- 精细金属渐变 - 调整为蓝灰色调 -->
        <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#59020202" Offset="0"/>
            <GradientStop Color="#1F020202" Offset="0.026"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.116"/>
            <GradientStop Color="#4DFFFFFF" Offset="0.498"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.888"/>
            <GradientStop Color="#1F020202" Offset="0.966"/>
            <GradientStop Color="#59020202" Offset="1"/>
        </LinearGradientBrush>

        <!-- 底座渐变 - 蓝灰色调 -->
        <LinearGradientBrush x:Key="BaseGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#33B8C5CC" Offset="0"/>
            <GradientStop Color="#59B8C5CC" Offset="0.264"/>
            <GradientStop Color="#1AB8C5CC" Offset="0.418"/>
            <GradientStop Color="#00FFFFFF" Offset="0.498"/>
            <GradientStop Color="#1AB8C5CC" Offset="0.581"/>
            <GradientStop Color="#59B8C5CC" Offset="0.719"/>
            <GradientStop Color="#B8C5CC" Offset="1"/>
        </LinearGradientBrush>

        <!-- 管道渐变 - 蓝灰金属色 -->
        <LinearGradientBrush x:Key="PipeGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A8B5BC" Offset="0"/>
            <GradientStop Color="#C4CFD6" Offset="0.15"/>
            <GradientStop Color="#DCE4E9" Offset="0.35"/>
            <GradientStop Color="#F4F7F9" Offset="0.5"/>
            <GradientStop Color="#DCE4E9" Offset="0.65"/>
            <GradientStop Color="#C4CFD6" Offset="0.85"/>
            <GradientStop Color="#A8B5BC" Offset="1"/>
        </LinearGradientBrush>

        <!-- 柱塞渐变 - 精细蓝灰金属 -->
        <LinearGradientBrush x:Key="PistonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#B0BCC3" Offset="0"/>
            <GradientStop Color="#D8E0E5" Offset="0.2"/>
            <GradientStop Color="#F0F4F6" Offset="0.4"/>
            <GradientStop Color="#FFFFFF" Offset="0.5"/>
            <GradientStop Color="#F0F4F6" Offset="0.6"/>
            <GradientStop Color="#D8E0E5" Offset="0.8"/>
            <GradientStop Color="#B0BCC3" Offset="1"/>
        </LinearGradientBrush>

        <!-- 气缸渐变 - 深蓝灰金属 -->
        <LinearGradientBrush x:Key="CylinderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#5A6870" Offset="0"/>
            <GradientStop Color="#7A8890" Offset="0.15"/>
            <GradientStop Color="#A0ADB5" Offset="0.35"/>
            <GradientStop Color="#C8D3DA" Offset="0.5"/>
            <GradientStop Color="#A0ADB5" Offset="0.65"/>
            <GradientStop Color="#7A8890" Offset="0.85"/>
            <GradientStop Color="#5A6870" Offset="1"/>
        </LinearGradientBrush>

        <!-- 按钮样式 - 优化版 -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 按钮背景 -->
                            <Ellipse x:Name="ButtonBg" Opacity="0.08">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="#E8EEF1" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                                    BlurRadius="8" ShadowDepth="3" Direction="315"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <!-- 按钮边框 -->
                            <Ellipse Stroke="White" StrokeThickness="2.5" Margin="1" Opacity="0.9"/>
                            <!-- 内圈高光 -->
                            <Ellipse Margin="4" Opacity="0.15">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Opacity" Value="0.25"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 电源按钮专用样式 -->
        <Style x:Key="PowerButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 按钮背景 - 白色半透明 -->
                            <Ellipse x:Name="ButtonBg" Fill="#FFFFFFFF">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#2A4A68" Opacity="0.2" 
                                            BlurRadius="8" ShadowDepth="3" Direction="315"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <!-- 按钮边框 -->
                            <Ellipse Stroke="White" StrokeThickness="2.5" Margin="1" Opacity="0.5"/>
                            <!-- 内圈高光 -->
                            <Ellipse Margin="4" Opacity="0.08">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FFFFFF" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBg" Property="Fill" Value="#F5FAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBg" Property="Fill" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

