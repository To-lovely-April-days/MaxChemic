<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.PistonPumpControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500" 
             d:DesignWidth="470"
             Width="470" Height="500"
             Background="Transparent"
             Cursor="SizeAll"
             ClipToBounds="False"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified"
             RenderOptions.CachingHint="Cache">

    <UserControl.CacheMode>
        <BitmapCache RenderAtScale="1.0" 
                     SnapsToDevicePixels="True" 
                     EnableClearType="False"/>
    </UserControl.CacheMode>

    <UserControl.Resources>
        <!-- 停止状态外壳渐变(蓝灰) -->
        <LinearGradientBrush x:Key="StoppedShellGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#8A98A8" Offset="0"/>
            <GradientStop Color="#96A4B2" Offset="0.15"/>
            <GradientStop Color="#A2B0BE" Offset="0.35"/>
            <GradientStop Color="#AEBCC8" Offset="0.5"/>
            <GradientStop Color="#A2B0BE" Offset="0.65"/>
            <GradientStop Color="#96A4B2" Offset="0.85"/>
            <GradientStop Color="#8A98A8" Offset="1"/>
        </LinearGradientBrush>

        <!-- 运行状态外壳渐变(蓝绿) -->
        <LinearGradientBrush x:Key="RunningShellGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7FB89D" Offset="0"/>
            <GradientStop Color="#9AC9B3" Offset="0.15"/>
            <GradientStop Color="#B5D9C8" Offset="0.35"/>
            <GradientStop Color="#CFE8DC" Offset="0.5"/>
            <GradientStop Color="#B5D9C8" Offset="0.65"/>
            <GradientStop Color="#9AC9B3" Offset="0.85"/>
            <GradientStop Color="#7FB89D" Offset="1"/>
        </LinearGradientBrush>

        <!-- LCD背光渐变 -->
        <LinearGradientBrush x:Key="LcdGradient" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#2848A0" Offset="0"/>
            <GradientStop Color="#1A3078" Offset="1"/>
        </LinearGradientBrush>

        <!-- 金属光泽覆盖 -->
        <LinearGradientBrush x:Key="MetalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#59020202" Offset="0"/>
            <GradientStop Color="#1F020202" Offset="0.026"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.116"/>
            <GradientStop Color="#3DFFFFFF" Offset="0.498"/>
            <GradientStop Color="#1FFFFFFF" Offset="0.888"/>
            <GradientStop Color="#1F020202" Offset="0.966"/>
            <GradientStop Color="#59020202" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Canvas Background="Transparent">

        <!-- 可拖拽区域 -->
        <Rectangle x:Name="DraggableArea"
                   Canvas.Left="0" Canvas.Top="0"
                   Width="470" Height="500"
                   Fill="Transparent"
                   Panel.ZIndex="0"
                   Cursor="SizeAll"
                   MouseDown="OnDraggableAreaMouseDown"
                   MouseMove="OnDraggableAreaMouseMove"
                   MouseUp="OnDraggableAreaMouseUp"
                   MouseLeave="OnDraggableAreaMouseLeave"/>

        <!-- 提手 -->
        <Path Stroke="#B0ACA4" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Fill="Transparent" Panel.ZIndex="1">
            <Path.Data>
                <PathGeometry Figures="M 195,10 Q 195,-10 235,-10 Q 275,-10 275,10"/>
            </Path.Data>
        </Path>

        <!-- 顶面 -->
        <Path Fill="#A8B4C0" Stroke="#8090A0" StrokeThickness="0.6" Panel.ZIndex="2">
            <Path.Data>
                <PathGeometry Figures="M 52,10 L 413,10 L 447,51 L 23,51 Z"/>
            </Path.Data>
        </Path>
        <Path Fill="White" Opacity="0.15" IsHitTestVisible="False" Panel.ZIndex="2">
            <Path.Data>
                <PathGeometry Figures="M 57,14 L 232,14 L 212,47 L 27,47 Z"/>
            </Path.Data>
        </Path>
        <Line X1="52" Y1="10" X2="23" Y2="51" Stroke="#8090A0" StrokeThickness="0.4" Opacity="0.4" Panel.ZIndex="2"/>
        <Line X1="413" Y1="10" X2="447" Y2="51" Stroke="#8090A0" StrokeThickness="0.4" Opacity="0.4" Panel.ZIndex="2"/>
        <Line X1="52" Y1="10" X2="413" Y2="10" Stroke="#8090A0" StrokeThickness="0.4" Opacity="0.25" Panel.ZIndex="2"/>

        <!-- 机身 -->
        <Canvas x:Name="MainBodyGroup" Panel.ZIndex="3">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="ShellShakeTransform" X="0" Y="0"/>
            </Canvas.RenderTransform>

            <Path x:Name="PumpShell" Fill="{StaticResource StoppedShellGradient}" 
                  Stroke="#6A7A8A" StrokeThickness="0.7" Panel.ZIndex="3">
                <Path.Data>
                    <PathGeometry Figures="M 23,51 L 447,51 L 460,450 Q 462,475 440,475 L 30,475 Q 8,475 10,450 Z"/>
                </Path.Data>
                <Path.Effect>
                    <DropShadowEffect x:Name="ShellGlow" 
                                      Color="Transparent" Opacity="0.8" BlurRadius="0" ShadowDepth="0"
                                      RenderingBias="Performance"/>
                </Path.Effect>
            </Path>

            <!-- 金属覆盖 -->
            <Path Fill="{StaticResource MetalBrush}" Panel.ZIndex="3">
                <Path.Data>
                    <PathGeometry Figures="M 23,51 L 447,51 L 460,450 Q 462,475 440,475 L 30,475 Q 8,475 10,450 Z"/>
                </Path.Data>
            </Path>

            <!-- 左高光 -->
            <Path Fill="White" Opacity="0.1" IsHitTestVisible="False" Panel.ZIndex="3">
                <Path.Data>
                    <PathGeometry Figures="M 25,53 L 12,448 Q 10,473 32,473 L 48,473 L 43,53 Z"/>
                </Path.Data>
            </Path>
            <!-- 右暗影 -->
            <Path Fill="#384858" Opacity="0.06" IsHitTestVisible="False" Panel.ZIndex="3">
                <Path.Data>
                    <PathGeometry Figures="M 445,53 L 458,448 Q 460,473 442,473 L 434,473 L 437,53 Z"/>
                </Path.Data>
            </Path>

            <!-- 不锈钢边框 -->
            <Rectangle Canvas.Left="35" Canvas.Top="60" Width="399" Height="410" 
                       RadiusX="6" RadiusY="6"
                       Fill="Transparent" Stroke="#728292" StrokeThickness="1" Opacity="0.35" Panel.ZIndex="4"/>

            <!-- 品牌区 -->
            <Rectangle Canvas.Left="44" Canvas.Top="69" Width="382" Height="27" 
                       RadiusX="3" RadiusY="3" Fill="#A0B0BE" Panel.ZIndex="4"/>
            <TextBlock Canvas.Left="62" Canvas.Top="74" 
                       Text="LongerPump®" FontFamily="Arial" FontSize="11" FontWeight="Bold"
                       Foreground="#E0E8F0" Opacity="0.8" Panel.ZIndex="5"/>
            <TextBlock Canvas.Left="355" Canvas.Top="74"
                       Text="BT100-1L" FontFamily="Arial" FontSize="12" FontWeight="Bold"
                       Foreground="#D0D8E0" Opacity="0.6" Panel.ZIndex="5"/>

            <!-- LCD大屏 -->
            <Rectangle Canvas.Left="52" Canvas.Top="105" Width="246" Height="141"
                       RadiusX="6" RadiusY="6"
