                       Foreground="#2A3A4A" TextAlignment="Center" Panel.ZIndex="6"/>
            <Button Canvas.Left="340" Canvas.Top="290" Width="30" Height="30"
                    Background="Transparent" BorderThickness="0" Opacity="0"
                    Panel.ZIndex="99" Cursor="Hand" Click="OnIncreaseButtonClick"/>

            <Ellipse Canvas.Left="384" Canvas.Top="290" Width="30" Height="30"
