            <TextBlock Canvas.Left="270" Canvas.Top="132"
                       Text="rpm" FontFamily="Times New Roman" FontSize="14"
                       Foreground="#C0D8F0" Panel.ZIndex="6"/>
            <TextBlock Canvas.Left="82" Canvas.Top="206"
                       Text="Flow: 25.4 mL/min" FontFamily="Arial" FontSize="11"
                       Foreground="#90B8D8" Panel.ZIndex="6"/>

            <!-- 旋钮 -->
            <Ellipse Canvas.Left="337" Canvas.Top="117" Width="68" Height="68"
