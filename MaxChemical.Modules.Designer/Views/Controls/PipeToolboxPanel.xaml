<!-- Views/Controls/PipeToolboxPanel.xaml -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.PipeToolboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             x:Name="RootControl">

    <!-- 使用Grid作为根容器 -->
    <Grid>
        <!-- 展开状态的工具箱 -->
        <Border x:Name="ExpandedPanel"
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1"
                CornerRadius="5"
                Width="160"
                Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" 
                        Background="#F8F9FA" 
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        CornerRadius="5,5,0,0">
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PipelineLibraryTitle}"
                                   ToolTip="{Binding RelativeSource={RelativeSource Mode=Self},Path=Text}"
                                   FontSize="13" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <!-- 收缩按钮 -->
                        <Button x:Name="CollapseButton"
                                Grid.Column="1"
                                Content="◀"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"
                                Click="OnCollapseClick"
                                ToolTip="{Binding FoldTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="3"
                                                        Padding="4">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                    VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E0E0E0"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- 组件列表 -->
                <StackPanel Grid.Row="1" Margin="10">

                    <!-- 直管道 -->
                    <Border Background="#F5F5F5" 
                            Padding="10" 
                            Margin="0,0,0,8"
                            CornerRadius="3"
                            Cursor="Hand"
                            MouseDown="OnStraightPipeMouseDown"
                            MouseEnter="OnToolboxItemMouseEnter"
                            MouseLeave="OnToolboxItemMouseLeave">
                        <StackPanel>
                            <TextBlock Text="{Binding StraightPipe}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,4"/>
                            <local:StraightPipeControl Width="70" 
                                                       Height="22" 
                                                       IsHitTestVisible="False"/>
                        </StackPanel>
                    </Border>

                    <!-- 弯管道 -->
                    <Border Background="#F5F5F5" 
                            Padding="10" 
                            Margin="0,0,0,8"
                            CornerRadius="3"
                            Cursor="Hand"
                            MouseDown="OnElbowPipeMouseDown"
                            MouseEnter="OnToolboxItemMouseEnter"
                            MouseLeave="OnToolboxItemMouseLeave">
                        <StackPanel>
                            <TextBlock Text="{Binding ElbowPipe}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,4"/>
                            <local:ElbowPipeControl Width="45" 
                                                   Height="45" 
                                                   IsHitTestVisible="False"
                                                   HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Z字形管道 -->
                    <Border Background="#F5F5F5" 
                            Padding="10" 
                            Margin="0,0,0,0"
                            CornerRadius="3"
                            Cursor="Hand"
                            MouseDown="OnZShapePipeMouseDown"
                            MouseEnter="OnToolboxItemMouseEnter"
                            MouseLeave="OnToolboxItemMouseLeave">
                        <StackPanel>
                            <TextBlock Text="{Binding ZShapePipe}" 
                                       FontSize="11" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,4"/>
                            <local:ZShapePipeControl Width="80" 
                                                    Height="50" 
                                                    IsHitTestVisible="False"
                                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- 三角通 -->
                    <Border Background="#F5F5F5" 
        Padding="10" 
        Margin="0,0,0,8"
        CornerRadius="3"
        Cursor="Hand"
        MouseDown="OnTShapePipeMouseDown"
        MouseEnter="OnToolboxItemMouseEnter"
        MouseLeave="OnToolboxItemMouseLeave">
                        <StackPanel>
                            <TextBlock Text="{Binding TShapePipe}" 
                   FontSize="11" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,4"/>
                            <local:TShapePipeControl Width="80" 
                                Height="70" 
                                IsHitTestVisible="False"
                                HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 收缩状态的按钮 -->
        <Border x:Name="CollapsedPanel"
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1"
                CornerRadius="5"
                Width="40"
                Height="100"
                Visibility="Collapsed"
                Cursor="Hand"
                MouseDown="OnExpandClick">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>

            <Grid>
                <TextBlock Text="{Binding ExpandLabel}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#666">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>

                <TextBlock Text="▶"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"
                           Foreground="#999"/>
            </Grid>
        </Border>
    </Grid>

</UserControl>