<!-- Views/Controls/PipeToolboxPanel.xaml -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.Controls.PipeToolboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             Width="150">

    <Border Background="White" 
            BorderBrush="#E0E0E0" 
            BorderThickness="1"
            CornerRadius="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
        </Border.Effect>

        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">
                <!-- 标题 -->
                <TextBlock Text="管道组件库" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Separator Margin="0,0,0,10"/>

                <!-- 直管道 -->
                <Border Background="#F5F5F5" 
                        Padding="10" 
                        Margin="0,0,0,10"
                        CornerRadius="3"
                        Cursor="Hand"
                        MouseDown="OnStraightPipeMouseDown"
                        MouseEnter="OnToolboxItemMouseEnter"
                        MouseLeave="OnToolboxItemMouseLeave">
                    <StackPanel>
                        <TextBlock Text="直管道" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,5"/>
                        <!-- 只改预览尺寸：从 120x40 改为 80x25 -->
                        <local:StraightPipeControl Width="80" 
                                                   Height="25" 
                                                   IsHitTestVisible="False"/>
                        <TextBlock Text="拖拽到画布使用" 
                                   FontSize="10" 
                                   Foreground="Gray" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 弯管道 -->
                <Border Background="#F5F5F5" 
                        Padding="10" 
                        Margin="0,0,0,10"
                        CornerRadius="3"
                        Cursor="Hand"
                        MouseDown="OnElbowPipeMouseDown"
                        MouseEnter="OnToolboxItemMouseEnter"
                        MouseLeave="OnToolboxItemMouseLeave">
                    <StackPanel>
                        <TextBlock Text="弯管道 (90°)" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,5"/>
                        <!-- 只改预览尺寸：从 80x80 改为 50x50 -->
                        <local:ElbowPipeControl Width="50" 
                                               Height="50" 
                                               IsHitTestVisible="False"
                                               HorizontalAlignment="Center"/>
                        <TextBlock Text="拖拽到画布使用" 
                                   FontSize="10" 
                                   Foreground="Gray" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Z字形管道 -->
                <Border Background="#F5F5F5" 
                        Padding="10" 
                        Margin="0,0,0,10"
                        CornerRadius="3"
                        Cursor="Hand"
                        MouseDown="OnZShapePipeMouseDown"
                        MouseEnter="OnToolboxItemMouseEnter"
                        MouseLeave="OnToolboxItemMouseLeave">
                    <StackPanel>
                        <TextBlock Text="Z字形管道" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,5"/>
                        <!-- 只改预览尺寸：从 120x100 改为 90x60 -->
                        <local:ZShapePipeControl Width="90" 
                                                Height="60" 
                                                IsHitTestVisible="False"
                                                HorizontalAlignment="Center"/>
                        <TextBlock Text="拖拽到画布使用" 
                                   FontSize="10" 
                                   Foreground="Gray" 
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 将来可以添加更多管道类型 -->
                <TextBlock Text="更多组件..." 
                           FontSize="11" 
                           Foreground="#999"
                           FontStyle="Italic"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>

                <!-- 占位符：三通管道 -->
                <Border Background="#FAFAFA" 
                        Padding="10" 
                        Margin="0,10,0,10"
                        CornerRadius="3"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Opacity="0.5">
                    <StackPanel>
                        <TextBlock Text="三通管道" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="即将推出..." 
                                   FontSize="10" 
                                   Foreground="Gray" 
                                   HorizontalAlignment="Center"
                                   Margin="0,10"/>
                    </StackPanel>
                </Border>

                <!-- 占位符：阀门 -->
                <Border Background="#FAFAFA" 
                        Padding="10" 
                        Margin="0,0,0,10"
                        CornerRadius="3"
                        BorderBrush="#DDD"
                        BorderThickness="1"
                        Opacity="0.5">
                    <StackPanel>
                        <TextBlock Text="阀门" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="即将推出..." 
                                   FontSize="10" 
                                   Foreground="Gray" 
                                   HorizontalAlignment="Center"
                                   Margin="0,10"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>