<Window x:Class="MaxChemical.Modules.Designer.Views.CountdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="等待倒计时"
        Width="380" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="False">

    <Window.Resources>
        <ControlTemplate x:Key="BtnTpl" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                    Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" Background="White" BorderBrush="#E8E8E8" BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="4" Direction="270" BlurRadius="20" Color="#000000" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 主内容区 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="28,24,28,0">

                <!-- 圆环进度条 -->
                <Grid Width="110" Height="110" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <!-- 背景圆环 -->
                    <Ellipse Width="110" Height="110"
                             Stroke="#F0F0F0" StrokeThickness="5"
                             Fill="Transparent"/>
                    <!-- 进度圆环（通过 code-behind 设置 StrokeDashArray 和 StrokeDashOffset） -->
                    <Ellipse x:Name="ProgressRing"
                             Width="110" Height="110"
                             Stroke="#1565C0" StrokeThickness="5"
                             StrokeDashCap="Round"
                             Fill="Transparent"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-90"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <!-- 中间倒计时文字 -->
                    <TextBlock x:Name="CountdownText"
                               Text="05:00"
                               FontSize="26" FontWeight="Medium"
                               Foreground="#212121" FontFamily="Consolas"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- 标题 -->
                <TextBlock Name="TbFixedLabel" Text="固定时间等待"
                           FontSize="14" FontWeight="Medium" Foreground="#212121"
                           HorizontalAlignment="Center" Margin="0,0,0,3"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="220"/>

                <!-- 等待信息 -->
                <TextBlock x:Name="WaitInfoText"
                           Text="正在等待..."
                           FontSize="11" Foreground="#9E9E9E"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <!-- 隐藏的 ProgressBar（保留兼容，不显示） -->
                <ProgressBar x:Name="CountdownProgress"
                             Height="0" Width="0" Visibility="Collapsed"
                             Background="#E5E5E5" Foreground="#1565C0" BorderThickness="0"/>
            </StackPanel>

            <!-- 按钮 -->
            <Grid Grid.Row="1" Margin="28,12,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="StopButton" Grid.Column="0"
                        Content="停止流程"
                        Background="Transparent" Foreground="#EF5350"
                        BorderBrush="#FFCDD2" BorderThickness="1"
                        Style="{StaticResource ButtonStyle}"
                        Click="StopButton_Click"/>
                <Button x:Name="SkipButton" Grid.Column="2"
                        Content="跳过等待"
                        Background="#1565C0" Foreground="White"
                        BorderThickness="0"
                        Style="{StaticResource ButtonStyle}"
                        Click="SkipButton_Click"/>
            </Grid>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="8"
                    CornerRadius="0,0,14,14" Background="#F8FBFF"
                    BorderBrush="#E3F2FD" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="#1565C0"
                             VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="倒计时进行中"
                               FontSize="10" Foreground="#1565C0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
