<Window x:Class="MaxChemical.Modules.Designer.Views.CountdownDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="等待倒计时" 
        Width="400" Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#FAFBFC"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="CountdownTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#186DF5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#186DF5" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="20" Height="20" Fill="White" Margin="0,0,12,0"/>
                <TextBlock Text="固定时间等待" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 倒计时显示 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock x:Name="WaitInfoText"
                       Text="正在等待..."
                       FontSize="14"
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <TextBlock x:Name="CountdownText"
                       Text="05:00"
                       Style="{StaticResource CountdownTextStyle}"/>

            <!-- 进度条 -->
            <ProgressBar x:Name="CountdownProgress"
                         Height="8"
                         Width="300"
                         Margin="0,24,0,0"
                         Background="#E5E5E5"
                         Foreground="#186DF5"
                         BorderThickness="0"/>
        </StackPanel>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0">
            <Button x:Name="SkipButton"
                    Content="跳过等待"
                    Background="#6CB6FF"
                    Foreground="White"
                    BorderThickness="0"
                    Style="{StaticResource ButtonStyle}"
                    Click="SkipButton_Click"/>

            <Button x:Name="StopButton"
                    Content="停止流程"
                    Background="#F44336"
                    Foreground="White"
                    BorderThickness="0"
                    Style="{StaticResource ButtonStyle}"
                    Click="StopButton_Click"/>
        </StackPanel>

        <!-- 底部信息 -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="16,8">
            <TextBlock x:Name="StatusText"
                       Text="等待时间可以通过上方按钮进行控制"
                       FontSize="11"
                       Foreground="#666666"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>