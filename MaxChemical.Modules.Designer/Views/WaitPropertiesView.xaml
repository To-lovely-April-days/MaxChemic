<UserControl x:Class="MaxChemical.Modules.Designer.Views.WaitPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <local:StringEqualityConverter x:Key="StrEqConverter"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpPillStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" HorizontalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="FieldComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0,28,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0" Stroke="#9E9E9E" StrokeThickness="1.5"
                                          Fill="Transparent" Width="10" Height="5"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                          StrokeLineJoin="Round" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0" Opacity="0"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="200">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2" Direction="270" BlurRadius="8" Color="#000000" Opacity="0.08"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 5 L 5 0 L 10 5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#212121"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,2">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox -->
        <Style x:Key="FieldCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBd" Width="16" Height="16"
                                    BorderBrush="#BDBDBD" BorderThickness="1.5" CornerRadius="4"
                                    Background="White" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 2 8 L 6 12 L 14 4"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBd" Property="Background" Value="#2196F3"/>
                                <Setter TargetName="CheckBd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBd" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ThinScrollViewerStyle}">
            <StackPanel Margin="10">

                <!-- ══ Header ══ -->
                <Border Padding="14,12" Background="#F5F5F5"
                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="38" Height="38" CornerRadius="10"
                                    Background="White" Margin="0,0,10,0">
                                <Image Source="pack://siteoforigin:,,,/Resources/CommadIcon/Bezel-lessDelay.png"
                                       Width="24" Height="24" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Name="NodeTitle" Text="等待" FontSize="15" FontWeight="Medium"
                                       Foreground="#212121" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="10" Padding="6,2"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    Background="White" Margin="0,0,6,0">
                                <TextBlock Text="Wait" FontSize="11" Foreground="#757575"/>
                            </Border>
                            <Border CornerRadius="10" Padding="6,2"
                                    BorderBrush="#E0E0E0" BorderThickness="1" Background="White">
                                <TextBlock Text="暂停执行" FontSize="11" Foreground="#757575"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ 基本信息卡片 ══ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="NodeInfoTitle" Text="基本信息" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <TextBlock Name="NodeNameLabel" Text="名称" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NodeNameBox"
                                 Style="{StaticResource FieldInputStyle}"
                                 Margin="0,0,0,10"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnValueChanged"/>

                        <TextBlock Name="NodeDescLabel" Text="描述" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="DescriptionBox"
                                 Height="60" Padding="9,6" FontSize="13"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 BorderBrush="#E0E0E0" BorderThickness="1"
                                 Background="#FAFAFA" Foreground="#212121"
                                 Text="{Binding LogicCommand.Properties[Description], UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnValueChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- ══ 等待模式卡片 ══ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="NodeModeTitle" Text="等待模式" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>
                        <Border Background="#F3F4F6" CornerRadius="7" Padding="3">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="FixedTimeRadio"
                                             Content="固定时间"
                                             GroupName="WaitMode"
                                             Style="{StaticResource OpPillStyle}"
                                             IsChecked="True"
                                             Checked="WaitMode_Changed"/>
                                <RadioButton x:Name="ConditionRadio"
                                             Content="条件等待"
                                             GroupName="WaitMode"
                                             Style="{StaticResource OpPillStyle}"
                                             Checked="WaitMode_Changed"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 执行模式卡片（仅条件等待时显示）══ -->
                <Border x:Name="ExecutionModeGroup"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="ExecuteModeTitle" Text="执行模式" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>
                        <Border Background="#F3F4F6" CornerRadius="7" Padding="3">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="SynchronousRadio"
                                             Content="同步（阻塞）"
                                             GroupName="ExecutionMode"
                                             Style="{StaticResource OpPillStyle}"
                                             IsChecked="True"
                                             Checked="ExecutionMode_Changed"/>
                                <RadioButton x:Name="AsynchronousRadio"
                                             Content="异步（后台）"
                                             GroupName="ExecutionMode"
                                             Style="{StaticResource OpPillStyle}"
                                             Checked="ExecutionMode_Changed"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 固定时间配置卡片 ══ -->
                <Border x:Name="FixedTimeGroup" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="NodeTimeTitle" Text="时间配置" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <TextBlock Name="NodeWaitLabel" Text="等待时长" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="WaitTimeTextBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,6,0"
                                     Text="{Binding LogicCommand.Properties[WaitTime], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <ComboBox Grid.Column="1"
                                      x:Name="TimeUnitCombo"
                                      Style="{StaticResource FieldComboStyle}"
                                      SelectedValue="{Binding LogicCommand.Properties[TimeUnit], UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="OnValueChanged">
                                <ComboBoxItem Content="毫秒" Tag="Milliseconds"/>
                                <ComboBoxItem Content="秒"   Tag="Seconds"/>
                                <ComboBoxItem Content="分钟" Tag="Minutes"/>
                                <ComboBoxItem Content="小时" Tag="Hours"/>
                            </ComboBox>
                        </Grid>
                        <!-- ★ 新增：等待稳定选项 -->
                        <Border Margin="0,12,0,0" Padding="10,8"
        Background="#F0F7FF" BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <CheckBox x:Name="WaitForStabilityCheckBox"
                  Style="{StaticResource FieldCheckBoxStyle}"
                  Content="等待设备稳定后再开始计时"
                  IsChecked="{Binding LogicCommand.Properties[WaitForStability], UpdateSourceTrigger=PropertyChanged}"
                  Checked="WaitForStability_Changed" Unchecked="WaitForStability_Changed"/>
                                <TextBlock Text="勾选后，节点会先等待选定设备进入稳定状态，再开始倒计时"
                   FontSize="10" Foreground="#1565C0" Margin="24,4,0,8"
                   TextWrapping="Wrap"/>

                                <!-- 设备多选区 -->
                                <StackPanel x:Name="StabilityDevicesPanel" Margin="24,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="参与稳定的设备" Style="{StaticResource FieldLabelStyle}" Margin="0,4,0,5"/>
                                    <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" 
                    Background="White" Padding="8" MinHeight="60">
                                        <ItemsControl x:Name="StabilityDevicesList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource FieldCheckBoxStyle}"
                                      Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      Checked="StabilityDevice_Changed" 
                                      Unchecked="StabilityDevice_Changed"
                                      Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <TextBlock Text="稳定超时（秒）" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,5"/>
                                    <TextBox x:Name="StabilityTimeoutTextBox"
                     Style="{StaticResource FieldInputStyle}"
                     Text="{Binding LogicCommand.Properties[StabilityTimeoutSeconds], UpdateSourceTrigger=PropertyChanged}"
                     TextChanged="OnValueChanged"/>
                                    <TextBlock Text="超过此时间仍未全部稳定将报错" 
                       FontSize="10" Foreground="#9E9E9E" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 条件等待配置卡片 ══ -->
                <Border x:Name="ConditionGroup"
                        Style="{StaticResource CardStyle}"
                        Visibility="Visible">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="WaitConditionTitle" Text="等待条件" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <!-- 左侧变量 -->
                        <TextBlock Name="LeftVariableLabel" Text="左侧变量" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="ConditionLeftVariableTextBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,6,0"
                                     Text="{Binding LogicCommand.Properties[ConditionLeftVariable], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <Button Name="SelectVarLabel" Grid.Column="1"
                                    Content="选择变量"
                                    Style="{StaticResource VarButtonStyle}"
                                    Width="72"
                                    Click="SelectLeftVariable_Click"/>
                        </Grid>

                        <!-- 操作符（隐藏 ComboBox 保持数据绑定） -->
                        <ComboBox x:Name="ConditionOperatorCombo"
                                  Visibility="Collapsed"
                                  SelectedValue="{Binding LogicCommand.Properties[ConditionOperator], UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="OnValueChanged">
                            <ComboBoxItem Tag="Equals"/>
                            <ComboBoxItem Tag="NotEquals"/>
                            <ComboBoxItem Tag="GreaterThan"/>
                            <ComboBoxItem Tag="LessThan"/>
                            <ComboBoxItem Tag="GreaterThanOrEqual"/>
                            <ComboBoxItem Tag="LessThanOrEqual"/>
                            <ComboBoxItem Tag="IsTrue"/>
                            <ComboBoxItem Tag="IsFalse"/>
                            <ComboBoxItem Tag="IsEmpty"/>
                            <ComboBoxItem Tag="IsNotEmpty"/>
                            <ComboBoxItem Tag="Contains"/>
                            <ComboBoxItem Tag="NotContains"/>
                        </ComboBox>

                        <!-- 比较符分段选择器 -->
                        <TextBlock Name="OperatorLabel" Text="比较符" Style="{StaticResource FieldLabelStyle}"/>
                        <Border Background="#F3F4F6" CornerRadius="7" Padding="3" Margin="0,0,0,10">
                            <UniformGrid Rows="1">
                                <RadioButton Content="="
                                             GroupName="WaitOpGroup" Style="{StaticResource OpPillStyle}"
                                             IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                                                 Converter={StaticResource StrEqConverter}, ConverterParameter=Equals,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Checked="OnValueChanged"/>
                                <RadioButton Content="≠"
                                             GroupName="WaitOpGroup" Style="{StaticResource OpPillStyle}"
                                             IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                                                 Converter={StaticResource StrEqConverter}, ConverterParameter=NotEquals,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Checked="OnValueChanged"/>
                                <RadioButton Content="&gt;"
                                             GroupName="WaitOpGroup" Style="{StaticResource OpPillStyle}"
                                             IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                                                 Converter={StaticResource StrEqConverter}, ConverterParameter=GreaterThan,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Checked="OnValueChanged"/>
                                <RadioButton Content="&lt;"
                                             GroupName="WaitOpGroup" Style="{StaticResource OpPillStyle}"
                                             IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                                                 Converter={StaticResource StrEqConverter}, ConverterParameter=LessThan,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Checked="OnValueChanged"/>
                                <RadioButton Content="≥"
                                             GroupName="WaitOpGroup" Style="{StaticResource OpPillStyle}"
                                             IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                                                 Converter={StaticResource StrEqConverter}, ConverterParameter=GreaterThanOrEqual,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Checked="OnValueChanged"/>
                                <RadioButton Content="≤"
                                             GroupName="WaitOpGroup" Style="{StaticResource OpPillStyle}"
                                             IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                                                 Converter={StaticResource StrEqConverter}, ConverterParameter=LessThanOrEqual,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             Checked="OnValueChanged"/>
                            </UniformGrid>
                        </Border>

                        <!-- 右侧值 -->
                        <TextBlock Name="RightValueLabel" Text="右侧值" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="ConditionRightValueTextBox"
                                 Style="{StaticResource FieldInputStyle}"
                                 Margin="0,0,0,10"
                                 Text="{Binding LogicCommand.Properties[ConditionRightValue], UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnValueChanged"/>

                        <!-- 检查间隔 -->
                        <TextBlock Name="CheckedIntervalLabel" Text="检查间隔" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="CheckIntervalTextBox"
                                     Style="{StaticResource FieldInputStyle}" Margin="0,0,8,0"
                                     Text="{Binding LogicCommand.Properties[CheckIntervalSeconds], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <TextBlock Name="IntervalLabel" Grid.Column="1" Text="秒" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#757575"/>
                        </Grid>

                        <!-- 超时设置 -->
                        <TextBlock Name="TimeoutSetLabel" Text="超时设置" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox x:Name="IsInfiniteTimeoutCheckBox"
                                  Style="{StaticResource FieldCheckBoxStyle}"
                                  Content="无限超时（一直等待直到条件满足）"
                                  IsChecked="{Binding LogicCommand.Properties[IsInfiniteTimeout], UpdateSourceTrigger=PropertyChanged}"
                                  Checked="OnValueChanged" Unchecked="OnValueChanged"/>

                        <Grid x:Name="TimeoutInputGroup">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TimeoutTextBox"
                                     Style="{StaticResource FieldInputStyle}" Margin="0,0,8,0"
                                     Text="{Binding LogicCommand.Properties[TimeoutSeconds], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <TextBlock Name="TimeoutLabel" Grid.Column="1" Text="秒" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#757575"/>
                        </Grid>

                        <!--  新增：警告模式开关  -->
                        <Border Margin="0,12,0,0" Padding="10,8"
                                Background="#FFF8F0" BorderBrush="#FFE0B2" BorderThickness="1" CornerRadius="6">
                            <StackPanel>
                                <CheckBox x:Name="IsWarningCheckBox"
                                          Style="{StaticResource FieldCheckBoxStyle}"
                                          Content="警告模式（橙色警告弹框）"
                                          Checked="IsWarning_Changed" Unchecked="IsWarning_Changed"/>
                                <TextBlock Name="IsWarningTblock" Text="开启后条件满足时显示橙色警告弹框，需人工确认后继续"
                                           FontSize="10" Foreground="#BF360C" Margin="24,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 预览卡片 ══ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="NodePreviewTitle" Text="预览" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>
                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0"
                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="WaitPreview"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#424242" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 验证提示 ══ -->
                <Border x:Name="ValidationPanel"
                        Background="#FFEBEE" BorderBrush="#EF9A9A" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="#E53935" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ValidationText" Text="配置有误"
                                   FontSize="12" Foreground="#C62828" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ══ 提示卡片 ══ -->
                <Border Background="#E3F2FD" BorderBrush="#BBDEFB"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Name="NodeUseDescTitle" Text="使用说明" FontSize="11" FontWeight="Medium" Foreground="#1565C0"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#1976D2" LineHeight="20" TextWrapping="Wrap">
                            <Run Name="Desc1" Text="• 固定时间：同步阻塞，适合确定等待时长的场景"/>
                            <LineBreak/>
                            <Run Name="Desc2" Text="• 条件等待：循环检查直到条件满足，支持同步/异步"/>
                            <LineBreak/>
                            <Run Name="Desc3" Text="• 警告模式：条件满足时弹出橙色警告弹框，需人工确认"/>
                            <LineBreak/>
                            <Run Name="Desc4" Text="• 左侧变量示例：{temperatureValue}、{isCompleted}"/>
                            <LineBreak/>
                            <Run Name="Desc5" Text="• 右侧值示例：100、true、完成状态"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
