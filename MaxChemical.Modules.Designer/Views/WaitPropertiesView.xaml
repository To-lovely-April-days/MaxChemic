<UserControl x:Class="MaxChemical.Modules.Designer.Views.WaitPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <!-- 保持所有之前的样式资源... -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

        <!-- 配色方案和所有样式保持不变... -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#186DF5"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6CB6FF"/>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SectionBrush" Color="#FAFBFC"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5"/>
        <SolidColorBrush x:Key="FocusBrush" Color="#186DF5"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#333333"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#666666"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#999999"/>

        <!-- 所有样式定义保持不变... -->
        <Style x:Key="MainStyleTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource FocusBrush}"/>
                                <Setter Property="BorderThickness" TargetName="border" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainStyleMultilineTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="72"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Auto"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" TargetName="border" Value="0.56"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource FocusBrush}"/>
                                <Setter Property="BorderThickness" TargetName="border" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainStyleComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0,30,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Grid.Column="2"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="20"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Path x:Name="arrow"
                                                                  Grid.Column="1"
                                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                                  Fill="{StaticResource TextSecondaryBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentPresenter"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsHitTestVisible="false"
                                              Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="true"
                                   Grid.ColumnSpan="2"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                                   Placement="Bottom">
                                <Border x:Name="dropDownBorder"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <Grid x:Name="grid" RenderOptions.ClearTypeHint="Enabled">
                                            <Canvas x:Name="canvas" HorizontalAlignment="Left" Height="0" VerticalAlignment="Top" Width="0">
                                                <Rectangle x:Name="opaqueRect" Fill="{Binding Background, ElementName=dropDownBorder}" Height="{Binding ActualHeight, ElementName=dropDownBorder}" Width="{Binding ActualWidth, ElementName=dropDownBorder}"/>
                                            </Canvas>
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" TargetName="toggleButton" Value="#CCCCCC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" TargetName="toggleButton" Value="{StaticResource FocusBrush}"/>
                                <Setter Property="BorderThickness" TargetName="toggleButton" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainStyleRadioButton" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,16,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MainStyleCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MainStyleButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F5FE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0D52D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainStyleGroupBox" TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 标题区域 -->
                                <Border Grid.Row="0" 
                                        Background="{StaticResource SectionBrush}"
                                        Padding="16,10"
                                        CornerRadius="6,6,0,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>

                                <!-- 内容区域 -->
                                <Border Grid.Row="1"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Background="{StaticResource SectionBrush}">
        <StackPanel Margin="16">

            <!-- 基本信息 -->
            <GroupBox Header="基本信息" Style="{StaticResource MainStyleGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 节点名称 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="名称" 
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="NodeNameBox"
                             Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MainStyleTextBox}"
                             Margin="0,0,0,12"
                             TextChanged="OnValueChanged"/>

                    <!-- 描述 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="描述" 
                               VerticalAlignment="Top"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             x:Name="DescriptionBox"
                             Text="{Binding LogicCommand.Properties[Description], UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MainStyleMultilineTextBox}"
                             TextChanged="OnValueChanged"/>
                </Grid>
            </GroupBox>

            <!-- 等待模式 -->
            <GroupBox Header="等待模式" Style="{StaticResource MainStyleGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <StackPanel>
                    <RadioButton x:Name="FixedTimeRadio"
                                 Content="固定时间等待（同步执行）"
                                 Style="{StaticResource MainStyleRadioButton}"
                                 IsChecked="True"
                                 Checked="WaitMode_Changed"/>
                    <RadioButton x:Name="ConditionRadio"
                                 Content="条件等待（循环检查直到条件满足）"
                                 Style="{StaticResource MainStyleRadioButton}"
                                 Checked="WaitMode_Changed"/>
                </StackPanel>
            </GroupBox>

            <!-- 执行模式 - 只在条件等待时显示 -->
            <GroupBox x:Name="ExecutionModeGroup" Header="执行模式" Style="{StaticResource MainStyleGroupBox}" Visibility="Collapsed">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <StackPanel>
                    <RadioButton x:Name="SynchronousRadio"
                                 Content="同步执行（阻塞后续步骤直到等待完成）"
                                 GroupName="ExecutionMode"
                                 Style="{StaticResource MainStyleRadioButton}"
                                 IsChecked="True"
                                 Checked="ExecutionMode_Changed"/>

                    <RadioButton x:Name="AsynchronousRadio"
                                 Content="异步执行（后台等待，不阻塞后续步骤）"
                                 GroupName="ExecutionMode"
                                 Style="{StaticResource MainStyleRadioButton}"
                                 Checked="ExecutionMode_Changed"/>
                </StackPanel>
            </GroupBox>

            <!-- 固定时间等待配置 -->
            <GroupBox x:Name="FixedTimeGroup" Header="固定时间配置" Style="{StaticResource MainStyleGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="（同步执行）" 
                                       FontSize="12" 
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <!-- 等待时间 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="等待时间*" 
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="WaitTimeTextBox"
                             Text="{Binding LogicCommand.Properties[WaitTime], UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MainStyleTextBox}"
                             Margin="0,0,8,12"
                             TextChanged="OnValueChanged"/>

                    <!-- 时间单位 -->
                    <ComboBox Grid.Row="0" Grid.Column="2"
                              x:Name="TimeUnitCombo"
                              SelectedValue="{Binding LogicCommand.Properties[TimeUnit], UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource MainStyleComboBox}"
                              Margin="0,0,0,12"
                              SelectionChanged="OnValueChanged">
                        <ComboBoxItem Content="毫秒" Tag="Milliseconds"/>
                        <ComboBoxItem Content="秒" Tag="Seconds"/>
                        <ComboBoxItem Content="分钟" Tag="Minutes"/>
                        <ComboBoxItem Content="小时" Tag="Hours"/>
                    </ComboBox>

                    <!-- 提示文本 -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                               Text="固定时间等待会阻塞后续步骤的执行"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
            </GroupBox>

            <!-- 条件等待配置 -->
            <GroupBox x:Name="ConditionGroup" Header="条件等待配置" Style="{StaticResource MainStyleGroupBox}" Visibility="Collapsed">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" 
                                   FontSize="14" 
                                   FontWeight="Medium" 
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 等待条件标题 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" 
                               Text="等待条件*" 
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- 条件组合区域 -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                        <!-- 左侧变量 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="ConditionLeftVariableTextBox"
                                     Text="{Binding LogicCommand.Properties[ConditionLeftVariable], UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MainStyleTextBox}"
                                     Margin="0,0,8,0"
                                     TextChanged="OnValueChanged"/>
                            <Button Grid.Column="1"
                                    Content="选择变量"
                                    Style="{StaticResource MainStyleButton}"
                                    Click="SelectLeftVariable_Click"/>
                        </Grid>

                        <!-- 操作符 -->
                        <ComboBox x:Name="ConditionOperatorCombo"
                                  SelectedValue="{Binding LogicCommand.Properties[ConditionOperator], UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource MainStyleComboBox}"
                                  Margin="0,0,0,8"
                                  SelectionChanged="OnValueChanged">
                            <ComboBoxItem Content="等于" Tag="Equals"/>
                            <ComboBoxItem Content="不等于" Tag="NotEquals"/>
                            <ComboBoxItem Content="大于" Tag="GreaterThan"/>
                            <ComboBoxItem Content="大于等于" Tag="GreaterThanOrEqual"/>
                            <ComboBoxItem Content="小于" Tag="LessThan"/>
                            <ComboBoxItem Content="小于等于" Tag="LessThanOrEqual"/>
                            <ComboBoxItem Content="包含" Tag="Contains"/>
                            <ComboBoxItem Content="不包含" Tag="NotContains"/>
                            <ComboBoxItem Content="为真" Tag="IsTrue"/>
                            <ComboBoxItem Content="为假" Tag="IsFalse"/>
                            <ComboBoxItem Content="为空" Tag="IsEmpty"/>
                            <ComboBoxItem Content="不为空" Tag="IsNotEmpty"/>
                        </ComboBox>

                        <!-- 右侧值 -->
                        <TextBox x:Name="ConditionRightValueTextBox"
                                 Text="{Binding LogicCommand.Properties[ConditionRightValue], UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MainStyleTextBox}"
                                 TextChanged="OnValueChanged"/>
                    </StackPanel>

                    <!-- 检查间隔 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" 
                               Text="检查间隔*" 
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="CheckIntervalTextBox"
                                 Text="{Binding LogicCommand.Properties[CheckIntervalSeconds], UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MainStyleTextBox}"
                                 Margin="0,0,8,0"
                                 TextChanged="OnValueChanged"/>
                        <TextBlock Grid.Column="1"
                                   Text="秒"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>

                    <!-- 超时设置 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" 
                               Text="超时设置" 
                               VerticalAlignment="Top"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                        <CheckBox x:Name="IsInfiniteTimeoutCheckBox"
                                  Content="无限超时（一直等待直到条件满足）"
                                  IsChecked="{Binding LogicCommand.Properties[IsInfiniteTimeout], UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource MainStyleCheckBox}"
                                  Checked="OnValueChanged"
                                  Unchecked="OnValueChanged"/>

                        <Grid x:Name="TimeoutInputGroup">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="TimeoutTextBox"
                                     Text="{Binding LogicCommand.Properties[TimeoutSeconds], UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MainStyleTextBox}"
                                     Margin="0,0,8,0"
                                     TextChanged="OnValueChanged"/>
                            <TextBlock Grid.Column="1"
                                       Text="秒"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 提示文本1 -->
                    <TextBlock Grid.Row="3" Grid.Column="1"
                               Text="左侧变量示例：{temperatureValue}, {isCompleted}"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>

                    <!-- 提示文本2 -->
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               Text="右侧值示例：100, true, 完成状态"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>

                    <!-- 提示文本3 -->
                    <TextBlock Grid.Row="5" Grid.Column="1"
                               Text="条件等待会循环检查条件，每隔指定间隔检查一次"
                               FontSize="11"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

            <!-- 预览 -->
            <GroupBox Header="预览" Style="{StaticResource MainStyleGroupBox}">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" 
                                     Fill="{StaticResource AccentBrush}" 
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding}" 
                                       FontSize="14" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Border Background="#F8FAFF" 
                        BorderBrush="{StaticResource AccentBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="16">
                    <TextBlock x:Name="WaitPreview"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="18"/>
                </Border>
            </GroupBox>

            <!-- 验证提示 -->
            <Border x:Name="ValidationPanel"
                    Background="#FEF2F2" 
                    BorderBrush="#FCA5A5" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="16"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" 
                             Fill="#DC2626" 
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>
                    <TextBlock x:Name="ValidationText"
                               Text="配置有误"
                               FontSize="13"
                               Foreground="#DC2626"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
