<UserControl x:Class="MaxChemical.Modules.Designer.Views.WaitPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <local:StringEqualityConverter x:Key="StrEqConverter"/>
        <!-- 风格B卡片 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- 输入框 -->
        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 变量按钮 -->
        <Style x:Key="VarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#616161"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill RadioButton -->
        <Style x:Key="OpPillStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" HorizontalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#1565C0"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
    </UserControl.Resources>

    <Border Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="10">

                <!-- ══ Header ══ -->
                <Border Padding="14,12" Background="#F5F5F5"
                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="38" Height="38" CornerRadius="10"
                                    Background="White" Margin="0,0,10,0">
                                <Image Source="pack://siteoforigin:,,,/Resources/CommadIcon/Bezel-lessDelay.png"
                                       Width="24" Height="24" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="等待" FontSize="15" FontWeight="Medium"
                                       Foreground="#212121" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="10" Padding="6,2"
                                    BorderBrush="#E0E0E0" BorderThickness="1"
                                    Background="White" Margin="0,0,6,0">
                                <TextBlock Text="Wait" FontSize="11" Foreground="#757575"/>
                            </Border>
                            <Border CornerRadius="10" Padding="6,2"
                                    BorderBrush="#E0E0E0" BorderThickness="1" Background="White">
                                <TextBlock Text="暂停执行" FontSize="11" Foreground="#757575"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══ 基本信息卡片 ══ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="基本信息" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <TextBlock Text="名称" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="NodeNameBox"
                                 Style="{StaticResource FieldInputStyle}"
                                 Margin="0,0,0,10"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnValueChanged"/>

                        <TextBlock Text="描述" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="DescriptionBox"
                                 Height="60"
                                 Padding="9,6"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 BorderBrush="#E0E0E0" BorderThickness="1"
                                 Background="#FAFAFA" Foreground="#212121"
                                 Text="{Binding LogicCommand.Properties[Description], UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnValueChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </StackPanel>
                </Border>

                <!-- ══ 等待模式卡片 ══ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="等待模式" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>
                        <Border Background="#F3F4F6" CornerRadius="7" Padding="3">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="FixedTimeRadio"
                                             Content="固定时间"
                                             GroupName="WaitMode"
                                             Style="{StaticResource OpPillStyle}"
                                             IsChecked="True"
                                             Checked="WaitMode_Changed"/>
                                <RadioButton x:Name="ConditionRadio"
                                             Content="条件等待"
                                             GroupName="WaitMode"
                                             Style="{StaticResource OpPillStyle}"
                                             Checked="WaitMode_Changed"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 执行模式卡片（仅条件等待时显示）══ -->
                <Border x:Name="ExecutionModeGroup"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="执行模式" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>
                        <Border Background="#F3F4F6" CornerRadius="7" Padding="3">
                            <UniformGrid Rows="1">
                                <RadioButton x:Name="SynchronousRadio"
                                             Content="同步（阻塞）"
                                             GroupName="ExecutionMode"
                                             Style="{StaticResource OpPillStyle}"
                                             IsChecked="True"
                                             Checked="ExecutionMode_Changed"/>
                                <RadioButton x:Name="AsynchronousRadio"
                                             Content="异步（后台）"
                                             GroupName="ExecutionMode"
                                             Style="{StaticResource OpPillStyle}"
                                             Checked="ExecutionMode_Changed"/>
                            </UniformGrid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 固定时间配置卡片 ══ -->
                <Border x:Name="FixedTimeGroup" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="时间配置" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <TextBlock Text="等待时长" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="WaitTimeTextBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,6,0"
                                     Text="{Binding LogicCommand.Properties[WaitTime], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <ComboBox Grid.Column="1"
                                      x:Name="TimeUnitCombo"
                                      Style="{StaticResource FieldComboStyle}"
                                      SelectedValue="{Binding LogicCommand.Properties[TimeUnit], UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="OnValueChanged">
                                <ComboBoxItem Content="毫秒" Tag="Milliseconds"/>
                                <ComboBoxItem Content="秒"   Tag="Seconds"/>
                                <ComboBoxItem Content="分钟" Tag="Minutes"/>
                                <ComboBoxItem Content="小时" Tag="Hours"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══ 条件等待配置卡片 ══ -->
                <Border x:Name="ConditionGroup"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="等待条件" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>

                        <!-- 左侧变量 -->
                        <TextBlock Text="左侧变量" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="ConditionLeftVariableTextBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,6,0"
                                     Text="{Binding LogicCommand.Properties[ConditionLeftVariable], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <Button Grid.Column="1"
                                    Content="选择变量"
                                    Style="{StaticResource VarButtonStyle}"
                                    Width="72"
                                    Click="SelectLeftVariable_Click"/>
                        </Grid>

                        <!-- 操作符 -->
                        <TextBlock Text="比较符" Style="{StaticResource FieldLabelStyle}"/>
                        <!-- 隐藏的 ComboBox 保持原有数据绑定，cs 里 UpdateWaitPreview 读的是 Properties[ConditionOperator] -->
                        <ComboBox x:Name="ConditionOperatorCombo"
          Visibility="Collapsed"
          SelectedValue="{Binding LogicCommand.Properties[ConditionOperator], UpdateSourceTrigger=PropertyChanged}"
          SelectedValuePath="Tag"
          SelectionChanged="OnValueChanged">
                            <ComboBoxItem Tag="Equals"/>
                            <ComboBoxItem Tag="NotEquals"/>
                            <ComboBoxItem Tag="GreaterThan"/>
                            <ComboBoxItem Tag="LessThan"/>
                            <ComboBoxItem Tag="GreaterThanOrEqual"/>
                            <ComboBoxItem Tag="LessThanOrEqual"/>
                            <ComboBoxItem Tag="IsTrue"/>
                            <ComboBoxItem Tag="IsFalse"/>
                            <ComboBoxItem Tag="IsEmpty"/>
                            <ComboBoxItem Tag="IsNotEmpty"/>
                            <ComboBoxItem Tag="Contains"/>
                            <ComboBoxItem Tag="NotContains"/>
                        </ComboBox>

                        <!-- 分段选择器：6个常用比较符，和 If 页面完全一致 -->
                        <Border Background="#F3F4F6" CornerRadius="7" Padding="3" Margin="0,0,0,10">
                            <UniformGrid Rows="1">
                                <RadioButton Content="="
                     GroupName="WaitOpGroup"
                     Style="{StaticResource OpPillStyle}"
                     IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                         Converter={StaticResource StrEqConverter},
                         ConverterParameter=Equals,
                         UpdateSourceTrigger=PropertyChanged}"
                     Checked="OnValueChanged"/>
                                <RadioButton Content="≠"
                     GroupName="WaitOpGroup"
                     Style="{StaticResource OpPillStyle}"
                     IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                         Converter={StaticResource StrEqConverter},
                         ConverterParameter=NotEquals,
                         UpdateSourceTrigger=PropertyChanged}"
                     Checked="OnValueChanged"/>
                                <RadioButton Content="&gt;"
                     GroupName="WaitOpGroup"
                     Style="{StaticResource OpPillStyle}"
                     IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                         Converter={StaticResource StrEqConverter},
                         ConverterParameter=GreaterThan,
                         UpdateSourceTrigger=PropertyChanged}"
                     Checked="OnValueChanged"/>
                                <RadioButton Content="&lt;"
                     GroupName="WaitOpGroup"
                     Style="{StaticResource OpPillStyle}"
                     IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                         Converter={StaticResource StrEqConverter},
                         ConverterParameter=LessThan,
                         UpdateSourceTrigger=PropertyChanged}"
                     Checked="OnValueChanged"/>
                                <RadioButton Content="≥"
                     GroupName="WaitOpGroup"
                     Style="{StaticResource OpPillStyle}"
                     IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                         Converter={StaticResource StrEqConverter},
                         ConverterParameter=GreaterThanOrEqual,
                         UpdateSourceTrigger=PropertyChanged}"
                     Checked="OnValueChanged"/>
                                <RadioButton Content="≤"
                     GroupName="WaitOpGroup"
                     Style="{StaticResource OpPillStyle}"
                     IsChecked="{Binding LogicCommand.Properties[ConditionOperator],
                         Converter={StaticResource StrEqConverter},
                         ConverterParameter=LessThanOrEqual,
                         UpdateSourceTrigger=PropertyChanged}"
                     Checked="OnValueChanged"/>
                            </UniformGrid>
                        </Border>

                        <!-- 右侧值 -->
                        <TextBlock Text="右侧值" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="ConditionRightValueTextBox"
                                 Style="{StaticResource FieldInputStyle}"
                                 Margin="0,0,0,10"
                                 Text="{Binding LogicCommand.Properties[ConditionRightValue], UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnValueChanged"/>

                        <!-- 检查间隔 -->
                        <TextBlock Text="检查间隔" Style="{StaticResource FieldLabelStyle}"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="CheckIntervalTextBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,8,0"
                                     Text="{Binding LogicCommand.Properties[CheckIntervalSeconds], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <TextBlock Grid.Column="1" Text="秒"
                                       VerticalAlignment="Center"
                                       FontSize="12" Foreground="#757575"/>
                        </Grid>

                        <!-- 超时设置 -->
                        <TextBlock Text="超时设置" Style="{StaticResource FieldLabelStyle}"/>
                        <CheckBox x:Name="IsInfiniteTimeoutCheckBox"
          Style="{StaticResource FieldCheckBoxStyle}"
          Content="无限超时（一直等待直到条件满足）"
          IsChecked="{Binding LogicCommand.Properties[IsInfiniteTimeout], UpdateSourceTrigger=PropertyChanged}"
          Checked="OnValueChanged" Unchecked="OnValueChanged"/>

                        <Grid x:Name="TimeoutInputGroup">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="TimeoutTextBox"
                                     Style="{StaticResource FieldInputStyle}"
                                     Margin="0,0,8,0"
                                     Text="{Binding LogicCommand.Properties[TimeoutSeconds], UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="OnValueChanged"/>
                            <TextBlock Grid.Column="1" Text="秒"
                                       VerticalAlignment="Center"
                                       FontSize="12" Foreground="#757575"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══ 预览卡片 ══ -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="预览" FontSize="11" FontWeight="Medium" Foreground="#757575"/>
                        </StackPanel>
                        <Border Background="#FAFAFA" BorderBrush="#E0E0E0"
                                BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="WaitPreview"
                                       FontFamily="Consolas" FontSize="12"
                                       Foreground="#424242" TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ 验证提示（cs 里控制显隐） ══ -->
                <Border x:Name="ValidationPanel"
                        Background="#FFEBEE"
                        BorderBrush="#EF9A9A" BorderThickness="1"
                        CornerRadius="8" Padding="12"
                        Margin="0,0,0,8"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="#E53935" Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="ValidationText"
                                   Text="配置有误"
                                   FontSize="12" Foreground="#C62828"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ══ 提示卡片 ══ -->
                <Border Background="#E3F2FD" BorderBrush="#BBDEFB"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="使用说明" FontSize="11" FontWeight="Medium" Foreground="#1565C0"/>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="#1976D2"
                                   LineHeight="20" TextWrapping="Wrap">
                            <Run Text="• 固定时间：同步阻塞，适合确定等待时长的场景"/>
                            <LineBreak/>
                            <Run Text="• 条件等待：循环检查直到条件满足，支持同步/异步"/>
                            <LineBreak/>
                            <Run Text="• 左侧变量示例：{temperatureValue}、{isCompleted}"/>
                            <LineBreak/>
                            <Run Text="• 右侧值示例：100、true、完成状态"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>