<Window x:Class="MaxChemical.Modules.Designer.Views.ConditionMetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="条件等待" 
        Width="500" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#FAFBFC"
        ShowInTaskbar="False"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#4CAF50" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="24" Height="24" Fill="White" Margin="0,0,16,0"/>
                <StackPanel>
                    <TextBlock Text="条件等待 - 条件已满足" 
                               FontSize="18" 
                               FontWeight="SemiBold" 
                               Foreground="White"/>
                    <TextBlock x:Name="ExecutionModeText"
                               Text="同步执行模式"
                               FontSize="12" 
                               Foreground="#E8F5E8"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主要内容 -->
        <StackPanel Grid.Row="1" Margin="32,24">
            <!-- 条件表达式显示 -->
            <TextBlock Text="等待条件已满足："
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="#333333"
                       Margin="0,0,0,12"/>

            <Border Background="White"
                    BorderBrush="#E5E5E5"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20,16"
                    Margin="0,0,0,20">
                <TextBlock x:Name="ConditionText"
           Text="条件表达式将在这里显示"
           FontFamily="Consolas"
           FontSize="16"
           FontWeight="SemiBold"
           Foreground="#4CAF50"
           TextWrapping="Wrap"
           HorizontalAlignment="Center"/>
            </Border>

            <!-- 说明文本 -->
            <TextBlock Text="请选择如何继续执行流程："
                       FontSize="13"
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="HelpText"
                       Text="• 继续：流程将继续执行下一步骤&#10;• 停止：终止整个流程的执行"
                       FontSize="12"
                       Foreground="#999999"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
            <Button x:Name="ContinueButton"
                    Content="✓ 继续执行"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Style="{StaticResource ButtonStyle}"
                    Click="ContinueButton_Click"/>

            <Button x:Name="StopButton"
                    Content="✕ 停止流程"
                    Background="#F44336"
                    Foreground="White"
                    BorderThickness="0"
                    Style="{StaticResource ButtonStyle}"
                    Click="StopButton_Click"/>
        </StackPanel>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText"
                           Text="条件检查已完成，等待用户确认"
                           FontSize="12"
                           Foreground="#666666"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>