<UserControl x:Class="MaxChemical.Modules.Designer.Views.DevicePropertyDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1200" Height="700">

    <UserControl.Resources>
        <!-- 蓝色标题样式 -->
        <Style x:Key="BlueHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="#4472C4"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- 白色文字样式 -->
        <Style x:Key="WhiteTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="15,0"/>
        </Style>

        <!-- 标签样式 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 文本框样式 -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 蓝色按钮样式 -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4472C4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#365A9B"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 绿色按钮样式（连接成功状态） -->
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 红色按钮样式（断开状态） -->
        <Style x:Key="RedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 灰色按钮样式 -->
        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#9E9E9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#757575"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox样式 -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- CheckBox样式 -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,3"/>
        </Style>

        <!-- 容器样式 -->
        <Style x:Key="ContainerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 第一部分：标题栏 -->
                <RowDefinition Height="200"/>
                <!-- 第二部分：主要内容区域 -->
                <RowDefinition Height="*"/>
                <!-- 第三部分：设备调试区域 -->
            </Grid.RowDefinitions>

            <!-- 第一部分：蓝色标题栏 -->
            <Border Grid.Row="0" Style="{StaticResource BlueHeaderStyle}">
                <Grid>
                    <TextBlock Text="基本信息" Style="{StaticResource WhiteTextStyle}"/>
                    <Button Content="✕" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="18"
                            Width="35"
                            Height="35"
                            Margin="5,0"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- 第二部分：主要内容区域（左右布局） -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <!-- 左侧：设备基础信息 -->
                    <ColumnDefinition Width="1*"/>
                    <!-- 右侧：监控参数绑定 -->
                </Grid.ColumnDefinitions>

                <!-- 左侧：设备基础信息 -->
                <Grid Grid.Column="0" Margin="0,0,10,0" Height="180" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 设备图片 -->
                    <Border Grid.Column="0" 
                            Width="130" Height="160" 
                            BorderBrush="#CCCCCC" 
                            BorderThickness="2"
                            Background="#F8F9FA"
                            VerticalAlignment="Center"
                            Margin="10,0,10,0">
                        <Image x:Name="DeviceImage" 
                               Stretch="Uniform"
                               Margin="8"/>
                    </Border>

                    <!-- 设备基础信息 -->
                    <StackPanel Grid.Column="1" Margin="10,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="设备名称：" Style="{StaticResource LabelStyle}" Width="80" FontWeight="Bold"/>
                            <TextBlock x:Name="DeviceNameText" Style="{StaticResource LabelStyle}" FontWeight="Bold" Foreground="#2E5BBA"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="设备类型：" Style="{StaticResource LabelStyle}" Width="80" FontWeight="Bold"/>
                            <TextBlock x:Name="DeviceTypeText" Style="{StaticResource LabelStyle}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="制造商：" Style="{StaticResource LabelStyle}" Width="80" FontWeight="Bold"/>
                            <TextBlock x:Name="ManufacturerText" Style="{StaticResource LabelStyle}"/>
                        </StackPanel>

                        <!-- 连接状态显示 -->
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <TextBlock Text="连接状态：" Style="{StaticResource LabelStyle}" Width="80" FontWeight="Bold"/>
                            <TextBlock x:Name="ConnectionStatusText" Style="{StaticResource LabelStyle}" 
                                      Text="未连接" Foreground="Red" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 右侧：监控参数绑定 -->
                <Grid Grid.Column="1" Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 监控参数绑定标题 -->
                    <TextBlock Grid.Row="0" Text="监控参数绑定：（选择在监控模式下显示的设备参数）" 
                               Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="0,5"/>

                    <!-- 命令显示 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="命    令：" Style="{StaticResource LabelStyle}" Width="80"/>
                        <TextBlock x:Name="CommandText" Style="{StaticResource LabelStyle}" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- 监控参数复选框 - 使用ScrollViewer包裹 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="100" Margin="0,10">
                        <WrapPanel x:Name="MonitorParametersPanel">
                            <!-- 这里会动态添加监控参数复选框 -->
                        </WrapPanel>
                    </ScrollViewer>

                    <!-- 全选/清除按钮 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                        <Button Content="全选" Style="{StaticResource BlueButtonStyle}" Click="SelectAllButton_Click"/>
                        <Button Content="清除" Style="{StaticResource GrayButtonStyle}" Click="ClearAllButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 第三部分：设备调试区域（从左到右三个容器） -->
            <Grid Grid.Row="2" Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 设备调试标题 -->
                <TextBlock Grid.Row="0" Text="设备调试:" Style="{StaticResource LabelStyle}" 
                          FontSize="14" FontWeight="Bold" Margin="0,10,0,5"/>

                <!-- 三个容器的布局 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <!-- 第一部分：命令列表 -->
                        <ColumnDefinition Width="1*"/>
                        <!-- 第二部分：命令参数 -->
                        <ColumnDefinition Width="1*"/>
                        <!-- 第三部分：设备参数 -->
                    </Grid.ColumnDefinitions>

                    <!-- 第一部分：命令容器 -->
                    <Border Grid.Column="0" Style="{StaticResource ContainerStyle}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 命令标题 -->
                            <Border Grid.Row="0" Background="#4472C4" Height="30" Margin="0,0,0,5">
                                <TextBlock Text="命令" Style="{StaticResource WhiteTextStyle}" 
                                          HorizontalAlignment="Center" FontSize="12"/>
                            </Border>

                            <!-- 命令列表 -->
                            <ListBox Grid.Row="1" x:Name="CommandListBox" 
                                    SelectionChanged="CommandListBox_SelectionChanged"
                                    BorderBrush="#CCCCCC" BorderThickness="1">
                                <!-- 这里会动态添加命令项 -->
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 第二部分：命令参数容器 -->
                    <Border Grid.Column="1" Style="{StaticResource ContainerStyle}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1*"/>
                                <!-- 输入参数 -->
                                <RowDefinition Height="1*"/>
                                <!-- 输出参数 -->
                            </Grid.RowDefinitions>

                            <!-- 命令参数标题 -->
                            <Border Grid.Row="0" Background="#4472C4" Height="30" Margin="0,0,0,5">
                                <TextBlock Text="命令参数" Style="{StaticResource WhiteTextStyle}" 
                                          HorizontalAlignment="Center" FontSize="12"/>
                            </Border>

                            <!-- 输入参数区域 -->
                            <GroupBox Grid.Row="1" Header="输入参数:" Margin="0,0,0,5">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="InputParametersPanel" Margin="5">
                                        <!-- 这里会动态添加输入参数 -->
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>

                            <!-- 输出参数区域 -->
                            <GroupBox Grid.Row="2" Header="输出参数:">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="OutputParametersPanel" Margin="5">
                                        <!-- 这里会动态添加输出参数 -->
                                    </StackPanel>
                                </ScrollViewer>
                            </GroupBox>
                        </Grid>
                    </Border>

                    <!-- 第三部分：设备参数容器 -->
                    <Border Grid.Column="2" Style="{StaticResource ContainerStyle}">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 设备参数标题 -->
                            <Border Grid.Row="0" Background="#4472C4" Height="30" Margin="0,0,0,5">
                                <TextBlock Text="设备参数" Style="{StaticResource WhiteTextStyle}" 
                      HorizontalAlignment="Center" FontSize="12"/>
                            </Border>

                            <!-- 设备参数列表 -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DeviceParametersPanel">
                                    <!-- 这里会动态添加设备参数 -->
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 底部按钮区域 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="ConnectButton" Content="连接" Style="{StaticResource BlueButtonStyle}" Click="ConnectButton_Click"/>
                    <Button x:Name="DisconnectButton" Content="断开" Style="{StaticResource GrayButtonStyle}" Click="DisconnectButton_Click" IsEnabled="False"/>
                    <Button x:Name="ExecuteButton" Content="执行" Style="{StaticResource BlueButtonStyle}" Click="ExecuteButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>