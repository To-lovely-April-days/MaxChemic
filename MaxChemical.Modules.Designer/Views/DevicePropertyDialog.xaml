<UserControl x:Class="MaxChemical.Modules.Designer.Views.DevicePropertyDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="960" Height="620">

    <UserControl.Resources>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="WhiteTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- TextBox -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0,28,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                    <Path x:Name="Arrow" Data="M 0 0 L 5 5 L 10 0" Stroke="#9E9E9E" StrokeThickness="1.5" Fill="Transparent"
                                          Width="10" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" StrokeLineJoin="Round" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0" Opacity="0"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="200">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2" Direction="270" BlurRadius="8" Color="#000000" Opacity="0.08"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 5 L 5 0 L 10 5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#212121"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="4,2">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox -->
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBd" Width="16" Height="16" BorderBrush="#BDBDBD" BorderThickness="1.5"
                                    CornerRadius="4" Background="White" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 2 8 L 6 12 L 14 4" Stroke="White" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBd" Property="Background" Value="#2196F3"/>
                                <Setter TargetName="CheckBd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBd" Property="BorderBrush" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons -->
        <ControlTemplate x:Key="BtnTpl" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>
        <Style x:Key="GreenButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>
        <Style x:Key="RedButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EF5350"/>
            <Setter Property="BorderBrush" Value="#FFCDD2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>
        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Template" Value="{StaticResource BtnTpl}"/>
        </Style>

        <Style x:Key="ContainerStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#F0F0F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!--  Commands ListBox 命令项样式（mockup: cmd-item 圆点+文字+hover蓝色） -->
        <Style x:Key="CommandListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="#616161"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="Dot" Width="4" Height="4" Fill="#BDBDBD"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F0F7FF"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                            <Setter TargetName="Dot" Property="Fill" Value="#1565C0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                            <Setter TargetName="Dot" Property="Fill" Value="#1565C0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Border CornerRadius="12" Background="White" BorderBrush="#E8E8E8" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ 上半：Hero + 监控参数 ═══ -->
            <Border Grid.Row="0" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hero -->
                    <Border Grid.Column="0" CornerRadius="12,0,0,0" ClipToBounds="True"
                            MouseLeftButtonDown="TitleBar_MouseDown">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0D47A1" Offset="0"/>
                                <GradientStop Color="#1565C0" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Width="120" Height="120" Fill="#FFFFFF" Opacity="0.05"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-30,-30,0"/>
                            <StackPanel Margin="20,20,20,0" VerticalAlignment="Top">
                                <Grid Width="72" Height="72" HorizontalAlignment="Left" Margin="0,0,0,14">
                                    <Border CornerRadius="12" BorderBrush="#FFFFFF" BorderThickness="1"
                                            Background="White">
                                        <Image x:Name="DeviceImage" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="DeviceNameText" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DeviceTypeText" FontSize="11" Foreground="#90CAF9"/>
                                    <TextBlock Text=" · " FontSize="11" Foreground="#64B5F6"/>
                                    <TextBlock x:Name="ManufacturerText" FontSize="11" Foreground="#90CAF9"/>
                                </StackPanel>
                            </StackPanel>
                            <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="20,0,0,16" BorderBrush="#2E7D32" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="#4CAF50" Opacity="0.2"/>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#81C784" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="ConnectionStatusText" Text="未连接" FontSize="11" Foreground="#EF5350" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 右侧：Overview 标签 + 监控参数（全宽，无设备详情） -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab 栏 + 关闭 -->
                        <Border Grid.Row="0" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Background="#FAFAFA"
                                MouseLeftButtonDown="TitleBar_MouseDown">
                            <Grid Height="40">
                                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <Border x:Name="OverviewTabBorder" Background="Transparent" BorderBrush="#1565C0" BorderThickness="0,0,0,2"
        Padding="4,2" Margin="0,0,18,0" Cursor="Hand"
        MouseLeftButtonDown="OverviewTab_Click">
                                        <TextBlock x:Name="OverviewTabText" Text="Overview" FontSize="12"
               FontWeight="Medium" Foreground="#1565C0"/>
                                    </Border>
                                    <Border x:Name="ScreenTabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
        Padding="4,2" Cursor="Hand" Visibility="Collapsed"
        MouseLeftButtonDown="ScreenTab_Click">
                                        <TextBlock x:Name="ScreenTabText" Text="设备屏幕" FontSize="12"
               FontWeight="Medium" Foreground="#9E9E9E"/>
                                    </Border>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Width="30" Height="30" Margin="0,0,8,0"
                                        Click="CloseButton_Click" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                                <TextBlock Text="×" FontSize="18" Foreground="#9E9E9E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 监控参数（全宽，之前是两列现在只一列） -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Margin="20,14" BorderBrush="#F0F0F0" BorderThickness="1" CornerRadius="8" Background="#FAFBFC" Padding="14">
                                <StackPanel>
                                    <TextBlock Name="BindParamLabel" FontSize="10" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,8" Text="监控参数绑定"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Name="CommandLabel" Text="命令：" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CommandText" FontSize="11" Foreground="#333" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="55">
                                        <WrapPanel x:Name="MonitorParametersPanel"/>
                                    </ScrollViewer>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                        <Button Name="BtnSelectAll" Content="全选" Style="{StaticResource BlueButtonStyle}" Click="SelectAllButton_Click" Height="22" Padding="8,0" FontSize="10"/>
                                        <Button Name="BtnClear" Content="清除" Style="{StaticResource GrayButtonStyle}" Click="ClearAllButton_Click" Height="22" Padding="8,0" FontSize="10"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══ 下半：Device debug ═══ -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <Border Grid.Row="0" Padding="20,8" Background="#FAFAFA" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="3" Height="10" CornerRadius="2" Background="#42A5F5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Device debug" FontSize="12" FontWeight="SemiBold" Foreground="#424242"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ConnectButton" Content="连接" Style="{StaticResource GreenButtonStyle}" Click="ConnectButton_Click"/>
                            <Button x:Name="DisconnectButton" Content="断开" Style="{StaticResource RedButtonStyle}" Click="DisconnectButton_Click" IsEnabled="False"/>
                            <Button x:Name="ExecuteButton" Content="执行" Style="{StaticResource BlueButtonStyle}" Click="ExecuteButton_Click" IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 三列 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Commands（使用 mockup 样式的 ListBox） -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,8" Background="#FDFDFD" BorderBrush="#F5F5F5" BorderThickness="0,0,1,1">
                            <TextBlock Text="Commands" FontSize="10" FontWeight="SemiBold" Foreground="#9E9E9E"/>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="#F0F0F0" BorderThickness="0,0,1,0">
                            <ListBox x:Name="CommandListBox" SelectionChanged="CommandListBox_SelectionChanged"
                                     Style="{StaticResource CommandListBoxStyle}"/>
                        </Border>
                    </Grid>

                    <!-- Parameters（Input + Output） -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,8" Background="#FDFDFD" BorderBrush="#F5F5F5" BorderThickness="0,0,1,1">
                            <TextBlock Text="Parameters" FontSize="10" FontWeight="SemiBold" Foreground="#9E9E9E"/>
                        </Border>
                        <Grid Grid.Row="1" Margin="6,6,6,3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Input" FontSize="9" Foreground="#BDBDBD" FontWeight="SemiBold" Margin="4,0,0,3"/>
                            <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#F0F0F0" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="InputParametersPanel" Margin="10,6"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="2" Margin="6,3,6,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Output" FontSize="9" Foreground="#BDBDBD" FontWeight="SemiBold" Margin="4,0,0,3"/>
                            <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#F0F0F0" BorderThickness="1" CornerRadius="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="OutputParametersPanel" Margin="10,6"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Device params -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="14,8" Background="#FDFDFD" BorderBrush="#F5F5F5" BorderThickness="0,0,0,1">
                            <TextBlock Text="Device params" FontSize="10" FontWeight="SemiBold" Foreground="#9E9E9E"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DeviceParametersPanel" Margin="10,6"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ═══ 设备屏幕层（默认隐藏，点“设备屏幕”Tab 显示，盖住 Overview 内容） ═══ -->
            <Border x:Name="ScreenHost" Grid.Row="0" Grid.RowSpan="2"
                    Background="#0E0F12" CornerRadius="0,0,12,12"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 屏幕层自己的顶栏：标题 + 关闭（关闭按钮复用现有 CloseButton_Click） -->
                    <Border Grid.Row="0" Background="#16181D" BorderBrush="#2A2F37"
                            BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseDown">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                <Border x:Name="OverviewTabBorder2" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
        Padding="4,2" Margin="0,0,18,0" Cursor="Hand"
        MouseLeftButtonDown="OverviewTab_Click">
                                    <TextBlock Text="Overview" FontSize="12" FontWeight="Medium" Foreground="#9E9E9E"/>
                                </Border>
                                <Border Background="Transparent" BorderBrush="#4FD1C5" BorderThickness="0,0,0,2" Padding="4,2" Cursor="Hand"
        MouseLeftButtonDown="ScreenTab_Click">
                                    <TextBlock Text="设备屏幕" FontSize="12" FontWeight="Medium" Foreground="#4FD1C5"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="ScreenHeaderText" Text="设备屏幕"
                                       Foreground="#6B7280" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Width="30" Height="30" Margin="0,0,8,0"
                                    Click="CloseButton_Click" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                                            <TextBlock Text="×" FontSize="18" Foreground="#9E9E9E"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2A2F37"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 屏幕控件挂载点：Viewbox 等比缩放 -->
                    <Viewbox x:Name="ScreenContentHost" Grid.Row="1"
                             Stretch="Uniform" StretchDirection="Both" Margin="10"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
