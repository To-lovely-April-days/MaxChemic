<!-- MaxChemical.Modules.Designer/Views/ExperimentDetailWindow.xaml -->
<Window x:Class="MaxChemical.Modules.Designer.Views.ExperimentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="实验详情" Height="700" Width="1000" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter" 
                                           TrueValue="首次记录" 
                                           FalseValue="参数变化"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 实验基本信息 -->
        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="15">
            <Grid DataContext="{Binding Experiment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding ExperimentName}" 
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="实验ID: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="{Binding ExperimentId}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="流程名称: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="{Binding FlowName}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="开始时间: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="{Binding StartTime, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="结束时间: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="{Binding EndTime, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="持续时间: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="{Binding Duration, StringFormat=hh\\:mm\\:ss}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="执行状态: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="{Binding StatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessful}" Value="True">
                                        <Setter Property="Foreground" Value="Green"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                                        <Setter Property="Foreground" Value="Red"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="描述: " FontWeight="Bold" Width="80"/>
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 详细数据标签页 -->
        <TabControl Grid.Row="1">
            <!-- 节点执行记录 -->
            <TabItem Header="节点执行记录">
                <DataGrid ItemsSource="{Binding Experiment.NodeRecords}" AutoGenerateColumns="False" 
                          IsReadOnly="True" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="顺序" Binding="{Binding ExecutionOrder}" Width="50"/>
                        <DataGridTextColumn Header="节点名称" Binding="{Binding NodeName}" Width="150"/>
                        <DataGridTextColumn Header="节点类型" Binding="{Binding NodeType}" Width="100"/>
                        <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="120"/>
                        <DataGridTextColumn Header="命令名称" Binding="{Binding CommandName}" Width="100"/>
                        <DataGridTextColumn Header="开始时间" Binding="{Binding StartTime, StringFormat=HH:mm:ss.fff}" Width="100"/>
                        <DataGridTextColumn Header="结束时间" Binding="{Binding EndTime, StringFormat=HH:mm:ss.fff}" Width="100"/>
                        <DataGridTextColumn Header="持续时间(ms)" Binding="{Binding DurationMs, StringFormat={}{0:F0}}" Width="100"/>

                        <DataGridTemplateColumn Header="状态" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccessful}" Value="True">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSuccessful}" Value="False">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- 参数变化记录 -->
            <TabItem Header="参数变化记录">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 说明文字 -->
                    <Border Grid.Row="0" Background="#E7F3FF" BorderBrush="#B3D7FF" BorderThickness="1" Padding="10" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="此表显示设备输出参数的变化记录，只显示参数值发生变化的时刻，相同值已自动去重。" 
                                       FontStyle="Italic" Foreground="#0066CC"/>
                            <ProgressBar Width="20" Height="20" IsIndeterminate="{Binding IsLoading}" 
                                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ParameterChanges}" AutoGenerateColumns="False" 
                              IsReadOnly="True" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F9FA"
                              Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="设备名称" Binding="{Binding DeviceName}" Width="120"/>
                            <DataGridTextColumn Header="参数名称" Binding="{Binding ParameterName}" Width="120"/>
                            <DataGridTextColumn Header="参数值" Binding="{Binding ParameterValue}" Width="100"/>
                            <DataGridTextColumn Header="前一个值" Binding="{Binding PreviousValue}" Width="100"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/>
                            <DataGridTextColumn Header="变化时间" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="100"/>
                            <DataGridTextColumn Header="命令名称" Binding="{Binding CommandName}" Width="100"/>
                            <DataGridTextColumn Header="节点名称" Binding="{Binding NodeName}" Width="120"/>
                            <DataGridTextColumn Header="变化序号" Binding="{Binding ChangeSequence}" Width="80"/>
                            <DataGridTextColumn Header="距上次变化" Binding="{Binding TimeSinceLastChange, StringFormat=hh\\:mm\\:ss\\.fff}" Width="100"/>

                            <DataGridTemplateColumn Header="变化类型" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsFirstRecord, Converter={StaticResource BooleanToStringConverter}}" 
                                                   HorizontalAlignment="Center" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFirstRecord}" Value="True">
                                                            <Setter Property="Foreground" Value="Blue"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFirstRecord}" Value="False">
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 状态栏和按钮区域 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 状态栏 -->
            <StatusBar Grid.Row="0" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <ProgressBar Width="20" Height="20" IsIndeterminate="{Binding IsLoading}" 
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StatusMessage}"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="15">
                <Button Content="导出详情" Command="{Binding ExportDetailCommand}" Width="80" Margin="0,0,10,0"/>
                <Button Content="关闭" Width="80" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>