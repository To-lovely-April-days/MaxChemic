<UserControl x:Class="MaxChemical.Modules.Designer.Views.WaitNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
    </UserControl.Resources>

    <Border x:Name="MainStepCard"
            Width="231" Height="64"
            CornerRadius="6"
            Cursor="Hand"
            MouseDown="Node_Click"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True"
            HorizontalAlignment="Center"
            Margin="0,10,0,10"
            Style="{StaticResource ExecutingWaitNodeStyle}">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="4"
                              Direction="315"
                              BlurRadius="8"
                              Color="#000000"
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="14">
            <!-- 先定义所有属性元素 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 执行状态指示条 -->
            <Rectangle Grid.ColumnSpan="3"
                       Height="3" 
                       VerticalAlignment="Top"
                       Margin="-14,0,-14,0"
                       Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                       Opacity="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToOpacityConverter}}">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- 左侧图标 -->
            <Grid Grid.Column="0" Width="32" Height="27" Margin="0,0,10,0">
                <Image Source="{Binding LogicCommand.Properties[Bezel_lessIconPath]}"
                       Width="24" 
                       Height="24"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>

            <!-- 右侧文字内容 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName, FallbackValue='等待'}"
                               FontSize="14"
                               FontWeight="Medium"
                               Foreground="#333"
                               Margin="0,0,8,2"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="110"/>

                    <!-- 执行状态圆点 -->
                    <Ellipse Width="8" Height="8" 
                             Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                             VerticalAlignment="Center"
                             Margin="0,0,0,2">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <!-- 动态显示等待信息 -->
                    <TextBlock FontSize="11"
                               Foreground="#999"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="110">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <!-- 默认显示固定时间等待 -->
                                <Setter Property="Text">
                                    <Setter.Value>
                                        <MultiBinding StringFormat="{}等待时长: {0} {1}">
                                            <Binding Path="LogicCommand.Properties[WaitTime]" FallbackValue="5"/>
                                            <Binding Path="LogicCommand.Properties[TimeUnit]" FallbackValue="秒"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- 当CommandType为Wait时显示固定时间等待 -->
                                    <DataTrigger Binding="{Binding LogicCommand.CommandType}" Value="Wait">
                                        <Setter Property="Text">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}等待时长: {0} {1}">
                                                    <Binding Path="LogicCommand.Properties[WaitTime]" FallbackValue="5"/>
                                                    <Binding Path="LogicCommand.Properties[TimeUnit]" FallbackValue="秒"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- 当CommandType为WaitIf时显示条件等待 -->
                                    <DataTrigger Binding="{Binding LogicCommand.CommandType}" Value="WaitIf">
                                        <Setter Property="Text">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}超时: {0}秒，间隔: {1}秒">
                                                    <Binding Path="LogicCommand.Properties[TimeoutSeconds]" FallbackValue="30"/>
                                                    <Binding Path="LogicCommand.Properties[CheckIntervalSeconds]" FallbackValue="1"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- 当CommandType为Loop时显示循环信息 -->
                                    <DataTrigger Binding="{Binding LogicCommand.CommandType}" Value="Loop">
                                        <Setter Property="Text">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}循环次数: {0}">
                                                    <Binding Path="LogicCommand.Properties[LoopCount]" FallbackValue="1"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>

                                    <!-- 当CommandType为Condition时显示条件判断 -->
                                    <DataTrigger Binding="{Binding LogicCommand.CommandType}" Value="Condition">
                                        <Setter Property="Text">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="{}{0} {1} {2}">
                                                    <Binding Path="LogicCommand.Properties[LeftOperand]" FallbackValue="变量"/>
                                                    <Binding Path="LogicCommand.Properties[Operator]" FallbackValue="=="/>
                                                    <Binding Path="LogicCommand.Properties[RightOperand]" FallbackValue="值"/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 执行时间显示 -->
                    <TextBlock Text="{Binding ExecutionDurationText}" 
                               FontSize="9" 
                               Foreground="#666"
                               Margin="8,0,0,0"
                               Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>

            <!-- 删除按钮 -->
            <Border x:Name="DeleteButton"
                    Grid.Column="2"
                    Width="20"
                    Height="20"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    MouseLeftButtonUp="DeleteButton_Click"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                                <Setter Property="CornerRadius" Value="10"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="×"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Foreground" Value="#333333"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</UserControl>