<!-- ParameterMonitorChartView.xaml - 修复版 -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.ParameterMonitorChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             Background="#FAFBFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StatusColorConverter x:Key="StatusColorConverter"/>
        <converters:StatusTextConverter x:Key="StatusTextConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- 标题文字样式 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8C8C8C"/>
        </Style>

        <!-- 现代卡片样式 -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" 
                                    ShadowDepth="0" 
                                    BlurRadius="12" 
                                    Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 科技感按钮 -->
        <Style x:Key="TechButton" TargetType="Button">
            <Setter Property="Background" Value="#1890FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#40A9FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#096DD9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#262626"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#1890FF"/>
                                <Setter Property="Foreground" Value="#1890FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 图标按钮 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#595959"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#1890FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 专业搜索框 -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#262626"/>
            <Setter Property="BorderBrush" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="36,10,12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CaretBrush" Value="#1890FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <!-- 搜索图标 -->
                                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="#BFBFBF"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      IsHitTestVisible="False"/>

                                <ScrollViewer x:Name="PART_ContentHost" 
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center"/>

                                <TextBlock x:Name="Placeholder"
                                         Text="Search parameters..."
                                         FontSize="13"
                                         Foreground="#BFBFBF"
                                         VerticalAlignment="Center"
                                         Margin="36,0,0,0"
                                         IsHitTestVisible="False"
                                         Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#40A9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代复选框 -->
        <Style x:Key="ModernCheckbox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#262626"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="18"
                                    Height="18"
                                    Background="White"
                                    BorderBrush="#D9D9D9"
                                    BorderThickness="1.5"
                                    CornerRadius="4"
                                    Margin="0,0,10,0">
                                <Path x:Name="CheckMark"
                                      Data="M4 8l3 3 5-6"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Stretch="Uniform"
                                      Width="12"
                                      Height="12"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckBorder" Property="Background" Value="#1890FF"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#1890FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#40A9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 参数列表项样式 -->
        <Style x:Key="ParameterItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F7FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== 专业顶部导航栏 ========== -->
        <Border Grid.Row="0" 
                Background="White"
                BorderBrush="#E8EAED"
                BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" 
                                ShadowDepth="0" 
                                BlurRadius="4" 
                                Opacity="0.04"/>
            </Border.Effect>
            
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & 标题 -->
                <StackPanel Grid.Column="0" 
                          Orientation="Horizontal" 
                          VerticalAlignment="Center">
                    <!-- 科技感Logo -->
                    <Border Background="#E6F7FF" 
                            CornerRadius="8"
                            Width="40"
                            Height="40"
                            Margin="0,0,16,0">
                        <Grid>
                            <Path Data="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"
                                  Fill="#1890FF"
                                  Stretch="Uniform"
                                  Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Real-time Parameter Monitor"
                                 FontSize="16"
                                 FontWeight="SemiBold"
                                 Foreground="#262626"/>
                        <TextBlock Text="Industrial Process Monitoring System"
                                 FontSize="12"
                                 Foreground="#8C8C8C"
                                 Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧控制台 -->
                <StackPanel Grid.Column="2" 
                          Orientation="Horizontal" 
                          VerticalAlignment="Center">
                    
                    <!-- 时间范围选择器 -->
                    <Border Background="#FAFAFA"
                            BorderBrush="#D9D9D9"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,16,0"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                                  Fill="#595959"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16"
                                  Margin="0,0,8,0"/>
                            <TextBlock Text="Last 15 min" 
                                     FontSize="13" 
                                     FontWeight="Medium"
                                     Foreground="#262626"/>
                            <Path Data="M7 10l5 5 5-5z"
                                  Fill="#8C8C8C"
                                  Stretch="Uniform"
                                  Width="12"
                                  Height="12"
                                  Margin="8,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 运行状态徽章 -->
                    <Border Background="{Binding IsProcessRunning, Converter={StaticResource StatusColorConverter}}"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" 
                                   Height="8" 
                                   Fill="White" 
                                   Margin="0,0,8,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="White" 
                                                    ShadowDepth="0" 
                                                    BlurRadius="4" 
                                                    Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding IsProcessRunning, Converter={StaticResource StatusTextConverter}}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- 工具按钮组 -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" 
                              Margin="0,0,6,0" 
                              ToolTip="Pause Monitoring">
                            <Path Data="M6 4h4v16H6V4zm8 0h4v16h-4V4z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16"/>
                        </Button>
                        
                        <Button Command="{Binding RefreshAvailableParametersCommand}"
                              Style="{StaticResource IconButton}" 
                              Margin="0,0,6,0" 
                              ToolTip="Refresh Data">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"/>
                        </Button>
                        
                        <Button Style="{StaticResource IconButton}" 
                              ToolTip="System Settings">
                            <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform"
                                  Width="18"
                                  Height="18"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 主内容三栏布局 ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧参数管理面板 ========== -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E8EAED"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索框 -->
                    <Border Grid.Row="0" Padding="16,16,16,16">
                        <TextBox Style="{StaticResource SearchBox}"
                               Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>

                    <!-- Active 区域标题 - 修复：去除LetterSpacing -->
                    <Border Grid.Row="1" 
                          Background="#FAFBFC" 
                          Padding="16,10,16,10"
                          BorderBrush="#E8EAED"
                          BorderThickness="0,1,0,1">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                     Text="ACTIVE MONITORS"
                                     VerticalAlignment="Center"/>
                            <Border Background="#1890FF"
                                    CornerRadius="12"
                                    Padding="8,4"
                                    HorizontalAlignment="Right"
                                    MinWidth="28">
                                <TextBlock Text="{Binding MonitoredParameters.Count, Mode=OneWay}"
                                         FontSize="11"
                                         FontWeight="Bold"
                                         Foreground="White"
                                         HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Active 参数列表 -->
                    <ScrollViewer Grid.Row="2" 
                                VerticalScrollBarVisibility="Auto" 
                                Padding="10,8,10,8">
                        <ItemsControl ItemsSource="{Binding MonitoredParameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ParameterItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 复选框 -->
                                            <CheckBox Grid.Column="0"
                                                    IsChecked="{Binding IsEnabled}"
                                                    Command="{Binding DataContext.ToggleParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ModernCheckbox}"
                                                    Margin="0,0,10,0"/>

                                            <!-- 颜色指示器 -->
                                            <Border Grid.Column="1"
                                                  Width="4"
                                                  Height="32"
                                                  Background="{Binding Color}"
                                                  CornerRadius="2"
                                                  Margin="0,0,12,0"/>

                                            <!-- 参数信息 -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                         FontSize="13"
                                                         FontWeight="Medium"
                                                         Foreground="#262626"
                                                         TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" 
                                                         FontFamily="Consolas"
                                                         Foreground="#8C8C8C" 
                                                         Margin="0,3,0,0">
                                                    <Run Text="{Binding MinValue, StringFormat=F1}"/>
                                                    <Run Text="~" Foreground="#BFBFBF"/>
                                                    <Run Text="{Binding MaxValue, StringFormat=F1}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- 删除按钮 -->
                                            <Button Grid.Column="3"
                                                    Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Width="28"
                                                    Height="28"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                              CornerRadius="4">
                                                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                                  Fill="#FF4D4F"
                                                                  Stretch="Uniform"
                                                                  Width="16"
                                                                  Height="16"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#FFF1F0"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 分隔线 -->
                    <Rectangle Grid.Row="3" Fill="#E8EAED"/>

                    <!-- Available 区域标题 - 修复：去除LetterSpacing -->
                    <Border Grid.Row="4" 
                          Background="#FAFBFC" 
                          Padding="16,10,16,10"
                          BorderBrush="#E8EAED"
                          BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource SectionTitle}"
                                 Text="AVAILABLE PARAMETERS"/>
                    </Border>

                    <!-- Available 参数列表 -->
                    <ScrollViewer Grid.Row="5" 
                                VerticalScrollBarVisibility="Auto" 
                                Padding="10,8,10,8">
                        <ItemsControl ItemsSource="{Binding AvailableParameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ParameterItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                         FontSize="13"
                                                         FontWeight="Medium"
                                                         Foreground="#595959"
                                                         TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ParameterType}"
                                                         FontSize="11"
                                                         Foreground="#BFBFBF"
                                                         Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <!-- 添加按钮 -->
                                            <Button Grid.Column="1"
                                                    Command="{Binding DataContext.AddParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Width="32"
                                                    Height="32"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                              CornerRadius="6">
                                                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                                                  Fill="#52C41A"
                                                                  Stretch="Uniform"
                                                                  Width="18"
                                                                  Height="18"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F6FFED"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ========== 中央图表区域 ========== -->
            <Grid Grid.Column="1" Background="#FAFBFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <!-- 主图表滚动区 -->
                <ScrollViewer Grid.Row="0" 
            VerticalScrollBarVisibility="Auto"
            Padding="20">
                    <Grid x:Name="ChartsContainer">
                        <!-- 空状态 -->
                        <Border Style="{StaticResource ModernCard}"
                Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="80,60"
                MaxWidth="480">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#E6F7FF"
                        Width="96"
                        Height="96"
                        CornerRadius="48"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">
                                    <Path Data="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"
                          Fill="#1890FF"
                          Stretch="Uniform"
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="No Active Monitors"
                         FontSize="20"
                         FontWeight="SemiBold"
                         Foreground="#262626"
                         HorizontalAlignment="Center"
                         Margin="0,0,0,12"/>
                                <TextBlock Text="Add parameters from the left panel to start real-time monitoring"
                         FontSize="14"
                         Foreground="#8C8C8C"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="360"/>
                            </StackPanel>
                        </Border>

                        <!--  新的动态图表容器 -->
                        <Grid x:Name="TimelineChartsPanel"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
                            <!-- 内容将在 Code-Behind 中动态生成 -->
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- 智能时间轴 -->
                <Border Grid.Row="1"
                      Background="White"
                      BorderBrush="#E8EAED"
                      BorderThickness="0,1,0,0"
                      Padding="20,0">
                    <Grid x:Name="TimeAxisContainer" VerticalAlignment="Center">
                        <!-- 时间轴将在Code-Behind中动态生成 -->
                    </Grid>
                </Border>
            </Grid>

            <!-- ========== 右侧分析控制面板 ========== -->
            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#E8EAED"
                    BorderThickness="1,0,0,0"
                    Padding="20,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 实时统计 - 修复：去除LetterSpacing -->
                        <TextBlock Style="{StaticResource SectionTitle}"
                                 Text="REAL-TIME STATISTICS"
                                 Margin="0,0,0,16"/>

                        <Border Style="{StaticResource ModernCard}" 
                              Padding="20" 
                              Margin="0,0,0,20">
                            <StackPanel>
                                <!-- 数据点计数 -->
                                <Grid Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Data Points" 
                                                 FontSize="12" 
                                                 Foreground="#8C8C8C"
                                                 Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding DataPointsCount, StringFormat=N0, Mode=OneWay}" 
                                                 FontSize="28" 
                                                 FontWeight="Bold" 
                                                 FontFamily="Consolas"
                                                 Foreground="#262626"/>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="#F0F0F0" Margin="0,0,0,18"/>

                                <!-- 活动监视器数 -->
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="Active Monitors" 
                                             FontSize="12" 
                                             Foreground="#8C8C8C"
                                             VerticalAlignment="Center"/>
                                    <Border Background="#F6FFED" 
                                          BorderBrush="#B7EB8F"
                                          BorderThickness="1"
                                          CornerRadius="4" 
                                          Padding="10,6" 
                                          HorizontalAlignment="Right">
                                        <TextBlock FontSize="15" 
                                                 FontWeight="Bold"
                                                 FontFamily="Consolas"
                                                 Foreground="#52C41A">
                                            <Run Text="{Binding MonitoredParameters.Count, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- 更新频率 -->
                                <Grid>
                                    <TextBlock Text="Update Rate" 
                                             FontSize="12" 
                                             Foreground="#8C8C8C"
                                             VerticalAlignment="Center"/>
                                    <Border Background="#E6F7FF" 
                                          BorderBrush="#91D5FF"
                                          BorderThickness="1"
                                          CornerRadius="4" 
                                          Padding="10,6" 
                                          HorizontalAlignment="Right">
                                        <TextBlock Text="500 ms" 
                                                 FontSize="13" 
                                                 FontWeight="SemiBold"
                                                 FontFamily="Consolas"
                                                 Foreground="#1890FF"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 系统告警 - 修复：去除LetterSpacing -->
                        <TextBlock Style="{StaticResource SectionTitle}"
                                 Text="SYSTEM ALERTS"
                                 Margin="0,8,0,16"/>

                        <Border Style="{StaticResource ModernCard}" 
                              Padding="24,20" 
                              Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#F6FFED"
                                      Width="48"
                                      Height="48"
                                      CornerRadius="24"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,12">
                                    <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"
                                          Fill="#52C41A"
                                          Stretch="Uniform"
                                          Width="24"
                                          Height="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="All Systems Normal" 
                                         FontSize="13" 
                                         FontWeight="Medium"
                                         Foreground="#52C41A"
                                         HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 快速操作 - 修复：去除LetterSpacing -->
                        <TextBlock Style="{StaticResource SectionTitle}"
                                 Text="QUICK ACTIONS"
                                 Margin="0,8,0,16"/>

                        <!-- 清除数据按钮 -->
                        <Button Command="{Binding ClearDataCommand}"
                              Background="White"
                              Foreground="#FF4D4F"
                              BorderBrush="#FFCCC7"
                              BorderThickness="1"
                              Padding="16,10"
                              FontSize="13"
                              FontWeight="Medium"
                              Cursor="Hand"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,0,12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          CornerRadius="6"
                                          Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                  Fill="{TemplateBinding Foreground}"
                                                  Stretch="Uniform"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,10,0"/>
                                            <TextBlock Text="Clear All Data"
                                                     Foreground="{TemplateBinding Foreground}"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF1F0"/>
                                            <Setter Property="BorderBrush" Value="#FF4D4F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 导出数据按钮 -->
                        <Button Style="{StaticResource SecondaryButton}"
                              HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z"
                                      Fill="#595959"
                                      Stretch="Uniform"
                                      Width="16"
                                      Height="16"
                                      Margin="0,0,10,0"/>
                                <TextBlock Text="Export Data"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>