<!-- ParameterMonitorChartView.xaml -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.ParameterMonitorChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

    
        <Style x:Key="ParameterListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="Bd" Value="#F0F8FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" TargetName="Bd" Value="#E3F2FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" x:Name="ConfigColumn"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 配置面板 -->
        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,0,1,0"
                Visibility="{Binding IsConfigurationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 可用参数标题和刷新按钮 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="可用参数" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Command="{Binding RefreshAvailableParametersCommand}" 
                            Content="🔄" Margin="10,0,0,0" Padding="5,2" 
                            ToolTip="刷新可用参数列表"/>
                </StackPanel>

                <!-- 搜索框 -->
                <TextBox Grid.Row="1" x:Name="SearchBox" Margin="0,0,0,10" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="搜索参数..." />

                <!-- 可用参数列表 -->
                <ListBox Grid.Row="2" ItemsSource="{Binding AvailableParameters}" 
                         SelectedItem="{Binding SelectedAvailableParameter}"
                         ItemContainerStyle="{StaticResource ParameterListItemStyle}"
                         Margin="0,0,0,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding ParameterType}" FontSize="10" 
                                               Foreground="Gray" Margin="0,2,0,0"/>
                                </StackPanel>

                                <Button Grid.Column="1" Content="+" 
                                        Command="{Binding DataContext.AddParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" 
                                        Margin="5,0,0,0" Padding="8,2" 
                                        Background="#4CAF50" Foreground="White" 
                                        BorderThickness="0" ToolTip="添加到监控"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 分隔符 -->
                <Rectangle Grid.Row="3" Height="1" Fill="#E9ECEF" Margin="0,10"/>

                <!-- 监控参数列表 -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="监控中的参数" FontWeight="Bold" Margin="0,10,0,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding MonitoredParameters}"
                             SelectedItem="{Binding SelectedMonitoredParameter}"
                             ItemContainerStyle="{StaticResource ParameterListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" 
                                              Command="{Binding DataContext.ToggleParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}" Margin="0,0,5,0"/>

                                    <Rectangle Grid.Column="1" Width="12" Height="12" 
                                               Fill="{Binding Color}" Margin="0,0,8,0"/>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="范围: " FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding MinValue, StringFormat=F2}" FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text=" ~ " FontSize="10" Foreground="Gray"/>
                                            <TextBlock Text="{Binding MaxValue, StringFormat=F2}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="3" Content="×" 
                                            Command="{Binding DataContext.RemoveParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" 
                                            Margin="5,0,0,0" Padding="8,2" 
                                            Background="#F44336" Foreground="White" 
                                            BorderThickness="0" ToolTip="移除监控"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- 分隔条 -->
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E9ECEF"/>

        <!-- 图表区域 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,0,0,1" Padding="10,8">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ToggleConfigurationCommand}" Margin="0,0,10,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="配置"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="20" Fill="#E9ECEF" Margin="0,0,10,0"/>

                    <Button Command="{Binding ClearDataCommand}" Margin="0,0,10,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="清空数据"/>
                        </StackPanel>
                    </Button>

                    <CheckBox IsChecked="{Binding IsRealTimeMode}" Content="实时模式" 
                              Margin="20,0,0,0" VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding StatusText}" Margin="20,0,0,0" 
                               VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </Border>

            <!-- 图表内容 -->
            <!-- 图表内容 -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E9ECEF" BorderThickness="1" Margin="10">
                <Grid>
                    <!-- 修改图表控件，添加轴配置 -->
                    <lvc:CartesianChart x:Name="MainChart" 
                    Series="{Binding ChartSeries}"
                    AxisY="{Binding YAxes}"
                    Zoom="X" Pan="X" 
                    LegendLocation="Bottom">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="时间" LabelFormatter="{Binding DateTimeFormatter}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator StrokeThickness="1" StrokeDashArray="2"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.DataTooltip>
                            <lvc:DefaultTooltip SelectionMode="OnlySender"/>
                        </lvc:CartesianChart.DataTooltip>
                    </lvc:CartesianChart>

                 
                </Grid>
            </Border>

            <!-- 状态栏 -->
            <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="监控参数:" Foreground="Gray"/>
                    <TextBlock Text="{Binding MonitoredParameters.Count}" Margin="5,0,15,0" FontWeight="Bold"/>
                    <TextBlock Text="数据点:" Foreground="Gray"/>
                    <TextBlock Text="{Binding DataPointsCount}" Margin="5,0,15,0" FontWeight="Bold"/>
                    <TextBlock Text="最后更新:" Foreground="Gray"/>
                    <TextBlock Text="{Binding LastUpdateTime, StringFormat=HH:mm:ss}" Margin="5,0,0,0" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>