<UserControl x:Class="MaxChemical.Modules.Designer.Views.ParameterMonitorChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             Background="#FAFBFC">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

        <!-- 搜索框 -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CaretBrush" Value="#6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="0">
                            <Grid>
                                <Path Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Fill="#D1D5DB" Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="10,0,0,0" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="30,0,10,0"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Text="Filter..."
                                         FontSize="12" Foreground="#D1D5DB"
                                         VerticalAlignment="Center" Margin="30,0,0,0"
                                         IsHitTestVisible="False" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#A5B4FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 底部按钮模板 -->
        <ControlTemplate x:Key="BottomBtnTpl" TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6"
                    Padding="0,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 时间范围按钮 -->
        <Style x:Key="TimeRangeBtn" TargetType="RadioButton">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="GroupName" Value="TimeRange"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="4" Padding="7,3" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#374151"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====== 左侧参数面板 ====== -->
        <Border Grid.Column="0" Background="White"
                BorderBrush="#E8EAED" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="Monitoring"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="#262626"
                           Margin="16,14,16,8"/>

                <!-- 搜索框 -->
                <Border Grid.Row="1" Padding="12,0,12,10">
                    <TextBox Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>

                <!-- 参数列表（code-behind 按设备分组动态生成） -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ParameterListPanel" Margin="0,0,0,4"/>
                </ScrollViewer>

                <!-- 底部按钮：清除数据 + 导出 -->
                <Border Grid.Row="3" Padding="10,8"
                        BorderBrush="#F0F1F3" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="BtnClearData"
                                Background="White" Foreground="#EF4444"
                                BorderBrush="#FECACA" FontSize="11"
                                Cursor="Hand" Template="{StaticResource BottomBtnTpl}"
                                Click="BtnClearData_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                      Fill="#EF4444" Stretch="Uniform" Width="12" Height="12"
                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Clear" Foreground="#EF4444" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" x:Name="BtnExport"
                                Background="#EEF2FF" Foreground="#6366F1"
                                BorderBrush="#C7D2FE" FontSize="11"
                                FontWeight="Medium" Cursor="Hand"
                                Template="{StaticResource BottomBtnTpl}"
                                Click="BtnExport_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z"
                                      Fill="#6366F1" Stretch="Uniform" Width="12" Height="12"
                                      Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Export" Foreground="#6366F1" FontSize="11" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ====== 图表区域 ====== -->
        <Grid Grid.Column="1" Background="#FAFBFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                    Padding="14,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#D1D5DB"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessRunning}" Value="True">
                                            <Setter Property="Fill" Value="#10B981"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="10" Foreground="#6B7280" VerticalAlignment="Center">
                            <Run Text="{Binding MonitoredParameters.Count, Mode=OneWay, StringFormat={}{0} params}"/>
                            <Run Text=" · " Foreground="#D1D5DB"/>
                            <Run Text="{Binding DataPointsCount, Mode=OneWay, StringFormat={}{0} pts}"/>
                        </TextBlock>
                    </StackPanel>

                    <Border HorizontalAlignment="Right" Background="#F3F4F6"
                            CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Rb5m" Style="{StaticResource TimeRangeBtn}" Content="5m" Tag="5"/>
                            <RadioButton x:Name="Rb15m" Style="{StaticResource TimeRangeBtn}" Content="15m" Tag="15"/>
                            <RadioButton x:Name="Rb30m" Style="{StaticResource TimeRangeBtn}" Content="30m" Tag="30" IsChecked="True"/>
                            <RadioButton x:Name="Rb1h" Style="{StaticResource TimeRangeBtn}" Content="1h" Tag="60"/>
                            <RadioButton x:Name="RbAll" Style="{StaticResource TimeRangeBtn}" Content="ALL" Tag="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 图表 -->
            <Grid Grid.Row="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Ellipse Width="64" Height="64" Fill="#F3F4F6"
                             HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="No active monitors" FontSize="16" FontWeight="Medium"
                               Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Select parameters from the left panel"
                               FontSize="12" Foreground="#D1D5DB" HorizontalAlignment="Center"/>
                </StackPanel>

                <Canvas x:Name="ChartCanvas" Background="Transparent" ClipToBounds="True"
                        Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Tooltip 放在 Grid 层，用 RenderTransform 定位 -->
                <Border x:Name="TooltipPanel" Background="White"
                        BorderBrush="#E5E7EB" BorderThickness="0.5"
                        CornerRadius="6" Padding="12,8"
                        Visibility="Collapsed" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TooltipTransform" X="0" Y="0"/>
                    </Border.RenderTransform>
                    <StackPanel x:Name="TooltipContent"/>
                </Border>

                <Line x:Name="CrosshairV" Stroke="#D1D5DB" StrokeThickness="0.5"
                      StrokeDashArray="4,4" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
