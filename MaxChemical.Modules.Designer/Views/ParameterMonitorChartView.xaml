<UserControl x:Class="MaxChemical.Modules.Designer.Views.ParameterMonitorChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             Background="#F8F9FB">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧参数面板 ═══ -->
        <Border Grid.Column="0" Background="White"
                BorderBrush="#E8EAED" BorderThickness="0,0,0.5,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <Border Grid.Row="0" Padding="14,12,14,8">
                    <StackPanel>
                        <TextBlock Text="参数监控" FontSize="13" FontWeight="Medium"
                                   Foreground="#1A1F36"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#C7CCD4"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProcessRunning}" Value="True">
                                                <Setter Property="Fill" Value="#059669"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="9" Foreground="#9CA3AF">
                                <Run Text="{Binding MonitoredParameters.Count, Mode=OneWay}"/>
                                <Run Text=" 参数 · "/>
                                <Run Text="{Binding DataPointsCount, Mode=OneWay}"/>
                                <Run Text=" pts"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 搜索框 -->
                <Border Grid.Row="1" Padding="10,0,10,8">
                    <Border CornerRadius="6" BorderBrush="#E2E5EB" BorderThickness="0.5"
                            Background="White" Height="28">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Margin="8,0,5,0"
                                  Data="M7,12.5 A5.5,5.5 0 1 1 12.5,7 A5.5,5.5 0 0 1 7,12.5 M11,11 L14.5,14.5"
                                  Stroke="#C7CCD4" StrokeThickness="1" Fill="Transparent"
                                  VerticalAlignment="Center" Width="12" Height="12" Stretch="Uniform"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="10" Foreground="#1A1F36" BorderThickness="0"
                                     Background="Transparent" VerticalContentAlignment="Center"
                                     Padding="0,0,8,0"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- 参数列表（code-behind 按设备分组动态生成） -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource SharedScrollViewer}">
                    <StackPanel x:Name="ParameterListPanel" Margin="0,0,0,4"/>
                </ScrollViewer>

                <!-- 底部按钮 -->
                <Border Grid.Row="3" Padding="10,8"
                        BorderBrush="#E8EAED" BorderThickness="0,0.5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="BtnClearData" Cursor="Hand"
                                Click="BtnClearData_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="White" CornerRadius="5"
                                            Padding="0,5" BorderBrush="#FECACA" BorderThickness="0.5">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="清除" FontSize="10" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FEF2F2"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" x:Name="BtnExport" Cursor="Hand"
                                Click="BtnExport_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#E8EAF6" CornerRadius="5"
                                            Padding="0,5" BorderBrush="#C7CBE9" BorderThickness="0.5">
                                        <TextBlock Text="导出" FontSize="10" FontWeight="Medium"
                                                   Foreground="#2D3A8C" HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#D5D9F0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ 右侧图表区 ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 工具栏 -->
            <Border Grid.Row="0" Background="White" Padding="12,6"
                    BorderBrush="#E8EAED" BorderThickness="0,0,0,0.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 图例（图标标签行） -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="归一化 %" FontSize="9" Foreground="#9CA3AF"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ItemsControl ItemsSource="{Binding ChartLegendItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                        <Border Width="10" Height="2" CornerRadius="1"
                                                Background="{Binding ColorBrush}" Margin="0,0,3,0"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="8" Foreground="#6B7280"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 时间范围 -->
                    <Border Grid.Column="2" Background="#F3F4F6" CornerRadius="5"
                            Padding="2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Rb5m" Content="5m" Tag="5" GroupName="TimeRange"
                                         Checked="TimeRange_Checked">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="6,2" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#374151"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton x:Name="Rb15m" Content="15m" Tag="15" GroupName="TimeRange"
                                         Checked="TimeRange_Checked" Style="{x:Null}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="6,2" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#374151"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton x:Name="Rb30m" Content="30m" Tag="30" GroupName="TimeRange"
                                         IsChecked="True" Checked="TimeRange_Checked" Style="{x:Null}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="6,2" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#374151"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton x:Name="Rb1h" Content="1h" Tag="60" GroupName="TimeRange"
                                         Checked="TimeRange_Checked" Style="{x:Null}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="6,2" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#374151"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                            <RadioButton x:Name="RbAll" Content="ALL" Tag="0" GroupName="TimeRange"
                                         Checked="TimeRange_Checked" Style="{x:Null}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="Bd" CornerRadius="4" Padding="6,2" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                                <Setter Property="Foreground" Value="#374151"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- 导出 -->
                    <Button Grid.Column="3" Content="导出" Cursor="Hand"
                            Click="BtnExport_Click"
                            FontSize="9" FontWeight="Medium" Foreground="#2D3A8C">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#E8EAF6" CornerRadius="5"
                                        Padding="10,4" BorderBrush="#C7CBE9" BorderThickness="0.5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#D5D9F0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- OxyPlot 图表 -->
            <Grid Grid.Row="1" Background="#FAFBFC">
                <!-- 无数据占位 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#F3F4F6"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="M3,4 L3,2 M9,4 L9,2 M1,6 L11,6 M1,4 C1,3 1.5,2.5 2.5,2.5 L9.5,2.5 C10.5,2.5 11,3 11,4 L11,11 C11,12 10.5,12.5 9.5,12.5 L2.5,12.5 C1.5,12.5 1,12 1,11 Z"
                              Stroke="#C7CCD4" StrokeThickness="1" Fill="Transparent"
                              Width="20" Height="20" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="暂无监控数据" FontSize="13" FontWeight="Medium"
                               Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="从左侧面板选择参数开始监控" FontSize="11"
                               Foreground="#C7CCD4" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 图表 -->
                <oxy:PlotView Model="{Binding NormalizedChartModel}"
                              Background="Transparent" Padding="0"
                              Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                    <oxy:PlotView.DefaultTrackerTemplate>
                        <ControlTemplate>
                            <oxy:TrackerControl Position="{Binding Position}"
                                                LineStroke="#C7CBE9" LineExtents="{Binding PlotModel.PlotArea}"
                                                LineDashArray="4 4" ShowPointer="True"
                                                BorderBrush="#E2E5EB" BorderThickness="0.5"
                                                Background="White" CornerRadius="8"
                                                BorderEdgeMode="Unspecified">
                                <oxy:TrackerControl.Content>
                                    <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas"
                                               Foreground="#374151" Margin="10,7" LineHeight="18"/>
                                </oxy:TrackerControl.Content>
                            </oxy:TrackerControl>
                        </ControlTemplate>
                    </oxy:PlotView.DefaultTrackerTemplate>
                </oxy:PlotView>
            </Grid>

            <!-- 底部报警条 -->
            <Border Grid.Row="2" Padding="12,6" Background="White"
                    BorderBrush="#E8EAED" BorderThickness="0,0.5,0,0"
                    Visibility="{Binding HasAlarm, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="AlarmDot" Width="8" Height="8" Fill="#DC2626"
                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AlarmMessage}" FontSize="10" FontWeight="Medium"
                               Foreground="#DC2626" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AlarmTime, StringFormat=' · {0:HH:mm:ss}'}"
                               FontSize="9" Foreground="#9CA3AF" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- 无报警时的状态栏 -->
            <Border Grid.Row="2" Padding="12,6" Background="White"
                    BorderBrush="#E8EAED" BorderThickness="0,0.5,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="9" Foreground="#9CA3AF">
                    <Run Text="最后更新: "/>
                    <Run Text="{Binding LastUpdateTime, StringFormat='HH:mm:ss', Mode=OneWay}"/>
                    <Run Text=" · "/>
                    <Run Text="{Binding DataPointsCount, Mode=OneWay}"/>
                    <Run Text=" 数据点"/>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</UserControl>
