<UserControl x:Class="MaxChemical.Modules.Designer.Views.SetVariableNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
    </UserControl.Resources>

    <Border x:Name="MainStepCard"
            Width="231" Height="64"
            CornerRadius="6"
            Cursor="Hand"
            MouseDown="Node_Click"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True"
            HorizontalAlignment="Center"
            Margin="0,10,0,10"
            Style="{StaticResource ExecutingSetVariableNodeStyle}">

        <Border.Effect>
            <DropShadowEffect ShadowDepth="4"
                              Direction="315"
                              BlurRadius="8"
                              Color="#000000"
                              Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="16 0 16 0">
            <!-- 先定义所有属性元素 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 然后是内容元素 -->
            <!-- 执行状态指示条 -->
            <Rectangle Grid.ColumnSpan="3"
                       Height="3" 
                       VerticalAlignment="Top"
                       Margin="-16,0,-16,0"
                       Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                       Opacity="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToOpacityConverter}}">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- 左侧图标 -->
            <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                <Ellipse Fill="#795548" Width="24" Height="24"/>
                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                      Fill="White"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Grid>

            <!-- 右侧文字内容 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName, FallbackValue='设置变量'}" 
                               FontSize="14" 
                               FontWeight="Medium"
                               Foreground="#333"
                               Margin="0,0,8,2"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="120"/>

                    <!-- 执行状态圆点 -->
                    <Ellipse Width="8" Height="8" 
                             Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                             VerticalAlignment="Center"
                             Margin="0,0,0,2">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <!-- 变量信息显示 -->
                    <TextBlock FontSize="11" 
                               Foreground="#999"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="120">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} = {1}">
                                <Binding Path="LogicCommand.Properties[VariableName]" FallbackValue="变量名"/>
                                <Binding Path="LogicCommand.Properties[VariableValue]" FallbackValue="值"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- 执行时间显示 -->
                    <TextBlock Text="{Binding ExecutionDurationText}" 
                               FontSize="9" 
                               Foreground="#666"
                               Margin="8,0,0,0"
                               Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>

            <!-- 删除按钮 -->
            <Border x:Name="DeleteButton"
                    Grid.Column="2"
                    Width="20"
                    Height="20"
                    Background="Transparent"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    MouseLeftButtonUp="DeleteButton_Click"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                                <Setter Property="CornerRadius" Value="10"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="×"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Foreground" Value="#333333"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</UserControl>