<!-- Controls/SetVariableNodeControl.xaml -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.SetVariableNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
    </UserControl.Resources>

    <Border x:Name="MainStepCard"
            Width="231" Height="64"
            Background="White"
            CornerRadius="6"
            Cursor="Hand"
            MouseDown="Node_Click"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True"
            HorizontalAlignment="Center"
            Margin="0,10,0,10">

        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="2"/>
                <!-- 始终保持2像素边框 -->
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="#0078D4"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="False">
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Border.Effect>
            <DropShadowEffect ShadowDepth="4"
                              Direction="315"
                              BlurRadius="8"
                              Color="#000000"
                              Opacity="0.25"/>
        </Border.Effect>

        <!-- 卡片内容 -->
        <Grid Margin="16 0 16 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧图标 - 与启动节点保持一致的尺寸 -->
            <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                <Ellipse Fill="#795548" Width="24" Height="24"/>
                <Path Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                      Fill="White"
                      Width="12" Height="12"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Grid>

            <!-- 右侧文字内容 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName, FallbackValue='设置变量'}" 
                           FontSize="14" 
                           FontWeight="Medium"
                           Foreground="#333"
                           Margin="0,0,0,2"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="130"/>

                <!-- 变量信息显示 -->
                <TextBlock FontSize="11" 
                           Foreground="#999"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="130">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} = {1}">
                            <Binding Path="LogicCommand.Properties[VariableName]" FallbackValue="变量名"/>
                            <Binding Path="LogicCommand.Properties[VariableValue]" FallbackValue="值"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>

            <!-- 删除按钮 -->
            <Border x:Name="DeleteButton"
        Grid.Column="2"
        Width="20"
        Height="20"
        Background="Transparent"
        VerticalAlignment="Center"
        HorizontalAlignment="Right"
        Cursor="Hand"
        MouseLeftButtonUp="DeleteButton_Click"
        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <!-- 鼠标悬停效果 - 淡灰色背景 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#10000000"/>
                                <Setter Property="CornerRadius" Value="10"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <TextBlock Text="×"
               FontSize="14"
               FontWeight="Bold"
               Foreground="#666666"
               HorizontalAlignment="Center"
               VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Style.Triggers>
                                <!-- 鼠标悬停时变深色 -->
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                    <Setter Property="Foreground" Value="#333333"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </Border>
</UserControl>