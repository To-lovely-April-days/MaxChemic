<UserControl x:Class="MaxChemical.Modules.Designer.Views.DeviceCommandPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MaxChemical.Modules.Designer.Views"
             xmlns:conv="clr-namespace:MaxChemical.Modules.Designer.Converters"
             x:Name="Root">

    <UserControl.Resources>
        <conv:NullToSourceBlocker x:Key="NullToSourceBlocker"/>

        <!-- ===== 与 IfCommandPropertiesView / LoopCommandPropertiesView 统一的样式 ===== -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#757575"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                <Setter Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox 圆角样式,与 LoopCommandPropertiesView 一致 -->
        <Style x:Key="FieldComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="9,0,28,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <Path x:Name="Arrow"
                                          Data="M 0 0 L 5 5 L 10 0"
                                          Stroke="#9E9E9E" StrokeThickness="1.5"
                                          Fill="Transparent"
                                          Width="10" Height="5"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0"
                                          StrokeLineJoin="Round"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDown"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="200">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2" Direction="270"
                                                          BlurRadius="8" Color="#000000" Opacity="0.08"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BDBDBD"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2196F3"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter TargetName="Arrow" Property="Stroke" Value="#2196F3"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0 5 L 5 0 L 10 5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#212121"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="4"
                                            Margin="4,2">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1565C0"/>
                                            <Setter Property="FontWeight" Value="Medium"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 参数行的 TextBox 样式(继承 FieldInputStyle,去掉固定高度) -->
        <Style x:Key="ParamInputStyle" TargetType="TextBox" BasedOn="{StaticResource FieldInputStyle}">
            <Setter Property="MinWidth" Value="120"/>
        </Style>

    </UserControl.Resources>

    <!-- DataContext = CommandNode(由父ContentControl传递) -->
    <Border Background="#F5F5F5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <!-- ① Header:图标 + 标题 -->
                <Border Padding="14,12"
                        Background="#F5F5F5"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,0,0,1"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- 图标 -->
                            <Border Width="38" Height="38" CornerRadius="10"
                                    Background="White" Margin="0,0,10,0">
                                <Grid Width="24" Height="24">
                                    <Image Source="{Binding DisplayImageLocation}" Stretch="Uniform" Width="22" Height="22">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="🔧" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Title, ElementName=Root}"
                                       FontSize="15" FontWeight="Medium"
                                       Foreground="#212121"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="12" Foreground="#757575"
                                   Margin="0,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- ② 设备绑定卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <!-- 区段标题 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding BindDeviceLabel, ElementName=Root}"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="#757575"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SelectDeviceLabel, ElementName=Root}" Style="{StaticResource FieldLabelStyle}"/>
                        <ComboBox
                            Style="{StaticResource FieldComboStyle}"
                            ItemsSource="{Binding DataContext.DeviceOptionsForSelectedNode, RelativeSource={RelativeSource AncestorType=views:FlowDesignerView}}"
                            SelectedValuePath="Id"
                            SelectedValue="{Binding BoundDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullToSourceBlocker}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- 已绑定设备名展示 -->
                        <Border Background="#FAFAFA"
                                BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="6" Padding="10,6"
                                Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentDeviceLabel, ElementName=Root, StringFormat='{}{0}: '}"
                                           FontSize="12" Foreground="#757575"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding BoundDeviceName}"
                                           FontSize="12" Foreground="#424242"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ③ 参数卡片 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <!-- 区段标题 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding InputParamLabel, ElementName=Root}"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="#757575"/>
                        </StackPanel>

                        <!-- 参数列表 -->
                        <ItemsControl x:Name="ParamsItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                        <TextBox Grid.Column="1"
                                                 Style="{StaticResource ParamInputStyle}"
                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 无参数时的占位提示 -->
                        <TextBlock Text="{Binding NoneParamLabel, ElementName=Root}"
                                   FontSize="12" Foreground="#BDBDBD"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeviceCommand}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ④ 摘要卡片 -->
                <Border Background="#E3F2FD"
                        BorderBrush="#BBDEFB" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="3" Height="13" CornerRadius="2"
                                    Background="#2196F3"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AbstractLabel, ElementName=Root}"
                                       FontSize="11" FontWeight="Medium"
                                       Foreground="#1565C0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ParameterSummary}"
                                   FontSize="12" Foreground="#1976D2"
                                   TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>