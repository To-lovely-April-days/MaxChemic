<UserControl x:Class="MaxChemical.Modules.Designer.Views.DeviceCommandPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MaxChemical.Modules.Designer.Views"
             xmlns:conv="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <conv:NullToSourceBlocker x:Key="NullToSourceBlocker"/>
    </UserControl.Resources>

    <!-- DataContext = CommandNode（由父ContentControl传递） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" >
            <TextBlock Text="设备命令"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#333"/>

            <!-- 设备绑定 -->
            <TextBlock Text="设备" Margin="0,12,0,4" Foreground="#666"/>
            <ComboBox
                ItemsSource="{Binding DataContext.DeviceOptionsForSelectedNode, RelativeSource={RelativeSource AncestorType=views:FlowDesignerView}}"
                DisplayMemberPath="Display"
                SelectedValuePath="Id"
                SelectedValue="{Binding BoundDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullToSourceBlocker}}"
                MinWidth="280"/>

            <!-- 已绑定设备名（只读展示） -->
            <TextBlock Text="{Binding BoundDeviceName}" Margin="0,6,0,0" Foreground="#888" FontSize="12"/>

            <Separator Margin="0,12,0,12"/>

            <TextBlock Text="参数"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#333"/>

            <!-- 参数列表 -->
            <ItemsControl x:Name="ParamsItems" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#555"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="160"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="摘要"
                       Margin="0,12,0,4"
                       Foreground="#666"/>
            <TextBlock Text="{Binding ParameterSummary}" Foreground="#444" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>