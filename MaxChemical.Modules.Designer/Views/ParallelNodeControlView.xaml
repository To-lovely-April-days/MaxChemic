<UserControl x:Class="MaxChemical.Modules.Designer.Views.ParallelNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
        <converters:StatusToIconBackgroundConverter x:Key="StatusToIconBgConverter"/>
        <converters:StatusToIconForegroundConverter x:Key="StatusToIconFgConverter"/>
        <converters:StatusToCardBackgroundConverter x:Key="StatusToCardBgConverter"/>
        <converters:StatusToCardBorderConverter x:Key="StatusToCardBorderConverter"/>
        <converters:StatusToTitleForegroundConverter x:Key="StatusToTitleFgConverter"/>
        <converters:StatusToBadgeBackgroundConverter x:Key="StatusToBadgeBgConverter"/>
        <converters:StatusToBadgeForegroundConverter x:Key="StatusToBadgeFgConverter"/>
        <converters:StatusToBadgeTextConverter x:Key="StatusToBadgeTextConverter"/>
        <converters:StatusToProgressVisibilityConverter x:Key="StatusToProgressVisConverter"/>
        <converters:StatusToDurationForegroundConverter x:Key="StatusToDurFgConverter"/>
    </UserControl.Resources>

    <!-- 整体水平布局: 主卡片 → 连线 → { → 分支行 → } -->
    <Grid x:Name="RootGrid" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- 主卡片 -->
            <ColumnDefinition Width="Auto"/>
            <!-- 左连线 -->
            <ColumnDefinition Width="Auto"/>
            <!-- 左花括号 { -->
            <ColumnDefinition Width="Auto"/>
            <!-- 分支行容器 -->
            <ColumnDefinition Width="Auto"/>
            <!-- 右花括号 } -->
        </Grid.ColumnDefinitions>

        <!-- ===== 列0: 主卡片 ===== -->
        <!-- 选中光晕 + 主卡片 -->
        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,10,0,10">
            <!-- 选中光晕 -->
            <Border Width="235" Height="70" CornerRadius="12"
                        BorderBrush="#42A5F5" BorderThickness="1.5"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Effect>
                    <DropShadowEffect Color="#2196F3" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                </Border.Effect>
            </Border>

            <Border x:Name="MainStepCard"
                    Width="231" Height="66"
                    CornerRadius="10"
                    Background="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBgConverter}}"
                    BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                    BorderThickness="1"
                    Cursor="Hand"
                    MouseDown="Node_Click"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">

                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid>
                    <!-- 底部进度条 -->
                    <Border Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            CornerRadius="0,0,10,10"
                            Visibility="{Binding ExecutionStatus, Converter={StaticResource StatusToProgressVisConverter}}">
                        <Border.Background>
                            <SolidColorBrush Color="#1976D2" Opacity="0.5"/>
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="231"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                        <Setter Property="Width" Value="150"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Border Margin="12,0,10,0" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 图标区 -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                                    VerticalAlignment="Center" Margin="0,0,10,0"
                                    Background="{Binding ExecutionStatus, Converter={StaticResource StatusToIconBgConverter}}"
                                    BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                                    BorderThickness="1">
                                <Image Source="{Binding LogicCommand.Properties[Bezel_lessIconPath]}"
                                       Width="20" Height="20" Stretch="Uniform"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 标题 + 副标题 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="{Binding DisplayName, FallbackValue='并行执行'}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToTitleFgConverter}}"
                                           TextTrimming="CharacterEllipsis"/>
                                <Grid>
                                    <!-- 默认摘要（idle 时显示） -->
                                    <TextBlock
                                   FontSize="11" Foreground="#9E9E9E"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}最大并行: {0}, 策略: {1}">
                                                <Binding Path="LogicCommand.Properties[MaxParallelCount]" FallbackValue="4"/>
                                                <Binding Path="LogicCommand.Properties[WaitStrategy]" FallbackValue="WaitAll"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 执行状态文字 -->
                                    <TextBlock FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                        <Setter Property="Foreground" Value="#1976D2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                        <Setter Property="Foreground" Value="#43A047"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Setter Property="Text" Value="{Binding ExecutionErrorMessage, FallbackValue='执行失败'}"/>
                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>


                            <!-- 右侧：Badge + 耗时 + 删除 -->
                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="3" Padding="5,2"
                            HorizontalAlignment="Right"
                            Background="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeBgConverter}}">
                                    <TextBlock Text="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeTextConverter}}"
                                   FontSize="9" FontWeight="SemiBold"
                                   Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeFgConverter}}"/>
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding ExecutionDurationText}"
                                   FontSize="10" FontWeight="Medium"
                                   Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToDurFgConverter}}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"
                                   Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Border x:Name="DeleteButton" Width="18" Height="18" Cursor="Hand"
                                Tag="{Binding}" Background="Transparent"
                                VerticalAlignment="Center"
                                MouseLeftButtonUp="DeleteButton_Click"
                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTip="删除节点">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Fill" Value="#BDBDBD"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                            <Setter Property="Fill" Value="#E53935"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 列1: 主卡片到左花括号的连线 ===== -->
        <Canvas x:Name="LeftConnectorCanvas"
                Grid.Column="1"
                Width="20"
                VerticalAlignment="Stretch"
                ClipToBounds="False">
            <Line x:Name="LeftConnectorLine"
                  X1="0" Y1="0" X2="20" Y2="0"
                  Stroke="#999"
                  StrokeThickness="1.2"/>
        </Canvas>

        <!-- ===== 列2: 左花括号 { (用Path绘制) ===== -->
        <Canvas x:Name="LeftBraceCanvas"
                Grid.Column="2"
                Width="14"
                VerticalAlignment="Stretch"
                ClipToBounds="False">
            <Path x:Name="LeftBracePath"
                  Stroke="#999"
                  StrokeThickness="1.5"
                  Fill="Transparent"/>
        </Canvas>

        <!-- ===== 列3: 分支行容器 (垂直堆叠，每行是一个水平分支) ===== -->
        <StackPanel x:Name="ParallelBranchesContainer"
                    Grid.Column="3"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    Margin="6,8,6,8">
        </StackPanel>

        <!-- ===== 列4: 右花括号 } (用Path绘制) ===== -->
        <Canvas x:Name="RightBraceCanvas"
                Grid.Column="4"
                Width="14"
                VerticalAlignment="Stretch"
                ClipToBounds="False">
            <Path x:Name="RightBracePath"
                  Stroke="#999"
                  StrokeThickness="1.5"
                  Fill="Transparent"/>
        </Canvas>
    </Grid>
</UserControl>