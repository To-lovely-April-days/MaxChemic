<UserControl x:Class="MaxChemical.Modules.Designer.Views.ParallelNodeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>
    </UserControl.Resources>

    <!-- 整体水平布局: 主卡片 → 连线 → { → 分支行 → } -->
    <Grid x:Name="RootGrid" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- 主卡片 -->
            <ColumnDefinition Width="Auto"/>
            <!-- 左连线 -->
            <ColumnDefinition Width="Auto"/>
            <!-- 左花括号 { -->
            <ColumnDefinition Width="Auto"/>
            <!-- 分支行容器 -->
            <ColumnDefinition Width="Auto"/>
            <!-- 右花括号 } -->
        </Grid.ColumnDefinitions>

        <!-- ===== 列0: 主卡片 ===== -->
        <Border x:Name="MainStepCard"
                Grid.Column="0"
                Width="231" Height="64"
                CornerRadius="6"
                Cursor="Hand"
                MouseDown="Node_Click"
                UseLayoutRounding="True"
                SnapsToDevicePixels="True"
                VerticalAlignment="Center"
                Margin="0,10,0,10"
                Style="{StaticResource ExecutingLogicNodeStyle}">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect ShadowDepth="4"
                      Direction="315"
                      BlurRadius="8"
                      Color="#000000"
                      Opacity="0.25"/>
            </Border.Effect>
            <Grid Margin="16 0 16 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 执行状态指示条 -->
                <Rectangle Grid.ColumnSpan="3"
                           Height="3" 
                           VerticalAlignment="Top"
                           Margin="-16,0,-16,0"
                           Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                           Opacity="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToOpacityConverter}}">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- 左侧图标 -->
                <Grid Grid.Column="0" Width="36" Height="27" Margin="0,0,12,0">
                    <Image Source="{Binding LogicCommand.Properties[Bezel_lessIconPath]}"
                           Width="24" 
                           Height="24"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Grid>

                <!-- 右侧文字内容 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName, FallbackValue='并行执行'}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#333"
                                   Margin="0,0,8,2"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- 执行状态圆点 -->
                        <Ellipse Width="8" Height="8" 
                                 Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,0,2">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="11"
                                   Foreground="#999"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}最大并行: {0}, 策略: {1}">
                                    <Binding Path="LogicCommand.Properties[MaxParallelCount]" FallbackValue="4"/>
                                    <Binding Path="LogicCommand.Properties[WaitStrategy]" FallbackValue="WaitAll"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- 执行时间显示 -->
                        <TextBlock Text="{Binding ExecutionDurationText}" 
                                   FontSize="9" 
                                   Foreground="#666"
                                   Margin="8,0,0,0"
                                   Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 删除按钮 -->
                <Border x:Name="DeleteButton"
                        Grid.Column="2"
                        Width="20"
                        Height="20"
                        Background="Transparent"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        MouseLeftButtonUp="DeleteButton_Click"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#10000000"/>
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock Text="×"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#666666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Foreground" Value="#333333"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ===== 列1: 主卡片到左花括号的连线 ===== -->
        <Canvas x:Name="LeftConnectorCanvas"
                Grid.Column="1"
                Width="20"
                VerticalAlignment="Stretch"
                ClipToBounds="False">
            <Line x:Name="LeftConnectorLine"
                  X1="0" Y1="0" X2="20" Y2="0"
                  Stroke="#999"
                  StrokeThickness="1.2"/>
        </Canvas>

        <!-- ===== 列2: 左花括号 { (用Path绘制) ===== -->
        <Canvas x:Name="LeftBraceCanvas"
                Grid.Column="2"
                Width="14"
                VerticalAlignment="Stretch"
                ClipToBounds="False">
            <Path x:Name="LeftBracePath"
                  Stroke="#999"
                  StrokeThickness="1.5"
                  Fill="Transparent"/>
        </Canvas>

        <!-- ===== 列3: 分支行容器 (垂直堆叠，每行是一个水平分支) ===== -->
        <StackPanel x:Name="ParallelBranchesContainer"
                    Grid.Column="3"
                    Orientation="Vertical"
                    VerticalAlignment="Center"
                    Margin="6,8,6,8">
        </StackPanel>

        <!-- ===== 列4: 右花括号 } (用Path绘制) ===== -->
        <Canvas x:Name="RightBraceCanvas"
                Grid.Column="4"
                Width="14"
                VerticalAlignment="Stretch"
                ClipToBounds="False">
            <Path x:Name="RightBracePath"
                  Stroke="#999"
                  StrokeThickness="1.5"
                  Fill="Transparent"/>
        </Canvas>
    </Grid>
</UserControl>