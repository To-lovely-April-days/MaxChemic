<!-- FlowDesignerView.xaml - 修复设备命令节点显示问题 -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.FlowDesignerView"
             x:Name="FlowDesignerRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:views="clr-namespace:MaxChemical.Modules.Designer.Views"
             Background="White">

    <UserControl.Resources>
        <!-- 转换器资源 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>

        <!-- 执行状态转换器 -->
        <converters:NodeExecutionStatusToBrushConverter x:Key="ExecutionStatusToBrushConverter"/>
        <converters:NodeExecutionStatusToOpacityConverter x:Key="ExecutionStatusToOpacityConverter"/>

      

        <!-- 自定义按钮样式 -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 设备命令节点模板 -->
        <DataTemplate x:Key="DeviceCommandNodeTemplate">
            <Border Width="231" Height="64"
            Background="White"
            CornerRadius="6"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            RenderTransformOrigin="0.5,0.5"
            Style="{StaticResource ExecutingDeviceNodeStyle}">

                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid>
                    <!-- 顶部执行状态条 -->
                    <Rectangle Height="3"
                       VerticalAlignment="Top"
                       Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
                       Opacity="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToOpacityConverter}}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <!-- 主体区域：点击即弹出绑定+参数编辑窗 -->
                    <Border Margin="16,0,16,0"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonDown="DeviceNode_SelectClick">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧图标 -->
                            <Grid Grid.Column="0"
                          Width="32" Height="32"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0">

                                <Image Source="{Binding DisplayImageLocation}" Stretch="Uniform" Width="26" Height="26">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <Border Width="26" Height="26" Background="#6CB6FF" CornerRadius="13">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="🔧" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- 中间标题 + 参数摘要 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock Text="{Binding DisplayName}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="#333"
                                   TextTrimming="CharacterEllipsis"/>

                                <!-- 参数摘要：使用 StringToVisibilityConverter 控制显示 -->
                                <TextBlock Text="{Binding ParameterSummary}"
                                   FontSize="10"
                                   Foreground="#777"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding ParameterSummary, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>

                            <!-- 右侧：执行/停止按钮 + 状态点/耗时 -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                <!-- 执行/停止切换按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Width="24" Height="24" Margin="0,0,4,0"
                Tag="{Binding}"
                Click="DeviceNode_ExecuteToggleClick">

                                        <!-- 只设置一次Style，移除重复的Style属性 -->
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                                                <!-- 默认状态：执行按钮 -->
                                                <Setter Property="ToolTip" Value="执行该命令"/>
                                                <Setter Property="IsEnabled" Value="{Binding HasDeviceBinding}"/>

                                                <Style.Triggers>
                                                    <!-- 正在执行状态：显示停止按钮 -->
                                                    <DataTrigger Binding="{Binding IsManualExecuting}" Value="True">
                                                        <Setter Property="ToolTip" Value="停止该命令"/>
                                                        <Setter Property="IsEnabled" Value="True"/>
                                                    </DataTrigger>

                                                    <!-- 未绑定设备状态：禁用按钮 -->
                                                    <DataTrigger Binding="{Binding HasDeviceBinding}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="ToolTip" Value="请先绑定设备"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <!-- 按钮内容：根据执行状态切换图片 -->
                                        <Image Width="22" Height="22" Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <!-- 默认：执行图标 -->
                                                    <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/Icon/play.png"/>
                                                    <Setter Property="Opacity" Value="1"/>

                                                    <Style.Triggers>
                                                        <!-- 正在执行：停止图标 -->
                                                        <DataTrigger Binding="{Binding IsManualExecuting}" Value="True">
                                                            <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/Icon/stop.png"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>

                                                        <!-- 未绑定设备：禁用状态，图标变灰 -->
                                                        <DataTrigger Binding="{Binding HasDeviceBinding}" Value="False">
                                                            <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/Icon/play_disabled.png"/>
                                                            <Setter Property="Opacity" Value="0.5"/>
                                                        </DataTrigger>

                                                        <!-- 执行状态的优先级更高 -->
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsManualExecuting}" Value="True"/>
                                                                <Condition Binding="{Binding HasDeviceBinding}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/Icon/stop.png"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Button>
                                </StackPanel>

                                <!-- 耗时 -->
                                <TextBlock Text="{Binding ExecutionDurationText}"
               FontSize="9"
               Foreground="#666"
               HorizontalAlignment="Right"
               Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- 状态圆点 -->
                                <Ellipse Width="8" Height="8"
             Fill="{Binding ExecutionStatus, Converter={StaticResource ExecutionStatusToBrushConverter}}"
             HorizontalAlignment="Right"
             Margin="0,2,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右上角 小黄点：未绑定提示 -->
                    <Ellipse Width="8" Height="8"
                     Fill="Gold"
                     Stroke="DarkGoldenrod"
                     StrokeThickness="1"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,7,28,0"
                     ToolTip="未绑定设备，点击进行绑定"
                     Panel.ZIndex="11">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NeedsBinding}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- 删除按钮（保持你的原逻辑） -->
                    <Border x:Name="DeleteButton"
                    Width="20" Height="20"
                    Background="Transparent"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,5,5,0"
                    Cursor="Hand"
                    Tag="{Binding}"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                    MouseLeftButtonUp="DeviceNode_DeleteClick">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#10000000"/>
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="×"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 右侧属性栏用的 DataTemplate：设备命令 -->
        <DataTemplate x:Key="DeviceCommandPropertiesTemplate">
            <views:DeviceCommandPropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="IfCommandPropertiesTemplate">
            <views:IfCommandPropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="LoopCommandPropertiesTemplate">
            <views:LoopCommandPropertiesView/>
        </DataTemplate>
        <!-- 右侧属性栏用的 DataTemplate：并行命令 -->
        <DataTemplate x:Key="ParallelCommandPropertiesTemplate">
            <views:ParallelCommandPropertiesView/>
        </DataTemplate>
        <!-- 等待命令属性模板 -->
        <DataTemplate x:Key="WaitCommandPropertiesTemplate">
            <views:WaitPropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="SetVariableCommandPropertiesTemplate">
            <views:SetVariablePropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="DefaultPropertiesTemplate">
            <Border Background="#FFF9F9F9" Padding="16">
                <StackPanel>
                    <TextBlock Text="属性"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#333"/>
                    <TextBlock Text="请选择一个节点以编辑属性。"
                               Margin="0,8,0,0"
                               Foreground="#777"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        
        
    </UserControl.Resources>

    <Grid>
        <!-- 画布外边框 -->
        <Rectangle Fill="White"
                   Stroke="#BCBCBC"
                   StrokeThickness="1"
                   StrokeDashArray="8,8"
                   RadiusX="4"
                   RadiusY="4"/>

        <!-- 两列：左=画布，右=属性栏 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- 顶部工具栏区域 -->
            <Border  Grid.ColumnSpan="2" Height="72" VerticalAlignment="Top">
                <Border.Background>
                    <SolidColorBrush Color="#EEEEEE" Opacity="0.27"/>
                </Border.Background>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="10">

                    <!-- 流程控制图标 -->
                    <Image Source="pack://siteoforigin:,,,/Resources/CommadIcon/control.png" 
                           Width="27" Height="22"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                    <TextBlock Text="流程控制:" 
                               FontSize="14"
                               Foreground="#747474"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- 动态生成的工具按钮 -->
                    <ItemsControl ItemsSource="{Binding LogicCommandPlugins}" 
                                  x:Name="ToolbarItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding ToolbarButton}"
                                                  Margin="0,0,16,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 管理按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <Button Command="{Binding ValidateAllNodesCommand}"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="验证所有节点配置"
                                Margin="0,0,8,0">
                            <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"
                                  Fill="#4CAF50"
                                  Width="20" Height="20"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Command="{Binding RefreshPluginsCommand}"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="刷新插件"
                                Margin="0,0,0,0">
                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Fill="#2196F3"
                                  Width="20" Height="20"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 主要内容区域 -->
            <!-- 滚动视图包装画布 -->
            <ScrollViewer x:Name="CanvasScrollViewer" 
                          Margin="0,72,0,0"
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Visible"
                          Background="Transparent"
                          CanContentScroll="False"
                          PanningMode="Both"
                          Style="{StaticResource ThinScrollViewerStyle}">

                <!-- 画布容器 - 移除固定尺寸绑定，改用MinWidth和MinHeight -->
                <Grid x:Name="CanvasContainer"  
                      Width="{Binding CanvasWidth}"
                      Height="{Binding CanvasHeight}"
                      MinWidth="1200" 
                      MinHeight="800"
                      Background="Transparent">

                    <!-- 主容器，支持拖放 -->
                    <Grid AllowDrop="True"
                          Drop="Canvas_Drop"
                          DragOver="Canvas_DragOver"
                          DragLeave="Canvas_DragLeave"
                          SizeChanged="MainGrid_SizeChanged">

                        <!-- 标题 -->
                        <TextBlock Text="步骤流程编辑" 
                                   FontSize="16" 
                                   FontWeight="Normal"
                                   Foreground="#999"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,10,0,0"/>

                        <!-- 画布内容 -->
                        <Canvas x:Name="DesignCanvas"
                                Background="Transparent"
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                Margin="0,35,0,0"
                                 MouseDown="CanvasHost_MouseDown">

                            <!-- 流程启动节点 - ZIndex=10 -->
                            <Border x:Name="StartNode"
                                    Canvas.Left="{Binding StartNodeX}"
                                    Canvas.Top="{Binding StartNodeY}"
                                    Panel.ZIndex="10"
                                    Width="231" Height="64"
                                    Background="White"
                                    CornerRadius="6"
                                    Cursor="Arrow">
                                <!-- 启动节点内容保持不变 -->
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="4"
                                                      Direction="315"
                                                      BlurRadius="8"
                                                      Color="#000000"
                                                      Opacity="0.25"/>
                                </Border.Effect>

                                <Grid Margin="16" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧图标 -->
                                    <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                                        <Ellipse Width="24" Height="23" Fill="#6CB6FF"/>
                                        <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" 
                                              Fill="White" 
                                              Width="12" Height="12"
                                              Margin="2,0,0,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="Uniform"/>
                                    </Grid>

                                    <!-- 右侧文字内容 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="流程启动" 
                                                   FontSize="14" 
                                                   FontWeight="Medium"
                                                   Foreground="#333"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="初始化执行环境" 
                                                   FontSize="11" 
                                                   Foreground="#999"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 命令节点集合 - ZIndex=10，确保节点在连接线之上 -->
                            <ItemsControl ItemsSource="{Binding CommandNodes}"
                                          Panel.ZIndex="10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="10" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              RenderTransformOrigin="0.5,0.5">

                                            <!-- 设置RenderTransform用于动画 -->
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                    <TranslateTransform X="0" Y="0"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>

                                            <!-- 逻辑节点高亮样式（保持不变） -->
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <!-- 插入高亮状态 - 为逻辑命令节点添加高亮效果 -->
                                                        <DataTrigger Binding="{Binding IsInsertHighlight}" Value="True">
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect ShadowDepth="0"
                                                      Direction="0"
                                                      BlurRadius="20"
                                                      Color="#186DF5"
                                                      Opacity="0.5"/>
                                                                </Setter.Value>
                                                            </Setter>

                                                            <!-- 逻辑节点的高亮动画 -->
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.02" Duration="0:0:0.3"
                                                         DecelerationRatio="0.6"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.02" Duration="0:0:0.3"
                                                         DecelerationRatio="0.6"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-3" Duration="0:0:0.3"
                                                         DecelerationRatio="0.6"/>
                                                                        <!-- 发光脉冲效果 -->
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         From="0.5" To="0.8" Duration="0:0:0.8"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>

                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.3"
                                                         AccelerationRatio="0.3"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.3"
                                                         AccelerationRatio="0.3"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.3"
                                                         AccelerationRatio="0.3"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <!-- 插件创建的逻辑命令节点控件 -->
                                            <ContentPresenter Content="{Binding NodeControl}"
                              PreviewMouseLeftButtonDown="NodeControl_PreviewMouseLeftButtonDown"
                              Visibility="{Binding NodeControl, Converter={StaticResource StringToVisibilityConverter}}">
                                                <ContentPresenter.Style>
                                                    <Style TargetType="ContentPresenter">
                                                        <EventSetter Event="Loaded" Handler="ComplexNodeControl_Loaded"/>
                                                    </Style>
                                                </ContentPresenter.Style>
                                            </ContentPresenter>

                                            <!-- 默认的设备命令节点模板 -->
                                            <ContentPresenter ContentTemplate="{StaticResource DeviceCommandNodeTemplate}"
                              Content="{Binding}">
                                                <ContentPresenter.Style>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeviceCommand}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NodeControl}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentPresenter.Style>
                                            </ContentPresenter>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 连接线集合 - ZIndex=5，确保连接线在节点之下但在背景之上 -->
                            <ItemsControl ItemsSource="{Binding Connections}"
                                          Panel.ZIndex="5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="5" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 连接线模板 -->
                                        <Canvas Width="10" Height="{Binding TotalHeight}">
                                            <!-- 竖直线 -->
                                            <Rectangle Fill="#979797" 
                                                       Width="1" 
                                                       Height="{Binding LineLength}"
                                                       Canvas.Left="4"
                                                       Canvas.Top="0"/>
                                            <!-- 向下箭头 -->
                                            <Path Data="M0,0 L8,0 L4,8 Z" 
                                                  Fill="#979797" 
                                                  Canvas.Left="1"
                                                  Canvas.Top="{Binding ArrowTop}"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <!-- 右侧属性栏 -->
            <Border x:Name="PropertyPanelRoot" Grid.Column="1"
                    Margin="0,72,0,0"
                    Background="#FFFFFFFF"
                    BorderBrush="#E5E5E5"
                    BorderThickness="1,0,0,0"
                    MouseDown="PropertyPanelRoot_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 属性栏标题 -->
                    <Border Background="#F7F7F9" Padding="12,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="属性"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#333"/>
                            <TextBlock Text="{Binding SelectedNode.DisplayName}"
                                       FontSize="12"
                                       Foreground="#666"
                                       Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- 属性内容：根据 SelectedNode 类型切换模板 -->
                    <ContentControl Grid.Row="1"
                Content="{Binding SelectedNode}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <!-- 基础样式 -->
                                <Setter Property="Background" Value="#FAFBFC"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="ContentTemplate" Value="{StaticResource DefaultPropertiesTemplate}"/>

                                <!-- 添加过渡动画 -->
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="0"/>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <!-- 设备命令 -->
                                    <DataTrigger Binding="{Binding SelectedNode.IsDeviceCommand}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource DeviceCommandPropertiesTemplate}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="20" To="0" Duration="0:0:0.2"
                                                 DecelerationRatio="0.8"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>

                                    <!-- IF命令 -->
                                    <DataTrigger Binding="{Binding SelectedNode.IsIfNode}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource IfCommandPropertiesTemplate}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="20" To="0" Duration="0:0:0.2"
                                                 DecelerationRatio="0.8"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>

                                    <!-- 循环命令 -->
                                    <DataTrigger Binding="{Binding SelectedNode.IsLoopNode}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource LoopCommandPropertiesTemplate}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="20" To="0" Duration="0:0:0.2"
                                                 DecelerationRatio="0.8"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>

                                    <!-- 并行命令 -->
                                    <DataTrigger Binding="{Binding SelectedNode.IsParallelNode}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource ParallelCommandPropertiesTemplate}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="20" To="0" Duration="0:0:0.2"
                                                 DecelerationRatio="0.8"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>

                                    <!-- 设置变量命令 -->
                                    <DataTrigger Binding="{Binding SelectedNode.IsSetVariableNode}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource SetVariableCommandPropertiesTemplate}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="20" To="0" Duration="0:0:0.2"
                                                 DecelerationRatio="0.8"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>

                                    <!-- 等待命令 -->
                                    <DataTrigger Binding="{Binding SelectedNode.IsWaitNode}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource WaitCommandPropertiesTemplate}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="20" To="0" Duration="0:0:0.2"
                             DecelerationRatio="0.8"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.8" To="1.0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 空状态提示 -->
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    x:Name="EmptyStatePanel"
                    Visibility="Collapsed">
            <!-- 空状态内容 -->
        </StackPanel>
    </Grid>
</UserControl>