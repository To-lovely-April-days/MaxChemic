<!-- FlowDesignerView.xaml - 水平流程布局 + 泳道图 -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.FlowDesignerView"
             x:Name="FlowDesignerRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:views="clr-namespace:MaxChemical.Modules.Designer.Views"
             Background="White">

    <UserControl.Resources>
        <!-- 转换器资源 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>

        <converters:StatusToIconBackgroundConverter x:Key="StatusToIconBgConverter"/>
        <converters:StatusToIconForegroundConverter x:Key="StatusToIconFgConverter"/>
        <converters:StatusToCardBackgroundConverter x:Key="StatusToCardBgConverter"/>
        <converters:StatusToCardBorderConverter x:Key="StatusToCardBorderConverter"/>
        <converters:StatusToTitleForegroundConverter x:Key="StatusToTitleFgConverter"/>
        <converters:StatusToSubtitleForegroundConverter x:Key="StatusToSubFgConverter"/>
        <converters:StatusToBadgeBackgroundConverter x:Key="StatusToBadgeBgConverter"/>
        <converters:StatusToBadgeForegroundConverter x:Key="StatusToBadgeFgConverter"/>
        <converters:StatusToBadgeTextConverter x:Key="StatusToBadgeTextConverter"/>
        <converters:StatusToProgressVisibilityConverter x:Key="StatusToProgressVisConverter"/>
        <converters:StatusToProgressBrushConverter x:Key="StatusToProgressBrushConverter"/>
        <converters:StatusToDurationForegroundConverter x:Key="StatusToDurFgConverter"/>

        <!-- 自定义按钮样式 -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设备命令节点模板 -->
        <DataTemplate x:Key="DeviceCommandNodeTemplate">
            <!-- 外层选中指示框（选中时显示蓝色边框+阴影） -->
            <Grid>
                <!-- 选中高亮边框（在卡片下方，通过更大的圆角和阴影形成选中效果） -->
                <Border Width="235" Height="70"
                        CornerRadius="12"
                        BorderBrush="#42A5F5"
                        BorderThickness="1.5"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border.Effect>
                        <DropShadowEffect Color="#2196F3" BlurRadius="8" ShadowDepth="0" Opacity="0.25"/>
                    </Border.Effect>
                </Border>

                <!-- 主卡片 -->
                <Border Width="231" Height="66"
                        CornerRadius="10"
                        Background="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBgConverter}}"
                        BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                        BorderThickness="1"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        RenderTransformOrigin="0.5,0.5"
                        SnapsToDevicePixels="True"
                        UseLayoutRounding="True"
                        Style="{StaticResource ExecutingDeviceNodeStyle}">

                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Border.RenderTransform>

                    <Grid>
                        <!-- ① 底部进度条 -->
                        <Border Height="2"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            CornerRadius="0,0,10,10"
                            Visibility="{Binding ExecutionStatus, Converter={StaticResource StatusToProgressVisConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="#1976D2" Opacity="0.5"/>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="231"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                            <Setter Property="Width" Value="150"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- ② 主体区域 -->
                        <Border Margin="12,0,10,0"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="DeviceNode_SelectClick">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 左侧图标区：圆角方块，状态变色 -->
                                <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="9"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0"
                                    Background="{Binding ExecutionStatus, Converter={StaticResource StatusToIconBgConverter}}"
                                    BorderBrush="{Binding ExecutionStatus, Converter={StaticResource StatusToCardBorderConverter}}"
                                    BorderThickness="1">
                                    <Grid>
                                        <!-- 有自定义图标时显示 -->
                                        <Image Source="{Binding DisplayImageLocation}"
                                           Stretch="Uniform" Width="20" Height="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>

                                        <!-- 无自定义图标时显示齿轮 SVG Path -->
                                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Width="18" Height="18" Stretch="Uniform"
                                          Fill="{Binding ExecutionStatus, Converter={StaticResource StatusToIconFgConverter}}"
                                          Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Grid>
                                </Border>

                                <!-- 中间：命令名称 + 参数摘要/状态文字 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding DisplayName}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToTitleFgConverter}}"
                                           TextTrimming="CharacterEllipsis"/>

                                    <!-- 执行中/完成/失败时显示状态文字，否则显示参数摘要 -->
                                    <TextBlock FontSize="11" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding ParameterSummary}"/>
                                                <Setter Property="Foreground" Value="#9E9E9E"/>
                                                <Setter Property="Visibility" Value="{Binding ParameterSummary, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Executing">
                                                        <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                        <Setter Property="Foreground" Value="#1976D2"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Completed">
                                                        <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                        <Setter Property="Foreground" Value="#43A047"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Failed">
                                                        <Setter Property="Text" Value="{Binding ExecutionErrorMessage, FallbackValue='执行失败'}"/>
                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ExecutionStatus}" Value="Waiting">
                                                        <Setter Property="Text" Value="{Binding ExecutionStatusText}"/>
                                                        <Setter Property="Foreground" Value="#FF9800"/>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- 右侧：运行按钮 + Badge / 删除按钮 -->
                                <Grid Grid.Column="2" VerticalAlignment="Center"
                                  Margin="4,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 上行：运行/停止按钮 + Badge -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                        <!-- 状态 Badge -->
                                        <Border CornerRadius="3"
                                            Padding="5,2"
                                            VerticalAlignment="Center"
                                            Margin="0,0,6,0"
                                            Background="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeBgConverter}}">
                                            <TextBlock Text="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeTextConverter}}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToBadgeFgConverter}}"/>
                                        </Border>

                                        <!-- 执行/停止按钮 -->
                                        <Button Width="24" Height="24"
                                            Tag="{Binding}"
                                            Click="DeviceNode_ExecuteToggleClick"
                                            VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
                                                    <Setter Property="ToolTip" Value="执行该命令"/>
                                                    <Setter Property="IsEnabled" Value="{Binding HasDeviceBinding}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsManualExecuting}" Value="True">
                                                            <Setter Property="ToolTip" Value="停止该命令"/>
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasDeviceBinding}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False"/>
                                                            <Setter Property="ToolTip" Value="请先绑定设备"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Image Width="18" Height="18" Stretch="Uniform">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/Icon/play.png"/>
                                                        <Setter Property="Opacity" Value="1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsManualExecuting}" Value="True">
                                                                <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/Icon/stop.png"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasDeviceBinding}" Value="False">
                                                                <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/Icon/play_disabled.png"/>
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsManualExecuting}" Value="True"/>
                                                                    <Condition Binding="{Binding HasDeviceBinding}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Source" Value="pack://siteoforigin:,,,/Resources/Icon/stop.png"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Button>
                                    </StackPanel>

                                    <!-- 下行：耗时 / 删除按钮（选中时） -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,2,0,0">

                                        <!-- 耗时 -->
                                        <TextBlock Text="{Binding ExecutionDurationText}"
                                               FontSize="10" FontWeight="Medium"
                                               Foreground="{Binding ExecutionStatus, Converter={StaticResource StatusToDurFgConverter}}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,4,0"
                                               Visibility="{Binding ShowExecutionDuration, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- 删除按钮（仅选中时显示）：透明背景 + 垃圾桶图标 -->
                                        <Border Width="18" Height="18"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            Background="Transparent"
                                            VerticalAlignment="Center"
                                            MouseLeftButtonUp="DeviceNode_DeleteClick"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="删除节点">
                                            <Path Width="12" Height="12" Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="#BDBDBD"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                <Setter Property="Fill" Value="#E53935"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ③ 未绑定警告角标 -->
                        <Border Width="16" Height="16"
                            CornerRadius="8"
                            Background="#FFF3E0"
                            BorderBrush="#FFE0B2"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="4,4,0,0"
                            ToolTip="未绑定设备，点击进行绑定"
                            Panel.ZIndex="11">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsBinding}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="!" FontSize="10" FontWeight="Bold"
                                   Foreground="#E65100"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>


        <!-- 右侧属性栏用的 DataTemplate -->
        <DataTemplate x:Key="DeviceCommandPropertiesTemplate">
            <views:DeviceCommandPropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="IfCommandPropertiesTemplate">
            <views:IfCommandPropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="LoopCommandPropertiesTemplate">
            <views:LoopCommandPropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="ParallelCommandPropertiesTemplate">
            <views:ParallelCommandPropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="WaitCommandPropertiesTemplate">
            <views:WaitPropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="SetVariableCommandPropertiesTemplate">
            <views:SetVariablePropertiesView/>
        </DataTemplate>
        <DataTemplate x:Key="DefaultPropertiesTemplate">
            <Border Background="#F5F5F5">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="0,80,0,0">
                    <!-- 空状态图标 -->
                    <Border Width="64" Height="64" CornerRadius="32"
                            Background="White"
                            BorderBrush="#E0E0E0" BorderThickness="1"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock Text="⚙" FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#BDBDBD"/>
                    </Border>
                    <TextBlock Text="未选择节点"
                               FontSize="14" FontWeight="Medium"
                               Foreground="#757575"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="点击画布中的节点以编辑属性"
                               FontSize="12"
                               Foreground="#BDBDBD"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <!-- 画布外边框 -->
        <Rectangle Fill="White"
                   Stroke="#BCBCBC"
                   StrokeThickness="1"
                   StrokeDashArray="8,8"
                   RadiusX="4"
                   RadiusY="4"/>

        <!--
            外层布局：
            - 2列：左=画布区域、右=属性栏
            - 2行：上=工具栏+画布、下=泳道图
            - 右侧属性栏 RowSpan="2" 占满两行高度
        -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <!-- 上方：工具栏 + 画布 -->
                <RowDefinition Height="5" />        <!-- GridSplitter 占用的行 -->
                <RowDefinition Height="200" MinHeight="260" />
                <!-- 下方：泳道图，可拖拽调整 -->
            </Grid.RowDefinitions>

            <!-- ==================== 顶部工具栏（跨两列，固定在顶部） ==================== -->
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Height="72" VerticalAlignment="Top"
                    Panel.ZIndex="20">
                <Border.Background>
                    <SolidColorBrush Color="#EEEEEE" Opacity="0.27"/>
                </Border.Background>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="10">

                    <Image Source="pack://siteoforigin:,,,/Resources/CommadIcon/control.png"
                           Width="27" Height="22"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                    <TextBlock Text="流程控制:"
                               FontSize="14"
                               Foreground="#747474"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <ItemsControl ItemsSource="{Binding LogicCommandPlugins}"
                                  x:Name="ToolbarItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding ToolbarButton}"
                                                  Margin="0,0,16,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <Button Command="{Binding ValidateAllNodesCommand}"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="验证所有节点配置"
                                Margin="0,0,8,0">
                            <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"
                                  Fill="#4CAF50" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Command="{Binding RefreshPluginsCommand}"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="刷新插件">
                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Fill="#2196F3" Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== 左上：画布 ScrollViewer（Row=0, Column=0） ==================== -->
            <ScrollViewer x:Name="CanvasScrollViewer"
                          Grid.Row="0" Grid.Column="0"
                          Margin="0,72,0,0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent"
                          CanContentScroll="False"
                          PanningMode="Both"
                          Style="{StaticResource ThinScrollViewerStyle}">

                <Grid x:Name="CanvasContainer"
                      Width="{Binding CanvasWidth}"
                      Height="{Binding CanvasHeight}"
                      MinWidth="1200"
                      MinHeight="600"
                      Background="Transparent">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>

                    <Grid AllowDrop="True"
                          Drop="Canvas_Drop"
                          DragOver="Canvas_DragOver"
                          DragLeave="Canvas_DragLeave"
                          SizeChanged="MainGrid_SizeChanged">

                        <!-- 标题 -->
                        <TextBlock Text="步骤流程编辑"
                                   FontSize="16"
                                   FontWeight="Normal"
                                   Foreground="#999"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,10,0,0"/>

                        <!-- 画布内容 -->
                        <Canvas x:Name="DesignCanvas"
                                Background="Transparent"
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                Margin="0,35,0,0"
                                MouseDown="CanvasHost_MouseDown">

                            <!-- 流程启动节点 -->
                            <Border x:Name="StartNode"
                                    Canvas.Left="{Binding StartNodeX}"
                                    Canvas.Top="{Binding StartNodeY}"
                                    Panel.ZIndex="10"
                                    Width="231" Height="64"
                                    Background="White"
                                    CornerRadius="6"
                                    Cursor="Arrow">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="4"
                                                      Direction="315"
                                                      BlurRadius="8"
                                                      Color="#000000"
                                                      Opacity="0.25"/>
                                </Border.Effect>

                                <Grid Margin="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                                        <Ellipse Width="24" Height="23" Fill="#6CB6FF"/>
                                        <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                              Fill="White"
                                              Width="12" Height="12"
                                              Margin="2,0,0,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="Uniform"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="流程启动"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Foreground="#333"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="初始化执行环境"
                                                   FontSize="11"
                                                   Foreground="#999"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 命令节点集合 - ZIndex=10 -->
                            <ItemsControl ItemsSource="{Binding CommandNodes}"
                                          Panel.ZIndex="10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="10" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                              RenderTransformOrigin="0.5,0.5">

                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                    <TranslateTransform X="0" Y="0"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>

                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInsertHighlight}" Value="True">
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect ShadowDepth="0"
                                                                                      Direction="0"
                                                                                      BlurRadius="20"
                                                                                      Color="#186DF5"
                                                                                      Opacity="0.5"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                         To="1.02" Duration="0:0:0.3" DecelerationRatio="0.6"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                         To="1.02" Duration="0:0:0.3" DecelerationRatio="0.6"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                         To="-3" Duration="0:0:0.3" DecelerationRatio="0.6"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                         From="0.5" To="0.8" Duration="0:0:0.8"
                                                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                         To="1.0" Duration="0:0:0.3" AccelerationRatio="0.3"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                         To="1.0" Duration="0:0:0.3" AccelerationRatio="0.3"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                         To="0" Duration="0:0:0.3" AccelerationRatio="0.3"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <!-- 插件创建的逻辑命令节点控件 -->
                                            <ContentPresenter Content="{Binding NodeControl}"
                                                              PreviewMouseLeftButtonDown="NodeControl_PreviewMouseLeftButtonDown"
                                                              Visibility="{Binding NodeControl, Converter={StaticResource StringToVisibilityConverter}}">
                                                <ContentPresenter.Style>
                                                    <Style TargetType="ContentPresenter">
                                                        <EventSetter Event="Loaded" Handler="ComplexNodeControl_Loaded"/>
                                                    </Style>
                                                </ContentPresenter.Style>
                                            </ContentPresenter>

                                            <!-- 默认设备命令节点模板 -->
                                            <ContentPresenter ContentTemplate="{StaticResource DeviceCommandNodeTemplate}"
                                                              Content="{Binding}">
                                                <ContentPresenter.Style>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeviceCommand}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NodeControl}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentPresenter.Style>
                                            </ContentPresenter>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 连接线集合 - ZIndex=5，水平箭头方向 -->
                            <ItemsControl ItemsSource="{Binding Connections}"
                                          Panel.ZIndex="5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="5" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <!-- 水平连接线模板：TotalHeight 字段复用为总宽度 -->
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas Width="{Binding TotalHeight}" Height="10">
                                            <!-- 水平线 -->
                                            <Rectangle Fill="#979797"
                                                       Width="{Binding LineLength}"
                                                       Height="1"
                                                       Canvas.Left="0"
                                                       Canvas.Top="4"/>
                                            <!-- 向右箭头三角形 -->
                                            <Path Data="M0,0 L0,8 L8,4 Z"
                                                  Fill="#979797"
                                                  Canvas.Left="{Binding ArrowTop}"
                                                  Canvas.Top="1"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </Canvas>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="0" Grid.Column="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,16,16"
                    Panel.ZIndex="30"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4,2">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" Direction="270" BlurRadius="6"
                                      Color="#000000" Opacity="0.08"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- 缩小 -->
                    <Button Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="缩小 (Ctrl+-)"
                            Click="ZoomOut_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M19,13H5V11H19V13Z" Fill="#757575" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- 缩放百分比 -->
                    <Border Width="48" Height="24" Margin="2,0">
                        <TextBlock x:Name="ZoomLevelText"
                                   Text="100%"
                                   FontSize="11"
                                   Foreground="#424242"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- 放大 -->
                    <Button Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="放大 (Ctrl++)"
                            Click="ZoomIn_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="#757575" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- 分隔线 -->
                    <Rectangle Width="1" Height="16" Fill="#E8E8E8" Margin="2,0"/>

                    <!-- 自适应 -->
                    <Button Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="自适应画布 (Ctrl+0)"
                            Click="ZoomFit_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M3,5V19H21V5H3M5,7H19V17H5V7M7,9V15H17V9H7Z" Fill="#757575" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- 还原100% -->
                    <Button Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="还原 100% (Ctrl+1)"
                            Click="ZoomReset_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="1:1" FontSize="10" Foreground="#757575" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ==================== GridSplitter 分割条 ==================== -->
            <GridSplitter Grid.Row="1" Grid.Column="0"
              Height="5"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center"
              Background="#E0E0E0"
              ShowsPreview="False"
              Cursor="SizeNS"/>
            <!-- ══ 泳道图（Row=1, Column=0） ══ -->
            <Border Grid.Row="2" Grid.Column="0"
            BorderBrush="#E8E8E8" BorderThickness="0,1,0,0"
            Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ══ 顶栏（紧凑：padding 缩小，单行布局） ══ -->
                    <Border Grid.Row="0" Padding="14,6"
                    BorderBrush="#EBEBEB" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="执行记录"
                               FontSize="12" FontWeight="Medium" Foreground="#424242"
                               VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="0" FontSize="10" Foreground="#BDBDBD"
                               VerticalAlignment="Center" Margin="56,0,0,0"
                               Text="{Binding SwimlaneRows.Count, StringFormat='({0}步)'}"/>

                            <!-- 状态计数（纯文字，无 Badge 背景） -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Text="{Binding CompletedCount, StringFormat='{}{0}'}"/>
                                <Ellipse Width="5" Height="5" Fill="#2196F3" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Text="{Binding ExecutingCount, StringFormat='{}{0}'}"/>
                                <Ellipse Width="5" Height="5" Fill="#EF5350" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Text="{Binding FailedCount, StringFormat='{}{0}'}"/>
                                <Ellipse Width="5" Height="5" Fill="#BDBDBD" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <TextBlock FontSize="10" Foreground="#BDBDBD" VerticalAlignment="Center"
                                   Text="{Binding IdleCount, StringFormat='{}{0}'}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ══ 列头（高度压缩） ══ -->
                    <Border Grid.Row="1" BorderBrush="#EBEBEB" BorderThickness="0,0,0,1" Height="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="步骤" FontSize="9" Foreground="#BDBDBD" Padding="12,0" VerticalAlignment="Center"/>
                            <Canvas Grid.Column="1" ClipToBounds="True">
                                <TextBlock Canvas.Left="3"   Canvas.Top="3" Text="0s"  FontSize="8" Foreground="#BDBDBD"/>
                                <TextBlock Canvas.Left="107" Canvas.Top="3" Text="2s"  FontSize="8" Foreground="#BDBDBD"/>
                                <TextBlock Canvas.Left="211" Canvas.Top="3" Text="4s"  FontSize="8" Foreground="#BDBDBD"/>
                                <TextBlock Canvas.Left="315" Canvas.Top="3" Text="6s"  FontSize="8" Foreground="#BDBDBD"/>
                                <TextBlock Canvas.Left="419" Canvas.Top="3" Text="8s"  FontSize="8" Foreground="#BDBDBD"/>
                                <TextBlock Canvas.Left="523" Canvas.Top="3" Text="10s" FontSize="8" Foreground="#BDBDBD"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- ══ 数据行（行高 48px，条块高 18px） ══ -->
                    <ScrollViewer Grid.Row="2" Style="{StaticResource ThinScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SwimlaneRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F5F5F5" BorderThickness="0,0,0,1" Height="48">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FAFCFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 名称列 -->
                                            <Border Grid.Column="0" BorderBrush="#F0F0F0" BorderThickness="0,0,1,0" Padding="10,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                                        <Setter Property="Background" Value="#F1F8E9"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#2196F3"/>
                                                                        <Setter Property="Background" Value="#E8F4FD"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#EF5350"/>
                                                                        <Setter Property="Background" Value="#FFF5F5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding RowIndexDisplay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="10" FontWeight="Medium">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#BDBDBD"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                                                            <Setter Property="Foreground" Value="#2196F3"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                            <Setter Property="Foreground" Value="#EF5350"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NodeName}" FontSize="11" FontWeight="Medium"
                                                           Foreground="#424242" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="115" ToolTip="{Binding NodeName}"/>
                                                        <TextBlock Text="{Binding NodeType}" FontSize="9" Foreground="#BDBDBD" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- 轨道列 -->
                                            <Canvas Grid.Column="1" ClipToBounds="True">
                                                <!-- 网格线 -->
                                                <Rectangle Canvas.Left="104" Width="0.5" Height="48" Fill="#F5F5F5"/>
                                                <Rectangle Canvas.Left="208" Width="0.5" Height="48" Fill="#F5F5F5"/>
                                                <Rectangle Canvas.Left="312" Width="0.5" Height="48" Fill="#F5F5F5"/>
                                                <Rectangle Canvas.Left="416" Width="0.5" Height="48" Fill="#F5F5F5"/>
                                                <Rectangle Canvas.Left="520" Width="0.5" Height="48" Fill="#F5F5F5"/>

                                                <!-- 时间范围（条块上方，单行合并） -->
                                                <TextBlock Canvas.Left="{Binding BarLeft}" Canvas.Top="4"
                                                   Text="{Binding TimeRangeText}"
                                                   FontSize="8" FontFamily="Consolas"
                                                   Visibility="{Binding TimeRangeText, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#BDBDBD"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#A5D6A7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                                                    <Setter Property="Foreground" Value="#90CAF9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="#EF9A9A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 左刻度线 -->
                                                <Rectangle Canvas.Left="{Binding BarLeft}" Canvas.Top="16" Width="0.5" Height="24"
                                                   Visibility="{Binding StartTimeText, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="#E8E8E8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Fill" Value="#C8E6C9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                                                    <Setter Property="Fill" Value="#BBDEFB"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Fill" Value="#FFCDD2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>

                                                <!-- 右刻度线 -->
                                                <Rectangle Canvas.Left="{Binding BarRight}" Canvas.Top="16" Width="0.5" Height="24"
                                                   Visibility="{Binding EndTimeText, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="Fill" Value="#E8E8E8"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Fill" Value="#C8E6C9"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Fill" Value="#FFCDD2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>

                                                <!-- 条块（18px 高，更精致） -->
                                                <Border Canvas.Top="19" Canvas.Left="{Binding BarLeft}"
                                                Width="{Binding BarWidth}" Height="18" CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Background" Value="#66BB6A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                                                    <Setter Property="Background" Value="#42A5F5"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Background" Value="#EF5350"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding NodeName}" FontSize="10" Foreground="White"
                                                       VerticalAlignment="Center" Margin="6,0,6,0"
                                                       TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsExecuting}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- 耗时（条块下方） -->
                                                <TextBlock Canvas.Top="39" Canvas.Left="{Binding BarLeft}"
                                                   FontSize="8" Text="{Binding DurationText}"
                                                   Visibility="{Binding DurationText, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#BDBDBD"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="#81C784"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="#E57373"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 未执行 -->
                                                <TextBlock Canvas.Left="8" Canvas.Top="18" Text="—" FontSize="9" Foreground="#E0E0E0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsCompleted}" Value="False"/>
                                                                        <Condition Binding="{Binding IsExecuting}" Value="False"/>
                                                                        <Condition Binding="{Binding IsFailed}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ══ 底栏（单行紧凑） ══ -->
                    <Border Grid.Row="3" Padding="12,5"
                    BorderBrush="#EBEBEB" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="10" Foreground="#BDBDBD" VerticalAlignment="Center" Text="开始" Margin="0,0,4,0"/>
                            <TextBlock FontSize="10" Foreground="#616161" FontFamily="Consolas" VerticalAlignment="Center"
                               Text="{Binding FlowStartTimeText}" Margin="0,0,14,0"/>

                            <TextBlock FontSize="10" Foreground="#BDBDBD" VerticalAlignment="Center" Text="结束" Margin="0,0,4,0"/>
                            <TextBlock FontSize="10" Foreground="#616161" FontFamily="Consolas" VerticalAlignment="Center"
                               Text="{Binding FlowEndTimeText}" Margin="0,0,14,0"/>

                            <TextBlock FontSize="10" Foreground="#BDBDBD" VerticalAlignment="Center" Text="耗时" Margin="0,0,4,0"/>
                            <TextBlock FontSize="10" Foreground="#616161" FontWeight="Medium" VerticalAlignment="Center"
                               Text="{Binding FlowElapsedText}" Margin="0,0,20,0"/>

                            <Rectangle Width="1" Height="14" Fill="#E8E8E8" Margin="0,0,12,0"/>

                            <!-- 进度 -->
                            <TextBlock FontSize="10" Foreground="#BDBDBD" VerticalAlignment="Center" Margin="0,0,6,0"
                               Text="{Binding ProgressText}"/>
                            <Border Height="3" Width="80" CornerRadius="1.5" Background="#EBEBEB" VerticalAlignment="Center">
                                <Border Height="3" CornerRadius="1.5" Background="#66BB6A"
                                HorizontalAlignment="Left" Width="{Binding ProgressBarWidth}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>



            <!-- ==================== 右侧属性栏（Row=0~1, Column=1，跨两行） ==================== -->
            <Border x:Name="PropertyPanelRoot"
                    Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                    Margin="0,72,0,0"
                    Background="#F5F5F5"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1,0,0,0"
                    MouseDown="PropertyPanelRoot_MouseDown">

                <!-- 去掉外层标题栏，直接由内部各属性视图的 Header 提供标题 -->
                <ContentControl Content="{Binding SelectedNode}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{StaticResource DefaultPropertiesTemplate}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="0"/>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- 设备命令 -->
                                <DataTrigger Binding="{Binding SelectedNode.IsDeviceCommand}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DeviceCommandPropertiesTemplate}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="20" To="0" Duration="0:0:0.2" DecelerationRatio="0.8"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                                <!-- IF命令 -->
                                <DataTrigger Binding="{Binding SelectedNode.IsIfNode}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource IfCommandPropertiesTemplate}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="20" To="0" Duration="0:0:0.2" DecelerationRatio="0.8"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                                <!-- 循环命令 -->
                                <DataTrigger Binding="{Binding SelectedNode.IsLoopNode}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource LoopCommandPropertiesTemplate}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="20" To="0" Duration="0:0:0.2" DecelerationRatio="0.8"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                                <!-- 并行命令 -->
                                <DataTrigger Binding="{Binding SelectedNode.IsParallelNode}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource ParallelCommandPropertiesTemplate}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="20" To="0" Duration="0:0:0.2" DecelerationRatio="0.8"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                                <!-- 设置变量命令 -->
                                <DataTrigger Binding="{Binding SelectedNode.IsSetVariableNode}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SetVariableCommandPropertiesTemplate}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="20" To="0" Duration="0:0:0.2" DecelerationRatio="0.8"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                                <!-- 等待命令 -->
                                <DataTrigger Binding="{Binding SelectedNode.IsWaitNode}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource WaitCommandPropertiesTemplate}"/>
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 From="20" To="0" Duration="0:0:0.2" DecelerationRatio="0.8"/>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.8" To="1.0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </Border>

        </Grid>

        <!-- 空状态提示 -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    x:Name="EmptyStatePanel"
                    Visibility="Collapsed">
        </StackPanel>

    </Grid>
</UserControl>
