<!-- FlowDesignerView.xaml - 修复设备命令节点显示问题 -->
<UserControl x:Class="MaxChemical.Modules.Designer.Views.FlowDesignerView"
             x:Name="FlowDesignerRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:MaxChemical.Modules.Designer.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White">

    <UserControl.Resources>
        <!-- 转换器资源 -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToThicknessConverter x:Key="BoolToThicknessConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>

   
        <!-- 自定义按钮样式 -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 设备命令节点模板 -->
        <DataTemplate x:Key="DeviceCommandNodeTemplate">
            <Border Width="231" Height="64"
            Background="White"
            CornerRadius="6"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
            RenderTransformOrigin="0.5,0.5">

                <!-- 设置RenderTransform用于动画 -->
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                        <TranslateTransform X="0" Y="0"/>
                    </TransformGroup>
                </Border.RenderTransform>

                <!-- 修正后的样式 - 高亮时替换阴影而不是叠加 -->
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect ShadowDepth="0"
                                          Direction="315"
                                          BlurRadius="8"
                                          Color="#000000"
                                          Opacity="0.25"/>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- 选中状态 -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>

                            <!-- 插入高亮状态 - 替换原始阴影，不叠加 -->
                            <DataTrigger Binding="{Binding IsInsertHighlight}" Value="True">
                                <!-- 完全替换Effect，而不是叠加 -->
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0"
                                                  Direction="0"
                                                 
                                                  Color="#186DF5"
                                                  Opacity="0.5"/>
                                    </Setter.Value>
                                </Setter>

                                <!-- 与逻辑节点完全相同的动画 -->
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                     To="1.02" Duration="0:0:0.3"
                                                     DecelerationRatio="0.6"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                     To="1.02" Duration="0:0:0.3"
                                                     DecelerationRatio="0.6"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                     To="-3" Duration="0:0:0.3"
                                                     DecelerationRatio="0.6"/>
                                            <!-- 发光脉冲效果 -->
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                     From="0.5" To="0.8" Duration="0:0:0.8"
                                                     AutoReverse="True" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                     To="1.0" Duration="0:0:0.3"
                                                     AccelerationRatio="0.3"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                     To="1.0" Duration="0:0:0.3"
                                                     AccelerationRatio="0.3"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                     To="0" Duration="0:0:0.3"
                                                     AccelerationRatio="0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!-- 现有的Grid内容保持不变 -->
                <Grid>
                    <!-- 主要内容区域 - 负责节点选择 -->
                    <Border Margin="16,16,40,16"
                    Background="Transparent"
                    Cursor="Hand"
                    MouseLeftButtonDown="DeviceNode_SelectClick">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧命令图标 -->
                            <Grid Grid.Column="0"
                          Width="32" Height="32"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0">

                                <!-- 真实图标 -->
                                <Image Source="{Binding DisplayImageLocation}" 
                               Stretch="Uniform" 
                               Width="26" Height="26">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- 默认图标 -->
                                <Border Width="26" Height="26" 
                                Background="#6CB6FF" 
                                CornerRadius="13">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="🔧" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"
                                       Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- 中间文字内容 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" 
                                   FontSize="14" 
                                   FontWeight="Medium"
                                   Foreground="#333"
                                   Margin="0,0,0,2"
                                   TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding DisplayHelpText}" 
                                   FontSize="10" 
                                   Foreground="#999"
                                   TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- 关闭/停止按钮 -->
                            <Button Grid.Column="2"
                            Width="16" Height="16"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            ToolTip="停止当前步骤"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Ellipse Fill="#F44336" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 删除按钮 - 独立区域，不受选择事件影响 -->
                    <Border Width="20" Height="20"
                    Background="Transparent"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,5,5,0"
                    Cursor="Hand"
                    Tag="{Binding}"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                    MouseLeftButtonUp="DeviceNode_DeleteClick">

                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#10000000"/>
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <TextBlock Text="×"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                            <Setter Property="Foreground" Value="#333333"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- 画布外边框 -->
        <Rectangle Fill="White"
                   Stroke="#BCBCBC"
                   StrokeThickness="1"
                   StrokeDashArray="8,8"
                   RadiusX="4"
                   RadiusY="4"/>

        <!-- 设计画布 -->
        <Grid>
            <!-- 顶部工具栏区域 -->
            <Border Height="72" VerticalAlignment="Top">
                <Border.Background>
                    <SolidColorBrush Color="#EEEEEE" Opacity="0.27"/>
                </Border.Background>

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="10">

                    <!-- 流程控制图标 -->
                    <Image Source="pack://siteoforigin:,,,/Resources/CommadIcon/control.png" 
                           Width="27" Height="22"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                    <TextBlock Text="流程控制:" 
                               FontSize="14"
                               Foreground="#747474"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- 动态生成的工具按钮 -->
                    <ItemsControl ItemsSource="{Binding LogicCommandPlugins}" 
                                  x:Name="ToolbarItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding ToolbarButton}"
                                                  Margin="0,0,16,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 管理按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                        <Button Command="{Binding ValidateAllNodesCommand}"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="验证所有节点配置"
                                Margin="0,0,8,0">
                            <Path Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M11,16.5L18,9.5L16.59,8.09L11,13.67L7.91,10.59L6.5,12L11,16.5Z"
                                  Fill="#4CAF50"
                                  Width="20" Height="20"
                                  Stretch="Uniform"/>
                        </Button>

                        <Button Command="{Binding RefreshPluginsCommand}"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip="刷新插件"
                                Margin="0,0,0,0">
                            <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                  Fill="#2196F3"
                                  Width="20" Height="20"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 主要内容区域 -->
            <!-- 滚动视图包装画布 -->
            <ScrollViewer x:Name="CanvasScrollViewer" 
                          Margin="0,72,0,0"
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Visible"
                          Background="Transparent"
                          CanContentScroll="False"
                          PanningMode="Both"
                          Style="{StaticResource ThinScrollViewerStyle}">

                <!-- 画布容器 - 移除固定尺寸绑定，改用MinWidth和MinHeight -->
                <Grid x:Name="CanvasContainer"  
                      Width="{Binding CanvasWidth}"
                      Height="{Binding CanvasHeight}"
                      MinWidth="1200" 
                      MinHeight="800"
                      Background="Transparent">

                    <!-- 主容器，支持拖放 -->
                    <Grid AllowDrop="True"
                          Drop="Canvas_Drop"
                          DragOver="Canvas_DragOver"
                          DragLeave="Canvas_DragLeave"
                          SizeChanged="MainGrid_SizeChanged">

                        <!-- 标题 -->
                        <TextBlock Text="步骤流程编辑" 
                                   FontSize="16" 
                                   FontWeight="Normal"
                                   Foreground="#999"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,10,0,0"/>

                        <!-- 画布内容 -->
                        <Canvas x:Name="DesignCanvas"
                                Background="Transparent"
                                Width="{Binding CanvasWidth}"
                                Height="{Binding CanvasHeight}"
                                Margin="0,35,0,0">

                            <!-- 流程启动节点 - ZIndex=10 -->
                            <Border x:Name="StartNode"
                                    Canvas.Left="{Binding StartNodeX}"
                                    Canvas.Top="{Binding StartNodeY}"
                                    Panel.ZIndex="10"
                                    Width="231" Height="64"
                                    Background="White"
                                    CornerRadius="6"
                                    Cursor="Arrow">
                                <!-- 启动节点内容保持不变 -->
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="4"
                                                      Direction="315"
                                                      BlurRadius="8"
                                                      Color="#000000"
                                                      Opacity="0.25"/>
                                </Border.Effect>

                                <Grid Margin="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧图标 -->
                                    <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0">
                                        <Ellipse Width="24" Height="23" Fill="#6CB6FF"/>
                                        <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z" 
                                              Fill="White" 
                                              Width="12" Height="12"
                                              Margin="2,0,0,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stretch="Uniform"/>
                                    </Grid>

                                    <!-- 右侧文字内容 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="流程启动" 
                                                   FontSize="14" 
                                                   FontWeight="Medium"
                                                   Foreground="#333"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="初始化执行环境" 
                                                   FontSize="11" 
                                                   Foreground="#999"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 命令节点集合 - ZIndex=10，确保节点在连接线之上 -->
                            <ItemsControl ItemsSource="{Binding CommandNodes}"
                                          Panel.ZIndex="10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="10" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              RenderTransformOrigin="0.5,0.5">

                                            <!-- 设置RenderTransform用于动画 -->
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                                    <TranslateTransform X="0" Y="0"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>

                                            <!-- 逻辑节点高亮样式（保持不变） -->
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <!-- 插入高亮状态 - 为逻辑命令节点添加高亮效果 -->
                                                        <DataTrigger Binding="{Binding IsInsertHighlight}" Value="True">
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect ShadowDepth="0"
                                                      Direction="0"
                                                      BlurRadius="20"
                                                      Color="#186DF5"
                                                      Opacity="0.5"/>
                                                                </Setter.Value>
                                                            </Setter>

                                                            <!-- 逻辑节点的高亮动画 -->
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.02" Duration="0:0:0.3"
                                                         DecelerationRatio="0.6"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.02" Duration="0:0:0.3"
                                                         DecelerationRatio="0.6"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="-3" Duration="0:0:0.3"
                                                         DecelerationRatio="0.6"/>
                                                                        <!-- 发光脉冲效果 -->
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                         From="0.5" To="0.8" Duration="0:0:0.8"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>

                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.3"
                                                         AccelerationRatio="0.3"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.3"
                                                         AccelerationRatio="0.3"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                         To="0" Duration="0:0:0.3"
                                                         AccelerationRatio="0.3"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <!-- 插件创建的逻辑命令节点控件 -->
                                            <ContentPresenter Content="{Binding NodeControl}"
                              PreviewMouseLeftButtonDown="NodeControl_PreviewMouseLeftButtonDown"
                              Visibility="{Binding NodeControl, Converter={StaticResource StringToVisibilityConverter}}">
                                                <ContentPresenter.Style>
                                                    <Style TargetType="ContentPresenter">
                                                        <EventSetter Event="Loaded" Handler="ComplexNodeControl_Loaded"/>
                                                    </Style>
                                                </ContentPresenter.Style>
                                            </ContentPresenter>

                                            <!-- 默认的设备命令节点模板 -->
                                            <ContentPresenter ContentTemplate="{StaticResource DeviceCommandNodeTemplate}"
                              Content="{Binding}">
                                                <ContentPresenter.Style>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeviceCommand}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NodeControl}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentPresenter.Style>
                                            </ContentPresenter>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 连接线集合 - ZIndex=5，确保连接线在节点之下但在背景之上 -->
                            <ItemsControl ItemsSource="{Binding Connections}"
                                          Panel.ZIndex="5">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Panel.ZIndex" Value="5" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 连接线模板 -->
                                        <Canvas Width="10" Height="{Binding TotalHeight}">
                                            <!-- 竖直线 -->
                                            <Rectangle Fill="#979797" 
                                                       Width="1" 
                                                       Height="{Binding LineLength}"
                                                       Canvas.Left="4"
                                                       Canvas.Top="0"/>
                                            <!-- 向下箭头 -->
                                            <Path Data="M0,0 L8,0 L4,8 Z" 
                                                  Fill="#979797" 
                                                  Canvas.Left="1"
                                                  Canvas.Top="{Binding ArrowTop}"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Grid>
                </Grid>
            </ScrollViewer>

        </Grid>

        <!-- 空状态提示 -->
        <StackPanel HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    x:Name="EmptyStatePanel"
                    Visibility="Collapsed">
            <!-- 空状态内容 -->
        </StackPanel>
    </Grid>
</UserControl>