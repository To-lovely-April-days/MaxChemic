<UserControl x:Class="MaxChemical.Modules.Designer.Views.ProcessDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White">

    <Border Background="White" 
            BorderBrush="#E0E0E0">

        <Grid>
            <!-- 🔥 新增：管道工具箱浮动在右侧 -->
            <local:PipeToolboxPanel x:Name="PipeToolbox"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,20,20,0"
                                    Panel.ZIndex="1000"/>

            <!-- 🔥 添加滚动查看器包装设计画布 -->
            <ScrollViewer x:Name="CanvasScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          PanningMode="Both"
                          CanContentScroll="True"
                          Style="{StaticResource ThinScrollViewerStyle}">

                <!-- 设计画布 -->
                <Canvas x:Name="DesignCanvas"
                Background="White"
                ClipToBounds="True"
                RenderOptions.BitmapScalingMode="LowQuality"
                RenderOptions.EdgeMode="Aliased"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

                    <!-- ✅ 关键优化：启用画布级别缓存 -->
                    <Canvas.CacheMode>
                        <BitmapCache EnableClearType="False" 
                             RenderAtScale="1" 
                             SnapsToDevicePixels="True"/>
                    </Canvas.CacheMode>
                </Canvas>

            </ScrollViewer>

            <!-- 水印和提示信息 -->
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">

                <TextBlock Text="工艺设计器" 
                           FontSize="32" 
                           FontWeight="Light" 
                           Foreground="#D0D0D0" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Border Background="#F8F9FA" 
                        BorderBrush="#E9ECEF" 
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="工艺流程设计画布" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#495057" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="在此区域创建和编辑化工工艺流程图" 
                                   FontSize="14" 
                                   Foreground="#6C757D" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"/>

                        <TextBlock Text="支持拖拽设备、连接管道、设置参数等操作" 
                                   FontSize="12" 
                                   Foreground="#868E96" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="• 滚动条：导航到指定区域&#x0a;• 中键拖拽：平移画布&#x0a;• 拖拽设备到画布上开始设计" 
                                   FontSize="11" 
                                   Foreground="#ADB5BD" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="350"
                                   Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>