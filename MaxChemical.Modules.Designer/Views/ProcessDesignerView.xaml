<UserControl x:Class="MaxChemical.Modules.Designer.Views.ProcessDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified">

    <Border Background="White" BorderBrush="#E0E0E0">
        <Grid>
            <!--  管道工具箱（最高层级，不缓存） -->
            <local:PipeToolboxPanel x:Name="PipeToolbox"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,20,20,0"
                                    Panel.ZIndex="1000"
                                    IsHitTestVisible="True"/>

            <!--  画布滚动容器（硬件加速） -->
            <ScrollViewer x:Name="CanvasScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          PanningMode="Both"
                          CanContentScroll="True"
                          Style="{StaticResource ThinScrollViewerStyle}"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          RenderOptions.EdgeMode="Unspecified">

             
                <!--  设计画布(核心优化,不使用 BitmapCache,避免拖拽抖动) -->
                <Canvas x:Name="DesignCanvas"
        Background="White"
        ClipToBounds="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.EdgeMode="Unspecified"/>

            </ScrollViewer>

            <!--  水印和提示信息（不缓存） -->
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">

                <TextBlock Text="工艺设计器" 
                           FontSize="32" 
                           FontWeight="Light" 
                           Foreground="#D0D0D0" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Border Background="#F8F9FA" 
                        BorderBrush="#E9ECEF" 
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="工艺流程设计画布" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#495057" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="在此区域创建和编辑化工工艺流程图" 
                                   FontSize="14" 
                                   Foreground="#6C757D" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"/>

                        <TextBlock Text="支持拖拽设备、连接管道、设置参数等操作" 
                                   FontSize="12" 
                                   Foreground="#868E96" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="• 滚动条：导航到指定区域&#x0a;• 中键拖拽:平移画布&#x0a;• 拖拽设备到画布上开始设计" 
                                   FontSize="11" 
                                   Foreground="#ADB5BD" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="350"
                                   Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ★ 上云:专业 loading 遮罩(主题色旋转环)。触发在标题栏项目名旁的「上云」按钮 -->
            <Grid x:Name="UploadingOverlay" Visibility="Collapsed" Panel.ZIndex="3000" Background="#B3FFFFFF">
                <Border Background="White" CornerRadius="14" Padding="32,28"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="#EEEEEE" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.18" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="54" Height="54" HorizontalAlignment="Center">
                            <Ellipse Width="54" Height="54" Stroke="#EEEEEE" StrokeThickness="5"/>
                            <Ellipse Width="54" Height="54" Stroke="{DynamicResource Brand.PrimaryBrush}"
                                     StrokeThickness="5" StrokeDashArray="45 200" StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <!-- 只在遮罩真正可见时转动(隐藏就停);Style 内不能用 TargetName,
                                                 直接动画本元素的 RenderTransform.Angle -->
                                            <Trigger Property="IsVisible" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard Name="SpinSB">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:0.9"
                                                                RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinSB"/>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="正在上云…" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock Text="导出组态并同步到云端,请稍候" FontSize="12" Foreground="#8A8F99"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>