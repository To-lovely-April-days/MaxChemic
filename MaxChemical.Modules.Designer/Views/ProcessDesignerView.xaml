<UserControl x:Class="MaxChemical.Modules.Designer.Views.ProcessDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:MaxChemical.Modules.Designer.Views.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             RenderOptions.BitmapScalingMode="HighQuality"
             RenderOptions.EdgeMode="Unspecified">

    <!--  样式资源 -->
    <UserControl.Resources>
        <!--  优化：高性能 ScrollViewer 样式 -->
        <Style x:Key="ThinScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 内容区域 -->
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"/>

                            <!-- 垂直滚动条 -->
                            <ScrollBar Grid.Column="1" Grid.Row="0"
                                       Name="PART_VerticalScrollBar"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Width="8"
                                       Opacity="0.6"/>

                            <!-- 水平滚动条 -->
                            <ScrollBar Grid.Column="0" Grid.Row="1"
                                       Name="PART_HorizontalScrollBar"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Height="8"
                                       Opacity="0.6"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#E0E0E0">
        <Grid>
            <!--  管道工具箱（最高层级，不缓存） -->
            <local:PipeToolboxPanel x:Name="PipeToolbox"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,20,20,0"
                                    Panel.ZIndex="1000"
                                    IsHitTestVisible="True"/>

            <!--  画布滚动容器（硬件加速） -->
            <ScrollViewer x:Name="CanvasScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          PanningMode="Both"
                          CanContentScroll="True"
                          Style="{StaticResource ThinScrollViewerStyle}"
                          RenderOptions.BitmapScalingMode="HighQuality"
                          RenderOptions.EdgeMode="Unspecified">

             
                <!--  设计画布(核心优化,不使用 BitmapCache,避免拖拽抖动) -->
                <Canvas x:Name="DesignCanvas"
        Background="White"
        ClipToBounds="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.EdgeMode="Unspecified"/>

            </ScrollViewer>

            <!--  水印和提示信息（不缓存） -->
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">

                <TextBlock Text="工艺设计器" 
                           FontSize="32" 
                           FontWeight="Light" 
                           Foreground="#D0D0D0" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Border Background="#F8F9FA" 
                        BorderBrush="#E9ECEF" 
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="工艺流程设计画布" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#495057" 
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="在此区域创建和编辑化工工艺流程图" 
                                   FontSize="14" 
                                   Foreground="#6C757D" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"/>

                        <TextBlock Text="支持拖拽设备、连接管道、设置参数等操作" 
                                   FontSize="12" 
                                   Foreground="#868E96" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="300"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="• 滚动条：导航到指定区域&#x0a;• 中键拖拽:平移画布&#x0a;• 拖拽设备到画布上开始设计" 
                                   FontSize="11" 
                                   Foreground="#ADB5BD" 
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="350"
                                   Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>