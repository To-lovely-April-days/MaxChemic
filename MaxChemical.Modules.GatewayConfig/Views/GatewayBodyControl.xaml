<UserControl x:Class="MaxChemical.Modules.GatewayConfig.Views.GatewayBodyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="640" Height="320">
    <Canvas Width="640" Height="320">
        <Rectangle Canvas.Left="20" Canvas.Top="20" Width="600" Height="280"
                   Fill="White" Stroke="#1A1A1A" StrokeThickness="1.2"/>
        <Line X1="20" Y1="50" X2="620" Y2="50" Stroke="#1A1A1A" StrokeThickness="0.8"/>

        <TextBlock Canvas.Left="0" Canvas.Top="32" Width="640" TextAlignment="Center"
                   FontFamily="Arial" FontSize="11" FontWeight="SemiBold" Foreground="#1A1A1A"
                   Text="SERIAL GATEWAY · 4-PORT"/>

        <ContentControl x:Name="Db9_1" Canvas.Left="56"  Canvas.Top="84"  Tag="0"/>
        <ContentControl x:Name="Db9_2" Canvas.Left="176" Canvas.Top="84"  Tag="1"/>
        <ContentControl x:Name="Db9_3" Canvas.Left="56"  Canvas.Top="176" Tag="2"/>
        <ContentControl x:Name="Db9_4" Canvas.Left="176" Canvas.Top="176" Tag="3"/>

        <Line X1="300" Y1="76" X2="300" Y2="290" Stroke="#1A1A1A"
              StrokeThickness="0.4" StrokeDashArray="2,3"/>

        <ContentControl x:Name="Rs485_1" Canvas.Left="330" Canvas.Top="84"  Tag="0"/>
        <ContentControl x:Name="Rs485_2" Canvas.Left="330" Canvas.Top="130" Tag="1"/>
        <ContentControl x:Name="Rs485_3" Canvas.Left="330" Canvas.Top="178" Tag="2"/>
        <ContentControl x:Name="Rs485_4" Canvas.Left="330" Canvas.Top="226" Tag="3"/>
    </Canvas>
</UserControl>
