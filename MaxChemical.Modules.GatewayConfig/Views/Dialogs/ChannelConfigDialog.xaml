<Window x:Class="MaxChemical.Modules.GatewayConfig.Views.Dialogs.ChannelConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MaxChemical.Modules.GatewayConfig.Models"
        Title="设备参数编辑"
        Width="1040" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaxChemical.Shell;component/Resources/ThemeColors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaxChemical.Shell;component/Resources/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- 设备候选下拉项模板 -->
            <DataTemplate x:Key="DeviceCandidateTemplate" DataType="{x:Type models:BindableDeviceCandidate}">
                <Grid Height="44" Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="30" Height="30" Background="#F0F0F0"
                            CornerRadius="4" HorizontalAlignment="Center">
                        <Image Source="{Binding ImageLocation}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" Margin="4"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                   FontWeight="Medium" Foreground="#1A1A1A"/>
                        <TextBlock Text="{Binding SubtitleText}" FontSize="11"
                                   Foreground="#888780" FontFamily="Consolas, Microsoft YaHei" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#EFEFEF" CornerRadius="2"
                            Padding="6,1" VerticalAlignment="Center" Margin="0,0,4,0"
                            Visibility="{Binding IsBoundElsewhere, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="已绑定" FontSize="10" Foreground="#888780"/>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="8" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#60000000" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <!-- 标题栏 -->
                <RowDefinition Height="Auto"/>
                <!-- 头信息 -->
                <RowDefinition Height="Auto"/>
                <!-- 主体 -->
                <RowDefinition Height="Auto"/>
                <!-- 绑定设备 -->
                <RowDefinition Height="Auto"/>
                <!-- 底部按钮 -->
            </Grid.RowDefinitions>

            <!-- ═══════════ 标题栏 ═══════════ -->
            <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="8,8,0,0"
                    x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{Binding TitleText}" Foreground="White" FontSize="13"
                               FontWeight="Medium" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Style="{DynamicResource CloseButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnCancelClick"/>
                </Grid>
            </Border>

            <!-- ═══════════ 头信息:设备 ID / MAC / 固件 ═══════════ -->
            <Border Grid.Row="1" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="28,14,28,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="设备 ID" FontSize="12" Foreground="#3F3F3F" FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DeviceIdHex}" FontSize="12" Foreground="#757575"
                                   FontFamily="Consolas, Microsoft YaHei" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Rectangle Width="1" Height="12" Fill="#D4D4D4" Margin="16,0"/>
                        <TextBlock Text="MAC" FontSize="12" Foreground="#3F3F3F" FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MacText}" FontSize="12" Foreground="#757575"
                                   FontFamily="Consolas, Microsoft YaHei" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <Rectangle Width="1" Height="12" Fill="#D4D4D4" Margin="16,0"/>
                        <TextBlock Text="固件" FontSize="12" Foreground="#3F3F3F" FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FirmwareText}" FontSize="12" Foreground="#757575"
                                   FontFamily="Consolas, Microsoft YaHei" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="修改后设备会自动重启" FontSize="11" Foreground="#888780"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ═══════════ 主体:左栏网络设置 + 右栏串口参数 ═══════════ -->
            <Grid Grid.Row="2" Margin="28,16,28,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ───── 左栏:网络设置 ───── -->
                <Border Grid.Column="0" Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <!-- 版块标题 -->
                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="13" Background="{DynamicResource Brand.PrimaryBrush}"
                                        CornerRadius="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="网络设置"/>
                            </StackPanel>
                        </Border>

                        <!-- 7 行 × 2 列网格 -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 第 1 行:设备名称 / IP 模式 -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="设备名称"/>
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         Text="{Binding Working.DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="IP 模式"/>
                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                          SelectedValue="{Binding Working.IpMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:IpMode.Static}">静态 IP</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:IpMode.Dhcp}">DHCP 动态</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- 第 2 行:本地 IP / 本地端口 -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="本地 IP"/>
                                <TextBox Style="{StaticResource FieldMonoTextBoxStyle}"
                                         Text="{Binding Working.Ip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="本地端口"/>
                                <TextBox Style="{StaticResource FieldMonoTextBoxStyle}"
                                         Text="{Binding Working.LocalPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- 第 3 行:子网掩码 / 网关 -->
                            <StackPanel Grid.Row="4" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="子网掩码"/>
                                <TextBox Style="{StaticResource FieldMonoTextBoxStyle}"
                                         Text="{Binding Working.Netmask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="网关"/>
                                <TextBox Style="{StaticResource FieldMonoTextBoxStyle}"
                                         Text="{Binding Working.GatewayAddr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- 第 4 行:DNS / Web 端口 -->
                            <StackPanel Grid.Row="6" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="DNS 服务器"/>
                                <TextBox Style="{StaticResource FieldMonoTextBoxStyle}"
                                         Text="{Binding Working.DnsServer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="6" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Web 端口"/>
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         Text="{Binding Working.WebPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- 第 5 行:工作模式 -->
                            <StackPanel Grid.Row="8" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="工作模式"/>
                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                          SelectedValue="{Binding Working.WorkMode, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:WorkMode.TcpServer}">TCP Server</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:WorkMode.TcpClient}">TCP Client</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:WorkMode.Udp}">UDP</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:WorkMode.UdpMulti}">UDP 组播</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- 第 6 行:目的 IP / 目的端口 -->
                            <StackPanel Grid.Row="10" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="目的 IP / 域名"/>
                                <TextBox Style="{StaticResource FieldMonoTextBoxStyle}"
                                         Text="{Binding Working.DestIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="10" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="目的端口"/>
                                <TextBox Style="{StaticResource FieldMonoTextBoxStyle}"
                                         Text="{Binding Working.DestPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- 第 7 行:断线重连 / 保活时间 -->
                            <StackPanel Grid.Row="12" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="断线重连(秒,0~255)"/>
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         Text="{Binding Working.ReconnectTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="12" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="保活时间(秒,0~255)"/>
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         Text="{Binding Working.KeepAliveTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ───── 右栏:串口参数 ───── -->
                <Border Grid.Column="2" Style="{StaticResource GroupCardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <!-- 版块标题 -->
                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="13" Background="{DynamicResource Brand.PrimaryBrush}"
                                        CornerRadius="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="串口参数"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 波特率 / 数据位 -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="波特率"/>
                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                          SelectedValue="{Binding Working.BaudRate, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_1200}">1200</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_2400}">2400</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_4800}">4800</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_9600}">9600</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_19200}">19200</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_38400}">38400</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_57600}">57600</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_115200}">115200</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_240800}">240800</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:BaudRate.Bps_460800}">460800</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="数据位"/>
                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                          SelectedValue="{Binding Working.DataBits, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:DataBits.Bits_8}">8 位</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:DataBits.Bits_7}">7 位</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:DataBits.Bits_6}">6 位</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:DataBits.Bits_5}">5 位</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- 校验位 / 停止位 -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="校验位"/>
                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                          SelectedValue="{Binding Working.Parity, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:Parity.None}">无校验</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:Parity.Odd}">奇校验</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:Parity.Even}">偶校验</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:Parity.Mark}">标记</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:Parity.Space}">空格</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="停止位"/>
                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                          SelectedValue="{Binding Working.StopBit, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:StopBit.Stop_1}">1 位</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:StopBit.Stop_2}">2 位</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <!-- 流控(独占整行) -->
                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="流控"/>
                                <ComboBox Style="{StaticResource FieldComboStyle}"
                                          SelectedValue="{Binding Working.FlowControl, Mode=TwoWay}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="{x:Static models:FlowControl.None}">无流控</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:FlowControl.RtsCts}">CTS/RTS</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:FlowControl.DtrDsr}">DTR/DSR</ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:FlowControl.XonXoff}">XON/XOFF</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════ 绑定设备(横跨全宽)═══════════ -->
            <Border Grid.Row="3" Style="{StaticResource GroupCardStyle}" Margin="28,4,28,14">
                <StackPanel>
                    <!-- 版块标题 -->
                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,0,0,9" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="13" Background="{DynamicResource Brand.PrimaryBrush}"
                                        CornerRadius="1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="绑定设备"/>
                            </StackPanel>
                            <TextBlock Text="绑定后,该设备的所有命令通过此通道收发"
                                       FontSize="11" Foreground="#888780"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 已绑定状态横条 -->
                    <Border Background="#FEF1F3" BorderBrush="#F3D7DC" BorderThickness="1"
                            CornerRadius="6" Padding="12,9" Margin="0,0,0,10"
                            Visibility="{Binding HasBinding, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource Brand.PrimaryBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="已绑定:" FontSize="12" Foreground="#5F5F5F"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentBoundDeviceText}"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource Brand.PrimaryBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Background="Transparent" BorderThickness="0"
                                        Foreground="#0F6E56" FontSize="12"
                                        Content="测试连接" Cursor="Hand" Padding="10,3"
                                        Command="{Binding TestConnectionCommand}"/>
                                <Rectangle Width="1" Height="14" Fill="#E0E0E0" VerticalAlignment="Center" Margin="4,0"/>
                                <Button Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource Brand.PrimaryBrush}" FontSize="12"
                                        Content="解绑" Cursor="Hand" Padding="10,3"
                                        Command="{Binding UnbindDeviceCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 测试结果显示 -->
                    <Border Background="#FAFAF8" BorderBrush="#EAEAEA" BorderThickness="1"
                            CornerRadius="6" Padding="12,9" Margin="0,0,0,10"
                            Visibility="{Binding HasBinding, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding TestResultText}"
                                   FontSize="11" Foreground="#3F3F3F"
                                   FontFamily="Consolas, Microsoft YaHei" TextWrapping="Wrap"
                                   LineHeight="16" MinHeight="20"/>
                    </Border>

                    <!-- 选择设备 + 绑定按钮 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Height="46"
                                  Padding="6"
                                  Background="#FAFAFA"
                                  BorderBrush="#E0E0E0"
                                  BorderThickness="1"
                                  ItemsSource="{Binding DeviceCandidates}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource DeviceCandidateTemplate}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="6,2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBoundElsewhere}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <Button Grid.Column="2" Content="绑定到此通道"
                                Command="{Binding BindDeviceCommand}"
                                Height="46" MinWidth="120" Padding="18,0"
                                FontSize="13" FontWeight="Medium"
                                Background="{DynamicResource Brand.PrimaryBrush}"
                                Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Brand.PrimaryHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource Brand.PrimaryDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══════════ 底部按钮:取消 / 重新读取 / 恢复默认 / 保存修改 ═══════════ -->
            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,0,28,18">
                <Button Style="{DynamicResource DialogSecondaryButtonStyleLg}"
                        Content="取消" Click="OnCancelClick" Margin="0,0,10,0"/>
                <Button Style="{DynamicResource DialogSecondaryButtonStyleLg}"
                        Content="重新读取" Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
                <Button Style="{DynamicResource DialogWarnButtonStyle}"
                        Content="恢复默认" Command="{Binding ResetToDefaultCommand}" Margin="0,0,10,0"/>
                <Button Style="{DynamicResource DialogPrimaryButtonStyleLg}"
                        Content="保存修改" Command="{Binding ApplyCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>