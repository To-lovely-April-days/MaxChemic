<Window x:Class="MaxChemical.Modules.GatewayConfig.Views.Dialogs.GlobalParamsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MaxChemical.Modules.GatewayConfig.Models"
        Title="网关全局参数"
        Width="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaxChemical.Shell;component/Resources/ThemeColors.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MaxChemical.Shell;component/Resources/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="FieldComboStyle" TargetType="ComboBox">
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="6,0"/>
                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>
            <Style x:Key="GroupCardStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Background" Value="White"/>
            </Style>
            <Style x:Key="DangerOutlineButton" TargetType="Button">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#A41626"/>
                <Setter Property="BorderBrush" Value="#A41626"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinWidth" Value="130"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#D4D4D4" BorderThickness="1" CornerRadius="8" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#60000000" Direction="310" ShadowDepth="3" BlurRadius="8" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1A1A1A" CornerRadius="8,8,0,0"
                    x:Name="TitleBar" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{Binding TitleText}" Foreground="White" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="28,0,0,0"/>
                    <Button Style="{DynamicResource CloseButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnCancelClick"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="50,28,50,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="设备身份"/>
                        </Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="设备名称"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
                                     Text="{Binding Working.DisplayName, Mode=TwoWay}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="MAC"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Working.Mac}"
                                       FontFamily="Consolas" FontSize="12" Foreground="#757575"
                                       VerticalAlignment="Center" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="固件"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Working.FirmwareVersion}"
                                       FontSize="12" Foreground="#757575" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource GroupCardStyle}">
                    <StackPanel>
                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="IP 与子网"/>
                        </Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="IP 模式"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldComboStyle}"
                                      SelectedValue="{Binding Working.IpMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag" Margin="0,0,0,6">
                                <ComboBoxItem Tag="{x:Static models:IpMode.Static}">静态 IP</ComboBoxItem>
                                <ComboBoxItem Tag="{x:Static models:IpMode.Dhcp}">DHCP</ComboBoxItem>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="IP 地址"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
                                     Text="{Binding Working.Ip, Mode=TwoWay}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="子网掩码"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
                                     Text="{Binding Working.Netmask, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                        Style="{StaticResource GroupCardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="网关 / DNS"/>
                        </Border>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="默认网关"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
                                     Text="{Binding Working.GatewayAddr, Mode=TwoWay}" Margin="0,0,12,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="DNS"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldTextBoxStyle}"
                                     Text="{Binding Working.DnsServer, Mode=TwoWay}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Web 端口"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
                                     Text="{Binding Working.WebPort, Mode=TwoWay}" Margin="0,0,12,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="#FFF7E8" BorderBrush="#FFB84A" BorderThickness="1"
                        CornerRadius="4" Padding="10,8" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" Foreground="#7A4A00" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="修改 IP 会同时影响 4 个通道,网关重启后需要用新 IP 重新搜索。"
                                   Foreground="#7A4A00" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="15,0,15,21">
                <Button Style="{StaticResource DangerOutlineButton}" Content="恢复出厂设置…"
                        HorizontalAlignment="Left" Command="{Binding ResetToDefaultCommand}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource DialogSecondaryButtonStyle}" Content="取消" Click="OnCancelClick"/>
                    <Button Style="{DynamicResource DialogPrimaryButtonStyle}" Content="应用并重启"
                            Command="{Binding ApplyCommand}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
